  "authority": {
    "statement": "RightsIR records SPDX Boolean expressions and explicit dispositions. Conflict and missing license/provenance machine-block release. Unknown, ambiguous, and custom-unparsed rights remain human-review and never machine-clear to compatible.",
    "provider_authority": "proposal-only",
    "prohibited_effects": [
      "infer_legal_clearance",
      "unknown_or_conflict_to_compatible",
      "sign_or_publish",
      "definitive_legal_advice",
      "machine_clear_from_readme_prose"
    ]
  },
  "policy": {
    "spdx_boolean_expressions": true,
    "ambiguous_legal_interpretation_human_blocked": true,
    "machine_clearance_of_unknown_or_conflict_forbidden": true,
    "conflict_machine_blocks": true,
    "missing_license_or_provenance_machine_blocks": true,
    "unknown_remains_human_review": true,
    "apparently_aligned_is_not_clearance": true,
    "fail_closed": true
  },
  "evidence_subset": [
    "licenses",
    "data_rights",
    "model_rights",
    "attribution",
    "share_alike",
    "commercial",
    "redistribution",
    "unknown_custom"
  ],
  "disposition_vocabulary": {
    "machine_block": {
      "blocks_release": true,
      "machine_clearance_allowed": false,
      "requires_human_review": false,
      "description": "Deterministic automatic block; no provider may clear."
    },
    "human_review": {
      "blocks_release": true,
      "machine_clearance_allowed": false,
      "requires_human_review": true,
      "description": "Unresolved or ambiguous rights; human legal review required; never auto-cleared."
    },
    "observation_only_not_clearance": {
      "blocks_release": false,
      "machine_clearance_allowed": false,
      "requires_human_review": false,
      "description": "Apparent SPDX alignment observation only; does not satisfy rights_resolution."
    },
    "human_cleared": {
      "blocks_release": false,
      "machine_clearance_allowed": false,
      "requires_human_review": false,
      "description": "Explicit human legal clearance recorded against exact SPDX expression and tree binding."
    }
  },
  "status_to_disposition": {
    "conflict": "machine_block",
    "missing": "machine_block",
    "missing_artifact": "machine_block",
    "undeclared": "machine_block",
    "unknown": "human_review",
    "ambiguous": "human_review",
    "custom_unparsed": "human_review",
    "apparently_aligned": "observation_only_not_clearance",
    "compatible": "human_review",
    "human_cleared": "human_cleared"
  },
  "evaluation_rules": [
    {
      "id": "rule:conflict-machine-blocks",
      "when_status_in": ["conflict"],
      "then_disposition": "machine_block",
      "blocks_release": true,
      "machine_clearance_allowed": false,
      "reason_code": "rights_conflict"
    },
    {
      "id": "rule:missing-license-or-provenance-machine-blocks",
      "when_status_in": ["missing", "missing_artifact", "undeclared"],
      "then_disposition": "machine_block",
      "blocks_release": true,
      "machine_clearance_allowed": false,
      "reason_code": "missing_license_or_provenance"
    },
    {
      "id": "rule:unknown-human-review",
      "when_status_in": ["unknown", "ambiguous", "custom_unparsed", "compatible"],
      "then_disposition": "human_review",
      "blocks_release": true,
      "machine_clearance_allowed": false,
      "reason_code": "unknown_rights_human_review"
    },
    {
      "id": "rule:apparently-aligned-not-clearance",
      "when_status_in": ["apparently_aligned"],
      "then_disposition": "observation_only_not_clearance",
      "blocks_release": false,
      "machine_clearance_allowed": false,
      "reason_code": "alignment_observation_only"
    },
    {
      "id": "rule:human-cleared-only-via-explicit-record",
      "when_status_in": ["human_cleared"],
      "then_disposition": "human_cleared",
      "blocks_release": false,
      "machine_clearance_allowed": false,
      "reason_code": "human_legal_clearance"
    }
  ],
