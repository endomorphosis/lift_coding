  "conjuncts": [
    {
      "id": "exact_source_binding",
      "requirement": "Qualification binds the exact controller tree and planning-forest gitlinks; floating branch tips do not qualify."
    },
    {
      "id": "immutable_dependency_closure",
      "requirement": "Every release-consumed dependency is content-addressed or lock-pinned; git+@branch, nightly indexes, and competing locks are rejected."
    },
    {
      "id": "identified_build_environment",
      "requirement": "Build environment identity is declared and reproducible within policy bounds."
    },
    {
      "id": "current_proofs_and_tests",
      "requirement": "Proofs and tests are current for the exact tree; stale or historical receipts are rejected."
    },
    {
      "id": "contract_compatibility",
      "requirement": "Repository assume/guarantee contracts compose without unresolved mandatory incompatibilities."
    },
    {
      "id": "rights_resolution",
      "requirement": "RightsIR dispositions for mandatory nodes are human_cleared or non-blocking observation-only; machine_block and human_review block."
    },
    {
      "id": "live_capabilities",
      "requirement": "Live capability claims require current signed live receipts; hermetic/simulated evidence cannot satisfy live."
    },
    {
      "id": "reproducibility_and_provenance",
      "requirement": "Immutable portfolio lock, reproducible build evidence, and signed provenance policy are present (FACP-056+)."
    }
  ],
  "rejection_rules": [
    {
      "code": "stale_proof",
      "blocks_release": true,
      "description": "Proof or receipt freshness is stale, historical, superseded, or bound to a different tree/gitlink.",
      "when_any": [
        {"field": "proof_freshness", "in": ["stale", "historical", "superseded", "expired"]},
        {"field": "proof_tree_match", "equals": false},
        {"field": "historical_receipt_used_as_current", "equals": true}
      ]
    },
    {
      "code": "simulation_as_live",
      "blocks_release": true,
      "description": "Simulation, fixture, or mock origin is presented as live production qualification.",
      "when_all": [
        {"field": "origin", "in": ["simulated", "fixture", "mock", "declared"]},
        {"field": "claimed_environment", "in": ["live", "production"]}
      ]
    },
    {
      "code": "mutable_ref",
      "blocks_release": true,
      "description": "Release inputs include mutable VCS refs, floating branches, unpinned nightlies, or competing lock authorities.",
      "when_any": [
        {"field": "dependency_mutability", "in": ["mutable", "floating_branch", "git_plus_branch", "nightly_index", "competing_locks"]},
        {"field": "has_mutable_ref", "equals": true}
      ]
    },
    {
      "code": "missing_capability",
      "blocks_release": true,
      "description": "Required live capability receipt or admission is absent, empty, or unavailable.",
      "when_any": [
        {"field": "capability_status", "in": ["missing", "absent", "unavailable", "empty_registry"]},
        {"field": "live_capability_present", "equals": false}
      ]
    },
    {
      "code": "incompatible_contract",
      "blocks_release": true,
      "description": "Repository contract composition fails: violated boundary, incompatible versions, or unresolved mandatory assumption.",
      "when_any": [
        {"field": "contract_status", "in": ["incompatible", "violated", "unresolved_mandatory"]},
        {"field": "contracts_compatible", "equals": false}
      ]
    },
    {
      "code": "unresolved_mandatory_rights",
      "blocks_release": true,
      "description": "Mandatory RightsIR node remains machine_block or human_review; rights_resolution is incomplete.",
      "when_any": [
        {"field": "rights_disposition", "in": ["machine_block", "human_review"]},
        {"field": "mandatory_rights_resolved", "equals": false},
        {"field": "rights_status", "in": ["conflict", "missing", "missing_artifact", "undeclared", "unknown", "ambiguous", "custom_unparsed"]}
      ]
    }
  ],
  "rejection_code_order": [
    "stale_proof",
    "simulation_as_live",
    "mutable_ref",
    "missing_capability",
    "incompatible_contract",
    "unresolved_mandatory_rights"
