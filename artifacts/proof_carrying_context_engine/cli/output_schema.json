{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipfs-accelerate:proof-context:cli:command-result:1",
  "title": "Proof-carrying context CLI command result",
  "description": "Stable, bounded projection. Null identity values mean missing evidence and are never inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "command", "status", "exit_code", "trace_id", "correlation_id", "identities", "artifact_cids", "provenance", "details", "error"],
  "properties": {
    "schema_version": {"const": "ipfs-accelerate.proof-context.v0.1/command-result@1"},
    "contract_version": {"const": "0.1"},
    "command": {"type": ["string", "null"], "maxLength": 4096},
    "status": {"type": "string", "enum": ["succeeded", "failed", "timeout", "cancelled", "verification_failed", "proof_failed", "assurance_failed", "context_insufficient", "model_escalation_required", "human_review_required", "infrastructure_failure", "partial_effect", "repair_required", "invalid", "rejected", "simulated", "unavailable", "stale"]},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 6},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "task_id", "run_id", "patch_id"],
      "properties": {
        "repository_id": {"type": ["string", "null"], "maxLength": 4096},
        "task_id": {"type": ["string", "null"], "maxLength": 4096},
        "run_id": {"type": ["string", "null"], "maxLength": 4096},
        "patch_id": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "artifact_cids": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "provenance": {"type": ["string", "null"], "maxLength": 4096},
    "details": {"type": "object"},
    "error": {"type": ["object", "string", "null"]}
  }
}
