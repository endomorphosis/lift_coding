  },
  "x-pcce-006-content-id": "sha256:b5503d2c2ec22e34091b3f747241fbde0519a9f0b213a03e0456a8f980a43f37",
  "x-schema-path": "artifacts/proof_carrying_context_engine/cli/output_schema.json",
  "x-status-taxonomy-content-id": "sha256:5f206feebb6213d3a1c113e37373ac8402003170cea609035ec9b871ca9fdd19",
  "$defs": {
    "cid": {
      "description": "CIDv1 raw sha2-256 base32. Pseudo-CIDs (sha256:, urn:, Qm) are rejected.",
      "maxLength": 128,
      "minLength": 59,
      "pattern": "^b[a-z2-7]{58,}$",
      "type": "string"
    },
    "errorCode": {
      "enum": [
        "unknown_field",
        "malformed",
        "identity_inconsistent",
        "stale_root",
        "simulated_promoted",
        "pseudo_cid",
        "schema_mismatch",
        "boundary_violation",
        "unavailable_capability",
        "timeout",
        "cancelled",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "infrastructure_failure",
        "partial_effect",
        "repair_required",
        "human_review_required"
      ],
      "type": "string"
    },
    "evidenceLabel": {
      "enum": [
        "observed",
        "estimated",
        "baseline",
        "missing"
      ],
      "type": "string"
    },
    "provenance": {
      "enum": [
        "live",
        "replayed",
        "simulated"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "rejected",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "model_escalation_required",
        "human_review_required",
        "unavailable",
        "timeout",
        "cancelled",
        "invalid",
        "stale",
        "simulated",
        "infrastructure_failure",
        "partial_effect",
        "repair_required"
      ],
      "type": "string"
    }
  }
}
