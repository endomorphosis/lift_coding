{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcce/proof-context/v0.1/cli-output",
  "title": "Proof-context CLI command result",
  "description": "Stable PCCE-043 machine output envelope. Every command result carries schema version, status, exit code, trace/correlation ID, repository/task/run/patch identities, and artifact CIDs. Live succeeded is the only zero exit. Estimates, baselines, and missing evidence are labeled in the paired human report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "exit_code",
    "correlation_id",
    "trace_id",
    "identities",
    "artifact_cids"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ipfs-accelerate.proof-context.v0.1/cli-output"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "contract_version": {
      "type": "string",
      "const": "0.1"
    },
    "interface": {
      "type": "string",
      "const": "ProofContextCLI@0.1"
    },
    "command": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "rejected",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "model_escalation_required",
        "human_review_required",
        "unavailable",
        "timeout",
        "cancelled",
        "invalid",
        "stale",
        "simulated",
        "infrastructure_failure",
        "partial_effect",
        "repair_required"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "0 live succeeded; 1 typed failure; 2 invalid/usage; 3 rejected; 4 simulated; 5 unavailable; 6 stale. Unavailable, failure, and simulation never use 0."
    },
    "policy": {
      "type": "string",
      "enum": ["production", "supervised", "evaluation", "simulation"]
    },
    "correlation_id": {
      "$ref": "#/$defs/identity_or_missing"
    },
    "trace_id": {
      "$ref": "#/$defs/identity_or_missing"
    },
    "output_mode": {
      "type": "string",
      "enum": ["json", "human"]
    },
    "identities": {
      "$ref": "#/$defs/identities"
    },
    "artifact_cid": {
      "$ref": "#/$defs/cid_or_missing"
    },
    "artifact_cids": {
      "$ref": "#/$defs/artifact_cids"
    },
    "provenance": {
      "type": ["string", "null"],
      "enum": ["live", "replayed", "simulated", null]
    },
    "contract": {
      "type": ["string", "null"]
    },
    "error": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object"
    },
    "missing_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "provider_bound": {
      "type": "boolean",
      "const": false
    },
    "sibling_layout_required": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "identity_or_missing": {
      "type": "string",
      "minLength": 1,
      "description": "Present identity or the exact token missing-evidence."
    },
    "cid_or_missing": {
      "type": "string",
      "minLength": 1,
      "description": "CIDv1 (b...) or missing-evidence. Pseudo-CIDs such as sha256: and Qm are not admitted as live artifact identities."
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_state_cid",
        "task_id",
        "run_id",
        "patch_id",
        "trace_id"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/identity_or_missing"},
        "repository_state_cid": {"$ref": "#/$defs/cid_or_missing"},
        "task_id": {"$ref": "#/$defs/identity_or_missing"},
        "run_id": {"$ref": "#/$defs/identity_or_missing"},
        "patch_id": {"$ref": "#/$defs/identity_or_missing"},
        "trace_id": {"$ref": "#/$defs/identity_or_missing"},
        "evidence_cid": {"$ref": "#/$defs/cid_or_missing"},
        "artifact_id": {"$ref": "#/$defs/cid_or_missing"},
        "contract_version": {"type": "string"}
      }
    },
    "artifact_cids": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"$ref": "#/$defs/cid_or_missing"},
        "evidence": {"$ref": "#/$defs/cid_or_missing"},
        "receipt": {"$ref": "#/$defs/cid_or_missing"},
        "seal": {"$ref": "#/$defs/cid_or_missing"},
        "report": {"$ref": "#/$defs/cid_or_missing"},
        "patch": {"$ref": "#/$defs/identity_or_missing"}
      },
      "additionalProperties": {"$ref": "#/$defs/cid_or_missing"}
    }
  }
}
