{
  "$comment": "PCCE-043. Version 0.1 is immutable after admission; incompatible changes require a new schema version.",
  "$defs": {
    "cid": {
      "description": "CIDv1 base32, or null when the artifact is missing evidence.",
      "maxLength": 128,
      "minLength": 59,
      "pattern": "^b[a-z2-7]{58,}$",
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "enum": [
        "live",
        "replayed",
        "simulated"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "rejected",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "model_escalation_required",
        "human_review_required",
        "unavailable",
        "timeout",
        "cancelled",
        "invalid",
        "stale",
        "simulated",
        "infrastructure_failure",
        "partial_effect",
        "repair_required"
      ],
      "type": "string"
    }
  },
  "$id": "https://ipfs-accelerate.dev/schemas/proof-context/v0.1/cli-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_version": "0.1",
  "cost_kinds": [
    "observed",
    "estimate",
    "baseline",
    "missing"
  ],
  "description": "Stable machine output for proof-context CLI commands. Every result binds schema version, status, exit code, trace/correlation ID, repository/task/run/patch identities, and artifact CIDs. Simulated, unavailable, and failed results cannot use exit zero. additionalProperties is false.",
  "exit_codes": {
    "assurance_failed": 1,
    "cancelled": 1,
    "context_insufficient": 1,
    "human_review_required": 1,
    "infrastructure_failure": 1,
    "invalid": 2,
    "model_escalation_required": 1,
    "partial_effect": 1,
    "proof_failed": 1,
    "rejected": 3,
    "repair_required": 1,
    "simulated": 4,
    "stale": 6,
    "succeeded": 0,
    "timeout": 1,
    "unavailable": 5,
    "verification_failed": 1
  },
  "human_report_fields": [
    "task",
    "revision",
    "routing",
    "context",
    "changes",
    "verification",
    "proof_reuse",
    "assurance",
    "escalation",
    "costs",
    "review",
    "receipts",
    "seal"
  ],
  "identity_fields": [
    "repository_id",
    "repository_state_cid",
    "task_id",
    "run_id",
    "trace_id",
    "patch_id",
    "evidence_cid"
  ],
  "interface": "ProofContextCLI@0.1",
  "nonzero_exit_statuses": [
    "rejected",
    "verification_failed",
    "proof_failed",
    "assurance_failed",
    "context_insufficient",
    "model_escalation_required",
    "human_review_required",
    "unavailable",
    "timeout",
    "cancelled",
    "invalid",
    "stale",
    "simulated",
    "infrastructure_failure",
    "partial_effect",
    "repair_required"
  ],
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "artifact_cids": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/cid"
        },
        "payload": {
          "$ref": "#/$defs/cid"
        },
        "primary": {
          "$ref": "#/$defs/cid"
        },
        "receipt": {
          "$ref": "#/$defs/cid"
        },
        "seal": {
          "$ref": "#/$defs/cid"
        }
      },
      "required": [
        "primary"
      ],
      "type": "object"
    },
    "command": {
      "type": "string"
    },
    "contract": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "const": "0.1",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "error": {
      "enum": [
        null,
        "unknown_field",
        "malformed",
        "identity_inconsistent",
        "stale_root",
        "simulated_promoted",
        "pseudo_cid",
        "schema_mismatch",
        "boundary_violation",
        "unavailable_capability",
        "timeout",
        "cancelled",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "infrastructure_failure",
        "partial_effect",
        "repair_required",
        "human_review_required"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "identities": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_version": {
          "const": "0.1",
          "type": "string"
        },
        "evidence_cid": {
          "$ref": "#/$defs/cid"
        },
        "patch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_state_cid": {
          "$ref": "#/$defs/cid"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository_id",
        "repository_state_cid",
        "task_id",
        "run_id",
        "trace_id",
        "patch_id"
      ],
      "type": "object"
    },
    "interface": {
      "const": "ProofContextCLI@0.1",
      "type": "string"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "output_cid": {
      "maxLength": 128,
      "minLength": 59,
      "pattern": "^b[a-z2-7]{58,}$",
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "policy": {
      "type": "string"
    },
    "provenance": {
      "enum": [
        "live",
        "replayed",
        "simulated"
      ],
      "type": "string"
    },
    "provider_bound": {
      "const": false,
      "type": "boolean"
    },
    "schema": {
      "const": "ipfs-accelerate.proof-context.v0.1/cli-output",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "type": "string"
    },
    "sibling_layout_required": {
      "const": false,
      "type": "boolean"
    },
    "status": {
      "enum": [
        "succeeded",
        "rejected",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "model_escalation_required",
        "human_review_required",
        "unavailable",
        "timeout",
        "cancelled",
        "invalid",
        "stale",
        "simulated",
        "infrastructure_failure",
        "partial_effect",
        "repair_required"
      ],
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "contract_version",
    "status",
    "exit_code",
    "trace_id",
    "correlation_id",
    "identities",
    "artifact_cids"
  ],
  "schema": "ipfs-accelerate.proof-context.v0.1/cli-output",
  "schema_version": "0.1",
  "title": "PCCE CLI command output@0.1",
  "type": "object"
}
