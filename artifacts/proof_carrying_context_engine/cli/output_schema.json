    "seal"
  ],
  "x-pcce-interface": "ProofContextCLI@0.1",
  "x-pcce-live-success-exit-code": 0,
  "x-pcce-nonzero-provenances": [
    "simulated",
    "replayed"
  ],
  "x-pcce-pcce-006-content-id": "sha256:b5503d2c2ec22e34091b3f747241fbde0519a9f0b213a03e0456a8f980a43f37",
  "x-pcce-identity-fields": [
    "repository_id",
    "repository_state_cid",
    "task_id",
    "run_id",
    "trace_id",
    "patch_id",
    "evidence_cid",
    "artifact_id"
  ],
  "x-pcce-required-identity-fields": [
    "repository_id",
    "task_id",
    "run_id",
    "patch_id"
  ],
  "x-pcce-required-output-fields": [
    "schema",
    "schema_version",
    "status",
    "exit_code",
    "correlation_id",
    "trace_id",
    "identities",
    "artifact_cids"
  ],
  "x-pcce-schema": "ipfs-accelerate.proof-context.v0.1/cli-output",
  "x-pcce-status-taxonomy-content-id": "sha256:5f206feebb6213d3a1c113e37373ac8402003170cea609035ec9b871ca9fdd19"
}
