    "profile": "sorted-key compact JSON with no insignificant whitespace",
    "duplicate_keys_forbidden": true,
    "floating_point_forbidden": true,
    "non_finite_numbers_forbidden": true,
    "content_identity": "sha2-256 over canonical UTF-8 policy bytes",
    "stored_self_identity": false
  },
  "contract_bindings": {
    "control_authorities": [
      "read",
      "proposal",
      "mutation"
    ],
    "dispositions": [
      "closed_deterministic",
      "residual_llm_authorized",
      "abstain_review",
      "defer_capability"
    ],
    "operation_authority_contract": "OperationAuthority",
    "implementation_disposition_contract": "ImplementationDisposition@1",
    "residual_llm_packet_contract": "ResidualLlmPacket@1",
    "reuse_existing_control_permits": true,
    "reuse_existing_completion_authority": true,
    "new_authority_lattice_forbidden": true
  },
  "defaults": {
