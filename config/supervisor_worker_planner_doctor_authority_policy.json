      "semantic_authority": "disposition_only",
      "mutation_authority": false,
      "completion_authority": false,
      "llm_authorization_authority": "residual_packet_only"
    },
    {
      "name": "independent_validation",
      "order": 3,
      "sources": [
        "independent_validation_runner",
        "merge_admission",
        "fixed_point_gate"
      ],
      "may": [
        "accept_or_reject_candidate_effects",
        "emit_validation_receipt"
      ],
      "may_not": [
        "authorize_write_alone",
        "claim_goal_completion_alone",
        "upgrade_provider_prose_to_pass"
      ],
      "semantic_authority": "validation_receipt_only",
      "mutation_authority": false,
      "completion_authority": false,
      "llm_authorization_authority": false
    },
    {
      "name": "completion_gate",
      "order": 4,
      "sources": [
        "existing_goal_completion_contract",
        "replayed_terminal_receipt"
      ],
      "may": [
        "evaluate_fresh_acceptance_evidence"
      ],
      "may_not": [
        "accept_provider_prose_as_completion",
        "accept_task_status_as_completion",
        "accept_candidate_self_certification"
      ],
      "semantic_authority": "existing_completion_contract_only",
      "mutation_authority": false,
      "completion_authority": "existing_goal_completion_contract",
      "llm_authorization_authority": false
    }
  ],
