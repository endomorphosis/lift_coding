    "doctor_mode": "report_only",
    "rollout_mode": "shadow",
    "mutation_authorized": false,
    "automatic_promotion_enabled": false,
    "derived_refill_enabled": false,
    "completion_authoritative": false,
    "llm_residual_enabled_by_default": false,
    "unknown_or_unsupported_disposition": "abstain_review",
    "ambiguous_disposition": "abstain_review"
  },
  "authority_ladder": [
    {
      "name": "nomination",
      "order": 0,
      "sources": [
        "ast_index",
        "bm25",
        "embedding",
        "graphrag",
        "history",
        "llm_output",
        "provider_prose",
        "synthetic_fixture",
        "vector_index"
      ],
      "may": [
        "discover",
        "rank",
        "retrieve",
        "suggest_candidate",
        "suggest_repair"
      ],
      "may_not": [
        "admit",
        "authorize_llm_call",
        "authorize_write",
        "certify_self",
        "claim_completion",
        "promote"
      ],
      "semantic_authority": false,
      "mutation_authority": false,
      "completion_authority": false,
      "llm_authorization_authority": false
    },
    {
      "name": "observation",
      "order": 1,
      "sources": [
        "independent_parser_rebuild",
        "independent_static_analysis",
        "independent_test",
        "runtime_trace",
        "validation_runner"
      ],
      "may": [
        "record_bounded_fact",
        "record_counterexample_candidate",
        "support_validation"
      ],
      "may_not": [
        "authorize_llm_call",
        "authorize_write",
        "claim_completion",
        "upgrade_own_assurance"
      ],
      "semantic_authority": false,
      "mutation_authority": false,
      "completion_authority": false,
      "llm_authorization_authority": false
    },
    {
      "name": "pre_implementation_kernel",
      "order": 2,
      "sources": [
        "deterministic_doctor",
        "formal_planner",
        "pre_implementation_kernel",
        "proof_carrying_planner"
      ],
      "required_bindings": [
        "doctor_disposition_cid",
        "evidence_roots",
        "forest_roots",
        "plan_admission_cid",
        "policy_revision",
        "task_cid"
      ],
      "may": [
        "emit_closed_deterministic_disposition",
        "emit_residual_llm_authorized_disposition",
        "emit_abstain_or_defer_disposition",
        "seal_residual_llm_packet"
      ],
      "may_not": [
        "authorize_free_form_provider_call",
        "claim_completion",
        "mutate_without_permit",
        "self_certify_kernel_receipt"
