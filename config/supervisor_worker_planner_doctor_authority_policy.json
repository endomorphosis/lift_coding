  "forbidden_transitions": [
    {
      "id": "unauthorized_llm_call",
      "description": "Any provider/LLM invocation when disposition is not residual_llm_authorized",
      "disposition": "reject"
    },
    {
      "id": "deterministic_mode_network_or_llm",
      "description": "Deterministic Doctor or closed_deterministic path loads network clients, remote embeddings, or LLM routers",
      "disposition": "reject"
    },
    {
      "id": "completion_from_prose",
      "description": "Provider prose, exit codes, or synthetic Doctor success flags used as completion authority",
      "disposition": "reject"
    },
    {
      "id": "free_reprompt_after_typed_failure",
      "description": "Free-form re-prompt that omits a sealed residual packet after a typed validation/scope/proof failure",
      "disposition": "reject"
    },
    {
      "id": "candidate_or_self_certification_to_authority",
      "description": "Candidate or model supplies its own receipt, floor, policy, or completion claim as authority",
      "disposition": "reject"
    },
    {
      "id": "write_without_mutation_permit",
      "description": "Repository or authoritative-state write without permit, lease, fence, and exact roots",
      "disposition": "reject"
    },
    {
      "id": "candidate_work_to_protected_anchor_mutation",
      "description": "Candidate edits protected WPD control, policy, scheduler, or threat-model anchors",
      "disposition": "reject_quarantine_and_escalate"
    },
    {
      "id": "provider_or_retrieval_result_to_semantic_authority",
      "description": "Retrieval score, embedding, or model text treated as admitted semantic truth",
      "disposition": "reject"
    },
    {
      "id": "task_count_or_task_status_to_completion",
      "description": "Board task counts or completed rows treated as goal completion",
      "disposition": "reject"
    },
    {
      "id": "false_analytical_close_without_byte_mutation",
      "description": "closed_deterministic success without real byte change when mutation was claimed",
      "disposition": "reject"
    }
  ],
