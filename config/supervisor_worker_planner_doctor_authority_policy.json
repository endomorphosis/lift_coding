{
  "schema": "ipfs_accelerate_py.agent_supervisor.worker_planner_doctor.authority_policy@1",
  "interface": "WorkerPlannerDoctorAuthorityPolicy@1",
  "policy_revision": "1",
  "board_namespace": "agent-supervisor-worker-planner-doctor-v1",
  "task_id": "WPD-003",
  "lifecycle": {
    "completion_mode": "manual",
    "self_sealing_forbidden": true,
