"""Explicit prospective control-plane authority; original final freeze is history.

This module only reads exact metadata and source bytes. Actual liveness, PID
birth, FD/inode/kernel flock, expiry and available capacity remain checked by
the unchanged resource_reservation function in native_final_gate.py.
"""
import hashlib,importlib.util,json,os,stat,sys
from pathlib import Path

ACTIVATION_SHA='a79cb456abf20fef034e70261509075c181540ce13aa1a588fced63cae934b05'
BATCH_SHA='ef9d30f50d8e45ac0a63f24777ed6b9cef03360b7a7d7ea0f70cf4d0201e0418'
FREEZE_SHA='7175ca68247d958dabf83a97441fe6042d3b88feafa74f95c76e1720cc74fa1a'
