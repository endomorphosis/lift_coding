            require(result['signature_and_scope_verified'] is True and result['useful_completion']==row['useful_completion'] and result['response_sha256']==entry['terminal_sha256'],'Actual final signature/resource/outcome join differs')
            original=result['receipt'];require(digest(public[cid]['proposal.json' if row['original_receipt_filename']=='proposal_result.json' else 'response.json'])==row['original_signed_receipt_sha256'],'Original signed receipt identity differs')
            require(original['cell_id']==cid and original['inert_qualification'] is False and original['final_scientific_run'] is True,'Fixture cannot enter actual bundle')
            scoring=not result.get('terminal_failure',False) or result.get('failure_disposition',{}).get('classification')=='known_scorer_failure'
