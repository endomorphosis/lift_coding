def reconstruct_patch(cb,payload,baseline):
    """Same deterministic adapter diff, reading only changed public preimages.

    Never extract or execute an archive, and never inspect an oracle/reference.
    The exact generated bytes must match the original signed candidate binding.
    """
    changed=sorted(cb['changed_paths'])
    if not changed:return b''
    archive=read_bytes(baseline['archive']['path'],baseline['archive']['sha256'],64<<20)
    old={};seen=set();count=0;total=0
    with tarfile.open(fileobj=io.BytesIO(archive),mode='r:gz') as tf:
        for member in tf:
            count+=1;require(count<=20000,'Public archive member bound exceeded')
            parts=Path(member.name).parts;require(parts and not member.name.startswith('/'),'Unsafe public archive name')
            if len(parts)==1:continue
            rel=str(safe_rel('/'.join(parts[1:])));require(rel not in seen,'Duplicate public archive path');seen.add(rel)
            if rel not in changed:continue
            spec=baseline['proposal_files'][rel]
            require(member.isfile() and spec['kind']=='file' and member.size==spec['bytes'] and member.size<=16<<20,'Changed public preimage is not a bounded original file')
            total+=member.size;require(total<=64<<20,'Public preimage aggregate bound exceeded')
            with tf.extractfile(member) as stream:raw=stream.read(member.size+1)
            require(len(raw)==member.size and digest(raw)==spec['sha256'],'Public preimage bytes differ');old[rel]=raw
    require(set(old)==set(changed),'Required public preimage absent from exact archive')
    patch=b''
    for rel in changed:
        before=old[rel].decode('utf-8');after=payload['changed/'+rel].decode('utf-8');require('\0' not in before+after,'Binary source edit refused')
        lines=difflib.unified_diff(before.splitlines(keepends=True),after.splitlines(keepends=True),fromfile='a/'+rel,tofile='b/'+rel,n=3)
        patch+=('diff --git a/'+rel+' b/'+rel+'\n'+''.join(line if line.endswith('\n') else line+'\n\\ No newline at end of file\n' for line in lines)).encode()
        require(len(patch)<=16384,'Original 16KiB patch budget exceeded')
    return patch

def candidate_guard(row,body,entry,baseline,public_cell,*,patch_raw=None):
    """Check only declared sealed public edit bytes and their signed commitments."""
    candidate_sha=body.get('candidate_sha256')
    if candidate_sha is None:
        require(entry=={'candidate_present':False,'reason':'no_candidate_in_original_signed_receipt'},'Missing candidate must remain explicit');return {}
    require(entry['candidate_present'] is True and entry['public_edit_payloads_only'] is True,'Retained actual candidate bytes required')
    binding_raw=read_bytes(entry['candidate_binding']['path'],entry['candidate_binding']['sha256']);cb=json.loads(binding_raw);files=cb['files']
    require(len(cb['changed_paths'])==len(set(cb['changed_paths'])) and type(cb['patch_bytes']) is int,'Malformed candidate path/patch metadata')
    require(cb['sha256']==candidate_sha==digest(canonical(files)),'Actual sealed candidate inventory identity differs')
    require(baseline['public_repository_source_only'] is True and baseline['oracle_or_reference_patch_included'] is False,'Public baseline custody required')
    require(set(files)==set(baseline['proposal_files']) and set(cb['changed_paths'])<=set(baseline['allowed_edit_paths']),'Candidate exceeds original public edit authority')
    changed={k for k in files if files[k]!=baseline['proposal_files'][k]};require(changed==set(cb['changed_paths'])==set(entry['changed_files']),'Exact changed public-file set differs')
    for p in files:
        safe_rel(p);require(files[p]['kind']==baseline['proposal_files'][p]['kind'] and files[p].get('mode')==baseline['proposal_files'][p].get('mode'),'Candidate type/mode changed')
    review_name='operator_review.json'
    if review_name in public_cell:
        review=json.loads(public_cell[review_name]);rb=review['binding']
        require(rb['candidate_sha256']==candidate_sha and rb['patch_sha256']==cb['patch_sha256'] and rb['candidate_binding_sha256']==digest(canonical(cb)),'Candidate/patch is not the exact reviewed object')
        require(entry['review_scope']=='actual_retained_ai_candidate_review','Candidate review scope differs')
    else:
        require(row['disposition_class']=='known_proposal_failure' and body.get('scorer',{}).get('executed') is False and entry['review_scope']=='no_candidate_review_before_original_proposal_failure','Missing pre-score review cannot be invented')
    patch=patch_raw if patch_raw is not None else read_bytes(entry['patch']['path'],entry['patch']['sha256'],16384)
    require(digest(patch)==cb['patch_sha256'] and len(patch)==cb['patch_bytes'],'Exact retained patch payload required')
    require(sum(files[p].get('bytes',0) for p in changed)<=64<<20,'Per-cell candidate edit transport bound exceeded')
    result={'candidate_binding.json':binding_raw,'candidate.patch':patch}
    for rel,record in entry['changed_files'].items():
        require(files[rel]['kind']=='file','Changed symlink not admitted')
        raw=read_bytes(record['path'],record['sha256'],16<<20)
        require(record['sha256']==files[rel]['sha256'] and len(raw)==files[rel]['bytes'],'Changed file bytes differ from sealed signed inventory')
        result['changed/'+rel]=raw
    require(patch==reconstruct_patch(cb,result,baseline),'Patch does not reconstruct exact changed public bytes')
    return result


