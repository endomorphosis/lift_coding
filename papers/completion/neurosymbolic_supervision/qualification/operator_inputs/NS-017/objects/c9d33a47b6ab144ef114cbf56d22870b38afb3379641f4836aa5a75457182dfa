+def _adjust_for_long_path(pathname: str) -> str:
+    """Fix for Windows issue with long paths.
+
+    If the path is too long, it is converted to an extended path by adding the
+    prefix `\\?\\`.
+    """
+    if _WINDOWS and len(pathname) >= 260:
+        return f"\\?\\{pathname}"
+    return pathname
+
