def rows():
    return [{'cell_id':A.cell_id(u,a,r),'unit':u,'arm':a,'repetition':r,'terminal':True,'useful_completion':False,'outcome':'constructed_failure',**{k:None for k in A.METRICS}}for u in A.UNITS for a in('A','B')for r in A.REPS]

def saved(p,v):
    p.parent.mkdir(mode=0o700,parents=True,exist_ok=True);p.write_text(json.dumps(v,sort_keys=True)+'\n');return {'path':str(p),'sha256':A.sha(p)}

