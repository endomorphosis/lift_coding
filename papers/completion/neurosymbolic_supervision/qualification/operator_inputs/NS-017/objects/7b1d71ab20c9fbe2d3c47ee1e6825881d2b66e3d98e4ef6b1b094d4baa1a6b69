            op,a,b,c,pc=terminal_fixture(Path(td));r=A.terminal_row(op,a,b,1,c,{},pc);self.assertTrue(r['useful_completion']);self.assertEqual(r['grant_to_terminal_elapsed_seconds'],720);self.assertEqual(r['client_poll_wall_seconds'],.02)
