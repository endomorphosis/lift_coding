class Analysis(unittest.TestCase):
    def test_fixed_eight_family_blocks_and_known_binomial_interval(self):
        r=rows()
        for x in r:
            i=A.UNITS.index(x['unit']);x['useful_completion']=(i<4)==(x['arm']=='B')
        s=A.summarize(r);self.assertEqual(s['useful_completions'],16);self.assertEqual(s['mean_B_minus_A_useful'],0);self.assertEqual(s['bootstrap']['quality_B_minus_A'],{'lower':-.75,'upper':.75,'degenerate':False});self.assertEqual(s['bootstrap']['draws_per_resample'],8);self.assertEqual(s['bootstrap']['resamples'],20000)
    def test_shared_pair_cost_constant_difference(self):
        r=rows()
        for x in r:
            for k in A.METRICS:x[k]=float(A.UNITS.index(x['unit'])+(2 if x['arm']=='B'else 0))
        s=A.summarize(r)
        self.assertEqual(s['bootstrap']['cost_B_minus_A']['provider_child_elapsed_seconds'],{'lower':2.0,'upper':2.0,'degenerate':True})
    def test_missing_family_cost_does_not_change_outcome_denominator(self):
        r=rows()
        for x in r:x['provider_child_elapsed_seconds']=0.0
        r[0]['provider_child_elapsed_seconds']=None;s=A.summarize(r)
        self.assertEqual(s['planned_cells'],32);self.assertEqual(s['paired_cost_family_coverage']['provider_child_elapsed_seconds']['complete_families'],7);self.assertNotIn('provider_child_elapsed_seconds',s['bootstrap']['cost_B_minus_A']);self.assertEqual(s['resource_summaries']['provider_child_elapsed_seconds']['missing_or_invalid_count'],1)
    def test_missing_all_is_not_zero_cost_or_completed_outcomes(self):
        r=rows()
        for x in r:x.update(terminal=False,outcome='unissued_pending')
        s=A.summarize(r);self.assertFalse(s['complete']);self.assertEqual(s['terminal_cells'],0);self.assertEqual(s['useful_fraction_fixed32'],0);self.assertIsNone(s['bootstrap']);self.assertIsNone(s['resource_summaries']['gateway_score_elapsed_seconds']['known_sum'])
    def test_genuine_constructed_zero_outcome_is_degenerate_not_promotion(self):
        s=A.summarize(rows());self.assertTrue(s['complete']);self.assertTrue(s['bootstrap']['quality_B_minus_A']['degenerate']);self.assertIn('does not establish',s['bootstrap']['interpretation'])
    def test_duplicate_cell_refused(self):
        r=rows();r[-1]=r[0].copy()
        with self.assertRaises(ValueError):A.summarize(r)
    def test_missing_repetition_refused(self):
        with self.assertRaises(ValueError):A.summarize(rows()[:-1])
    def test_wrong_repetition_identity_refused(self):
        r=rows();r[0]['repetition']=0
        with self.assertRaises(ValueError):A.summarize(r)
    def test_missing_cell_cannot_claim_useful(self):
        r=rows();r[0].update(terminal=False,useful_completion=True)
        with self.assertRaises(ValueError):A.summarize(r)
    def test_nonfinite_negative_and_boolean_costs_missing(self):
        s=A.measured([None,float('nan'),float('inf'),-1,False,0,2]);self.assertEqual(s['known_sum'],2);self.assertEqual(s['known_count'],2);self.assertEqual(s['missing_or_invalid_count'],5)
    def test_quantile_uses_linear_interpolation(self):self.assertEqual(A.quantile([0,10],.025),.25)
    def test_timestamps_missing_or_negative_not_zero(self):
        self.assertIsNone(A.interval(None,None));self.assertIsNone(A.interval('2026-09-13T02:00:00+00:00','2026-09-13T01:00:00+00:00'));self.assertEqual(A.interval('2026-09-13T01:00:00+00:00','2026-09-13T01:00:00+00:00'),0)
    def test_actual_final_client_resource_function_controls(self):
        pc=A.load_client();body={'proposal_resource_measurements':{'provider_child_seconds':595,'http_wrapper_seconds':600,'gateway_proposal_seconds':600},'score_elapsed_seconds':120};self.assertTrue(pc.resource_compliance(body)['compliant']);body['proposal_resource_measurements']['http_wrapper_seconds']=618.5;self.assertFalse(pc.resource_compliance(body)['compliant']);body['proposal_resource_measurements']['http_wrapper_seconds']=None;self.assertIn('http_wrapper_seconds',pc.resource_compliance(body)['unavailable'])
    def test_constructed_retained_terminal_full_path_at_exact_caps(self):
