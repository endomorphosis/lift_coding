        with tempfile.TemporaryDirectory()as td:
            p=Path(td);h=saved(p/'proposal_result.json',{'fixture':True})['sha256'];d={'classification':'candidate_rejected','original_filename':'proposal_result.json','original_receipt_sha256':h,'binding':{'original_receipt_sha256':h}};self.assertEqual(A.original_terminal_path(p,d),p/'proposal_result.json');d['binding']['original_receipt_sha256']='0'*64
            with self.assertRaises(ValueError):A.original_terminal_path(p,d)
