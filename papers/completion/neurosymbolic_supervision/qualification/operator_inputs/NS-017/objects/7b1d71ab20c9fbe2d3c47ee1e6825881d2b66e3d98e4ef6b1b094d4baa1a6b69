            op,a,b,c,pc=terminal_fixture(Path(td));b['units'][A.UNITS[0]]['arms']['A']['profile_sha256']='0'*64
            with self.assertRaises(ValueError):A.terminal_row(op,a,b,1,c,{},pc)
