        with tempfile.TemporaryDirectory()as td:
            p=Path(td);h=saved(p/'plain.json',{'fixture':True})['sha256'];(p/'link.json').symlink_to(p/'plain.json')
            with self.assertRaises(ValueError):A.read(p/'link.json',{},h)
            with self.assertRaises(ValueError):A.read(p/'plain.json',{},'0'*64)
    def test_nonfinite_serialization_retains_null_not_zero(self):
        with tempfile.TemporaryDirectory()as td:
            p=Path(td)/'out.json';A.write(p,{'measured':float('nan')});self.assertIsNone(json.loads(p.read_text())['measured'])
    def test_pending_observed_costs_retained_without_terminal_credit(self):
        with tempfile.TemporaryDirectory()as td:
            op,a,b,c,pc=terminal_fixture(Path(td));r=A.pending_row(a,1,c,{})
            self.assertFalse(r['terminal']);self.assertFalse(r['useful_completion']);self.assertEqual(r['provider_child_elapsed_seconds'],595);self.assertEqual(r['actual_provider_posts'],1)
