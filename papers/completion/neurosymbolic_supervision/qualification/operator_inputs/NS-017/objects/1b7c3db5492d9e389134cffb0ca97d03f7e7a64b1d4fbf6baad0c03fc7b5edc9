def now():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def write(path, raw, mode=0o600):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    fd = os.open(Path(path).parent, os.O_RDONLY | os.O_DIRECTORY)
    os.fsync(fd)
    os.close(fd)


def record(path, value):
    write(path, (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode())


def run(name, argv):
    target = HERE / name
    target.mkdir(mode=0o700)
    record(target / 'plan.private.json', {
        'at': now(), 'argv': argv, 'operator_script_sha256': sha(__file__),
        'activation_sha256': ACTIVATION, 'automatic_retry': False,
        'authoring_claim_execution': False,
    })
    started = time.monotonic()
    with (target / 'stdout.private.json').open('xb') as out, (target / 'stderr.private.txt').open('xb') as err:
        try:
            result = subprocess.run(argv, stdout=out, stderr=err)
        except BaseException as exc:
            out.flush(); err.flush(); os.fsync(out.fileno()); os.fsync(err.fileno())
            record(target / 'execution.private.json', {
                'at': now(), 'exit_code': None, 'exception_class': type(exc).__name__,
                'elapsed_host_wall_seconds': time.monotonic() - started,
                'pending': 'phase_outcome_unknown_requires_exact_reconciliation',
                'stdout_sha256': sha(target / 'stdout.private.json'),
                'stderr_sha256': sha(target / 'stderr.private.txt'),
                'automatic_retry': False,
            })
            raise
        out.flush(); err.flush()
        os.fsync(out.fileno()); os.fsync(err.fileno())
    record(target / 'execution.private.json', {
        'at': now(), 'exit_code': result.returncode,
        'elapsed_host_wall_seconds': time.monotonic() - started,
        'stdout_sha256': sha(target / 'stdout.private.json'),
        'stderr_sha256': sha(target / 'stderr.private.txt'),
        'automatic_retry': False,
    })
    require(result.returncode == 0, 'phase failed; retained evidence requires reconciliation, no replay: ' + name)
    return load(target / 'stdout.private.json')


