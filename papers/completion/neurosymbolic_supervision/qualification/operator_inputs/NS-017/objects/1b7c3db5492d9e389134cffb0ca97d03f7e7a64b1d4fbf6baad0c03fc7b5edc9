def require(ok, message):
    if not ok:
        raise ValueError(message)


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def read_json_bytes(path):
    path = Path(path)
    require(path.is_absolute() and path.resolve() == path, 'canonical input required')
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        require(stat.S_ISREG(info.st_mode) and info.st_size <= 16*1024*1024, 'bounded JSON input required')
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            raw = stream.read(16*1024*1024+1)
    finally:
        os.close(fd)
    require(len(raw) <= 16*1024*1024, 'JSON input grew')
    return raw


def load(path):
    return json.loads(read_json_bytes(path))


def bound(binding):
    require(isinstance(binding, dict) and set(binding) >= {'path','sha256'}
            and re.fullmatch('[a-f0-9]{64}', binding['sha256']) is not None, 'exact path/hash binding required')
    raw = read_json_bytes(binding['path'])
    require(hashlib.sha256(raw).hexdigest() == binding['sha256'], 'input changed: '+binding['path'])
    return json.loads(raw)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',',':'), allow_nan=False).encode()


def cell_id(unit, arm, repetition):
    require(unit in UNITS and arm in ('A','B') and type(repetition) is int
            and repetition in (104729,130363), 'fixed final cell identity differs')
    return hashlib.sha256(canonical({'unit':unit,'arm':arm,'cache':'local_cold',
                                     'repetition':repetition,'record_kind':'final'})).hexdigest()


