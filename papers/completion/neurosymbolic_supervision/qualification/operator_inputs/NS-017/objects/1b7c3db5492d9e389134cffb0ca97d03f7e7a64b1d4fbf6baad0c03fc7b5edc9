                require(sha(old[key]['path']) == old[key]['sha256'], 'retained terminal observation changed')
            print(json.dumps({'terminal': True, 'retained_record': str(terminal), 'sha256': sha(terminal),
                              'new_client_execution': False, 'new_provider_calls': 0, 'new_scorer_calls': 0}))
            return
        admission = HERE / (tag + '_client_admission.private.json')
        n = 1
        while (HERE / (tag + '_client_poll%03d' % n)).exists():
            n += 1
        output = HERE / (tag + '_client_poll%03d' % n)
        value = run(tag + '_poll_command%03d' % n, [PY, '-B', str(DRIVER / 'launch.py'),
            '--package-sha256', PACKAGE, '--admission', str(admission), '--admission-sha256', sha(admission),
            '--output', str(output)])
        execution = load(output / 'execution.private.json')
        body = load(output / 'work/result.json')
        require(execution['success'] is True and execution['cleanup_exit_code'] == 0, 'client cleanup unproven')
        if body.get('terminal') is True:
            require(body['batch_sha256'] == a['batch']['sha256'] and len(body['results']) == 1
                    and body['results'][0]['cell_id'] == cell, 'terminal cell differs')
            verified = body['results'][0]['result']['host_verified']
