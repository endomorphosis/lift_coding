        before = json.loads(before_raw)
        old_drop = worker / before['final_host_handoff']['offer_drop_relative']
        old_drop_hash = sha(old_drop) if index else None
        if index:
            require(old_drop_hash == before['final_host_handoff']['offer_drop_sha256'], 'previous offer history changed')
            require({b['cell_id'] for b in load(old_drop)['bindings']} == set(a['ordered_cells'][:index]),
                    'previous offer history differs from fixed prefix')
        else:
            require(old_drop.parent.is_dir(), 'root must prepare exact empty final offer directory before grants')
            require(not old_drop.exists() and before['final_host_handoff']['offer_drop_sha256'] is None
                    and before['final_host_handoff']['scientific_activation_review_sha256'] is None
                    and before['final_host_handoff']['final_freeze_sha256'] is None,
                    'first cell requires fresh inactive profile and no old offer')
        result = run(tag + '_prepare', [PY, '-B', str(gateway), 'prepare',
            '--private', str(private), '--queue', str(queue), '--repo', a['native_repo'],
            '--registry', a['registry']['path'], '--registry-sha256', a['registry']['sha256'],
            '--unit', amendment['unit'], '--amendment', amendment['path'],
            '--amendment-sha256', amendment['sha256']])
        wave = HERE / ('wave%03d' % args.cell_number)
        built = run(tag + '_build_offer', [PY, '-B', str(builder), '--worker', str(worker),
