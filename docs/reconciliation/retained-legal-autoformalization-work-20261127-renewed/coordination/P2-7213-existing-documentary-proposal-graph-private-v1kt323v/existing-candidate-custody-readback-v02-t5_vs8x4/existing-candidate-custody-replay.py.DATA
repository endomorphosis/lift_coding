summary['executed_current_Git_matched_retained_files']=pinned_files
summary['retained_project_read_size_upper_from_open_events']=tracked_reads
summary['prior_adapt_and_budget_stop']={'path': '/tmp/codex-all-work-github-main-reconciliation-20261123-etm066qn/Phase8-existing-native-CI-trigger-repair-private-v01/coordination-full-goal-v02/P2-7213-existing-documentary-proposal-graph-private-v1kt323v/existing-candidate-custody-current-v01-bg57f4s2/attempt.stderr', 'bytes': 8263, 'sha256': '00e8c6fecb3d7c38a845e3878cde639429371f066746deddfd95a0dcf83045f4'}
summary['Parquet_export_run']=False
