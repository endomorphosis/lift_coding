    "source_inputs": {
      "fixture:mixed-act-v1/unit-1": {
        "extracted_text": "For this fictional Act, a covered officer means an officer appointed by the Board. Café.",
        "raw_bytes": {
          "$fixture_bytes_base64": "Rm9yIHRoaXMgZmljdGlvbmFsIEFjdCwgYSBjb3ZlcmVkIG9mZmljZXIgbWVhbnMgYW4gb2ZmaWNlciBhcHBvaW50ZWQgYnkgdGhlIEJvYXJkLiBDYWbDqS4="
        }
      },
      "fixture:mixed-act-v1/unit-2": {
        "extracted_text": "Every covered officer must file a report unless the Board expressly excuses that officer.",
        "raw_bytes": {
          "$fixture_bytes_base64": "RXZlcnkgY292ZXJlZCBvZmZpY2VyIG11c3QgZmlsZSBhIHJlcG9ydCB1bmxlc3MgdGhlIEJvYXJkIGV4cHJlc3NseSBleGN1c2VzIHRoYXQgb2ZmaWNlci4="
        }
      },
      "fixture:mixed-act-v1/unit-3": {
        "extracted_text": "For every officer, supervisor, event, and time, if both people are covered officers, that officer may inspect the register under that supervisor at that event and time.",
        "raw_bytes": {
          "$fixture_bytes_base64": "Rm9yIGV2ZXJ5IG9mZmljZXIsIHN1cGVydmlzb3IsIGV2ZW50LCBhbmQgdGltZSwgaWYgYm90aCBwZW9wbGUgYXJlIGNvdmVyZWQgb2ZmaWNlcnMsIHRoYXQgb2ZmaWNlciBtYXkgaW5zcGVjdCB0aGUgcmVnaXN0ZXIgdW5kZXIgdGhhdCBzdXBlcnZpc29yIGF0IHRoYXQgZXZlbnQgYW5kIHRpbWUu"
        }
      }
    }
  }
