assert not any(node.find(tag) is not None for node in tests for tag in ('failure','error','skipped'))
counts=Counter(node.attrib['classname'].replace('.','/')+'.py' for node in tests)
functions=Counter((node.attrib['classname'],node.attrib['name'].partition('[')[0]) for node in tests)
assert counts==qualified['file_case_counts'] and len(counts)==5
assert len(functions)==43 and list(functions.values())==qualified['function_count_vector']
