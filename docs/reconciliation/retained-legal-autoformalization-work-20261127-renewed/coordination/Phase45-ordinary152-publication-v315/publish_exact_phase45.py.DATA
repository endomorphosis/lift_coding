    'actual_parent_release_return','actual_COLLECT_RUN_JUnit_order_exact','fourteen_current_Source_module_bindings'))
assert all(qualified[key]==0 for key in ('owned_operator_exit_code','errors','failures','skips','duplicates'))
tests=list(ET.fromstring(checked_ref(qualified['raw_JUnit'])).iter('testcase'))
