assert [x['attempt'] for x in qualified['retained_failed_normal_attempts']]==['v311','v312','v313','v314']
assert all(x['full_Source128_retained'] for x in qualified['retained_failed_normal_attempts'])
freeze=json.loads(checked_ref(qualified['freeze']))
source=json.loads(checked_ref(qualified['actual_SourceWRITE8']))
packet=freeze['candidate_packet']
assert packet['sha256']=='9ea2b698b477c4a15b6e7aaa78afe24b3d69bf840d92ef480d28047470587524'
candidate=json.loads(checked_ref(packet))['targets']
assert source['Source_closed'] and source['module_closed'] and not source['errors']
assert freeze['D_local_HEAD']==target and freeze['D_parent']==base['datasets']
assert freeze['D_tree']==qualified['D_tree']
rows=freeze['exact_committed_files']
installed={str(Path(row['path']).relative_to(repos/'datasets')):row for row in source['installed']}
assert len(rows)==8 and sum(path.startswith('tests/') for path in rows)==4
assert set(rows)==set(installed)==set(candidate)==set(source['only_worktree_deltas'])

def snapshot_index(role):
    path=repos/role/'.git/index'
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as stream:
        before={k:str(getattr(os.fstat(stream.fileno()),k)) for k in fields}
        sha=hashlib.file_digest(stream,'sha256').hexdigest()
        after={k:str(getattr(os.fstat(stream.fileno()),k)) for k in fields}
    assert before==after=={k:str(getattr(path.lstat(),k)) for k in fields}
    return {'path':str(path),'bytes':int(after['st_size']),'sha256':sha,'full9':after}

for role,expected in base.items():
    assert revision(role)==(target if role=='datasets' else expected)
    assert revision(role,'refs/remotes/origin/main')==expected
    assert observe(role,'remote','get-url','origin').decode().strip().removesuffix('.git')==urls[role]
    assert observe(role,'remote','get-url','--push','origin').decode().strip().removesuffix('.git')==urls[role]
    assert origin(role)==expected
    clean(role)
indices_before={role:snapshot_index(role) for role in base}
assert indices_before['datasets']==freeze['D_index_frozen']
for role,meta in freeze['other_roots_preserved'].items():
    assert revision(role,'HEAD^{tree}')==meta['tree']
    assert indices_before[role]['full9']==meta['index_full9']
assert revision('datasets','HEAD^')==base['datasets']
assert revision('datasets','HEAD^{tree}')==qualified['D_tree']
before_tree=rows_at('datasets',base['datasets'])
after_tree=rows_at('datasets',target)
assert set(before_tree)==set(after_tree)
assert {path for path in before_tree if before_tree[path]!=after_tree[path]}==set(rows)
for path,row in rows.items():
    spec=candidate[path]
    oid=row['stage0_and_committed_blob']
    mode=row['git_mode']
    assert row['previous_blob']==spec['current_git_blob']==before_tree[path][2]
    assert mode==before_tree[path][0]=='100644' and oid==spec['candidate_git_blob']
    assert after_tree[path]==(mode,'blob',oid)
    assert row['sha256']==spec['after']['sha256'] and row['bytes']==spec['after']['bytes']
    assert all(row[key]==installed[path][key] for key in ('path','bytes','sha256','full9'))
    assert {name:str(getattr(Path(row['path']).lstat(),name)) for name in fields}==row['full9']
    stage=observe('datasets','ls-files','--stage','--',path).decode().rstrip(chr(10))
    assert stage==f'{mode} {oid} 0'+chr(9)+path
    raw=observe('datasets','cat-file','blob',oid)
    assert len(raw)==row['bytes'] and hashlib.sha256(raw).hexdigest()==row['sha256']
record({'preflight_exact':True,'before_remotes':base,'qualified_D':target,'ordinary_unique_tests':len(tests)})

