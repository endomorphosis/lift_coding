    clean(role)
    reconciled[role]={'HEAD':oid,'tree':revision(role,'HEAD^{tree}'),'origin_main':verified,
                     'clean_worktree_and_index':True,'origin':urls[role],'gitlinks_updated':links[role]}
exact_gitlinks('hallucinate',base['hallucinate'],h,h_links)
exact_gitlinks('root',base['root'],root,root_links)
indices_after={role:snapshot_index(role) for role in base}
assert indices_after['datasets']==indices_before['datasets']
assert indices_after['accelerate']==indices_before['accelerate']
