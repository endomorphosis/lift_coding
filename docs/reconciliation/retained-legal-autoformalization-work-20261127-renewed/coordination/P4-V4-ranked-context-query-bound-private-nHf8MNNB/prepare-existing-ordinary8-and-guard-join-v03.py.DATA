assert len(guard)==1623
for target in candidate["files"].values():
    path=str(d/target["path"])
    row=guard[path]
    assert target["canonical_before_full9"]==row["full9"]==f9(Path(path).lstat())
    assert row["sha256"]==target["before"]["sha256"] and row["bytes"]==target["before"]["bytes"]
    assert auth(target["before"])==git("cat-file","blob",target["before"]["git_blob"])
module_paths={k:k.replace(".","/")+".py" for k in owner_roles}
module_paths.update({v:k for k,v in test_modules.items()})
positive=json.loads(read(here/"after-adapter-positive.stdout"))
required_roles={}
for name,relative in module_paths.items():
    row=guard[str(d/relative)]
    assert row["full9"]==f9((d/relative).lstat()) and "sha256" in row
    post=next((target["after"] for target in candidate["files"].values()
                if target["path"]==relative),None)
    if post is None:
        proof=positive["read_only_project_module_sources"][name]
        assert proof["relative_path"]==relative and proof["sha256"]==row["sha256"]
        expected={k:row[k] for k in ("bytes","sha256")}
    else:
        expected={k:post[k] for k in ("bytes","sha256")}
    required_roles[name]={"relative_path":relative,**expected,"actual_Source_full9":None}

