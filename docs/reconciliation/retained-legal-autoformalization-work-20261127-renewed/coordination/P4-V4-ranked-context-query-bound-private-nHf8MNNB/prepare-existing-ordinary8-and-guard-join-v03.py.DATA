from pathlib import Path
import ast
import hashlib
import json
import os
import re
import stat
import subprocess
from types import SimpleNamespace

here=Path(__file__).resolve().parent
coord=here.parent
out=here/"existing-ordinary8-INERT-v03"
out.mkdir(mode=0o700)
d=here.parents[2]/"repositories/datasets"
old=Path("/tmp/P4-extracted-view-ordinary9-existing-R2-INERT-xvc6ai4j")
def sha(raw):
    return hashlib.sha256(raw).hexdigest()
def f9(info):
    return {f:str(getattr(info,f)) for f in ("st_dev","st_ino","st_mode","st_nlink","st_uid",
        "st_gid","st_size","st_mtime_ns","st_ctime_ns")}
def read(p):
    fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(fd,"rb") as f:
        before=os.fstat(f.fileno())
        assert stat.S_ISREG(before.st_mode) and before.st_nlink==1
        raw=f.read()
        assert len(raw)==before.st_size and f9(before)==f9(os.fstat(f.fileno()))==f9(p.lstat())
    return raw
def ref(p,digest=None):
    raw=read(p); s=sha(raw)
    if digest is not None:
        assert s==digest
    return dict(path=str(p),bytes=len(raw),sha256=s)
def auth(x):
    raw=read(Path(x["path"]))
    assert (len(raw),sha(raw))==(x["bytes"],x["sha256"])
    return raw
def put(name,raw):
    p=out/name
    with os.fdopen(os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400),"wb") as f:
        f.write(raw);f.flush();os.fsync(f.fileno())
    assert read(p)==raw
    return ref(p)
def obj(name,data):
    return put(name,(json.dumps(data,indent=2,sort_keys=True)+"\n").encode())
def get(code,key):
    values=[n.value for n in ast.parse(code).body if isinstance(n,ast.Assign)
            and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id==key]
    assert len(values)==1,(key,len(values))
    return ast.literal_eval(values[0])
def assign(code,key,value):
    n,=[n for n in ast.parse(code).body if isinstance(n,ast.Assign)
        and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id==key]
    lines=code.splitlines(keepends=True)
    lines[n.lineno-1:n.end_lineno]=[f"{key} = {value!r}\n"]
    return "".join(lines)
def replace(code,a,b,count=1):
    assert code.count(a)==count,(a,code.count(a))
    return code.replace(a,b)
env={**os.environ,"GIT_OPTIONAL_LOCKS":"0","GIT_NO_LAZY_FETCH":"1"}
def git(*args):
    return subprocess.check_output(["git","-c","core.preloadIndex=false","-c","index.threads=1","-C",str(d),*args],env=env)
candidate_ref=ref(here/"SEALED-V4-ranked-context-query-count-exact-two.json",
                   "830258edd624af25e432e7cb17aa3e896d15c6dc921541dbd0b76d62a4e25dae")
