old_packet=ref(old/"READY-P4-extracted-view-ordinary9-existing-R2-INERT-RootNULL.json",
               "53e6325a49d8b32a7e75c475f9f62828152a0ea93e28082e4542baafdbb980bd")
prior=json.loads(auth(old_packet))
old_recipe=json.loads(auth(prior["future_Root_bindings"]))
old_specs=prior["controls"]
head,tracking=git("rev-parse","HEAD","refs/remotes/origin/main").decode().splitlines()
assert head==tracking==candidate["observed_local_tip_and_tracking_tip"]
assert not git("status","--porcelain=v1","--untracked-files=all")
base_source={k:auth(v).decode() for k,v in old_specs.items()}
group="Phase4-ranked-context-query-bound-ordinary8"
controls={k:v.replace(prior["group"],group) for k,v in base_source.items()}
old_selection=get(controls["operator"],"SELECTION")
owner_roles=get(controls["operator"],"MAINTAINED_OWNER_NAMES")
test_modules=get(controls["operator"],"SELECTED_TEST_MODULES")
owner_test=candidate["files"]["test"]["path"]
assert list(test_modules)==[owner_test]
names=candidate["static_ordinary_inputs"]["functions"]
tree=ast.parse(auth(candidate["files"]["test"]["after"]))
selected={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names}
assert list(selected)==names
cases={}
for name,n in selected.items():
    dec,=n.decorator_list
    assert ast.unparse(dec.func)=="pytest.mark.parametrize"
    cases[name]=ast.literal_eval(dec.args[1])
assert list(cases.values())==[[None,"abstention","source","selected-body"],[0,1,32,33]]
selectors=[owner_test+"::"+name for name in names]
nodes=[owner_test+"::"+name+"["+str(v)+"]" for name,values in cases.items() for v in values]
counts=dict.fromkeys(selectors,4)
selection={**old_selection,"function_count":2,"literal_expected_cases":8,
    "function_selectors":selectors,"literal_expected_nodeids":nodes,"expected_function_case_counts":counts}
assert len(nodes)==len(set(nodes))==8
literal_roster=obj("independent-literal8-roster-DATA.json",{
    "schema":"ranked-context-ordinary8-independent-membership/v1",
    "source_candidate":candidate_ref,"selectors":selectors,"case_counts":counts,
    "exact_case_membership":nodes,"retained":4,"new":4,
    "literal_order_for_independent_membership_only":True,"actual_collect_and_run":None,
})
del selection["independent_literal9_roster_reference"]
selection["independent_literal8_roster_reference"]=literal_roster
o=assign(controls["operator"],"SELECTION",selection).replace("INERT P4 ordinary9","INERT P4 ordinary8")
o=assign(o,"EXPECTED_BRIDGE27_CASE_VECTOR",(4,4))
for x,y in (("['function_count'] == 5","['function_count'] == 2"),
            ("['literal_expected_cases'] == 9","['literal_expected_cases'] == 8"),
            ("len(set(_selectors)) == 5","len(set(_selectors)) == 2"),
            ("sum(_counts.values()) == 9","sum(_counts.values()) == 8"),
            ("len(set(_literal_ids)) == 9","len(set(_literal_ids)) == 8"),
            ("len(set(roster)) == 9","len(set(roster)) == 8"),
            ("literal9 nodeid","literal8 nodeid")):
    o=replace(o,x,y)
b=controls["bootstrap"]
for key,v in (("FUNCTION_SELECTORS",selectors),("EXPECTED_FUNCTION_CASE_COUNTS",counts),
    ("EXPECTED_ORDERED_CASE_COUNTS",(4,4)),("EXPECTED_CASES",8),
    ("LITERAL_EXPECTED_NODEIDS",nodes)):
    b=assign(b,key,v)
for x,y in (("len(function_selectors) != 5","len(function_selectors) != 2"),
            ("len(set(function_selectors)) != 5","len(set(function_selectors)) != 2"),
            ("5 future-bound software functions/9","2 future-bound software functions/8"),
            ("ordered5-selector case vector/9","ordered2-selector case vector/8")):
    b=replace(b,x,y)
f=replace(controls["factory"]," != 9"," != 8",2)
f=replace(f,"literal9 nodeid","literal8 nodeid")
f=replace(f,"5 independently selected software-function counts/9","2 independently selected software-function counts/8")
fref=put("existing-v350-ordinary8-factory.INERT.py.DATA",f.encode())
bref=put("existing-v350-ordinary8-bootstrap.INERT.py.DATA",b.encode())
o=assign(o,"FACTORY_REFERENCE",fref)
oref=put("existing-v350-ordinary8-operator.INERT.py.DATA",o.encode())
for kind,src,file in (("operator",o,oref),("bootstrap",b,bref),("factory",f,fref)):
    compile(src,file["path"],"exec",dont_inherit=True)
    assert not re.search(r"(?:=|==|!=) 9\b|literal9\b|ordered5-selector",src)
for key in old_recipe["operator_NULL_literal_slots"]:
    assert get(o,key) is None,key
for key in old_recipe["bootstrap_NULL_literal_slots"]:
