assert len(tool_calls)==2
shape=ref(coord/"P2-retained-qualification-component-binding-private-pZ1QE2WG/existing-Source2-Guide570-INERT-v02/READY-Guide570-existing-Source2-exact-component-evidence-NONSELECTED.json",
          "03cbb53316fc31a037fc95988aa06f8f03f8eb5147bc7c2dee325ec6b818a50a")
