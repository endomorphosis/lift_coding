assert run_request["expected_function_case_counts"]==get(b,"EXPECTED_FUNCTION_CASE_COUNTS")==counts
assert get(b,"EXPECTED_CASES")==len(nodes)==8
assert get(b,"EXPECTED_ORDERED_CASE_COUNTS")==tuple(counts.values())==(4,4)
assert json.loads(collect["input_files"]["request.json"])["expected_function_case_counts"]==counts
assert run["limits"]["cpu_seconds"]==540 and run["limits"]["resident_memory_bytes"]==4294967296
for broken in (nodes[:-1],[*nodes[:-1],nodes[0]],[*nodes[:-1],nodes[-1]+"foreign"]):
