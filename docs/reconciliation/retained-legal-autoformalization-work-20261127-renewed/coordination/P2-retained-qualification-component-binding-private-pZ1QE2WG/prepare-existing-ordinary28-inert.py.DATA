import ast
import difflib
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
from types import SimpleNamespace

root=Path(__file__).resolve().parent
out=root/"existing-ordinary28-INERT"
out.mkdir(mode=0o700)
source_root=Path("/tmp/P2-retained-type-review-UTC-SHA-existing-v528-ordinary25-INERT-oum3k0s9")
old_ready=source_root/"READY-existing-v528-retained-type-UTC-SHA-ordinary25-INERT.json"
packet_path=root/"SEALED-retained-V4-qualification-component-binding-exact-two.json"
success_root=Path("/tmp/P2-retained-type-review-ordinary25-v528-helpers-INERT-f65vnpjw")
marker="phase2-retained-type-current-review-metadata-ordinary25"
