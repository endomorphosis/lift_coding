        "span_sha256": "4d3d504e3ed18f7d5ed9db7531805e05ee10ddd0969d61a9ba3845c813c421a4",
        "span_text": "For this fictional Act, a covered officer means an officer appointed by the Board. Café.",
        "start_char": 0,
        "start_utf8": 0
      },
      {
        "cid_scope": "payload_without_record_cid/v1",
        "coordinate_system": "extracted-unicode-codepoints-and-utf8-half-open/v1",
        "end_char": 89,
        "end_utf8": 89,
        "historical_aliases": [],
        "record_cid": "baguqeeraspsmmgi7rz74uwbolgtvhnjz2llvqld36jwcf2526l6eejw7ogoq",
        "schema": "legal-corpus-source-occurrence/v1",
        "source_version_cid": "baguqeera76h6foirdop7np677cr6f25nl6xkzgvzjbqhstyc3m6iv57a6mca",
        "span_cid": "bafkreiekasjcom4cymk5rdpla7vwjfeojwiu42n2gv5qbp4xctibdnoety",
        "span_sha256": "8a0492273382c315d88deb07eb64948e4d914e69ba357b00bf9714d011b5c49e",
        "span_text": "Every covered officer must file a report unless the Board expressly excuses that officer.",
        "start_char": 0,
        "start_utf8": 0
      },
      {
        "cid_scope": "payload_without_record_cid/v1",
        "coordinate_system": "extracted-unicode-codepoints-and-utf8-half-open/v1",
        "end_char": 168,
        "end_utf8": 168,
        "historical_aliases": [],
        "record_cid": "baguqeera7sbnrtwgmqegsigv7mc6v6eit3ugb2pl425jgjduxgvsrwsslcma",
        "schema": "legal-corpus-source-occurrence/v1",
        "source_version_cid": "baguqeerajnvuszussa3idemidjf5fau2jutxvfyihltferekhw7faxxmjvdq",
        "span_cid": "bafkreibwqkxm3w3mthzkpmzulwookjsqg3gv5k7ijffwetxbl7sq7pbpxa",
        "span_sha256": "3682aecddb6c99f2a7b3345d9ce5265036cd5eabe8494b624ee15fe50fbc2fb8",
        "span_text": "For every officer, supervisor, event, and time, if both people are covered officers, that officer may inspect the register under that supervisor at that event and time.",
        "start_char": 0,
        "start_utf8": 0
      }
    ],
