      "import LegalRelationalAstPreservation.Semantics\nnamespace LegalRelationalAstPreservation.Instanced730343569165d945393cf90cfb7015f7c7007ff4e4f604ef430fa50a5e9c7ec\ndef formula_0 {Entity Agent : Type} (i : Interpretation Entity Agent) : Nat → Prop := (fun t => ∀ v0 : Entity, (fun t => ((fun t => i.atom \"CoveredOfficer\" [v0] t) t) ↔ ((fun t => i.atom \"AppointedByBoard\" [v0] t) t)) t)\n\ndef actualNativeValue : NativeValue := (.object [(\"formula\", (.object [(\"left\", (.object [(\"arguments\", (.array [(.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)])])), (\"name\", (.string \"CoveredOfficer\")), (\"node_type\", (.string \"Predicate\"))])), (\"node_type\", (.string \"BinaryFormula\")), (\"operator\", (.object [(\"enum\", (.string \"LogicOperator\")), (\"value\", (.string \"↔\"))])), (\"right\", (.object [(\"arguments\", (.array [(.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)])])), (\"name\", (.string \"AppointedByBoard\")), (\"node_type\", (.string \"Predicate\"))]))])), (\"node_type\", (.string \"QuantifiedFormula\")), (\"quantifier\", (.object [(\"enum\", (.string \"Quantifier\")), (\"value\", (.string \"∀\"))])), (\"variable\", (.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)]))])\ndef typedNativeAst : RelationalFOL := (.universal \"officer\" (.equivalence (.predicate \"CoveredOfficer\" [\"officer\"]) (.predicate \"AppointedByBoard\" [\"officer\"])))\ndef typedSourceAst : RoleFormula := (.universal \"officer\" (.equivalence (.predicate \"CoveredOfficer\" [\"officer\"] [\"officer\"]) (.predicate \"AppointedByBoard\" [\"officer\"] [\"officer\"])))\ndef predicateRoles (name : String) : List String :=\n  if name = \"AppointedByBoard\" then [\"officer\"] else\n  if name = \"CoveredOfficer\" then [\"officer\"] else\n  []\ntheorem native_value_exact : relToNativeValue typedNativeAst = actualNati