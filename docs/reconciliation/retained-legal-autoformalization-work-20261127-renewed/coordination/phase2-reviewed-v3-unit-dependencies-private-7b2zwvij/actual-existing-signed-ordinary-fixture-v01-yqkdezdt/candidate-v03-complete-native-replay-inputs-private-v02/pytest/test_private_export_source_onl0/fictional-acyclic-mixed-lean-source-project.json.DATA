      "unit-companions/00-file-06.txt",
      "{\"original_fragment\":{\"admitted\":false,\"all_logic_families_supported\":false,\"backend_executed\":false,\"cross_family_equivalence_verified\":false,\"exact_native_ast_roundtrip\":true,\"family\":\"deontic_fol\",\"formula\":\"∀officer.(↔ CoveredOfficer(officer) AppointedByBoard(officer))\",\"formula_sha256\":\"c528e7501df131aafd590397ae2b95a4f643677c5fc1f72176def39496f7696b\",\"lean_body\":\"def formula_0 {Entity Agent : Type} (i : Interpretation Entity Agent) : Nat → Prop := (fun t => ∀ v0 : Entity, (fun t => ((fun t => i.atom \\\"CoveredOfficer\\\" [v0] t) t) ↔ ((fun t => i.atom \\\"AppointedByBoard\\\" [v0] t) t)) t)\",\"lowering_details\":{\"assumptions\":[\"Object carrier and atomic predicates are arbitrary interpretation parameters.\",\"Deontic/cognitive operators are distinct interpretation parameters; no modal axioms or source truth are asserted.\",\"Supported temporal operators use discrete unbounded Nat traces.\"],\"operators\":[\"QuantifiedFormula\",\"BinaryFormula\",\"↔\",\"Predicate\",\"Predicate\"],\"validator\":\"strict_native_reparse_and_exact_AST\"},\"native_ast\":{\"formula\":{\"left\":{\"arguments\":[{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}],\"name\":\"CoveredOfficer\",\"node_type\":\"Predicate\"},\"node_type\":\"BinaryFormula\",\"operator\":{\"enum\":\"LogicOperator\",\"value\":\"↔\"},\"right\":{\"arguments\":[{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}],\"name\":\"AppointedByBoard\",\"node_type\":\"Predicate\"}},\"node_type\":\"QuantifiedFormula\",\"quantifier\":{\"enum\":\"Quantifier\",\"value\":\"∀\"},\"variable\":{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}},\"native_ast_sha256\":\"9425f98a35f5074840424fbe10d7524b5bb3fee78d738caeaac083dd459cf8ae\",\"parse_receipt\":{\"admitted\":false,\"ast_classes\":[\"BinaryFormula\",\"Predicate\",\"QuantifiedFormula\"],\"consumed_all_input\":true,\"diagnostics\":[],\"family\":\"deontic_fol\",\"formalized\":false,\"formula\":\"∀officer