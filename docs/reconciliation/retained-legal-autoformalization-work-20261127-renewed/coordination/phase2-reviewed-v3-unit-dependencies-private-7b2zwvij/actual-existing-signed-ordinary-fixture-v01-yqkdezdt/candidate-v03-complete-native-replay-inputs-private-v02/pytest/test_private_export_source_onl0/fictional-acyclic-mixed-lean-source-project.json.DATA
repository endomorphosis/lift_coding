      "unit-companions/01-file-06.txt",
      "{\"original_fragment\":{\"admitted\":false,\"all_logic_families_supported\":false,\"backend_executed\":false,\"cross_family_equivalence_verified\":false,\"exact_native_ast_roundtrip\":true,\"family\":\"deontic_fol\",\"formula\":\"∀officer.(→ CoveredOfficer(officer) (→ ¬Excused(officer) O(FilesReport(officer))))\",\"formula_sha256\":\"28aaf5df5c9750351de7c3df1011762263bac647e7d024a65af0dcd1befab52a\",\"lean_body\":\"def formula_0 {Entity Agent : Type} (i : Interpretation Entity Agent) : Nat → Prop := (fun t => ∀ v0 : Entity, (fun t => ((fun t => i.atom \\\"CoveredOfficer\\\" [v0] t) t) → ((fun t => ((fun t => ¬ ((fun t => i.atom \\\"Excused\\\" [v0] t) t)) t) → ((i.modal \\\"deontic:O\\\" [] none (fun t => i.atom \\\"FilesReport\\\" [v0] t)) t)) t)) t)\",\"lowering_details\":{\"assumptions\":[\"Object carrier and atomic predicates are arbitrary interpretation parameters.\",\"Deontic/cognitive operators are distinct interpretation parameters; no modal axioms or source truth are asserted.\",\"Supported temporal operators use discrete unbounded Nat traces.\"],\"operators\":[\"QuantifiedFormula\",\"BinaryFormula\",\"→\",\"Predicate\",\"BinaryFormula\",\"→\",\"UnaryFormula\",\"¬\",\"Predicate\",\"DeonticFormula\",\"O\",\"Predicate\"],\"validator\":\"strict_native_reparse_and_exact_AST\"},\"native_ast\":{\"formula\":{\"left\":{\"arguments\":[{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}],\"name\":\"CoveredOfficer\",\"node_type\":\"Predicate\"},\"node_type\":\"BinaryFormula\",\"operator\":{\"enum\":\"LogicOperator\",\"value\":\"→\"},\"right\":{\"left\":{\"formula\":{\"arguments\":[{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}],\"name\":\"Excused\",\"node_type\":\"Predicate\"},\"node_type\":\"UnaryFormula\",\"operator\":{\"enum\":\"LogicOperator\",\"value\":\"¬\"}},\"node_type\":\"BinaryFormula\",\"operator\":{\"enum\":\"LogicOperator\",\"value\":\"→\"},\"right\":{\"agent\":null,\"context\":null,\"formula\":{\"arguments\":[{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}],\"name\":\"FilesReport\",\"node_type\":\"Predicate\"},\"node_type\":\"DeonticFormula\",\"operator\":{\"enum\":\"DeonticOperator\",\"value\":\"O\"}}}},\"node_type\":\"QuantifiedFormula\",\"quantifier\":{\"enum\":\"Quantifier\",\"value\":\"∀\"},\"variable\":{\"name\":\"officer\",\"node_type\":\"Variable\",\"sort\":null}},\"native_ast_sha256\":\"75496a9a1713f3c77a64856d10a482189d6595325a7c073924c31e749abe7e31\",\"parse_receipt\":{\"admitted\":false,\"ast_classes\":[\"BinaryFormula\",\"DeonticFormula\",\"Predicate\",\"QuantifiedFormula\",\"UnaryFormula\"],\"consumed_all_input\":true,\"diagnostics\":[],\"family\":\"deontic_fol\",\"formalized\":false,\"formula\":\"∀officer.(→ CoveredOfficer(officer) (→ ¬Excused(officer) O(FilesReport(officer))))\",\"formula_sha256\":\"28aaf5df5c9750351de7c3df1011762263bac647e7d024a65af0dcd1befab52a\",\"parser\":\"ipfs_datasets_py.logic.TDFOL.tdfol_parser.TDFOLParser\",\"parser_source_sha256\":\"8e1f8885be6dc2a7d692ecdf0364ccc4d01692c38c81137775d9d222d8b8d9d3\",\"passed\":true,\"predicates\":[\"CoveredOfficer\",\"Excused\",\"FilesReport\"],\"printed\":\"∀officer.(→ CoveredOfficer(officer) (→ ¬Excused(officer) O(FilesReport(officer))))\",\"semantic_equivalence_checked\":false,\"source_bound\":false,\"syntax_valid\":true},\"printed\":\"∀officer.(→ CoveredOfficer(officer) (→ ¬Excused(officer) O(FilesReport(officer))))\",\"printed_parse_receipt\":{\"admitted\":false,\"ast_classes\":[\"BinaryFormula\",\"DeonticFormula\",\"Predicate\",\"QuantifiedFormula\",\"UnaryFormula\"],\"consumed_all_input\":true,\"diagnostics\":[],\"family\":\"deontic_fol\",\"formalized\":false,\"formula\":\"∀officer.(→ CoveredOfficer(officer) (→ ¬Excused(officer) O(FilesReport(officer))))\",\"formula_sha256\":\"28aaf5df5c9750351de7c3df1011762263bac647e7d024a65af0dcd1befab52a\",\"parser\":\"ipfs_datasets_py.logic.TDFOL.tdfol_parser.TDFOLParser\",\"parser_source_sha256\":\"8e1f8885be6dc2a7d692ecdf0364ccc4d01692c38c8113