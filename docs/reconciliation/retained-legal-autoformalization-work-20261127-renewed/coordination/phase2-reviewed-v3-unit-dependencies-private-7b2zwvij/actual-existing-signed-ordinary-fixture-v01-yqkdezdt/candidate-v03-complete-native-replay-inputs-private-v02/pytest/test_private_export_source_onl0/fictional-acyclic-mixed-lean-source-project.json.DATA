      "import LegalRelationalAstPreservation.Semantics\nnamespace LegalRelationalAstPreservation.Instance4fd6dded64c9fb6c604f71b49815fdd4b5ff74dc683e13e6614e141ffe973040\ndef formula_0 {Entity Agent : Type} (i : Interpretation Entity Agent) : Nat → Prop := (fun t => ∀ v0 : Entity, (fun t => ((fun t => i.atom \"CoveredOfficer\" [v0] t) t) → ((fun t => ((fun t => ¬ ((fun t => i.atom \"Excused\" [v0] t) t)) t) → ((i.modal \"deontic:O\" [] none (fun t => i.atom \"FilesReport\" [v0] t)) t)) t)) t)\n\ndef actualNativeValue : NativeValue := (.object [(\"formula\", (.object [(\"left\", (.object [(\"arguments\", (.array [(.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)])])), (\"name\", (.string \"CoveredOfficer\")), (\"node_type\", (.string \"Predicate\"))])), (\"node_type\", (.string \"BinaryFormula\")), (\"operator\", (.object [(\"enum\", (.string \"LogicOperator\")), (\"value\", (.string \"→\"))])), (\"right\", (.object [(\"left\", (.object [(\"formula\", (.object [(\"arguments\", (.array [(.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)])])), (\"name\", (.string \"Excused\")), (\"node_type\", (.string \"Predicate\"))])), (\"node_type\", (.string \"UnaryFormula\")), (\"operator\", (.object [(\"enum\", (.string \"LogicOperator\")), (\"value\", (.string \"¬\"))]))])), (\"node_type\", (.string \"BinaryFormula\")), (\"operator\", (.object [(\"enum\", (.string \"LogicOperator\")), (\"value\", (.string \"→\"))])), (\"right\", (.object [(\"agent\", .null), (\"context\", .null), (\"formula\", (.object [(\"arguments\", (.array [(.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)])])), (\"name\", (.string \"FilesReport\")), (\"node_type\", (.string \"Predicate\"))])), (\"node_type\", (.string \"DeonticFormula\")), (\"operator\", (.object [(\"enum\", (.string \"DeonticOperator\")), (\"value\", (.string \"O\"))]))]))]))])), (\"node_type\", (.string \"QuantifiedFormula\")), (\"quantifier\", (.object [(\"enum\", (.string \"Quantifier\")), (\"value\", (.string \"∀\"))])), (\"variable\", (.object [(\"name\", (.string \"officer\")), (\"node_type\", (.string \"Variable\")), (\"sort\", .null)]))])\ndef typedNativeAst : RelationalFOL := (.universal \"officer\" (.implication (.predicate \"CoveredOfficer\" [\"officer\"]) (.implication (.negation (.predicate \"Excused\" [\"officer\"])) (.modal \"O\" (.predicate \"FilesReport\" [\"officer\"])))))\ndef typedSourceAst : RoleFormula := (.universal \"officer\" (.implication (.predicate \"CoveredOfficer\" [\"officer\"] [\"officer\"]) (.implication (.negation (.predicate \"Excused\" [\"officer\"] [\"officer\"])) (.modal \"O\" (.predicate \"FilesReport\" [\"officer\"] [\"officer\"])))))\ndef predicateRoles (name : String) : List String :=\n  if name = \"CoveredOfficer\" then [\"officer\"] else\n  if name = \"Excused\" then [\"officer\"] else\n  if name = \"FilesReport\" then [\"officer\"] else\n  []\ntheorem native_value_exact : relToNativeValue typedNativeAst = actualNativeValue := by\n  rfl\n#print axioms native_value_exact\ntheorem native_ast_closed : relClosed [] typedNativeAst = true := by\n  decide\n#print axioms native_ast_closed\ntheorem denotation_matches_native {Entity Agent : Type} (i : Interpretation Entity Agent) (t : Nat) :\n    relDenote i typedNativeAst emptyEnvironment t ↔ formula_0 i t := by\n  exact Iff.intro (fun h => h) (fun h => h)\n#print axioms denotation_matches_native\ntheorem typed_source_lowering_exact : eraseRoles typedSourceAst = typedNativeAst := by\n  rfl\n#print axioms typed_source_lowering_exact\ntheorem role_denotation_matches_native {Entity Agent : Type} (base : Interpretation Entity Agent)\n    (atoms : String → List (String × Entity) → Nat → Prop) (t : Nat) :\n    roleDenote base atoms typedSourceAst emptyEnvironment t ↔\n      formula_0 (roleInterpretation base atoms predicateRoles) t := by\n  exact Iff.intro (fun h