import hashlib
import json
import sys
from pathlib import Path

guard = Path(sys.argv[5])
guard_raw = guard.read_bytes()
assert hashlib.sha256(guard_raw).hexdigest() == "b3fe749fe409c404a426669781c4807538115fda1127534bbb3c8613853fd42e"
sentinel = 'owner = repo / "tests/unit/logic/legal_ir/test_proof_cache.py"'
assert guard_raw.count(sentinel.encode()) == 1
scope = {"__file__": str(guard)}
exec(compile(guard_raw.split(sentinel.encode(), 1)[0], str(guard), "exec"), scope)
repo, loader, pytest = (scope[key] for key in ("repo", "GuardedLoader", "pytest"))
os = scope["os"]
os.chdir(scope["working"])
test = Path(sys.argv[4])
assert hashlib.sha256(test.read_bytes()).hexdigest() == sys.argv[6]
module_name = "ipfs_datasets_py.optimizers.logic_theorem_optimizer.legal_ir_semantic_metrics"
relative = "ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_ir_semantic_metrics.py"
if len(sys.argv) == 9:
    overlay = Path(sys.argv[7])
    assert hashlib.sha256(overlay.read_bytes()).hexdigest() == sys.argv[8]
    class OneOverlay(scope["importlib"].abc.MetaPathFinder):
        def find_spec(self, fullname, path=None, target=None):
            if fullname == module_name:
                return scope["importlib"].util.spec_from_file_location(fullname, repo / relative, loader=loader(relative, overlay))
    sys.meta_path.insert(0, OneOverlay())
xml = scope["working"] / "junit.xml"
result = pytest.main([
    "-c", "/dev/null", "--noconftest", "-p", "no:cacheprovider", "-q",
    "--junitxml", str(xml), str(test), "-k", "retrieved",
])
print(json.dumps(dict(scope="private direct scorer fixtures", pytest_exit=int(result),
                      denied=scope["denied"], overlays=scope["watched"])))
raise SystemExit(int(result) if not scope["denied"] else 8)
