from pathlib import Path
from types import SimpleNamespace
import ast
import hashlib
import json
import os
import re
import stat

here=Path(__file__).resolve().parent
out=here/"existing-v360-ordinary37-INERT"
out.mkdir(mode=0o700)
source=here/"existing-Source2-Guide570-INERT/READY-existing-Guide570-Phase8-Source2-exact-two-NONSELECTED.json"
old=Path("/tmp/P8-scorer-retrieval-depth-ordinary23-existing-R2-INERT-j3gfjl4S")
actual=Path("/tmp/Root-existing-P8-scorer-depth-ordinary23-v360-l58nsgfh")

def H(raw):
    return hashlib.sha256(raw).hexdigest()
def f9(st):
    return {k:str(getattr(st,k)) for k in (
        "st_dev","st_ino","st_mode","st_nlink","st_uid","st_gid","st_size","st_mtime_ns","st_ctime_ns")}
def read(path):
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NONBLOCK|os.O_NOFOLLOW),"rb") as f:
        before=os.fstat(f.fileno())
        assert stat.S_ISREG(before.st_mode) and before.st_nlink==1
        raw=f.read()
        assert len(raw)==before.st_size and f9(before)==f9(os.fstat(f.fileno()))==f9(path.lstat())
    return raw
def pin(path,size=None,sha=None):
    raw=read(path)
    if size is not None:
        assert len(raw)==size
    if sha is not None:
        assert H(raw)==sha
    return {"path":str(path),"bytes":len(raw),"sha256":H(raw)}
def auth(r):
    raw=read(Path(r["path"]))
    assert (len(raw),H(raw))==(r["bytes"],r["sha256"])
    return raw
def wire(r):
    return json.loads(auth(r))
def emit(name,raw):
    p=out/name
    with os.fdopen(os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400),"wb") as f:
        f.write(raw)
        f.flush()
        os.fsync(f.fileno())
    return pin(p,len(raw),H(raw))
def record(name,value):
    return emit(name,(json.dumps(value,sort_keys=True,indent=2)+"\n").encode())

s2=pin(source,3483,"863fcd209ad0abdd73502a2bdec78000f804a4d4f9fb8823aa72abdd9f25e827")
s2data=wire(s2)
candidate_ref=s2data["exact_two_file_candidate"]
candidate=wire(candidate_ref)
s2struct=wire(s2data["structural_source2_request"])
d=Path(s2struct["root"])
rows={r["path"]:r for r in wire(s2data["matched_1623_live_metadata_only"])["rows"]}
assert len(rows)==1623

prior_ref=pin(old/"READY-P8-scorer-retrieval-depth-ordinary23-existing-R2-INERT-RootNULL.json",
              9292,"d322d062e010bbd457b5a5df8bb7fb7456e025a83915dea3bd65f03ab79b5c5e")
prior=wire(prior_ref)
old_actual=pin(actual/"actual-scorer-ordinary23-closed-small-v360.json",10045,
               "64b4ac03e48fbabaafb0b98f331dcebbee95406527fd4f3ff9a84a89c5effdc9")
close=wire(old_actual)
assert close["Source_closed"] and close["resource_cleanup_confirmed"] and close["parent_home_removed"]
assert close["actual_operator_exit_code"]==0 and close["qualification_complete"]
config_ref=pin(actual/"actual-frozen-scorer-normal-config-and-fixture-roles.json",4537,
               "2d06faeb9fb6ca540622a90387f53f2a93e623fb5a2896b8007e533174ad9ff7")
config=wire(config_ref)
conf=["conftest.py","tests/conftest.py","tests/unit/conftest.py",
      "tests/unit/optimizers/conftest.py","tests/unit/optimizers/logic_theorem_optimizer/conftest.py"]
assert config["required_normal_conftests"]==[str(d/p) for p in conf]
assert config["pytest_inifile"]==str(d/"pytest.ini")
for row in config["required_fixture_closure"]:
    assert rows[row["path"]]==row and row["full9"]==f9(Path(row["path"]).lstat())

test=candidate["files"]["test"]["canonical_path"]
test_module=test.removesuffix(".py").replace("/",".")
cases=candidate["exact_shared_private_testcase_order"]
selectors=list(dict.fromkeys(test+"::"+name.partition("[")[0] for name in cases))
nodes=[test+"::"+name for name in cases]
counts={base:sum(n.partition("[")[0]==base for n in nodes) for base in selectors}
assert len(nodes)==len(set(nodes))==sum(counts.values())==37 and len(selectors)==13
assert tuple(counts.values())==(1,1,1,1,1,12,2,6,1,2,2,5,2)
tree=ast.parse(auth(candidate["files"]["test"]["after"]))
selected={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef)
          and (test+"::"+n.name) in counts}
assert list(test+"::"+name for name in selected)==selectors
for name,fn in selected.items():
    if not fn.decorator_list:
        assert [n for n in cases if n.partition("[")[0]==name]==[name]
        continue
    decorator,=fn.decorator_list
    assert ast.unparse(decorator.func)=="pytest.mark.parametrize"
    params=ast.literal_eval(decorator.args[1])
    ids=[str(x) if type(x) in (type(None),str) else "scenario"+str(i) for i,x in enumerate(params)]
    assert [n for n in cases if n.partition("[")[0]==name]==[name+"["+x+"]" for x in ids],name

roster=record("independent-literal37-roster-DATA.json",{
    "schema":"phase8-scorer-reported-counterexamples-exact37-membership/v1",
    "same_private_observation":candidate_ref,
    "static_check":"function/source AST, finite parameter values, exact private raw XML order",
    "function_selectors":selectors,"expected_function_case_counts":counts,"literal_expected_nodeids":nodes,
    "retained":30,"new":7,"actual_selected_COLLECT_supplies_RUN_order":True,
    "actual_ordinary_collect_run_result":None,
})
group="Phase8-reported-counterexample-assignment-ordinary37"
o,b,f=(auth(prior["controls"][k]).decode().replace(prior["group"],group) for k in ("operator","bootstrap","factory"))

def assignment(src,key):
    located=[n for n in ast.parse(src).body if isinstance(n,ast.Assign) and len(n.targets)==1
             and isinstance(n.targets[0],ast.Name) and n.targets[0].id==key]
    assert len(located)==1
    return located[0]
def get(src,key):
    return ast.literal_eval(assignment(src,key).value)
def set_value(src,key,value):
    n=assignment(src,key)
    parts=src.splitlines(keepends=True)
    parts[n.lineno-1:n.end_lineno]=[f"{key} = {value!r}\n"]
    return "".join(parts)
def replace(src,before,after,count=1):
    assert src.count(before)==count,(before,src.count(before))
    return src.replace(before,after)

selection={**get(o,"SELECTION"),"function_count":len(selectors),"literal_expected_cases":len(nodes),
           "function_selectors":selectors,"expected_function_case_counts":counts,"literal_expected_nodeids":nodes}
del selection["independent_literal23_roster_reference"]
selection["independent_literal37_roster_reference"]=roster
o=set_value(o,"SELECTION",selection)
o=set_value(o,"EXPECTED_BRIDGE27_CASE_VECTOR",tuple(counts.values()))
for before,after in (("['function_count'] == 8","['function_count'] == 13"),
                     ("['literal_expected_cases'] == 23","['literal_expected_cases'] == 37"),
                     ("len(set(_selectors)) == 8","len(set(_selectors)) == 13"),
                     ("sum(_counts.values()) == 23","sum(_counts.values()) == 37"),
                     ("len(set(_literal_ids)) == 23","len(set(_literal_ids)) == 37"),
                     ("len(set(roster)) == 23","len(set(roster)) == 37"),
                     ("literal23 nodeid","literal37 nodeid"),("INERT P8 scorer ordinary23","INERT P8 scorer ordinary37")):
    o=replace(o,before,after)
for key,value in (("FUNCTION_SELECTORS",selectors),("EXPECTED_FUNCTION_CASE_COUNTS",counts),
                  ("EXPECTED_ORDERED_CASE_COUNTS",tuple(counts.values())),("EXPECTED_CASES",37),
                  ("LITERAL_EXPECTED_NODEIDS",nodes)):
    b=set_value(b,key,value)
for before,after in (("len(function_selectors) != 8","len(function_selectors) != 13"),
                     ("len(set(function_selectors)) != 8","len(set(function_selectors)) != 13"),
                     ("8 future-bound software functions/23","13 future-bound software functions/37"),
                     ("ordered8-selector case vector/23","ordered13-selector case vector/37")):
    b=replace(b,before,after)
f=replace(f," != 23"," != 37",2)
f=replace(f,"literal23 nodeid","literal37 nodeid")
f=replace(f,"8 independently selected software-function counts/23","13 independently selected software-function counts/37")
fref=emit("existing-v360-ordinary37-factory.INERT.py.DATA",f.encode())
bref=emit("existing-v360-ordinary37-bootstrap.INERT.py.DATA",b.encode())
o=set_value(o,"FACTORY_REFERENCE",fref)
oref=emit("existing-v360-ordinary37-operator.INERT.py.DATA",o.encode())
for src,ref in ((o,oref),(b,bref),(f,fref)):
    compile(src,ref["path"],"exec",dont_inherit=True)
    assert not re.search(r"ordinary23|literal23|ordered8-selector|(?:==|!=) 23\b",src)
for key in prior["late_Root_bindings_NULL_bootstrap"]:
    assert get(b,key) is None
for key in prior["late_Root_bindings_NULL_operator"]:
    assert get(o,key) is None
owners=get(o,"MAINTAINED_OWNER_NAMES")
assert owners==get(b,"MAINTAINED_OWNER_NAMES")
assert sorted(name.rsplit(".",1)[-1] for name in owners)==["legal_ir_family_evaluator","legal_ir_semantic_metrics"]
test_modules={test:test_module}
policy=get(o,"SELECTED_TEST_REWRITE_POLICY")
assert get(o,"SELECTED_TEST_MODULES")==get(b,"SELECTED_TEST_MODULES")==test_modules
assert get(b,"SELECTED_TEST_REWRITE_POLICY")==policy and policy["selected_test_binding_names"]==[test_module]

role_rows={}
role_paths=owners+[test_module,"ipfs_datasets_py.optimizers.logic_theorem_optimizer.snapshot_evaluator"]
for name in role_paths:
    rel=name.replace(".","/")+".py"
    existing=rows[str(d/rel)]
    assert f9((d/rel).lstat())==existing["full9"]
    post=next((row["after"] for row in candidate["files"].values() if row["canonical_path"]==rel),None)
    row=existing if post is None else post
    role_rows[name]={"relative_path":rel,"expected_bytes":row["bytes"],"expected_sha256":row["sha256"],
        "role":("maintained_compile_observation" if name in owners else
                "selected_owning_test_normal_rewrite" if name==test_module else "required_import_guard_only"),
        "fresh_Source_role_metadata":None}

calls=[]
def fake_request(**kwargs):
    calls.append(kwargs)
    return kwargs
ctx={"ROOT":str(d),"ADDITIONAL_A_ROOT":"/fictional/A","EXPECTED_MODULES":{},
     "MAINTAINED_OWNER_NAMES":owners,"SELECTED_TEST_MODULES":test_modules,"REQUIRED_CONFTESTS":config["required_normal_conftests"],
     "fixture":{"pytest_inifile":config["pytest_inifile"]},"OWNING_FILES":[test],"SELECTION":selection,"H":H,
     "epoch_raw":b"[]","EPOCH":[],"SELECTED_TEST_REWRITE_POLICY":policy,"ROOT_RUNTIME_SELECTION":None,
     "FINAL_D_PROVENANCE":None,"FINAL_A_PROVENANCE":None,"FINAL_BINDING_MANIFEST_REFERENCE":None,"D_READ_BINDING_REFERENCE":None,
     "FINAL_ADMITTED_IO_PLAN_REFERENCE":None,"FINAL_EFFECT_DECISION_REFERENCE":None,"BOOTSTRAP_REFERENCE":bref,
     "read_private":lambda p,n,h:auth({"path":p,"bytes":n,"sha256":h}),"PY":"/fictional/python","FLAGS":{},
     "sdk":SimpleNamespace(ToolRunLimits=lambda **kwargs:kwargs,ToolRunRequest=fake_request)}
exec(compile(f,fref["path"],"exec"),ctx)
call=ctx["continuation_request"]
phase="frozen-local-D-"+group
collect=call(phase,"collect",group=group)
run=call(phase,"run",nodes,group=group)
for prompt in (collect,run):
    raw=prompt["input_files"]["request.json"]
    assert len(raw)<65536
    packed=json.loads(raw)
    assert packed["literal_expected_nodeids"]==get(b,"LITERAL_EXPECTED_NODEIDS")==nodes
    assert packed["function_selectors"]==get(b,"FUNCTION_SELECTORS")==selectors
    assert packed["expected_function_case_counts"]==get(b,"EXPECTED_FUNCTION_CASE_COUNTS")==counts
    assert packed["selected_test_rewrite_policy"]==policy
assert json.loads(run["input_files"]["request.json"])["actual_collected_roster"]==nodes
assert get(b,"EXPECTED_ORDERED_CASE_COUNTS")==tuple(counts.values()) and get(b,"EXPECTED_CASES")==37
assert collect["limits"]["cpu_seconds"]==110 and run["limits"]["cpu_seconds"]==540
for mutated in (nodes[1:],nodes[:-1]+nodes[:1],nodes[:-1]+[nodes[-1]+"foreign"]):
    try:
        call(phase,"run",mutated,group=group)
    except ValueError:
        pass
    else:
        raise AssertionError("factory accepted incorrect roster")
assert len(calls)==2

ready=record("READY-existing-v360-scorer-ordinary37-INERT-RootNULL.json",{
    "schema":"existing-v360-scorer-ordinary37-reported-counterexample-qualification-inert/v1",
    "candidate":candidate_ref,"existing_Source2":s2,"prior_ordinary23_terminal":old_actual,"prior_controls":prior_ref,
    "adapted_controls":{"operator":oref,"bootstrap":bref,"factory":fref},"group":group,
    "literal_membership_roster":roster,"ordinary_owning_selection":selection,
    "role_rows":role_rows,"historic_normal_pytest_ini_and_five_conftests":config_ref,
    "present_Guide570_config_matches_all_six_prior_config_full9_SHA_bytes":True,
    "selected_test_assertion_rewrite_policy":policy,
    "actual_pure_factory_join":{"collect":True,"run37":True,"short_refused":True,"duplicate_refused":True,
        "foreign_refused":True,"bootstrap_literals_match":True,"SDK_calls":0},
    "current_Guide570_matches_private_before_rows":True,
    "pending_Source2_write_local_freeze_fresh_Source_READ_current_clock_SDK_lease_IO_effect_output":None,
    "actual_ordinary_results":None,
    "next_existing_owner_input":"After exact Source2 and local freeze, bind a current Source READ of two frozen posts and the exact D index, retain or refresh all current guard rows; separately bind actual resource and authority.",
    "scope":"Existing scoring and reported counterexample comparison only; software evidence, no real scenario execution or legal review."
})
print(json.dumps(ready))
