def idx(role):
    path = repos/role/'.git/index'
    with os.fdopen(os.open(path, os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK), 'rb') as f:
        first = {key:str(getattr(os.fstat(f.fileno()), key)) for key in fields}
        sha = hashlib.file_digest(f, 'sha256').hexdigest()
        last = {key:str(getattr(os.fstat(f.fileno()), key)) for key in fields}
    assert first == last == {key:str(getattr(path.lstat(), key)) for key in fields}
    return dict(path=str(path), bytes=int(first['st_size']), sha256=sha, full9=first)

