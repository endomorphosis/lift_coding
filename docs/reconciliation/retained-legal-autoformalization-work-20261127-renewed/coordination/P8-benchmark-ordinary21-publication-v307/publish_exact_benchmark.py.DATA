import hashlib
import json
import os
from pathlib import Path
import subprocess
import time
import xml.etree.ElementTree as ET

work = Path(__file__).parent
coord = work.parent
repos = Path('/tmp/codex-all-work-github-main-reconciliation-20261123-etm066qn/repositories')
receipt_path = Path('/tmp/Root-P8-benchmark-ordinary21-v307-sz73_pyk/Root-P8-benchmark-ordinary21-qualified-small-v307.json')
output = coord / 'actual-P8-benchmark-ordinary21-three-FF-publication-v307.json'
assert not output.exists()
started = time.monotonic()
base = {
    'datasets': '64744f61c80f452b8395db41289c2b1dcafba9d6',
    'hallucinate': 'fb0ea773e0baa2499378d91883e9041798b10636',
    'root': '3cec152cc741a41d920978e8526c91dbc17ebdb6',
    'accelerate': '88c0d9f82f66aaddbb01344c9f85236e92a5dc88',
}
target = 'a79b4ef9a8b9a4aee2e53a975832784e694b5e33'
urls = {
    'datasets':'https://github.com/endomorphosis/ipfs_datasets_py',
    'hallucinate':'https://github.com/endomorphosis/hallucinate_app',
    'root':'https://github.com/endomorphosis/lift_coding',
    'accelerate':'https://github.com/endomorphosis/ipfs_accelerate_py',
}
env = dict(os.environ, GIT_OPTIONAL_LOCKS='0', GIT_NO_LAZY_FETCH='1', GIT_TERMINAL_PROMPT='0')
fields = ('st_ctime_ns','st_dev','st_gid','st_ino','st_mode','st_mtime_ns','st_nlink','st_size','st_uid')

def checked(path, length, digest):
    value = Path(path).read_bytes()
    assert len(value) == length and hashlib.sha256(value).hexdigest() == digest, path
    return value

def checked_ref(row):
    return checked(row['path'], row['bytes'], row['sha256'])

def observe(role, *args, data=None):
    result = subprocess.run(['git','-c','core.fsmonitor=false','-C',str(repos/role),*args],
                            input=data, capture_output=True, env=env, timeout=90, check=True)
    return result.stdout

def record(event):
    with (work/'actual-events.jsonl').open('a', encoding='utf-8') as file:
        file.write(json.dumps(event, sort_keys=True)+'\n')
        file.flush()
        os.fsync(file.fileno())
    print(json.dumps(event, sort_keys=True), flush=True)

def revision(role, ref='HEAD'):
    return observe(role,'rev-parse',ref).decode().strip()

def origin(role):
    raw = observe(role,'ls-remote','--exit-code','origin','refs/heads/main').decode().splitlines()
    assert len(raw) == 1
    oid, ref = raw[0].split('\t')
    assert ref == 'refs/heads/main' and len(oid) == 40
    return oid

def clean(role):
    assert observe(role,'status','--porcelain=v1','--untracked-files=all','--ignore-submodules=dirty') == b'', role
    assert observe(role,'diff','--cached','--name-only','--ignore-submodules=none') == b'', role

def rows_at(role, rev):
    rows = {}
    for line in observe(role,'ls-tree','-rz',rev).split(b'\0'):
        if line:
            metadata, path = line.decode().split('\t',1)
            mode, kind, oid = metadata.split()
            rows[path] = (mode,kind,oid)
    return rows

def exact_gitlinks(role, old, new, links):
    before = rows_at(role, old)
    after = rows_at(role, new)
    assert set(before) == set(after)
    assert {path for path in before if before[path] != after[path]} == set(links)
    for path, oid in links.items():
        assert before[path][:2] == ('160000','commit') and after[path] == ('160000','commit',oid)

def gitlink_commit(role, updates, message):
    assert revision(role) == base[role] and origin(role) == base[role], role
    clean(role)
    before = rows_at(role, base[role])
    for path, (prior, _) in updates.items():
        assert before[path] == ('160000','commit',prior)
    links = {path: value for path, (_,value) in updates.items()}
    data = ''.join(f'160000 {oid}\t{path}\n' for path,oid in links.items()).encode()
    observe(role,'update-index','--index-info',data=data)
    assert set(observe(role,'diff','--cached','--name-only').decode().splitlines()) == set(links)
    observe(role,'commit','-m',message)
    oid = revision(role)
    assert revision(role,'HEAD^') == base[role]
    exact_gitlinks(role,base[role],oid,links)
    clean(role)
    record({'local_commit':oid,'repository':role,'links':links})
    return oid, links

pushes = []
def push(role, oid):
    assert revision(role) == oid and origin(role) == base[role], role
    observe(role,'merge-base','--is-ancestor',base[role],oid)
    clean(role)
    record({'push_start':role,'before':base[role],'target':oid})
    porcelain = observe(role,'push','--porcelain','origin',oid+':refs/heads/main').decode()
    result = next(line for line in porcelain.splitlines() if '\t' in line)
    assert result.startswith(' \t') and origin(role) == oid and revision(role,'refs/remotes/origin/main') == oid
    event = {'repository':role,'before':base[role],'after':oid,'normal_fast_forward':True,
             'push_returncode':0,'porcelain':result}
    pushes.append(event)
    record(event)


qualification_digest='4faacaab4ca6332c382df49a0131e4b23bac3a6390fff2a8495a677b290de3d1'
qualified=json.loads(checked(receipt_path,4105,qualification_digest))
assert qualified['D_HEAD']==target
assert qualified['actual_ordinary_unique_PASS']==21 and qualified['function_count']==15
assert qualified['fictional_fixture_evaluation_only'] is True
assert all(qualified[key] is True for key in ('Source_closed','resource_cleanup_confirmed',
    'actual_parent_release_return','actual_COLLECT_RUN_JUnit_order_exact','six_current_Source_module_bindings'))
assert all(qualified[key]==0 for key in ('owned_operator_exit_code','errors','failures','skips','duplicates'))
tests=list(ET.fromstring(checked_ref(qualified['raw_JUnit'])).iter('testcase'))
assert len(tests)==len({(node.attrib['classname'],node.attrib['name']) for node in tests})==21
assert not any(node.find(tag) is not None for node in tests for tag in ('failure','error','skipped'))
from collections import Counter
function_counts=Counter(node.attrib['name'].partition('[')[0] for node in tests)
assert len(function_counts)==15
assert list(function_counts.values())==qualified['function_count_vector']
freeze=json.loads(checked_ref(qualified['freeze']))
source=json.loads(checked_ref(qualified['actual_SourceWRITE2']))
assert source['Source_closed'] and source['module_closed'] and not source['errors']
assert freeze['D_local_HEAD']==target and freeze['D_parent']==base['datasets']
assert freeze['D_tree']==qualified['D_tree']
paths={
    'ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_ir_external_benchmark.py':'fe181984a79a0088faa46010bd2d60e155d27b0a',
    'tests/unit/optimizers/logic_theorem_optimizer/test_legal_ir_external_benchmark.py':'939c3d60a7bb13f021679de702d760d0c19f30aa',
}
rows=freeze['exact_committed_files']
assert set(rows)==set(paths)==set(source['only_worktree_deltas'])
installed={str(Path(row['path']).relative_to(repos/'datasets')):row for row in source['installed']}
for role, expected in base.items():
    actual=target if role=='datasets' else expected
    assert revision(role)==actual
    assert revision(role,'refs/remotes/origin/main')==expected
    assert observe(role,'remote','get-url','origin').decode().strip().removesuffix('.git')==urls[role]
    assert observe(role,'remote','get-url','--push','origin').decode().strip().removesuffix('.git')==urls[role]
    assert origin(role)==expected
    clean(role)
assert revision('datasets','HEAD^')==base['datasets']
assert revision('datasets','HEAD^{tree}')==qualified['D_tree']
before_tree=rows_at('datasets',base['datasets'])
after_tree=rows_at('datasets',target)
assert set(before_tree)==set(after_tree)
assert {path for path in before_tree if before_tree[path]!=after_tree[path]}==set(paths)
index=freeze['D_index_frozen']
index_path=Path(index['path'])
assert {name:str(getattr(index_path.lstat(),name)) for name in fields}==index['full9']
checked_ref(index)
assert {name:str(getattr(index_path.lstat(),name)) for name in fields}==index['full9']
for path,oid in paths.items():
    row=rows[path]
    assert row['previous_blob']==before_tree[path][2]
    assert row['stage0_and_committed_blob']==oid and after_tree[path]==('100644','blob',oid)
    assert all(row[key]==installed[path][key] for key in ('path','bytes','sha256','full9'))
    assert {name:str(getattr(Path(row['path']).lstat(),name)) for name in fields}==row['full9']
    stage=observe('datasets','ls-files','--stage','--',path).decode().rstrip(chr(10))
    assert stage==f'100644 {oid} 0'+chr(9)+path
    raw=observe('datasets','cat-file','blob',oid)
    assert len(raw)==row['bytes'] and hashlib.sha256(raw).hexdigest()==row['sha256']
record({'preflight_exact':True,'before_remotes':base,'qualified_D':target,'ordinary_unique_tests':len(tests)})

push('datasets',target)
h,h_links=gitlink_commit('hallucinate',{'ipfs_datasets_py':(base['datasets'],target)},
                         'Update datasets link for qualified external benchmark')
push('hallucinate',h)
root,root_links=gitlink_commit('root',{
    'external/ipfs_datasets':(base['datasets'],target),'hallucinate_app':(base['hallucinate'],h)},
    'Update external benchmark qualification links')
push('root',root)
final_heads={'datasets':target,'hallucinate':h,'root':root,'accelerate':base['accelerate']}
final_links={'datasets':{},'hallucinate':h_links,'root':root_links,'accelerate':{}}
reconciled={}
for role,oid in final_heads.items():
    readback=origin(role)
    assert readback==oid==revision(role)==revision(role,'refs/remotes/origin/main')
    clean(role)
    reconciled[role]={'HEAD':oid,'tree':revision(role,'HEAD^{tree}'),'origin_main':readback,
                      'origin':urls[role],'clean_worktree_and_index':True,'gitlinks_updated':final_links[role]}
exact_gitlinks('hallucinate',base['hallucinate'],h,h_links)
exact_gitlinks('root',base['root'],root,root_links)
assert {name:str(getattr(index_path.lstat(),name)) for name in fields}==index['full9']
checked_ref(index)
summary={
    'schema':'P8-benchmark-ordinary21-exact-two-three-FF-publication/v307',
    'qualification':{'path':str(receipt_path),'bytes':4105,'sha256':qualification_digest},
    'source_closed_install':qualified['actual_SourceWRITE2'],'local_freeze':qualified['freeze'],
    'verified_raw_JUnit':qualified['raw_JUnit'],'ordinary_unique_pass':len(tests),
    'actual_function_count':len(function_counts),'function_count_vector':list(function_counts.values()),
    'Guide519_and_other_paths_links_preserved':True,
    'compiled_SDK_Source_qualification_scope':'synthetic benchmark fixture and software only',
    'source_resources_and_actual_parent_reported_closed':True,
    'committed_files':rows,'frozen_D_index_unchanged_through_push':index,
    'repos':reconciled,'pushes_in_actual_order':pushes,'elapsed_seconds':time.monotonic()-started,
    'private21_referenced_separately':True,'no_new_Source_tests_CI_Native_model_legal_training_operation':True,
    'Root_verifier_v1_dictionary_order_assumption_failure_retained':True,
    'whole_eight_phase_goal_complete':False,
}
raw=(json.dumps(summary,sort_keys=True,indent=2)+chr(10)).encode()
fd=os.open(output,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o400)
with os.fdopen(fd,'wb') as file:
    file.write(raw)
    file.flush()
    os.fsync(file.fileno())
assert output.read_bytes()==raw
print(json.dumps({'receipt':str(output),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'heads':final_heads}),flush=True)
