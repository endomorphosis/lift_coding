}, "Update accelerator and app links for durable manifest handoffs")
push("root", root)
heads = dict(accelerate=target,datasets=base["datasets"],hallucinate=h,root=root)
links = dict(accelerate={},datasets={},hallucinate=h_links,root=root_links)
repositories = {}
for role, oid in heads.items():
    via_remote=origin(role)
    assert via_remote == oid == revision(role) == revision(role, "refs/remotes/origin/main")
    clean(role)
    repositories[role] = dict(HEAD=oid,tree=revision(role, "HEAD^{tree}"),origin_main=via_remote,
        origin=urls[role],clean_worktree_and_index=True,gitlinks_updated=links[role])
indices_after = {role:index_snapshot(role) for role in base}
for role in ("accelerate","datasets"):
