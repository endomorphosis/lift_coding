assert all(qualification[key] is True for key in (
    "actual_qualified_100", "all_Source_and_owner_resource_and_parent_home_closed",
    "zero_failures_errors_skips_duplicates", "exact_COLLECT_RUN_order_actual",
    "executable_owner_mode_preserved", "isolated_fictional_endpoint_scope_only_no_live_RPC",
))
assert qualification["actual_CLI100_unique_parent_PASS"] == qualification["retained_parent_cases"] + qualification["new_manifest_cases"] == 100
assert qualification["passing_subtest_reports_separate"] == 195
xml = ET.fromstring(checked_ref(qualification["raw_junit"]))
tests = list(xml.iter("testcase"))
names = [(case.attrib["classname"], case.attrib["name"]) for case in tests]
assert len(tests) == len(set(names)) == 100
assert all(not any(child.tag in {"failure","error","skipped"} for child in case) for case in tests)
freeze = json.loads(checked_ref(qualification["actual_local_freeze"]))
assert freeze["local_clean"] and freeze["exact_changes_only"] and not freeze["pushed"]
source = json.loads(checked_ref(qualification["source_write_closed_separate"]))
assert source["Source_closed"] and source["module_closed"] and source["write_complete"]
target = "190cb69b9035ea210d9af8817fbe76caf890b48f"
parent_tree = "416a953630c9ba7ef521fd87bf821f075b052efc"
assert freeze["parent"]["HEAD"] == base["accelerate"] and freeze["parent"]["tree"] == parent_tree
assert freeze["frozen"]["HEAD"] == qualification["exact_frozen_A_HEAD"] == target
assert freeze["frozen"]["tree"] == qualification["exact_frozen_A_tree"]
assert freeze["frozen"]["stage0_index"] == qualification["frozen_A_index"]
assert revision("accelerate", "HEAD^") == base["accelerate"]
assert revision("accelerate", "HEAD^{tree}") == freeze["frozen"]["tree"]
assert observe("accelerate", "symbolic-ref", "HEAD").strip().decode() == freeze["frozen"]["branch"]
branch_ref = freeze["frozen"]["branch_file"]
assert stable(Path(branch_ref["path"]), branch_ref) == (target + chr(10)).encode()

for role, oid in base.items():
    expected_head = target if role == "accelerate" else oid
    assert revision(role) == expected_head
    assert revision(role, "refs/remotes/origin/main") == oid == origin(role)
    assert observe(role, "remote", "get-url", "origin").decode().strip().removesuffix(".git") == urls[role]
    assert observe(role, "remote", "get-url", "--push", "origin").decode().strip().removesuffix(".git") == urls[role]
    clean(role)
    if role != "accelerate":
        assert revision(role, "HEAD^{tree}") == freeze["preserved_peers"][role]["tree"]
indices_before = {role:index_snapshot(role) for role in base}
assert indices_before["accelerate"] == qualification["frozen_A_index"]
assert indices_before["datasets"] == freeze["preserved_peers"]["datasets"]["stage0_index"]
previous = rows_at("accelerate", base["accelerate"])
current = rows_at("accelerate", target)
paths = {
    "ipfs_accelerate_py/cli_integrations/openai_codex_cli_integration.py": "100755",
    "test/api/test_codex_thread_handoff.py": "100644",
}
posts = {row["relative_path"]:row for row in source["installed"]}
assert set(paths) == set(freeze["committed"]) == set(posts)
assert set(previous) == set(current)
assert {path for path in current if current[path] != previous[path]} == set(paths)
for path, mode in paths.items():
    row = posts[path]
    oid = row["expected_committed_blob"]
    assert freeze["committed"][path]["committed_blob"] == oid
    assert current[path] == (mode, "blob", oid)
    assert previous[path] == (mode, "blob", row["before_blob"])
    assert row["path"] == str(repos / "accelerate" / path)
    raw = stable(Path(row["path"]), row)
    assert observe("accelerate", "cat-file", "blob", oid) == raw
    assert observe("accelerate", "ls-files", "--stage", "--", path).decode().rstrip(chr(10)) == f"{mode} {oid} 0" + chr(9) + path
assert rows_at("hallucinate", base["hallucinate"])["ipfs_datasets_py"] == ("160000", "commit", base["datasets"])
assert rows_at("root", base["root"])["external/ipfs_datasets"] == ("160000", "commit", base["datasets"])
record(dict(preflight_exact=True, remotes_before=base, testcases=100, only_exact_two_A_blobs=sorted(paths)))

