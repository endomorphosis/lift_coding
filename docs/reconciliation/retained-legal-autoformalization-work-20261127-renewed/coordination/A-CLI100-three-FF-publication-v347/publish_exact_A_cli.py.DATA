    index_before=indices_before,index_after=indices_after,repositories=repositories,pushes_in_actual_order=pushes,
    datasets_Guide527_unchanged=True,exact_parent_links_only=True,no_Source_test_CI_replay=True)
raw=(json.dumps(body,sort_keys=True,indent=2)+chr(10)).encode()
fd=os.open(output,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o400)
with os.fdopen(fd,"wb") as stream:
    stream.write(raw)
    stream.flush()
    os.fsync(stream.fileno())
assert output.read_bytes()==raw
print(json.dumps(dict(path=str(output),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),heads=heads)),flush=True)
