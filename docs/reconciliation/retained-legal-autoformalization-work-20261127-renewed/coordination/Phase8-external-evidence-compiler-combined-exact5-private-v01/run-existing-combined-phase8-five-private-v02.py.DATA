"""Fixture-only external benchmark evaluation, denying models and subprocesses."""
import hashlib
import importlib.abc
import importlib.util
import json
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent
mode = sys.argv[4]
guard = Path(sys.argv[5])
assert mode in {"red", "green"}
assert sys.argv[2] == "red"  # Do not activate the unrelated proof-cache overlays.
starter = guard.read_text()
assert hashlib.sha256(starter.encode()).hexdigest() == "b3fe749fe409c404a426669781c4807538115fda1127534bbb3c8613853fd42e"
marker = 'owner = repo / "tests/unit/logic/legal_ir/test_proof_cache.py"'
assert starter.count(marker) == 1
environment = {"__file__": str(guard)}
exec(compile(starter.split(marker, 1)[0], str(guard), "exec", dont_inherit=True), environment)
repo, working = environment["repo"], environment["working"]
os.chdir(working)
os.environ["PYTEST_DISABLE_PLUGIN_AUTOLOAD"] = "1"
OVERLAYS = {'scripts.ops.legal_ir.hammer_leanstral_rollout_gate': ('scripts/ops/legal_ir/hammer_leanstral_rollout_gate.py', (('hammer_leanstral_rollout_gate.py.red.DATA', 217722, 'ccc8334295437ac903b3a5b4fcc19f3e57c071171f1bd99ee153aa78f33fa7c0'), ('hammer_leanstral_rollout_gate.py.green.DATA', 221541, '9785ff320f6ab5b16e9c933d6519cfed5b0abe2b7d9db58a363a782b612b167c'))), 'ipfs_datasets_py.optimizers.logic_theorem_optimizer.legal_ir_external_benchmark': ('ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_ir_external_benchmark.py', (('legal_ir_external_benchmark.py.red.DATA', 37952, '9ad1187907f37120be9929da6967ba3753cb6887696b48c2386e13854c2df000'), ('legal_ir_external_benchmark.py.green.DATA', 38313, '99397ab0476b222e78a74bfb03d69ed85b9518ae9df330c195c6433da5cb5c27')))}
TESTS = ['tests/unit/optimizers/logic_theorem_optimizer/test_compiler_system_promotion_gate.py', 'tests/unit/optimizers/logic_theorem_optimizer/test_external_validity_promotion_gate.py', 'tests/unit/optimizers/logic_theorem_optimizer/test_legal_ir_external_benchmark.py']
class PrivateOwners(importlib.abc.MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname == 'tests.unit.optimizers.logic_theorem_optimizer.test_external_validity_promotion_gate':
            relative = 'tests/unit/optimizers/logic_theorem_optimizer/test_external_validity_promotion_gate.py'
            path = root / "isolated" / relative
            assert hashlib.sha256(path.read_bytes()).hexdigest() == 'dfbf3ace8d5d0fa5b6e16bacd4c0ffedb80b8d636f29e398299a80e7ceef1a43'
            return importlib.util.spec_from_file_location(
                fullname, path, loader=environment["GuardedLoader"](relative, path)
            )
        role = OVERLAYS.get(fullname)
        if role is None:
            return None
        relative, pins = role
        leaf, count, digest = pins[mode == "green"]
        post = root / leaf
        raw = post.read_bytes()
        assert len(raw) == count and hashlib.sha256(raw).hexdigest() == digest
        return importlib.util.spec_from_file_location(
            fullname, repo / relative, loader=environment["GuardedLoader"](relative, post)
        )

owner_loader = PrivateOwners()
sys.meta_path.insert(0, owner_loader)
import pytest

class ExactHelperImport:
    def pytest_sessionstart(self, session):
        # Pytest registers its rewrite hook ahead of user finders. Keep
        # this exact loader first for the qualified sibling fixture.
        sys.meta_path.remove(owner_loader)
        sys.meta_path.insert(0, owner_loader)
fixture = root / "isolated/tests/fixtures/legal_ir/external_expert_benchmark.jsonl"
result = int(pytest.main([
    "-c", "/dev/null", "--noconftest", "-p", "no:cacheprovider", "--rootdir", str(root / "isolated"),
    "-q", "--tb=short", "-k", "not (test_external_validity_cli_writes_decision_and_report or test_compiler_system_gate_cli_writes_decision_and_report)",
    f"--basetemp={working / 'pytest'}", f"--junitxml={working / 'junit.xml'}",
    f"--log-file={working / 'pytest.log'}", *(str(root / "isolated" / item) for item in TESTS),
], plugins=[ExactHelperImport()]))
helper = "tests.unit.optimizers.logic_theorem_optimizer.test_external_validity_promotion_gate"
helper_path = str(root / "isolated/tests/unit/optimizers/logic_theorem_optimizer/test_external_validity_promotion_gate.py")
assert any(row["module"] == helper and row["actual_bytes"] == helper_path for row in environment["watched"])
assert sys.modules[helper].__file__ == helper_path
print(json.dumps({"mode": mode, "pytest_exit": result, "guard_events": environment["denied"],
                  "overlays": environment["watched"],
                  "fixture": hashlib.sha256(fixture.read_bytes()).hexdigest(),
                  "tests": {rel: hashlib.sha256((root/"isolated"/rel).read_bytes()).hexdigest()
                            for rel in TESTS}}, sort_keys=True))
raise SystemExit(result if not environment["denied"] else 2)
