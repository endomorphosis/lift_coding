assert {path for path in old if old[path] != new[path]} == set(committed)
assert set(q['compiled_source_sha256_by_path']) == set(recorded)
for path, row in committed.items():
    blob = row['stage0_and_committed_blob']
    assert row['path'] == str(repos/'datasets'/path)
    assert {k:row[k] for k in keys} == recorded[row['path']]
    assert q['compiled_source_sha256_by_path'][row['path']] == row['sha256']
    for phase in phases:
        binding = phase['actual_binding']
        if path.startswith('tests/'):
            witness = binding['actual_test_rewrite_source_to_code'][row['path']]
            assert witness['compile_source_sha256'] == row['sha256'] and witness['compile_source_full9'] == row['full9']
            assert witness['source_to_AST_observed'] and witness['AST_to_code_observed'] and witness['code_execution_observed']
        else:
            assert binding['actual_compiled_current_Source'][row['path']] == row['sha256']
    assert row['git_mode'] == '100644'
    assert old[path] == ('100644', 'blob', row['parent_blob'])
    assert new[path] == ('100644', 'blob', blob)
    assert observe('datasets', 'ls-files', '--stage', '-z', '--', path) == f'100644 {blob} 0\t{path}\0'.encode()
    assert observe('datasets', 'cat-file', 'blob', blob) == stable(Path(row['path']), row)

