def idx(role):
    path = repos/role/'.git/index'
    with os.fdopen(os.open(path, os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK), 'rb') as f:
        first = {key:str(getattr(os.fstat(f.fileno()), key)) for key in fields}
        sha = hashlib.file_digest(f, 'sha256').hexdigest()
        last = {key:str(getattr(os.fstat(f.fileno()), key)) for key in fields}
    assert first == last == {key:str(getattr(path.lstat(), key)) for key in fields}
    return dict(path=str(path), bytes=int(first['st_size']), sha256=sha, full9=first)

indices = {}
for role, parent in base.items():
    assert origin(role) == revision(role, 'refs/remotes/origin/main') == parent, role
    assert revision(role) == (d if role == 'datasets' else parent), role
    for option in ((), ('--push',)):
        assert observe(role, 'remote', 'get-url', *option, 'origin').decode().strip().removesuffix('.git') == urls[role]
    clean(role)
    indices[role] = idx(role)
assert indices['datasets'] == freeze['frozen']['index']
assert all(indices[k] == freeze['unchanged_peers'][k]['index'] for k in base if k != 'datasets')
keys = ('path', 'bytes', 'sha256', 'full9')
