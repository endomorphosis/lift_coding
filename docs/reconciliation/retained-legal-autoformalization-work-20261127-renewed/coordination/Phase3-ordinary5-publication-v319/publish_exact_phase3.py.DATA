def stable_meta(path):
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as stream:
        st=os.fstat(stream.fileno())
        assert stat.S_ISREG(st.st_mode) and st.st_nlink==1
        before={k:str(getattr(st,k)) for k in fields}
        digest=hashlib.file_digest(stream,'sha256').hexdigest()
        after={k:str(getattr(os.fstat(stream.fileno()),k)) for k in fields}
    assert before==after=={k:str(getattr(path.lstat(),k)) for k in fields}
    return {'path':str(path),'bytes':int(after['st_size']),'sha256':digest,'full9':after}

