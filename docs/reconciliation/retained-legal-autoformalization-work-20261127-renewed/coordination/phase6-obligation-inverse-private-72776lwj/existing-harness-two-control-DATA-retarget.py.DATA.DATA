def audit(event, args):
    if event.startswith(("subprocess.", "socket.")) or event in (
        "os.fork", "os.forkpty", "os.posix_spawn", "os.exec", "os.system",
        "os.mkdir", "os.remove", "os.rename", "os.truncate", "os.rmdir",
    ):
        raise RuntimeError("engineering cohort denies process/network/filesystem mutation")
    if event == "open":
        path, mode, flags = args
        if isinstance(path, (str, bytes)) and str(path).startswith("/home/"):
            raise RuntimeError("engineering cohort denies canonical Source reads")
        if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
            raise RuntimeError("engineering cohort has stdout-only output")

sys.addaudithook(audit)

class CachedOnly(importlib.abc.MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname.startswith("ipfs_datasets_py"):
            raise ImportError("unbound project module: " + fullname)
        return None

sys.meta_path.insert(0, CachedOnly())
for name in (
    "ipfs_datasets_py", "ipfs_datasets_py.logic", "ipfs_datasets_py.logic.families",
    "ipfs_datasets_py.logic.syntax_core", "ipfs_datasets_py.logic.autoformal",
    "ipfs_datasets_py.logic.legal_ir",
):
    module = types.ModuleType(name)
    module.__path__ = []
    sys.modules[name] = module
    if "." in name:
        parent, child = name.rsplit(".", 1)
        setattr(sys.modules[parent], child, module)

def load(relative_path, selected=None):
    name = relative_path[:-3].replace("/", ".")
    raw = cached[relative_path]
    tree = pyast.parse(raw, filename="cached:" + relative_path)
    if selected is not None:
        tree.body = [node for node in tree.body if (
            isinstance(node, pyast.ImportFrom) and node.module == "__future__"
            or isinstance(node, (pyast.FunctionDef, pyast.ClassDef)) and node.name in selected
            or isinstance(node, pyast.Assign)
        )]
    module = types.ModuleType(name)
    module.__file__ = next(row["path"] for row in manifest["records"] if row["repo_relative_path"] == relative_path)
    module.__package__ = name.rsplit(".", 1)[0]
    sys.modules[name] = module
    setattr(sys.modules[module.__package__], name.rsplit(".", 1)[1], module)
    if selected is not None:
        from itertools import combinations
        module.combinations = combinations
    if relative_path.endswith("/extended_compiler.py"):
        import re
        owner = sys.modules["ipfs_datasets_py.logic.legal_ir.extended_decompiler"]
        module.__dict__.update(json=json, re=re, MAX_RENDERED_UTF8_BYTES=owner.MAX_RENDERED_UTF8_BYTES)
    exec(compile(tree, module.__file__, "exec"), module.__dict__)
    return module


