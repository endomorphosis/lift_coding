def index_snapshot(role):
    path = repos/role/'.git/index'
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as f:
        before={key:str(getattr(os.fstat(f.fileno()),key)) for key in fields}
        sha=hashlib.file_digest(f,'sha256').hexdigest()
        last={key:str(getattr(os.fstat(f.fileno()),key)) for key in fields}
    assert before==last=={key:str(getattr(path.lstat(),key)) for key in fields}
    return {'path':str(path),'bytes':int(before['st_size']),'sha256':sha,'full9':before}
indices_before={role:index_snapshot(role) for role in base}

