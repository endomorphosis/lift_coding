old_docs, prepared = {}, {}
for path in sorted(targets):
    row, planned = docs[path], manifest[path]
    assert row["path"] == str(docdir/path)
    assert row["before_blob"] == planned["before_Git_blob_oid"] == revision("datasets",base["datasets"]+":"+path)
    old = observe('datasets','cat-file','blob',base['datasets']+':'+path)
    archived_before = planned['before_private']
    assert archived_before == row['before_private'] and old == checked_ref(archived_before)
    new = stable(Path(row['path']),row)
    assert row['post_private'] == planned['post_private'] and new == checked_ref(planned['post_private'])
    assert checked_ref(planned["forward_patch"]) and checked_ref(planned["inverse_patch"])
    insert = planned['surgical_insertion']
    offset, n = insert['offset'], insert['inserted_bytes']
    fragment = checked_ref(insert["fragment_reference"])
    assert len(fragment) == n and hashlib.sha256(fragment).hexdigest() == insert["inserted_sha256"]
    assert new[offset:offset+n] == fragment and old[:offset]+fragment+old[offset:] == new
    assert new[:offset]+new[offset+n:] == old
    if path.endswith('.md'):
        assert offset == len(old)
    old_docs[path] = old
    prepared[path] = new

