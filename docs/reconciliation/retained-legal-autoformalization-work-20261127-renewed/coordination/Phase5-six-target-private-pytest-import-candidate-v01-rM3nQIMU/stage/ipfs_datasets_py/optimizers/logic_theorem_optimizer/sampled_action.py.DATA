"""Private decoder sample and column binding, built on the masked scorer."""
from dataclasses import asdict, dataclass
from hashlib import sha256
import json
from math import exp, isfinite, log, log1p
import sys


PREFIX_PROFILE = "causal-autonomous-full-prefix-final-logit/v1"
ENCODER_DECODER_PROFILE = "encoder-decoder-unpadded-full-prefix-native-head/v1"
QWEN_PROJECTED_PROFILE = "qwen2-chatml-complete-prefix-projected-native-head/v1"
QWEN_CONDITIONING_PROFILE = "qwen2-chatml-digest-omitted-legal-ir/v1"
QWEN_CACHED_PROFILE = "qwen2-chatml-owned-kv-behavior/v1"
QWEN_NATIVE_CACHE = "builtin-qwen2-dynamic-kv/v1"
QWEN_TEACHER_CACHE = "qwen2-chatml-one-teacher-slot-dynamic-kv/v1"
QWEN_TEACHER_CANDIDATE = "qwen2-chatml-one-teacher-slot-fresh-full-prefix/v1"
QWEN_TEACHER_BRIDGE = "qwen2-teacher-kv-integer-mass-behavior-fresh-smooth-candidate/v1"
QWEN_FRESH_CANDIDATE_PROFILE = "qwen2-chatml-full-prefix-explicit-no-cache/v1"
QWEN_CACHED_BRIDGE = "qwen2-kv-integer-mass-behavior-full-prefix-smooth-candidate/v1"
SAMPLER = "binary64-exp-exact-integer-mass/v1"
BRIDGE = "integer-mass-behavior-smooth-candidate/v1"
SAMPLER_CONTRACT_SHA256 = sha256(SAMPLER.encode("ascii")).hexdigest()
LOGIT_DTYPES = ("torch.float16", "torch.bfloat16", "torch.float32", "torch.float64")


def _digest(value):
    raw = json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(",", ":"), allow_nan=False)
    return sha256(raw.encode("ascii")).hexdigest()


def _pin(value):
    return type(value) is str and len(value) == 64 and all(c in "0123456789abcdef" for c in value)


def _need(ok, message):
    if not ok:
        raise ValueError(message)


@dataclass(frozen=True)
class PrefixFrame:
    source_record_sha256: str
    tokenizer_sha256: str
    forward_profile_sha256: str
    prompt_ids: tuple[int, ...]
    generated_body_ids: tuple[int, ...]

    def digest(self):
        _need(all(_pin(x) for x in (self.source_record_sha256, self.tokenizer_sha256, self.forward_profile_sha256)),
              "independent source, tokenizer and full-prefix profile pins required")
        _need(type(self.prompt_ids) is tuple and bool(self.prompt_ids) and type(self.generated_body_ids) is tuple,
              "exact consumed prompt and earlier generated body IDs required")
        _need(all(type(x) is int and x >= 0 for x in self.prompt_ids + self.generated_body_ids),
              "ordinary model-consumed token IDs required")
        return _digest({"profile": PREFIX_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class EncoderDecoderPrefixFrame:
    source_record_sha256: str
    tokenizer_sha256: str
    forward_profile_sha256: str
    encoder_input_ids: tuple[int, ...]
    encoder_attention_mask: tuple[int, ...]
    behavior_forward_receipt_sha256: str
    decoder_bos_token_id: int
    generated_body_ids: tuple[int, ...]

    def digest(self):
        _need(all(_pin(value) for value in (self.source_record_sha256, self.tokenizer_sha256,
                                            self.forward_profile_sha256, self.behavior_forward_receipt_sha256)),
              "independent encoder source, tokenizer, profile and behavior forward pins required")
        _need(type(self.encoder_input_ids) is tuple and bool(self.encoder_input_ids)
            and type(self.encoder_attention_mask) is tuple
            and len(self.encoder_attention_mask) == len(self.encoder_input_ids)
            and all(type(item) is int and item == 1 for item in self.encoder_attention_mask)
            and type(self.generated_body_ids) is tuple,
            "unpadded encoder source and exact all-ones mask required")
        _need(all(type(item) is int and item >= 0 for item in (
                   *self.encoder_input_ids, self.decoder_bos_token_id, *self.generated_body_ids)),
              "ordinary encoder IDs and exact decoder BOS and generated IDs required")
        return _digest({"profile": ENCODER_DECODER_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class EncoderDecoderObservation:
    frame_sha256: str
    policy_sha256: str
    owner_forward_receipt_sha256: str
    encoder_input_ids: tuple[int, ...]
    encoder_attention_mask: tuple[int, ...]
    decoder_input_ids: tuple[int, ...]
    cache_reused: bool
    native_unprojected_head: bool

    def digest(self):
        return _digest({"profile": ENCODER_DECODER_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class EncoderDecoderHead:
    tensor: object
    observation: EncoderDecoderObservation
    expected_observation_sha256: str


@dataclass(frozen=True)
class ProjectedQwenPrefixFrame:
    source_record_sha256: str
    tokenizer_sha256: str
    forward_profile_sha256: str
    behavior_forward_receipt_sha256: str
    framed_prompt_ids: tuple[int, ...]
    generated_body_ids: tuple[int, ...]
    tokenizer_vocab_size: int
    logical_bos_token_id: int
    eos_token_id: int

    def _validate_chatml(self):
        _need(all(_pin(value) for value in (self.source_record_sha256, self.tokenizer_sha256,
                                    self.forward_profile_sha256, self.behavior_forward_receipt_sha256)),
              "independent source, tokenizer, profile and projected behavior forward pins required")
        _need(type(self.tokenizer_vocab_size) is int and self.tokenizer_vocab_size >= 3
            and type(self.framed_prompt_ids) is tuple and bool(self.framed_prompt_ids)
            and type(self.generated_body_ids) is tuple
            and all(type(token) is int and 0 <= token < self.tokenizer_vocab_size
                    for token in (*self.framed_prompt_ids, *self.generated_body_ids,
                                  self.logical_bos_token_id, self.eos_token_id))
            and self.logical_bos_token_id != self.eos_token_id
            and self.logical_bos_token_id not in self.framed_prompt_ids
            and not {self.logical_bos_token_id, self.eos_token_id}.intersection(self.generated_body_ids),
            "complete ChatML prompt and prior live tokenizer-domain body required")

    def digest(self):
        self._validate_chatml()
        return _digest({"profile": QWEN_PROJECTED_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class CachedQwenBehaviorFrame(ProjectedQwenPrefixFrame):
    """One owner-attested transition, with no retained or replayed KV tensors."""

    cache_session_sha256: str
    input_cache_revision_sha256: str
    output_cache_revision_sha256: str

    def _validate_cache(self):
        self._validate_chatml()
        _need(all(_pin(value) for value in (self.cache_session_sha256,
                    self.input_cache_revision_sha256, self.output_cache_revision_sha256))
            and self.input_cache_revision_sha256 != self.output_cache_revision_sha256,
            "owned cache session and advancing revision required")

    def digest(self):
        self._validate_cache()
        return _digest({"profile": QWEN_CACHED_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class TeacherCachedQwenFrame(CachedQwenBehaviorFrame):
    teacher_row_id: str
    teacher_conditioning_sha256: str

    def digest(self):
        self._validate_cache()
        _need(type(self.teacher_row_id) is str and 1 <= len(self.teacher_row_id) <= 512
              and _pin(self.teacher_conditioning_sha256), "exact teacher conditioning commitment required")
        return _digest({"profile": QWEN_TEACHER_CACHE, **asdict(self)})


@dataclass(frozen=True)
class CachedQwenObservation:
    frame_sha256: str
    policy_sha256: str
    owner_forward_receipt_sha256: str
    cache_session_sha256: str
    input_cache_revision_sha256: str
    output_cache_revision_sha256: str
    input_cache_length: int
    output_cache_length: int
    input_ids: tuple[int, ...]
    attention_mask: tuple[int, ...]
    position_ids: tuple[int, ...]
    logits_to_keep: int
    conditioning_profile: str
    generation_profile: str
    model_family: str
    forward_keywords: tuple[str, ...]
    use_cache: bool
    returned_owned_cache: bool

    def digest(self):
        return _digest({"profile": QWEN_CACHED_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class TeacherCachedQwenObservation(CachedQwenObservation):
    # The inherited input_ids describe text IDs before the embedding lookup.
    # Native kwargs independently identify whether IDs entered the model.
    teacher_conditioning_sha256: str
    slot_observed_at_prefill: bool

    def digest(self):
        return _digest({"profile": QWEN_TEACHER_CACHE, **asdict(self)})


@dataclass(frozen=True)
class CachedQwenBehaviorHead:
    tensor: object
    observation: CachedQwenObservation
    expected_observation_sha256: str


@dataclass(frozen=True)
class ProjectedQwenObservation:
    frame_sha256: str
    policy_sha256: str
    owner_forward_receipt_sha256: str
    input_ids: tuple[int, ...]
    attention_mask: tuple[int, ...]
    input_position: int
    logits_to_keep: int
    conditioning_profile: str
    generation_profile: str
    model_family: str
    forward_keywords: tuple[str, ...]
    cache_reused: bool

    def digest(self):
        return _digest({"profile": QWEN_PROJECTED_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class FreshQwenCandidateObservation(ProjectedQwenObservation):
    use_cache: bool
    returned_cache: bool

    def digest(self):
        return _digest({"profile": QWEN_FRESH_CANDIDATE_PROFILE, **asdict(self)})


@dataclass(frozen=True)
class TeacherFreshQwenObservation(FreshQwenCandidateObservation):
    teacher_conditioning_sha256: str
    position_ids: tuple[int, ...]

    def digest(self):
        return _digest({"profile": QWEN_TEACHER_CANDIDATE, **asdict(self)})


@dataclass(frozen=True)
class ProjectedQwenHead:
    tensor: object
    observation: ProjectedQwenObservation
    expected_observation_sha256: str


@dataclass(frozen=True)
class ActionColumns:
    model_width: int
    ordered_columns: tuple[int, ...]

    def digest(self, support):
        _need(type(self.model_width) is int and self.model_width > 0
              and type(self.ordered_columns) is tuple
              and len(self.ordered_columns) == len(support.ordered_actions)
              and all(type(x) is int and 0 <= x < self.model_width for x in self.ordered_columns)
              and len(set(self.ordered_columns)) == len(self.ordered_columns),
              "exact one-to-one ordered model-head columns required")
        return _digest({"model_width": self.model_width, "mapping": list(
            zip(support.ordered_actions, self.ordered_columns, strict=True))})


@dataclass(frozen=True)
class DrawIdentity:
    stream_sha256: str
    ordinal: int


@dataclass(frozen=True)
class Sample:
    profile: str
    trajectory_id: str
    action_position: int
    prefix_sha256: str
    action_columns_sha256: str
    support_sha256: str
    behavior_policy_sha256: str
    behavior_logit_dtype: str
    eligible_logits_sha256: str
    mass_roster_sha256: str
    action_id: str
    output_column: int
    rng_event: DrawIdentity | None
    draw: int | None
    total_mass: int
    selected_mass: int
    exact_mass_log_probability: float
    smooth_reference_log_probability: float

    def digest(self):
        return _digest(asdict(self))


def _support(mask, *, support, frame, expected_prefix_sha256, columns,
             expected_action_columns_sha256, expected_support_sha256):
    _need(type(frame) in (PrefixFrame, EncoderDecoderPrefixFrame, ProjectedQwenPrefixFrame, CachedQwenBehaviorFrame, TeacherCachedQwenFrame)
          and _pin(expected_prefix_sha256)
          and frame.digest() == expected_prefix_sha256, "consumed prefix binding differs")
    _need(type(support) is mask.SupportBinding
          and support == mask.bind_support(support.policy, support.ordered_actions, support.allowed)
          and _pin(expected_support_sha256)
          and support.sha256 == expected_support_sha256
          and support.policy.sampler_contract_sha256 == SAMPLER_CONTRACT_SHA256,
          "ordered support or exact sampler contract differs")
    _need(type(columns) is ActionColumns and _pin(expected_action_columns_sha256)
          and columns.digest(support) == expected_action_columns_sha256, "action column mapping differs")
    if type(frame) is EncoderDecoderPrefixFrame:
        _need(all(item < columns.model_width for item in (
               *frame.encoder_input_ids, frame.decoder_bos_token_id, *frame.generated_body_ids)),
               "encoder and decoder IDs must fit the selected shared tokenizer vocabulary")
    if type(frame) in (ProjectedQwenPrefixFrame, CachedQwenBehaviorFrame, TeacherCachedQwenFrame):
        _need(frame.tokenizer_vocab_size <= columns.model_width <= frame.tokenizer_vocab_size + 4096
              and all(column < frame.tokenizer_vocab_size for column in columns.ordered_columns),
              "projected head padding is outside the ordered tokenizer action domain")


def _behavior_origin(support, trajectory_id, behavior_policy_sha256, behavior_logit_dtype, rng_event, draw):
    _need(type(trajectory_id) is str and bool(trajectory_id) and _pin(behavior_policy_sha256),
          "trajectory and behavior checkpoint identity required")
    _need(type(behavior_logit_dtype) is str and behavior_logit_dtype in LOGIT_DTYPES,
          "supported declared behavior logit dtype required")
    if sum(support.allowed) == 1:
        _need(rng_event is None, "forced action cannot declare a consumed draw")
    else:
        _need(type(rng_event) is DrawIdentity and _pin(rng_event.stream_sha256)
              and type(rng_event.ordinal) is int and rng_event.ordinal >= 0 and callable(draw),
              "independently tracked RNG event and uniform integer draw owner required")


def _mass_roster(mask, *, support, ordered_logits):
    _need(type(ordered_logits) in (list, tuple) and len(ordered_logits) == len(support.ordered_actions),
          "one declared ordered logit per action required")
    permitted = tuple(index for index, yes in enumerate(support.allowed) if yes)
    raw = tuple(mask._number(ordered_logits[index]) for index in permitted)
    maximum = max(raw)
    _need(support.policy.temperature >= sys.float_info.min,
          "sampler reference temperature is below its normal numeric range")
    weights = tuple(exp((x - maximum) / support.policy.temperature) for x in raw)
    _need(all(isfinite(weight) and weight >= sys.float_info.min for weight in weights),
          "exact integer sampler requires positive normal allowed weights")
    # Every binary64 weight is an exact dyadic rational. Integerizing the
    # weights together avoids CDF rounding away an allowed action.
    ratios = [weight.as_integer_ratio() for weight in weights]
    common = max(denominator for _, denominator in ratios)
    masses = tuple(numerator * (common // denominator) for numerator, denominator in ratios)
    return permitted, raw, masses


def _log_probability(mass, total):
    if mass > total // 2:
        return log1p(-(total - mass) / total)
    # Positive normal weights normalized over a large vocabulary can yield a
    # subnormal probability. The log stays meaningful in binary64.
    p = mass / total
    return log(p) if p > sys.float_info.min else log(mass) - log(total)


def _sample(mask, *, frame, expected_prefix_sha256, columns, expected_action_columns_sha256,
            support, expected_support_sha256, ordered_logits, trajectory_id,
            behavior_policy_sha256, behavior_logit_dtype, rng_event, draw_for_total):
    _support(mask, support=support, frame=frame, expected_prefix_sha256=expected_prefix_sha256, columns=columns,
             expected_action_columns_sha256=expected_action_columns_sha256,
             expected_support_sha256=expected_support_sha256)
    _behavior_origin(support, trajectory_id, behavior_policy_sha256, behavior_logit_dtype, rng_event, draw_for_total)
    _need(type(ordered_logits) in (list, tuple), "ordinary ordered logit snapshot required")
    ordered_logits = tuple(ordered_logits)
    permitted, raw, masses = _mass_roster(mask, support=support, ordered_logits=ordered_logits)
    total = sum(masses)
    if len(permitted) == 1:
        local, draw = 0, None
        profile = "forced-no-draw/v1"
    else:
        event_identity = (rng_event.stream_sha256, rng_event.ordinal)
        draw = draw_for_total(total)
        _need(type(draw) is int and 0 <= draw < total, "uniform integer draw is outside its declared range")
        # Check the frozen origin again before issuing a receipt from an
        # injected callback. A refusal does not undo an already consumed draw.
        _support(mask, support=support, frame=frame, expected_prefix_sha256=expected_prefix_sha256,
                 columns=columns, expected_action_columns_sha256=expected_action_columns_sha256,
                 expected_support_sha256=expected_support_sha256)
        _need((rng_event.stream_sha256, rng_event.ordinal) == event_identity
              and type(rng_event.ordinal) is int, "RNG event changed during its draw")
        rng_event = DrawIdentity(*event_identity)
        cumulative = 0
        for local, mass in enumerate(masses):
            cumulative += mass
            if draw < cumulative:
                break
        profile = SAMPLER
    index = permitted[local]
    action = support.ordered_actions[index]
    analytical = mask.score_masked_choice(expected_support=support, policy=support.policy,
        action_ids=support.ordered_actions, allowed=support.allowed, logits=ordered_logits, selected_action_id=action)
    return Sample(profile, trajectory_id, len(frame.generated_body_ids), expected_prefix_sha256,
                  expected_action_columns_sha256, expected_support_sha256, behavior_policy_sha256,
                  behavior_logit_dtype, _digest([x.hex() for x in raw]), _digest(list(masses)), action, columns.ordered_columns[index],
                  rng_event, draw, total, masses[local], _log_probability(masses[local], total),
                  analytical.natural_log_probability)


def sample_behavior(mask, *, draw_uniform_integer, **bound):
    """Sample using one caller-owned uniform-integer event, or record a forced action."""
    frame = bound.get("frame")
    _need(type(frame) not in (EncoderDecoderPrefixFrame, ProjectedQwenPrefixFrame, CachedQwenBehaviorFrame, TeacherCachedQwenFrame),
          "typed architecture sampling requires its observed forward head")
    return _sample(mask, draw_for_total=draw_uniform_integer, **bound)


def replay_behavior(mask, *, receipt, expected_receipt_sha256, **bound):
    """Check a retained receipt against exact pins and ordered logits, without RNG."""
    _need(type(receipt) is Sample and _pin(expected_receipt_sha256)
          and receipt.digest() == expected_receipt_sha256, "independent behavior receipt pin differs")
    rebuilt = _sample(mask, draw_for_total=lambda total: receipt.draw, **bound)
    _need(rebuilt.digest() == expected_receipt_sha256, "saved action or integer probability differs from exact replay")
    return rebuilt


def _bound_forward(head, head_type, observation_type, frame, expected_policy_sha256, behavior, label):
    _need(type(head) is head_type and type(head.observation) is observation_type
          and _pin(head.expected_observation_sha256)
          and head.observation.digest() == head.expected_observation_sha256,
          f"independently pinned observed {label} forward required")
    observation = head.observation
    _need(observation.frame_sha256 == frame.digest()
        and observation.policy_sha256 == expected_policy_sha256 and _pin(observation.owner_forward_receipt_sha256)
        and (not behavior or observation.owner_forward_receipt_sha256 == frame.behavior_forward_receipt_sha256),
        ("observed encoder input or forward owner differs" if label == "encoder-decoder"
         else f"observed {label} forward or owner differs"))
    return observation


def _validate_cached_qwen_observation(observation, frame):
    body = frame.generated_body_ids
    teacher = type(frame) is TeacherCachedQwenFrame
    output_length = len(frame.framed_prompt_ids) + len(body) + int(teacher)
    prefill_slot = teacher and not body
    expected_keys = ("attention_mask", "inputs_embeds" if prefill_slot else "input_ids", "logits_to_keep",
                     "past_key_values", "position_ids", "use_cache")
    if teacher:
        _need(observation.teacher_conditioning_sha256 == frame.teacher_conditioning_sha256
              and observation.slot_observed_at_prefill is prefill_slot,
              "observed teacher prefill or conditioning differs")
    input_length = output_length - 1 if body else 0
    step_ids = body[-1:] if body else frame.framed_prompt_ids
    geometry = (observation.input_ids, observation.attention_mask, observation.position_ids)
    _need(all(type(row) is tuple and all(type(token) is int for token in row) for row in geometry)
        and geometry == (step_ids, (1,) * output_length, tuple(range(input_length, output_length)))
        and type(observation.input_cache_length) is int and observation.input_cache_length == input_length
        and type(observation.output_cache_length) is int and observation.output_cache_length == output_length
        and type(observation.logits_to_keep) is int and observation.logits_to_keep == 1
        and observation.conditioning_profile == QWEN_CONDITIONING_PROFILE
        and observation.generation_profile == (QWEN_TEACHER_CACHE if teacher else QWEN_NATIVE_CACHE)
        and observation.model_family == "qwen2"
        and observation.forward_keywords == expected_keys
        and observation.use_cache is True and observation.returned_owned_cache is True,
        "observed Qwen2 KV input, positions, projection or owned cache geometry differs")
    _need((observation.cache_session_sha256, observation.input_cache_revision_sha256,
           observation.output_cache_revision_sha256) ==
          (frame.cache_session_sha256, frame.input_cache_revision_sha256, frame.output_cache_revision_sha256),
          "observed Qwen2 cache session or revision differs")


def _projected_qwen_forward_profile_matches(observation):
    fixed_keywords = ("attention_mask", "input_ids", "logits_to_keep")
    if type(observation) is FreshQwenCandidateObservation:
        return (observation.generation_profile == QWEN_FRESH_CANDIDATE_PROFILE
                and observation.forward_keywords == (*fixed_keywords, "use_cache")
                and observation.use_cache is False and observation.returned_cache is False)
    return observation.generation_profile == "full-prefix/v1" and observation.forward_keywords == fixed_keywords


def _teacher_fresh_profile_matches(observation, frame, full_positions):
    return (observation.generation_profile == QWEN_TEACHER_CANDIDATE
            and observation.teacher_conditioning_sha256 == frame.teacher_conditioning_sha256
            and type(observation.position_ids) is tuple and all(type(x) is int for x in observation.position_ids)
            and observation.position_ids == tuple(range(full_positions))
            and observation.forward_keywords ==
                 ("attention_mask", "inputs_embeds", "logits_to_keep", "position_ids", "use_cache")
            and observation.use_cache is False and observation.returned_cache is False)


def _ordered_tensor(torch, head, frame, columns, declared_dtype, *, expected_policy_sha256, behavior=False):
    if type(frame) is EncoderDecoderPrefixFrame:
        observation = _bound_forward(head, EncoderDecoderHead, EncoderDecoderObservation, frame,
                                     expected_policy_sha256, behavior, "encoder-decoder")
        expected_prefix = (frame.decoder_bos_token_id, *frame.generated_body_ids)
        observed_ids = (observation.encoder_input_ids, observation.encoder_attention_mask, observation.decoder_input_ids)
        _need(all(type(items) is tuple and all(type(value) is int for value in items) for items in observed_ids)
            and observed_ids == (frame.encoder_input_ids, frame.encoder_attention_mask, expected_prefix)
            and observation.cache_reused is False and observation.native_unprojected_head is True,
            "observed encoder input, decoder prefix or unprojected head differs")
        tensor = head.tensor
        positions = len(expected_prefix)
    elif type(frame) in (CachedQwenBehaviorFrame, TeacherCachedQwenFrame) and behavior:
        cache_observation = TeacherCachedQwenObservation if type(frame) is TeacherCachedQwenFrame else CachedQwenObservation
        observation = _bound_forward(head, CachedQwenBehaviorHead, cache_observation, frame,
                                     expected_policy_sha256, True, "Qwen2 cached behavior")
        _validate_cached_qwen_observation(observation, frame)
        tensor = head.tensor
        positions = 1
    elif type(frame) in (ProjectedQwenPrefixFrame, CachedQwenBehaviorFrame, TeacherCachedQwenFrame):
        observation_type = ProjectedQwenObservation
        if type(frame) is TeacherCachedQwenFrame:
            observation_type = TeacherFreshQwenObservation
        elif (type(frame) is CachedQwenBehaviorFrame
                and type(getattr(head, "observation", None)) is FreshQwenCandidateObservation):
            observation_type = FreshQwenCandidateObservation
        observation = _bound_forward(head, ProjectedQwenHead, observation_type, frame,
                                     expected_policy_sha256, behavior, "Qwen2 projected")
        expected_prefix = frame.framed_prompt_ids + frame.generated_body_ids
        teacher = type(frame) is TeacherCachedQwenFrame
        full_positions = len(expected_prefix) + int(teacher)
        observed_ids = (observation.input_ids, observation.attention_mask)
        _need(all(type(items) is tuple and all(type(value) is int for value in items) for items in observed_ids)
            and observed_ids == (expected_prefix, (1,) * full_positions)
            and type(observation.input_position) is int and observation.input_position == full_positions - 1
            and type(observation.logits_to_keep) is int and observation.logits_to_keep == 1
            and observation.conditioning_profile == QWEN_CONDITIONING_PROFILE
            and observation.model_family == "qwen2" and observation.cache_reused is False
            and (_teacher_fresh_profile_matches(observation, frame, full_positions) if teacher
                 else _projected_qwen_forward_profile_matches(observation)),
            "observed Qwen2 ChatML prefix, projected position or cache mode differs")
        tensor = head.tensor
        positions = 1
    else:
        tensor = head
        positions = len(frame.prompt_ids) + len(frame.generated_body_ids)
    _need(torch.is_tensor(tensor) and tensor.ndim == 3 and tensor.shape[0] == 1
          and tensor.shape[1] == positions and tensor.shape[2] == columns.model_width
          and str(tensor.dtype) == declared_dtype,
          "single-row full-prefix model head differs from its declared geometry")
    return tensor[0, -1, list(columns.ordered_columns)]


def sample_behavior_tensor(torch, tensor, mask, *, frame, columns, behavior_logit_dtype,
                           draw_uniform_integer, expected_cached_observation_sha256=None, **bound):
    """Observe the behavior head at its declared column boundary.

    The forward owner retains the cache and authenticates its identity, the
    observation and live logit tensor before calling this scorer.
    """
    if type(frame) in (CachedQwenBehaviorFrame, TeacherCachedQwenFrame):
        _need(type(tensor) is CachedQwenBehaviorHead and _pin(expected_cached_observation_sha256)
              and tensor.expected_observation_sha256 == expected_cached_observation_sha256,
              "independent selected Qwen2 cached behavior commitment differs")
    else:
        _need(expected_cached_observation_sha256 is None, "unexpected cached observation on another behavior profile")
    _support(mask, support=bound["support"], frame=frame,
             expected_prefix_sha256=bound["expected_prefix_sha256"], columns=columns,
             expected_action_columns_sha256=bound["expected_action_columns_sha256"],
             expected_support_sha256=bound["expected_support_sha256"])
    _behavior_origin(bound["support"], bound["trajectory_id"], bound["behavior_policy_sha256"],
                     behavior_logit_dtype, bound["rng_event"], draw_uniform_integer)
    ordered = _ordered_tensor(torch, tensor, frame, columns, behavior_logit_dtype,
                              expected_policy_sha256=bound["behavior_policy_sha256"], behavior=True)
    observed = tuple(ordered.detach().cpu().tolist())
    sample = _sample(mask, frame=frame, columns=columns, behavior_logit_dtype=behavior_logit_dtype,
                     ordered_logits=observed, draw_for_total=draw_uniform_integer, **bound)
    return sample, observed


def candidate_term(term, torch, tensor, mask, *, receipt, expected_receipt_sha256,
                   expected_behavior_policy_sha256, expected_behavior_logit_dtype,
                   behavior_ordered_logits, expected_rng_event, frame, expected_prefix_sha256, columns,
                   expected_action_columns_sha256, support, expected_support_sha256,
                   candidate_policy_sha256, expected_candidate_policy_sha256,
                   expected_trajectory_id, bridge, advantage, clip_epsilon, expected_projected_observation_sha256=None):
    """Join a verified sampled receipt to differentiable candidate columns.

    Live tensor origin and the draw's ownership must already be authenticated
    by the existing caller. The behavior denominator uses exact dyadic
    masses. The candidate uses a continuous surrogate with a named scope.
    """
    _need(type(receipt) is Sample and receipt.profile == SAMPLER,
          "authenticated sampled behavior receipt required")
    expected_bridge = (QWEN_TEACHER_BRIDGE if type(frame) is TeacherCachedQwenFrame else
                       QWEN_CACHED_BRIDGE if type(frame) is CachedQwenBehaviorFrame else BRIDGE)
    _need(bridge == expected_bridge, "exact sampler and smooth candidate need the declared surrogate profile")
    _need(_pin(expected_candidate_policy_sha256) and candidate_policy_sha256 == expected_candidate_policy_sha256,
          "candidate checkpoint identity differs")
    receipt = replay_behavior(mask, receipt=receipt, expected_receipt_sha256=expected_receipt_sha256, frame=frame,
        expected_prefix_sha256=expected_prefix_sha256, columns=columns,
        expected_action_columns_sha256=expected_action_columns_sha256, support=support,
        expected_support_sha256=expected_support_sha256, ordered_logits=behavior_ordered_logits,
        trajectory_id=expected_trajectory_id, behavior_policy_sha256=expected_behavior_policy_sha256,
        behavior_logit_dtype=expected_behavior_logit_dtype, rng_event=expected_rng_event)
    choice = term.Choice(expected_trajectory_id, expected_prefix_sha256, receipt.action_position,
                         receipt.action_id, expected_support_sha256)
    behavior = term.ObservedBehavior(choice, expected_behavior_policy_sha256, "post-mask-categorical-sample",
                                    expected_receipt_sha256, receipt.exact_mass_log_probability)
    if type(frame) in (ProjectedQwenPrefixFrame, CachedQwenBehaviorFrame, TeacherCachedQwenFrame):
        _need(type(tensor) is ProjectedQwenHead and _pin(expected_projected_observation_sha256)
              and tensor.expected_observation_sha256 == expected_projected_observation_sha256,
              "independent selected Qwen2 candidate forward commitment differs")
    else:
        _need(expected_projected_observation_sha256 is None, "unexpected projected forward on another architecture")
    ordered = _ordered_tensor(torch, tensor, frame, columns, expected_behavior_logit_dtype,
                              expected_policy_sha256=expected_candidate_policy_sha256)
    return term.differentiable_conditional_loss(torch, ordered, mask, expected_choice=choice,
        expected_behavior_sha256=expected_behavior_policy_sha256, expected_candidate_sha256=expected_candidate_policy_sha256,
        expected_sampling_receipt_sha256=expected_receipt_sha256, support=support, behavior=behavior,
        candidate_choice=choice, candidate_policy_sha256=candidate_policy_sha256,
        advantage=advantage, clip_epsilon=clip_epsilon)


OWNER_ROLLOUT_PROFILE = "reviewed-qwen2-cached-sampled-rollout/v1"


@dataclass(frozen=True)
class CachedQwenRolloutRow:
    row_id: str
    trajectory_id: str
    source_wire_sha256: str
    source_and_context_sha256: str
    framed_prompt_sha256: str
    rng_stream_sha256: str


@dataclass(frozen=True)
class CachedQwenRolloutPolicy:
    """Inputs supplied by the existing pinned rollout and RNG owners.

    The caller authenticates model, tokenizer, support and source commitments.
    It allocates a single-use attempt and independent streams. The draw owner
    records consumption before returning or raising, including on failed runs.
    """

    attempt_sha256: str
    behavior_policy_sha256: str
    tokenizer_sha256: str
    forward_profile_sha256: str
    rows: tuple[CachedQwenRolloutRow, ...]
    mask_owner: object
    support_policy: object
    select_support: object
    draw_uniform_integer: object
    maximum_support_columns: int
    maximum_evidence_bytes: int


def _live_cache_call(arguments, cache, *, logical_text_ids=None):
    _need(arguments["past_key_values"] is cache and arguments["use_cache"] is True,
          "sampled forward must use its row-owned cache")
    snapshot = []
    for name in ("input_ids", "attention_mask", "position_ids"):
        if name == "input_ids" and logical_text_ids is not None:
            snapshot.append(logical_text_ids)
            continue
        rows = arguments[name].detach().cpu().tolist()
        _need(type(rows) is list and len(rows) == 1 and type(rows[0]) is list
              and all(type(token) is int for token in rows[0]),
              "single native integer input, attention and position rows required")
        snapshot.append(tuple(rows[0]))
    return (tuple(sorted(arguments)), arguments["logits_to_keep"], *snapshot)


class CachedQwenRollout:
    """Collect replay data at the existing worker's guarded native forward."""

    def __init__(self, policy, owned, framed_sources, *, max_output_tokens, tokenizer_contract, model_width):
        _need(type(policy) is CachedQwenRolloutPolicy
              and all(_pin(value) for value in (policy.attempt_sha256, policy.behavior_policy_sha256,
                                                 policy.tokenizer_sha256, policy.forward_profile_sha256))
              and type(policy.rows) is tuple and len(policy.rows) == len(owned)
              and type(policy.maximum_support_columns) is int and 1 <= policy.maximum_support_columns <= 4096
              and type(policy.maximum_evidence_bytes) is int and 1 <= policy.maximum_evidence_bytes <= 16 * 1024 * 1024
              and callable(policy.select_support) and callable(policy.draw_uniform_integer),
              "closed bounded sampled rollout policy required")
        _need(all(type(item) is CachedQwenRolloutRow and type(item.trajectory_id) is str
                and 1 <= len(item.trajectory_id) <= 512
                and all(_pin(value) for value in (item.source_wire_sha256, item.source_and_context_sha256,
                                                   item.framed_prompt_sha256, item.rng_stream_sha256))
                for item in policy.rows), "exact sampled rollout row bindings required")
        _need(len({item.trajectory_id for item in policy.rows}) == len(owned)
              and len({item.rng_stream_sha256 for item in policy.rows}) == len(owned),
              "unique rollout trajectory and RNG streams required")
        for item, row in zip(policy.rows, owned, strict=True):
            _need(type(item.row_id) is str and item.row_id == row["id"]
                  and item.source_wire_sha256 == sha256(row["source_wire"].encode("utf-8")).hexdigest()
                  and item.framed_prompt_sha256 == _digest(framed_sources[row["id"]]),
                  "sampled rollout row, exact source wire or framed prompt differs")
        self.policy = policy
        self.rows = {item.row_id: item for item in policy.rows}
        self.vocab, self.bos, self.eos = (tokenizer_contract[name] for name in ("vocab_size", "bos_token_id", "eos_token_id"))
        self.model_width = model_width
        self.max_output_tokens = max_output_tokens
        self.row_results = []
        self.closed_roster = []
        self.used_bytes = 0
        self._charge({"profile": OWNER_ROLLOUT_PROFILE, "attempt_sha256": policy.attempt_sha256,
                      "rows": (), "cached_rollout_closes": (), "cached_rollout_closes_sha256": _digest(())})

    def _charge(self, value):
        size = len(json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"),
                              allow_nan=False).encode("ascii"))
        self.used_bytes += size + 16
        _need(self.used_bytes <= self.policy.maximum_evidence_bytes, "sampled rollout exceeds retained evidence budget")

    def begin_row(self, row_id, prompt, cache, *, teacher_condition=None, read_prefill_slot=None):
        item = self.rows[row_id]
        _need((teacher_condition is None and read_prefill_slot is None)
              or _pin(teacher_condition) and callable(read_prefill_slot),
              "teacher cache needs an authenticated staged condition and live prefill observer")
        return _CachedQwenRolloutTape(self, item, tuple(prompt), cache, teacher_condition, read_prefill_slot)

    def retain_row(self, tape, result):
        self._charge({"rollout_outcome": result["outcome"], "reason": result["reason"],
                      "generated_token_ids": result["generated_token_ids"]})
        _need(tuple(result["generated_token_ids"]) == (self.bos, *tape.output_tokens),
              "sampled actions differ from the native generation exit")
        close = None
        if result["outcome"] == "complete":
            _need(result["reason"] is None and len(tape.samples) >= 2 and tape.output_tokens[-1] == self.eos,
                  "completed sampled rollout requires an observed nonempty codec terminal")
            close = {
                "profile": OWNER_ROLLOUT_PROFILE,
                "attempt_sha256": self.policy.attempt_sha256,
                "row_id": tape.row.row_id,
                "trajectory_id": tape.row.trajectory_id,
                "cache_session_sha256": tape.session,
                "last_cache_revision_sha256": tape.revision,
                "ordered_sample_digests_sha256": _digest(tape.sample_digests),
                "generated_token_ids_sha256": _digest(result["generated_token_ids"]),
                "candidate_sha256": _digest(result["candidate"]),
                "closure": "nonempty-observed-eos-and-structural-codec",
            }
            self._charge(close)
            self.closed_roster.append((tape.row.trajectory_id, tape.session,
                                       close["ordered_sample_digests_sha256"], _digest(close)))
        self.row_results.append({"row_id": tape.row.row_id, "outcome": result["outcome"], "reason": result["reason"],
                                 "samples": tuple(tape.samples), "close": close})

    def finish(self):
        """Called by the worker only after generation and state restoration succeed."""
        _need(tuple(item["row_id"] for item in self.row_results) == tuple(self.rows),
              "sampled rollout result roster differs")
        evidence = {"profile": OWNER_ROLLOUT_PROFILE, "attempt_sha256": self.policy.attempt_sha256,
                    "rows": tuple(self.row_results), "cached_rollout_closes": tuple(self.closed_roster),
                    "cached_rollout_closes_sha256": _digest(self.closed_roster)}
        # Count serialized wrapper and repeated close metadata as well as live rows.
        _need(len(json.dumps(evidence, ensure_ascii=True, sort_keys=True, separators=(",", ":"),
                             allow_nan=False).encode("ascii")) <= self.policy.maximum_evidence_bytes,
              "sampled rollout exceeds retained evidence budget")
        return evidence


class _CachedQwenRolloutTape:
    def __init__(self, rollout, row, prompt, cache, teacher_condition=None, read_prefill_slot=None):
        self.rollout = rollout
        self.row = row
        self.prompt = prompt
        self.cache = cache
        self.teacher_condition = teacher_condition
        self.read_prefill_slot = read_prefill_slot
        self.prefill_state = None
        parts = (OWNER_ROLLOUT_PROFILE, rollout.policy.attempt_sha256, row.trajectory_id)
        if teacher_condition is not None:
            parts = (*parts, QWEN_TEACHER_CACHE, teacher_condition)
        self.session = _digest(parts)
        self.revision = _digest((self.session, "empty"))
        self.samples = []
        self.sample_digests = []
        self.output_tokens = []
        self.draws = 0

    def before_forward(self, arguments, *, observed_lookup_ids=None):
        if self.teacher_condition is None or self.output_tokens:
            _need(observed_lookup_ids is None, "unexpected teacher embedding lookup")
            return _live_cache_call(arguments, self.cache)
        _need("input_ids" not in arguments and "inputs_embeds" in arguments,
              "teacher cache prefill requires actual native inputs_embeds")
        embeddings = arguments["inputs_embeds"]
        self.read_prefill_slot(embeddings)
        identity = (id(embeddings), tuple(embeddings.shape), embeddings._version)
        if self.prefill_state is None:
            _need(type(observed_lookup_ids) is tuple and observed_lookup_ids == self.prompt,
                  "teacher cache prefill lookup differs from the selected logical prompt")
            self.prefill_state = (identity, observed_lookup_ids)
        else:
            _need(observed_lookup_ids is None and identity == self.prefill_state[0],
                  "teacher cached prefill embeddings changed in native custody")
        return _live_cache_call(arguments, self.cache, logical_text_ids=self.prefill_state[1])

    def sample_step(self, torch, output, logits, arguments, call, *, prior_tokens, output_tokens,
                    generated, forced_eos, current):
        rollout, row, policy = self.rollout, self.row, self.rollout.policy
        body = tuple(self.output_tokens)
        _need(tuple(generated) == (rollout.bos, *body)
              and len(body) < rollout.max_output_tokens - 1,
              "native sampled prefix or output budget differs")
        _need(getattr(output, "past_key_values", None) is self.cache and getattr(output, "logits", None) is logits
              and self.before_forward(arguments) == call,
              "returned cache, owned logit tensor or consumed arguments differed")
        keys, keep, ids, mask, positions = call
        dtype = str(logits.dtype)
        forward = _digest((OWNER_ROLLOUT_PROFILE, self.session, self.revision, tuple(self.sample_digests[-1:]),
                           call, prior_tokens, output_tokens, policy.behavior_policy_sha256,
                           dtype, rollout.model_width, forced_eos))
        next_revision = _digest((self.session, self.revision, forward, output_tokens))
        frame_fields = (row.source_and_context_sha256, policy.tokenizer_sha256, policy.forward_profile_sha256,
            forward, self.prompt, body, rollout.vocab, rollout.bos, rollout.eos, self.session, self.revision, next_revision)
        teacher = self.teacher_condition is not None
        frame = (TeacherCachedQwenFrame(*frame_fields, row.row_id, self.teacher_condition)
                 if teacher else CachedQwenBehaviorFrame(*frame_fields))
        meta_fields = (frame.digest(), policy.behavior_policy_sha256, forward, self.session,
            self.revision, next_revision, prior_tokens, output_tokens, ids, mask, positions, keep,
            QWEN_CONDITIONING_PROFILE, QWEN_TEACHER_CACHE if teacher else QWEN_NATIVE_CACHE, "qwen2", keys, True, True)
        meta = (TeacherCachedQwenObservation(*meta_fields, self.teacher_condition, not body)
                if teacher else CachedQwenObservation(*meta_fields))
        if forced_eos:
            actions, allowed, ordered_columns = (str(rollout.eos),), (True,), (rollout.eos,)
        else:
            # Only detached scalar data crosses to the existing support owner.
            offered = policy.select_support(row.row_id, body)
            _need(type(offered) is tuple and len(offered) == 3, "ordered sampled support triple required")
            actions, allowed, ordered_columns = offered
        _need(type(actions) is tuple and type(allowed) is tuple and type(ordered_columns) is tuple
              and len(actions) == len(allowed) == len(ordered_columns)
              and 1 <= len(actions) <= policy.maximum_support_columns
              and all(type(token) is int and action == str(token) for action, token in zip(actions, ordered_columns)),
              "bounded one-to-one native sampled token support required")
        support = policy.mask_owner.bind_support(policy.support_policy, actions, allowed)
        columns = ActionColumns(rollout.model_width, ordered_columns)
        event = None if sum(allowed) == 1 else DrawIdentity(row.rng_stream_sha256, self.draws)

        def draw(total):
            self.draws += 1
            return policy.draw_uniform_integer(row.trajectory_id, event, total)

        current()
        _need(getattr(output, "logits", None) is logits and getattr(output, "past_key_values", None) is self.cache
              and self.before_forward(arguments) == call,
              "sampled native head ownership or input arguments changed")
        observation_sha256 = meta.digest()
        receipt, values = sample_behavior_tensor(torch, CachedQwenBehaviorHead(logits, meta, observation_sha256),
            policy.mask_owner, frame=frame, expected_prefix_sha256=frame.digest(), columns=columns,
            expected_action_columns_sha256=columns.digest(support), support=support,
            expected_support_sha256=support.sha256, trajectory_id=row.trajectory_id,
            behavior_policy_sha256=policy.behavior_policy_sha256, behavior_logit_dtype=dtype,
            rng_event=event, draw_uniform_integer=draw, expected_cached_observation_sha256=observation_sha256)
        current()
        record = {"frame": asdict(frame), "observation": asdict(meta), "observation_sha256": observation_sha256,
                  "columns": asdict(columns), "support": asdict(support), "ordered_logits": values,
                  "sample": asdict(receipt), "sample_sha256": receipt.digest()}
        rollout._charge(record)
        self.samples.append(record)
        if teacher and not body:
            self.prefill_state = None
        self.sample_digests.append(receipt.digest())
        self.output_tokens.append(receipt.output_column)
        self.revision = next_revision
        return receipt.output_column
