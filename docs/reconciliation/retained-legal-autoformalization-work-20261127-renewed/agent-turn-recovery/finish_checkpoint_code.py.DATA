exec(compile(open('/tmp/legal-refusal-recovery-j_10md5l/install_checkpoint.py').read().split('originals = ')[0], '<load-source-control>', 'exec'))
originals = {p:p.read_bytes() for p in (owner,cli)}
tree = ast.parse(originals[owner]); node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='prepare_agent_turn_recovery_checkpoint_v1')
lines=originals[owner].decode().splitlines(keepends=True)
old=''.join(lines[node.lineno-1:node.end_lineno]); new=(BASE/'checkpoint_impl.py.DATA').read_text().rstrip('\n')
owner_raw=originals[owner].decode().replace(old,new).encode()
tree=ast.parse(originals[cli]); node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_write_agent_turn_checkpoint_v1')
lines=originals[cli].decode().splitlines(keepends=True)
old=''.join(lines[node.lineno-1:node.end_lineno]); new=(BASE/'cli_checkpoint_writer.py.DATA').read_text().rstrip('\n')
cli_raw=originals[cli].decode().replace(old,new).encode()
test=ROOT/'tests/unit/logic/test_supervisor_agent_turn_recovery.py'
originals[test]=test.read_bytes()
assert b'class AgentTurnObservationCheckpointTests' not in originals[test]
updates={owner:owner_raw,cli:cli_raw,test:originals[test]+(BASE/'checkpoint-tests.py.DATA').read_bytes()}
for p,raw in updates.items():ast.parse(raw,filename=str(p))
with module.source_lease(ROOT,mode='write',timeout_seconds=30) as lease:
 for p,raw in originals.items():assert p.read_bytes()==raw
 for p,raw in updates.items():p.write_bytes(raw)
 for p,raw in updates.items():assert p.read_bytes()==raw
 facts=lease.to_dict()
print(json.dumps({'Source_WRITE_closed':True,'lease':facts,'files':[{'path':str(p),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()} for p,raw in updates.items()]}))
