W = Path(__file__).parent
LIMIT = 8 * 1024**2
# Earlier scoping, assignment, exact sources, child schema/closeout reads and repeats.
SPENT = 226514
PRIVATE_IO_RESERVE = 1024**2
READS = []
START = time.monotonic()
resource.setrlimit(resource.RLIMIT_AS, (512*1024**2,512*1024**2))
resource.setrlimit(resource.RLIMIT_CPU, (60,60))
os.sched_setaffinity(0,{min(os.sched_getaffinity(0))})
signal.alarm(60)
REAL_READ = os.read

def observed_read(fd,size):
    global SPENT
    b=REAL_READ(fd,size)
    SPENT+=len(b)
    if SPENT+PRIVATE_IO_RESERVE>LIMIT:
        raise RuntimeError('private_input_byte_limit')
    return b

def read(p,sha=None):
    fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
    K=('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
    try:
        a=os.fstat(fd);parts=[]
        while True:
            b=observed_read(fd,65536)
            if not b:break
            parts.append(b)
        z=os.fstat(fd);raw=b''.join(parts)
        assert tuple(getattr(a,k) for k in K)==tuple(getattr(z,k) for k in K)==tuple(getattr(os.stat(p,follow_symlinks=False),k) for k in K)
    finally:os.close(fd)
    if sha:assert hashlib.sha256(raw).hexdigest()==sha
    READS.append(dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()))
    return raw

def save(name,raw):
    if not isinstance(raw,bytes):raw=(json.dumps(raw,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    p=W/name;fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o400)
    try:
        v=memoryview(raw)
        while v:n=os.write(fd,v);v=v[n:]
        os.fsync(fd)
    finally:os.close(fd)
    assert read(p)==raw
    return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

BEFORE=read(W/'caller.before.py.DATA','cf78dacd03150efba5cd7e2d6d4eeb7c61d58e850a47319d98298fac34c3dd81')
TEST=read(W/'test_existing_invoke_once_hydration.py')

def cohort(raw,label):
    module=types.ModuleType('_private_same_invoke_once_tests_'+label)
    module.__file__=str(W/'test_existing_invoke_once_hydration.py')
    exec(compile(TEST,module.__file__,'exec'),module.__dict__)
    module.CALLER_RAW=raw;module.WORKDIR=str(W)
    suite=unittest.defaultTestLoader.loadTestsFromTestCase(module.ExistingCallerHydrationTests)
    transcript=io.StringIO()
    os.read=observed_read
    try:result=unittest.TextTestRunner(stream=transcript,verbosity=2).run(suite)
    finally:os.read=REAL_READ
    return dict(label=label,parents=result.testsRun,failures=[dict(test=str(t),traceback=s) for t,s in result.failures],
        errors=[dict(test=str(t),traceback=s) for t,s in result.errors],skipped=[str(x) for x in result.skipped],
        transcript=transcript.getvalue(),root_cause=module.ROOT_CAUSE,
        actual_function='same invoke_once and exact pinned existing function exports',
        boundary='only _open_codex_app_connection replaced by explicit fictional transport; real metadata parser/artifact writer/reader/sender validators retained',
        real_RPC=0,Source=0,Git=0,SQL=0,SDK=0,Native=0,model=0)

