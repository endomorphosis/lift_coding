            def same_terminal(latest):
                return (type(latest) is dict and latest.get('id')==turn['id']
                    and latest.get('status')==turn['status']
                    and latest.get('status') in {'completed','failed','interrupted'})
            def status_type(current):
                status=current.get('status') if type(current) is dict else None
                return status.get('type') if type(status) is dict else status
            current,latest=observe_latest()
            if needs_resume:
                if (type(current) is not dict or current.get('id')!=THREAD_ID
                        or status_type(current)!='notLoaded'
                        or not (current.get('canAcceptDirectInput') is None
                                or current.get('canAcceptDirectInput') is False)
                        or not same_terminal(latest)):
                    return finish(no_authority('refused','unloaded_state_changed_no_dispatch',
                        method='thread/resume',rpc_response_ids=response_ids))
                reservation=reserve('thread/resume+turn/start',{'id':latest['id'],'status':latest['status']})
                mutation_started=True;mutation_method='thread/resume'
                hydrated=rpc('thread/resume',{'threadId':THREAD_ID,'excludeTurns':True})
                resumed=hydrated.get('thread') if type(hydrated) is dict else None
                if (type(resumed) is not dict or resumed.get('id')!=THREAD_ID
                        or resumed.get('canAcceptDirectInput') is not True
                        or status_type(resumed)!='idle'):
                    raise ValueError('same_thread_resume_ack_invalid')
                resume_acknowledged=True
                # Hydration is not an enqueue or a current-turn guarantee.
                current,latest=observe_latest()
                if (type(current) is not dict or current.get('id')!=THREAD_ID
                        or current.get('canAcceptDirectInput') is not True
                        or status_type(current)!='idle' or not same_terminal(latest)):
                    return finish(no_authority('refused','hydrated_state_changed_no_dispatch',
                        method='turn/start',rpc_response_ids=response_ids,
                        metadata_resume_acknowledged=True,UNKNOWN_reservation=reservation,
