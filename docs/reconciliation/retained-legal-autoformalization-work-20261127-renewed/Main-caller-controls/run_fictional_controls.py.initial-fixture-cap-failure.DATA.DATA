assert red['root_cause'][0]['reason']=='current_thread_state_unverified'
assert red['root_cause'][0]['read_snapshot']['status']=='notLoaded'
assert red['root_cause'][0]['read_snapshot']['can_accept_direct_input'] is None
assert 'thread/resume' not in red['root_cause'][0]['methods'] and 'turn/start' not in red['root_cause'][0]['methods']
assert red['failures'] or red['errors']
print(json.dumps(dict(RED=RED,parents=red['parents'],failures=len(red['failures']),errors=len(red['errors']),root_cause=red['root_cause'])),flush=True)

