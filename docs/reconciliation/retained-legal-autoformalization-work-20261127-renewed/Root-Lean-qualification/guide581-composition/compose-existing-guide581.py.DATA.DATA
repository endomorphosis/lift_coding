"""Compose Guide 581 against the published Lean diagnostic change."""
from collections import Counter
from hashlib import sha256
import json
from pathlib import Path
from runpy import run_path
import sys
from xml.etree import ElementTree as ET

HERE = Path(__file__).resolve().parent
WORK = HERE.parent
D = WORK.parent/'datasets'
A = Path('/tmp/Root-V4-CLI-live-main-reconcile-EsXXzUG0/accelerate')
PREVIOUS = WORK.parent/'cache-atomic-put'
ANCESTOR = Path('/tmp/P2-live-V4-CLI-evidence-composer-INERT-aMJ0GRii/compose-live-v4-cli-evidence.v02.py.DATA')
assert __debug__ and len(sys.argv)==4
assert sha256(ANCESTOR.read_bytes()).hexdigest()=='a41cc18ff1e4f4c14eb0848eeba83641aa94e1a7b941bfd4bcb5b33729d32a4b'
prior = run_path(str(ANCESTOR))
put, load, read, ref, digest, blob, link, git, observed_file, insertion_for, offset_for = (
    prior[key] for key in ('put','load','read','ref','digest','blob','link','git','observed_file','insertion_for','collection_insertion_offset'))
put.__globals__['HERE']=HERE
pub_path=WORK/'actual-Phase1-lean-json-diagnostics-ordinary99-and-native-three-FF-publication.json'
assert Path(sys.argv[1])==pub_path and sys.argv[2].isdecimal() and 0<int(sys.argv[2])<=65536
CODE=ref(pub_path,int(sys.argv[2]),sys.argv[3])
pub=load(CODE,'actual_published_Lean_diagnostics')
assert pub['schema']=='actual-current-Phase1-lean-json-diagnostics-ordinary99-and-native-live-publication/v1'
assert pub['terminal_returncode']==0 and pub['terminal_success'] and pub['shared_worktrees_preserved']
before,after=pub['live_main_before'],pub['live_main_after']
assert [step['repo'] for step in pub['pushes_in_actual_order']]==['datasets','hallucinate','root']
assert all(step['normal_fast_forward'] and (step['prior'],step['published'])==(before[step['repo']],after[step['repo']])
           for step in pub['pushes_in_actual_order'])
qualified_a=pub['qualification_A']
live_a=after['accelerate']
assert qualified_a=='219ba3da0f62f772801d71715e22c506faa21126'
assert before['accelerate']==live_a=='e55316f48847b17a8b4041a2da30bcaa0ba6eb90'
assert pub['current_gitlinks']['hallucinate']['ipfs_accelerate_py']==pub['current_gitlinks']['root']['external/ipfs_accelerate']==live_a
GUIDE580=ref(PREVIOUS/'actual-Guide580-four-docs-three-FF-publication.json',2991,'12de3885bbfd86bc00dd792861c9f670af1bee590b0b8a996a9eae97cbbda9fc')
READY580=ref(PREVIOUS/'guide580-composition/READY-one-existing-guide580-four-guides.json',19238,'fde425b8eac93b7ce10317f9602339c799aefd5cfedef97348b41dd5ab7597d5')
OBS=ref(WORK/'actual-current-main-fast-forward-official-V2-base.json',5270,'23a507a1f439e697be16860808c32ba21af50ac094a44d8d108a6e1e35dc829f')
assert pub['previous_published_guide']==GUIDE580 and pub['external_base_observation']==OBS
guide=load(GUIDE580,'published_Guide580')
install=load(guide['actual_doc_Source_closed'],'closed_Guide580_document_installation')
old=load(READY580,'exact_prior_document_posts')
old_joint=load(old['joint_facts'],'prior_joint_facts')
obs=load(OBS,'observed_official_V2_base')
assert guide['terminal_returncode']==install['terminal_returncode']==0 and guide['evidence_ordinal']==old['evidence_ordinal']==580
assert install['Source_closed'] and install['module_closed'] and install['composer_READY']==READY580
assert obs['previous_published_guide']==GUIDE580 and obs['guide_main']==guide['live_main_after']
assert obs['observed_base_is_dataset_descendant'] and obs['previous_author_qualification_claimed'] is False
assert obs['live_main_after']['datasets']==before['datasets'] and obs['live_main_after']['accelerate']==qualified_a
guide_d=guide['live_main_after']['datasets']
git(D,'merge-base','--is-ancestor',guide_d,before['datasets'])

FREEZE,READ3,EPOCH,Q,NATIVE=(pub[k] for k in ('exact_local_freeze','READ3','current_frozen_Source_epoch','qualification','native_qualification'))
def bind(r,n,h):
    assert r['bytes']==n and r['sha256']==h
bind(FREEZE,16495,'a52014d373c00aade6e9673cb3dab91deefbfe7c23d456b4b483ce5964532e8a')
bind(READ3,7482,'0b9d17c27efa541b520be7d9e3578b71df4ef584d92152ccfeb2e965e527ccb5')
bind(EPOCH,9553,'1d609bd6f829ddac94791852f283e82ab5ec70a502aeae9c4ba44207f77949ed')
bind(Q,25346,'ba0317da64826b8d5f81839ec911a2ac9bc16fc2188d6773da467ed489e637d2')
bind(NATIVE,1026,'abbf8d4ced879afceeccba6598e56f1fd72c9b915199842cbd1e347d32dd220c')
freeze=load(FREEZE,'exact_two_freeze')
source=load(READ3,'actual_READ3')
epoch=load(EPOCH,'actual_closed_epoch')
q=load(Q,'actual_ordinary99')
native=load(NATIVE,'actual_namespaced_native2')
assert freeze['isolated_Source_context_closed'] and freeze['only_two_D_tree_entries_changed'] and freeze['local_clean']
assert freeze['observed_base']==epoch['observed_base']==OBS and freeze['parent']==epoch['prior_published_D']==before['datasets']
assert source['exact_local_freeze']==epoch['exact_local_freeze']==q['isolated_freeze']==FREEZE
assert source['actual_isolated_content_epoch']==EPOCH
assert source['outer_epoch_reference']==epoch['outer_epoch_reference']
assert source['Source_closed'] and epoch['Source_closed'] and source['module_closed'] and epoch['module_closed']
assert source['protected_index_reference']==pub['D_index']==freeze['frozen']['index']
assert source['actual_accelerate_index_metadata']==pub['A_index']==epoch['actual_A_index']
owner='ipfs_datasets_py/logic/backends/kernel/lean.py'
test='tests/integration/logic/backends/test_kernel_backends.py'
assert set(freeze['committed'])=={owner,test} and pub['exact_two_changes']==freeze['committed']
head,tree=(freeze['frozen'][k] for k in ('HEAD','tree'))
assert head==after['datasets']=='95dc193c3a4a37f9c9227da640a346b2cd58e54c'
assert git(D,'rev-parse','HEAD^','HEAD','HEAD^{tree}').decode().split()==[before['datasets'],head,tree]
assert git(A,'rev-parse','HEAD','HEAD^{tree}').decode().split()==[qualified_a,source['projects'][1]['Git_tree']]
assert source['projects'][1]['Git_HEAD']==qualified_a
assert all(not git(repo,'status','--porcelain=v1','-z','-uall') for repo in (D,A))

counts=dict(tests=99,passed=99,functions=24,failures=0,errors=0,skipped=0)
assert q['terminal_returncode']==0 and q['counts']==counts and q['Source_and_resource_and_parent_closed']
assert q['Source_READ3']==source['ordinary_read_binding_abi']
ordinary=load(q['actual_report'],'ordinary99_raw_operator_report')
assert not ordinary['errors'] and all(ordinary[k] is True for k in ('qualification_complete','Source_closed',
    'resource_cleanup_confirmed','actual_parent_release_return'))
assert ordinary['statutory_or_modelquality_or_convergence_authority'] is False
assert ordinary['git_candidate_provenance']['actual_closed_Source_READ']==READ3
assert ordinary['source_epoch_sha256']==epoch['outer_epoch_reference']['sha256']
phases={p['operation']:p for p in ordinary['phases'].values()}
assert set(phases)=={'collect','run'} and all(p['accepted'] and not p['error'] for p in phases.values())
collect,run=(phases[k]['actual_binding'] for k in ('collect','run'))
ids=q['ordered_cases']
assert ids==collect['actual_collected_roster']==run['actual_called_roster']
assert len(ids)==len(set(ids))==99 and len(Counter(node.split('[',1)[0] for node in ids))==24
suite,=ET.fromstring(read(q['actual_raw_JUnit'],'ordinary99_raw_JUnit')).findall('testsuite')
assert all(int(suite.attrib[k])==counts[k] for k in ('tests','errors','failures','skipped'))
cases=suite.findall('testcase')
assert [row.attrib['name'] for row in cases]==[node.rsplit('::',1)[1] for node in ids]
assert [row.attrib['classname'] for row in cases]==[node.rsplit('::',1)[0].removesuffix('.py').replace('/','.') for node in ids]
assert not any(row.find(tag) is not None for row in cases for tag in ('failure','error','skipped'))
assert run['actual_compiled_current_Source'][str(D/owner)]==freeze['committed'][owner]['sha256']
for phase in (collect,run):
    rewrite=phase['actual_test_rewrite_source_to_code'][str(D/test)]
    assert all(rewrite[k] for k in ('source_to_AST_observed','AST_to_code_observed','code_execution_observed'))
    assert rewrite['source_sha256']==rewrite['compile_source_sha256']==freeze['committed'][test]['sha256']

full=load(native['report'],'actual_Native2_full_report')
binding=load(native['binding'],'actual_Native2_binding')
selection=load(binding['Native_enrollment']['Root_selection'],'actual_Native2_selection')
assert native['cleanup_verified'] and native['native_cases']==2 and native['compiler_rc']==[0,1]
assert native['version_rc']==native['pytest_case_credit']==0 and native['full_Phase1_complete'] is False
native_counts=dict(all=3,compiler=2,unclassified=0,version=1)
assert full['actual_command_counts']==native_counts and full['pytest_case_credit']==0 and not full['errors']
assert all(full[k] for k in ('actual_native_qualification','Source_closed','actual_parent_release_return',
    'resource_cleanup_confirmed','parent_home_cleanup_confirmed'))
assert full['statutory_or_model_or_corpus_admission'] is False
assert full['test_source_sha256']==freeze['committed'][test]['sha256']
assert binding['Source_epoch']==source['outer_epoch_reference'] and binding['PROJECTS']==source['projects']
assert (selection['ordinary99'],selection['exact_local_freeze'],selection['exact_current_index_and_targets_READ3'])==(Q,FREEZE,READ3)
assert [(r['declaration'],r['compiler_returncode'],r['accepted']) for r in full['actual_namespaced_cases']]==[('wanted',0,True),('Law.wanted',1,False)]
test_report=load(full['original_test_report'],'actual_namespaced_test_report')
assert test_report['native_Lean_executed'] and test_report['toolchain_version']=='4.34.1'
assert test_report['statutory_or_source_semantic_admission'] is False
cap_ref=native['full_retained_Source_cap']
bind(cap_ref,1749,'f86281355aee837b7da1ebdfc57f0e5418a84faeaf81b97d8cbc6304a3f60de4')
cap=load(cap_ref,'retained_Native2_charge')
assert cap['all_prior_costs_retained'] and cap['resource_policy_capacity_unchanged']
prior_ord=load(cap['previous_charge'],'retained_ordinary_v04_charge')
failed_ref=prior_ord['retained_prior_closed_ordinary_refusal']
failed=load(failed_ref,'retained_ordinary_v03_collection_refusal')
assert failed['Source_and_parent_and_resource_closed'] and failed['collect_exited_nonzero']
assert failed['terminal_returncode']==1 and failed['actual_RUN_entered'] is failed['qualification_complete'] is False

materialized={rel for rel,row in obs['exact_D_delta'].items() if row['materialized']}
assert len(materialized)==11 and len(obs['exact_D_delta'])==13
outer=load(epoch['outer_epoch_reference'],'actual_1618_role_epoch')
rows={row['path']:row for row in outer}
assert len(outer)==len(rows)==1618 and epoch['python_epoch_record_count']==1605
drift=epoch['changed_current_live_role_comparison']
for rel in materialized:
    row=drift[rel]
    assert row['git_blob']==git(D,'rev-parse','HEAD:'+rel).decode().strip()==git(D,'rev-parse','HEAD^:'+rel).decode().strip()
    assert row['to_sha256']==rows[str(D/rel)]['sha256']
candidate=load(freeze['candidate'],'private_same_99_regression')
assert candidate['baseline_HEAD']==guide_d
assert candidate['actual_RED']['counts']==dict(counts,passed=93,failures=6)
assert candidate['actual_GREEN']['counts']==counts

names={'BACKLOG.json','work_catalog.json','HANDOFF.md','TRAINING_HISTORY.md'}
task='LIR-14'
component='kernel-proof-evidence-integrity'
migration='phase1_lean_json_diagnostic_handling_20261127'
record='phase1-lean-json-diagnostics-ordinary99-namespaced-native2-evidence581-20261127'
assert len(old['files'])==4 and {row['file_name'] for row in old['files']}==names
assert set(guide['only_four_docs'])==set(install['committed_docs'])=={row['relative_path'] for row in old['files']}
parents=[]
for row in old['files']:
    name,rel=row['file_name'],row['relative_path']
    assert rel==str(prior['DOC_DIRECTORY']/name)
    body,f9=observed_file(D/rel)
    meta=rows[str(D/rel)]
    assert (len(body),digest(body),f9)==(meta['bytes'],meta['sha256'],meta['full9'])
    assert all(git(D,'rev-parse',rev+':'+rel).decode().strip()==blob(body) for rev in ('HEAD','HEAD^'))
    older=read(row['post_private'],'prior_Guide580_post_'+name)
    saved=install['committed_docs'][rel]
    assert (len(older),digest(older),blob(older))==(saved['bytes'],saved['sha256'],saved['committed_blob'])
    assert git(D,'rev-parse',guide_d+':'+rel).decode().strip()==saved['committed_blob']
    if name=='HANDOFF.md':
        assert rel in materialized and body.startswith(older) and len(body)>len(older)
        assert drift[rel]['git_blob']==blob(body) and drift[rel]['to_sha256']==digest(body)
    else:
        assert body==older
    if name=='BACKLOG.json':
        state=json.loads(body)
        assert len(state['tasks'])==24 and state['migration'][old_joint['migration_key']]==old_joint['backlog_record']
        assert migration not in state['migration']
        assert next(row for row in state['tasks'] if row['id']==task)['title']=='Run source-bound corpus builds and obligations'
        offset=offset_for(body,'migration',state['migration'])
    elif name=='work_catalog.json':
        state=json.loads(body)
        assert len(state['components'])==126 and len(state['selected_evidence'])==580
        assert state['selected_evidence'][-1]==old_joint['catalog_record']
        assert all(row.get('id')!=record and row.get('evidence_ordinal')!=581 for row in state['selected_evidence'])
        assert next(row for row in state['components'] if row['id']==component)['path']==owner
        offset=offset_for(body,'selected_evidence',state['selected_evidence'])
    else:
        assert body.count(b'## Evidence580')==1 and b'## Evidence581' not in body
        offset=len(body)
    parents.append((body,dict(file_name=name,relative_path=rel,insertion_offset=offset),f9))

facts=dict(schema='live-reconciled-Phase1-Lean-diagnostic-handling-engineering-evidence/v1',
    evidence_ordinal=581,task=task,related_catalog_component=component,
    prior_verified_guide580_publication=GUIDE580,current_official_V2_base_observation=OBS,
    actual_live_code_publication=CODE,actual_live_ordinary99=Q,ordinary_raw_JUnit=q['actual_raw_JUnit'],
    ordinary_qualification_counts=counts,ordinary_collect_run_raw_JUnit_order_equal=True,
    ordinary_Source_resource_and_parent_closed=True,retained_ordinary_v03_collection_refusal=failed_ref,
    actual_live_native_namespaced2=NATIVE,actual_native_report=native['report'],
    original_native_test_report=full['original_test_report'],actual_native_command_counts=native_counts,
    native_fictional_fixture_only=True,Lean_version='4.34.1',native_compiler_exit_codes=[0,1],
    native_root_wanted_accepted=True,native_Law_wanted_wrong_type_rejected=True,native_pytest_case_credit=0,
    native_Source_resource_and_parent_closed=True,actual_latest_closed_native_Source_cap=cap_ref,
    private_same_99_reproduction_and_fix=freeze['candidate'],private_baseline_tests_passed=93,private_fixed_tests_passed=99,
    recursion_exhausted_json_becomes_invalid_diagnostic=True,non_text_dependency_report_severity_is_rejected=True,
    actual_live_exact_two_freeze=FREEZE,actual_live_reconciled_Source42_READ3=READ3,actual_live_reconciled_Source42_epoch=EPOCH,
    qualified_D_HEAD=head,qualified_physical_A_HEAD=qualified_a,live_A_main_HEAD=live_a,current_external_base_materialized_roles=11,
    qualified_commit_blobs={rel:row['stage0_and_committed_blob'] for rel,row in freeze['committed'].items()},
    physical_IO_accounting_complete=False,task_status_changed=False,full_Phase1_complete=False,
    actual_signed_statutory_review_or_corpus_admission_or_model_qualification=False)
facts_ref=put('current-Phase1-Lean-diagnostic-handling-scoped-facts.json',facts)
backlog=dict(record_id=record,evidence_ordinal=581,task=task,related_tasks=[],related_catalog_component=component,
    facts=facts_ref,status='closed_controlled_engineering_evidence_only_no_task_status_change',
    actual_live_ordinary99=Q,actual_live_native_namespaced2=NATIVE,
    actual_signed_statutory_review_or_corpus_admission_or_model_qualification=False)
catalog=dict(id=record,evidence_ordinal=581,path=facts_ref['path'],root='artifact_workspace',
    observed_bytes=facts_ref['bytes'],observed_sha256=facts_ref['sha256'],status='CLOSED_CONTROLLED_ENGINEERING_EVIDENCE_ONLY',
    required_for_catalog_check=False,backlog_crosslink='BACKLOG.json#/migration/'+migration,
    scope='Lean JSON diagnostics and a separate Native namespaced declaration check on fictional Lean source.',
    closed_runtime_facts=facts)
joint=dict(backlog_container='migration',backlog_record=backlog,catalog_record=catalog,evidence_ordinal=581,
    migration_key=migration,record_id=record)
assert set(joint)==prior['JOINT_KEYS']
joint_ref=put('guide581-existing-actuator-six-key-joint-facts.json',joint)
markdown=(
    '\n\n## Evidence581 — Reject malformed Lean JSON diagnostics\n\n'
    'The Lean adapter reports excessively nested compiler JSON as invalid. A dependency report with a list or '
    'object in the severity field now yields a structured rejection. All 99 ordinary cases passed across 24 test '
    'functions. An earlier collection attempt stopped during setup, reached no tests, and released its resources. '
    'In a separate check on fictional Lean source, Lean 4.34.1 ran one version probe and two compilations. '
    'It accepted the expected root declaration `wanted` and rejected the wrong expected type for `Law.wanted`. '
    'Signed statutory review remains pending. '
    + link('Ordinary qualification',Q) + ' · ' + link('Native qualification',NATIVE)
    + ' · ' + link('Code publication',CODE) + '\n').encode()
md_ref=put('guide581-shared-Markdown-append.DATA',markdown)

insert=insertion_for(581)
files,proofs,forward,inverse=[],[],[],[]
for body,plan,f9 in parents:
    name,rel=plan['file_name'],plan['relative_path']
    change=insert(body,plan,joint,markdown)
    fragment=put(f'{name}.guide581.only-insertion.DATA',change['fragment'])
    files.append(dict(file_name=name,relative_path=rel,before_private=put(f'{name}.captured-current-parent.DATA',body),
        before_Git_blob_oid=blob(body),before_full9=f9,
        before_metadata_lineage=dict(ordinal_ancestry=GUIDE580,official_V2_base_observation=OBS,
            Source42_current_documentary_epoch=EPOCH,current_documentary_HEAD=head,actual_live_code_publication=CODE),
        post_private=put(f'{name}.guide581.after.DATA',change['post']),
        forward_patch=put(f'{name}.guide581.forward.patch',change['forward']),
        inverse_patch=put(f'{name}.guide581.inverse.patch',change['inverse']),
        surgical_insertion=change['surgical_insertion'] | dict(fragment_reference=fragment,inverse_removal_recovers_entire_old_file=True)))
    proofs.append(dict(relative_path=rel,before_SHA256=digest(body),after_SHA256=digest(change['post']),
        after_Git_blob=blob(change['post']),insertion_offset=plan['insertion_offset'],inserted_bytes=fragment['bytes'],
        forward_hunks=1,inverse_hunks=1,all_previous_structured_values_or_Markdown_prefix_exact=True))
    forward.append(change['forward'])
    inverse.append(change['inverse'])
preservation=put('guide581-four-guides-preservation-and-inverse-proof.json',dict(tasks=24,components=126,
    previous_catalog_records=580,new_catalog_records=1,prior_structured_values_exact=True,
    both_Markdown_prefixes_exact=True,external_V2_HANDOFF_append_preserved=True,records=proofs))
base=dict(schema='one-existing-guide581-four-private-posts/v1',evidence_ordinal=581,migration_key=migration,record_id=record,
    prior_author_READY=READY580,prior_verified_guide580_publication=GUIDE580,current_external_base_observation=OBS,
    actual_live_code_publication=CODE,actual_live_ordinary99=Q,actual_live_native_namespaced2=NATIVE,
    actual_live_reconciled_Source42_epoch=EPOCH,actual_live_reconciled_Source42_READ3=READ3,
    ordinary_raw_JUnit=q['actual_raw_JUnit'],original_native_test_report=full['original_test_report'],exact_candidate=freeze['candidate'],
    facts=facts_ref,joint_facts=joint_ref,shared_Markdown_append=md_ref,files=files,preservation_proof=preservation,
    forward_patch=put('guide581-four-insertions.forward.patch',b''.join(forward)),
    inverse_patch=put('guide581-four-insertions.inverse.patch',b''.join(inverse)),
    expected_current_D_HEAD=head,expected_current_D_tree=tree,expected_current_A_HEAD=qualified_a,live_A_main_HEAD=live_a,
    expected_current_A_tree=source['projects'][1]['Git_tree'],total_four_post_bytes=sum(row['post_private']['bytes'] for row in files),
    total_inserted_bytes=sum(row['surgical_insertion']['inserted_bytes'] for row in files),
    all24_tasks126_components580_old_records_and_all_other_JSON_values_preserved=True,
    entire_Markdown_prefixes_and_EOF_preserved=True,exact_six_key_joint_facts_shape_preserved=True,
    exact_all4_inverse_removal_complete=True,exact_all4_forward_and_inverse_unified_application_complete=True,
    exactly_one581_record_and_migration_key_added=True,all4_post_and_fragment_full_readbacks_complete=True,
    canonical_adoption_or_publication_performed=False,Root_Source_clock_selection_ledger_IO_output_effect_authority=None,
    full_eight_phase_goal_complete=False)
descriptor=put('descriptor-one-existing-guide581-four-private-posts.json',base)
print(put('READY-one-existing-guide581-four-guides.json',base | dict(descriptor=descriptor)))
