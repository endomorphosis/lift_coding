assert __debug__ and len(sys.argv)==8 and sys.argv[7] in ("--verify-only","--bind-only")
out=Path(__file__).resolve().parent
controls=Path(sys.argv[4])
prior=Path("/tmp/Root-Phase6-effective-date-ordinary44-selected-v335-wrle9136/Root-selected-existing-effective-date-ordinary44-operator.py")

H=lambda b:hashlib.sha256(b).hexdigest()
f9=lambda s:tuple(getattr(s,k) for k in ("st_dev","st_ino","st_mode","st_nlink","st_uid","st_gid","st_size","st_mtime_ns","st_ctime_ns"))

def read(ref):
 p=Path(ref["path"]); s=p.lstat()
 assert stat.S_ISREG(s.st_mode) and s.st_nlink==1
 raw=p.read_bytes()
 assert f9(s)==f9(p.lstat()) and len(raw)==ref["bytes"] and H(raw)==ref["sha256"]
 return raw

def identify(p):
 raw=p.read_bytes()
 return dict(path=str(p),bytes=len(raw),sha256=H(raw))

def seal(name,value):
 p=out/name
 b=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2)+"\n").encode()
 with p.open("xb") as stream: stream.write(b);stream.flush();os.fsync(stream.fileno())
 p.chmod(0o400)
 return dict(path=str(p),bytes=len(b),sha256=H(b))

def literal_assignments(raw):
 vals={}
 for item in ast.parse(raw).body:
  if isinstance(item,ast.Assign) and len(item.targets)==1 and isinstance(item.targets[0],ast.Name):
   name=item.targets[0].id
   try: vals[name]=ast.literal_eval(item.value)
   except (TypeError,ValueError): pass
 return vals

def bind(raw,slots):
 values=literal_assignments(raw)
 assert all(name in values and values[name] is None for name in slots)
 assert {name for name,value in values.items() if value is None and name not in {"parent","rewrite_observer"}}==set(slots)
 source=raw.decode()
 for name,value in slots.items():
  source,n=re.subn(r"^"+name+r" = None$",lambda _:name+" = "+repr(value),source,flags=re.M)
  assert n==1
 compile(source,"phase1_lean_json_diagnostics_ordinary99_operator_bootstrap","exec",dont_inherit=True)
 for name,value in slots.items():
  assert literal_assignments(source)[name]==value
 return source.encode()

