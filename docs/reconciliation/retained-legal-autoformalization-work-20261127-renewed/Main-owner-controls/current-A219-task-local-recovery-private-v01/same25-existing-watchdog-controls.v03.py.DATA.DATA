from pathlib import Path
import ast,hashlib,io,json,os,resource,sys,time,types,unittest
resource.setrlimit(resource.RLIMIT_CPU,(30,30))
resource.setrlimit(resource.RLIMIT_AS,(536870912,536870912))
D=Path(__file__).parent
phase,name,expected,output=sys.argv[1:]
assert phase in {"RED","GREEN"} and Path(name).name==name and Path(output).name==output
source=(D/name).read_bytes()
assert hashlib.sha256(source).hexdigest()==expected
baseline=(D/'test_board_stall_watchdog.py.DATA').read_bytes()
assert len(baseline)==28670 and hashlib.sha256(baseline).hexdigest()=='5b0d140ce0ac404e2e037db401d79ec23db0094347d9006986867e7cd99059f1'
fragment=(D/'event_recheck_tests.v03.py.DATA').read_bytes()
owner=types.ModuleType('actual_cached_board_stall_watchdog')
exec(compile(source,'actual-cached-board-stall-watchdog','exec'),owner.__dict__)
old=['test_file_lock_clear_matches_only_an_empty_fuser_miss','test_active_work_is_left_alone_and_a_finished_board_is_idle','test_idle_blocked_board_releases_once_and_then_records_the_stall','test_progress_does_not_start_a_repair_subagent','test_active_task_does_not_starve_independent_metadata_resolution','test_active_resolution_reports_trusted_metadata_completion_without_launch','test_active_blocked_hold_remains_held_without_a_repair_attempt','test_active_only_frontier_does_not_call_the_metadata_resolver','test_active_recheck_preserves_the_actual_lock_exception','test_active_release_failure_does_not_claim_progress_or_spawn_repair','test_active_recheck_does_not_reset_or_spend_the_idle_repair_latch','test_existing_serve_fast_path_does_not_hide_an_active_blocked_frontier']
helpers={'_Repo','_blocked','_active_and_blocked_repo','_forbid_active_repair'}
tree=ast.parse(baseline)
nodes=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name in set(old)|helpers]
assert len(nodes)==len(old)+len(helpers) and all(not getattr(n,'decorator_list',[]) for n in nodes)
scope=dict(owner.__dict__)
exec(compile(ast.Module(body=nodes,type_ignores=[]),'actual-existing-owning-fixtures-and-tests','exec'),scope)
exec(compile(fragment,'actual-appended-event-controls','exec'),scope)
new=[n.name for n in ast.parse(fragment).body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')]
assert len(new)==13
suite=unittest.TestSuite(unittest.FunctionTestCase(scope[n],description=n) for n in old+new)
stream=io.StringIO();r=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)
report={'schema':'Main-existing-watchdog-event-aware-cache-controls/v1','phase':phase,'source_path':str(D/name),'source_bytes':len(source),'source_sha256':expected,'test_fragment_sha256':hashlib.sha256(fragment).hexdigest(),'unchanged_existing_test_selectors':old,'new_selectors':new,'tests':r.testsRun,'failures':len(r.failures),'errors':len(r.errors),'skips':len(r.skipped),'output':stream.getvalue(),'scope':'Actual whole cached stdlib watchdog module plus exact existing scripted repository fixtures and12 old tests;8 new fictional event-notification controls. No actual repository validator or SQL execution; not normal package or runtime qualification.','canonical_imports':0,'Source':0,'SQL':0,'SDK':0,'Native':0,'model':0,'network':0,'Git_mutation':0,'limits':{'CPU_seconds':30,'address_space_bytes':536870912}}
b=(json.dumps(report,indent=2)+'\n').encode();p=D/output
fd=os.open(p,os.O_CREAT|os.O_EXCL|os.O_WRONLY,0o400)
with os.fdopen(fd,'wb') as f:f.write(b);f.flush();os.fsync(f.fileno())
assert p.read_bytes()==b
print(json.dumps({'result':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest(),'tests':r.testsRun,'failures':len(r.failures),'errors':len(r.errors),'skips':len(r.skipped)}))
if phase=='GREEN': assert r.wasSuccessful()
