      ],
      [
        5125,
        "\n"
      ],
      [
        5126,
        "        def _await_plan_bound_merge_turn(\n"
      ],
      [
        5127,
        "            self,\n"
      ],
      [
        5128,
        "            execution_lease: PlanBoundExecutionLease,\n"
      ],
      [
        5129,
        "        ) -> None:\n"
      ],
      [
        5130,
        "            \"\"\"Serialize canonical queue handoff in immutable manifest order.\n"
      ],
      [
        5131,
        "\n"
      ],
      [
        5132,
        "            Provider work and proposal validation remain parallel.  The merge\n"
      ],
      [
        5133,
        "            train is globally serialized, but it can otherwise dequeue a dead\n"
      ],
      [
        5134,
        "            sibling's newly committed row before that sibling's CAS-bound\n"
      ],
      [
        5135,
        "            recovery child adopts its SETTLING lifecycle.  Requiring every\n"
      ],
      [
        5136,
        "            earlier manifest slice to reach authoritative ``merge_completed``\n"
      ],
      [
        5137,
        "            keeps the canonical train on the row whose exact owner is alive;\n"
      ],
      [
        5138,
        "            a crashed predecessor is restarted by the outer runner while later\n"
      ],
      [
        5139,
        "            lanes wait outside every store/claim/lifecycle lock.\n"
      ],
      [
        5140,
        "            \"\"\"\n"
      ],
      [
        5141,
        "\n"
      ],
      [
        5142,
        "            timeout_ms = self._proposal_barrier_timeout_ms(execution_lease)\n"
      ],
      [
        5143,
        "            deadline = time.monotonic() + timeout_ms / 1000.0\n"
      ],
      [
        5144,
        "            adapter = ProductionParallelPlanAdapter(store)\n"
      ],
      [
        5145,
        "            while True:\n"
      ],
      [
        5146,
        "                pending: list[str] = []\n"
      ],
      [
        5147,
        "                with store._thread_lock:  # noqa: SLF001\n"
      ],
      [
        5148,
        "                    with store._guard():  # noqa: SLF001\n"
      ],
      [
        5149,
        "                        manifest_payload = _secure_store_cas(\n"
      ],
      [
        5150,
        "                            store,\n"
      ],
      [
        5151,
        "                            execution_lease.slice_manifest_cid,\n"
      ],
      [
        5152,
        "                        )\n"
      ],
      [
        5153,
        "                        manifest = ConfiguredBoardExecutionSlices.from_dict(\n"
      ],
      [
        5154,
        "                            manifest_payload\n"
      ],
      [
        5155,
        "                        )\n"
      ],
      [
        5156,
        "                        ordered = tuple(\n"
      ],
      [
        5157,
        "                            sorted(\n"
      ],
      [
        5158,
        "                                manifest.nonempty,\n"
      ],
      [
        5159,
        "                                key=lambda item: (item.lane_index, item.slice_id),\n"
      ],
      [
        5160,
        "                            )\n"
      ],
      [
        5161,
        "                        )\n"
      ],
      [
        5162,
        "                        terminal_failures = tuple(\n"
      ],
      [
        5163,
        "                            item.slice_id\n"
      ],
      [
        5164,
        "                            for item in ordered\n"
      ],
      [
        5165,
        "                            if _load_plan_bound_merge_terminal_failure_locked(\n"
      ],
      [
        5166,
        "                                store,\n"
      ],
      [
        5167,
        "                                revision_cid=execution_lease.revision_cid,\n"
      ],
      [
        5168,
        "                                slice_id=item.slice_id,\n"
      ],
      [
        5169,
        "                            )\n"
      ],
      [
        5170,
        "                            is not None\n"
      ],
      [
        5171,
        "                        )\n"
      ],
      [
        5172,
        "                        if terminal_failures:\n"
      ],
      [
        5173,
        "                            raise PlanBoundReplanRequired(\n"
      ],
      [
        5174,
        "                                \"wave contains terminal canonical merge failure: \"\n"
      ],
      [
        5175,
        "                                f\"{sorted(terminal_failures)!r}\"\n"
      ],
      [
        5176,
        "                            )\n"
      ],
      [
        5177,
        "                        current_indexes = tuple(\n"
      ],
      [
        5178,
        "                            index\n"
      ],
      [
        5179,
        "                            for index, item in enumerate(ordered)\n"
      ],
      [
        5180,
        "                            if item.slice_id == execution_lease.slice_id\n"
      ],
      [
        5181,
        "                        )\n"
      ],
      [
        5182,
        "                        if len(current_indexes) != 1:\n"
      ],
      [
        5183,
        "                            raise PlanBoundReplanRequired(\n"
      ],
      [
        5184,
        "                                \"merge turn lost its immutable manifest slice\"\n"
      ],
      [
        5185,
        "                            )\n"
      ],
      [
        5186,
        "                        for prior_slice in ordered[: current_indexes[0]]:\n"
      ],
      [
        5187,
        "                            reassignment = adapter._load_slice_reassignment_locked(  # noqa: SLF001\n"
      ],
      [
        5188,
        "                                revision_cid=execution_lease.revision_cid,\n"
      ],
      [
        5189,
        "                                slice_id=prior_slice.slice_id,\n"
      ],
      [
        5190,
        "                            )\n"
      ],
      [
        5191,
        "                            owner_lane = (\n"
      ],
      [
        5192,
        "                                prior_slice.lane_id\n"
      ],
      [
        5193,
        "                                if reassignment is None\n"
      ],
      [
        5194,
        "                                else reassignment[1].recipient_lane_id\n"
      ],
      [
        5195,
        "                            )\n"
      ],
      [
        5196,
        "                            prior = _load_plan_bound_execution_lease_locked(\n"
      ],
      [
        5197,
        "                                store,\n"
      ],
      [
        5198,
        "                                revision_cid=execution_lease.revision_cid,\n"
      ],
      [
        5199,
        "                                slice_id=prior_slice.slice_id,\n"
      ],
      [
        5200,
        "                                lane_id=owner_lane,\n"
      ],
      [
        5201,
        "                            )\n"
      ],
      [
        5202,
        "                            if prior is None or prior[1].phase != \"merge_completed\":\n"
      ],
      [
        5203,
        "                                pending.append(prior_slice.slice_id)\n"
      ],
      [
        5204,
        "                if not pending:\n"
      ],
