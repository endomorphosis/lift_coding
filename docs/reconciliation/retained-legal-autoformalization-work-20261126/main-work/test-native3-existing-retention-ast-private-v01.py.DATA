"""Two exact retention/readback AST controls in a private owned temp directory."""
from __future__ import annotations
import argparse
import ast
import copy
import hashlib
import io
import json
import os
from pathlib import Path
import stat
import tempfile
import unittest


def main():
    parser=argparse.ArgumentParser();parser.add_argument('--source',required=True);parser.add_argument('--sha256',required=True);parser.add_argument('--output',required=True);args=parser.parse_args()
    path=Path(args.source);raw=path.read_bytes();assert hashlib.sha256(raw).hexdigest()==args.sha256
    tree=ast.parse(raw);names={'read_private','retain_bytes'};nodes=[n for n in ast.walk(tree) if isinstance(n,ast.FunctionDef) and n.name in names];assert {n.name for n in nodes}==names
    code=compile(ast.fix_missing_locations(ast.Module(body=copy.deepcopy(nodes),type_ignores=[])),str(path),'exec')
    class ReadbackTests(unittest.TestCase):
        def execute(self,*,mutate):
            with tempfile.TemporaryDirectory(prefix='native3-retention-fixture-',dir=Path(__file__).parent) as directory:
                fields=('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
                calls=[];scope={'Path':Path,'stat':stat,'os':os,'f9':lambda s:{k:str(getattr(s,k)) for k in fields},'H':lambda b:hashlib.sha256(b).hexdigest(),'RUN_OUTPUT':Path(directory),'MAX_DIAGNOSTIC_BYTES':1048576,'report':{'diagnostic_bytes_written':0}}
                exec(code,scope);reader=scope['read_private']
                def observed_read(path,size,digest):
                    calls.append((path,size,digest))
                    if mutate:
                        os.chmod(path,0o600)
                        with open(path,'wb') as output:output.write(b'changed');output.flush();os.fsync(output.fileno())
                        os.chmod(path,0o400)
                    return reader(path,size,digest)
                scope['read_private']=observed_read
                if mutate:
                    with self.assertRaises(AssertionError):scope['retain_bytes']('actual-raw-fixture.bin',b'exact raw bytes\x00\xff')
                else:
                    ref=scope['retain_bytes']('actual-raw-fixture.bin',b'exact raw bytes\x00\xff')
                    self.assertEqual(Path(ref['path']).read_bytes(),b'exact raw bytes\x00\xff')
                    self.assertEqual(stat.S_IMODE(Path(ref['path']).stat().st_mode),0o400)
                self.assertEqual(len(calls),1)
        def test_raw_retention_actually_reads_back(self):self.execute(mutate=False)
        def test_post_write_changed_bytes_refuse_before_custody_release(self):self.execute(mutate=True)
    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(ReadbackTests))
    value={'source':{'path':str(path),'bytes':len(raw),'sha256':args.sha256},'tests_run':result.testsRun,'failures':len(result.failures),'errors':len(result.errors),'skipped':len(result.skipped),'output':stream.getvalue(),'scope':'Exact existing retain_bytes and read_private AST; owned private filesystem only; explicit post-write mutation fixture; no project/SDK/Source/Native/real resource calls.'}
    saved=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode();output=Path(args.output);fd=os.open(output,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400)
    try:
        todo=memoryview(saved)
        while todo:n=os.write(fd,todo);assert n>0;todo=todo[n:]
        os.fsync(fd)
    finally:os.close(fd)
    assert output.read_bytes()==saved
    print(json.dumps({'path':str(output),'bytes':len(saved),'sha256':hashlib.sha256(saved).hexdigest(),'tests_run':result.testsRun,'failures':len(result.failures),'errors':len(result.errors)}))


if __name__=='__main__':main()
