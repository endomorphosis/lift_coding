"""Fixture-only external benchmark evaluation, denying models and subprocesses."""
import hashlib
import importlib.abc
import importlib.util
import json
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent
mode = sys.argv[4]
guard = Path(sys.argv[5])
assert mode in {"red", "green"}
assert sys.argv[2] == "red"  # Do not activate the unrelated proof-cache overlays.
starter = guard.read_text()
assert hashlib.sha256(starter.encode()).hexdigest() == "b3fe749fe409c404a426669781c4807538115fda1127534bbb3c8613853fd42e"
marker = 'owner = repo / "tests/unit/logic/legal_ir/test_proof_cache.py"'
assert starter.count(marker) == 1
environment = {"__file__": str(guard)}
exec(compile(starter.split(marker, 1)[0], str(guard), "exec", dont_inherit=True), environment)
repo, working = environment["repo"], environment["working"]
os.chdir(working)
os.environ["PYTEST_DISABLE_PLUGIN_AUTOLOAD"] = "1"
relative = "scripts/ops/legal_ir/hammer_leanstral_rollout_gate.py"
def snapshot(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

class PrivateOwner(importlib.abc.MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname == "scripts.ops.legal_ir.hammer_leanstral_rollout_gate":
            leaf = "gate-owner.before.py.DATA" if mode == "red" else "gate-owner.after.py.DATA"
            return importlib.util.spec_from_file_location(
                fullname, repo / relative, loader=environment["GuardedLoader"](relative, root / leaf))
        return None

sys.meta_path.insert(0, PrivateOwner())
import pytest
test = root / "isolated-v03/tests/unit/optimizers/logic_theorem_optimizer/test_compiler_system_promotion_gate.py"
fixtures = repo / "tests/unit/optimizers/logic_theorem_optimizer/test_external_validity_promotion_gate.py"
raw = fixtures.read_bytes()
assert hashlib.sha1(b"blob " + str(len(raw)).encode() + b"\0" + raw).hexdigest() == "83c43ebef4d4eb874635f586ded14a8e4601421a"
result = int(pytest.main([
    "-c", "/dev/null", "--noconftest", "-p", "no:cacheprovider", "--rootdir", str(root / "isolated-v03"),
    "-q", "--tb=short", "-k", "not test_compiler_system_gate_cli_writes_decision_and_report", f"--basetemp={working / 'pytest'}", f"--junitxml={working / 'junit.xml'}",
    f"--log-file={working / 'pytest.log'}", str(test),
]))
print(json.dumps({"mode": mode, "pytest_exit": result, "guard_events": environment["denied"],
                  "overlays": environment["watched"], "test": snapshot(test), "fixture": snapshot(fixtures)},
                 sort_keys=True))
raise SystemExit(result if not environment["denied"] else 2)
