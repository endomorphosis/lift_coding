+def observe_rollout_test_imports():
+    # Two maintained test files deliberately reload scripts.*. Keep their
+    # imported functions coupled to code compiled by the guarded Source loader.
+    path = str(bound_paths[ROLLOUT_OWNER])
+    live = sys.modules.get(ROLLOUT_OWNER)
+    observations = {}
+    for test, names in ROLLOUT_EXPORTS.items():
+        generation = None
+        namespace = None
+        for name in names:
+            fn = vars(loaded[test]).get(name)
+            if type(fn) is not FunctionType or fn.__module__ != ROLLOUT_OWNER:
+                raise RuntimeError('foreign rollout export in selected test')
+            scope = fn.__globals__
+            spec = scope.get('__spec__')
+            if spec is None or spec.name != ROLLOUT_OWNER or spec.origin != path:
+                raise RuntimeError('rollout export origin differs from exact Source')
+            if scope.get('__file__') != path or fn.__code__.co_filename != path:
+                raise RuntimeError('rollout export path differs from exact Source')
+            copies = [index for index, constants in enumerate(rollout_code_generations)
+                      if any(fn.__code__ is constant for constant in constants)]
+            if len(copies) != 1 or (generation is not None and
+                    (copies[0] != generation or scope is not namespace)):
+                raise RuntimeError('test did not retain one guarded rollout source generation')
+            generation, namespace = copies[0], scope
+        observations[test] = {'path': path, 'exports': names, 'compiled_SHA256': compiled[path],
+                              'compile_generation': generation, 'is_current_alias': live is not None and live.__dict__ is namespace}
+    if len({row['compile_generation'] for row in observations.values()}) != len(ROLLOUT_EXPORTS):
+        raise RuntimeError('separate fixture imports need distinct guarded code generations')
+    if sum(row['is_current_alias'] for row in observations.values()) != 1:
+        raise RuntimeError('live rollout alias differs from observed test imports')
+    return live, observations
