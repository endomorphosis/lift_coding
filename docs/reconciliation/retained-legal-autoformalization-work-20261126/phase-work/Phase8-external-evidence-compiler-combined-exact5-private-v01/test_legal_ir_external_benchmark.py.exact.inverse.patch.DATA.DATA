-    else:
-        payload["packet_digest"] = "sha256:" + "0" * 64
-
-    with pytest.raises(LegalIRExternalBenchmarkError, match="benchmark packet digest"):
-        ExternalLegalExpertBenchmarkPacket.from_mapping(payload)
