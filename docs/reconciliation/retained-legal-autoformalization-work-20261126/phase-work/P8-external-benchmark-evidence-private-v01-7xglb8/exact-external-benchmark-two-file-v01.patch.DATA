diff --git a/ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_ir_external_benchmark.py b/ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_ir_external_benchmark.py
--- a/ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_ir_external_benchmark.py
