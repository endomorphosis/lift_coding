+@pytest.mark.parametrize("change", ["none", "missing-round-trip", "changed-actor"])
+def test_semantic_equivalence_gate_is_unchanged_by_latent_instrumentation(change):
+    from ipfs_datasets_py.optimizers.logic_theorem_optimizer.legal_ir_evaluation_cache import (
+        LegalIREvaluationArtifact,
+    )
+    from ipfs_datasets_py.optimizers.logic_theorem_optimizer.legal_ir_semantic_metrics import (
+        SemanticEquivalenceConfig,
+        semantic_equivalence_promotion_gate,
+    )
+
+    def reported_rule(actor):
+        return {
+            "rules": [
+                {"modality": "obligation", "subject": actor, "action": "provide notice",
+                 "proof_obligation_ids": ["po-notice"]},
+            ],
+            "round_trip": {
+                "decompiled": f"The {actor} must provide notice.",
+                "recompiled_ir": f"O(provide_notice({actor.lower()}))",
+            },
+        }
+
+    reference = reported_rule("Agency")
+    candidate = reported_rule("Contractor" if change == "changed-actor" else "Agency")
+    if change == "missing-round-trip":
+        del candidate["round_trip"]
+
+    def metrics(candidate_ir):
+        return {"view_family_metrics": {
+            "deontic": {"reference_ir": reference, "candidate_ir": candidate_ir},
+        }}
+
+    baseline = metrics(reference)
+    case = LegalIREvaluationArtifact(
+        key=LegalIREvaluationCacheKey(
+            sample_hash="fictional-notice-rule",
+            compiler_commit="fixture-compiler",
+            state_hash="fixture-state",
+            metric_schema="fixture-metrics",
+            config_hash="fixture-config",
+        ),
+        compiler_artifact={},
+        metrics=metrics(candidate),
+    )
+    config = SemanticEquivalenceConfig(families=("deontic",))
+    before = semantic_equivalence_promotion_gate(baseline, case.metrics, config=config)
+    diagnostic = materialize_latent_diagnostic_report(synthetic_collapse_fixture())
+    attached = attach_latent_diagnostics(case, diagnostic)
+    assert attached.metadata["latent_diagnostic_digest"] == diagnostic.digest
+    assert case.metrics["view_family_metrics"] == attached.metrics["view_family_metrics"]
+
+    after = semantic_equivalence_promotion_gate(baseline, attached.metrics, config=config)
+    assert before == after
+    assert after["accepted"] is (change == "none")
+    measured = after["family_results"]["deontic"]["after"]
+    assert measured["scores"]["obligation_equivalence"] == (0.0 if change == "changed-actor" else 1.0)
+    observations = measured["detail"]["round_trip_evidence"]
+    assert observations["authority"] == "caller_reported_observations_only"
+    assert observations["independently_recompiled"] is False
+    if change == "missing-round-trip":
+        assert measured["missing_metrics"] == ["decompiler_round_trip_preservation"]
+        assert "deontic:semantic_equivalence_evidence_missing" in after["block_reasons"]
+    else:
+        assert measured["complete"] is True
+
+
+@pytest.mark.parametrize("scale", [1.0, 1e308, 1e-320], ids=["ordinary", "large", "subnormal"])
+def test_strata_cosines_and_centroids_preserve_finite_scale(scale):
+    records = [
+        LatentRepresentationRecord(sample_id="a1", vector=(scale, scale), family="deontic"),
+        LatentRepresentationRecord(sample_id="a2", vector=(scale, 0.0), family="deontic"),
+        LatentRepresentationRecord(sample_id="b1", vector=(scale, 0.0), family="tdfol"),
+        LatentRepresentationRecord(sample_id="b2", vector=(scale, 0.0), family="tdfol"),
+    ]
+    family = evaluate_latent_clustering_strata(records).axes["family"]
+    expected_intra = (1 + 1 / math.sqrt(2)) / 2
+    expected_inter = 2 / math.sqrt(5)
+    assert family.group_counts == {"deontic": 2, "tdfol": 2}
+    assert family.intra_cosine == pytest.approx(expected_intra), family.to_dict()
+    assert family.inter_cosine == pytest.approx(expected_inter)
+    assert family.separation == pytest.approx(expected_intra - expected_inter)
+    assert family.unknown_denominators == ()
+
+
+@pytest.mark.parametrize("unavailable", [math.nan, math.inf, -math.inf])
+def test_strata_keep_nonfinite_vectors_out_of_cosine_denominators(unavailable):
+    result = evaluate_latent_clustering_strata([
+        {"sample_id": "valid", "family": "deontic", "vector": (1.0, 0.0)},
+        {"sample_id": "invalid", "family": "deontic", "vector": (unavailable, 1.0)},
+    ]).axes["family"]
+    assert result.intra_cosine is None, result.to_dict()
+    assert result.group_counts == {"deontic": 2}
+    assert result.in_distribution_count == 2
+    assert "family:nonfinite_vector" in result.unknown_denominators
+
+
+def test_strata_reports_unavailable_inter_cosine_for_zero_centroids():
+    records = [
+        LatentRepresentationRecord(sample_id="a1", vector=(1.0, 0.0), family="deontic"),
+        LatentRepresentationRecord(sample_id="a2", vector=(-1.0, 0.0), family="deontic"),
+        LatentRepresentationRecord(sample_id="b1", vector=(0.0, 1.0), family="tdfol"),
+        LatentRepresentationRecord(sample_id="b2", vector=(0.0, -1.0), family="tdfol"),
+    ]
+    family = evaluate_latent_clustering_strata(records).axes["family"]
+    assert family.intra_cosine == pytest.approx(-1.0)
+    assert family.inter_cosine is None
+    assert family.separation is None
+    assert "family:inter_cosine" in family.unknown_denominators
