    @pytest.mark.parametrize("dimension,role", [
        ("source_integrity", "reviewed_crosswalk"),
        ("representation", "preservation"),
        ("dependency", "dependency"),
    ])
    def test_checked_release_type_capture_requires_the_matching_component_evidence(dimension, role):
        from ipfs_datasets_py.logic.autoformal import corpus_qualification as qualification
    
        case = _checked_release_type_capture_fixture("one")
        report = deepcopy(case["report"])
        evidence = report["declared_eligibility_evidence"]
        components = evidence["component_cids"]
        original = report["declared_qualification"]
        dimensions = deepcopy(original["dimensions"])
        assert dimensions[dimension]["evidence_cids"] == [components[role]]
        assert components[role] != components["graph"]
        dimensions[dimension]["evidence_cids"] = [components["graph"]]
        declared = qualification.prepare_qualification(
            artifact_cid=evidence["artifact_cid"], profile=report["profile"],
            theorem_requested=original["theorem_requested"], dimensions=dimensions)
        eligibility = qualification.derive_eligibility(
            declared, artifact_cid=evidence["artifact_cid"], profile=report["profile"])
        assert declared["record_cid"] != original["record_cid"]
        assert eligibility["views"] == case["report"]["declared_eligibility"]["views"]
        assert eligibility["views"]["reviewed_graph"]["declared_eligible"] is True
        assert eligibility["views"]["checked_lean"]["declared_eligible"] is False
        report.update(declared_qualification=declared, declared_eligibility=eligibility)
        raw = canonical(report)
        options = {**case["options"], "checked_release_report_raw": raw,
                   "expected_checked_release_report_sha256": sha(raw)}
&gt;       with pytest.raises(ValueError, match=dimension + " evidence differs"):
E       Failed: DID NOT RAISE &lt;class 'ValueError'&gt;

