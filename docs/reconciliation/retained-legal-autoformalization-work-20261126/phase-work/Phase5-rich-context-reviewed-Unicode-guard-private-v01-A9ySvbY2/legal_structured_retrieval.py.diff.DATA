--- a/ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_structured_retrieval.py
+++ b/ipfs_datasets_py/optimizers/logic_theorem_optimizer/legal_structured_retrieval.py
@@ -320,12 +320,25 @@
     _require(not training_sources.intersection(heldout_sources),
              "heldout and TRAIN share a reviewed declared legal source identity")
     source_rows = [*queries, *training_rows]
-    source_examples = [bound.splits.LegalIRSplitExample.from_sample(row) for row in source_rows]
-    clusters = bound.splits._near_duplicate_clusters(source_examples,
-        bound.splits.LegalIREvalSplitConfig().near_duplicate_jaccard_threshold)
-    holdout_clusters = {clusters[query["id"]] for query in queries if query["id"] in clusters}
-    _require(not holdout_clusters.intersection(clusters.get(row["id"]) for row in training_rows),
