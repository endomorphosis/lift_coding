 def build_ir_campaign_splits(
     samples: Sequence[Any],
     config: LegalIREvalSplitConfig | None = None,
+    *,
+    split_profile: str | None = None,
 ) -> LegalIRSplitManifest:
-    """Build IRSplitManifest@1 from lineage-grouped samples.
