from dataclasses import replace
from pathlib import Path
from types import ModuleType
import hashlib
import json
import sys
import traceback

stage = Path(__file__).absolute().parent
feedback = stage.parent / "Phase7-current-obligation-write-binding-private-ymey1qtf"
adapter_path = feedback / "no-fit-current-obligation-bound-feedback-adapter-v02.py"
raw = adapter_path.read_bytes()
assert (len(raw), hashlib.sha256(raw).hexdigest()) == (
    20480, "43ad9ed1524e541998646663dc67baea01cacce87769666d4afa12cd6252abf7",
)
adapter = ModuleType("_existing_pinned_nofit_fixture_adapter")
adapter.__file__ = str(adapter_path)
sys.modules[adapter.__name__] = adapter
exec(compile(raw, str(adapter_path), "exec"), adapter.__dict__)
prior = adapter.load_prior()
owner_rel = "ipfs_datasets_py/optimizers/logic_theorem_optimizer/modal_autoencoder.py"


def overlay_loader(pin):
    adapter.prepare_loader(prior, {})
    if pin is None:
        return
    post, count, digest = pin
    code = adapter.pinned_file(stage / post, count, digest)
    guarded_source = prior.BoundSource

    class CurrentCacheFixtureOverlay(guarded_source):
        def get_code(self, fullname):
            baseline = super().get_code(fullname)
            path = Path(self.path).absolute()
            relative = path.relative_to(prior.ROOT).as_posix()
            if relative != owner_rel:
                return baseline
            prior.compiled_total += len(code)
            assert prior.compiled_total <= prior.MAX_MODULE_BYTES
            prior.compiled[relative]["overlay_executed"] = {
                "path": str(stage / post), "bytes": count, "sha256": digest,
            }
            return compile(code, str(path), "exec", dont_inherit=True)

    prior.BoundSource = CurrentCacheFixtureOverlay


def cases(fixture):
    from ipfs_datasets_py.optimizers.logic_theorem_optimizer import modal_autoencoder as modal

    original, revised, _, _, _ = adapter.samples_and_legacy_record(fixture)
    assert original.sample_id == revised.sample_id and original.text == revised.text
    assert original.modal_ir.canonical_hash() != revised.modal_ir.canonical_hash()
    assert modal._sample_content_cache_id(original) == modal._sample_content_cache_id(revised)
    updated_text = original.text + " A different fictional source revision applies."
    other_source = replace(original, text=updated_text, normalized_text=updated_text,
        modal_ir=replace(original.modal_ir, normalized_text=updated_text))
    other_source.validate()
    assert other_source.sample_id == original.sample_id
    assert modal._sample_content_cache_id(original) != modal._sample_content_cache_id(other_source)
    distinct_id = replace(original, sample_id="fictional-other-sample-with-same-projection")
    assert modal._sample_content_cache_id(original) == modal._sample_content_cache_id(distinct_id)
    prefix = original.text[:45].rstrip()
    bounded = modal._legal_ir_metric_sample_for_text(original, metric_text=prefix)
    bounded_revision = modal._legal_ir_metric_sample_for_text(revised, metric_text=prefix)
    assert bounded.sample_id == bounded_revision.sample_id != original.sample_id
    assert bounded.text != original.text
    assert bounded.modal_ir.canonical_hash() != bounded_revision.modal_ir.canonical_hash()
    target = {"deontic.ir": 1.0}
    new_target = {"TDFOL.prover": 1.0}
    temporary = {"CEC.native": 1.0}
    losses = {"linear_logic_equivalence_loss": 0.55}

    def prime(model, sample, views=target, scaled_losses=losses):
        model._cache_legal_ir_targets([sample], {sample.sample_id: views},
                                     {sample.sample_id: scaled_losses})

    def lookup(model, sample):
        return [
            model._legal_ir_view_target_distribution_for_sample(sample, include_autoencoder_prior=False),
            model._compiler_quality_loss_targets_for_sample(sample),
        ]

    rows = []

    def observe(name, report, expected):
        rows.append(dict(case=name, observed=report, expected=expected, passed=report == expected))

    model = fixture.AdaptiveModalAutoencoder(compute_device="python")
    clean_state = prior.state_identity(model)
    prime(model, original)
    observe("retained-exact-revision-copy", lookup(model, replace(original)), [target, losses])
    observe("same-id-edited-ir", lookup(model, revised), [{}, {}])
    observe("same-id-edited-source", lookup(model, other_source), [{}, {}])
    observe("different-sample-id-same-coarse-projection", lookup(model, distinct_id), [{}, {}])
    prime(model, bounded)
    model.alias_cached_legal_ir_targets([original], [bounded])
    observe("retained-explicit-exact-prefix-alias", lookup(model, original), [target, losses])
    model.alias_cached_legal_ir_targets([revised], [bounded_revision])
    observe("stale-prefix-cannot-donate-to-updated-full-row", lookup(model, revised), [{}, {}])

    prime(model, original)
    prime(model, revised, views=new_target)
    observed = []

    def intercept(sample, **kwargs):
        assert sample is original
        observed.append([lookup(model, original)[0], lookup(model, revised)[0]])
        return True

    with fixture.pytest.MonkeyPatch.context() as patches:
        patches.setattr(model, "_nudge_legal_ir_view_logits", intercept)
        assert model._nudge_legal_ir_view_logits_toward_distribution(
            original, temporary, learning_rate=0.01, update_sample_memory=False,
        )
    observed[0].extend([lookup(model, original)[0], lookup(model, revised)[0]])
    observe("retained-temporary-override-scoped-and-restored", observed[0],
        [temporary, new_target, target, new_target])

    clean_batch = fixture.AdaptiveModalAutoencoder(compute_device="python")
    result = {}
    try:
        clean_batch._cache_legal_ir_targets([original, revised], {original.sample_id: target},
                                            {original.sample_id: losses})
    except ValueError:
        result["refused"] = True
    else:
        result["refused"] = False
    result["no_alias_partially_installed"] = lookup(clean_batch, original) == [{}, {}] and lookup(clean_batch, revised) == [{}, {}]
    observe("ambiguous-id-keyed-batch-refused-before-cache-mutation", result,
        {"refused": True, "no_alias_partially_installed": True})
    assert prior.state_identity(model) == clean_state
    assert prior.state_identity(clean_batch) == clean_state
    return rows


outcome = {}
code = 2
try:
    assert sys.argv[1:] == ["baseline"] or len(sys.argv) == 5 and sys.argv[1] == "overlay"
    prior.install_kernel_guards()
    pin = (sys.argv[2], int(sys.argv[3]), sys.argv[4]) if sys.argv[1] == "overlay" else None
    overlay_loader(pin)
    fixture = adapter.import_fixture(prior)
    outcome["rows"] = cases(fixture)
    assert not prior.denied
    code = 0 if all(row["passed"] for row in outcome["rows"]) else 1
except Exception as error:
    traceback.print_exc()
    outcome["refusal"] = repr(error)
finally:
    outcome.update(worker_rc=code, denied=prior.denied, guard=prior.guard, compiled=prior.compiled,
                   project_body_bytes=prior.compiled_total, model_fit=False)
    print(json.dumps(outcome, sort_keys=True))
raise SystemExit(code)
