--- a/tests/unit/optimizers/logic_theorem_optimizer/test_legal_ir_external_benchmark.py
+++ b/tests/unit/optimizers/logic_theorem_optimizer/test_legal_ir_external_benchmark.py
@@ -382,119 +382,3 @@
