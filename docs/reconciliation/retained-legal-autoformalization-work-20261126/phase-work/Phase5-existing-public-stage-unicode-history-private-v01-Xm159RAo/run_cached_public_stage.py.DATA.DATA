import ast
from dataclasses import replace
import hashlib
from importlib.machinery import SourceFileLoader
from importlib.util import spec_from_loader, module_from_spec
from importlib.abc import MetaPathFinder
import os
from pathlib import Path
import resource
import sys
from types import SimpleNamespace

import pytest

resource.setrlimit(resource.RLIMIT_CPU, (35, 40))
if hasattr(os, "sched_getaffinity"):
    os.sched_setaffinity(0, {min(os.sched_getaffinity(0))})


class ScopeGuard(MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname.partition(".")[0] in {"torch", "transformers", "duckdb"}:
            raise AssertionError("out-of-scope import: " + fullname)
        return None


stage_root, original_test, fragment, split, consumer, training, run_root = map(Path, sys.argv[1:])
run_root.mkdir(mode=0o700)
sys.path.insert(0, str(stage_root))
sys.meta_path.insert(0, ScopeGuard())


def load_owner(name, path, digest):
    assert hashlib.sha256(path.read_bytes()).hexdigest() == digest, path
    spec = spec_from_loader(name, SourceFileLoader(name, str(path)))
    module = module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    parent, _, attr = name.rpartition(".")
    if parent in sys.modules:
        setattr(sys.modules[parent], attr, module)
    assert Path(module.__file__) == path
    return module


p = "ipfs_datasets_py.optimizers.logic_theorem_optimizer."
splits = load_owner(p + "legal_ir_eval_splits", split, "e652c79842323fec40f3e5d8f6a23620c9b4ce4a2d1043c597176a13de3f4acd")
binding = load_owner(p + "legal_span_consumer_binding", consumer, "5bb6c1c1d627d65d7e0d98a00d5f646c7519f0c3a73a21492db1936445ecdd4f")
actual_training_hash = hashlib.sha256(training.read_bytes()).hexdigest()
assert actual_training_hash in {"88125051a7b1d0dcc887f772faa750fa13b8a2141693679a62e2bd5e97e92db3",
                                "c172218316d2add710f45f3c0cd99f78fbc4a4f70616cfb875eb07930bea1b28"}
inputs = load_owner("ipfs_datasets_py.logic.autoformal.training_cycle_inputs", training, actual_training_hash)
old = original_test.read_bytes()
assert hashlib.sha256(old).hexdigest() == "1bc35935c61fb82ccd41c0b9ce9e46e93eb215778166182404c5e8849c4382be"
definitions = {"_ReviewedArtifactRegistry", "_reviewed_transition_fixture", "_reviewed_stage_options", "_reviewed_doc"}
existing = [node for node in ast.parse(old).body if getattr(node, "name", "") in definitions]
assert len(existing) == len(definitions)
namespace = {"pytest": pytest, "inputs": inputs, "Path": Path, "replace": replace,
             "json": __import__("json"), "SimpleNamespace": SimpleNamespace}
exec(compile(ast.Module(body=existing, type_ignores=[]), str(original_test), "exec"), namespace)
exec(compile(fragment.read_bytes(), str(fragment), "exec"), namespace)

failed = 0
for name, args in (
    ("default", (False,)), ("unicode", (True,)), ("repinned_history_source_drift", ()),
):
    path = run_root / name
    path.mkdir(mode=0o700)
    try:
        if args:
            namespace["test_reviewed_cycle_preserves_actual_campaign_manifest_and_source_history"](path, *args)
        else:
            namespace["test_reviewed_cycle_rejects_repinned_unicode_history_source_drift_before_staging"](path)
    except (Exception, pytest.fail.Exception):
        import traceback
        traceback.print_exc()
        print(name, "FAIL", flush=True)
        failed += 1
    else:
        print(name, "PASS", flush=True)
raise SystemExit(bool(failed))
