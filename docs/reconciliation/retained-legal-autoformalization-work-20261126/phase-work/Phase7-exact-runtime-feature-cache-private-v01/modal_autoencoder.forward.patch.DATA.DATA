+        # The bridge-target cache uses a citation-independent projection.
+        # Feature extraction reads the whole sample, including formula order,
+        # source roles, and current parser metadata. Hash it at each lookup
+        # because a frozen sample can still contain mutable nested values.
+        try:
+            snapshot = sample
+            if type(sample.embedding_vector) not in (tuple, list):
+                snapshot = replace(sample, embedding_vector=tuple(sample.embedding_vector))
+            payload = json.dumps(asdict(snapshot), ensure_ascii=True,
+                                 allow_nan=False, separators=(",", ":"))
+        except (TypeError, ValueError, RecursionError):
+            # Non-serializable extension inputs may still be processed, but
+            # cannot share a feature-cache entry.
+            return {}
+        digest = hashlib.sha256(payload.encode("ascii")).hexdigest()
+        return self._sample_feature_cache.setdefault((digest, len(sample.embedding_vector)), {})
 
