read_fields = ('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
denied, observed, tried = [], [], []
byte_count = 0
byte_limit = int(sys.argv[2])
assert 0 < byte_limit <= 8 << 20
blocked = frozenset(('duckdb','_duckdb','torch','transformers','tensorflow','onnxruntime','llama_cpp'))
writes = os.O_RDWR | os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_APPEND
mutations = {'os.mkdir','os.remove','os.rmdir','os.rename','os.link','os.symlink',
             'os.truncate','os.chmod','os.chown','os.utime','shutil.rmtree'}

def deny(event, key):
    denied.append([event,str(key)])
    raise PermissionError(f'private fixture operation denied: {event} {key}')

def location(value):
    if isinstance(value, int):
        value = os.readlink(f'/proc/self/fd/{value}')
    return Path(os.path.realpath(os.fsdecode(value)))

def audit(event, args):
    if event.startswith(('socket.', 'subprocess.', 'os.exec', 'os.spawn', 'os.posix_spawn')) or event in {
        'os.fork','os.forkpty','os.system','os.kill','os.killpg','ctypes.dlopen',
    }:
        deny(event, 'process or network')
    if event == 'open' and len(args) > 2:
        if isinstance(args[0], int):
            if args[2] & writes and not location(args[0]).is_relative_to(work):
                deny(event, args[0])
            return
        resolved = location(args[0])
        if resolved.name == 'disk-reservations.json' or (resolved.parent == Path('/tmp') and resolved.name.startswith('ipfs-datasets-resource-scheduler-')):
            deny('live_resource_state_open', resolved)
        if any(resolved.is_relative_to(root) for root in forbidden_roots):
            deny('canonical_source_open', resolved)
        if args[2] & writes and not resolved.is_relative_to(work):
            deny(event, resolved)
    if event in mutations:
        values = args[:2] if event in {'os.rename','os.link','os.symlink'} else args[:1]
        for value in values:
            if not location(value).is_relative_to(work):
                deny(event, value)

def read(path):
    global byte_count
    assert path.resolve(strict=True) == path, path
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd, 'rb') as f:
        s = os.fstat(f.fileno())
        assert stat.S_ISREG(s.st_mode) and s.st_nlink == 1
        before = tuple(getattr(s, k) for k in read_fields)
        if byte_count+s.st_size > byte_limit:
            raise RuntimeError(f'private cached input limit exhausted at {path}')
        body = f.read(s.st_size+1)
        byte_count += len(body)
        assert len(body)==s.st_size and before==tuple(getattr(os.fstat(f.fileno()),k) for k in read_fields)
    digest = hashlib.sha256(body).hexdigest()
    tried.append([str(path),len(body),digest])
    return body,digest

def pinned(path, size, digest):
    value, actual = read(path)
    assert len(value)==size and actual==digest, path
    return value

class BoundLoader(importlib.abc.Loader):
    def __init__(self, filename, body):
        self.filename, self.body = str(filename), body

    def exec_module(self, module):
        exec(compile(self.body, self.filename, 'exec', dont_inherit=True), module.__dict__)

class RefusingLoader(importlib.abc.Loader):
    def __init__(self, name):
        self.name = name

    def exec_module(self, module):
        raise ImportError(f'missing pinned private body for {self.name}')

class BoundFinder(importlib.abc.MetaPathFinder):
    def __init__(self, records, overlays):
        self.records, self.overlays = records, overlays

    def find_spec(self, fullname, path=None, target=None):
        top = fullname.split('.',1)[0]
        if top in blocked:
            raise ImportError(f'backend outside private in-memory scope: {fullname}')
        if top not in archived:
            return None
        prefix = fullname.replace('.','/')
        choices = ((prefix+'/__init__.py', True), (prefix+'.py',False))
        for relative, pkg in choices:
            expected = self.records.get(relative)
            if expected is None:
                continue
            for candidate in self.overlays.get(relative, ()) + tuple(r/relative for r in archived[top]):
                if not candidate.is_file():
                    continue
                if candidate.lstat().st_size != expected[0]:
                    continue
                body, digest = read(candidate)
                if digest == expected[1]:
                    observed.append([fullname,str(candidate),len(body),digest])
                    return importlib.util.spec_from_file_location(
                        fullname, candidate, loader=BoundLoader(candidate,body),
                        **({'submodule_search_locations':[str(candidate.parent)]} if pkg else {}),
                    )
            return importlib.util.spec_from_file_location(
                fullname, work/relative, loader=RefusingLoader(fullname),
                **({'submodule_search_locations':[]} if pkg else {}),
            )
        if any(rel.startswith(prefix+'/') for rel in self.records):
            spec = importlib.machinery.ModuleSpec(fullname, None, is_package=True)
            spec.submodule_search_locations = []
            observed.append([fullname,'prior manifest namespace',0,None])
            return spec
        return importlib.util.spec_from_file_location(fullname, work/(prefix+'.py'),
                loader=RefusingLoader(fullname))

