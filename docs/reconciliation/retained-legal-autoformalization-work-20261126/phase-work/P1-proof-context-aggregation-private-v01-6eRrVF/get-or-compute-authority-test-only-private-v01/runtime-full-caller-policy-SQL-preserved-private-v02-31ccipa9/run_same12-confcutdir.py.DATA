        'ipfs_datasets_py/optimizers/logic_theorem_optimizer/resource_scheduler.py': Path('/tmp/Root-LIR23-fresh18-existing-SourceREAD-actual-v183-huy_olqh/08-resource_scheduler.py.DATA'),
