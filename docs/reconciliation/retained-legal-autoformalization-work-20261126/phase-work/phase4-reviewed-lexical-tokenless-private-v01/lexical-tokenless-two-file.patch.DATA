--- a/tests/unit/optimizers/logic_theorem_optimizer/test_legal_joint_retrieval.py
+++ b/tests/unit/optimizers/logic_theorem_optimizer/test_legal_joint_retrieval.py
@@ -1043,3 +1043,36 @@
     assert case["preparation"] == original_preparation
