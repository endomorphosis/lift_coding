--- a/tests/unit/optimizers/logic_theorem_optimizer/test_legal_ir_evaluation_artifacts.py
+++ b/tests/unit/optimizers/logic_theorem_optimizer/test_legal_ir_evaluation_artifacts.py
@@ -4633,3 +4633,36 @@
     assert result["candidate_count"] == 0 and result["abstention_count"] == 1
     assert result["rows"] == [] and result["model_forward_executed"] is False
     assert "required_dependency_closure_not_current" in result["blockers"]
+
+
+
+@pytest.mark.parametrize("query_count", [0, 1, 32, 33])
+def test_aggregate_v4_ranked_context_checks_query_count_before_ranking(monkeypatch, query_count):
+    from ipfs_datasets_py.optimizers.logic_theorem_optimizer import legal_structured_retrieval as structured
+
+    queries = [
+        {"id": f"fixture:query:{index}", "split_sample_id": f"fixture:split:{index}",
+         "source_text": f"Fictional provision {index}."}
+        for index in range(query_count)
+    ]
+    calls = []
+
+    class RankingReached(Exception):
+        pass
+
+    def rank(_retriever, offered, *args, **kwargs):
+        calls.append(offered)
+        raise RankingReached
+
+    monkeypatch.setattr(structured, "build_reviewed_rich_context_candidates_v4", rank)
+    expected = RankingReached if 1 <= query_count <= 32 else ValueError
+    with pytest.raises(expected) as stopped:
+        structured.prepare_reviewed_ranked_training_context_v4(
+            object(), queries, None, None, None, [],
+            retrieval_inputs={}, example_consumer_inputs={})
+    if expected is ValueError:
+        assert "bounded aggregate quer" in str(stopped.value)
+        assert calls == []
+    else:
+        assert calls == [queries]
+        assert calls[0] is not queries
