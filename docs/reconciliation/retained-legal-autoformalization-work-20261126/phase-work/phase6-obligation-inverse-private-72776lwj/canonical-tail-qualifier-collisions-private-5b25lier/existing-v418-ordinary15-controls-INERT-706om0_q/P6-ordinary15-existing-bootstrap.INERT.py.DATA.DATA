def exact(path, size, digest):
    p = Path(path)
    assert p.is_absolute() and p.resolve(strict=True) == p
    a = p.lstat()
    fields = ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_uid', 'st_gid', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
    stamp = lambda info: {k: str(getattr(info, k)) for k in fields}
    assert stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and (a.st_size == size)
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    parts = []
    total = 0
    try:
        assert stamp(a) == stamp(os.fstat(fd))
        while (piece := os.read(fd, 65536)):
            total += len(piece)
            assert total <= size
            parts.append(piece)
        b = b''.join(parts)
        assert total == size and H(b) == digest and (stamp(a) == stamp(os.fstat(fd)) == stamp(p.lstat()))
    finally:
        os.close(fd)
    authenticated[str(p)] = {'path': str(p), 'bytes': total, 'sha256': H(b), 'full9': stamp(a), 'stable_FD_path_before_after': True}
    return b
