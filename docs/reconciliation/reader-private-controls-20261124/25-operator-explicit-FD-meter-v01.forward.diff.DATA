+def source_io_read_fd(state, fd, maximum_bytes, path, kind):
+    if type(maximum_bytes)is not int or maximum_bytes<0:
+        raise RuntimeError('Source IO read bound differs')
+    source_io_admit(state,maximum_bytes+1)
