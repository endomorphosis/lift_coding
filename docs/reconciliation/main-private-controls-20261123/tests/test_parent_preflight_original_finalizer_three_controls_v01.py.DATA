"""Three fictional stdlib controls of the retained parent preflight/finalizer AST.

No module preamble, Source lease, SDK, package import or complete operator runs.
Only named actual pure helpers and the unmodified outer try/finally are compiled.
All filesystem boundaries used by those helpers/finalizer are explicit in-memory IO.
"""
import ast
import base64
import contextlib
import copy
import hashlib
import io
import json
import os
from pathlib import PurePosixPath
import stat
import sys
import traceback
import types
import unittest
import zlib

PARENT_OPERATOR_SHA256 = '087843f1f120467ac86f50dadd511d59a44629cab678c8a09fad787ce88d3516'
_EXACT_PARTS_ZLIB_BASE64 = ''
_PARTS = json.loads(zlib.decompress(base64.b64decode(_EXACT_PARTS_ZLIB_BASE64)))
_FUNCTIONS = compile(ast.parse(_PARTS['functions']), '<actual-parent-pure-helpers-AST>', 'exec')
_MAIN_TRY = compile(ast.parse(_PARTS['main_try']), '<actual-parent-outer-try-finally-AST>', 'exec')
_REPORT = compile(ast.parse(_PARTS['report_assignment']), '<actual-parent-report-assignment-AST>', 'exec')
OBSERVATIONS = {}

def install_corrected_parent_ast_for_same_controls(raw, expected_sha256):
    """Reader may bind a corrected private candidate in RAM, with the same tests."""
    global _FUNCTIONS, _MAIN_TRY, _REPORT, PARENT_OPERATOR_SHA256
    if type(raw) is not bytes or hashlib.sha256(raw).hexdigest() != expected_sha256:
        raise ValueError('exact corrected private parent bytes required')
    tree = ast.parse(raw)
    names = set(_PARTS['names'])
    functions = [copy.deepcopy(n) for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names]
    if len(functions) != len(names):
        raise ValueError('exact retained pure-helper population required')
    assignment_names = {'H', 'fields', 'f9', 'SOURCE_IO_SCOPE', 'SOURCE_IO_OUTSIDE_BOUNDARY'}
    assignments = [copy.deepcopy(n) for n in tree.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id in assignment_names for t in n.targets)]
    report = [copy.deepcopy(n) for n in tree.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'report' for t in n.targets)]
    mains = [copy.deepcopy(n) for n in tree.body if isinstance(n, ast.Try) and n.body and isinstance(n.body[0], ast.Assign) and any(isinstance(x, ast.Call) and isinstance(x.func, ast.Name) and x.func.id == 'check_known_literal_import_coverage' for x in ast.walk(n.body[0]))]
    if len(assignments) != len(assignment_names) or len(report) != 1 or len(mains) != 1:
        raise ValueError('exact parent report/outer preflight-finalizer seam required')
    _FUNCTIONS = compile(ast.fix_missing_locations(ast.Module(body=assignments + functions, type_ignores=[])), '<actual-corrected-parent-pure-helpers-AST>', 'exec')
    _MAIN_TRY = compile(ast.fix_missing_locations(ast.Module(body=mains, type_ignores=[])), '<actual-corrected-parent-outer-try-finally-AST>', 'exec')
    _REPORT = compile(ast.fix_missing_locations(ast.Module(body=report, type_ignores=[])), '<actual-corrected-parent-report-assignment-AST>', 'exec')
    PARENT_OPERATOR_SHA256 = expected_sha256

class ParentPreflightOriginalFinalizerControls(unittest.TestCase):
    def _exercise(self, kind, *, cleanup_fails=False):
        root = '/fictional/D'
        origin = root + '/pkg/owner.py'
        namespace = root + '/pkg/__init__.py'
        origin_sha = 'a' * 64
        coverage = {'project_roots': [root], 'origin_modules': [{'path': origin, 'sha256': origin_sha}], 'required_project_paths': [origin, namespace]}
        coverage_raw = json.dumps(coverage, sort_keys=True, separators=(',', ':')).encode()
        artifact_path = '/fictional/owned-control/coverage.json'
        correct_digest = hashlib.sha256(coverage_raw).hexdigest()
        ref = {'path': artifact_path, 'bytes': len(coverage_raw), 'sha256': '0' * 64 if kind == 'badSHA' else correct_digest}
        if kind == 'missingCoverage':
            ref = None
        epoch = [{'path': origin, 'sha256': origin_sha}]
        if kind != 'missingNamespace':
            epoch.append({'path': namespace, 'sha256': 'b' * 64})
        io_state = {'offset': 0, 'active_fd': False, 'opens': 0, 'closes': 0, 'cleanup_calls': 0, 'source_calls': 0, 'sdk_calls': 0, 'resource_calls': 0, 'printed': [], 'retained': {}}
        stamp = types.SimpleNamespace(st_dev=1, st_ino=2, st_mode=stat.S_IFREG | 0o400, st_nlink=1, st_uid=1000, st_gid=1000, st_size=len(coverage_raw), st_mtime_ns=111, st_ctime_ns=111)

        class FakePath(PurePosixPath):
            def lstat(self):
                if str(self) != artifact_path:
                    raise AssertionError('unexpected fictional metadata path')
                return stamp

        class FakeOS:
            path = os.path
            O_RDONLY = os.O_RDONLY
            O_NOFOLLOW = os.O_NOFOLLOW

            @staticmethod
            def open(path, flags):
                if str(path) != artifact_path or not flags & os.O_NOFOLLOW or io_state['active_fd']:
                    raise AssertionError('unexpected fictional open')
                io_state['opens'] += 1
                io_state['active_fd'] = True
                return 17

            @staticmethod
            def fstat(fd):
                if fd != 17 or not io_state['active_fd']:
                    raise AssertionError('unexpected fictional fstat')
                return stamp

            @staticmethod
            def read(fd, count):
                if fd != 17 or not io_state['active_fd']:
                    raise AssertionError('unexpected fictional read')
                offset = io_state['offset']
                value = coverage_raw[offset:offset + count]
                io_state['offset'] += len(value)
                return value

            @staticmethod
            def close(fd):
                if fd != 17 or not io_state['active_fd']:
                    raise AssertionError('unexpected fictional close')
                io_state['active_fd'] = False
                io_state['closes'] += 1

        def source_forbidden(*args, **kwargs):
            io_state['source_calls'] += 1
            raise AssertionError('Source boundary reached after a rejected preflight')

        def sdk_forbidden(*args, **kwargs):
            io_state['sdk_calls'] += 1
            raise AssertionError('SDK/import boundary reached after a rejected preflight')

        def resource_forbidden(*args, **kwargs):
            io_state['resource_calls'] += 1
            raise AssertionError('resource observation reached after a rejected preflight')

        def retain_bytes(name, raw):
            if type(raw) is not bytes or name in io_state['retained']:
                raise AssertionError('unexpected fictional report persistence')
            io_state['retained'][name] = raw
            return {'path': '/fictional/retained/' + name, 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}

        cleanup_error = OSError('fictional owned-output cleanup failure')

        def cleanup(path):
            io_state['cleanup_calls'] += 1
            if str(path) != '/fictional/owned-output/parent-home':
                raise AssertionError('cleanup outside selected fictional output')
            if cleanup_fails:
                raise cleanup_error

        authority = {'fictional_control_only': True}
        ns = {'__builtins__': __builtins__, 'Path': FakePath, 'os': FakeOS, 'stat': stat, 'hashlib': hashlib, 'json': json, 'sys': sys, 'traceback': traceback, 'contextlib': contextlib,
              'shutil': types.SimpleNamespace(rmtree=cleanup), 'source': types.SimpleNamespace(source_lease=source_forbidden, canonical_source_root=source_forbidden),
              'importlib': types.SimpleNamespace(import_module=sdk_forbidden), 'execute_phase': sdk_forbidden, 'observe_state': resource_forbidden, 'metadata_guard': source_forbidden,
              'tracked_source_read': source_forbidden, 'retain_bytes': retain_bytes, 'PARENT_HOME': FakePath('/fictional/owned-output/parent-home'),
              'ROOT_SELECTION': authority, 'FINAL_KNOWN_IMPORT_COVERAGE_REFERENCE': ref, 'FINAL_KNOWN_IMPORT_COVERAGE_PROJECT_ROOTS': [root],
              'manifest': {'known_literal_import_coverage_reference': ref}, 'EPOCH': epoch, 'PROJECTS': [{'root': root}], 'parent': None,
              'print': lambda *args, **kwargs: io_state['printed'].append((args, kwargs))}
        exec(_FUNCTIONS, ns)
        allocation = {'schema': 'Root-selected-declared-direct-Source-IO-allocation/v1', 'runtime_authority': authority, 'operation_total_bytes': 65536,
                      'role_limits': {'parent': 20000, 'collect': 20000, 'run': 20000},
                      'ledger_before': {'captures': 23, 'used': 100000, 'internal_used': 90000, 'global_cap': 1000000, 'internal_cap': 900000}, 'scope': ns['SOURCE_IO_SCOPE']}
        ns['SOURCE_IO_STATE'] = ns['source_io_start'](allocation, authority, 'parent', {'bytes': 37, 'captures': 2})
        ledger_before = copy.deepcopy(allocation['ledger_before'])
        exec(_REPORT, ns)
        caught = None
        try:
            exec(_MAIN_TRY, ns)
        except BaseException as error:
            caught = error
        report = ns['report']
        primary = ns.get('_source_io_active_primary_error')
        meter = ns['SOURCE_IO_STATE']
        expected_new_bytes = 0 if kind == 'missingCoverage' else len(coverage_raw)
        expected_new_captures = 0 if kind == 'missingCoverage' else 1
        retained = io_state['retained'].get('complete-published-D-phase2-bridge27-existing-owner-report.json')
        saved = None if retained is None else json.loads(retained)
        observation = {'fixture': kind, 'cleanup_fault_injected': cleanup_fails, 'parent_operator_sha256': PARENT_OPERATOR_SHA256,
                       'caught_type': None if caught is None else type(caught).__name__, 'primary_type': None if primary is None else type(primary).__name__,
                       'caught_is_original_primary': caught is primary, 'secondary_cleanup_error_became_primary': caught is cleanup_error,
                       'initial_bytes': 37, 'actual_meter_bytes': meter['bytes'], 'expected_meter_bytes': 37 + expected_new_bytes,
                       'initial_captures': 2, 'actual_meter_captures': meter['captures'], 'expected_meter_captures': 2 + expected_new_captures,
                       'meter_finished': meter['finished'], 'Source_sentinel_calls': io_state['source_calls'], 'SDK_sentinel_calls': io_state['sdk_calls'],
                       'resource_sentinel_calls': io_state['resource_calls'], 'fake_FDs_opened': io_state['opens'], 'fake_FDs_closed': io_state['closes'],
                       'qualification_complete': report['qualification_complete'], 'resource_cleanup_confirmed': report['resource_cleanup_confirmed'],
                       'report_saved_before_cleanup': saved is not None, 'recorded_errors': report['errors'], 'real_Source_SDK_or_full_operator_executed': False}
        OBSERVATIONS[kind] = observation
        self.assertIsNotNone(caught)
        self.assertIsNotNone(primary)
        self.assertIs(meter['finished'], True)
        self.assertEqual(meter['bytes'], 37 + expected_new_bytes)
        self.assertEqual(meter['captures'], 2 + expected_new_captures)
        self.assertEqual(allocation['ledger_before'], ledger_before)
        self.assertEqual((io_state['source_calls'], io_state['sdk_calls'], io_state['resource_calls']), (0, 0, 0))
        self.assertFalse(io_state['active_fd'])
        self.assertEqual(io_state['opens'], io_state['closes'])
        self.assertIs(report['qualification_complete'], False)
        self.assertIs(report['software_sequence_accepted'], False)
        self.assertEqual(report['phase_order'], [])
        self.assertEqual(report['phases'], {})
        self.assertTrue(report['errors'])
        self.assertEqual(report['errors'][0]['type'], type(primary).__name__)
        self.assertIsNotNone(saved)
        self.assertEqual(saved['declared_direct_Source_IO_parent']['bytes'], meter['bytes'])
        self.assertEqual(saved['declared_direct_Source_IO_parent']['captures'], meter['captures'])
        self.assertIs(saved['qualification_complete'], False)
        # A secondary output-cleanup failure must not replace the actual preflight error.
        self.assertIs(caught, primary)
        frames = []
        tb = caught.__traceback__
        while tb is not None:
            frames.append(tb.tb_frame.f_code.co_name)
            tb = tb.tb_next
        self.assertIn('check_known_literal_import_coverage', frames)

    def test_missing_coverage_reaches_original_finalizer_without_Source_or_SDK(self):
        self._exercise('missingCoverage')

    def test_bad_SHA_keeps_read_charge_and_primary_error_if_output_cleanup_fails(self):
        self._exercise('badSHA', cleanup_fails=True)

    def test_missing_namespace_reaches_original_finalizer_without_dispatch(self):
        self._exercise('missingNamespace')

if __name__ == '__main__':
    import resource
    import signal
    resource.setrlimit(resource.RLIMIT_CPU, (30, 30))
    resource.setrlimit(resource.RLIMIT_AS, (512 * 1024**2, 512 * 1024**2))
    if hasattr(os, 'sched_getaffinity'):
        os.sched_setaffinity(0, {min(os.sched_getaffinity(0))})
    signal.alarm(60)
    capture = io.StringIO()
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(ParentPreflightOriginalFinalizerControls)
    result = unittest.TextTestRunner(stream=capture, verbosity=2).run(suite)
    payload = {'schema': 'actual-private-parent-preflight-original-finalizer-three-controls/v1', 'parent_operator_sha256': PARENT_OPERATOR_SHA256,
               'tests': result.testsRun, 'failures': len(result.failures), 'errors': len(result.errors), 'skipped': len(result.skipped),
               'passed': result.testsRun - len(result.failures) - len(result.errors) - len(result.skipped), 'observations': OBSERVATIONS,
               'unittest_output': capture.getvalue(), 'scope': 'Exact retained parent outer try/finally and pure helpers with explicit fictional IO; no full operator/Source/SDK/package/native or current-runtime qualification.'}
    raw = (json.dumps(payload, indent=2) + '\n').encode()
    fd = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o400)
    try:
        remain = memoryview(raw)
        while remain:
            n = os.write(fd, remain)
            assert n > 0
            remain = remain[n:]
        os.fsync(fd)
    finally:
        os.close(fd)
    print(json.dumps({'path': sys.argv[1], 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest(), 'tests': payload['tests'],
                      'passed': payload['passed'], 'failures': payload['failures'], 'errors': payload['errors'], 'skipped': payload['skipped'],
                      'observations': OBSERVATIONS}))
    raise SystemExit(0 if result.wasSuccessful() else 1)
