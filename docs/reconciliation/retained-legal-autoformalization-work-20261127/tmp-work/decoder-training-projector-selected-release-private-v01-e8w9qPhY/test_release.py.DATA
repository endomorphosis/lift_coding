"""Exercise the selected release issuer and reader using retained modeled owners."""

from dataclasses import replace
from hashlib import sha256
import json
import os
from os.path import isabs
from pathlib import Path
from tempfile import TemporaryDirectory
import unittest


HERE = Path(__file__).resolve().parent
OLD = HERE.parent / "decoder-training-qwen-projector-release-slot-private-v01-OR9N19LA"
LAUNCHER = HERE / "launcher.py.DATA"
ASSESSMENT = HERE / "relational_assessment.py"
CLIPATH = OLD / "run_incremental_autoencoders.py.DATA"
TRIAL = HERE.parent / "decoder-training-shared-trial-companion-private-v01-CxWQ8SRT/relational_trial.py"
TEACHER = (HERE.parent / "decoder-training-projector-request-paid-join-private-v01-OXrJ2XDz/stage/"
           "ipfs_datasets_py/optimizers/logic_theorem_optimizer/teacher_prefix.py")
REPORT = {}


def exact(path, pin):
    raw = path.read_bytes()
    assert sha256(raw).hexdigest() == pin, path
    return raw


def substitute(body, before, after):
    assert body.count(before) == 1, before
    return body.replace(before, after)


raw = exact(OLD / "test_release.py", "5b70123a6ebde006d71054b7ffa34397ed02a9646498a31950a2b32761973723")
exact(CLIPATH, "b0bc92bdf9d0670376d8c4c43f3b0fd36e3f98e402a257b28aae819042d65a2b")
exact(TRIAL, "be4488a3e1d17f221a76082e8cd2696be134b73863e8aaf68ff2ce939851aa28")
exact(TEACHER, "b7e46d7f5df3783cb2904a67cacc3273d5e82e987d1740afb085c3a76a97f5cd")
raw = substitute(raw, b"POST = HERE / 'autoencoder_inference.py.DATA'", b"POST = LAUNCHER_PATH")
raw = substitute(raw, b"cli = extracted(HERE/'run_incremental_autoencoders.py.DATA'", b"cli = extracted(OLD_CLI")
raw = substitute(raw, b"reader=extracted(HERE/'relational_assessment.py.DATA'", b"reader=extracted(PAID_READER")
raw = substitute(raw,
    b"assert options['owner'] is owner and options['qwen2_projector_guard']('prelaunch',f.ref['sha256'],f.request['qwen2_projector_arm']['custody'])",
    b"assert options['owner'] is owner\n                approve_fixture(options['qwen2_projector_guard'], f.ref, f.request)")


def approve_fixture(guard, reference, request):
    confirm, complete = parent_checks._qwen2_projector_parent_checks(request, reference["sha256"], guard)
    for stage in ("selection", "prefill"):
        confirm({"schema": "reviewed-qwen2-projector-parent-check/v1", "stage": stage,
                 "custody": request["qwen2_projector_arm"]["custody"]})
    assert complete()


fixture = {"__name__": "retained_modeled_release", "__file__": str(HERE / "test_release.py"),
           "OLD_CLI": CLIPATH, "LAUNCHER_PATH": LAUNCHER, "PAID_READER": ASSESSMENT,
           "approve_fixture": approve_fixture}
exec(compile(raw, str(OLD / "test_release.py"), "exec"), fixture)
extract = fixture["extracted"]
teacher = extract(TEACHER, {"_need", "_pin", "_sha", "_wire", "_commit"}, {"json": json, "sha256": sha256})
artifact = extract(TRIAL, {"_artifact"}, {"isabs": isabs, "_pin": teacher._pin})
parent_checks = extract(LAUNCHER, {"_qwen2_projector_parent_checks"},
                        {"_QWEN2_PROJECTOR_ACK_SCHEMA": "reviewed-qwen2-projector-parent-check/v1"})
reader = extract(ASSESSMENT, {"_qwen2_projector_released_parent"},
                 {"_need": teacher._need, "_pin": teacher._pin, "_commit": teacher._commit,
                  "_artifact": artifact._artifact, "json": json})._qwen2_projector_released_parent


class SelectedReleaseControls(unittest.TestCase):
    def setUp(self):
        root = Path(self.enterContext(TemporaryDirectory(dir=HERE, prefix="modeled-release-"))) / "attempt"
        root.mkdir()
        base = fixture["ReleaseControls"]()
        self.f = base.fixture(root)
        self.profile = self.f.runtime.qwen2_projector_release
        self.request = self.f.cfg["reviewed_evaluation_request"]["sha256"]
        self.epoch = self.profile.source_epoch_sha256
        self.approved = {"request_sha256": self.request, "source_epoch_sha256": self.epoch}

    def launch(self, **changes):
        def verify_launch(request, epoch):
            self.f.log.append(("launch-selection", request, epoch))
            return (request, epoch) == (self.request, self.epoch)

        def verify_projector(stage, request, custody):
            self.f.log.append(("projector", stage, request, custody["role"]))
            return request == self.request

        settings = {"expected_request_sha256": self.request, "verify_projector_launch": verify_launch,
                    "verify_projector": verify_projector} | changes
        profile = replace(self.profile, **settings)
        return self.f.cli.supervised_cycle(self.f.cfg, reviewed_parent_runtime=replace(
            self.f.runtime, qwen2_projector_release=profile))

    def released(self, **changes):
        result = self.launch(**changes)
        ref = fixture["Artifact"].from_dict(result["direct_projector_release_artifact"])
        raw = fixture["read"](ref, limit=65536)
        parent = self.f.parent
        captured = {name + ".json": value for name, value in parent["output_artifacts"].items()}
        captured["cycle.json"] = parent["child_cycle_artifact"]
        parent_raw = fixture["wire"](parent)
        captured["parent-cycle.json"] = {"bytes": len(parent_raw), "sha256": teacher._sha(parent_raw)}
        offered = self.f.cfg["reviewed_evaluation_request"]
        captured["reviewed-evaluation-request.json"] = {key: offered[key] for key in ("bytes", "sha256")}
        self.reader_inputs = {"captured": captured, "reservation_id": self.f.owner.reservation_id,
                              "child": self.f.owner.child, "owner_pid": os.getpid()}
        self.assertEqual(result["parent_cycle"], parent)
        return raw

    def read(self, raw, **changes):
        expected = {"expected_prelaunch_request_sha256": self.request,
                    "expected_source_epoch_sha256": self.epoch} | changes
        return reader(raw, **self.reader_inputs, **expected)

    def assert_no_entry(self, expected_log):
        self.assertEqual(self.f.log, expected_log)
        self.assertFalse(self.f.active)
        self.assertFalse(self.f.release_path.exists())
        self.assertFalse(self.f.release_path.with_name(self.f.release_path.name + ".pending").exists())

    def test_selected_v3_emitted_by_original_owner_and_read_by_original_reader(self):
        raw = self.released()
        decoded = json.loads(raw)
        self.assertEqual(decoded["schema"], "reviewed-qwen2-projector-direct-owner-release/v3")
        self.assertEqual(decoded["launch_selection"], self.approved)
        self.assertEqual(self.read(raw), "same-original-lease")
        self.assertEqual(self.f.log[0], ("launch-selection", self.request, self.epoch))
        self.assertEqual([row[1:3] for row in self.f.log if row[0] == "projector"],
                         [(stage, self.request) for stage in ("prelaunch", "selection", "prefill")])
        self.assertEqual(self.f.log[-4:], ["owner-exit", ("exit", "/fictional/z"),
                                          ("exit", "/fictional/a"), ("inspect", True)])
        self.assertFalse(self.f.active)
        REPORT.update(issued_release_sha256=teacher._sha(raw), launch_selection=self.approved,
                      modeled_source_and_daemon=True, actual_model_processes=0,
                      tested_original_approval_stages=["prelaunch", "selection", "prefill"])

    def test_wrong_epoch_is_refused_before_source_or_resource(self):
        other = "1" * 64
        with self.assertRaisesRegex(ValueError, "owner refused the selected request and Source epoch"):
            self.launch(source_epoch_sha256=other)
        self.assert_no_entry([("launch-selection", self.request, other)])

    def test_wrong_request_is_refused_before_source_or_authority(self):
        with self.assertRaisesRegex(ValueError, "differs from the independently selected request"):
            self.launch(expected_request_sha256="1" * 64)
        self.assert_no_entry([])

    def test_refused_or_nonboolean_approval_has_no_effects(self):
        for decision in (False, 1):
            calls = []

            def refuse(*pair):
                calls.append(pair)
                return decision

            with self.subTest(decision=decision), self.assertRaisesRegex(ValueError, "owner refused"):
                self.launch(verify_projector_launch=refuse)
            self.assertEqual(calls, [(self.request, self.epoch)])
            self.assert_no_entry([])

    def test_missing_request_pin_or_invalid_guard_refuses_before_entry(self):
        for changes in ({"expected_request_sha256": None}, {"verify_projector_launch": True}):
            with self.subTest(changes=changes), self.assertRaisesRegex(ValueError, "owner refused"):
                self.launch(**changes)
            self.assert_no_entry([])

    def test_legacy_v2_remains_valid_but_cannot_supply_selected_authority(self):
        raw = self.released(verify_projector_launch=None)
        decoded = json.loads(raw)
        self.assertEqual(decoded["schema"], "reviewed-qwen2-projector-direct-owner-release/v2")
        self.assertNotIn("launch_selection", decoded)
        self.assertEqual(self.read(raw, expected_prelaunch_request_sha256=None), "same-original-lease")
        with self.assertRaisesRegex(ValueError, "prelaunch-bound release required"):
            self.read(raw)

    def test_marker_substitutions_and_missing_marker_refuse(self):
        raw = self.released()
        for field in ("request_sha256", "source_epoch_sha256", "unexpected", None):
            doc = json.loads(raw)
            if field is None:
                del doc["launch_selection"]
            else:
                doc["launch_selection"][field] = "1" * 64
            with self.subTest(field=field), self.assertRaisesRegex(ValueError, "prelaunch selection differs"):
                self.read(fixture["wire"](doc))

    def test_self_consistent_replaced_fence_differs_from_independent_epoch(self):
        doc = json.loads(self.released())
        other = {"rows": ["different modeled Source epoch"]}
        for field in ("source_before", "source_after_run", "source_after"):
            doc[field] = other
        doc["launch_selection"]["source_epoch_sha256"] = teacher._commit(other)
        with self.assertRaisesRegex(ValueError, "Source fence differs from the selected request epoch"):
            self.read(fixture["wire"](doc))

    def test_strict_readback_requires_both_selected_values(self):
        raw = self.released()
        for changes in ({"expected_source_epoch_sha256": None}, {"expected_prelaunch_request_sha256": "1" * 64}):
            with self.subTest(changes=changes), self.assertRaisesRegex(ValueError, "prelaunch-bound release required"):
                self.read(raw, **changes)

    def test_selected_version_still_requires_exact_scheduler_inspection(self):
        doc = json.loads(self.released())
        doc["resource_after_parent_release"]["expected_request_id"] = "a different reservation"
        with self.assertRaisesRegex(ValueError, "exact released Qwen2 lease"):
            self.read(fixture["wire"](doc))


if __name__ == "__main__":
    result = unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(SelectedReleaseControls))
    if result.wasSuccessful():
        print(json.dumps(REPORT, sort_keys=True))
    raise SystemExit(not result.wasSuccessful())
