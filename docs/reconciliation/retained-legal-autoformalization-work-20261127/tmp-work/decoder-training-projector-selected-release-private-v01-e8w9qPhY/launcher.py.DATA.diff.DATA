+        launch_selection = {"request_sha256": expected, "source_epoch_sha256": profile.source_epoch_sha256}
     roots = tuple(sorted(str(canonical_source_root(root)) for root in profile.source_roots))
     if len(set(roots)) != len(roots) or set(roots) != set(profile.source_roots):
         raise ValueError("exact original canonical Qwen2 Source roots required")
@@ -1678,6 +1685,9 @@
               "source_after_run": worker._parse_json(after_run), "source_after": worker._parse_json(closing),
               "actual_parent_lease": lease, "actual_reservation_finalized": released,
               "resource_after_parent_release": absent, "retained_artifacts": retained}
+    if launch_selection is not None:
+        report["schema"] = "reviewed-qwen2-projector-direct-owner-release/v3"
