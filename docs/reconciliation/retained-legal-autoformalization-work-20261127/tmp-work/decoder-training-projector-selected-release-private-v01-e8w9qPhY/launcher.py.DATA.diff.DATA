 def _reviewed_projector_source_bytes(profile, guard, worker):
@@ -1569,6 +1570,12 @@
     if expected is not None and (type(expected) is not str or expected != selected.sha256):
         raise ValueError("configured Qwen2 projector request differs from the independently selected request")
     config["reviewed_evaluation_request"] = {"path": selected.path, "sha256": selected.sha256, "bytes": selected.bytes}
+    launch_selection = None
