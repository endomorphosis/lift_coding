def _strict_audit_modules():
    result = []
    for name in module_order:
        mod = sys.modules.get(name)
        if mod is not loaded.get(name) or mod is None:
            raise RuntimeError('existing-name module object was replaced: ' + name)
        path = bound_paths[name]
        if Path(mod.__file__).resolve(strict=True) != path or Path(mod.__spec__.origin).resolve(strict=True) != path or mod.__spec__.name != name:
            raise RuntimeError('module physical origin was retagged: ' + name)
        parent_name, attribute = name.rsplit('.', 1)
        if getattr(sys.modules[parent_name], attribute) is not mod:
            raise RuntimeError('parent-package alias differs: ' + name)
        result.append(body_identity(name))
    return result

def preload_maintained_owners():
    for name in maintained_owner_names:
        if name not in _lazy_owner_names:
            loaded[name] = importlib.import_module(name)

def audit_modules(stage='collection'):
    if not _lazy_owner_names:
        return _strict_audit_modules()
    if stage not in ('initial', 'collection', 'run_terminal'):
        raise RuntimeError('unknown maintained-owner audit stage')
    result = []
    for name in module_order:
        identity = body_identity(name)
        mod = sys.modules.get(name)
        lazy = name in _lazy_owner_names
        if lazy and mod is None:
            if stage == 'run_terminal' or name in loaded:
                raise RuntimeError('required lazy owner absent or disappeared: ' + name)
            result.append(dict(identity, status='not_loaded', compiled_SHA256=None))
            continue
        if mod is None or (name in loaded and mod is not loaded[name]) or (not lazy and mod is not loaded.get(name)):
            raise RuntimeError('existing-name module object was replaced: ' + name)
        path = bound_paths[name]
        if Path(mod.__file__).resolve(strict=True) != path or Path(mod.__spec__.origin).resolve(strict=True) != path or mod.__spec__.name != name:
            raise RuntimeError('module physical origin was retagged: ' + name)
        parent_name, attribute = name.rsplit('.', 1)
        if getattr(sys.modules[parent_name], attribute) is not mod:
            raise RuntimeError('parent-package alias differs: ' + name)
        if lazy:
            if compiled.get(str(path)) != modules[name]['sha256']:
                raise RuntimeError('lazy owner exact Source compilation was not observed: ' + name)
            loaded.setdefault(name, mod)
            identity.update(status='loaded', compiled_SHA256=compiled[str(path)])
        result.append(identity)
    return result

def owner_origins(stage='collection'):
    audit_modules(stage)
    result = {}
    for name in maintained_owner_names:
        path = str(bound_paths[name])
        mod = sys.modules.get(name)
        if name in _lazy_owner_names and mod is None:
            result[name] = dict(status='not_loaded', path=path, spec_origin=None, compiled_SHA256=None)
            continue
        if compiled.get(path) != modules[name]['sha256']:
            raise RuntimeError('maintained owner compilation was not observed: ' + name)
        row = dict(path=path, spec_origin=str(Path(mod.__spec__.origin).resolve()), compiled_SHA256=compiled[path])
        if name in _lazy_owner_names:
            row['status'] = 'loaded'
        result[name] = row
    return result
