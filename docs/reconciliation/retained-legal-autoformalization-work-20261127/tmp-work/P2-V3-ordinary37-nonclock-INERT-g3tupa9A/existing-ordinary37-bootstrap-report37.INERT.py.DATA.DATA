def normal_guarded_source_code(loader, name):
    path = Path(loader.path).resolve()
    if path.is_relative_to(root) or path.is_relative_to(accelerate):
        row = epoch.get(str(path))
        if row is None:
            raise RuntimeError('unlisted actual Source import: ' + str(path))
        before = path.lstat()
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or f9(before) != f9(os.fstat(fd)):
                raise RuntimeError('actual Source identity differs')
            raw = bytearray()
            while (piece := os.read(fd, 1024 ** 2)):
                raw.extend(piece)
                if len(raw) > row['bytes']:
                    raise RuntimeError('Source byte bound changed')
            if f9(before) != f9(os.fstat(fd)) or f9(before) != f9(path.lstat()) or f9(before) != row['full9']:
                raise RuntimeError('actual Source metadata differs')
        finally:
            os.close(fd)
        raw = bytes(raw)
        if len(raw) != row['bytes'] or hashlib.sha256(raw).hexdigest() != row['sha256']:
            raise RuntimeError('actual Source bytes differ')
        compiled[str(path)] = row['sha256']
        return loader.source_to_code(raw, str(path))
    return original_source_loader(loader, name)

class SelectedTestRewriteObserver:

    def __init__(self, rewrite_module, specs, read_exact, authenticated):
        self.module = rewrite_module
        self.specs = specs
        self.read_exact = read_exact
        self.authenticated = authenticated
        self.events = {}
        self.code_records = {}
        self.cache_bypasses = {path: 0 for path in specs}
        self.installed = False

    def install(self):
        module = self.module
        assert isinstance(module.AssertionRewritingHook, type) and callable(module._rewrite_test) and callable(module._read_pyc)
        self.original_rewrite = module._rewrite_test
        self.original_read_pyc = module._read_pyc
        self.had_exec = 'exec' in vars(module)
        self.original_exec = vars(module).get('exec', __import__('builtins').exec)
        self.original_ast = module.ast
        self.had_compile = 'compile' in vars(module)
        self.original_compile = vars(module).get('compile', __import__('builtins').compile)
        module._rewrite_test = self.rewrite_test
        module._read_pyc = self.read_pyc
        module.exec = self.exec_code
        self.installed = True
        return self

    def selected_path(self, value):
        try:
            path = str(Path(value).resolve())
        except (TypeError, ValueError, OSError):
            return None
        return path if path in self.specs else None

    def read_pyc(self, *args, **kwargs):
        source = args[0] if args else kwargs.get('source')
        path = self.selected_path(source)
        if path is not None:
            self.cache_bypasses[path] += 1
            return None
        return self.original_read_pyc(*args, **kwargs)

    def rewrite_test(self, *args, **kwargs):
        filename = args[0] if args else kwargs.get('fn')
        path = self.selected_path(filename)
        if path is None:
            return self.original_rewrite(*args, **kwargs)
        assert path not in self.events, 'selected test was rewritten more than once'
        spec = self.specs[path]
        raw = self.read_exact(path, spec['bytes'], spec['sha256'])
        before = dict(self.authenticated[path])
        assert before['full9'] == spec['full9']
        actual_source_sha = __import__('hashlib').sha256(raw).hexdigest()
        event = {'schema': 'actual-selected-test-source-AST-code-witness/v1', 'path': path, 'source_bytes': len(raw), 'source_sha256': actual_source_sha, 'source_before': before, 'source_to_AST_observed': False, 'AST_to_code_observed': False, 'returned_code_identity_matches': False, 'code_execution_observed': False, 'code_filename': None, 'code_sha256': None, 'compile_source_sha256': None, 'compile_source_full9': None, 'cache_policy': 'bypass-read-only-for-selected-owning-test'}
        parsed = {}
        compiled = {}
        observer = self

        class AstProxy:

            def __getattr__(self, name):
                return getattr(observer.original_ast, name)

            def parse(self, source, *parse_args, **parse_kwargs):
                selected_filename = parse_kwargs.get('filename', parse_args[0] if parse_args else '<unknown>')
                if str(selected_filename) != path:
                    return observer.original_ast.parse(source, *parse_args, **parse_kwargs)
                assert type(source) is bytes and source == raw, 'pytest parsed bytes must equal the authenticated source bytes'
                tree = observer.original_ast.parse(source, *parse_args, **parse_kwargs)
                assert not parsed
                parsed['tree'] = tree
                event['source_to_AST_observed'] = True
                return tree

        def compile_code(source, filename, mode, *compile_args, **compile_kwargs):
            if str(filename) != path:
                return observer.original_compile(source, filename, mode, *compile_args, **compile_kwargs)
            assert parsed and source is parsed['tree'] and (mode == 'exec') and (not compiled), 'pytest must compile the observed rewritten AST'
            code = observer.original_compile(source, filename, mode, *compile_args, **compile_kwargs)
            assert code.co_filename == path
            compiled['code'] = code
            event['AST_to_code_observed'] = True
            event['code_filename'] = code.co_filename
            event['code_sha256'] = __import__('hashlib').sha256(__import__('marshal').dumps(code)).hexdigest()
            event['compile_source_sha256'] = actual_source_sha
            event['compile_source_full9'] = before['full9']
            return code
        self.module.ast = AstProxy()
        self.module.compile = compile_code
        try:
            result = self.original_rewrite(*args, **kwargs)
            assert type(result) is tuple and len(result) == 2 and compiled and (result[1] is compiled['code']), 'rewrite hook must return the actually observed code object'
            self.read_exact(path, spec['bytes'], spec['sha256'])
            after = dict(self.authenticated[path])
            assert before == after
            event['source_after'] = after
            event['returned_code_identity_matches'] = True
            self.events[path] = event
            self.code_records[id(result[1])] = (result[1], event)
            return result
        finally:
            self.module.ast = self.original_ast
            if self.had_compile:
                self.module.compile = self.original_compile
            else:
                vars(self.module).pop('compile', None)

    def exec_code(self, code, *args, **kwargs):
        if kwargs or len(args) not in (1, 2) or type(args[0]) is not dict:
            raise RuntimeError('pytest rewrite exec requires explicit positional globals dictionary')
        if len(args) == 2 and args[1] is not None and (type(args[1]) is not dict):
            raise RuntimeError('pytest rewrite exec locals scope is unsupported')
        pair = self.code_records.get(id(code))
        if pair is None:
            return self.original_exec(code, *args, **kwargs)
        assert pair[0] is code
        namespace = args[0] if args else kwargs.get('globals')
        assert type(namespace) is dict and str(Path(namespace['__file__']).resolve()) == pair[1]['path']
        result = self.original_exec(code, *args, **kwargs)
        pair[1]['code_execution_observed'] = True
        return result

    def witness(self, path):
        assert path in self.events, 'no source-coupled selected-test rewrite event'
        event = dict(self.events[path])
        event['selected_cache_reads_bypassed'] = self.cache_bypasses[path]
        assert event['source_to_AST_observed'] is True and event['AST_to_code_observed'] is True and (event['returned_code_identity_matches'] is True) and (event['code_execution_observed'] is True) and (event['selected_cache_reads_bypassed'] >= 1)
        return event

    def restore(self):
        if not self.installed:
            return True
        self.module._rewrite_test = self.original_rewrite
        self.module._read_pyc = self.original_read_pyc
        self.module.ast = self.original_ast
        if self.had_exec:
            self.module.exec = self.original_exec
        else:
            vars(self.module).pop('exec', None)
        if self.had_compile:
            self.module.compile = self.original_compile
        else:
            vars(self.module).pop('compile', None)
        self.installed = False
        return self.module._rewrite_test is self.original_rewrite and self.module._read_pyc is self.original_read_pyc and (self.module.ast is self.original_ast)
prefix = str(root) + '/'

def normalized(value):
    return value[len(prefix):] if value.startswith(prefix) else value
called = []
terminal_reports = []
rewrite_observer = None

class BindingEvidence:

    def pytest_collection_finish(self, session):
        roster = [normalized(item.nodeid) for item in session.items]
        counts = {}
        pairs = []
        for item, nodeid in zip(session.items, roster, strict=True):
            base = nodeid.split('[', 1)[0]
            counts[base] = counts.get(base, 0) + 1
            relative = nodeid.split('::', 1)[0]
            selected_test_name = expected_test_modules.get(relative)
            if selected_test_name is None:
                raise pytest.UsageError('pytest selected a foreign owning module')
            module = item.module
            if selected_test_name in loaded and loaded[selected_test_name] is not module:
                raise pytest.UsageError('selected module object changed')
            loaded[selected_test_name] = module
            function = getattr(item.obj, '__func__', item.obj)
            if sys.modules.get(selected_test_name) is not module or function.__globals__ is not module.__dict__:
                raise pytest.UsageError('collected function globals differ from owning module')
            left, *tail = nodeid.split('::')
            pairs.append([left[:-3].replace('/', '.') + ('.' + '.'.join(tail[:-1]) if len(tail) > 1 else ''), tail[-1]])
        report['actual_collected_roster'] = roster
        report['actual_function_case_counts'] = counts
        report['junit_expected_pairs'] = pairs
        if len(roster) != EXPECTED_CASES or len(set(roster)) != len(roster) or counts != expected_counts or ({node.split('::', 1)[0] for node in roster} != set(owning_files)):
            raise pytest.UsageError('empty, duplicated, foreign or wrong-count collection')
        if operation == 'run' and roster != request['actual_collected_roster']:
            raise pytest.UsageError('RUN roster differs from genuine expanded COLLECT order')
        report['collection_module_bindings'] = audit_modules()
        report['loaded_bindings'] = audit_modules()
        actual_conftests = sorted({str(Path(plugin.__file__).resolve()) for _, plugin in session.config.pluginmanager.list_name_plugin() if getattr(plugin, '__file__', None) and Path(plugin.__file__).name == 'conftest.py'})
        report['actual_conftest_paths'] = actual_conftests
        required = request['required_canonical_conftests']
        if type(required) is not list or not required or set(required) != set(actual_conftests):
            raise pytest.UsageError('normal D conftest closure was not loaded')
        report['actual_inifile'] = str(session.config.inipath)
        if report['actual_inifile'] != str(pytest_inifile):
            raise pytest.UsageError('normal D pytest.ini differs')
        report['actual_normal_config_confcutdir'] = session.config.getoption('confcutdir', default=None)
        report['collection_configuration_bindings'] = audit_configuration()
        if _lazy_owner_names:
            report['actual_maintained_owner_origins'] = owner_origins('collection')
        else:
            report['actual_maintained_owner_origins'] = {}
            for name in maintained_owner_names:
                module = loaded[name]
                path = str(bound_paths[name])
                if compiled.get(path) != modules[name]['sha256']:
                    raise pytest.UsageError('maintained owner compilation was not observed')
                report['actual_maintained_owner_origins'][name] = {'path': path, 'spec_origin': str(Path(module.__spec__.origin).resolve()), 'compiled_SHA256': compiled[path]}
        report['actual_test_module_origins'] = {}
        report['actual_test_item_origins'] = []
        report['actual_test_rewrite_source_to_code'] = {}
        for item, nodeid in zip(session.items, roster, strict=True):
            relative = nodeid.split('::', 1)[0]
            name = expected_test_modules[relative]
            path = str(bound_paths[name])
            row = modules[name]
            module = item.module
            exact(path, row['bytes'], row['sha256'])
            source_before = dict(authenticated[path])
            if source_before['full9'] != row['full9']:
                raise pytest.UsageError('owning-test source metadata differs')
            module_loader = getattr(module, '__loader__', None)
            spec_loader = getattr(module.__spec__, 'loader', None)
            if not isinstance(module_loader, pytest_rewrite.AssertionRewritingHook) or module_loader is not spec_loader:
                raise pytest.UsageError('actual owning-test pytest rewrite loader required')
            witness = rewrite_observer.witness(path)
            if witness['compile_source_sha256'] != row['sha256'] or witness['compile_source_full9'] != row['full9']:
                raise pytest.UsageError('source-coupled owning-test compilation differs')
            function = getattr(item.obj, '__func__', item.obj)
            code_object = getattr(function, '__code__', None)
            if code_object is None or str(Path(code_object.co_filename).resolve()) != path:
                raise pytest.UsageError('selected item code filename differs')
            exact(path, row['bytes'], row['sha256'])
            source_after = dict(authenticated[path])
            if source_before != source_after:
                raise pytest.UsageError('owning-test source changed during item binding')
            loader_name = type(module_loader).__module__ + '.' + type(module_loader).__qualname__
            spec_loader_name = type(spec_loader).__module__ + '.' + type(spec_loader).__qualname__
            common = dict(path=path, spec_origin=path, loader_type=loader_name, spec_loader_type=spec_loader_name, rewritten_test_compiled_SHA256=witness['compile_source_sha256'], rewritten_test_compiled_SHA_observed=True, actual_rewrite_witness=witness)
            report['actual_test_module_origins'][path] = dict(common, name=module.__name__, source_sha256=row['sha256'], source_full9=source_after['full9'])
            report['actual_test_item_origins'].append(dict(common, nodeid=nodeid, module_origin=path, item_code_filename=str(Path(code_object.co_filename).resolve()), source_before=source_before, source_after=source_after))
            report['actual_test_rewrite_source_to_code'][path] = witness
        test_paths = {str(bound_paths[name]) for name in test_names}
        if set(report['actual_test_module_origins']) != test_paths or [row['nodeid'] for row in report['actual_test_item_origins']] != roster:
            raise pytest.UsageError('incomplete selected-test witness population')
        report['collection_accepted'] = True

    def pytest_runtest_call(self, item):
        selected_test_name = expected_test_modules.get(normalized(item.nodeid).split('::', 1)[0])
        function = getattr(item.obj, '__func__', item.obj)
        if selected_test_name is None or item.module is not loaded[selected_test_name] or function.__globals__ is not loaded[selected_test_name].__dict__:
            raise pytest.UsageError('run item does not use actual owning code')
        called.append(normalized(item.nodeid))

    def pytest_runtest_logreport(self, report):
        if report.when == 'call':
            if type(report) is not pytest.TestReport and (not isinstance(report, pytest.SubtestReport)):
                raise RuntimeError('unknown public pytest report kind')
            terminal_reports.append(dict(nodeid=normalized(report.nodeid), outcome=report.outcome, is_subtest=isinstance(report, pytest.SubtestReport)))

    def pytest_sessionfinish(self, session, exitstatus):
        report['actual_called_roster'] = list(called)
        report['actual_terminal_call_reports'] = list(terminal_reports)
        if operation == 'run' and int(exitstatus) == 0:
            if called != request['actual_collected_roster'] or len(called) != len(set(called)) or (not terminal_reports) or any((type(row['is_subtest']) is not bool or row['nodeid'] not in called or row['outcome'] != 'passed' for row in terminal_reports)) or ([row['nodeid'] for row in terminal_reports if not row['is_subtest']] != called):
                raise pytest.UsageError('successful owning-file run did not execute every retained selected call')
code = 1
os.environ['IPFS_TEST_PROOF_REUSE_MODE'] = 'off'
sys.path.insert(0, str(accelerate))
sys.path.insert(0, str(root))
report['initial_body_bindings'] = [body_identity(name) for name in modules]
report['initial_configuration_bindings'] = audit_configuration()
importlib.machinery.SourceFileLoader.get_code = normal_guarded_source_code
try:
    preload_maintained_owners()
    if any((name in sys.modules for name in test_names)):
        raise RuntimeError('owning tests imported before genuine pytest rewrite observer')
    import pytest
    import _pytest.assertion.rewrite as pytest_rewrite
    selected_test_specs = {str(bound_paths[name]): dict(bytes=modules[name]['bytes'], sha256=modules[name]['sha256'], full9=modules[name]['full9']) for name in test_names}
    rewrite_observer = SelectedTestRewriteObserver(pytest_rewrite, selected_test_specs, exact, authenticated).install()
    argv = ['-c', str(pytest_inifile), '--rootdir', str(root), '--import-mode=importlib', '--showlocals', '-o', 'cache_dir=' + str(workspace / 'pytest-cache'), '-o', 'tmp_path_retention_policy=all', '--basetemp', str(workspace / 'pytest')] + [str(root / selector) for selector in selected]
    if operation == 'collect':
        argv += ['--collect-only', '-q', '-q']
    else:
        argv += ['--junitxml', str(workspace / 'junit.xml')]
    report['pytest_argv'] = argv
    code = pytest.main(argv, plugins=[BindingEvidence()])
    report['pytest_exit_code'] = int(code)
    report['closing_module_bindings'] = audit_modules('run_terminal' if operation == 'run' else 'collection')
    if _lazy_owner_names:
        report['actual_terminal_maintained_owner_origins'] = owner_origins('run_terminal' if operation == 'run' else 'collection')
    report['closing_configuration_bindings'] = audit_configuration()
finally:
    report['normal_pytest_rewrite_observer_restored'] = True if rewrite_observer is None else rewrite_observer.restore()
    importlib.machinery.SourceFileLoader.get_code = original_source_loader
    report['normal_Source_loader_restored'] = importlib.machinery.SourceFileLoader.get_code is original_source_loader
    report['entry_meta_path_mutations'] = 0
    report['normal_import_meta_path_types_before'] = [type(x).__module__ + '.' + type(x).__qualname__ for x in original_meta_path]
    report['normal_import_meta_path_types_after'] = [type(x).__module__ + '.' + type(x).__qualname__ for x in sys.meta_path]
    report['actual_compiled_current_Source'] = compiled
    report['actual_compiled_owner_SHA256'] = compiled
    raw = json.dumps(report, sort_keys=True, separators=(',', ':')).encode()
    descriptor = os.open(workspace / 'binding.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 384)
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
