def metadata_guard():
    for path in ABSENT_PATHS:
        assert not os.path.lexists(path), ('declared namespace absence changed', path)
    out = []
    for row in EPOCH:
        p = Path(row['path'])
        a = os.lstat(p)
        assert stat.S_ISREG(a.st_mode) and a.st_nlink == 1
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            assert f9(a) == f9(os.fstat(fd)) == f9(os.lstat(p)) == row['full9'], ('source metadata drift', str(p))
        finally:
            os.close(fd)
        out.append({'path': str(p), 'bytes': row['bytes'], 'sha256': row['sha256'], 'full9': f9(a)})
    heads = {}
    for project in PROJECTS:
        git = subprocess.run(['/usr/bin/git', '-C', project['root'], 'rev-parse', 'HEAD'], capture_output=True, text=True, timeout=10, check=True).stdout.strip()
        assert git == project['Git_HEAD'], ('Git HEAD drift', project['root'])
        heads[project['root']] = git
    p = Path(EVIDENCE['path'])
    a = os.lstat(p)
    assert stat.S_ISREG(a.st_mode) and a.st_nlink == 1
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        assert f9(a) == f9(os.fstat(fd)) == f9(os.lstat(p)) == EVIDENCE['full9'], 'protected canonical evidence metadata changed'
    finally:
        os.close(fd)
    return {'Git_HEADS': heads, 'records': out, 'protected_evidence': {'path': str(p), 'full9': f9(a)}, 'Source_body_read_bytes': 0, 'all_FDs_closed': True}

def genuine(result):
    d = result.to_dict()
    assert not any((d[k] for k in ('timed_out', 'cancelled', 'unavailable', 'output_truncated', 'workspace_limit_exceeded', 'resource_exhausted'))), d
    assert d['workspace_cleaned'] and (not d['error']), d
    assert d.get('native_lifecycle', {}).get('cleanup_confirmed') is True, d
    return d

def observe_state():
    for attempt in range(5):
        before = STATE.lstat()
        assert stat.S_ISREG(before.st_mode) and before.st_size < 65536
        fd = os.open(STATE, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            opened = os.fstat(fd)
            raw = os.read(fd, 65537)
            end = os.fstat(fd)
        finally:
            os.close(fd)
        after = STATE.lstat()
        if f9(before) == f9(opened) == f9(end) == f9(after) and len(raw) == before.st_size:
            return {'full9': f9(after), 'bytes': len(raw), 'sha256': H(raw), 'state': json.loads(raw)}
    raise RuntimeError('bounded resource snapshot identity changed')

def run_phase_with_actual_custody(phase_name, request):
    try:
        result = runner.run(request)
    except BaseException as error:
        handle = error.cleanup_handle if type(error) is sdk.OwnedToolCleanupError else None
        report['owned_cleanup_pending'] = {'owner': 'existing SDK ordinary owned-process cleanup', 'SDK_returned_result': False, 'observations': [], 'attempts': 0, 'original_error_type': type(error).__name__}
        current = error.__traceback__
        while current is not None:
            if current.tb_frame.f_code is sdk.BoundedToolRunner.run.__code__:
                value = current.tb_frame.f_locals.get('result')
                if type(value) is sdk.ToolRunResult:
                    retain_phase_result(phase_name, value, returned=False)
                    report['owned_cleanup_pending']['SDK_result_origin'] = 'actual SDK run traceback local before error; not a successful return'
                candidate = current.tb_frame.f_locals.get('owned_handle')
                if handle is None and type(candidate) is sdk.NativeToolCleanupHandle:
                    handle = candidate
            current = current.tb_next
        if handle is None:
            report['owned_cleanup_pending']['ambiguous_without_actual_handle'] = True
            while True:
                try:
                    print(json.dumps({'event': 'AMBIGUOUS_ORDINARY_CUSTODY_RETAINED', 'operator_pid': os.getpid(), 'Source_READ_still_held': True, 'new_test_dispatch': False}), flush=True)
                    time.sleep(5)
                except BaseException as hold_error:
                    report['owned_cleanup_pending']['last_hold_error_type'] = type(hold_error).__name__
        while True:
            report['owned_cleanup_pending']['attempts'] += 1
            confirmed = False
            try:
                observation = handle.retry_cleanup()
                row = observation.to_dict()
                report['owned_cleanup_pending']['observations'] = (report['owned_cleanup_pending']['observations'] + [row])[-32:]
                confirmed = observation.cleanup_confirmed
            except BaseException as retry_error:
                report['owned_cleanup_pending']['last_retry_error_type'] = type(retry_error).__name__
            if confirmed:
                report['owned_cleanup_pending']['confirmed_after_error'] = True
                raise error
            try:
                print(json.dumps({'event': 'ACTUAL_ORDINARY_CUSTODY_RETAINED', 'operator_pid': os.getpid(), 'attempts': report['owned_cleanup_pending']['attempts'], 'Source_READ_still_held': True, 'new_test_dispatch': False}), flush=True)
                time.sleep(1)
            except BaseException as hold_error:
                report['owned_cleanup_pending']['last_hold_error_type'] = type(hold_error).__name__
    retain_phase_result(phase_name, result, returned=True)
    return result

def retain_json(name, value):
    return retain_bytes(name, (json.dumps(value, sort_keys=True, separators=(',', ':'), default=str) + '\n').encode())

def retain_bytes(name, raw):
    assert type(raw) is bytes and '/' not in name
    path = RUN_OUTPUT / name
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 256)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    return {'path': str(path), 'bytes': len(raw), 'sha256': H(raw)}

def retain_phase_result(phase_name, result, *, returned):
    from collections.abc import Mapping
    output_files = result.output_files
    if not isinstance(output_files, Mapping):
        raise TypeError('actual SDK output_files Mapping required')
    entry = report['phases'][phase_name]
    number = len(entry['actual_results'])
    refs = []
    for index, (logical_name, raw) in enumerate(output_files.items()):
        if type(logical_name) is not str or type(raw) is not bytes:
            raise TypeError('actual SDK output filename and exact bytes required')
        refs.append({'logical_name': logical_name, **retain_bytes(f'{phase_name}-result{number}-output{index}.bin', raw)})
    row = {'SDK_returned_result': returned, 'raw_output_files': refs, 'result': result.to_dict()}
    entry['actual_results'].append(row)
    row['durable_result_record'] = retain_json(f'{phase_name}-result{number}-actual-record.json', row)

def require_actual_rewrite_witness(row, path, want, witness):
    assert row['rewritten_test_compiled_SHA_observed'] is True and row['rewritten_test_compiled_SHA256'] == want['sha256']
    assert row['actual_rewrite_witness'] == witness and witness['schema'] == 'actual-selected-test-source-AST-code-witness/v1'
    assert witness['path'] == witness['code_filename'] == path and witness['source_bytes'] == want['bytes'] and (witness['source_sha256'] == witness['compile_source_sha256'] == want['sha256']) and (witness['compile_source_full9'] == want['full9'])
    assert all((witness[k] is True for k in ('source_to_AST_observed', 'AST_to_code_observed', 'returned_code_identity_matches', 'code_execution_observed')))
    assert witness['source_before'] == witness['source_after'] == {'path': path, 'bytes': want['bytes'], 'sha256': want['sha256'], 'full9': want['full9'], 'stable_FD_path_before_after': True}
    assert witness['cache_policy'] == 'bypass-read-only-for-selected-owning-test' and type(witness['selected_cache_reads_bypassed']) is int and (witness['selected_cache_reads_bypassed'] >= 1)
    digest = witness['code_sha256']
    assert type(digest) is str and len(digest) == 64 and all((c in '0123456789abcdef' for c in digest))
    return True

def validate_lazy_owner_origin_binding(origins, require_loaded):
    assert type(origins) is dict and set(origins) == set(MAINTAINED_OWNER_NAMES)
    for name in MAINTAINED_OWNER_NAMES:
        row = origins[name]
        want = EXPECTED_MODULES[name]
        path = str(ROOT / want['relative_path'])
        if row.get('status') == 'not_loaded':
            assert not require_loaded and row == dict(status='not_loaded', path=path, spec_origin=None, compiled_SHA256=None)
        else:
            assert row.get('status') == 'loaded'
            assert row['path'] == row['spec_origin'] == path
            assert row['compiled_SHA256'] == want['sha256']

def binding_for(phase_name, request, result):
    raw = result.output_files.get('binding.json')
    if raw is None:
        report['phases'][phase_name]['missing_required_output'] = 'binding.json'
        raise RuntimeError('actual SDK result lacks binding.json; original outputs and custody retained')
    binding = json.loads(raw)
    report['phases'][phase_name]['actual_binding'] = binding
    expected_request = json.loads(request.input_files['request.json'])
    assert binding['schema'] == 'frozen-local-D-phase2-bridge27-binding/v1' and binding['canonical_application'] is False and (binding['frozen_local_D_Git_READ_application'] is True) and (binding['Source_WRITE_claimed'] is False)
    assert binding['actual_bootstrap_execution'] is True and binding['phase'] == expected_request['phase'] and (binding['operation'] == expected_request['operation'])
    assert binding['collection_accepted'] is True and binding['pytest_exit_code'] == result.returncode
    assert binding['normal_Source_loader_restored'] is True and binding['normal_pytest_rewrite_observer_restored'] is True
    for field in ('git_candidate_provenance', 'additional_A_provenance', 'binding_manifest_reference', 'source_read_binding_reference', 'admitted_io_plan_reference', 'effect_decision_reference'):
        assert binding[field] == expected_request[field]
    for label in ('initial_body_bindings', 'loaded_bindings', 'collection_module_bindings', 'closing_module_bindings'):
        rows = binding[label]
        byname = {r['name']: r for r in rows}
        assert len(rows) == len(byname) == len(EXPECTED_MODULES) and set(byname) == set(EXPECTED_MODULES)
        for name, want in EXPECTED_MODULES.items():
            row = byname[name]
            assert row['scope'] == 'frozen_local_git_D_source' and (row['path'], row['bytes'], row['sha256'], row['full9']) == (str(ROOT / want['relative_path']), want['bytes'], want['sha256'], want['full9'])
    if _lazy_owner_names:
        assert binding['maintained_owner_visibility_policy'] == MAINTAINED_OWNER_VISIBILITY_POLICY == expected_request['maintained_owner_visibility_policy']
        assert binding['maintained_owner_visibility_policy_reference'] == MAINTAINED_OWNER_VISIBILITY_POLICY_REFERENCE == expected_request['maintained_owner_visibility_policy_reference']
        validate_lazy_owner_origin_binding(binding['actual_maintained_owner_origins'], False)
        validate_lazy_owner_origin_binding(binding['actual_terminal_maintained_owner_origins'], expected_request['operation'] == 'run')
    else:
        origins = binding['actual_maintained_owner_origins']
        assert set(origins) == set(MAINTAINED_OWNER_NAMES)
        for name in MAINTAINED_OWNER_NAMES:
            row = origins[name]
            want = EXPECTED_MODULES[name]
            assert row['path'] == row['spec_origin'] == str(ROOT / want['relative_path']) and row['compiled_SHA256'] == want['sha256']
    test_paths = {str(ROOT / relative): EXPECTED_MODULES[name] for relative, name in SELECTED_TEST_MODULES.items()}
    assert set(binding['actual_test_module_origins']) == set(binding['actual_test_rewrite_source_to_code']) == set(test_paths)
    for path, want in test_paths.items():
        row = binding['actual_test_module_origins'][path]
        require_actual_rewrite_witness(row, path, want, binding['actual_test_rewrite_source_to_code'][path])
        assert row['path'] == row['spec_origin'] == path and row['source_sha256'] == want['sha256'] and (row['source_full9'] == want['full9'])
    roster = binding['actual_collected_roster']
    assert type(roster) is list and len(roster) == len(set(roster)) == 37 and all((type(n) is str and n.split('::', 1)[0] in OWNING_FILES for n in roster))
    assert set(roster) == set(SELECTION['literal_expected_nodeids']), 'independent literal37 nodeid set differs'
    retained_order = SELECTION['literal_expected_nodeids'][:22]
    retained_ids = set(retained_order)
    assert [node for node in roster if node in retained_ids] == retained_order, 'prior v581 ordering differs'
    assert binding['selection_group'] == expected_request['selection_group'] == 'reviewed-mixed-v3-definition-self-reference-ordinary37'
    counts = {}
    for node in roster:
        base = node.split('[', 1)[0]
        counts[base] = counts.get(base, 0) + 1
    assert counts == binding['actual_function_case_counts'] == SELECTION['expected_function_case_counts']
    assert tuple((counts[n] for n in SELECTION['function_selectors'])) == EXPECTED_BRIDGE27_CASE_VECTOR
    if expected_request['operation'] == 'run':
        assert roster == expected_request['actual_collected_roster']
    items = binding['actual_test_item_origins']
    assert [r['nodeid'] for r in items] == roster
    for row in items:
        path = row['path']
        want = test_paths[path]
        require_actual_rewrite_witness(row, path, want, binding['actual_test_rewrite_source_to_code'][path])
        assert row['module_origin'] == row['spec_origin'] == row['item_code_filename'] == path
    assert set(binding['actual_conftest_paths']) == set(REQUIRED_CONFTESTS) and binding['actual_inifile'] == fixture['pytest_inifile']
    config_paths = {fixture['pytest_inifile'], *REQUIRED_CONFTESTS}
    for stage in ('initial_configuration_bindings', 'collection_configuration_bindings', 'closing_configuration_bindings'):
        actual = binding[stage]
        observed = {r['path']: r for r in actual}
        assert len(actual) == len(observed) == len(config_paths) and set(observed) == config_paths
        for path, row in observed.items():
            assert all((row[k] == outer_rows[path][k] for k in ('path', 'bytes', 'sha256', 'full9'))) and row['stable_FD_path_before_after'] is True
    assert set(binding['actual_compiled_current_Source']) <= set(outer_rows) and all((outer_rows[p]['sha256'] == h for p, h in binding['actual_compiled_current_Source'].items()))
    return binding

def reconcile_junit(phase_name, result, roster):
    raw = result.output_files.get('junit.xml')
    if raw is None:
        report['phases'][phase_name]['missing_required_output'] = 'junit.xml'
        raise RuntimeError('actual SDK result lacks junit.xml; retained resource flags/results determine failure')
    entry = report['phases'][phase_name]
    try:
        xml = ET.fromstring(raw)
        cases = []
        for case in xml.iter('testcase'):
            cases.append({'classname': case.get('classname'), 'name': case.get('name'), 'failures': [{'type': item.get('type'), 'message': item.get('message'), 'text': item.text} for item in case.findall('failure')], 'errors': [{'type': item.get('type'), 'message': item.get('message'), 'text': item.text} for item in case.findall('error')], 'skipped': [{'type': item.get('type'), 'message': item.get('message'), 'text': item.text} for item in case.findall('skipped')]})
        actual_pairs = [(case['classname'], case['name']) for case in cases]
        expected_pairs = []
        for node in roster:
            owner_key, case_name = node.rsplit('::', 1)
            filename, *class_names = owner_key.split('::')
            expected_pairs.append(('.'.join([filename[:-3].replace('/', '.'), *class_names]), case_name))
        missing = sorted(set(expected_pairs) - set(actual_pairs))
        extra = sorted(set(actual_pairs) - set(expected_pairs), key=repr)
        duplicates = sorted({pair for pair in actual_pairs if actual_pairs.count(pair) > 1}, key=repr)
        summary = {'cases': cases, 'tests': len(cases), 'failures': sum((len(case['failures']) for case in cases)), 'errors': sum((len(case['errors']) for case in cases)), 'skipped': sum((len(case['skipped']) for case in cases)), 'passed': sum((not (case['failures'] or case['errors'] or case['skipped']) for case in cases)), 'missing_pairs': missing, 'unexpected_pairs': extra, 'duplicate_pairs': duplicates, 'actual_raw_junit_bytes': len(raw), 'actual_raw_junit_sha256': H(raw)}
        entry['junit'] = summary
    except BaseException as error:
        entry['junit_parse_error'] = {'type': type(error).__name__, 'message': str(error), 'traceback': traceback.format_exc()}
        raise
    assert len(cases) == len(roster) and (not missing) and (not extra) and (not duplicates)
    return summary

def execute_phase(phase, operation, roster=None, *, group):
    name = group + '-' + operation
    entry = {'phase': phase, 'operation': operation, 'selection_group': group, 'actual_results': [], 'accepted': False, 'error': None}
    report['phases'][name] = entry
    report['phase_order'].append(name)
    validate_runtime_authority(ROOT_RUNTIME_SELECTION, ROOT_RUNTIME_SELECTION, time.time_ns())
    request = continuation_request(phase, operation, roster, group=group)
    expected_count = None if operation == 'collect' else len(roster)
    entry['request'] = {'argv': list(request.argv), 'limits': dataclasses.asdict(request.limits), 'output_paths': list(request.output_paths), 'input_file_manifest': [{'path': key, 'bytes': len(value), 'sha256': H(value)} for key, value in request.input_files.items()]}
    entry['source_before'] = retain_json(name + '-source-before.json', metadata_guard())
    try:
        print(json.dumps({'event': 'ACTUAL_PUBLISHED_D_PHASE2_BRIDGE27_PHASE_START', 'phase': name, 'operator_pid': os.getpid(), 'parent_lease_id': parent.lease_id}), flush=True)
        result = run_phase_with_actual_custody(name, request)
        entry['source_after'] = retain_json(name + '-source-after.json', metadata_guard())
        entry['actual_SDK_resource_flags'] = {key: result.to_dict().get(key) for key in ('returncode', 'timed_out', 'cancelled', 'unavailable', 'output_truncated', 'workspace_limit_exceeded', 'resource_exhausted', 'workspace_cleaned', 'error', 'native_lifecycle')}
        genuine(result)
        if result.returncode != 0:
            entry['primary_actual_phase_failure'] = {'actual_tool_returncode': result.returncode, 'success_binding_checks_skipped': True, 'partial_binding_retained_in_raw_outputs': 'binding.json' in result.output_files, 'raw_stdout_stderr_and_result_already_durable': True}
            raise RuntimeError('Actual normal pytest phase exited nonzero before success-binding validation: ' + name + ' returncode=' + str(result.returncode))
        binding = binding_for(name, request, result)
        actual_roster = binding['actual_collected_roster']
        junit = reconcile_junit(name, result, actual_roster) if operation == 'run' else None
        genuine(result)
        if operation == 'collect':
            assert result.returncode == 0, ('actual collection/binding infeasibility', name, result.returncode)
        else:
            assert result.returncode == 0 and junit['tests'] == junit['passed'] == expected_count
            assert junit['failures'] == junit['errors'] == junit['skipped'] == 0
            actual_calls = binding['actual_called_roster']
            terminal_reports = binding['actual_terminal_call_reports']
            assert actual_calls == actual_roster and len(actual_calls) == len(set(actual_calls)) == expected_count
            assert terminal_reports and all((type(row['is_subtest']) is bool and row['nodeid'] in actual_roster and (row['outcome'] == 'passed') for row in terminal_reports))
            parent_reports = [row for row in terminal_reports if not row['is_subtest']]
            subtest_reports = [row for row in terminal_reports if row['is_subtest']]
            assert [row['nodeid'] for row in parent_reports] == actual_roster and len(parent_reports) == expected_count
            entry['terminal_report_accounting'] = dict(unique_actual_test_calls=len(actual_calls), terminal_reports=len(terminal_reports), parent_terminal_reports=len(parent_reports), passing_subtest_reports=len(subtest_reports), all_raw_reports_preserved=True)
            entry['frozen_local_D_bridge_tests_PASS'] = True
        entry['accepted'] = True
        return actual_roster
    except BaseException as error:
        entry['error'] = {'type': type(error).__name__, 'message': str(error), 'traceback': traceback.format_exc()}
        if 'source_after' not in entry:
            try:
                entry['source_after'] = retain_json(name + '-source-after-error.json', metadata_guard())
            except BaseException as fence_error:
                entry['source_after_error'] = {'type': type(fence_error).__name__, 'message': str(fence_error)}
        raise

@contextlib.contextmanager
def tracked_source_read(project):
    manager = source.source_lease(project['root'], mode='read', timeout_seconds=30)
    lease = manager.__enter__()
    observation = {'root': project['root'], 'entered': True, 'exit_returned': False}
    report.setdefault('actual_Source_context_closure', []).append(observation)
    try:
        yield lease
    except BaseException:
        suppressed = manager.__exit__(*sys.exc_info())
        observation['exit_returned'] = True
        if not suppressed:
            raise
    else:
        manager.__exit__(None, None, None)
        observation['exit_returned'] = True
parent = None
try:
    with contextlib.ExitStack() as stack:
        leases = [stack.enter_context(tracked_source_read(project)) for project in sorted(PROJECTS, key=lambda row: str(source.canonical_source_root(row['root'])))]
        report['Source_leases'] = [lease.to_dict() for lease in leases]
        try:
            report['source_opening'] = retain_json('source-opening.json', metadata_guard())
            sys.path[:0] = FLAGS['PYTHONPATH'].split(os.pathsep)
            sdk = importlib.import_module('ipfs_datasets_py.logic.backends.process')
            admitted = importlib.import_module('ipfs_datasets_py.logic.backends.resource_admission')
            resources = importlib.import_module('ipfs_datasets_py.optimizers.logic_theorem_optimizer.resource_scheduler')
            assert sdk.ToolRunRequest is admitted.ToolRunRequest and sdk.ToolRunResult is admitted.ToolRunResult
            assert admitted.GlobalResourceScheduler is resources.GlobalResourceScheduler
            pins = FINAL_SDK_BINDINGS
            report['canonical_module_bindings'] = {}
            for name, (relative, digest) in pins.items():
                path = ROOT / relative
                row = next((row for row in EPOCH if row['path'] == str(path)))
                assert Path(sys.modules[name].__file__).resolve() == path.resolve() and row['sha256'] == digest and (f9(path.lstat()) == row['full9'])
                report['canonical_module_bindings'][name] = {'path': str(path), 'sha256': digest, 'full9': row['full9']}
            report['resource_before'] = observe_state()
            assert report['resource_before']['state']['config'] == EXPECTED_CONFIG
            assert report['resource_before']['state']['child_process_capacity'] == EXPECTED_CAPACITY
            config = resources.ResourceSchedulerConfig(state_path=str(STATE), **report['resource_before']['state']['config'])
            scheduler = resources.get_global_resource_scheduler(config=config)
            parent = scheduler.try_acquire('validation', cpu_slots=1, memory_mb=4096, child_process_slots=1, requires_gpu=False, gpu_memory_mb=0, unified_memory_mb=0, parent_lease=None, request_id='frozen-local-D-reviewed-mixed-v3-definition-self-reference-ordinary37:once')
            if parent is None:
                report['admission_refused'] = True
                raise RuntimeError('Existing shared validation admission refused; no SDK dispatch or product RED')
            report['actual_parent_lease'] = parent.to_dict()
            runner = admitted.ResourceAdmittedToolRunner(parent_lease=parent, cpu_slots=1, child_process_slots=1, base_environment={'PATH': PATH_SCOPE, 'LANG': 'C.UTF-8'}, executable_roots=('/usr/bin', '/home/barberb/lift_coding/.venv/bin'))
            report['explicit_existing_D27_ordinary_budget'] = {'collect': {'wall_seconds': 120, 'cpu_seconds': 110}, 'run': {'wall_seconds': 600, 'cpu_seconds': 540}, 'cpu_slots': 1, 'child_process_slots': 1, 'resident_memory_bytes': 4294967296, 'same_existing_direct_scheduler_no_Daemon_layer': True}
            roster = execute_phase('frozen-local-D-reviewed-mixed-v3-definition-self-reference-ordinary37', 'collect', group='reviewed-mixed-v3-definition-self-reference-ordinary37')
            execute_phase('frozen-local-D-reviewed-mixed-v3-definition-self-reference-ordinary37', 'run', roster, group='reviewed-mixed-v3-definition-self-reference-ordinary37')
            report['software_sequence_accepted'] = True
        finally:
            if parent is not None:
                attempt = 0
                while True:
                    attempt += 1
                    try:
                        snapshot = observe_state()
                        rows = snapshot['state']['leases']
                        descendants = {parent.lease_id}
                        changed = True
                        while changed:
                            changed = False
                            for lease_id, row in rows.items():
                                if row.get('parent_lease_id') in descendants and lease_id not in descendants:
                                    descendants.add(lease_id)
                                    changed = True
                        assert not descendants.intersection(rows) - {parent.lease_id}, 'actual managed descendants remain; retain own parent and Source custody'
                        report['resource_before_parent_release'] = snapshot
                        if not parent.released:
                            report['actual_parent_release_return'] = parent.release()
                        snapshot = observe_state()
                        assert not descendants.intersection(snapshot['state']['leases'])
                        report['resource_after_parent_release'] = snapshot
                        report['resource_cleanup_confirmed'] = True
                        break
                    except BaseException as cleanup_error:
                        report['resource_cleanup_last_error'] = {'type': type(cleanup_error).__name__, 'message': str(cleanup_error), 'attempt': attempt}
                        try:
                            print(json.dumps({'event': 'ACTUAL_PUBLISHED_D_PHASE2_BRIDGE27_CUSTODY_RETAINED', 'operator_pid': os.getpid(), 'attempt': attempt, 'Source_READ_held': True}), flush=True)
                            time.sleep(1)
                        except BaseException as hold_error:
                            report['resource_hold_error'] = repr(hold_error)
            else:
                report['resource_after_predispatch'] = observe_state()
                report['resource_cleanup_confirmed'] = True
            report['source_closing'] = retain_json('source-closing.json', metadata_guard())
except BaseException as error:
    report['errors'].append({'type': type(error).__name__, 'message': str(error), 'traceback': traceback.format_exc()})
    raise
finally:
    _finalizer_primary_error = sys.exc_info()[1]
    _parent_home_cleanup_error = None
    try:
        shutil.rmtree(PARENT_HOME)
    except BaseException as cleanup_error:
        _parent_home_cleanup_error = cleanup_error
        report['errors'].append({'stage': 'parent_home_cleanup', 'type': type(cleanup_error).__name__, 'message': str(cleanup_error), 'traceback': traceback.format_exc()})
    report['Source_closed'] = all((row['exit_returned'] for row in report.get('actual_Source_context_closure', [])))
    report['qualification_complete'] = report['software_sequence_accepted'] and report['Source_closed'] and report['resource_cleanup_confirmed'] and (not report['errors'])
    try:
        ref = retain_json('complete-frozen-local-D-reviewed-mixed-v3-definition-self-reference-ordinary37-existing-owner-report.json', report)
    except BaseException as final_report_error:
        report['final_report_retention_error'] = {'type': type(final_report_error).__name__, 'message': str(final_report_error), 'traceback': traceback.format_exc()}
        if _finalizer_primary_error is None and _parent_home_cleanup_error is None:
            raise
    else:
        try:
            print(json.dumps({'event': 'ACTUAL_PUBLISHED_D_PHASE2_BRIDGE27_CLOSED', 'report': ref, 'Source_closed': report['Source_closed'], 'resource_cleanup_confirmed': report['resource_cleanup_confirmed'], 'qualification_complete': report['qualification_complete'], 'errors': report['errors']}, sort_keys=True), flush=True)
        except BaseException as final_print_error:
            report['final_report_print_error'] = {'type': type(final_print_error).__name__, 'message': str(final_print_error)}
            if _finalizer_primary_error is None and _parent_home_cleanup_error is None:
                raise
    if _finalizer_primary_error is None and _parent_home_cleanup_error is not None:
        raise _parent_home_cleanup_error
