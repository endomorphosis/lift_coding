        if (Path(mod.__file__).resolve(strict=True) != path
                or Path(mod.__spec__.origin).resolve(strict=True) != path
                or mod.__spec__.name != name):
            raise RuntimeError("module physical origin was retagged: " + name)
        parent_name, attribute = name.rsplit(".", 1)
        if getattr(sys.modules[parent_name], attribute) is not mod:
            raise RuntimeError("parent-package alias differs: " + name)
        result.append(body_identity(name))
    return result

