def validate_runtime_authority(authority, expected_authority, now_utc_ns):
    keys={'schema','root_selection','launch_not_before_utc_ns','launch_deadline_utc_ns'}
    for value in (authority,expected_authority):
        if type(value) is not dict or set(value)!=keys or value['schema']!='Root-selected-normal-HOME-rescue-launch-authority/v1':
            raise RuntimeError('closed Root runtime authority required')
        reference=value['root_selection']
        if type(reference) is not dict or set(reference)!={'path','bytes','sha256'}:
            raise RuntimeError('one exact immutable Root selection reference required')
        if type(reference['path']) is not str or not Path(reference['path']).is_absolute() or type(reference['bytes']) is not int or reference['bytes']<=0 or type(reference['sha256']) is not str or len(reference['sha256'])!=64 or any(c not in '0123456789abcdef' for c in reference['sha256']):
            raise RuntimeError('invalid immutable Root selection reference')
        start=value['launch_not_before_utc_ns'];deadline=value['launch_deadline_utc_ns']
        if type(start) is not int or type(deadline) is not int or not 0<start<deadline:
            raise RuntimeError('finite exact UTC nanosecond launch window required')
    if authority!=expected_authority:
        raise RuntimeError('Root runtime authority mismatch, including selection and clock')
    if type(now_utc_ns) is not int or not authority['launch_not_before_utc_ns']<=now_utc_ns<authority['launch_deadline_utc_ns']:
        raise RuntimeError('Root launch clock outside selected window')
    return authority

