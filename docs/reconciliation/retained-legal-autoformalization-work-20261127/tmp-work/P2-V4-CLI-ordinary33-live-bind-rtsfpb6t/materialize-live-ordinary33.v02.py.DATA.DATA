import hashlib
import json
import os
from pathlib import Path
import stat
import sys

work=Path(__file__).resolve().parent
file_names=('path','bytes','sha256')
fields=('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
stamp=lambda s:{k:str(getattr(s,k)) for k in fields}

def captured(path):
    p=Path(path)
    st=p.lstat()
    assert stat.S_ISREG(st.st_mode) and st.st_nlink==1
    with os.fdopen(os.open(p,os.O_RDONLY|os.O_NOFOLLOW),'rb') as stream:
        assert stamp(st)==stamp(os.fstat(stream.fileno()))
        data=stream.read(st.st_size+1)
        assert stamp(st)==stamp(os.fstat(stream.fileno()))
    assert len(data)==st.st_size and stamp(st)==stamp(p.lstat())
    return dict(path=str(p),bytes=len(data),sha256=hashlib.sha256(data).hexdigest()),data


def ref(path):
    return captured(path)[0]


def raw(r):
    observed,data=captured(r['path'])
    assert observed=={k:r[k] for k in file_names}
    return data

def obj(r):
    return json.loads(raw(r))

def save(name,payload):
    p=work/name
    with os.fdopen(os.open(p,os.O_CREAT|os.O_NOFOLLOW|os.O_WRONLY|os.O_EXCL,0o400),'wb') as stream:
        stream.write((json.dumps(payload,indent=2,sort_keys=True)+'\n').encode());stream.flush();os.fsync(stream.fileno())
    return ref(p)

assert __debug__ and len(sys.argv)==10
closed_ref,freeze_ref,controls_ref=(
    dict(path=sys.argv[i],bytes=int(sys.argv[i+1]),sha256=sys.argv[i+2]) for i in (1,4,7))
closed,freeze,controls=map(obj,(closed_ref,freeze_ref,controls_ref))
