    pytest_inifile=at_clone(old_fixture['pytest_inifile']),required_absent_paths=absences,
    script_required_fixture=retarget(old_fixture['script_required_fixture']),
    prospective_parent_RUN_compile_rows=[retarget(row) for row in old_fixture['prospective_parent_RUN_compile_rows']],
    required_normal_conftests=[at_clone(path) for path in old_fixture['required_normal_conftests']])
