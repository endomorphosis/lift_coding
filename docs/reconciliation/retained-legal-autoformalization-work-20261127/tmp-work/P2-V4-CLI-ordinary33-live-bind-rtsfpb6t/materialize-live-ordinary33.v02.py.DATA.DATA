assert retained['global_cap']>=retained['used'] and retained['internal_cap']>=retained['internal_used']

def at_clone(path):
    return str(D / Path(path).relative_to(old_D))


def retarget(row):
    fresh=current[at_clone(row['path'])]
    if Path(row['path']).relative_to(old_D).as_posix() not in expected:
        assert all(fresh[key]==row[key] for key in ('bytes','sha256'))
    return fresh


