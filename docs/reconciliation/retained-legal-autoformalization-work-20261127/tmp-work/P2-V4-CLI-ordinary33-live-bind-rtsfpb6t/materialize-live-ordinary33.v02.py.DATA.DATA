absences=[at_clone(path) for path in old_fixture['required_absent_paths']]
assert len(absences)==len(set(absences))==9 and all(not os.path.lexists(path) for path in absences)
fixture_rows=[retarget(row) for row in old_fixture['required_fixture_closure']]
assert len(fixture_rows)==6
assert all(retarget(row) for row in controls['known_current_RUN_support_rows'])
