+    if parent is None and reservation is not None and getattr(reservation,'_lease',None)is not None and not reservation._lease.released:
+     parent=reservation._lease
+    if parent is not None:
+     attempt=0
+     while True:
+      attempt+=1
+      try:
+       snapshot=observe_state();rows=snapshot['state']['leases'];descendants={parent.lease_id};changed=True
+       while changed:
+        changed=False
+        for leaseid,row in rows.items():
+         if row.get('parent_lease_id')in descendants and leaseid not in descendants:descendants.add(leaseid);changed=True
+       if descendants.intersection(rows)-{parent.lease_id}:raise RuntimeError('actual managed descendant claims remain; retain original custody')
+       report['resource_before_parent_release']=snapshot
+       if reservation is not None and not parent.released:
+        if report.get('origin_capture_selected') is True:
+         report['origin_archive_external_bytes'] = origin_retained_external_bytes()
+         reservation.account_external_bytes('actual-relational-origin-SDK-and-archive-v1', report['origin_archive_external_bytes'])
+        elif not isolated:
+         reservation.account_external_bytes('actual-currentcopy-v11-vendor-import-SDK-outputs',sum(len(v)for v in result.output_files.values())if 'result'in globals()else 0)
+        if CHARGED_ROOT.exists():
+         report['actual_reservation_finalized']=reservation.finalize(CHARGED_ROOT,artifacts_durable=True)
+        else:
+         assert not report['tests_dispatched'],'no target or SDK was dispatched before this admission failure'
+         report['actual_reservation_predispatch_release']=reservation.release(artifacts_durable=True)
+        report['actual_parent_release_return']=parent.released
+       elif not parent.released:report['actual_parent_release_return']=parent.release()
+       snapshot=observe_state();assert not descendants.intersection(snapshot['state']['leases'])
+       report['resource_after_parent_release']=snapshot;report['resource_cleanup_confirmed']=True
+       break
+      except BaseException as cleanup_error:
+       report['resource_cleanup_last_error']={'type':type(cleanup_error).__name__,'message':str(cleanup_error),'attempt':attempt}
+       try:print(json.dumps({'event':'ACTUAL_RESOURCE_CUSTODY_RETAINED','operator_pid':os.getpid(),'attempt':attempt,'Source_READ_held':True}),flush=True);time.sleep(1)
+       except BaseException as hold_error:report['resource_hold_error']=repr(hold_error)
+    else:report['resource_after_predispatch']=observe_state();report['resource_cleanup_confirmed']=True
+    report['source_after']=metadata_guard()
+ except BaseException as error:
+  report['errors'].append({'type':type(error).__name__,'message':str(error),'traceback':traceback.format_exc()});raise
+ finally:
+  contexts=report.get('actual_Source_context_closure',[]);report['Source_closed']=bool(contexts)and all(row['exit_returned']is True for row in contexts)
+  raw=json.dumps(report,sort_keys=True,separators=(',',':'),default=str).encode();path=RUN_OUTPUT/('complete-selected-A0-isolated-existing-owner-report.json' if isolated else 'complete-fresh-currentcopy-v11-vendor-import-existing-owner-report.json')
+  fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400)
+  with os.fdopen(fd,'wb')as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
+  shutil.rmtree(PARENT_HOME)
+  print(json.dumps({'event':('ACTUAL_SELECTED_A0_ISOLATED_IMPORT_CLOSED' if isolated else 'ACTUAL_CURRENTCOPY_V11_VENDOR_IMPORT_CLOSED'),'report':{'path':str(path),'bytes':len(raw),'sha256':H(raw)},'Source_closed':report['Source_closed'],'resource_cleanup_confirmed':report['resource_cleanup_confirmed'],'errors':report['errors']},sort_keys=True),flush=True)
+
+ return report
+
+
+if __name__ == '__main__':
+ assert len(sys.argv)==4,'one authenticated actual metadata binding CLI required'
+ run_existing_owner({'path':sys.argv[1],'bytes':int(sys.argv[2]),'sha256':sys.argv[3]})
