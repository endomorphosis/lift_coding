import contextlib,re,tempfile,time,shutil
import os,sys,json,stat,types,hashlib,base64,zlib,subprocess,traceback,importlib.util,xml.etree.ElementTree as ET
from pathlib import Path


H=lambda b:hashlib.sha256(b).hexdigest()
fields=('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_uid', 'st_gid', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
f9=lambda s:{k:str(getattr(s,k))for k in fields}
def exact_metadata(reference):
 assert type(reference)is dict and set(reference)=={'path','bytes','sha256'}
 assert type(reference['path'])is str and Path(reference['path']).is_absolute()and '..'not in Path(reference['path']).parts
 assert type(reference['bytes'])is int and 0<reference['bytes']<=4194304
 assert type(reference['sha256'])is str and re.fullmatch('[0-9a-f]{64}',reference['sha256'])is not None
 p=Path(reference['path']);before=p.lstat();assert stat.S_ISREG(before.st_mode)and before.st_nlink==1 and before.st_uid==os.getuid()and before.st_size==reference['bytes']
 fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
 try:
  opened=os.fstat(fd);assert f9(before)==f9(opened);raw=b''
  while True:
   chunk=os.read(fd,min(1048576,reference['bytes']+1-len(raw)))
   if not chunk:break
   raw+=chunk;assert len(raw)<=reference['bytes']
  ended=os.fstat(fd)
 finally:os.close(fd)
 assert f9(before)==f9(opened)==f9(ended)==f9(p.lstat())and len(raw)==reference['bytes']and H(raw)==reference['sha256']
 return raw

ISOLATED_PARENT_SCHEMA = "actual-selected-a0-isolated-existing-owner-parent/v1"
ISOLATED_SOURCE_SCHEMA = "actual-selected-a0-paired-source-read-binding/v1"
ISOLATED_RESERVATION_SCHEMA = "actual-selected-a0-original-resource-opening/v1"
ISOLATED_PARENT_MODULES = ('ipfs_datasets_py.logic.backends.process',
    'ipfs_datasets_py.logic.backends.resource_admission',
    'ipfs_datasets_py.optimizers.logic_theorem_optimizer.resource_scheduler',
    'ipfs_datasets_py.optimizers.logic_theorem_optimizer.autoencoder_daemon_resources')

def _selected_parent_path(value):
 return type(value) is str and Path(value).is_absolute() and '..' not in Path(value).parts and str(Path(value)) == value

def _selected_parent_digest(value):
 return type(value) is str and re.fullmatch('[0-9a-f]{64}', value) is not None

def _selected_parent_json(reference):
 raw=exact_metadata(reference)
 def unique(pairs):
  result={}
  for name,value in pairs:
   if name in result:
    raise ValueError("duplicate selected parent metadata key")
   result[name]=value
  return result
 return json.loads(raw,object_pairs_hook=unique),raw

def isolated_parent_fingerprint(selected, owner):
 controls={key:value for key,value in selected.items() if key not in ('fingerprint','epoch_raw','launch_raw','root')}
 return (H(json.dumps(controls,sort_keys=True,separators=(',',':')).encode()),
         H(selected['epoch_raw']),H(selected['launch_raw']),str(selected['root']),
         owner['origin_owner'].origin_commitment(owner['origin']),
         id(owner['origin_owner']),id(owner['renderer']),id(owner['renderer']['run_relational_origin_first_use']),
         id(owner['verify_opening']),id(owner['verify_control_binding']),id(owner['verify_launch_owner']))

def prepare_isolated_parent(execution, execution_ref, owner):
 """Authenticate parent inputs before the existing driver opens its live custody."""
 from copy import deepcopy
 if (type(execution) is not dict or set(execution) != {'schema','source_binding','control_binding',
       'resource_opening','launch_selection','projects','charged_root','output_directory'}
     or execution['schema'] != ISOLATED_PARENT_SCHEMA
     or type(owner) is not dict or set(owner) != {'origin_owner','origin','renderer',
           'verify_opening','verify_control_binding','verify_launch_owner'}
     or any(not callable(owner[key]) for key in ('verify_opening','verify_control_binding','verify_launch_owner'))
     or type(owner['renderer']) is not dict or not callable(owner['renderer'].get('run_relational_origin_first_use'))):
  raise ValueError("explicit existing owner and exact isolated parent input required")
 sealed_execution,execution_raw=_selected_parent_json(execution_ref)
 if sealed_execution!=execution:
  raise ValueError("selected isolated parent execution input changed")
 source, _ = _selected_parent_json(execution['source_binding'])
 control, _ = _selected_parent_json(execution['control_binding'])
 opening, _ = _selected_parent_json(execution['resource_opening'])
 launch, launch_raw = _selected_parent_json(execution['launch_selection'])
 if (type(source) is not dict or source.get('schema') != ISOLATED_SOURCE_SCHEMA
     or set(source) != {'schema','datasets_root','projects','outer_epoch','protected_index','absent_paths','paired_reader_close','parent_module_sha256'}
     or not _selected_parent_path(source['datasets_root'])):
  raise ValueError("exact current paired Source binding required")
 projects=source['projects']
 if (type(projects) is not list or len(projects)!=2 or projects!=execution['projects']
     or any(type(p) is not dict or set(p)!={'root','Git_HEAD'} or not _selected_parent_path(p['root'])
            or type(p['Git_HEAD']) is not str or re.fullmatch('[0-9a-f]{40}',p['Git_HEAD']) is None for p in projects)
     or len({p['root'] for p in projects})!=2 or source['datasets_root'] not in {p['root'] for p in projects}):
  raise ValueError("current paired project roots and Git HEADs differ")
 roots={Path(p['root']) for p in projects}
 if any(root.resolve(strict=True)!=root for root in roots):
  raise ValueError("paired project roots must have their selected resolved identities")
 if any(a != b and a.is_relative_to(b) for a in roots for b in roots):
  raise ValueError("paired project roots must be separate")
 for field in ('charged_root','output_directory'):
  if (not _selected_parent_path(execution[field])
      or Path(execution[field]).resolve()!=Path(execution[field])
      or any(Path(execution[field]).is_relative_to(root) for root in roots)):
   raise ValueError("private charged and output paths must be outside selected Source roots")
 epoch, epoch_raw = _selected_parent_json(source['outer_epoch'])
 _selected_parent_json(source['paired_reader_close'])
 evidence=source['protected_index']
 absent=source['absent_paths']
 def row_stamp(full9):
  return (type(full9) is dict and set(full9)==set(fields)
          and all(type(value) is str and re.fullmatch('[0-9]+', value) is not None for value in full9.values()))
 if (type(epoch) is not list or not 0<len(epoch)<=8192
     or any(type(row) is not dict or not _selected_parent_path(row.get('path'))
            or type(row.get('bytes')) is not int or row['bytes']<0 or not _selected_parent_digest(row.get('sha256'))
            or not row_stamp(row.get('full9')) or row['full9']['st_size']!=str(row['bytes'])
            or sum(Path(row['path']).is_relative_to(root) for root in roots)!=1 for row in epoch)
     or len({row['path'] for row in epoch})!=len(epoch)
     or type(evidence) is not dict or set(evidence)!={'path','full9','sha256'}
     or not _selected_parent_path(evidence['path']) or not row_stamp(evidence['full9'])
     or not _selected_parent_digest(evidence['sha256'])
     or type(absent) is not list or any(not _selected_parent_path(path)
          or not any(Path(path).is_relative_to(root) for root in roots) for path in absent)
     or len(set(absent))!=len(absent) or set(absent).intersection(row['path'] for row in epoch)):
  raise ValueError("current paired Source full9, protected index or absence roster differs")
 parent_module_sha256=source['parent_module_sha256']
 by_path={row['path']:row for row in epoch}
 index_row=by_path.get(evidence['path'])
 if index_row is not None and any(index_row[key]!=evidence[key] for key in ('sha256','full9')):
  raise ValueError("protected index and paired Source row differ")
 if (type(parent_module_sha256) is not dict or set(parent_module_sha256)!=set(ISOLATED_PARENT_MODULES)
     or any(not _selected_parent_digest(digest)
            or by_path.get(str(Path(source['datasets_root'])/(name.replace('.','/')+'.py')),{}).get('sha256')!=digest
            for name,digest in parent_module_sha256.items())):
  raise ValueError("exact current parent module pins must match the paired Source epoch")
 numeric={'storage_bytes','storage_limit_bytes','memory_mb','cpu_slots','child_process_slots',
          'timeout_seconds','ledger_lock_timeout_seconds'}
 if (type(opening) is not dict or set(opening)!=(numeric | {'schema','state_path','resource_ledger',
          'roots','expected_scheduler_policy_sha256','environment'})
     or opening['schema'] != ISOLATED_RESERVATION_SCHEMA
     or any(type(opening[field]) is not int or opening[field]<=0 for field in numeric)
     or not all(_selected_parent_path(opening[key]) for key in ('state_path','resource_ledger'))
     or not _selected_parent_digest(opening['expected_scheduler_policy_sha256'])
     or type(opening['roots']) is not list or not opening['roots']
     or any(not _selected_parent_path(root) for root in opening['roots'])
     or len(set(opening['roots']))!=len(opening['roots'])
     or opening['storage_bytes']>opening['storage_limit_bytes']
     or not any(Path(execution['charged_root']).is_relative_to(Path(root)) for root in opening['roots'])):
  raise ValueError("exact existing ledger, scheduler and charged reservation selection required")
 environment=opening['environment']
 if (type(environment) is not dict or any(type(key) is not str or type(value) is not str for key,value in environment.items())
     or not all(environment.get(key) == value for key,value in {
         'HF_HUB_OFFLINE':'1','TRANSFORMERS_OFFLINE':'1','IPFS_DATASETS_PY_MINIMAL_IMPORTS':'1',
         'IPFS_ACCEL_AUTO_INSTALL':'0','IPFS_ACCEL_SKIP_CORE':'1','IPFS_DATASETS_AUTO_INSTALL_TEST_DEPS':'0',
         'IPFS_DATASETS_PY_LAZY_INSTALL_ERGOAI':'0','PYTHONDONTWRITEBYTECODE':'1'}.items())
     or environment.get('PYTHONOPTIMIZE','') not in ('','0')
     or not set(map(str,roots)).issubset(environment.get('PYTHONPATH','').split(os.pathsep))):
  raise ValueError("exact approved offline parent and renderer environment required")
 origin_sha=owner['origin_owner'].origin_commitment(owner['origin'])
 if (type(control) is not dict or control.get('origin_selection_sha256')!=origin_sha
     or control.get('source_epoch_reference')!=source['outer_epoch']
     or control.get('cwd')!=source['datasets_root']
     or control.get('attempt_directory')!=str(Path(execution['charged_root'])/'attempt')
     or not _selected_parent_path(control.get('python'))
     or not _selected_parent_digest(control.get('owner_admission_sha256'))
     or type(control.get('limits')) is not dict
     or any(type(control['limits'].get(key)) is not int or not 0<control['limits'][key]<=bound
            for key,bound in {'resident_memory_bytes':opening['memory_mb']*1024**2,
                              'max_workspace_bytes':opening['storage_bytes']}.items())
     or type(launch) is not dict or launch.get('origin_selection_sha256')!=origin_sha
     or launch.get('source_epoch_sha256')!=source['outer_epoch']['sha256']
     or launch.get('control_binding_sha256')!=execution['control_binding']['sha256']
     or not all(_selected_parent_digest(launch.get(key)) for key in ('physical_request_sha256','clock_domain_sha256'))):
  raise ValueError("selected control, launch, resource or origin does not bind the paired Source epoch")
 selected={'root':Path(source['datasets_root']),'projects':projects,'environment':environment,
     'epoch_reference':source['outer_epoch'],'epoch':epoch,'epoch_raw':epoch_raw,'control':control,
     'evidence':{key:evidence[key] for key in ('path','full9')},'protected_index_sha256':evidence['sha256'],
     'absent_paths':absent,'opening':opening,'paired_close':source['paired_reader_close'],'launch_raw':launch_raw,
     'launch_reference':dict(execution['launch_selection']), 'parent_module_sha256':parent_module_sha256,
     'control_reference':dict(execution['control_binding'])}
 # The original verifier authenticates the paired reader close and the selected
 # index path even when Git metadata is tracked outside the regular Source roster.
 fingerprint=isolated_parent_fingerprint(selected, owner)
 references=(dict(execution_ref),dict(execution['source_binding']),dict(execution['resource_opening']),
             dict(source['paired_reader_close']),dict(execution['control_binding']),dict(execution['launch_selection']))
 if owner['verify_opening'](*(ref['sha256'] for ref in references),control['owner_admission_sha256'],origin_sha) is not True:
  raise ValueError("original owner refused the selected parent opening")
 if (isolated_parent_fingerprint(selected,owner)!=fingerprint or exact_metadata(execution_ref)!=execution_raw
     or execution!=sealed_execution):
  raise ValueError("selected isolated parent opening changed during verification")
 for ref in references[1:]:
  exact_metadata(ref)
 selected['fingerprint']=fingerprint
 return selected

def dispatch_isolated_parent(selected, execution, owner):
 if (selected['fingerprint']!=isolated_parent_fingerprint(selected,owner)
     or execution['launch_selection']!=selected['launch_reference']
     or execution['control_binding']!=selected['control_reference']):
  raise ValueError("selected isolated dispatch scope changed after parent admission")
 report['isolated_origin_dispatch_attempted']=True
 return run_selected_isolated_origin(owner['origin'],origin_owner=owner['origin_owner'],
     actual_control_binding_reference=dict(selected['control_reference']),verify_control_binding=owner['verify_control_binding'],
     launch_raw=selected['launch_raw'],expected_launch_sha256=selected['launch_reference']['sha256'],
     verify_launch_owner=owner['verify_launch_owner'])

