process={'afterFull9': {'st_ctime_ns': '1794440363922454714', 'st_dev': '66306', 'st_gid': '1000', 'st_ino': '57805342', 'st_mode': '33188', 'st_mtime_ns': '1794440363920001940', 'st_nlink': '1', 'st_size': '102792', 'st_uid': '1000'}, 'body_read_calls': 1, 'bytes': 102792, 'encoding': 'zlib+base64', 'full9': {'st_ctime_ns': '1794440363922454714', 'st_dev': '66306', 'st_gid': '1000', 'st_ino': '57805342', 'st_mode': '33188', 'st_mtime_ns': '1794440363920001940', 'st_nlink': '1', 'st_size': '102792', 'st_uid': '1000'}, 'path': '/home/barberb/lift_coding/external/ipfs_datasets/ipfs_datasets_py/logic/backends/process.py', 'pathAfterFull9': {'st_ctime_ns': '1794440363922454714', 'st_dev': '66306', 'st_gid': '1000', 'st_ino': '57805342', 'st_mode': '33188', 'st_mtime_ns': '1794440363920001940', 'st_nlink': '1', 'st_size': '102792', 'st_uid': '1000'}, 'raw_zlib_base64': '', 'role': 'actual_spec_router_and_existing_public_process_seam', 'sha256': '4434f571e209c17165aa3ea941001bbeaad3efc10957a8dfe9c183f7531b44b6'}

def load_cached_operational(record,name):
 raw=zlib.decompress(base64.b64decode(record["raw_zlib_base64"]));assert(len(raw),H(raw))==(record["bytes"],record["sha256"])
 spec=importlib.util.spec_from_file_location(name,record["path"]);assert spec is not None
 mod=importlib.util.module_from_spec(spec);sys.modules[name]=mod
 exec(compile(raw,record["path"],"exec"),mod.__dict__)
 return mod

def metadata_guard():
 for path in ABSENT_PATHS:assert not os.path.lexists(path),("declared namespace absence changed",path)
 out=[]
 for row in EPOCH:
  p=Path(row["path"]);a=os.lstat(p);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1
  fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
  try:
   assert f9(a)==f9(os.fstat(fd))==f9(os.lstat(p))==row["full9"],("source metadata drift",str(p))
  finally:os.close(fd)
  out.append({"path":str(p),"bytes":row["bytes"],"sha256":row["sha256"],"full9":f9(a)})
 heads={}
 for project in PROJECTS:
  git=subprocess.run(["/usr/bin/git","-C",project["root"],"rev-parse","HEAD"],capture_output=True,text=True,timeout=10,check=True).stdout.strip()
  assert git==project["Git_HEAD"],("Git HEAD drift",project["root"])
  heads[project["root"]]=git
 p=Path(EVIDENCE["path"]);a=os.lstat(p);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1
 fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
 try:
  assert f9(a)==f9(os.fstat(fd))==f9(os.lstat(p))==EVIDENCE["full9"],"protected canonical evidence metadata changed"
 finally:os.close(fd)
 return {"Git_HEADS":heads,"records":out,"protected_evidence":{"path":str(p),"full9":f9(a)},"Source_body_read_bytes":0,"all_FDs_closed":True}

def genuine(result):
 d=result.to_dict()
 assert not any(d[k]for k in("timed_out","cancelled","unavailable","output_truncated","workspace_limit_exceeded","resource_exhausted")),d
 assert d["workspace_cleaned"] and not d["error"],d
 assert d.get("native_lifecycle",{}).get("cleanup_confirmed") is True,d
 return d

def run_test_with_actual_custody(request, *, origin_owner=None, origin_selection=None,
                                 expected_origin_request_sha256=None, first_use_attempt_raw=None,
                                 expected_first_use_attempt_sha256=None, verify_first_use_dispatch=None,
                                 observe_isolated_source_after_run=None):
 origin_archive = (origin_owner, origin_selection, expected_origin_request_sha256)
 attempt_options = (first_use_attempt_raw, expected_first_use_attempt_sha256, verify_first_use_dispatch)
 if observe_isolated_source_after_run is not None:
  if (not callable(observe_isolated_source_after_run) or any(value is None for value in (*origin_archive, *attempt_options))
      or type(report.get("source_before")) is not dict or not report["source_before"]):
   raise ValueError("isolated preclose requires selected first-use custody and the opening Source guard")
  opening_source = origin_owner._wire(report["source_before"])
 captured_attempt = None
 if any(value is not None for value in attempt_options):
  if any(value is None for value in (*attempt_options, *origin_archive)) or "origin_first_use_attempt" in report:
   raise ValueError("one complete existing-owner first-use attempt selection required")
  operator, _ = sdk._linux_owned_identity(os.getpid())
  attempt = origin_owner.prepare_qwen_import_attempt_dispatch(origin_selection, request, sdk=sdk,
      attempt_raw=first_use_attempt_raw, expected_attempt_sha256=expected_first_use_attempt_sha256,
      operator_birth=(operator.pid, operator.birth_ticks), verify_dispatch_owner=verify_first_use_dispatch)
  captured_attempt = {"dispatch": attempt, "dispatch_sha256": expected_first_use_attempt_sha256,
                      "sdk_return_status": "unobserved", "original_result_sha256": None}
 if any(value is not None for value in origin_archive):
  if any(value is None for value in origin_archive):
   raise ValueError("complete existing-owner origin capture selection required")
  report["origin_capture_selected"] = True
  dispatch = origin_owner.retain_origin_dispatch(origin_selection, request, sdk=sdk,
      expected_request_sha256=expected_origin_request_sha256, retain=retain_origin_owner_bytes)
  sync_origin_output_directory()
  if origin_owner.origin_request_commitment(origin_selection, request, sdk=sdk) != expected_origin_request_sha256:
   raise ValueError("selected SDK request changed while retaining dispatch evidence")
  report["origin_dispatch"] = dispatch
  if captured_attempt is not None:
   report["origin_first_use_attempt"] = captured_attempt
 try:
  result=runner.run(request)
  if origin_owner is None:
   retain_actual_output_files("run",result)
   report["run"]=result.to_dict()
   return result
 except BaseException as error:
  # Only an actual owner supplied by this exact SDK call is usable.
  handle=error.cleanup_handle if type(error)is sdk.OwnedToolCleanupError else None
  report["owned_cleanup_pending"]={"owner":"existing SDK ordinary owned-process cleanup","SDK_returned_result":False,"observations":[],"attempts":0,"original_error_type":type(error).__name__}
  current=error.__traceback__
  while current is not None:
   if current.tb_frame.f_code is sdk.BoundedToolRunner.run.__code__:
    value=current.tb_frame.f_locals.get("result")
    if type(value)is sdk.ToolRunResult:
     try:retain_actual_output_files("run-exception",value)
     except BaseException as raw_retention_error:report["raw_retention_error"]={"type":type(raw_retention_error).__name__,"message":str(raw_retention_error)}
     report["run"]=value.to_dict()
     report["owned_cleanup_pending"]["SDK_result_origin"]="actual SDK run traceback local before error; not a successful return"
    candidate=current.tb_frame.f_locals.get("owned_handle")
    if handle is None and type(candidate)is sdk.NativeToolCleanupHandle:
     handle=candidate
   current=current.tb_next
  if handle is None:
   # No proof that this exception happened before dispatch: retain both READs
   # and this original caller instead of claiming cleanup or releasing them.
   report["owned_cleanup_pending"]["ambiguous_without_actual_handle"]=True
   while True:
    try:
     print(json.dumps({"event":"AMBIGUOUS_ORDINARY_CUSTODY_RETAINED","operator_pid":os.getpid(),"Source_READ_still_held":True,"new_test_dispatch":False}),flush=True)
     time.sleep(5)
    except BaseException as hold_error:
     report["owned_cleanup_pending"]["last_hold_error_type"]=type(hold_error).__name__
  while True:
   report["owned_cleanup_pending"]["attempts"]+=1
   confirmed=False
   try:
    observation=handle.retry_cleanup()
    row=observation.to_dict()
    report["owned_cleanup_pending"]["observations"]=(report["owned_cleanup_pending"]["observations"]+[row])[-32:]
    confirmed=observation.cleanup_confirmed
   except BaseException as retry_error:
    # This includes the owner's own OwnedToolCleanupError: none is a release.
    report["owned_cleanup_pending"]["last_retry_error_type"]=type(retry_error).__name__
   if confirmed:
    report["owned_cleanup_pending"]["confirmed_after_error"]=True
    if captured_attempt is not None:
     captured_attempt["sdk_return_status"] = "no_normal_return"
    # Rethrow only OUTSIDE the retry handler after fresh actual confirmation.
    raise error
   try:
    print(json.dumps({"event":"ACTUAL_ORDINARY_CUSTODY_RETAINED","operator_pid":os.getpid(),"attempts":report["owned_cleanup_pending"]["attempts"],"Source_READ_still_held":True,"new_test_dispatch":False}),flush=True)
    time.sleep(1)
   except BaseException as hold_error:
    report["owned_cleanup_pending"]["last_hold_error_type"]=type(hold_error).__name__

 # The SDK call returned. Retention errors belong to the ordinary owner failure
 # path, outside the handler for an exception thrown by the actual SDK call.
 retained = retain_actual_output_files("run", result)
 report["run"] = result.to_dict()
 captured = origin_owner.retain_origin_sdk_return(result, retained, sdk=sdk, retain=retain_origin_owner_bytes)
 sync_origin_output_directory()
 report["origin_return"] = captured
 if captured_attempt is not None:
  captured_attempt.update(sdk_return_status="returned", original_result_sha256=captured["result_manifest"]["sha256"])
 if observe_isolated_source_after_run is not None:
  after_run = observe_isolated_source_after_run()
  if type(after_run) is not dict:
   raise ValueError("isolated origin Source guard changed after the original SDK return")
  after_run_raw = origin_owner._wire(after_run)
  if after_run_raw != opening_source or origin_owner._wire(report["source_before"]) != opening_source:
   raise ValueError("isolated origin Source guard changed after the original SDK return")
  report["source_after_run"] = json.loads(after_run_raw)
  report["isolated_origin_preclose"] = origin_owner.prepare_isolated_origin_preclose(
      origin_selection, sdk=sdk, request=request, result=result,
      expected_request_sha256=expected_origin_request_sha256,
      expected_result_sha256=captured["result_manifest"]["sha256"])
 return result


def run_selected_isolated_origin(origin, *, origin_owner, actual_control_binding_reference,
                                 verify_control_binding, launch_raw, expected_launch_sha256,
                                 verify_launch_owner):
 """Run the selected isolated import under the original parent and Source reads."""
 render = factory_namespace.get("run_relational_origin_first_use")
 before = report.get("source_before")
 active_reads = report.get("actual_Source_context_closure")
 parent = report.get("actual_parent_lease")
 if (not callable(render) or not callable(metadata_guard) or not callable(verify_launch_owner)
     or type(before) is not dict or before.get("all_FDs_closed") is not True
     or type(active_reads) is not list or not active_reads
     or any(type(row) is not dict or type(row.get("root")) is not str
            or row.get("entered") is not True or row.get("exit_returned") is not False for row in active_reads)
     or type(parent) is not dict or type(parent.get("lease_id")) is not str or not parent["lease_id"]
     or report.get("run") is not None or any(key in report for key in (
         "origin_dispatch", "origin_first_use_attempt", "origin_return", "isolated_origin_preclose"))):
  raise ValueError("one isolated import needs the existing renderer, original opening Source guard and parent custody")
 roots = {row["root"] for row in active_reads}
 heads = before.get("Git_HEADS")
 fields = ("path", "bytes", "sha256", "full9")
 frozen_epoch = epoch_raw
 if (type(frozen_epoch) is not bytes or len(frozen_epoch) != epoch_reference["bytes"]
     or H(frozen_epoch) != epoch_reference["sha256"]):
  raise ValueError("opening Source epoch bytes differ from the selected driver reference")
 sealed_rows = json.loads(frozen_epoch)
 epoch_rows = origin_owner._wire(sealed_rows)
 expected_rows = [{key: row[key] for key in fields} for row in sealed_rows]
 if (origin_owner._wire(EPOCH) != epoch_rows
     or len(roots) != len(active_reads) or type(heads) is not dict or set(heads) != roots
     or origin_owner._wire(before.get("records")) != origin_owner._wire(expected_rows)):
  raise ValueError("opening Source rows or entered lease roots differ from the selected driver epoch")
 opening_raw = origin_owner._wire(before)
 lease_scope = origin_owner._wire(active_reads)
 parent_scope = origin_owner._wire(parent)
 epoch_scope = origin_owner._wire(epoch_reference)
 charged = str(CHARGED_ROOT)

 def current():
  if (origin_owner._wire(report.get("source_before")) != opening_raw
      or origin_owner._wire(report.get("actual_Source_context_closure")) != lease_scope
      or origin_owner._wire(report.get("actual_parent_lease")) != parent_scope
      or origin_owner._wire(epoch_reference) != epoch_scope or epoch_raw != frozen_epoch
      or origin_owner._wire(EPOCH) != epoch_rows or str(CHARGED_ROOT) != charged):
   raise ValueError("isolated import opening Source or parent scope changed before dispatch")

 def verify_selected_launch(*offered):
  allowed = verify_launch_owner(*offered)
  current()
  if origin_owner._wire(report.get("source_epoch_binding")) != epoch_scope:
   raise ValueError("isolated import epoch binding changed before dispatch")
  return allowed

 def dispatch_selected(request, **custody):
  # The renderer authenticated these original bytes against the selected launch.
  binding = json.loads(request.input_files["control-binding.json"])
  selection = json.loads(request.input_files["request.json"])
  epoch = binding["source_epoch_reference"]
  prior = report.get("source_epoch_binding")
  current()
  if (origin_owner._wire(epoch) != epoch_scope
      or (prior is not None and origin_owner._wire(prior) != epoch_scope)
      or selection["source_sha256"] != {row["path"]: row["sha256"] for row in expected_rows}
      or selection["cwd"] not in roots or str(Path(selection["attempt_directory"]).parent) != charged
      or custody.get("observe_isolated_source_after_run") is not metadata_guard):
   raise ValueError("selected isolated request, Source epoch, charged root or return guard differs")
  report["source_epoch_binding"] = dict(epoch)
  return run_test_with_actual_custody(request, **custody)

 return render(origin, origin_owner=origin_owner, sdk=sdk, python=PY, environment=FLAGS,
     actual_control_binding_reference=actual_control_binding_reference, verify_control_binding=verify_control_binding,
     launch_raw=launch_raw, expected_launch_sha256=expected_launch_sha256, verify_launch_owner=verify_selected_launch,
     run_with_actual_custody=dispatch_selected, observe_isolated_source_after_run=metadata_guard)


def retain_origin_owner_bytes(name, raw):
 if type(name) is not str or not re.fullmatch(r"origin\.[a-z0-9.-]+", name) or type(raw) is not bytes:
  raise ValueError("exact owner origin artifact name and bytes required")
 path = RUN_OUTPUT / name
 fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
 with os.fdopen(fd, "wb") as stream:
  stream.write(raw)
  stream.flush()
  os.fsync(stream.fileno())
 return {"path": str(path), "bytes": len(raw), "sha256": H(raw)}


def sync_origin_output_directory():
 fd = os.open(RUN_OUTPUT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
 try:
  os.fsync(fd)
 finally:
  os.close(fd)


def origin_retained_external_bytes():
 # Storage finalization includes incomplete writes and exception outputs.
 total = 0
 with os.scandir(RUN_OUTPUT) as records:
  for record in records:
   if record.name.startswith("origin.") or re.fullmatch(r"run(?:-exception)?\.output\.[0-9]+\.bin", record.name):
    info = record.stat(follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
     raise ValueError("origin evidence storage requires single-link regular files")
    total += info.st_size
 return total


def retain_actual_output_files(phase, result):
 from collections.abc import Mapping
 outputs=result.output_files
 if not isinstance(outputs, Mapping):
  raise TypeError("SDK output_files must preserve the actual bytes mapping")
 retained=[]
 for index,(logical_name,raw) in enumerate(outputs.items()):
  if type(logical_name)is not str or type(raw)is not bytes:
   raise TypeError("SDK output file names and exact bytes required")
  path=RUN_OUTPUT/(phase+".output."+str(index)+".bin")
  fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400)
  with os.fdopen(fd,"wb")as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
  retained.append({"logical_name":logical_name,"path":str(path),"bytes":len(raw),"sha256":H(raw),"origin":"actual ToolRunResult.output_files bytes; not to_dict decoded text"})
 report[phase+"_raw_output_files"]=retained
 return retained

import importlib

def observe_control_and_CAS_metadata(database,artifact_root):
 pool=disk._inventory([artifact_root],strict=True)
 observed=database.lstat();assert stat.S_ISREG(observed.st_mode)and observed.st_nlink==1
 return {'database':{'path':str(database),'bytes':observed.st_size,'full9':f9(observed)},
  'artifact_root':str(artifact_root),'pool_inventory':pool,'content_bodies_read':False}

def observe_state():
 for attempt in range(5):
  before=STATE.lstat();assert stat.S_ISREG(before.st_mode)and before.st_size<65536
  fd=os.open(STATE,os.O_RDONLY|os.O_NOFOLLOW)
  try:
   opened=os.fstat(fd);raw=os.read(fd,65537);end=os.fstat(fd)
  finally:os.close(fd)
  after=STATE.lstat()
  if f9(before)==f9(opened)==f9(end)==f9(after)and len(raw)==before.st_size:
   return {'full9':f9(after),'bytes':len(raw),'sha256':H(raw),'state':json.loads(raw)}
 raise RuntimeError('bounded resource snapshot identity changed')

