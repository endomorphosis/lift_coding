"""Exercise startup and terminal accounting with modeled Source and Git custody."""
import ast
import json
from pathlib import Path
import sys
import time
from types import SimpleNamespace
import unittest

HERE = Path(__file__).resolve().parent
RES = HERE.parent/'decoder-training-stage-a-relocated-reservation-private-v01-Pb5rVPUy'
sys.path.insert(0,str(RES))
from test_reader_v3 import RelocatedReader as Fixture, checked, digest, wire

BINDING = Path('/tmp/Reader-P1-current-published-Source-and-assets-read-preparation-private-v01/'
               'actual-Source42-doc-owner-current-control-binding-v01.json')


class OwnerStartup(unittest.TestCase):
    def setUp(self):
        self.fixture = f = Fixture()
        f.setUp()
        self.addCleanup(f.doCleanups)
        self.h = h = f.h
        self.preview = f.preview
        self.git = f.git
        h.owner.update(source=None)
        h.owner['request']['Source_envelope'] = 48*1024**2
        self.git['verify_standalone_git'].__globals__.update(R=Path(f.roots[0]),A=Path(f.roots[1]))
        owner = HERE/'reader.py.DATA'
        raw = checked((owner,50286,'b7380b24e0320f9745716a41c253c2871896fc825c824f9bb9b699ff20851241'))
        functions = [node for node in ast.parse(raw).body if type(node) is ast.FunctionDef
                     and node.name in ('admit','run_selected_relocated_stage_a_owner')]
        self.assertEqual(len(functions),2)
        h.owner.update(traceback=__import__('traceback'))
        exec(compile(ast.Module(functions,type_ignores=[]),str(owner),'exec'),h.owner)

        # The prepared private preview is already present in the authorized parent's memory.
        preview_path = Path(f.ref['path'])
        h.given_data[str(preview_path)] = preview_path.read_bytes()
        h.output = h.output/'fresh-owner-output'
        h.owner['OUT'] = h.output
        self.reader = f.selection | dict(output_root=str(h.output))
        binding_raw = checked((BINDING,2297,'43c18000562ed03baf5df2d0cea8260682063078822ed7ff23208ba47c4ea674'))
        binding = json.loads(binding_raw)
        code = binding['code_reference']
        h.given_data[code['path']] = checked((Path(code['path']),10375,code['sha256']))
        current = time.time_ns()
        self.startup = dict(schema='selected-existing-StageA-Reader-owner-startup/v1',
            reader_selection_sha256=digest(wire(self.reader)),preview_sha256=digest(wire(self.preview)),
            ledger_before=h.owner['before'],Source_envelope=h.owner['request']['Source_envelope'],
            terminal_receipt_max_bytes=2**20,output_root=str(h.output),
            not_before_utc_ns=current-1_000_000_000,deadline_utc_ns=current+5_000_000_000,
            source_code=code,source_original_module_path=binding['original_module_path'])
        self.load_calls=[]
        self.close_calls=[]
        self.bad_root=False
        self.allow_cleanup=True

    def load(self,raw,path):
        self.load_calls.append((len(raw),digest(raw),path))
        return SimpleNamespace(canonical_source_root=lambda root: '/other/root' if self.bad_root else root)

    def cleanup(self,source):
        self.close_calls.append(source)
        self.h.events.append(('module','cleanup'))
        return self.allow_cleanup

    def run_owner(self, *, verify=lambda *_:True):
        return self.h.owner['run_selected_relocated_stage_a_owner'](
            self.preview,startup=self.startup,expected_startup_sha256=digest(wire(self.startup)),
            reader_selection=self.reader,verify_startup=verify,verify_reader_selection=lambda *_:True,
            verify_relocation_owner=lambda *_:True,load_source=self.load,cleanup_source=self.cleanup,
            epoch_api=self.fixture.epoch,git_api=self.git,io=None,read_stage_zero=lambda *_:None,
            deadline=time.monotonic()+4)

    def test_success_snapshot_has_closed_module_and_exact_terminal_debits(self):
        receipt = self.run_owner()
        raw = Path(receipt['path']).read_bytes()
        terminal = json.loads(raw)
        self.assertEqual(receipt['sha256'],digest(raw))
        self.assertEqual(terminal['stage_a']['body_capture_count'],32)
        self.assertEqual(terminal['errors'],[])
        self.assertTrue(all(terminal[key] for key in ('Root_selected','read_complete','Source_closed','owned_module_closed')))
        self.assertEqual(self.h.spent['bytes']-terminal['explicit_IO_before_closeout']['bytes'],2*len(raw))
        self.assertEqual(self.h.spent['captures']-terminal['explicit_IO_before_closeout']['captures'],1)
        self.assertLess(self.h.events.index(('Source','exit checked')),self.h.events.index(('module','cleanup')))
        self.assertLess(self.h.events.index(('module','cleanup')),self.h.events.index(('read','exact_stage_a_child_closeout_readback')))
        self.assertEqual(sum(event==('read','selected_stage_a_relocation_preview') for event in self.h.events),1)

    def test_owner_refusal_has_no_active_namespace_or_io(self):
        with self.assertRaisesRegex(ValueError,'original owner refused'):
            self.run_owner(verify=lambda *_:False)
        self.assertFalse(self.h.output.exists())
        self.assertEqual(self.h.events,[])
        self.assertEqual(self.load_calls,[])

    def test_selection_mutation_refuses_before_effects(self):
        def mutate(*args):
            self.reader['maximum_core_bytes']+=1
            return True
        with self.assertRaisesRegex(ValueError,'selection changed'):
            self.run_owner(verify=mutate)
        self.assertFalse(self.h.output.exists())
        self.assertEqual(self.load_calls,[])

    def test_terminal_reserve_counts_before_any_effect(self):
        self.startup['terminal_receipt_max_bytes']=16*1024**2
        with self.assertRaisesRegex(RuntimeError,'selected READ envelope insufficient'):
            self.run_owner()
        self.assertFalse(self.h.output.exists())
        self.assertEqual(self.h.events,[])

    def test_prelease_root_refusal_cleans_module_and_records_negative_closeout(self):
        self.bad_root=True
        receipt=self.run_owner()
        terminal=json.loads(Path(receipt['path']).read_bytes())
        self.assertTrue(terminal['owned_module_closed'])
        self.assertFalse(terminal['Source_closed'] or terminal['read_complete'])
        self.assertEqual(terminal['Source_contexts'],[])
        self.assertEqual(len(terminal['errors']),1)
        self.assertEqual(len(self.close_calls),1)

    def test_unconfirmed_source_exit_keeps_original_module_and_no_receipt(self):
        self.h.close_failure=True
        self.assertIsNone(self.run_owner())
        self.assertIsNotNone(self.h.owner['source'])
        self.assertEqual(self.close_calls,[])
        self.assertFalse(self.h.report['Source_closed'])
        self.assertFalse((self.h.output/'actual-existing-StageA-v3-Reader-child.json').exists())

    def test_unconfirmed_module_cleanup_refuses_terminal_receipt(self):
        self.allow_cleanup=False
        self.assertIsNone(self.run_owner())
        self.assertTrue(self.h.report['Source_closed'])
        self.assertFalse(self.h.report['owned_module_closed'])
        self.assertIsNotNone(self.h.owner['source'])
        self.assertFalse((self.h.output/'actual-existing-StageA-v3-Reader-child.json').exists())

    def test_git_namespace_must_hold_selected_roots(self):
        self.git['verify_standalone_git'].__globals__['R']=Path('/fixture/other-datasets')
        with self.assertRaisesRegex(ValueError,'original owner refused'):
            self.run_owner()
        self.assertFalse(self.h.output.exists())


if __name__=='__main__':
    suite=unittest.defaultTestLoader.loadTestsFromTestCase(OwnerStartup)
    raise SystemExit(not unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful())
