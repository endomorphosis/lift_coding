 def verify_all_paid_phases(
@@ -464,3 +465,84 @@
             "physical_paid_events": tuple(ledger._wire(union[key]) for key in sorted(union)),
             "observed_exclusive_physical_work_ns": ledger._physical_work_ns(union),
             "dispatch_authority": False, **wall}
+
+
+TEACHER_PILOT_PREPARATION_STOP_WALL_SCHEMA = "reviewed-teacher-pilot-preparation-stop-first-use-wall/v1"
+
+
+def verify_teacher_pilot_preparation_stop_wall(
+        ledger, validator, source_owner, physical_owner, *, expected_preparation_stop_sha256,
+        first_use_wall, expected_first_use_wall_sha256, verify_first_use_wall_owner, **preparation_args):
+    """Replay a selected terminal stop, including a genuine zero-paid preparation stop.
+
+    The existing study verifies the roster, the coverage and both dispatch
+    closes when a replacement producer was tried. All decoder slots must be
+    independently unstarted before first-use time can end at this stop.
+    """
+    require(ledger._pin(expected_preparation_stop_sha256) and callable(verify_first_use_wall_owner),
+            "exact original preparation stop and independent clock owner required")
+
+    def input_commitment():
+        return ledger.commitment({key: (sha256(value).hexdigest() if type(value) is bytes else value)
+                                  for key, value in preparation_args.items() if not callable(value)})
+
+    initial = input_commitment()
+
+    def current():
+        require(teacher_pilot_first_use_wall_commitment(ledger, expected_preparation_stop_sha256, first_use_wall)
+                == expected_first_use_wall_sha256 and input_commitment() == initial,
+                "selected preparation stop or first-use wall witness changed")
+
+    current()
+    seen = {}
+    replay = preparation_args.get("replay_preparation_close")
+
+    def capture(row):
+        selected = dict(row)
+        observed = replay(row)
+        current()
+        event = selected["event_sha256"]
+        require(type(observed) is physical_owner.PhysicalClose and event not in seen,
+                "exact once-per-event original preparation close required")
+        seen[event] = selected, deepcopy(observed)
+        return observed
+
+    original_args = dict(preparation_args)
+    if callable(replay):
+        original_args["replay_preparation_close"] = capture
+    report = ledger.summarize_teacher_pilot_preparation_stop(validator, source_owner, physical_owner, **original_args)
+    current()
+    require(report["schema"] in (ledger.TEACHER_PILOT_PREPARATION_STOP_SCHEMA,
+                                 ledger.TEACHER_PILOT_PREPARATION_RECOVERY_STOP_SCHEMA)
+            and report["dispatch_authority"] is False and ledger.commitment(report) == expected_preparation_stop_sha256,
+            "exact independently selected terminal preparation stop required")
+    scope = report["decoder_dispatch"]
+    require(len(scope) == 1 + 2 * len(ledger.MATRIX_TEACHERS)
+            and tuple(row["arm"] for row in scope) == tuple(arm for arm, _ in preparation_args["study"].arms)
+            and all(row["dispatch_status"] == "confirmed_unstarted" and row["decoder_attempt_sha256"] is None for row in scope)
+            and ledger._pin(report.get("no_dispatch_sha256")) and ledger._pin(report.get("no_dispatch_owner_close_sha256"))
+            and ("recovery_coverage_sha256" not in report or (
+                ledger._pin(report.get("recovery_no_dispatch_sha256"))
+                and ledger._pin(report.get("recovery_no_dispatch_owner_close_sha256")))),
+            "a preparation-only wall requires authenticated unstarted evidence for every original decoder arm")
+    refs = report.get("paid_preparation_event_refs", report["original_paid_preparation_event_refs"])
+    require(report["paid_preparation_event_count"] == len(seen)
+            and tuple(map(tuple, refs)) == tuple((event, leaf.close_sha256) for event, (_, leaf) in sorted(seen.items())),
+            "preparation-only elapsed span must bind every original paid preparation event")
+    reserved = {value for key, value in report.items() if key.endswith("_sha256") and ledger._pin(value)}
+    reserved.update((expected_preparation_stop_sha256, preparation_args["plan"].requests_sha256))
+    for field in ("profiles", "recovery_profiles"):
+        reserved.update(row["owner_close_sha256"] for row in report.get(field, ()))
+
+    def approve(*pins):
+        decision = verify_first_use_wall_owner(*pins)
+        current()
+        require(ledger.commitment(report) == expected_preparation_stop_sha256,
+                "selected original preparation stop changed during clock approval")
+        return decision
+
+    wall = _teacher_pilot_first_use_wall(ledger, expected_preparation_stop_sha256, first_use_wall,
+        expected_first_use_wall_sha256, seen, reserved, approve, allow_empty=True,
+        scope="pilot_opening_through_independently_authenticated_preparation_stop")
+    return {"schema": TEACHER_PILOT_PREPARATION_STOP_WALL_SCHEMA, "preparation_stop_sha256": expected_preparation_stop_sha256,
+            "preparation_stop": report, "first_use_wall": wall, "dispatch_authority": False}
