+def run_selected_stage_a_selector_owner(expected_roots, *, startup, expected_startup_sha256,
+        verify_startup,load_source,cleanup_source,git_api,deadline):
+    """Capture and close the original paired selector in the selected Source owner."""
+    def encoded(value):
