+def _stage_a_owner_code(chosen,roots):
+    code = chosen['source_code']
+    module_path = chosen['source_original_module_path']
+    if (type(code) is not dict or set(code) != {'path','bytes','sha256','full9'}
+            or code['bytes'] != 10375 or code['sha256'] !=
+                '42e9f07d0d458177079269d9f495f0b70512180c1adc2f7fe0bfdb05518a12f9'
+            or type(module_path) is not str or not Path(module_path).is_absolute()
+            or type(code['path']) is not str or not Path(code['path']).is_absolute()
+            or any(Path(code['path']).is_relative_to(root) for root in roots)
+            or Path(code['path']).resolve(strict=True) != Path(code['path'])):
+        raise ValueError('exact approved Source42 control and module path required')
+    return code,module_path
+
+
+def _stage_a_owner_prepare(chosen,roots,startup_sha,business_bytes,code_bytes,subdirs=()):
+    if (not OUT.is_absolute() or '..' in OUT.parts or any(OUT.is_relative_to(root) for root in roots)
+            or OUT.resolve()!=OUT or os.path.lexists(OUT)):
+        raise ValueError('fresh literal private Stage A output required')
+    cap = chosen['Source_envelope']
+    terminal_bound = 2*chosen['terminal_receipt_max_bytes']+1
+    report['selected_stage_a_operator_envelope'] = cap
+    admit(business_bytes+code_bytes+1+terminal_bound)
+    report.update(stage_a_owner_startup_sha256=startup_sha,
+                  selected_stage_a_operator_envelope=cap-terminal_bound,
+                  selected_stage_a_terminal_reservation=terminal_bound,
+                  Root_selected=True,operator_pid=os.getpid(),read_complete=False,owned_module_closed=False)
+    parents(OUT)
+    OUT.mkdir(mode=0o700)
+    for name in subdirs:
+        (OUT/name).mkdir(mode=0o700)
+
+
+def _stage_a_owner_error(error,phase):
+    report['errors'].append(dict(type=type(error).__name__,message=str(error),phase=phase,
+                                 traceback=traceback.format_exc()))
+
+
+def _stage_a_owner_source42(roots,code,module_path,load_source,cleanup_source,in_window,operation):
+    """Run the owner's selected operation and preserve uncertain custody in this process."""
+    global source
+    value = None
+    try:
+        leaf(code)
+        raw = control_read(code,'approved_existing_Source42_code')
+        leaf(code)
+        if len(raw) != code['bytes'] or H(raw) != code['sha256'] or not in_window():
+            raise ValueError('Source42 pin or owner startup deadline changed')
+        source = load_source(raw,module_path)
+        if tuple(str(source.canonical_source_root(root)) for root in roots) != roots or not in_window():
+            raise ValueError('Source42 root or deadline changed before Stage A')
+        value = operation()
+        if not in_window():
+            raise ValueError('Stage A operation exceeded original launch window')
+        report['read_complete'] = True
+    except Exception as error:
+        _stage_a_owner_error(error,'source_operation')
+    finally:
+        contexts = report['Source_contexts']
+        exited = all(row['exit_returned'] is True for row in contexts)
+        report['Source_closed'] = contexts == [
+            {'root':root,'mode':'read','entered':True,'exit_returned':True} for root in sorted(roots)]
+        if source is not None and exited:
+            try:
+                report['owned_module_closed'] = cleanup_source(source) is True
+            except Exception as error:
+                _stage_a_owner_error(error,'owned_module_cleanup')
+            if report['owned_module_closed']:
+                source = None
+    return value,exited and source is None
+
+
+def _stage_a_owner_archive(path,raw,kind):
+    admit(2*len(raw)+1)
+    spent['bytes'] += len(raw)
+    reference = seal(path,raw)
+    if control_read(reference,kind) != raw:
+        raise ValueError('selected Stage A private artifact differs after readback')
+    return reference
+
+
+def _stage_a_owner_child_receipt(chosen,body,path,kind):
+    if len(body)>chosen['terminal_receipt_max_bytes']:
+        raise ValueError('selected Stage A terminal receipt exceeds its reserved bound')
+    reference = _stage_a_owner_archive(path,body,kind)
+    for directory in (OUT, OUT.parent):
+        fd = os.open(directory,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+    return reference
