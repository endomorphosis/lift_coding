+              'source_code','source_original_module_path'}
+    integer_fields = ('Source_envelope','terminal_receipt_max_bytes','not_before_utc_ns',
+                      'deadline_utc_ns','maximum_run_seconds')
+    if (not __debug__ or type(chosen) is not dict or set(chosen) != fields
+            or chosen['schema'] != 'selected-existing-StageA-selector-owner-startup/v1'
+            or H(raw_startup) != expected_startup_sha256 or chosen['expected_roots_sha256'] != H(raw_roots)
+            or any(type(chosen[key]) is not int or chosen[key] <= 0 for key in integer_fields)
+            or type(deadline) not in (int,float) or not 0 < deadline-time.monotonic() <= chosen['maximum_run_seconds']
+            or not in_window() or chosen['ledger_before'] != before
+            or chosen['Source_envelope'] != request['Source_envelope']
+            or chosen['output_root'] != str(OUT)
