"""Bind the maintained Native cache helper to the existing caller-owned runner.

Private profile binding only. No project import, scheduler, lease, runner,
Source operation, subprocess or Native command is constructed by this module.
The existing direct owner supplies its actual admitted runner and observations.
"""
from __future__ import annotations
import ast
import hashlib
import sys

OWNING_TEST_SHA256 = 'b706ba0dddc5795055be378d8393c831e65fb7fbaf73a574fcee51227d3676b5'
OWNING_TEST_BYTES = 128091
FIXTURE_SHA256 = '23543784354ebcc0c3b58860d14c80cc7171b0ed9e3f86a5b5ddcc70e63423ab'
HELPER_NAME = "_assert_lean_native_v3_proof_cache_round_trip"
LOADER_NAME = "_load_native_proof_cache_fixture_owner"
WRAPPER_NAME = "test_lean_native_v3_proof_cache_round_trip_and_exact_reuse_context"
CASE_PROFILE = 'P1-native-cache-controlled-translation/v1'

def bind_existing_native_cache_exact_reuse(owning_test_namespace, *, owning_test_source_bytes,
        caller_owned_runner, caller_owned_processes, executable, version):
    if type(owning_test_source_bytes) is not bytes:
        raise TypeError("exact authenticated owning-test bytes required")
    if (len(owning_test_source_bytes) != OWNING_TEST_BYTES or
            hashlib.sha256(owning_test_source_bytes).hexdigest() != OWNING_TEST_SHA256):
        raise ValueError("owning-test source identity differs from cache binding")
    names = {
        "sdk": "ipfs_datasets_py.logic.backends.process",
        "admitted": "ipfs_datasets_py.logic.backends.resource_admission",
        "lean": "ipfs_datasets_py.logic.backends.kernel.lean",
        "resources": "ipfs_datasets_py.optimizers.logic_theorem_optimizer.resource_scheduler",
        "protocols": "ipfs_datasets_py.logic.ir_core.protocols",
    }
    modules = {key: sys.modules.get(name) for key, name in names.items()}
    if any(module is None for module in modules.values()):
        raise ValueError("caller must load the existing canonical module graph")
    sdk, admitted, lean, resources, protocols = (modules[key] for key in
        ("sdk", "admitted", "lean", "resources", "protocols"))
    if not (sdk.ToolRunRequest is admitted.ToolRunRequest and
            sdk.ToolRunResult is admitted.ToolRunResult and
            admitted.GlobalResourceScheduler is resources.GlobalResourceScheduler and
            owning_test_namespace["ToolRunRequest"] is sdk.ToolRunRequest and
            owning_test_namespace["ToolRunLimits"] is sdk.ToolRunLimits and
            owning_test_namespace["BoundedToolRunner"] is sdk.BoundedToolRunner and
            owning_test_namespace["LeanKernelBackend"] is lean.LeanKernelBackend and
            owning_test_namespace["ExecutionBounds"] is protocols.ExecutionBounds and
            lean.ResourceAdmittedToolRunner is admitted.ResourceAdmittedToolRunner):
        raise ValueError("caller-owned SDK, scheduler or owning-test identities differ")
    if not isinstance(caller_owned_runner, admitted.ResourceAdmittedToolRunner):
        raise TypeError("actual caller-owned ResourceAdmittedToolRunner required")
    if caller_owned_runner.cpu_slots != 1 or caller_owned_runner.child_process_slots != 1:
        raise ValueError("preserve the existing one-CPU/one-child runner profile")
    parent = getattr(caller_owned_runner, "_parent_lease", None)
    if not isinstance(parent, resources.ResourceLease) or parent.released:
        raise ValueError("existing owner must supply its actual live parent lease")
    if type(caller_owned_runner._executor) is not sdk.SubprocessExecutor:
        raise TypeError("unchanged real SubprocessExecutor required by maintained helper")
    if type(caller_owned_processes) is not list or caller_owned_processes:
        raise ValueError("fresh caller-owned actual-process observation list required")
    environment = owning_test_namespace["os"].environ
    if environment.get("IPFS_DATASETS_RUN_NATIVE_LEAN") != "1":
        raise ValueError("existing explicit Native Lean opt-in must be selected")
    if (version != "4.34.1" or environment.get("IPFS_DATASETS_LEAN_VERSION") != version or
            environment.get("IPFS_DATASETS_LEAN_EXECUTABLE") != executable):
        raise ValueError("exact selected toolchain executable/version required")
    original = ast.parse(owning_test_source_bytes)
    for name in (HELPER_NAME, LOADER_NAME, WRAPPER_NAME):
        selected = [node for node in original.body if isinstance(node, ast.FunctionDef) and node.name == name]
        if len(selected) != 1:
            raise ValueError("exact maintained cache helper/loader/wrapper required")
        function = owning_test_namespace[name]
        if function.__code__.co_filename != owning_test_namespace["__file__"]:
            raise ValueError("maintained function source origin differs")
        if function.__globals__ is not owning_test_namespace:
            raise ValueError("maintained function namespace differs")
    if owning_test_namespace["_NATIVE_PROOF_CACHE_FIXTURE_SHA256"] != FIXTURE_SHA256:
        raise ValueError("exact current dynamically compiled fixture pin required")
    helper = owning_test_namespace[HELPER_NAME]
    def bound(tmp_path):
        if caller_owned_processes:
            raise ValueError("cache caller observation list was already used")
        bounds = protocols.ExecutionBounds(timeout_ms=15000, max_steps=100,
            max_memory_bytes=4 * 1024**3, max_output_bytes=65536)
        return helper(tmp_path, runner=caller_owned_runner, processes=caller_owned_processes,
            executable=executable, version=version, bounds=bounds)
    bound.__name__ = "existing_native_cache_exact_reuse_caller"
    return bound
