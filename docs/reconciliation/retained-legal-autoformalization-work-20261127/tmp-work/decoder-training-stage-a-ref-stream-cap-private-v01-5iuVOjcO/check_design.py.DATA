def project_reciprocal_activation_panel(reference):
    from base64 import b64decode

    descriptor = retained_json(reference)
    fixture = retained_json(descriptor["portable_fixture"])
    raw = b64decode(fixture["selection_base64"], validate=True)
    selection = json.loads(raw)
    result = fixture["readback"]
    require(descriptor["schema"] == "reciprocal-activation-panel-private-controls/v1"
            and descriptor["local_controls"] == {"panel": 9, "retained_t5": 7}
            and descriptor["actual_semantic_review"] is descriptor["native_activation_measurement"]
                is descriptor["maintained_source_adoption"] is None
            and descriptor["dispatch_authority"] is False
            and sha256(raw).hexdigest() == result["selection_sha256"]
            and selection["split"] == result["split"] == "development"
            and selection["facet"] == result["facet"] == "modality"
            and result["evidence_kind"] == "modeled_fixture",
            "activation panel fixture and scope differ from their retained selection")
    projected, originals = result["routes"], fixture["original_route_readbacks"]
    require(len(projected) == len(originals) == len(selection["routes"]) == 2
            and [row["architecture"] for row in projected] == ["t5", "qwen2"],
            "both original activation routes required")
    for route, selected, original in zip(projected, selection["routes"], originals, strict=True):
        raw = b64decode(original["base64"], validate=True)
        require((len(raw), sha256(raw).hexdigest()) == (original["bytes"], original["sha256"])
                and route["readback_sha256"] == selected["readback_sha256"] == original["sha256"]
                and all(route[key] == value for key, value in selected.items()),
                "original activation readback or projected binding differs")
    t5, qwen = projected
    right = qwen["directions"][1]
    require([row["target_exceeds_both_controls"] for row in t5["directions"]] == [True, True]
            and [row["target_exceeds_both_controls"] for row in qwen["directions"]] == [True, False]
            and right["cross_patch_toward_donor"] == right["random_toward_donor"] == 11.0
            and result["disposition"] == "reciprocal_selectivity_not_established_across_routes"
            and result["source_fidelity_inferred"] is result["dispatch_authority"] is False,
            "modeled control tie must remain material to the panel disposition")
    return {"passing_local_controls": descriptor["local_controls"],
            "modeled_directional_selectivity": {"t5": [True, True], "qwen2": [True, False]},
            "native_activation_measurement": None, "actual_semantic_review": None,
            "dispatch_authority": False}

def project_qwen_original_activation_discovery(reference):
    from base64 import b64decode

    def original(ref):
        raw = b64decode(ref["raw_base64"], validate=True)
        require((len(raw), sha256(raw).hexdigest()) == (ref["bytes"], ref["sha256"]),
                "retained Qwen2 original body changed")
        return raw

    descriptor = retained_json(reference)
    raw = retained_json(descriptor["portable_fixture"])
    fixture = raw["original_fixture"]
    selection = json.loads(original(fixture["selection"]))
    result = fixture["report"]
    roles = selection["roles"]
    forwards = fixture["all_twelve_requests_and_forwards"]
    require(descriptor["schema"] == "qwen2-original-activation-discovery-private-controls/v1"
            and descriptor["local_controls"] == {"original_discovery": 9, "retained_panel": 9}
            and descriptor["actual_semantic_review"] is descriptor["native_activation_measurement"]
                is descriptor["maintained_source_adoption"] is None
            and descriptor["dispatch_authority"] is False
            and len(roles) == len(forwards) == 12 and result["forward_roles"] == roles
            and sha256(original(fixture["seeded"])).hexdigest()
                == selection["seeded_evidence_sha256"] == result["seeded_evidence_sha256"]
            and selection["split"] == result["split"] == "discovery"
            and selection["evidence_kind"] == result["evidence_kind"] == "modeled_fixture"
            and result["selection_sha256"] == fixture["selection"]["sha256"],
            "Qwen2 discovery fixture changed or exceeded its modeled scope")
    for (req, out), role in zip(forwards, roles, strict=True):
        require(sha256(original(req)).hexdigest() == role["request_sha256"]
                and sha256(original(out)).hexdigest() == role["forward_sha256"],
                "Qwen2 discovery original forward roster changed")
    left, right = result["directions"]
    counterexample = raw["signed_sham_counterexample"]
    dose = raw["wrong_sham_dose_counterexample"]
    request = json.loads(original(dose["lower_dose_request"]))
    actual = json.loads(original(dose["authentic_modeled_forward"]))
    selected_cross = json.loads(original(forwards[5][0]))
    require(request["position_control"]["expected_target_sha256"] != selected_cross["expected_donor_sha256"]
            and actual["activation_intervention"]["replacement"]["position_control"]["target_sha256"]
                == request["position_control"]["expected_target_sha256"]
            and dose["refused_before_seeded_cast"] is True,
            "the authentic alternate-dose sham regression must retain both distinct donor pins")
    require(result["both_directions_meet_selected_policy"] is False
            and [left["meets_selected_effect_policy"], right["meets_selected_effect_policy"]] == [True, False]
            and right["control_qualified"] is True
            and right["cross_patch_toward_donor"] == right["random_toward_donor"] == 11.0
            and result["source_fidelity_inferred"] is result["dispatch_authority"] is False
            and counterexample["old_accepted_resealed_geometry"] is True
            and counterexample["new_refused_before_owner_and_seeded_cast"] is True,
            "Qwen2 discovery qualification or recovered original sham counterexample changed")
    return {"passing_local_controls": descriptor["local_controls"], "original_modeled_forward_roles": len(roles),
            "both_directions_meet_selected_policy": False, "native_activation_measurement": None,
            "actual_semantic_review": None, "training_credit_assignment_changed": False, "dispatch_authority": False}

def project_qwen_guided_cached_anchor(reference):
    from base64 import b64decode

    def original(ref):
        raw = b64decode(ref["raw_base64"], validate=True)
        require((len(raw), sha256(raw).hexdigest()) == (ref["bytes"], ref["sha256"]),
                "retained Qwen2 guidance body changed")
        return json.loads(raw)

    descriptor = retained_json(reference)
    fixture = retained_json(descriptor["portable_fixture"])
    passed, refused = fixture["positive"], fixture["original_negative"]
    mapping = original(passed["mapping"])
    discovery = original(passed["discovery"])
    negative = original(refused["readback"])
    readback, selection = passed["readback"], passed["selection"]
    guided, control = readback["guided"], readback["control"]
    require(descriptor["schema"] == "qwen2-guided-cached-anchor-private-controls/v1"
            and descriptor["local_controls"] == {"focused_guidance": 9, "retained_scope": 6}
            and descriptor["actual_semantic_review"] is descriptor["native_activation_measurement"]
                is descriptor["maintained_source_adoption"] is None
            and descriptor["dispatch_authority"] is False
            and mapping["guided_selection_sha256"] == readback["selection_sha256"]
            and mapping["discovery_selection_sha256"] == discovery["selection_sha256"]
            and mapping["evidence_kind"] == discovery["evidence_kind"] == "modeled_fixture"
            and discovery["both_directions_meet_selected_policy"] is True
            and selection["discovery_receipt_sha256"] == passed["discovery"]["sha256"]
            and mapping["direction_policy_sha256"] == selection["direction_policy_sha256"]
            and mapping["materialized_replay_binding_sha256"] == readback["materialized_replay"]["binding_sha256"]
            and selection["credit_sha256"] == guided["credit_sha256"] == control["credit_sha256"]
            and len(readback["materialized_replay"]["common_sample_sha256s"]) == 10
            and readback["scored_action_counts"] == [2, 2]
            and readback["model_forward_observed"] is readback["optimizer_step_observed"] is False
            and readback["materialized_replay"]["worker_admission_granted"] is False,
            "modeled guided allocation must retain its discovery, independent reward, and original replay binding")
    require([row["action_position"] for row in guided["slots"]] == [0, 0]
            and [row["action_position"] for row in control["slots"]] == [3, 3]
            and [row["sample_sha256"] for row in guided["slots"]]
                == [row["anchor_sample_sha256"] for row in mapping["train_action_mapping"]]
            and [row["advantage"] for row in guided["slots"]] == [row["advantage"] for row in control["slots"]]
                == passed["guide_control_advantages"] == [-0.5, 0.5]
            and passed["common_reward_and_advantages_unchanged"] is True
            and negative["both_directions_meet_selected_policy"] is False
            and negative["evidence_kind"] == "modeled_fixture"
            and len(negative["forward_roles"]) == refused["replayed_original_roles"] == 12
            and refused["no_mapping_or_common_owner_called"] is True,
            "Qwen2 guidance must retain both matched allocations and the authentic archived control refusal")
    return {"passing_local_controls": descriptor["local_controls"], "modeled_opening_scored_actions_per_arm": [2, 2],
            "modeled_common_cache_rows": 10, "original_discovery_roles_replayed_before_refusal": 12,
            "actual_guided_training": None, "actual_legal_review": None, "dispatch_authority": False}

