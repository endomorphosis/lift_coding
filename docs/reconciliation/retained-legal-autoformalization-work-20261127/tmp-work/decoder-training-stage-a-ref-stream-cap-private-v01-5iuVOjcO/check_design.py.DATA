        require((len(raw), sha256(raw).hexdigest()) == (ref["bytes"], ref["sha256"]),
                "retained Qwen2 worker boundary evidence changed")
        return json.loads(raw)

    descriptor = retained_json(reference)
    fixture = retained_json(descriptor["portable_fixture"])
    proof = fixture["false_native_pass"]
    admission = original(proof["selected_admission"])
    claim = original(proof["claimed_discovery"])
    ordered = [[side, condition] for side in ("left", "right") for condition in
               ("baseline", "observation", "no_op", "sham", "random", "cross_patch")]
    require(descriptor["schema"] == "qwen2-native-discovery-admission-private-controls/v1"
