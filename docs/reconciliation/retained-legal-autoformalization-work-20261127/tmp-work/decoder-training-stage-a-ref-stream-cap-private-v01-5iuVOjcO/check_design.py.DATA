            and claim["split"] == "discovery" and claim["both_directions_meet_selected_policy"] is True
            and admission["discovery_receipt_sha256"] == proof["claimed_discovery"]["sha256"]
            and admission["discovery_selection_sha256"] == claim["selection_sha256"]
            and all(digest(admission[key]) for key in ("opening_sha256", "native_scope_selection_sha256",
                                                      "guided_selection_sha256", "mapping_sha256"))
            and proof["original_roles_replayed"] == ordered
            and proof["mapping_owner_called"] is proof["output_created"] is False
            and proof["optimizer_steps"] == 0,
