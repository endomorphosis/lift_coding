            and prior["observed_guide"] == 573 and row["prior_published_D"] == prior["last_verified_published_datasets_sha"]
            and pub["live_main_after"]["datasets"] == writer["HEAD"] == row["published_D"]
            and pub["live_main_after"]["accelerate"] == writer["A"] == row["published_A"]
            and writer["index"] == index and pub["actual_doc_Source_closed"] == refs["writer"]
            and pub["actual_ordinary26"] == writer["ordinary_qualification"] == refs["ordinary"]
            and ordinary["actual_ordinary_counts"]["passed"] == row["ordinary_passes"] == 26
            and ordinary["Source_lease_and_resource_cleanup_closed"] is True
            and ordinary["large_model_fit_or_Native_or_statutory_qualification"] is False
            and row["nested_feedback_both_passed_in_replay"] is True
            and row["retained_rows_mapped"] == 1218
            and row["protected_body_hash_and_size_matches"] == row["protected_body_full9_changes"] == 32
            and len(row["retained_changed_content"]) == 3 and cap["all_prior_costs_retained"] is True
            and headroom == row["retained_headroom_bytes"] and ledger["captures"] == row["retained_capture_snapshot"]
            and index["bytes"]+1-headroom == row["independent_index_payload_gap"] == 713_606
            and row["fresh_independent_index_read"] is row["current_stage0_and_HEAD_join"]
                is row["current_paired_quote"] is row["live_reader_allocation"] is None
            and row["model_or_legal_qualification"] is row["dispatch_authority"] is False,
            "exact Guide574 publication, Phase7 qualification and unresolved Stage A endpoints required")
    return prior | {"observed_guide":574,
        "source_frontier":"published_checkout_pending_current_Git_roles_and_independent_index",
        "recorded_publication":refs["publication"],"Guide574_detached_metadata":reference,
        "last_verified_published_datasets_sha":row["published_D"],"last_verified_published_accelerate_sha":row["published_A"],
        "recorded_published_datasets_index":index,"recorded_published_accelerate_index":writer["A_index"],
        "recorded_headroom_bytes":headroom,"latest_retained_capture_floor":ledger["captures"],
        "current_publication_retained_precharge":refs["cap"],"publisher_preflight":None,
        "detached_body_content_matches":32,"replayed_stage_zero_protected_count":None,
        "quote_basis":"Guide574 current stage-zero and HEAD join and paired quote are pending",
        "conditional_Reader_bytes":None,"conditional_selector_bytes":None,
        "conditional_combined_bytes_before_overhead":None,"conditional_shortfall_bytes_before_overhead":None,
        "standalone_independent_index_payload_floor_excluded_from_quote":index["bytes"]+1,
        "standalone_independent_index_payload_shortfall":row["independent_index_payload_gap"]}


def guide574_replayed_stage_a(reference, prior):
    row = retained_json(reference)
    proof = retained_json(row["index_replay"])
    preview = retained_json(row["reader_preview"])
    quote = retained_json(row["quote"])
    selector = retained_json(quote["selector_expectations"])
    require(row["schema"] == "private-guide574-stage-a-exact-replay-and-price/v1"
            and prior["observed_guide"] == 574 and prior["Guide574_detached_metadata"] == proof["guide574_metadata"]
            and proof["schema"] == "private-stage-a-guide574-writer-index-and-body-roles/v1"
            and proof["writer_expected_index"] == prior["recorded_published_datasets_index"]
            and proof["writer_matched_index"] == row["writer_matched_index"]
            and all(proof["writer_matched_index"][key] == proof["writer_expected_index"][key]
                    for key in ("bytes", "sha256"))
            and proof["Git_index_entries"] == 41250
            and len(proof["protected_roles"]) == 32
            and all(role["Git_stage"] == 0 for role in proof["protected_roles"])
            and proof["published_roots"] == selector["expected_roots"] == preview["reader_inputs"]["current_roots"]
            and preview["relocation_proof"] == row["index_replay"]
            and row["reader_preview"] == quote["preview"] and preview["execution_selected"] is False
            and preview["source_body_reads"] == 32 and preview["archive_historical_count"] == 20
            and row["reader_local_passing_cases"] == 7 and row["modeled_Source_Git_owner_in_reader_checks"] is True
            and row["stage_zero_controls"]["exact_positions"] == 32
            and row["independent_index_live_read"] is row["original_paired_selector_allocation"]
                is row["live_reader_allocation"] is None
            and row["dispatch_authority"] is False, "exact detached Guide574 replay and closed local controls required")
    selector_bytes = quote["selector_git_stream_allowance"] + quote["selector_raw_stream_write_readback_allowance"]
    reader_bytes = quote["Reader_core"]["logical_selected_bytes"] + quote["Reader_parent_matrix_allowance"]
    combined = selector_bytes + reader_bytes
    headroom = quote["retained_headroom_bytes"]
    index = quote["independent_index_payload_floor"]
    require(headroom == prior["recorded_headroom_bytes"] and combined == quote["selector_Reader_conditional_subtotal"]
                == 26_801_431 and combined - headroom == quote["conditional_paired_gap_before_overhead"]
            and index == prior["standalone_independent_index_payload_floor_excluded_from_quote"]
            and index - headroom == quote["independent_index_payload_gap"]
                == prior["standalone_independent_index_payload_shortfall"]
            and combined + index - headroom == quote["conditional_joint_gap_before_overhead"]
            and quote["independent_index_read_included"] is False
            and quote["live_reservation"] is quote["actual_original_owner_allocation"] is None,
            "exact Guide574 conditional budgets and independent index gap required")
    return prior | {"source_frontier":"published_writer_matched_index_and_paired_quote_await_current_owner",
        "Guide574_exact_offline_index_roles":row["index_replay"],"Guide574_offline_Reader_v3":row["reader_preview"],
        "replayed_stage_zero_protected_count":32,"quote_basis":"Guide574 v3 all-fresh conditional, one preview read",
        "conditional_Reader_bytes":reader_bytes,"conditional_selector_bytes":selector_bytes,
        "conditional_combined_bytes_before_overhead":combined,
        "conditional_shortfall_bytes_before_overhead":quote["conditional_paired_gap_before_overhead"],
        "conditional_joint_with_independent_index_gap_before_overhead":quote["conditional_joint_gap_before_overhead"]}


def guide574_ref_cap_alternatives(reference, coordination):
    row = retained_json(reference)
    quote = retained_json(row['quote'])
    legacy = quote['legacy']
    narrow = quote['ref_64_KiB']
    tighter = quote['ref_64_KiB_short_4_KiB']
    states = ('current_ref_stream_sizes','independent_index_read','selector_allocation','reader_allocation')
    require(row['schema'] == 'private-stage-a-optional-ref-stream-cap-and-price/v1'
            and quote['schema'] == 'private-guide574-stage-a-ref-cap-conditional-quotes/v1'
            and coordination['observed_guide'] == 574
            and legacy['joint_payload_floor_gap'] == coordination['conditional_joint_with_independent_index_gap_before_overhead']
            and row['candidate']['core'] == quote['candidate']
            and row['passing_cases'] == {'core':7,'startup':21}
            and row['execution_selected'] is quote['execution_selected'] is False
            and all(quote[state] is None for state in states),
            'optional cap must preserve prior Guide574 provenance and leave live selections unset')
    for ref in (*row['candidate'].values(), *row['tests'].values(), *row['diffs'].values()):
        path = Path(ref['path'])
        require(path.is_absolute() and path.stat().st_size == ref['bytes'],
                'exact bounded ref-cap candidate artifact is required')
        require(sha256(path.read_bytes()).hexdigest() == ref['sha256'],
                'ref-cap candidate artifact digest differs')
    require(legacy['paired_subtotal'] - narrow['paired_subtotal'] == 10*(262144-65536)
            and narrow['paired_subtotal'] - tighter['paired_subtotal'] == 68*(8192-4096)
            and narrow['joint_with_historical_independent_readback_floor_gap']-narrow['joint_payload_floor_gap']==7070597
            and all(variant['Reader_core']['direct_source_bytes']==legacy['Reader_core']['direct_source_bytes']
                    for variant in (narrow,tighter)), 'detached cap selection changes only the stream reservation')
    return {**coordination, 'optional_Guide574_ref_cap_quotes':row['quote'],
            'conditional_paired_ref64K':narrow['paired_subtotal'],
            'conditional_joint_ref64K_payload_gap':narrow['joint_payload_floor_gap'],
            'conditional_joint_ref64K_with_historical_readback_gap':narrow['joint_with_historical_independent_readback_floor_gap']}


def report(manifest):
    require(type(manifest) is dict and manifest.get("manifest_schema_id") == "decoder-training-experiment-design"
            and manifest.get("artifact_kind") == "inert_experiment_design"
            and all(manifest.get(flag) is False for flag in FLAGS),
            "only the local advisory experiment design can be projected")
    design = manifest["typed_execution_design"]
    slots, stages, experiments = design["independent_selection_slots"], design["stages"], manifest["experiments"]
    require(type(slots) is list and len(slots) == 17 and all(
        type(row) is dict and type(row.get("id")) is str and row["id"]
        and all(type(row.get(key)) is str and bool(row[key]) for key in ("required_authority", "required_binding"))
        and "selected_receipt_sha256" in row
        and (row["selected_receipt_sha256"] is None or digest(row["selected_receipt_sha256"])) for row in slots),
        "every independent selection needs an existing authority, binding and explicit receipt field")
    by_slot = {row["id"]: row for row in slots}
    require(len(by_slot) == len(slots) and set(STUDY + TEACHERS) <= by_slot.keys(),
            "independent selection identifiers differ from the common study and four teacher slots")
    require(type(stages) is list and all(type(row) is dict for row in stages)
            and tuple(row.get("id") for row in stages) == STAGES
            and type(experiments) is list and len(experiments) == 11
            and all(type(row) is dict and type(row.get("id")) is str for row in experiments),
            "exact seven stages and eleven registered experiments required")
    by_experiment = {row["id"]: row for row in experiments}
    require(len(by_experiment) == len(experiments), "ambiguous experiment identity")

    summary, used_experiments, used_bindings = [], [], set()
    for stage in stages:
        key, bindings, roster = (stage[name] for name in ("id", "required_launch_bindings", "experiments"))
        dependencies = stage.get("requires_completed_designs", [])
        require(names(bindings) and set(STUDY) <= set(bindings) <= by_slot.keys()
                and names(roster) and bool(roster)
                and all(name in by_experiment and by_experiment[name]["stage"] == key for name in roster)
                and names(dependencies) and set(dependencies) <= set(STAGES[:STAGES.index(key)]),
                "stage trace has an unknown owner binding, foreign experiment, or nonprior dependency")
        used_experiments.extend(roster)
        used_bindings.update(bindings)
        summary.append({
            "stage": key, "experiments": roster, "required_prior_designs": dependencies,
            "missing_selection_ids": [name for name in bindings if by_slot[name]["selected_receipt_sha256"] is None],
            "supplied_reference_ids_requiring_owner_validation": [
                name for name in bindings if by_slot[name]["selected_receipt_sha256"] is not None],
        })
    require(len(used_experiments) == len(by_experiment) and set(used_experiments) == by_experiment.keys()
            and used_bindings == by_slot.keys(), "the stage graph omits or reuses a registered experiment or owner binding")
    a0 = stages[0]["source_only_preflight_requires"]
    require(tuple(a0) == BASELINE and "A0-source-only" in stages[0]["experiments"]
            and set(TEACHERS) <= set(stages[0]["required_launch_bindings"]),
            "source-only preflight and measured four-teacher Stage A have different scopes")
    endpoint, final = manifest["primary_endpoint"], design["final_release"]
    semantics = endpoint["required_gate_semantics"]
    require(type(semantics) is dict and set(semantics) == set(GATES)
            and all(type(value) is str and bool(value) for value in semantics.values())
            and endpoint.get("threshold_selection_before_comparison") is True
            and endpoint.get("missing_required_gate_breaks_streak") is True
            and endpoint.get("include_all_selected_seeds_and_failures") is True
            and endpoint.get("final_test_is_not_adaptive_selection_oracle") is True
            and final.get("binding_id") == "final_reservation"
            and final.get("adaptive_selection_permitted") is False
            and tuple(final.get("opens_only_after", ())) == RELEASE,
            "five independent gates, full paid scope and opaque FINAL release rules must stay bound")
    historical = stage_a_coordination(design)
    current = design.get("current_retained_stage_a_readiness")
    coordination = (historical if current is None else retained_stage_a_readiness(current))
    predecessor = {}
    if "latest_published_stage_a_pending_current_read" in design:
        require(current is not None, "publisher preflight requires its original independently read predecessor")
        predecessor["last_independently_rebound_stage_a_coordination"] = coordination
        coordination = pending_published_stage_a(design["latest_published_stage_a_pending_current_read"], current, coordination)
    if "guide566_published_stage_a_pending_current_read" in design:
        predecessor["prior_publisher_stage_a_preflight"] = coordination
        coordination = pending_later_published_stage_a(design["guide566_published_stage_a_pending_current_read"],
            design["latest_published_stage_a_pending_current_read"], coordination)

    if "guide567_published_stage_a_pending_current_read" in design:
        predecessor["guide566_publisher_stage_a_preflight"] = coordination
        coordination = pending_guide567_stage_a(design["guide567_published_stage_a_pending_current_read"],
            design["guide566_published_stage_a_pending_current_read"], coordination)

    if "v582_published_stage_a_pending_current_read" in design:
        predecessor["guide567_catalog_stage_a_preflight"] = coordination
        coordination = pending_v582_stage_a(design["v582_published_stage_a_pending_current_read"], coordination)

    if "guide568_independently_read_stage_a" in design:
        predecessor["prior_v582_published_stage_a_preflight"] = coordination
        coordination = joined_guide568_stage_a(design["guide568_independently_read_stage_a"], coordination)

    if "guide569_published_stage_a_pending_current_read" in design:
        predecessor["last_independently_rebound_guide568_stage_a"] = coordination
        coordination = pending_guide569_stage_a(design["guide569_published_stage_a_pending_current_read"],
            manifest["guide569_stage_a_funding_inputs"], manifest["retained_stage_a_charges_after_guide568"], coordination)

    if "guide570_published_stage_a_pending_current_read" in design:
        predecessor["prior_publisher_guide569_stage_a"] = coordination
        coordination = pending_guide570_stage_a(design["guide570_published_stage_a_pending_current_read"], coordination)
    if "guide571_published_stage_a_pending_current_read" in design:
        predecessor["prior_publisher_guide570_stage_a"] = coordination
        coordination = pending_guide571_stage_a(design["guide571_published_stage_a_pending_current_read"], coordination)
    if "guide571_later_isolated_read_charge" in design:
        coordination = retain_guide571_isolated_charge(design["guide571_later_isolated_read_charge"], coordination)
    if "guide572_published_new_checkout_pending_reader" in design:
        predecessor["prior_publisher_guide571_stage_a"] = coordination
        coordination = guide572_stage_a_frontier(design["guide572_published_new_checkout_pending_reader"], coordination)
    if "guide573_published_stage_a_body_metadata" in design:
        predecessor["prior_publisher_guide572_stage_a"] = coordination
        coordination = guide573_stage_a_metadata(design["guide573_published_stage_a_body_metadata"], coordination)
    if "guide573_stage_a_writer_matched_all_fresh_quote" in design:
        predecessor["guide573_before_exact_offline_index_and_quote"] = coordination
        coordination = guide573_replayed_stage_a(design["guide573_stage_a_writer_matched_all_fresh_quote"], coordination)
    guide573_owner_coordination = coordination
    if "guide574_published_stage_a_metadata" in design:
        predecessor["prior_publisher_guide573_stage_a"] = coordination
        coordination = guide574_stage_a_metadata(design["guide574_published_stage_a_metadata"], coordination)
    if "guide574_stage_a_writer_matched_all_fresh_quote" in design:
        predecessor["guide574_before_exact_offline_index_and_quote"] = coordination
        coordination = guide574_replayed_stage_a(design["guide574_stage_a_writer_matched_all_fresh_quote"], coordination)
    if 'guide574_stage_a_optional_git_ref_cap' in design:
        coordination = guide574_ref_cap_alternatives(design['guide574_stage_a_optional_git_ref_cap'], coordination)
    return {
        "schema": "decoder-training-advisory-design-check/v1",
