    scheduled = retained_json(descriptor["scheduled_fixture"])["scheduled_failure"]
    require(descriptor["schema"] == "compact-stage-f-generation-custody-private-controls/v1"
            and descriptor["local_controls"] == {"comparison": 4, "scheduled": 9}
            and descriptor["native_weight_edit_or_training"] is descriptor["maintained_source_adoption"] is None
            and descriptor["dispatch_authority"] is False
            and all(focused[key]["interventions"] == 1 and focused[key]["concealed_by_guard"] == 0
                    and focused[key]["refused_before_any_scoring"] is True
                    and focused[key]["owned_weights_restored"] is True
                    and focused[key]["before_sha256"] != focused[key]["tampered_sha256"]
                    for key in ("generate", "inspect"))
            and all(digest(value) for value in focused["original_unchanged_reports"].values()),
            "the original generation and inspection drift must both refuse without changing valid reports")
    shared = focused["partial_shared_owner"]
    require(scheduled["closed_arms"] == shared["verified_and_restored_prior_arms"] == ["baseline"]
            and scheduled["committed_rows"] == ["new-A", "new-B"] and shared["verified_prior_rows"] == ["A", "B"]
            and scheduled["offending_rows_admitted"] == shared["offending_rows_admitted"] == 0
            and scheduled["scores"] == {} and scheduled["weights_restored"] is True,
            "the failed scheduled arm must retain only previously verified work and restore the owned weights")
    return {"passing_local_controls": descriptor["local_controls"], "drift_boundaries_reproduced": ["generate", "inspect"],
            "scheduled_prior_arms_retained": scheduled["closed_arms"], "offending_rows_admitted": 0,
            "native_edit_effect": None, "actual_legal_review": None, "dispatch_authority": False}

def project_qwen_external_projector_development(reference):
    descriptor = retained_json(reference)
    fixture = retained_json(descriptor["portable_fixture"])
    qwen, t5 = fixture["qwen"], fixture["t5"]
    roster, transport = fixture["shared_scripted_source_roster"], fixture["retained_transport"]
    roles = ["baseline", "targeted", "seeded", "restored_baseline"]
    arms = qwen["roles"]
    require(descriptor["schema"] == "qwen2-external-projector-development-private-controls/v1"
            and descriptor["local_controls"] == {"focused": 7, "retained_t5": 3}
            and descriptor["native_or_protected_development"] is descriptor["maintained_source_adoption"] is None
            and descriptor["dispatch_authority"] is False
            and qwen["original_projector_evidence_kind"] == "scripted_fixture"
            and qwen["native_or_legal_work"] is False and qwen["rollback_matches_both_rows"] is True
            and qwen["one_parent_and_source_roster"] is True and roster["rows"] == 2
            and [row["role"] for row in arms] == roles and [row["forwards"] for row in arms] == [4] * 4
            and all(row["source_records_sha256"] == roster["source_records_sha256"]
                    and len(row["consumed"]) == 2 and all(digest(value) for value in row["consumed"]) for row in arms),
            "Qwen2 projector must retain the exact four modeled scopes and common source-only roster")
    require(arms[0]["consumed"] == arms[3]["consumed"]
            and len({row["consumed"][0] for row in arms[:3]}) == 3
            and len({row["consumed"][1] for row in arms}) == 1
            and t5["same_report_bytes"] is True and t5["rows_per_arm"] == [2] * 4
            and len(transport) == 2 and [row["family"] for row in transport] == ["qwen", "t5"]
            and all(digest(row["exact_seed_replay_sha256"]) for row in transport)
            and len(fixture["retained_t5_worker"]) == 1
            and [row["forwards"] for row in fixture["retained_t5_worker"][0]["arithmetic_fixture_arms"]] == [4] * 4,
            "restore, unaffected row and retained T5 and original transport proofs must match")
    return {"passing_local_controls": descriptor["local_controls"], "scripted_common_source_rows": roster["rows"],
            "scripted_forwards_per_route": {"Qwen2": 16, "T5": 16}, "verified_native_or_protected_development": None,
            "weight_edit_benefit_measured": False, "dispatch_authority": False}


def project_qwen_external_projector_returns(reference):
    from base64 import b64decode

    def raw(item):
        require(type(item) is dict and set(item) == {"bytes", "sha256", "raw_base64"}
                and type(item["bytes"]) is int and 0 < item["bytes"] <= 4 * 1024**2
                and type(item["raw_base64"]) is str and len(item["raw_base64"]) == 4 * ((item["bytes"] + 2) // 3),
                "exact bounded projector return capsule required")
        data = b64decode(item["raw_base64"], validate=True)
        require(len(data) == item["bytes"] and sha256(data).hexdigest() == item["sha256"],
                "projector return capsule bytes or hash differ")
        return data

    descriptor = retained_json(reference)
    fixture = retained_json(descriptor["portable_fixture"])
    original, partial = fixture["originals"], fixture["modeled_partial"]
    report, roles = original["readback"], original["ordered_roles"]
    arms = report["arms"]
    expected = ["baseline", "targeted", "seeded", "restored_baseline"]
    require(descriptor["schema"] == "qwen2-external-projector-returns-private-controls/v1"
            and descriptor["passing_local_controls"] == 10
            and descriptor["native_or_protected_development"] is descriptor["maintained_source_adoption"] is None
            and descriptor["dispatch_authority"] is report["scoring_or_dispatch_authority"] is False
            and report["original_projector_evidence_kind"] == "scripted_fixture"
            and [item["role"] for item in roles] == [item["role"] for item in arms] == expected,
            "Qwen2 returns must retain all four matched scripted roles")
    for capsule, key in (("binding", "binding_sha256"), ("source", "source_sha256"),
                         ("prefill", "prefill_sha256"), ("preparation", "source_preparation_sha256")):
        require(sha256(raw(original[capsule])).hexdigest() == report[key],
                "Qwen2 projector prefill, records or binding hash differs")
    for item, arm in zip(roles, arms, strict=True):
        require(sha256(raw(item["return"])).hexdigest() == arm["return_sha256"]
                and sha256(raw(item["modeled_close"])).hexdigest() == arm["original_close_sha256"]
                and len(arm["rows"]) == 2 and all(row["observed_forward_count"] == 2 for row in arm["rows"]),
                "Qwen2 projector arm lost its exact return, modeled close or forwards")
    comparison = report["row_slot_comparison"]
    subjects = {row["review_subject_sha256"] for arm in arms for row in arm["rows"]}
    require(len({arm["original_close_sha256"] for arm in arms}) == 4 and len(subjects) == 8
            and all(digest(subject) for subject in subjects)
            and arms[0]["return_sha256"] == arms[-1]["return_sha256"]
            and [row["slot_comparison"] for row in comparison] == ["distinct", "unchanged"]
            and all(row["restored_generation_matches_baseline"] is True
                    and row["restored_bf16_matches_baseline"] is True for row in comparison)
            and partial == {"observed_forward_count": 0, "slot_comparison": "unobserved", "disposition": "incomplete"},
            "Qwen2 restored or unaffected rows differ, or modeled time stop claims a slot")
    return {"passing_local_controls": 10, "scripted_source_rows": 2, "scripted_backend_forwards": 16,
            "role_scoped_review_subjects": 8, "scripted_bf16_restoration_verified": True,
            "verified_native_or_protected_development": None, "weight_edit_benefit_measured": False,
            "dispatch_authority": False}


