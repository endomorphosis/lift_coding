"""Check a pinned design and project its current owner handoff as JSON."""

import argparse
from hashlib import sha256
import json
from pathlib import Path
import re
from stat import S_ISREG


STAGES = tuple("ABCDEFG")
FLAGS = ("execution_selected", "executable_now", "project_source_changes_selected", "hosted_ci_allowed")
BASELINE = ("legal_cohort", "origin_and_decoder", "resources_and_cost")
STUDY = BASELINE + ("final_reservation", "threshold_policy", "seed_and_checkpoint_grid", "retention_reference")
TEACHERS = ("teacher_spacy8_close", "teacher_gte_small384_close",
            "teacher_gte_base768_close", "teacher_leanstral4096_close")
GATES = ("source_fidelity", "formal_validity", "retention", "coverage", "abstention")
RELEASE = ("original development comparison", "preregistered threshold policy",
           "eligible frozen exact checkpoint", "separate resource and legal review")
PHASE4_TERMINAL = ("qualified_local_sha", "passed_cases", "source_closed", "resource_cleanup_confirmed",
                   "parent_release_returned")
GUIDE526_PUBLICATION_SCHEMA = "guide526-four-doc-three-normal-FF-publication/v336"
GUIDE526_PUBLICATION = (10967, "b0b70d49db2d68218c57c5547cc58f122b6e73db9c641cc8e704ff53cc055632")
GUIDE526_PRIOR_PUBLICATION = (13081, "b9b12b1a191f866b9d83bce59772eec6c31c82f820cf4f1f9c63993dd13acb39")
GUIDE526_SOURCE4 = (4834, "2f1c3cd6eb18b477bf1af9536a15eef2a125103b44bee1cc368d7a52ab09ade8")
GUIDE526_CHECKPOINT = (4214, "c9ac8f3b8b1438530df43bd5bd6a0e3ea173de77d74e4561c25e023b1f70b6ee")
GUIDE526_DOCS = tuple("ipfs_datasets_py/logic/autoformal/docs/" + name for name in (
    "BACKLOG.json", "HANDOFF.md", "TRAINING_HISTORY.md", "work_catalog.json"))


def require(condition, message):
    if not condition:
        raise ValueError(message)


def digest(value, length=64):
    return type(value) is str and re.fullmatch(r"[0-9a-f]{" + str(length) + r"}", value) is not None


def names(value):
    return type(value) is list and all(type(name) is str and bool(name) for name in value) and len(set(value)) == len(value)


def unique_pairs(pairs):
    result = dict(pairs)
    require(len(result) == len(pairs), "duplicate JSON key in the pinned design")
    return result


def reject_constant(value):
    raise ValueError(f"non-finite JSON value in planning evidence: {value}")


def read_design(path, expected, *, expected_bytes=None):
    require(digest(expected), "a pinned design SHA-256 is required")
    maximum = 2 * 1024**2
    if expected_bytes is not None:
        require(type(expected_bytes) is int and 0 < expected_bytes <= maximum,
                "bounded design byte count required")
        maximum = expected_bytes
    path = path.resolve(strict=True)
    require(path.is_relative_to("/tmp") and "repositories" not in path.parts and path.is_file(),
            "select a retained private design file")
    with path.open("rb") as stream:
        raw = stream.read(maximum + 1)
    require(0 < len(raw) <= maximum and (expected_bytes is None or len(raw) == expected_bytes)
            and sha256(raw).hexdigest() == expected,
            "pinned design byte identity differs")
    return json.loads(raw, object_pairs_hook=unique_pairs, parse_constant=reject_constant)


def verify_qualification_successor(current, local, published, terminal):
    reference = current["guide_only_successor_of_phase4_qualification"]
    require(type(reference) is dict and set(reference) == {"path", "bytes", "sha256"}
            and type(reference["path"]) is str and type(reference["bytes"]) is int
            and 0 < reference["bytes"] <= 32 * 1024 and digest(reference["sha256"]),
            "docs-only successor requires a pinned local publication readback")
    path = Path(reference["path"])
    proof = read_design(path, reference["sha256"])
    require(path.stat().st_size == reference["bytes"] and type(proof) is dict
            and proof.get("schema") == "private-stage-a-existing-reader-published-guide522-rebind/v1"
            and type(terminal) is dict and digest(terminal.get("qualified_local_sha"), 40)
            and terminal["qualified_local_sha"] != local
            and proof.get("preserved_prior_phase4_qualification_commit") == terminal.get("qualified_local_sha")
            and proof.get("verified_published_D_and_A_roots", {}).get("D", {}).get("HEAD") == local == published
            and proof.get("previous_phase4_qualification_publication") == current.get("phase4_normal_publication_and_new_index")
            and proof.get("actual_guide522_publication") == current.get("current_published_source_and_index")
            and proof.get("existing_reader_plan") == current.get("rebound_current_reader_plan")
            and proof.get("changed_guard_ordinals") == [85, 1218, 1219, 1220, 1221]
            and digest(proof.get("unchanged_qualified_test_blob"), 40)
            and proof.get("execution_selected") is False,
            "docs-only successor differs from the recorded publication, Reader plan or executed Phase4 commit")


def _read_publication_reference(reference, *, pin=None):
    require(type(reference) is dict and set(reference) == {"path", "bytes", "sha256"}
            and type(reference["path"]) is str and Path(reference["path"]).is_absolute()
            and type(reference["bytes"]) is int and 0 < reference["bytes"] <= 32 * 1024
            and digest(reference["sha256"]), "later publication requires a bounded pinned receipt")
    require(pin is None or (reference["bytes"], reference["sha256"]) == pin,
            "exact recorded Guide526 evidence reference required")
    return read_design(Path(reference["path"]), reference["sha256"], expected_bytes=reference["bytes"])


def _publication_roots(publication):
    roots = {}
    full9_fields = {"st_dev", "st_ino", "st_mode", "st_nlink", "st_uid", "st_gid",
                    "st_size", "st_mtime_ns", "st_ctime_ns"}
    for role, name in (("D", "datasets"), ("A", "accelerate")):
        repository = publication["repositories"].get(name)
        require(type(repository) is dict and repository.get("clean_worktree_and_index") is True
                and digest(repository.get("HEAD"), 40) and digest(repository.get("tree"), 40)
                and repository.get("origin_main") == repository["HEAD"],
                "later publication needs matching clean local and origin/main commits and tree identities")
        index = repository.get("index")
        require(type(index) is dict and set(index) == {"path", "bytes", "full9"}
                and type(index["path"]) is str and type(index["bytes"]) is int and index["bytes"] > 0,
                "later publication needs exact Datasets and Accelerate index references")
        index_path = Path(index["path"])
        stamp = index["full9"]
        require(index_path.is_absolute() and str(index_path) == index["path"] and ".." not in index_path.parts
                and index_path.parts[-3:] == (name, ".git", "index")
                and type(stamp) is dict and set(stamp) == full9_fields
                and all(type(value) is str and re.fullmatch(r"[0-9]+", value) for value in stamp.values())
                and stamp["st_size"] == str(index["bytes"]) and S_ISREG(int(stamp["st_mode"])),
                "later publication index path, full9 mode or byte count differs")
        roots[role] = {key: repository[key] for key in ("HEAD", "origin_main", "tree", "index")}
    return roots


def _verify_v335_publication(reference, publication, prior_datasets_head):
    require(type(publication) is dict
            and publication.get("schema") == "Phase6-effective-date-ordinary44-three-normal-FF-publication/v335"
            and publication.get("Source_SDK_parent_home_closed") is True
            and publication.get("frozen_D_index_exact_readback_before_and_after") is True
            and type(publication.get("repositories")) is dict,
            "closed v335 publication and frozen Datasets index evidence required")
    roots = _publication_roots(publication)
    frozen = publication.get("frozen_D_index")
    require(type(frozen) is dict and set(frozen) == {"path", "bytes", "full9", "sha256"}
            and digest(frozen["sha256"])
            and {key: frozen[key] for key in roots["D"]["index"]} == roots["D"]["index"]
            and roots["D"]["HEAD"] != prior_datasets_head,
            "later publication must bind the frozen Datasets index and a distinct Datasets commit")
    roots["D"]["index"] = frozen
    return {"receipt": reference, "roots": roots}


def _verify_guide526_publication(reference, publication, prior_datasets_head):
    require((reference["bytes"], reference["sha256"]) == GUIDE526_PUBLICATION
            and type(publication.get("repositories")) is dict
            and publication.get("evidence_ordinal") == 526
            and publication.get("only_exact_four_docs_and_intended_parent_gitlinks") is True
            and publication.get("exact_inverse_verified") is True
            and publication.get("no_test_CI_Source_Native_model_replay") is True,
            "exact closed documentary Guide526 publication required")
    roots = _publication_roots(publication)
    prior_ref = publication.get("prior_publication")
    prior_publication = _read_publication_reference(prior_ref, pin=GUIDE526_PRIOR_PUBLICATION)
    prior = _verify_v335_publication(prior_ref, prior_publication, prior_datasets_head)["roots"]
    require(roots["A"] == prior["A"] and roots["D"]["HEAD"] != prior["D"]["HEAD"]
            and roots["D"]["index"]["path"] == prior["D"]["index"]["path"]
            and roots["D"]["index"]["full9"] != prior["D"]["index"]["full9"],
            "Guide526 requires a fresh Datasets publication and the retained Accelerate checkout")
    pushes = publication.get("pushes_in_actual_order")
    push_repos = ("datasets", "hallucinate", "root")
    require(type(pushes) is list and len(pushes) == len(push_repos)
            and all(type(row) is dict and row.get("normal_fast_forward") is True
                    and (row.get("repository"), row.get("before"), row.get("after"))
                    == (name, prior_publication["repositories"][name]["HEAD"], publication["repositories"][name]["HEAD"])
                    for name, row in zip(push_repos, pushes, strict=True)),
            "Guide526 requires the recorded three normal fast-forward publications")

    source_ref = publication.get("actual_Source4")
    source = _read_publication_reference(source_ref, pin=GUIDE526_SOURCE4)
    require(type(source) is dict and source.get("schema") == "Root-one-guide526-four-installed-Source-closed/v336"
            and source.get("prior_phase6_publication") == prior_ref
            and (source.get("before_D_HEAD"), source.get("before_D_tree")) == (prior["D"]["HEAD"], prior["D"]["tree"])
            and source.get("catalog_before_after") == [525, 526] and source.get("evidence_ordinal") == 526
            and type(source.get("errors")) is int and source["errors"] == 0
            and all(source.get(flag) is True for flag in (
                "Source_closed", "module_closed", "staging_closed", "Source_write_checks_complete",
                "Source144_full_precharge_retained", "no_test_CI_SQL_or_Native_replay"))
            and source.get("only_worktree_deltas") == list(GUIDE526_DOCS),
            "exact four-guide Source4 closure must precede the documentary publication")
    docs, installed = publication.get("docs"), source.get("installed")
    require(type(docs) is dict and set(docs) == set(GUIDE526_DOCS)
            and type(installed) is list and len(installed) == len(GUIDE526_DOCS)
            and all(type(docs[name]) is dict and type(row) is dict
                    and row == {key: docs[name].get(key) for key in ("path", "bytes", "sha256", "full9")}
                    for name, row in zip(GUIDE526_DOCS, installed, strict=True)),
            "published Guide526 docs differ from the Source4 closure")
    roots["D"]["index"] = {**roots["D"]["index"], "sha256": None}
    return {"receipt": reference, "roots": roots, "prior_publication": prior_ref, "source4": source_ref}


def verify_unbound_later_publication(reference, prior_datasets_head):
    publication = _read_publication_reference(reference)
    if type(publication) is dict and publication.get("schema") == GUIDE526_PUBLICATION_SCHEMA:
        return _verify_guide526_publication(reference, publication, prior_datasets_head)
    return _verify_v335_publication(reference, publication, prior_datasets_head)


def _verify_guide526_closed_checkpoint(reference, publication):
    require("prior_publication" in publication, "closed Guide526 checkpoint requires its matching Guide526 publication")
    checkpoint = _read_publication_reference(reference, pin=GUIDE526_CHECKPOINT)
    require(type(checkpoint) is dict
            and checkpoint.get("schema") == "qualified-effective-date-source-withheld-ordinary44-and-Guide526-current-checkpoint/v336"
            and checkpoint.get("all_pub_and_source_owner_handles_closed") is True
            and checkpoint.get("guide_publication") == publication["receipt"]
            and checkpoint.get("code_publication") == publication["prior_publication"]
            and checkpoint.get("doc_source4") == publication["source4"],
            "closed Guide526 checkpoint must bind the exact publication and Source4 closure")
    repos, ledger, pending = (checkpoint.get(key) for key in ("current_repositories", "ledger", "pending"))
    require(type(repos) is dict and all(type(repos.get(name)) is dict
            and repos[name].get("clean_worktree_and_index") is True
            and all(repos[name].get(key) == publication["roots"][role][key] for key in ("HEAD", "origin_main", "tree"))
            for role, name in (("D", "datasets"), ("A", "accelerate"))),
            "closed Guide526 checkpoint differs from the published Datasets or Accelerate checkout")
    require(type(pending) is dict and set(pending) == {"bytes", "captures", "components"}
            and type(pending["bytes"]) is int and pending["bytes"] == 0
            and type(pending["captures"]) is int and pending["captures"] == 0 and pending["components"] == []
            and type(ledger) is dict and ledger.get("capturesComplete") is False
            and all(type(ledger.get(key)) is int and ledger[key] >= 0
                    for key in ("captures", "internal_cap", "internal_used", "global_cap", "used"))
            and ledger["internal_cap"] - ledger["internal_used"] == ledger["global_cap"] - ledger["used"] == 10551296,
            "closed Guide526 checkpoint requires the observed ledger and zero pending charges")
    return min(ledger["internal_cap"] - ledger["internal_used"], ledger["global_cap"] - ledger["used"])


def _later_index_preparation(reference, publication, checkpoint):
    """Attach retained READ1 and an inert plan without treating them as a live binding."""
    audit = _read_publication_reference(reference, pin=(4948,
        "4d6d77e8aa0e4e72e5c1aac6e9e94f6b0abf3b9c1bb94311525e3b7f8320d743"))
    require(type(audit) is dict
            and audit.get("schema") == "private-stage-a-v337-original-read1-closed-index-audit/v1"
            and audit.get("actual_published_source") == publication["receipt"]
            and audit.get("source_read_closed_original_receipt") is True
            and audit.get("selected_read1_observed_new_head_tree_and_refs") is False
            and all(key in audit and audit[key] is None for key in ("actual_baseline_or_execution_selection",
                "original_paired_selector_observation", "separate_reader_admission")),
            "READ1 audit must bind the same publication without a live launch or Reader receipt")
    index, selected = audit["verified_current_index_pin"], publication["roots"]["D"]["index"]
    require(type(index) is dict and set(index) == {"path", "bytes", "full9", "sha256"}
            and selected["sha256"] is None and digest(index["sha256"])
            and {**selected, "sha256": index["sha256"]} == index,
            "closed index capture differs from the published index expectation")
    source_close = _read_publication_reference(audit["input_references"]["v337_closed_read1"])
    require(type(source_close) is dict and source_close.get("Source_closed") is True
            and source_close.get("Root_selected") is True and source_close.get("errors") == []
            and source_close.get("raw_refs") == [{**audit["input_references"]["v337_original_private_index"],
                "canonical_full9": index["full9"], "canonical_path": index["path"]}]
            and source_close["raw_refs"][0]["sha256"] == index["sha256"],
            "retained READ1 source close or exact private index reference differs")
    plan_ref = audit["verified_reader_plan"]
    require(type(plan_ref) is dict and set(plan_ref) == {"path", "bytes", "sha256"}
            and type(plan_ref["path"]) is str and type(plan_ref["bytes"]) is int
            and 0 < plan_ref["bytes"] <= 48 * 1024 and digest(plan_ref["sha256"]),
            "exact bounded prepared Reader plan reference required")
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    canonical = json.dumps(plan, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
    require(type(plan) is dict and plan.get("current_index") == index and plan.get("execution_selected") is False
            and "Stage_A_owner_selection" in plan and plan["Stage_A_owner_selection"] is None
            and sha256(canonical).hexdigest() == audit["verified_reader_plan_canonical_sha256"]
            and all((plan["current_roots"][role]["HEAD"], plan["current_roots"][role]["tree"]) ==
                (root["HEAD"], root["tree"]) for role, root in publication["roots"].items()),
            "prepared Reader plan must retain the exact closed index and published root pair")
    reconcile = audit["retained_envelope_reconciliation"]
    residual = reconcile["headroom_if_full_precharge_is_only_postselection_ledger_change_bytes"]
    require(type(residual) is int and 0 <= residual < checkpoint["recorded_headroom_bytes"]
            and reconcile["fresh_original_postclose_ledger"] is None,
            "retained READ1 accounting is conditional, not a new ledger")
    return {"source_frontier": "published_successor_has_verified_index_expectation",
        "prepared_reader_plan": plan_ref, "verified_index_expectation": index,
        "original_closed_index_capture": audit["input_references"]["v337_closed_read1"],
        "closed_postpublication_checkpoint_headroom_bytes": checkpoint["recorded_headroom_bytes"],
        "conditional_post_read1_headroom_bytes": residual, "recorded_headroom_bytes": None,
        "headroom_observation_basis": "post_read1_balance_derived_from_retained_charge_pending_original_ledger",
        "next_source_owner_dependency": "bind the original paired selector and separate Reader allocation to the current Source scope"}


def _calendar_local_preparation(reference, publication, original):
    local = _read_publication_reference(reference, pin=(10032,
        "624261a91fa20b2cb7dac1b588927ec236e0c954c8cbc8371bbe33b880bd9e78"))
    require(type(local) is dict and local.get("schema") == "private-stage-a-v339-frozen-calendar-local-reader-plan-v1"
            and local.get("published_predecessor") == publication["receipt"]
            and local.get("v337_published_predecessor_plan") == original["prepared_reader_plan"]
            and local.get("published") is False and local.get("execution_selected") is False
            and local.get("guard_changed_rows_zero_based") == [85, 213, 578, 796]
            and (local.get("guard_row_count"), local.get("stage_zero_role_count"),
                 local.get("byte_verified_archive_count"), local.get("fresh_role_count")) == (1254, 32, 20, 12)
            and all(key in local and local[key] is None for key in ("reader_allocation", "paired_selector")),
            "the exact local-only successor must preserve the original Reader evidence scope")
    freeze = _read_publication_reference(local["owner_local_freeze_receipt"], pin=(10270,
        "7bf4b816e14c3c7ee7d86d13a9b9709616eb9f3874b0e153eba1bfc189b20040"))
    roots, index = local["frozen_local_roots"], local["frozen_current_index"]
    prior = publication["roots"]["D"]["origin_main"]
    require(type(freeze) is dict and freeze.get("schema") == "actual-Phase3-effective-calendar-exact-three-file-local-freeze/v339"
            and freeze.get("prior_Guide526_publication") == publication["receipt"]
            and freeze.get("D_parent") == freeze.get("local_origin_main_tracking_unchanged") == prior
            and freeze.get("D_clean_worktree_and_index") is True and freeze.get("pushed") is False
            and freeze.get("remote_action") is False and roots["D"]["HEAD"] != prior
            and (freeze.get("D_local_HEAD"), freeze.get("D_tree"), freeze.get("D_index_frozen")) == (
                roots["D"]["HEAD"], roots["D"]["tree"], index)
            and all(roots["A"][key] == publication["roots"]["A"][key] for key in ("HEAD", "tree")),
            "calendar freeze must distinguish clean local checkout, unchanged Accelerate and earlier publication")
    read4 = _read_publication_reference(local["read4_source_close"])
    require(type(read4) is dict and read4.get("Source_closed") is True and read4.get("errors") == []
            and read4.get("raw_refs") == local["read4_raw_refs"]
            and len(local["read4_raw_refs"]) == 4,
            "four exact frozen index and calendar reads must have closed under their original owner")
    plan_ref = local["local_reader_plan"]
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    canonical = json.dumps(plan, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
    require(type(plan) is dict and plan.get("current_index") == index and plan.get("current_roots") == roots
            and plan.get("execution_selected") is False and "Stage_A_owner_selection" in plan
            and plan["Stage_A_owner_selection"] is None
            and sha256(canonical).hexdigest() == local["local_reader_plan_canonical_sha256"],
            "Reader plan must authenticate the exact frozen local index and stay unselected")
    return {"source_frontier": "local_calendar_freeze_requires_qualification_and_publication",
            "clean_local_datasets_sha": roots["D"]["HEAD"], "prior_prepared_published_reader": original,
            "prepared_reader_plan": None, "verified_index_expectation": None,
            "conditional_post_read1_headroom_bytes": None,
            "local_only_reader_plan": plan_ref, "local_only_index_expectation": index,
            "local_freeze": local["owner_local_freeze_receipt"], "local_read4_close": local["read4_source_close"],
            "headroom_observation_basis": "calendar_owner_read4_charge_has_no_stage_a_allocation",
            "next_source_owner_dependency": "qualify and publish the local calendar freeze and recheck the index before selector selection"}


def _calendar_local_qualification(reference, local):
    receipt = _read_publication_reference(reference, pin=(2538,
        "d54fe9e16fb25d61625054151afe78a3e7ccdc61b58094bf57821c0060c37e71"))
    require(type(receipt) is dict and receipt.get("schema") == "actual-phase3-effective-calendar-ordinary69-current-frozen/v1"
            and receipt.get("read_only_frozen_candidate") == local["local_freeze"]
            and receipt.get("actual_closed_SourceREAD4") == local["local_read4_close"]
            and receipt.get("head") == local["clean_local_datasets_sha"]
            and receipt.get("Source_closed") is True and receipt.get("resource_cleanup_confirmed") is True
            and receipt.get("ordered_COLLECT_called_RUN_same") is True
            and receipt.get("physical_unique_passing_cases") == 69 and receipt.get("failure_error_skip") == 0
            and receipt.get("Native_or_statutory_qualification_in_this_cohort") is False,
            "calendar software qualification must match the exact frozen local checkout and original READ4")
    return {"source_frontier": "qualified_local_calendar_freeze_pending_publication",
            "local_calendar_software_qualification": reference, "local_calendar_software_cases_passed": 69,
            "next_source_owner_dependency": "publish the qualified local calendar freeze and recheck the index before selector selection"}


def _calendar_published_successor(reference, historical, local, qualification):
    document = _read_publication_reference(reference, pin=(12709,
        "192b14db36939a9a91f992b2e6c8df03b8d214985cfba9866560af4556385c2f"))
    require(type(document) is dict
            and document.get("schema") == "Phase3-effective-calendar-ordinary69-and-direct-Lean-three-normal-FF-publication/v342"
            and document.get("prior_Guide526_publication") == historical["receipt"]
            and document.get("exact_local_freeze") == local["local_freeze"]
            and document.get("ordinary69") == qualification["local_calendar_software_qualification"]
            and document.get("Source_SDK_resource_closed") is True
            and document.get("frozen_D_index_exact_readback_before_and_after") is True
            and document.get("frozen_D_index") == local["local_only_index_expectation"],
            "calendar publication must preserve the exact qualified local freeze and original index capture")
    roots = _publication_roots(document)
    selected = roots["D"]["index"]
    index = document["frozen_D_index"]
    require(roots["D"]["HEAD"] == local["clean_local_datasets_sha"]
            and roots["A"] == historical["roots"]["A"] and all(index[key] == value for key, value in selected.items()),
            "calendar publication roots must retain the exact frozen Reader plan and Accelerate")
    roots["D"]["index"] = index
    return {"source_frontier": "published_calendar_successor_has_verified_reader_expectation",
            "last_verified_published_datasets_sha": roots["D"]["origin_main"],
            "prior_guide526_publication": historical,
            "active_publication": {"receipt": reference, "roots": roots},
            "prepared_reader_plan": local["local_only_reader_plan"], "verified_index_expectation": index,
            "local_only_reader_plan": None, "local_only_index_expectation": None,
            "headroom_observation_basis": "current_stage_a_allocation_and_scope_remain_unbound",
            "next_source_owner_dependency": "bind the paired selector and separately funded Reader to the published calendar checkout"}


def _guide527_reader_successor(reference, calendar):
    prepared = _read_publication_reference(reference)
    publication = prepared["source_publication"]
    document = _read_publication_reference(publication, pin=(12291,
        "9d6a9c1c9b3a67cd16a225948eff9090b450b3abcfc5b1f599ed7e54bd40bb45"))
    _expected_guides = [85, 1218, 1219, 1220, 1221]
    require(document.get("schema") == "guide527-four-doc-child-first-fast-forward-publication/v1"
            and document.get("all_other_paths_and_gitlinks_preserved") is True
            and document.get("exact_forward_and_inverse_verified") is True
            and prepared.get("guard_changed_rows_from_v342_zero_based") == _expected_guides
            and prepared.get("after_index_raw_export_available") is False
            and all(key in prepared and prepared[key] is None for key in ("current_stage_a_ledger", "paired_selector", "reader_allocation")),
            "Guide527 preparation must preserve its exact published scope without a new live Reader or raw export")
    earlier = calendar["active_publication"]
    indices = document["index_readback"]
    actual_roots = _publication_roots({"repositories": {name: {**document["repositories"][name],
        "index": {key: value for key, value in indices[name]["after"].items() if key != "sha256"}}
        for name in ("accelerate", "datasets")}})
    for role, name in (("A", "accelerate"), ("D", "datasets")):
        pin = indices[name]["after"]
        require(digest(pin.get("sha256")), "Guide527 publisher must attest the exact final index byte digest")
        actual_roots[role]["index"] = pin
    first = document["pushes_in_actual_order"][0]
    require(indices["datasets"]["before"] == earlier["roots"]["D"]["index"]
            and actual_roots["D"]["index"] == prepared["publisher_attested_frozen_D_index"]
            and actual_roots["D"]["HEAD"] == first["after"] and first["before"] == earlier["roots"]["D"]["HEAD"]
            and first["normal_fast_forward"] is True and first["push_returncode"] == 0
            and indices["accelerate"]["before"] == actual_roots["A"]["index"]
            and all(actual_roots["A"][key] == earlier["roots"]["A"][key] for key in ("HEAD", "tree")),
            "published Guide527 must preserve original calendar lineage and Accelerate and rebind the exact Datasets index")
    plan_ref = prepared["published_reader_plan"]
    expected_bytes = prepared["reader_plan_canonical_sha256"]
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    old_ref = calendar["prepared_reader_plan"]
    older = read_design(Path(old_ref["path"]), old_ref["sha256"], expected_bytes=old_ref["bytes"])
    updated = ("current_index", "current_roots", "four_guide_post_candidates_for_current_owner_recheck")
    docs = document["committed_docs"]
    dataset_root = Path(actual_roots["D"]["index"]["path"]).parents[1]
    expected_docs = [{**{key: value[key] for key in ("bytes", "sha256", "full9")}, "path": str(dataset_root / path)}
                     for path, value in docs.items()]
    canonical = json.dumps(plan, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
    require(sha256(canonical).hexdigest() == expected_bytes and plan["current_index"] == actual_roots["D"]["index"]
            and plan["current_roots"] == prepared["published_roots"]
            and all((plan["current_roots"][role]["HEAD"], plan["current_roots"][role]["tree"]) == (row["HEAD"], row["tree"])
                    for role, row in actual_roots.items())
            and plan["current_roots"]["D"]["root"] == str(dataset_root)
            and len(docs) == 4 and {row["path"]: row for row in plan[updated[2]]} == {row["path"]: row for row in expected_docs}
            and {key: value for key, value in plan.items() if key not in updated} == {
                key: value for key, value in older.items() if key not in updated},
            "Guide527 Reader plan can replace only the frozen published roots, exact index and four guide expectations")
    return {"source_frontier": "published_guide527_reader_plan_requires_live_index_and_selector",
        "active_publication": {"receipt": publication, "roots": actual_roots},
        "prior_calendar_publication": earlier,
        "clean_local_datasets_sha": actual_roots["D"]["HEAD"],
        "last_verified_published_datasets_sha": actual_roots["D"]["origin_main"],
        "prepared_reader_plan": plan_ref, "verified_index_expectation": actual_roots["D"]["index"],
        "current_index_expectation_basis": "publisher_index_readback_pending_original_live_reader_byte_verification",
        "next_source_owner_dependency": "bind the fresh paired selector and separately funded Reader to the Guide527 checkout"}


def _accelerate_cli_index_readback(reference, guide):
    evidence = _read_publication_reference(reference)
    freeze = _read_publication_reference(evidence["owner_local_freeze"], pin=(10096,
        "4cf138952e013c5bce3232b811c7660bec843bb06b53efe873c40d6c848c6ac2"))
    close_ref = evidence["closed_read9"]["compact"]
    closed = _read_publication_reference(close_ref, pin=(15010,
        "bc8433d7acc58c1e39a1e858b113f8ca1861bc340c696446955b56bc2bea9656"))
    roots = guide["active_publication"]["roots"]
    parent, local = freeze["parent"], freeze["frozen"]
    require(freeze["exact_changes_only"] is True and freeze["local_clean"] is True
            and all(freeze[key] is False for key in ("pushed", "remote_contact", "ordinary100_run"))
            and (parent["HEAD"], parent["tree"], parent["stage0_index"]) == (
                roots["A"]["HEAD"], roots["A"]["tree"], roots["A"]["index"])
            and local["HEAD"] != parent["HEAD"]
            and local["local_origin_main_tracking_ref"] == parent["local_origin_main_tracking_ref"] == roots["A"]["origin_main"],
            "Accelerate local freeze must retain the published ancestor and separate local identity")
    require(closed["Source_closed"] is True and closed["owned_module_closed"] is True and closed["errors"] == []
            and closed["roots_before"] == closed["roots_after"] and len(closed["captures"]) == 9,
            "existing owner index readback must be closed with stable roots")
    source_rows = {row["path"]: row for row in closed["captures"]}
    indexes = {"A": local["stage0_index"], "D": roots["D"]["index"]}
    require(freeze["preserved_peers"]["datasets"]["stage0_index"] == indexes["D"],
            "Accelerate freeze must preserve the Guide527 Datasets index")
    raw = {}
    for role, index in indexes.items():
        row = source_rows[index["path"]]
        raw[role] = row["raw_reference"]
        require(all(row[key] == value for key, value in index.items())
                and all(raw[role][key] == index[key] for key in ("bytes", "sha256")),
                "both native index expectations must match the archived owner readback")
    accounting = _read_publication_reference(evidence["owner_paid_minimum_close"], pin=(16324,
        "aec2202a3bcb9365f8544bd614dc27c375683f45c3095ace4c0a38830dadf849"))
    require(accounting["actual_read9"] == close_ref and accounting["A_local_freeze"] == evidence["owner_local_freeze"],
            "paid-minimum accounting must bind the same closed owner observations")
    paid = _read_publication_reference(accounting["paid_exact_receipt"], pin=(1502,
        "cbcc4426b21e410b3d12180dbb673e76cf859875028b8a5adae2020ee4deeb0e"))["after_full_precharge"]
    ledger = accounting["current_paid_Source_minimum"]
    observed = closed["ledger_after"]
    remaining = min(ledger["global_cap"] - ledger["used"], ledger["internal_cap"] - ledger["internal_used"])
    require(remaining == 6_356_992
            and all(ledger[key] == paid[key] == observed[key] for key in ("global_cap", "internal_cap"))
            and all(ledger[key] == max(paid[key], observed[key]) for key in ("used", "internal_used", "captures")),
            "existing owner ledger must preserve the full precharge and later observed capture count")
    plan_ref = evidence["reader_plan"]
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    prior_ref = guide["prepared_reader_plan"]
    prior = read_design(Path(prior_ref["path"]), prior_ref["sha256"], expected_bytes=prior_ref["bytes"])
    old_outer, new_outer = [read_design(Path(row["path"]), row["sha256"], expected_bytes=row["bytes"])
                            for row in (prior["current_retained_epochs"]["outer"], plan["current_retained_epochs"]["outer"])]
    observed_roots = closed["roots_after"]
    changes = {"HEAD": local["HEAD"], "tree": local["tree"]}
    expected = {**prior, "current_roots": {**prior["current_roots"], "A": {**prior["current_roots"]["A"], **changes}},
                "current_retained_epochs": {**prior["current_retained_epochs"], "outer": plan["current_retained_epochs"]["outer"]}}
    canonical = json.dumps(plan, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
    require(plan == expected and sha256(canonical).hexdigest() == evidence["canonical"]
            and len(old_outer) == 1218 and old_outer[0] == roots["A"]["index"] and new_outer == [indexes["A"], *old_outer[1:]]
            and all(all(observed_roots[row["root"]][key] == value for key, value in row.items() if key != "root")
                    for row in plan["current_roots"].values())
            and plan["current_index"] == indexes["D"]
            and evidence["paired_selector"] is None and evidence["reader_terminal"] is None
            and evidence["source_scope"]["current_stage_A_ledger"] is None and evidence["source_scope"]["stage_A_allocation"] is None
            and plan["execution_selected"] is False and plan["Stage_A_owner_selection"] is None,
            "local index readback can change only the observed Accelerate root and index in the inert Reader plan")
    return {"source_frontier": "accelerate_local_successor_requires_paired_selector_and_reader_allocation",
            "guide527_published_reader_plan": prior_ref, "prepared_reader_plan": plan_ref,
            "observed_local_accelerate_sha": local["HEAD"], "last_verified_published_accelerate_sha": roots["A"]["origin_main"],
            "retained_index_readback": {"receipt": close_ref, "raw_indexes": raw},
            "retained_paid_source_minimum_receipt": evidence["owner_paid_minimum_close"],
            "local_only_accelerate_preparation": reference,
            "current_index_expectation_basis": "closed_existing_owner_archive_pending_original_stage_a_live_verification",
            "recorded_headroom_after_retained_paid_minimum_bytes": remaining,
            "next_source_owner_dependency": "bind exact local and published Accelerate branch roles in the paired selector and fund the Reader"}


def _accelerate_cli_local_qualification(reference, local):
    proof = _read_publication_reference(reference, pin=(6699,
        "f1ebac4de5ef8ffc08335b6578aa152e3140fa1c98f426ee53b63172ffd7d02b"))
    require(proof["schema"] == "private-stage-a-v347-existing-CLI100-frozen-local-read-corroboration-v1"
            and proof["prior"] == local["local_only_accelerate_preparation"]
            and proof["reader_plan_unchanged"] == local["prepared_reader_plan"]
            and proof["roots"]["A"]["HEAD"] == local["observed_local_accelerate_sha"]
            and proof["A_origin_main_last_receipt"] == local["last_verified_published_accelerate_sha"]
            and proof["both_index_pins_unchanged"] is True and proof["guard_changed_zero_based"] == []
            and proof["observed_planned_bound_rows_exact"] == 1242 and proof["remaining_fresh_Source_body_obligations"] == 12
            and all(row["entered"] and row["exit_returned"] for row in proof["read_lease_contexts_closed"])
            and {row["root"] for row in proof["read_lease_contexts_closed"]} == {row["root"] for row in proof["roots"].values()},
            "existing ordinary test closure must retain the paired Reader snapshot and all pending captures")
    result = proof["ordinary_result"]
    require(result["parent_passed"] == 100 and all(result[key] == 0 for key in ("error", "failure", "skipped"))
            and all(proof[key] is None for key in ("A_published_or_fresh_origin_proof", "paired_signed_Stage_A_selector"))
            and proof["live_authority_granted"] is False and proof["stage_A_source_read_executed"] is False,
            "Accelerate CLI qualification is a local test result outside the Stage A paired Source scope")
    cap = _read_publication_reference(proof["source_scoped_full_precharge"], pin=(1220,
        "81d1cbdff43e4bcc383026f24a75f141f2579db85a5113473fba703936e69fe9"))
    earlier = _read_publication_reference(local["retained_paid_source_minimum_receipt"])
    prior, after, accounting = cap["prior"], cap["after_full_precharge"], proof["accounting"]
    remaining = tuple(after[limit] - after[used] for limit, used in (("global_cap", "used"), ("internal_cap", "internal_used")))
    require(cap["prior_READ9_all_costs_retained"] == earlier["paid_exact_receipt"] and cap["source_operation_bytes"] == 134_217_728
            and prior == earlier["current_paid_Source_minimum"]
            and prior == accounting["prior_paid_minimum"] and after == accounting["owner_selected_full_precharge_after"]
            and remaining == (6_356_992, 6_356_992) and list(remaining) == accounting["remainder_from_full_precharge_bytes"]
            and all(accounting[key] is None for key in ("current_Stage_A_ledger", "stage_A_allocation")),
            "CLI test precharge must remain in its original owner scope")
    return {"local_accelerate_ordinary_qualification": reference,
            "local_accelerate_cli_test_cases_passed": result["parent_passed"],
            "retained_paid_source_minimum_receipt": proof["source_scoped_full_precharge"],
            "recorded_headroom_after_retained_paid_minimum_bytes": min(remaining)}


def _accelerate_cli_publication(reference, local, tested):
    publication = _read_publication_reference(reference, pin=(10596,
        "dbda5956bf87018cf376d29c509e75a54923966e600452f088c1062c716e8685"))
    qualified = _read_publication_reference(publication["qualification"], pin=(3119,
        "9e2065a08c3408b04533602b170d8e25a95115246ca39cf8f69660fb808ef8c5"))
    local_evidence = _read_publication_reference(local["local_only_accelerate_preparation"])
    test_evidence = _read_publication_reference(tested["local_accelerate_ordinary_qualification"])
    require(publication["schema"] == "accelerator-CLI100-manifest-handoff-three-fast-forward-publication/v1"
            and qualified["actual_ordinary100_report"] == test_evidence["owner_ordinary_terminal"]
            and qualified["actual_prepaid_Source_allocation"] == tested["retained_paid_source_minimum_receipt"]
            and qualified["actual_local_freeze"] == publication["local_freeze"] == local_evidence["owner_local_freeze"]
            and publication["physical_unique_pass"] == qualified["actual_CLI100_unique_parent_PASS"] == 100
            and all(publication[key] is True for key in ("closed_source_resource_parent", "datasets_Guide527_unchanged",
                                                       "exact_parent_links_only", "no_Source_test_CI_replay")),
            "Accelerate publication must bind the original closed 100-case run and freeze")
    plan_ref = local["prepared_reader_plan"]
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    for role, name in (("A", "accelerate"), ("D", "datasets")):
        after = publication["repositories"][name]
        expected = plan["current_roots"][role]
        index = publication["index_after"][name]
        captured = local["retained_index_readback"]["raw_indexes"][role]
        require(after["HEAD"] == after["origin_main"] == expected["HEAD"] and after["tree"] == expected["tree"]
                and after["clean_worktree_and_index"] is True and after["gitlinks_updated"] == {}
                and publication["index_before"][name] == index
                and all(index[key] == captured[key] for key in ("bytes", "sha256"))
                and index == local_evidence["protected_index_readback"][f"{role}_canonical"],
                "public roots and index evidence must preserve the prepared Reader input exactly")
    pushes = publication["pushes_in_actual_order"]
    require([row["repository"] for row in pushes] == ["accelerate", "hallucinate", "root"]
            and all(row["normal_fast_forward"] is True and row["push_returncode"] == 0
                    and row["after"] == publication["repositories"][row["repository"]]["origin_main"] for row in pushes)
            and pushes[0]["before"] == local["last_verified_published_accelerate_sha"],
            "original publication needs the exact normal push order and Accelerate lineage")
    return {"source_frontier": "published_pair_requires_signed_selector_and_reader_allocation",
            "active_accelerate_publication": reference,
            "last_verified_published_accelerate_sha": pushes[0]["after"],
            "current_index_expectation_basis": "paired_publisher_matches_closed_index_archives_pending_stage_a_live_verification",
            "next_source_owner_dependency": "capture the fresh signed paired selector for the published roots and fund the Reader"}


def _stage_a_existing_selector_preselection(reference, published, local, tested):
    proof = _read_publication_reference(reference, pin=(13544,
        "66a32a8f170c5898a2543892f9d023cf4ce9a6611d4bbbfc7fc7b91b8895171e"))
    published_ref = _read_publication_reference(proof["published_reference"], pin=(9106,
        "fad873ef644c2219005bfb9f6754f44d1cbefdea10968f7135705a706ef38b58"))
    require(proof["schema"] == "private-v347-stage-a-existing-paired-selector-preselection-expectations/v1"
            and proof["authorized_or_executed"] is False and all(proof[key] is None for key in (
                "expected_owner_scope_sha256", "current_owner_deadline", "current_live_Stage_A_ledger",
                "original_signed_selector_receipt", "paired_selector_observation_sha256", "stage_A_allocation"))
            and published_ref["owner_publication"] == published["active_accelerate_publication"]
            and published_ref["previous_ordinary_verification"] == tested["local_accelerate_ordinary_qualification"],
            "Stage A selector preparation must carry the published pair without an owner selection")
    reader = proof["reader"]
    plan_ref = local["prepared_reader_plan"]
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    require(reader["plan"] == plan_ref == published_ref["reader_plan"]
            and reader["canonical_sha256"] == published_ref["canonical"]
            and proof["expected_roots"] == plan["current_roots"]
            and (reader["total_guard_rows"], reader["bound_physical_rows"], reader["protected_D_Git_modes_and_blobs"],
                 reader["retained_archives"], reader["fresh_captures"]) == (1254, 1242, 32, 20, 12)
            and reader["asset_or_legal_row_scope_selected"] is False and reader["source_lease_or_launch_selected"] is False
            and all(row["current_owner_stream_sha256"] is None
                    for row in proof["archived_selector_expectations_for_owner_recheck_only"].values()),
            "selector preparation cannot bind a current ref stream or change the Reader plan")
    paid_cap = _read_publication_reference(tested["retained_paid_source_minimum_receipt"])
    quote = proof["logical_quotes"]["8192"]
    selector = quote["selector_conditional_before_owner_overhead_bytes"]
    reader_bytes = quote["reader_conditional"]["reader_core_and_matrix_bytes"]
    subtotal = quote["combined_conditional_before_owner_overhead_bytes"]
    remaining = tested["recorded_headroom_after_retained_paid_minimum_bytes"]
    require(proof["last_retained_paid_minimum_only"] == paid_cap["after_full_precharge"]
            and proof["retained_remainder_not_admission"] == [remaining, remaining]
            and (selector, reader_bytes, subtotal) == (1_753_114, 24_811_017, 26_564_131)
            and subtotal == selector + reader_bytes
            and subtotal - remaining == quote["combined_excess_over_retained_minimum_remainder_bytes"],
            "Stage A conditional quotes must preserve the original scope-specific ledger")
    return {"standalone_selector_preselection": reference,
            "source_frontier": "published_pair_preselection_ready_for_original_owner_scope",
            "conditional_source_sizing_before_owner_overhead_bytes": {
                "selector": selector, "reader": reader_bytes, "combined": subtotal},
            "next_source_owner_dependency": "select the independent paired read scope, capture both fresh ref streams and close the selector before a separately allocated Reader"}


def _datasets_local_successor_after_selector(reference, prepared, complete_selector):
    evidence = _read_publication_reference(reference)
    freeze = _read_publication_reference(evidence["owner_local_freeze"], pin=(11261,
        "fde7b558c49bd776aa00a03bd8604b300084afe38f89521c4bdaa3d1ae954cf8"))
    old_ref = prepared["prepared_reader_plan"]
    original = read_design(Path(old_ref["path"]), old_ref["sha256"], expected_bytes=old_ref["bytes"])
    droot = original["current_roots"]["D"]
    before, after = freeze["parent"], freeze["frozen"]
    require(freeze["schema"] == "actual-P4-extracted-view-exact2-local-only-freeze/v1"
            and freeze["local_clean"] is True and freeze["pushed"] is False and freeze["ordinary9_run"] is False
            and all(before[key] == droot[key] and after[key] != before[key] for key in ("HEAD", "tree"))
            and before["index"] == original["current_index"] and after["index"] != before["index"]
            and before["local_origin_main_tracking_ref"] == after["local_origin_main_tracking_ref"] == droot["HEAD"],
            "new Datasets freeze must only supersede the live root while retaining the earlier published expectation")
    next_ref = evidence["reader_plan"]
    successor = read_design(Path(next_ref["path"]), next_ref["sha256"], expected_bytes=next_ref["bytes"])
    expected_roots = {**original["current_roots"], "D": {**droot, "HEAD": after["HEAD"], "tree": after["tree"]}}
    close = _read_publication_reference(evidence["closed_read3"]["compact"], pin=(7894,
        "4fff285ebdd4513f44f2a6b8afb877933e4a585d28166d19f2c7f3525aedf4bc"))
    require(close["Source_closed"] is True and close["owned_module_closed"] is True and close["errors"] == []
            and close["roots_before"] == close["roots_after"] and len(close["captures"]) == 3
            and all(all(close["roots_after"][row["root"]][key] == value for key, value in row.items() if key != "root")
                    for row in expected_roots.values()), "local Reader plan must use the observed closed paired roots")
    index = close["captures"][2]
    require(all(index[key] == value for key, value in after["index"].items())
            and evidence["post_local_index_pins"]["D"] == after["index"],
            "new local root must use the existing owner's exact closed index capture")
    require(successor == {**original, "current_roots": expected_roots, "current_index": after["index"]}
            and evidence["paired_selector"] is None and evidence["stage_A_allocation"] is None
            and successor["execution_selected"] is False and successor["Stage_A_owner_selection"] is None,
            "private successor is an exact local root and index rebind without execution selection")
    return {"source_frontier": "new_local_datasets_candidate_requires_fresh_pair_and_reader_allocation",
            "clean_local_datasets_sha": after["HEAD"], "last_verified_published_datasets_sha": droot["HEAD"],
            "older_published_selector_preselection": complete_selector["standalone_selector_preselection"],
            "standalone_selector_preselection": None,
            "older_published_conditional_source_sizing_bytes": complete_selector["conditional_source_sizing_before_owner_overhead_bytes"],
            "conditional_source_sizing_before_owner_overhead_bytes": None,
            "prepared_reader_plan": next_ref, "latest_local_datasets_rebind": reference,
            "verified_index_expectation": after["index"],
            "current_index_expectation_basis": "closed_datasets_local_read3_pending_original_stage_a_live_verification",
            "next_source_owner_dependency": "bind the new Datasets epoch after owner qualification or explicit local acceptance, then capture the fresh signed selector and allocate the Reader"}


def _datasets_extracted_view_publication(reference, local, accelerate):
    proof = _read_publication_reference(reference)
    receipt = _read_publication_reference(proof["owner_publication"], pin=(13408,
        "582a712ce8b1d33d0509218d8c55ed41cafd0d21b3a6e20156dd711a56140d16"))
    close = _read_publication_reference(receipt["qualification"], pin=(7734,
        "1a7622afc2501950d0b34e18a47a0cb67ea22e3a7306fb7566ac9eedfcbe4e58"))
    cap = _read_publication_reference(close["Source_only_full_precharge"], pin=(1244,
        "8a730e47735b6701ca11fa5328181167b34d7111f86248dbdc4242c9d80ce3b5"))
    ledger = cap["after_full_retained_precharge"]
    local_proof = _read_publication_reference(local["latest_local_datasets_rebind"])
    require(receipt["schema"] == "actual-P4-extracted-view-ordinary9-three-fast-forward-publication/v1"
            and receipt["local_freeze"] == local_proof["owner_local_freeze"]
            and receipt["physical_unique_pass"] == 9 and receipt["Native_or_model_execution"] is False
            and all(receipt[key] is True for key in ("source_and_resources_closed", "Guide527_and_other_links_preserved",
                                                   "zero_failures_errors_skips_duplicates"))
            and close["actual_operator_exit_code"] == 0 and close["errors"] == []
            and all(close[key] is True for key in ("Source_closed", "parent_home_removed", "resource_cleanup_confirmed",
                                                 "qualification_complete"))
            and ledger["used"] == 30_125_017_098 and ledger["internal_used"] == 29_934_425_224,
            "Datasets publication requires the original exact local freeze and closed ordinary fixture result")
    plan_ref = local["prepared_reader_plan"]
    plan = read_design(Path(plan_ref["path"]), plan_ref["sha256"], expected_bytes=plan_ref["bytes"])
    selector = proof["selector_preselection_exact_inert_delta"]
    require(proof["reader_plan"] == plan_ref and proof["paired_selector"] is None and proof["stage_A_allocation"] is None
            and selector["expected_roots"] == plan["current_roots"]
            and selector["v347_preselection_historical_only"] == local["older_published_selector_preselection"]
            and all(selector[key] is None for key in ("owner_scope_sha256", "owner_deadline", "owner_ref_streams"))
            and proof["v347_to_v350_guard_changes_zero_based"] == [85]
            and proof["publication_plan_guard_changes_zero_based"] == [],
            "Datasets publication must retain the local Reader plan and pending signed selector")
    for role, name in (("D", "datasets"), ("A", "accelerate")):
        actual = receipt["repositories"][name]
        expected = plan["current_roots"][role]
        index = receipt["index_after"][name]
        require(actual["HEAD"] == actual["origin_main"] == expected["HEAD"] and actual["tree"] == expected["tree"]
                and actual["clean_worktree_and_index"] is True and actual["gitlinks_updated"] == {}
                and receipt["index_before"][name] == index
                and index == local_proof["post_local_index_pins"][role] == proof["post_publication_index_pins"][role],
                "published Datasets and Accelerate must retain the paired local Reader snapshot")
    pushes = receipt["pushes_in_actual_order"]
    require([row["repository"] for row in pushes] == ["datasets", "hallucinate", "root"]
            and all(row["normal_fast_forward"] is True and row["push_returncode"] == 0
                    and row["after"] == receipt["repositories"][row["repository"]]["origin_main"] for row in pushes)
            and pushes[0]["before"] == local["last_verified_published_datasets_sha"]
            and plan["current_roots"]["A"]["HEAD"] == accelerate["last_verified_published_accelerate_sha"],
            "Datasets must publish by the original normal fast-forward without moving Accelerate")
    remaining = min(ledger["global_cap"] - ledger["used"], ledger["internal_cap"] - ledger["internal_used"])
    require(remaining == 6_356_992, "recorded Datasets qualification ledger must retain the full selected precharge")
    return {"source_frontier": "new_published_pair_requires_fresh_signed_selector_and_reader_allocation",
            "last_verified_published_datasets_sha": pushes[0]["after"],
            "post_extracted_view_publication_evidence": reference,
            "standalone_selector_preselection": reference,
            "local_datasets_retrieval_fixture_passes": 9,
            "retained_paid_source_minimum_receipt": close["Source_only_full_precharge"],
            "recorded_headroom_after_retained_paid_minimum_bytes": remaining,
            "current_index_expectation_basis": "published_pair_preserves_closed_read3_pending_original_stage_a_live_verification",
            "next_source_owner_dependency": "select the current paired read scope, capture fresh refs from both published roots and allocate the Reader separately"}


def stage_a_coordination(design):
    current = design["current_stage_a_coordination_checkpoint"]
    require(type(current) is dict, "the current Stage A checkpoint is required")
    local, published = (current.get(key) for key in (
        "clean_local_datasets_sha", "last_verified_published_datasets_sha"))
    require(digest(local, 40) and digest(published, 40), "separate local and published Datasets SHA required")
    headroom = current.get("nominal_headroom_bytes")
    receipt = current.get("existing_owner_checkpoint")
    timestamp = current.get("ledger_observation_utc_ns")
    observed = (type(timestamp) is int and timestamp > 0
                or type(timestamp) is str and re.fullmatch(r"[1-9][0-9]*", timestamp) is not None
                or timestamp is None and digest(current.get("ledger_observation_selection_sha256")))
    require(type(headroom) is int and headroom >= 0 and observed
            and type(receipt) is dict and set(receipt) == {"bytes", "path", "sha256"}
            and digest(receipt["sha256"]) and type(receipt["bytes"]) is int and receipt["bytes"] > 0
            and type(receipt["path"]) is str and receipt["path"].startswith("/tmp/"),
            "exact private checkpoint reference and scoped nominal headroom required")
    terminal = current.get("phase4_qualification")
    successor = "guide_only_successor_of_phase4_qualification" in current
    if successor:
        verify_qualification_successor(current, local, published, terminal)
    if terminal is not None:
        require(type(terminal) is dict and set(terminal) == set(PHASE4_TERMINAL)
                and (successor or terminal["qualified_local_sha"] == local)
                and type(terminal["passed_cases"]) is int and terminal["passed_cases"] == 4
                and all(terminal[key] is True for key in PHASE4_TERMINAL[2:]),
                "Phase4 terminal qualification must bind the exact local commit and all closure flags")
    if local != published:
        next_action = ("verify existing Phase4 qualification and publication" if terminal is None
                       else "verify existing Phase4 normal publication and readback for the qualified local commit")
    else:
        next_action = "verify the current protected index and original paired selector before Reader selection"
    prior = {
        "source_frontier": "published_checkout_differs" if local != published else "same_recorded_commit",
        "clean_local_datasets_sha": local,
        "last_verified_published_datasets_sha": published,
        "phase4_recorded_passes": None if terminal is None else terminal["passed_cases"],
        **({"phase4_qualified_datasets_sha": terminal["qualified_local_sha"],
            "docs_only_successor_preserves_qualification": True} if successor else {}),
        "next_source_owner_dependency": next_action,
        "recorded_headroom_bytes": headroom,
        "headroom_observation_basis": current.get("ledger_observation_basis", "recorded_preparation_checkpoint"),
        "ledger_observation_selection_sha256": current.get("ledger_observation_selection_sha256"),
        "headroom_is_selection_or_admission": False,
        "checkpoint_sha256": receipt["sha256"],
    }
    checkpoint_field = "unbound_later_publication_closed_checkpoint"
    index_field = "later_publication_original_closed_index_audit"
    local_field = "subsequent_unpublished_local_reader_preparation"
    qualification_field = "subsequent_unpublished_local_software_qualification"
    published_field = "subsequent_calendar_publication_preserving_frozen_index"
    guide_field = "subsequent_guide527_publisher_attested_reader_preparation"
    cli_field = "subsequent_accelerate_cli_local_freeze_with_index_readback"
    cli_test_field = "subsequent_accelerate_local_cli_qualification"
    cli_publish_field = "subsequent_accelerate_cli_normal_publication"
    selector_field = "current_existing_stage_a_selector_preselection"
    later_datasets_field = "subsequent_datasets_extracted_view_local_reader_rebind"
    later_datasets_publish_field = "subsequent_datasets_extracted_view_normal_publication"
    if "unbound_later_publication" not in current:
        require(all(key not in current for key in (checkpoint_field, index_field, local_field,
                                                   qualification_field, published_field, guide_field, cli_field,
                                                   cli_test_field, cli_publish_field, selector_field, later_datasets_field,
                                                   later_datasets_publish_field)),
                "closed publication checkpoint and index capture require a later publication")
        return prior
    require(successor, "later publication requires a verified prior Reader frontier")
    active = verify_unbound_later_publication(current["unbound_later_publication"], published)
    checkpoint = {}
    if checkpoint_field in current:
        reference = current[checkpoint_field]
        checkpoint = {
            "closed_postpublication_checkpoint": reference,
            "recorded_headroom_bytes": _verify_guide526_closed_checkpoint(reference, active),
            "headroom_observation_basis": "recorded_closed_postpublication_ledger",
        }
    later_index = {}
    if index_field in current:
        require(checkpoint_field in current, "closed index audit requires its earlier publication checkpoint")
        later_index = _later_index_preparation(current[index_field], active, checkpoint)
    local_preparation = {}
    if local_field in current:
        require(bool(later_index), "local calendar Reader preparation requires its historical published expectation")
        local_preparation = _calendar_local_preparation(current[local_field], active, later_index)
    qualification = {}
    if qualification_field in current:
        require(bool(local_preparation), "local calendar qualification requires its exact local Reader preparation")
        qualification = _calendar_local_qualification(current[qualification_field], local_preparation)
    published_successor = {}
    if published_field in current:
        require(bool(qualification), "calendar publication requires its original local qualification")
        published_successor = _calendar_published_successor(current[published_field], active, local_preparation, qualification)
    guide527 = {}
    if guide_field in current:
        require(bool(published_successor), "Guide527 requires the previously verified published calendar freeze")
        guide527 = _guide527_reader_successor(current[guide_field], published_successor)
    local_cli = {}
    if cli_field in current:
        require(bool(guide527), "local Accelerate freeze requires the earlier Guide527 publication")
        local_cli = _accelerate_cli_index_readback(current[cli_field], guide527)
    local_cli_test = {}
    if cli_test_field in current:
        require(bool(local_cli), "ordinary Accelerate qualification requires its exact prior local freeze")
        local_cli_test = _accelerate_cli_local_qualification(current[cli_test_field], local_cli)
    cli_published = {}
    if cli_publish_field in current:
        require(bool(local_cli_test), "Accelerate CLI publication requires the verified ordinary test closure")
        cli_published = _accelerate_cli_publication(current[cli_publish_field], local_cli, local_cli_test)
    selector_preselection = {}
    if selector_field in current:
        require(bool(cli_published), "Stage A selector preparation requires the exact published root pair")
        selector_preselection = _stage_a_existing_selector_preselection(current[selector_field], cli_published, local_cli, local_cli_test)
    later_datasets = {}
    if later_datasets_field in current:
        require(bool(selector_preselection), "later local freeze must preserve its exact former published selector")
        later_datasets = _datasets_local_successor_after_selector(current[later_datasets_field], local_cli, selector_preselection)
    later_datasets_publish = {}
    if later_datasets_publish_field in current:
        require(bool(later_datasets), "later publication requires the verified local Datasets successor")
        later_datasets_publish = _datasets_extracted_view_publication(current[later_datasets_publish_field], later_datasets, cli_published)
    datasets = active["roots"]["D"]
    return {
        "source_frontier": "published_successor_requires_reader_rebind",
        "clean_local_datasets_sha": datasets["HEAD"],
        "last_verified_published_datasets_sha": datasets["origin_main"],
        "active_publication": active,
        "prior_checked_reader_coordination": prior,
        "current_reader_bound": False,
        "next_source_owner_dependency": "rebind the existing paired selector and Reader to the later publication before Reader selection",
        "recorded_headroom_bytes": None,
        "headroom_observation_basis": "later_publication_has_no_applicable_ledger",
        "ledger_observation_selection_sha256": None,
        "headroom_is_selection_or_admission": False,
        **checkpoint,
        **later_index,
        **local_preparation,
        **qualification,
        **published_successor,
        **guide527,
        **local_cli,
        **local_cli_test,
        **cli_published,
        **selector_preselection,
        **later_datasets,
        **later_datasets_publish,
    }


def retained_json(reference):
    require(type(reference) is dict and set(reference) == {"path", "bytes", "sha256"}
            and type(reference["path"]) is str and Path(reference["path"]).is_absolute(),
            "exact bounded retained artifact reference required")
    return read_design(Path(reference["path"]), reference["sha256"], expected_bytes=reference["bytes"])


def verify_guide564_replay(report, selection, rebind):
    require(report["status"] == "PASS_Guide564_retained_only_offline_rebind_and_bytewise_verification"
            and report["verification"]["stdout_identical_to_passed_replay"] is True,
            "Guide564 requires the closed replay and bytewise verification")
    first, second = report["replay"], report["verification"]
    for run in (first, second):
        exit_ref, stdout, stderr = run["logs"]
        require(type(run["exit_code"]) is int and run["exit_code"] == 0 and retained_json(exit_ref) == 0
                and stderr["bytes"] == 0 and stderr["sha256"] == sha256(b"").hexdigest(),
                "Guide564 replay or verification did not close cleanly")
        summary = retained_json(stdout)
        require(summary["receipt"] == selection["rebind"] and summary["conditional_cost"] == rebind["conditional_cost"]
                and summary["index"] == rebind["published_index"]
                and summary["selector"] == rebind["selector"] and summary["Reader"] == rebind["Reader"],
                "Guide564 replay summary binds different prepared outputs")
    require(all(first["logs"][1][key] == second["logs"][1][key] for key in ("bytes", "sha256")),
            "Guide564 replay and verification outputs differ")
    return report["outputs"]


def retained_stage_a_readiness(selected):
    """Verify the latest selected archive report for the original Stage A owners."""
    require(type(selected) is dict and set(selected) == {"guide", "rebind", "verification"}
            and type(selected["guide"]) is int and selected["guide"] > 0,
            "exact published Guide and original replay references required")
    rebind = retained_json(selected["rebind"])
    observed = retained_json(selected["verification"])
    guide564 = selected["guide"] == 564
    require(rebind["schema"] == ("private-guide564-stage-a-retained-only-replay/v1" if guide564
                                 else "private-existing-stage-a-published-chain-replay/v1")
            and rebind["no_canonical_Source_Git_or_model_invoked"] is True
            and rebind["actual_paired_selection"] is rebind["actual_reader_allocation"]
            is rebind["independent_DEVELOPMENT_admission"] is None,
            "offline replay must retain its Guide and unissued original owner inputs")
    if guide564:
        artifacts = verify_guide564_replay(observed, selected, rebind)
    else:
        require(observed["schema"] == f"private-stage-a-guide{selected['guide']}-closed-offline-replay-verification/v1"
                and observed["Guide"] == selected["guide"]
                and observed["actual_paired_selection"] is observed["actual_reader_allocation"] is None,
                "original replay verification is for a different Guide or claims live authority")
        artifacts = observed["identical_outputs"]
    require(artifacts == {"receipt.json": selected["rebind"], "published-index.DATA": rebind["published_index"],
                "selector.INERT.json": rebind["selector"], "reader.INERT.json": rebind["Reader"],
                "outer.INERT.json": rebind["retained_lists"]["outer"], "python.INERT.json": rebind["retained_lists"]["python"]},
            "required selector, Reader, index and guard references must match the independently replayed outputs")

    publication = retained_json(rebind["published_guide"])
    scopes = rebind["current_roots"]
    require(set(scopes) == {"D", "A"} and (guide564 or scopes == observed["current_roots"])
            and publication["evidence_ordinal"] == selected["guide"] and publication["terminal_returncode"] == 0,
            "latest successful publication and replay must bind the same paired roots")
    pushes = publication["pushes_in_actual_order"]
    require([row["repository"] for row in pushes] == ["datasets", "hallucinate", "root"]
            and all(row["normal_fast_forward"] is True and row["push_returncode"] == 0
                    and row["after"] == publication["repositories"][row["repository"]]["origin_main"] for row in pushes),
            "retained Guide requires the original successful normal fast-forward publication")
    captured = rebind["independent_published_index_readback"]
    require(guide564 or captured == observed["independent_published_index_readback"],
            "the independent replays must bind the exact same index read and full retained precharge")
    close = retained_json(captured["close"])
    require(close["status"] == "PASS" and close["Source_closed"] is close["owned_module_closed"] is True
            and close["errors"] == [] and close["roots_before"] == close["roots_after"],
            "independent paired index observation requires a genuine unchanged closed Source read")
    for role, repository in (("D", "datasets"), ("A", "accelerate")):
        original = publication["repositories"][repository]
        current = close["roots_after"][scopes[role]["root"]]
        require(digest(original["origin_main"], 40) and digest(original["tree"], 40)
                and scopes[role]["HEAD"] == current["HEAD"] == original["HEAD"] == original["origin_main"]
                and scopes[role]["tree"] == current["tree"] == original["tree"]
                and all(row["clean_worktree_and_index"] is True for row in (scopes[role], current, original)),
                "original publication, index read and proposed paired roots name different checkouts")
    index, = close["captures"]
    descriptor = publication["index_readback"]["datasets"]["after"]
    raw_index = captured["index"] if guide564 else captured["raw_index"]
    require(index["relative_path"] == ".git/index" and index["root"] == scopes["D"]["root"]
            and {key: index[key] for key in ("path", "bytes", "sha256", "full9")} == descriptor
            and {key: index["raw_reference"][key] for key in ("path", "bytes", "sha256")} == raw_index
            and all(index[key] == rebind["published_index"][key] == raw_index[key] for key in ("bytes", "sha256")),
            "publisher, independent Datasets index capture and replay must retain exact bytes and full identity")

    selector, reader = retained_json(rebind["selector"]), retained_json(rebind["Reader"])
    metadata = selector["historical_expectations_needing_current_owner_recheck"]
    accelerate_indexes = publication["index_readback"]["accelerate"]
    require(selector["expected_roots"] == reader["current_roots"] == scopes
            and selector["published_pair"] == rebind["published_guide"] and selector["inert_Reader_plan"] == rebind["Reader"]
            and reader["current_index"] == descriptor and reader["Stage_A_owner_selection"] is None
            and reader["current_retained_epochs"] == rebind["retained_lists"]
            and selector["authorized_or_executed"] is selector["dispatch_authority"] is reader["execution_selected"] is False
            and set(metadata) == {"D", "A"}
            and all(row["original_live_ref_stream_sha256"] is None for row in metadata.values())
            and metadata["D"]["index_expectation"] == descriptor
            and metadata["A"]["index_expectation"] == accelerate_indexes["before"] == accelerate_indexes["after"],
            "selector and Reader must retain the current published pair as unselected offline preparation")

    precharge = rebind["current_full_retained_charge"]
    authored_precharge = rebind["retained_prior_charge_chain"][-1] if guide564 else captured["precharge"]
    require(precharge == authored_precharge,
            "Source headroom must retain the original independent read precharge")
    charge_receipt = retained_json(precharge)
    if guide564:
        previous = rebind["retained_prior_charge_chain"][-2]
        require(charge_receipt["prior_Guide564_Source_full_charge"] == previous
                and charge_receipt["all_prior_costs_retained"] is True,
                "Guide564 must retain the actual prior writer charge")
    ledger = charge_receipt["after_full_retained_precharge"]
    balance = min(ledger["global_cap"] - ledger["used"], ledger["internal_cap"] - ledger["internal_used"])
    quote = rebind["conditional_cost"]
    reader_core = quote["Reader_core"]
    minimum_indexes = descriptor["bytes"] + publication["index_readback"]["accelerate"]["after"]["bytes"] + 2
    quoted_indexes = (rebind["mandatory_two_index_probe_bytes"] if guide564 else
                      rebind["mandatory_read_lower_bound"]["mandatory_two_index_probe_bytes"])
    require(quote == selector["conditional_cost"] and (guide564 or quote == observed["conditional_cost"])
            and reader_core["logical_selected_bytes"] == sum(reader_core[key] for key in (
                "control_probe_bytes", "direct_source_bytes", "epoch_output_allowance_bytes", "git_output_allowance_bytes"))
            and quote["Reader_with_matrix_bytes"] == reader_core["logical_selected_bytes"] + quote["parent_matrix_bytes"]
            and quote["selector_and_reader_bytes"] == quote["selector_bytes"] + quote["Reader_with_matrix_bytes"]
            and quote["retained_balance_per_cap"] == balance >= 0
            and quote["shortfall_before_owner_overhead"] == quote["selector_and_reader_bytes"] - balance
            and quote["owner_overhead_included"] is False
            and minimum_indexes == quoted_indexes
            and (not guide564 or minimum_indexes - balance == rebind["mandatory_two_index_probe_shortfall"]),
            "current prospective quote must reproduce the preserved charges and both live index probes")
    targets = [row["path"] for row in reader["fresh_Source_body_targets"]]
    retained = reader["phase7_shared_paths"]
    require(names(targets) and names(retained) and set(retained) <= set(targets)
            and (len(targets), len(retained), len(set(targets) - set(retained)))
            == (rebind["held_body_roles"], rebind["reused_archives"], rebind["pending_capture_roles"]),
            "retained and pending body roles must account for the complete Reader scope")
    if not guide564:
        runs = observed["closed_replay_logs"]
        summary = retained_json(runs["run.stdout"])
        exits = tuple(retained_json(runs[name]) for name in ("run.rc", "verify.rc"))
        require(all(type(code) is int and code == 0 for code in exits)
                and all(runs[name]["bytes"] == 0 and runs[name]["sha256"] == sha256(b"").hexdigest()
                        for name in ("run.stderr", "verify.stderr"))
                and all(runs["run.stdout"][key] == runs["verify.stdout"][key] for key in ("bytes", "sha256"))
                and retained_json(runs["verify.stdout"]) == summary
                and summary == {"Guide": selected["guide"], "conditional_cost": quote, "receipt": selected["rebind"],
                                "mandatory_read_lower_bound": rebind["mandatory_read_lower_bound"]},
                "both closed offline replays must issue the same complete result and quote")
    return {"observed_guide": selected["guide"], "source_frontier": "published_pair_has_verified_offline_preselection",
            "last_verified_published_datasets_sha": scopes["D"]["HEAD"],
            "last_verified_published_accelerate_sha": scopes["A"]["HEAD"],
            "recorded_publication": rebind["published_guide"], "original_index_read_close": captured["close"],
            "offline_verification": selected["verification"], "prepared_selector": rebind["selector"],
            "prepared_reader_plan": rebind["Reader"], "recorded_headroom_bytes": balance,
            "conditional_selector_bytes": quote["selector_bytes"], "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
            "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
            "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"],
            "mandatory_two_index_probe_bytes": minimum_indexes,
            "held_body_roles": rebind["held_body_roles"], "reused_archives": rebind["reused_archives"],
            "pending_capture_roles": rebind["pending_capture_roles"], "current_reader_bound": False,
            "actual_paired_selection": None, "actual_reader_allocation": None, "headroom_is_selection_or_admission": False}


def pending_published_stage_a(preflight_reference, preceding_selection, preceding):
    """Verify a publication-based quote while the independent current read is pending."""
    preflight = retained_json(preflight_reference)
    require(preflight["schema"] == "private-guide565-stage-a-publisher-preflight/v1"
            and preceding["observed_guide"] == 564 and preflight["basis"] == preceding_selection["rebind"]
            and preflight["prior_closed_index"] == preceding["original_index_read_close"]
            and preflight["cost_is_conditional_on_original_owner_scope"] is True
            and preflight["dispatch_authority"] is False
            and all(preflight[key] is None for key in ("independent_current_index_close", "actual_paired_selection",
                                                        "actual_reader_allocation", "independent_DEVELOPMENT_admission")),
            "publisher preflight must extend the independently checked predecessor without live authority")
    latest = retained_json(preflight["published_guide"])
    scope, indexes = latest["documentary_evidence_scope"], latest["index_readback"]
    push = latest["pushes_in_actual_order"][0]
    roots = preflight["current_roots"]
    require(latest["evidence_ordinal"] == 565 and latest["terminal_returncode"] == 0
            and latest["all_other_paths_and_gitlinks_preserved"] is True
            and scope["prior_Guide564_publication"] == preceding["recorded_publication"]
            and push["repository"] == "datasets" and push["normal_fast_forward"] is True and push["push_returncode"] == 0
            and push["before"] == preceding["last_verified_published_datasets_sha"]
            and push["after"] == roots["D"]["HEAD"] == latest["repositories"]["datasets"]["origin_main"]
            and roots["A"]["HEAD"] == latest["repositories"]["accelerate"]["origin_main"]
                  == preceding["last_verified_published_accelerate_sha"]
            and set(preflight["changed_index_paths"]) == latest["committed_docs"].keys()
            and len(preflight["changed_index_paths"]) == 4 and preflight["published_index_entries"] == 41249,
            "publisher quote does not bind the actual four-document successor")
    index = preflight["publisher_matched_index"]
    prior_publication = retained_json(preceding["recorded_publication"])
    require(indexes["datasets"]["before"] == prior_publication["index_readback"]["datasets"]["after"]
            and indexes["accelerate"] == prior_publication["index_readback"]["accelerate"]
            and all(index[field] == indexes["datasets"]["after"][field] for field in ("bytes", "sha256")),
            "publisher index preflight binds different index evidence")
    paid = retained_json(preflight["full_prepaid_source_charge"])["after_full_retained_precharge"]
    ledger = preflight["latest_carried_ledger_if_no_later_owner_activity"]
    quote = preflight["conditional_cost"]
    balance = min(ledger["global_cap"] - ledger["used"], ledger["internal_cap"] - ledger["internal_used"])
    require(all(paid[key] == ledger[key] for key in ("global_cap", "internal_cap", "used", "internal_used"))
            and ledger["captures"] >= paid["captures"] and quote["retained_balance_per_cap"] == balance >= 0
            and quote["owner_overhead_included"] is False
            and quote["selector_bytes"] == preceding["conditional_selector_bytes"]
            and quote["selector_and_reader_bytes"] == quote["selector_bytes"] + quote["Reader_with_matrix_bytes"]
            and quote["shortfall_before_owner_overhead"] == quote["selector_and_reader_bytes"] - balance
            and quote["selector_and_reader_bytes"] == preceding["conditional_combined_bytes_before_overhead"]
                  + quote["document_growth_bytes"],
            "published projection must retain charged bytes and exact cost arithmetic")
    return {
        "observed_guide": 565,
        "source_frontier": "published_pair_pending_independent_current_read",
        "last_verified_published_datasets_sha": roots["D"]["HEAD"],
        "last_verified_published_accelerate_sha": roots["A"]["HEAD"],
        "recorded_publication": preflight["published_guide"],
        "publisher_preflight": preflight_reference,
        "candidate_reader_pending_current_index": preflight["reader_candidate_pending_current_index"],
        "recorded_headroom_bytes": balance,
        "conditional_selector_bytes": quote["selector_bytes"],
        "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
        "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
        "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"],
        "quote_basis": "retained publisher and consumed predecessor archive",
        "original_index_read_close": None, "actual_paired_selection": None, "actual_reader_allocation": None,
        "headroom_is_selection_or_admission": False, "current_reader_bound": False,
    }


def pending_later_published_stage_a(reference, prior_reference, prior):
    evidence = retained_json(reference)
    require(evidence["schema"] == "private-stage-a-guide566-publisher-preflight/v1"
            and evidence["basis"] == prior_reference and prior["observed_guide"] == 565
            and evidence["current_independent_index_read"] is None
            and evidence["allocated"] is evidence["paired_selector_issued"] is evidence["dispatch_authority"] is False,
            "unselected Guide566 report must extend the verified Guide565 publisher preflight")
    impact = retained_json(evidence["v572_publication_impact"])
    code = retained_json(impact["publication"])
    published = retained_json(evidence["published_guide"])
    roots = evidence["current_roots"]
    scope = published["documentary_evidence_scope"]
    require(impact["preceding_published_guide"] == scope["prior_Guide565_publication"] == prior["recorded_publication"]
            and scope["exact1_SQL_test_code_publication"] == impact["publication"]
            and scope["current_Source_READ2"] == impact["verified_local_read_before_publication"]
            and code["terminal_returncode"] == published["terminal_returncode"] == 0
            and published["evidence_ordinal"] == 566
            and [row["before"] for row in published["pushes_in_actual_order"]]
            == [row["after"] for row in code["pushes_in_actual_order"]]
            and len(published["committed_docs"]) == 4 and published["all_other_paths_and_gitlinks_preserved"] is True
            and published["pushes_in_actual_order"][0]["after"] == roots["D"]["HEAD"]
            == published["repositories"]["datasets"]["origin_main"]
            and roots["A"]["HEAD"] == prior["last_verified_published_accelerate_sha"]
            == published["repositories"]["accelerate"]["origin_main"],
            "Guide566 and v572 publisher sequence do not bind the same verified pair")
    index = evidence["publisher_matched_index"]
    require(all(index[key] == published["index_readback"]["datasets"]["after"][key] for key in ("bytes", "sha256"))
            and published["index_readback"]["datasets"]["before"] == code["index_after"]["datasets"]
            and (evidence["published_index_paths"], evidence["held_body_roles"], evidence["reused_archives"],
                 evidence["pending_capture_roles"]) == (41249, 32, 20, 12),
            "Guide566 did not preserve the paid Reader roster and index chain")
    quote = evidence["conditional_cost"]
    paid = retained_json(evidence["full_retained_precharge"])["after_full_retained_precharge"]
    balance = min(paid["global_cap"] - paid["used"], paid["internal_cap"] - paid["internal_used"])
    require(paid == evidence["conservative_ledger"] and balance == quote["headroom_bytes"]
            and quote["owner_overhead_included"] is False
            and quote["selector_bytes"] == prior["conditional_selector_bytes"]
            and quote["selector_and_reader_bytes"] == quote["selector_bytes"] + quote["Reader_with_matrix_bytes"]
            == prior["conditional_combined_bytes_before_overhead"] + quote["document_growth_bytes"]
            and quote["shortfall_before_owner_overhead"] == quote["selector_and_reader_bytes"] - balance,
            "Guide566 quote must preserve costs and arithmetic at its exact current pair")
    return {**prior, "observed_guide": 566, "recorded_publication": evidence["published_guide"],
            "publisher_preflight": reference, "candidate_reader_pending_current_index": evidence["reader_pending_current_index"],
            "last_verified_published_datasets_sha": roots["D"]["HEAD"], "recorded_headroom_bytes": balance,
            "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
            "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
            "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"]}


def pending_guide567_stage_a(reference, prior_reference, prior):
    """Verify the new paid read estimate without turning publication into Source admission."""
    evidence = retained_json(reference)
    require(evidence["schema"] == "private-stage-a-guide567-publisher-preflight/v1"
            and prior["observed_guide"] == 566 and evidence["basis"] == prior_reference
            and all(evidence[key] is None for key in ("current_independent_index_read", "paired_selection",
                                                        "Reader_allocation", "native_execution_or_TRAIN_admission"))
            and evidence["dispatch_authority"] is False,
            "Guide567 must extend the Guide566 publisher projection with no live selection")
    frontier = retained_json(evidence["retained_published_frontier"])
    code = retained_json(evidence["code_publication"])
    pub = retained_json(evidence["published_guide"])
    writer = retained_json(evidence["latest_closed_writer"])
    prev = retained_json(prior["recorded_publication"])
    roots = evidence["current_roots"]
    require(frontier["publication"] == evidence["published_guide"]
            and pub["source_closed_installation"] == evidence["latest_closed_writer"]
            and pub["terminal_returncode"] == code["terminal_returncode"] == 0
            and code["source_review_or_corpus_admission_granted"] is False
            and code["Source_READ7"] == writer["current_Source_READ7"] == evidence["original_closed_prepublication_READ7"]
            and writer["prior_guide_publication"] == prior["recorded_publication"]
            and pub["evidence_ordinal"] == 567 and len(pub["committed_docs"]) == 4
            and pub["all_other_paths_and_gitlinks_preserved"] is True,
            "Guide567 publication does not bind the exact six-code and four-document chain")
    for first, next_ in ((prev, code), (code, pub)):
        p, n = first["pushes_in_actual_order"], next_["pushes_in_actual_order"]
        require([row["repository"] for row in p] == [row["repository"] for row in n] ==
                    ["datasets", "hallucinate", "root"]
                and [row["after"] for row in p] == [row["before"] for row in n]
                and all(row["normal_fast_forward"] is True and row["push_returncode"] == 0 for row in n),
                "Guide567 publication chain is crossed or incomplete")
    for role, repository in (("D", "datasets"), ("A", "accelerate")):
        require(roots[role]["HEAD"] == pub["repositories"][repository]["origin_main"]
                and roots[role]["tree"] == pub["repositories"][repository]["tree"],
                "Guide567 projection binds a different published pair")
    require(frontier["dataset_tip"] == roots["D"]["HEAD"] and frontier["accelerate_tip"] == roots["A"]["HEAD"]
            == prior["last_verified_published_accelerate_sha"],
            "Guide567 publication differs from the selected Datasets and Accelerate roots")
    index = pub["index_readback"]["datasets"]
    reader = retained_json(evidence["reader_pending_current_index"])
    require(index["before"] == code["index_before"]["datasets"] == code["index_after"]["datasets"]
            and frontier["publisher_index"] == reader["current_index"] == index["after"]
            and all(index["after"][key] == evidence["publisher_matched_index"][key] for key in ("bytes", "sha256"))
            and reader["current_roots"] == roots and reader["current_retained_epochs"] == evidence["retained_lists"]
            and reader["Stage_A_owner_selection"] is None and reader["execution_selected"] is False
            and (evidence["published_index_paths"], evidence["held_body_roles"], evidence["reused_archives"],
                 evidence["pending_capture_roles"]) == (41249, 32, 20, 12)
            and len(reader["fresh_Source_body_targets"]) == 32 and len(reader["phase7_shared_paths"]) == 20,
            "Guide567 Reader plan changed corpus or archive scope")
    transition = evidence["pending_body_changed"]
    after, = [row for row in reader["fresh_Source_body_targets"] if row["path"] == transition["after"]["path"]]
    role = code["six_Source_stage_commit_and_compile_joins"][transition["relative_path"]]
    require(after == transition["after"] and after["full9"] is transition["before"]["full9"] is None
            and (after["sha256"], after["bytes"], after["expected_Git_blob_oid"]) ==
                (role["sha256"], role["bytes"], role["stage0_and_committed_blob"])
            and transition["before"]["expected_Git_blob_oid"] == role["parent_blob"]
            and evidence["changed_reader_row_ordinals"] == [85, 659, 1218, 1219, 1220, 1221, 1252],
            "the updated Stage A body must stay pending under its exact published code identity")
    quote = evidence["conditional_cost"]
    paid = retained_json(frontier["retained_full_charge"])["after_full_retained_precharge"]
    balance = min(paid["global_cap"] - paid["used"], paid["internal_cap"] - paid["internal_used"])
    growth = quote["document_growth_bytes"] + 3 * quote["body_growth_bytes"]
    require(paid == evidence["conservative_ledger"] and balance == frontier["retained_headroom_bytes"]
                  == quote["headroom_bytes"]
            and quote["body_growth_bytes"] == after["bytes"] - transition["before"]["bytes"]
            and quote["owner_overhead_included"] is False
            and quote["selector_bytes"] == prior["conditional_selector_bytes"]
            and quote["selector_and_reader_bytes"] == quote["selector_bytes"] + quote["Reader_with_matrix_bytes"]
                  == prior["conditional_combined_bytes_before_overhead"] + growth
            and quote["shortfall_before_owner_overhead"] == quote["selector_and_reader_bytes"] - balance,
            "Guide567 must price the verified fresh-body capture, write and readback")
    return prior | {
        "observed_guide": 567, "recorded_publication": evidence["published_guide"],
        "publisher_preflight": reference, "candidate_reader_pending_current_index": evidence["reader_pending_current_index"],
        "last_verified_published_datasets_sha": roots["D"]["HEAD"], "recorded_headroom_bytes": balance,
        "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
        "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
        "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"],
    }




def pending_v582_stage_a(reference, prior):
    evidence = retained_json(reference)
    require(evidence["schema"] == "private-stage-a-v582-retained-publication-rebind/v1"
            and evidence["basis_guide567"] == prior["publisher_preflight"]
            and evidence["actual_catalog_ordinal_unchanged"] == prior["observed_guide"] == 567
            and all(evidence[field] is None for field in ("independent_post_publication_index_read",
                        "paired_selection", "Reader_allocation", "independent_TRAIN_cohort"))
            and evidence["dispatch_authority"] is False, "v582 must remain an unselected successor of Guide567")
    code = retained_json(evidence["actual_code_publication"])
    closed = retained_json(evidence["existing_local_READ3_before_publication"])
    previous = retained_json(prior["recorded_publication"])
    roots = evidence["current_roots"]
    require(code["terminal_returncode"] == 0 and code["Source_READ3"] == evidence["existing_local_READ3_before_publication"]
            and code["prior_Guide567"] == prior["recorded_publication"]
            and [row["before"] for row in code["pushes_in_actual_order"]] ==
                [row["after"] for row in previous["pushes_in_actual_order"]]
            and roots["D"]["HEAD"] == code["repositories"]["datasets"]["origin_main"]
            and roots["A"]["HEAD"] == code["repositories"]["accelerate"]["origin_main"] ==
                prior["last_verified_published_accelerate_sha"]
            and code["source_review_or_corpus_admission_granted"] is False,
            "v582 is unrelated to the closed Guide567 publication or retained READ3")
    index = code["index_after"]["datasets"]
    raw = evidence["published_index_matching_retained_raw"]
    reader = retained_json(evidence["Reader_candidate"])
    paid = retained_json(evidence["full_retained_precharge"])["after_full_retained_precharge"]
    quote = evidence["conditional_cost"]
    require(index == code["index_before"]["datasets"] == reader["current_index"] ==
                {key: closed["protected_index_reference"][key] for key in ("path", "bytes", "sha256", "full9")}
            and all(index[key] == raw[key] for key in ("bytes", "sha256"))
            and reader["current_roots"] == roots and reader["current_retained_epochs"] == evidence["retained_lists"]
            and reader["execution_selected"] is False and reader["Stage_A_owner_selection"] is None
            and evidence["changed_guard_row_ordinals"] == [85, 232, 523]
            and evidence["same_32_body_roles"] is True
            and (evidence["reused_archive_roles"], evidence["pending_capture_roles"]) == (20, 12),
            "v582 publication and rebind must retain the same Reader body scope")
    require(paid == evidence["retained_ledger"] and quote["headroom_bytes"] ==
                min(paid["global_cap"] - paid["used"], paid["internal_cap"] - paid["internal_used"])
            and quote["headroom_bytes"] == prior["recorded_headroom_bytes"]
            and quote["selector_and_reader_bytes"] == prior["conditional_combined_bytes_before_overhead"]
            and quote["shortfall_before_owner_overhead"] == prior["conditional_shortfall_bytes_before_overhead"],
            "v582 changed the quote or ledger independently of the verified replay")
    return prior | {
        "last_verified_published_datasets_sha": roots["D"]["HEAD"],
        "latest_postcatalog_code_publication": evidence["actual_code_publication"],
        "latest_postcatalog_rebind": reference,
        "candidate_reader_pending_current_index": evidence["Reader_candidate"],
        "quote_basis": "retained Guide567 replay plus v582 two-file publication and prior closed local READ3",
    }


def joined_guide568_stage_a(reference, prior):
    sealed = retained_json(reference)
    require(sealed["schema"] == "private-guide568-stage-a-offline-rebind-with-closed-READ1/v1"
            and sealed["code_publication"] == prior["latest_postcatalog_code_publication"]
            and prior["observed_guide"] == 567
            and sealed["dispatch_authority"] is sealed["current_source_cap_changed_by_this_replay"] is False
            and all(sealed[key] is None for key in ("current_paired_selection", "current_reader_allocation",
                                                  "current_corpus_TRAIN_admission")),
            "Guide568 must be the independently observed successor of the prior published code")
    artifacts = sealed["private_artifacts"]
    replay = retained_json(artifacts["rebinding.json"])
    join = retained_json(artifacts["independent-read1-join.json"])
    funding = retained_json(artifacts["funding-after-read1.INERT.json"])
    pub = retained_json(sealed["published_guide"])
    code = retained_json(sealed["code_publication"])
    close = retained_json(sealed["independent_published_index_READ1"])
    require(join["published_pair"] == replay["published_guide"] == sealed["published_guide"]
            and join["publisher_matched_replay"] == artifacts["rebinding.json"]
            and join["original_READ1_compact_close"] == sealed["independent_published_index_READ1"]
            and pub["terminal_returncode"] == 0 and pub["evidence_ordinal"] == 568
            and [item["before"] for item in pub["pushes_in_actual_order"]] ==
                [item["after"] for item in code["pushes_in_actual_order"]]
            and len(pub["committed_docs"]) == 4 and pub["all_other_paths_and_gitlinks_preserved"] is True
            and close["status"] == "PASS" and close["Source_closed"] is close["owned_module_closed"] is True
            and close["errors"] == [] and close["roots_before"] == close["roots_after"]
            and len(close["captures"]) == 1,
            "Guide568 release does not join the actual closed READ1")
    observed, = close["captures"]
    index = pub["index_readback"]["datasets"]["after"]
    roles = replay["current_roots"]
    for key, repo in (("D", "datasets"), ("A", "accelerate")):
        root = roles[key]
        snapshot = close["roots_after"][root["root"]]
        require(root["HEAD"] == pub["repositories"][repo]["origin_main"] == snapshot["HEAD"]
                and root["tree"] == pub["repositories"][repo]["tree"] == snapshot["tree"]
                and root["status_sha256"] == snapshot["status_sha256"],
                "independent Guide568 read closed over a different root, commit or index scope")
    require(index == join["current_published_index"] ==
                {key: observed[key] for key in ("path", "bytes", "sha256", "full9")}
            and join["matched_full_metadata_and_raw_bytes"] is True
            and sealed["independent_READ1_exact_raw_index"] == join["original_READ1_raw_index"] == observed["raw_reference"]
            and all(index[key] == replay["publisher_matched_index"][key] == observed["raw_reference"][key]
                    for key in ("bytes", "sha256")),
            "independent Guide568 index bytes or approved published metadata differ")
    paid = retained_json(join["original_READ1_retained_paid_cap"])["after_full_retained_precharge"]
    quote = replay["conditional_cost"]
    balance = min(paid["global_cap"] - paid["used"], paid["internal_cap"] - paid["internal_used"])
    require(paid == join["retained_ledger"] and balance == join["retained_headroom_bytes"]
                   == quote["headroom_bytes"] == prior["recorded_headroom_bytes"]
            and join["observed_source_capture_count_floor"] == close["ledger_after"]["captures"]
            and quote == sealed["conditional_cost"]
            and quote["owner_overhead_included"] is False
            and quote["selector_bytes"] == prior["conditional_selector_bytes"]
            and quote["selector_and_reader_bytes"] == quote["selector_bytes"] + quote["Reader_with_matrix_bytes"]
             == prior["conditional_combined_bytes_before_overhead"] + quote["document_growth_bytes"]
            and quote["shortfall_before_owner_overhead"] == quote["selector_and_reader_bytes"] - balance
            and replay["body_roles_changed"] == [] and replay["published_index_paths"] == 41249
            and (replay["held_body_roles"], replay["reused_archives"], replay["pending_capture_roles"]) == (32, 20, 12),
            "Guide568 quote or full retained READ1 accounting differs")
    reader = retained_json(artifacts["reader.INERT.json"])
    require(replay["reader_pending_current_index"] == artifacts["reader.INERT.json"]
            and reader["current_index"] == index and reader["current_roots"] == roles
            and reader["Stage_A_owner_selection"] is None and reader["execution_selected"] is False
            and funding["applied_cap_change"] is funding["dispatch_authority"] is False
            and funding["actual_allocation"] is None,
            "closed index observation cannot stand in for a separate paired selector or Reader allocation")
    return prior | {
        "observed_guide": 568, "source_frontier": "published_pair_independently_observed_selection_and_funding_pending",
        "last_verified_published_datasets_sha": roles["D"]["HEAD"],
        "last_verified_published_accelerate_sha": roles["A"]["HEAD"],
        "recorded_publication": sealed["published_guide"], "publisher_preflight": artifacts["rebinding.json"],
        "original_index_read_close": sealed["independent_published_index_READ1"],
        "current_independent_read_join": artifacts["independent-read1-join.json"],
        "candidate_reader_pending_current_index": None,
        "reader_candidate_after_independent_index_read": artifacts["reader.INERT.json"],
        "current_source_funding_inputs": artifacts["funding-after-read1.INERT.json"],
        "recorded_headroom_bytes": balance,
        "quote_basis": "Guide568 publisher replay and independently closed v584 index read",
        "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
        "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
        "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"],
    }


def pending_guide569_stage_a(reference, funding_ref, paid_ref, prior):
    evidence = retained_json(reference)
    require(evidence["schema"] == "private-stage-a-guide569-publisher-preflight/v1"
            and prior["observed_guide"] == 568 and evidence["basis"] == prior["publisher_preflight"]
            and evidence["prior_independent_read"] == prior["current_independent_read_join"]
            and all(evidence[key] is None for key in ("current_independent_index_read", "paired_selection",
                            "Reader_allocation", "native_execution_or_TRAIN_admission"))
            and evidence["dispatch_authority"] is False,
            "Guide569 must retain Guide568's actual independent read and its own unselected status")
    publication = retained_json(evidence["published_guide"])
    earlier = retained_json(prior["recorded_publication"])
    writer = retained_json(evidence["latest_closed_writer"])
    stage_costs = retained_json(paid_ref)
    require(publication["terminal_returncode"] == 0 and publication["evidence_ordinal"] == 569
            and publication["source_closed_installation"] == evidence["latest_closed_writer"]
            and publication["all_other_paths_and_gitlinks_preserved"] is True and len(publication["committed_docs"]) == 4
            and [row["before"] for row in publication["pushes_in_actual_order"]] ==
                [row["after"] for row in earlier["pushes_in_actual_order"]]
            and writer["Source_closed"] is writer["module_closed"] is True
            and evidence["native_success_retained_precharge"] == stage_costs["v586_full_precharge"],
            "Guide569 publication or original fictional validation charge lineage differs")
    reader = retained_json(evidence["reader_pending_current_index"])
    funding = retained_json(funding_ref)
    paid = retained_json(evidence["current_full_retained_precharge"])
    charge = paid["after_full_retained_precharge"]
    quote = evidence["conditional_cost"]
    balance = min(charge["global_cap"] - charge["used"], charge["internal_cap"] - charge["internal_used"])
    index = publication["index_readback"]["datasets"]
    roots = evidence["current_roots"]
    require(index["before"] == earlier["index_readback"]["datasets"]["after"]
            and all(evidence["publisher_matched_index"][key] == index["after"][key] for key in ("bytes", "sha256"))
            and reader["current_index"] == index["after"] and reader["current_roots"] == roots
            and reader["current_retained_epochs"] == evidence["retained_lists"]
            and roots["D"]["HEAD"] == publication["repositories"]["datasets"]["origin_main"]
            and roots["A"]["HEAD"] == publication["repositories"]["accelerate"]["origin_main"]
                                         == prior["last_verified_published_accelerate_sha"]
            and (evidence["published_index_paths"], evidence["held_body_roles"], evidence["reused_archives"],
                 evidence["pending_capture_roles"]) == (41249, 32, 20, 12)
            and reader["Stage_A_owner_selection"] is None and reader["execution_selected"] is False,
            "Guide569 rebind must preserve the original 32 body roles and exact published index")
    require(publication["Source_only_full_charge_retained"] == evidence["current_full_retained_precharge"]
            and paid["prior"] == stage_costs["conservative_charged_ledger"]
            and charge == evidence["conservative_ledger"] and quote["headroom_bytes"] == balance
            and quote["selector_bytes"] == prior["conditional_selector_bytes"]
            and quote["selector_and_reader_bytes"] == quote["selector_bytes"] + quote["Reader_with_matrix_bytes"]
                  == prior["conditional_combined_bytes_before_overhead"] + quote["document_growth_bytes"]
            and quote["shortfall_before_owner_overhead"] == quote["selector_and_reader_bytes"] - balance
            and funding["publisher_matched_replay"] == reference
            and funding["current_independent_index_read"] is funding["actual_allocation"] is None
            and funding["applied_cap_change"] is funding["dispatch_authority"] is False,
            "Guide569 quote must carry all charges and leave live allocations unset")
    return prior | {
        "observed_guide": 569, "source_frontier": "published_pair_pending_independent_current_read",
        "recorded_publication": evidence["published_guide"], "publisher_preflight": reference,
        "last_verified_published_datasets_sha": roots["D"]["HEAD"],
        "last_verified_published_accelerate_sha": roots["A"]["HEAD"],
        "quote_basis": "Guide569 publisher replay from the independently closed Guide568 index",
        "recorded_headroom_bytes": balance, "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
        "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
        "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"],
        "original_index_read_close": None, "current_independent_read_join": None,
        "reader_candidate_after_independent_index_read": None,
        "candidate_reader_pending_current_index": evidence["reader_pending_current_index"],
        "current_source_funding_inputs": funding_ref,
    }


def project_temporal_continued_cost_fixture(reference):
    descriptor = read_design(Path(reference["path"]), reference["sha256"], expected_bytes=reference["bytes"])
    fixture_ref = descriptor["fixture"]
    fixture = read_design(Path(fixture_ref["path"]), fixture_ref["sha256"], expected_bytes=fixture_ref["bytes"])
    readback = fixture["readback"]
    require(descriptor["schema"] == "temporal-continued-first-use-cost-private-controls/v1"
            and descriptor["local_test_count"] == 12 and descriptor["test_exit"] == 0
            and descriptor["real_meter_receipt"] is None
            and fixture["scope"] == "fictional_meter_and_saved_checkpoint_fixtures" and fixture["real_updates"] == 0
            and readback["schema"] == "reviewed-temporal-policy-continued-first-use-cost/v1"
            and len(readback["rounds"]) == 2 and len(readback["physical_paid_events"]) == 8
            and readback["physical_work_ns"] == {"cpu_ns": 204, "gpu_ns": None}
            and readback["whole_study_elapsed_wall"] is None
            and readback["cost_to_held_out_threshold_established"] is False
            and readback["dispatch_authority"] is False,
            "selected temporal paid-continuation fixture does not establish any real meter, wall or effect")
    return {"scope": fixture["scope"], "passing_local_controls": descriptor["local_test_count"],
            "current_actual_meter_evidence": None, "whole_study_elapsed_wall": None,
            "cost_to_held_out_threshold_established": False, "dispatch_authority": False}


def pending_guide570_stage_a(reference, prior):
    seal = retained_json(reference)
    bundle = seal["private_artifacts"]
    rebind, funding = bundle["rebinding.json"], bundle["funding.INERT.json"]
    evidence, costs = map(retained_json, (rebind, funding))
    old, code, published, local, writer, reader, paid = map(retained_json, (
        prior["recorded_publication"], evidence["code_publication"], evidence["published_guide"],
        evidence["original_closed_prepublication_READ3"], evidence["latest_closed_writer"],
        evidence["reader_pending_current_index"], costs["full_retained_precharge"]))
    require(seal["schema"] == "private-guide570-stage-a-publisher-preflight-seal/v1"
            and evidence["schema"] == "private-stage-a-guide570-publisher-preflight/v1"
            and prior["observed_guide"] == 569 and evidence["basis"] == prior["publisher_preflight"]
            and seal["verification"]["returncode"] == code["terminal_returncode"] == published["terminal_returncode"]
                 == local["terminal_returncode"] == 0
            and seal["published_guide"] == evidence["published_guide"] == costs["published_pair"]
            and seal["code_publication"] == evidence["code_publication"] == writer["code_publication"]
            and local["previous_published_guide"] == code["prior_Guide569"] == writer["prior_guide_publication"]
                 == prior["recorded_publication"]
            and writer["current_Source_READ3"] == evidence["original_closed_prepublication_READ3"]
            and writer["Source_closed"] is writer["module_closed"] is local["Source_closed"] is local["module_closed"] is True
            and published["source_closed_installation"] == evidence["latest_closed_writer"]
            and published["all_other_paths_and_gitlinks_preserved"] is True
            and published["evidence_ordinal"] == 570 and len(published["committed_docs"]) == 4,
            "Guide570 replay must retain the closed historical Source and both actual publications")
    for current, earlier in ((code, old), (published, code)):
        pushes = current["pushes_in_actual_order"]
        require(len(pushes) == 3 and all(row["normal_fast_forward"] is True for row in pushes)
                and [row["before"] for row in pushes] == [row["after"] for row in earlier["pushes_in_actual_order"]],
                "Guide570 verification requires successive normal publications")
    index = published["index_readback"]["datasets"]
    roots = evidence["current_roots"]
    require(index["before"] == code["index_after"]["datasets"] == local["protected_index_reference"]
            and reader["current_index"] == index["after"]
            and all(index["after"][key] == evidence["publisher_matched_index"][key] for key in ("bytes", "sha256"))
            and reader["current_roots"] == roots and reader["current_retained_epochs"] == evidence["retained_lists"]
            and roots["D"]["HEAD"] == published["repositories"]["datasets"]["origin_main"]
            and roots["A"]["HEAD"] == published["repositories"]["accelerate"]["origin_main"]
                 == prior["last_verified_published_accelerate_sha"]
            and (evidence["published_index_paths"], evidence["held_body_roles"], evidence["reused_archives"],
                 evidence["pending_capture_roles"]) == (41249, 32, 20, 12)
            and evidence["body_roles_changed"] == [] and len(evidence["metadata_guards_changed"]) == 2
            and all(evidence[key] is None for key in ("current_independent_index_read", "paired_selection",
                                                    "Reader_allocation", "native_execution_or_TRAIN_admission"))
            and reader["Stage_A_owner_selection"] is None and reader["execution_selected"] is False,
            "Guide570 replay must carry the matched index and exact body roles while independent Source selection is open")
    quote = evidence["conditional_cost"]
    charge = paid["after_full_retained_precharge"]
    balance = min(charge["global_cap"] - charge["used"], charge["internal_cap"] - charge["internal_used"])
    component_bytes = tuple(request["bytes"] for request in costs["finite_source_requests_in_owner_order"])
    require(seal["conditional_cost"] == quote and seal["full_retained_ledger"] == costs["full_retained_precharge"]
            == published["Source_only_full_charge_retained"] and charge == evidence["conservative_ledger"]
            and paid["all_prior_costs_retained"] is True and costs["publisher_matched_replay"] == rebind
            and costs["current_independent_index_read"] is costs["actual_allocation"] is None
            and costs["applied_cap_change"] is costs["dispatch_authority"] is False
            and evidence["dispatch_authority"] is seal["dispatch_authority"] is False
            and balance == costs["retained_headroom_bytes"] == quote["headroom_bytes"]
            and component_bytes == (prior["conditional_selector_bytes"], quote["Reader_with_matrix_bytes"])
            and sum(component_bytes) == quote["selector_and_reader_bytes"]
                 == prior["conditional_combined_bytes_before_overhead"] + quote["document_growth_bytes"]
            and sum(component_bytes) - balance == quote["shortfall_before_owner_overhead"]
                 == costs["finite_quota_before_original_owner_overhead"]
            and costs["standalone_independent_D_index_read_payload_floor_excluded_from_quote"] == index["after"]["bytes"] + 1,
            "Guide570 budget must retain all prior charges and separate the standalone index request")
    return prior | {
        "observed_guide": 570, "source_frontier": "published_pair_pending_independent_current_read",
        "recorded_publication": evidence["published_guide"], "publisher_preflight": rebind,
        "last_verified_published_datasets_sha": roots["D"]["HEAD"],
        "last_verified_published_accelerate_sha": roots["A"]["HEAD"],
        "quote_basis": "Guide570 publisher replay through the retained v589 index and both normal releases",
        "recorded_headroom_bytes": balance, "conditional_Reader_bytes": quote["Reader_with_matrix_bytes"],
        "conditional_combined_bytes_before_overhead": quote["selector_and_reader_bytes"],
        "conditional_shortfall_bytes_before_overhead": quote["shortfall_before_owner_overhead"],
        "standalone_independent_index_payload_floor_excluded_from_quote":
             costs["standalone_independent_D_index_read_payload_floor_excluded_from_quote"],
        "candidate_reader_pending_current_index": evidence["reader_pending_current_index"],
        "current_source_funding_inputs": funding,
    }


