    preview = retained_json(row["reader_preview"])
    require(row["schema"] == "private-guide573-stage-a-exact-replay-and-price/v1"
            and prior["observed_guide"] == 573 and prior["Guide573_detached_metadata"] == replay["guide573_metadata"]
            and replay["writer_expected_index"] == prior["recorded_published_datasets_index"]
            and row["writer_matched_index"] == replay["writer_matched_index"]
            and all(replay["writer_matched_index"][key] == replay["writer_expected_index"][key]
                    for key in ("bytes", "sha256"))
            and replay["Git_index_entries"] == 41250
            and len(replay["protected_roles"]) == 32 and all(role["Git_stage"] == 0 for role in replay["protected_roles"])
            and selector["expected_roots"] == replay["published_roots"] == preview["reader_inputs"]["current_roots"]
            and row["index_replay"] == preview["relocation_proof"]
            and row["reader_preview"] == quote["basis_preview"]
            and row["selector_basis"] == quote["expected_selector_roots"]
            and preview["execution_selected"] is False and preview["source_body_reads"] == 32
            and preview["archive_historical_count"] == 20 and row["local_reader_controls"] == 7
            and row["Source_Git_and_owner_authority_modeled_in_reader_controls"] is True
            and row["independent_current_index_read"] is row["paired_selection"] is row["live_reader_allocation"]
                is row["model_or_training_execution"] is None and row["dispatch_authority"] is False,
            "exact detached Guide573 index, roots and body-role reconciliation required")
    selector_bound = quote["selector_git_stream_allowance"] + quote["selector_raw_stream_write_readback_allowance"]
    reader_bound = quote["Reader_core"]["logical_selected_bytes"] + quote["Reader_parent_matrix_allowance"]
    total = selector_bound + reader_bound
    require(quote["retained_headroom_bytes"] == prior["recorded_headroom_bytes"]
            and quote["selector_Reader_conditional_subtotal"] == total == 26_777_300
            and total - quote["retained_headroom_bytes"] == quote["conditional_pair_gap_before_owner_overhead"]
            and quote["independent_index_payload_gap"] == prior["standalone_independent_index_payload_shortfall"]
            and quote["independent_index_read_included"] is False
            and quote["additional_owner_control_roster"] is quote["live_reservation"] is None,
            "Guide573 conditional reservation must retain its separate resource decisions")
    return prior | {"source_frontier":"published_writer_matched_index_and_paired_quote_await_current_owner",
        "Guide573_exact_offline_index_roles":row["index_replay"],"Guide573_offline_Reader_v3":row["reader_preview"],
        "replayed_stage_zero_protected_count":32,"quote_basis":"Guide573 v3 all-fresh conditional, one preview read",
        "conditional_Reader_bytes":reader_bound,"conditional_selector_bytes":selector_bound,
        "conditional_combined_bytes_before_overhead":total,
        "conditional_shortfall_bytes_before_overhead":quote["conditional_pair_gap_before_owner_overhead"]}


