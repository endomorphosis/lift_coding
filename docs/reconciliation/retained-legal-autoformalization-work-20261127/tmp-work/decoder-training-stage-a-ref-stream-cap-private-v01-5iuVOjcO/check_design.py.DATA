def pending_guide571_stage_a(reference, prior):
    seal = retained_json(reference)
    artifacts = seal["private_artifacts"]
    rebind, funding = artifacts["rebinding.json"], artifacts["funding.INERT.json"]
    evidence, costs = map(retained_json, (rebind, funding))
    earlier, earlier_read, published, writer, reader, charge = map(retained_json, (
        prior["recorded_publication"], evidence["prior_independent_read"], evidence["published_guide"],
        evidence["latest_closed_writer"], evidence["reader_pending_current_index"], costs["full_retained_precharge"]))
    require(seal["schema"] == "private-guide571-stage-a-publisher-preflight-seal/v1"
            and evidence["schema"] == "private-stage-a-guide571-publisher-preflight/v1"
            and prior["observed_guide"] == 570 and evidence["basis"] == prior["publisher_preflight"]
            and seal["published_guide"] == costs["published_pair"] == evidence["published_guide"]
            and earlier_read["Guide570_publication"] == writer["prior_guide_publication"] == prior["recorded_publication"]
            and seal["prior_independent_read"] == evidence["prior_independent_read"]
            and seal["verification"]["returncode"] == earlier_read["terminal_returncode"]
                 == published["terminal_returncode"] == writer["actual_owned_exit_code"] == 0
            and earlier_read["Source_closed"] is earlier_read["module_closed"]
                 is writer["Source_closed"] is writer["module_closed"] is True
            and published["source_closed_installation"] == evidence["latest_closed_writer"]
            and published["all_other_paths_and_gitlinks_preserved"] is True
            and published["evidence_ordinal"] == 571 and len(published["committed_docs"]) == 4,
            "Guide571 must retain the closed prior read, writer and normal published receipt")
    pushes = published["pushes_in_actual_order"]
    require(len(pushes) == 3 and all(row["normal_fast_forward"] is True and row["push_returncode"] == 0 for row in pushes)
            and [(row["repository"], row["before"]) for row in pushes]
                == [(row["repository"], row["after"]) for row in earlier["pushes_in_actual_order"]],
            "Guide571 must follow the actual Guide570 publication")
    index = published["index_readback"]["datasets"]
    current_raw = artifacts["guide571-index.DATA"]
    prior_raw = seal["prior_independent_raw_index"]
    for captured, selected in ((prior_raw, index["before"]), (current_raw, index["after"])):
        raw = Path(captured["path"]).read_bytes()
        require(len(raw) == captured["bytes"] == selected["bytes"]
                and sha256(raw).hexdigest() == captured["sha256"] == selected["sha256"],
                "Guide571 must retain the exact old and publisher-matched index bytes")
    roles, roots = seal["stage_a_roles"], evidence["current_roots"]
    require(earlier_read["index"] == index["before"] == earlier["index_readback"]["datasets"]["after"]
            and earlier_read["actual_raw_index"] == prior_raw == evidence["prior_independent_raw_index"]
            and current_raw == seal["publisher_matched_current_index"] == evidence["publisher_matched_index"]
            and reader["current_index"] == index["after"]
            and reader["current_roots"] == roots and reader["current_retained_epochs"] == evidence["retained_lists"]
            and roots["D"]["HEAD"] == published["repositories"]["datasets"]["origin_main"]
            and roots["A"]["HEAD"] == published["repositories"]["accelerate"]["origin_main"]
                 == prior["last_verified_published_accelerate_sha"]
            and (evidence["published_index_paths"], roles["held"], roles["reused_archives"], roles["pending"])
                 == (41249, evidence["held_body_roles"], evidence["reused_archives"], evidence["pending_capture_roles"])
                 == (41249, 32, 20, 12)
            and roles["body_roles_changed"] == []
            and roles["changed_reader_row_ordinals"] == evidence["changed_reader_row_ordinals"]
            and all(evidence[key] is None for key in ("current_independent_index_read", "paired_selection",
                                                    "Reader_allocation", "native_execution_or_TRAIN_admission"))
            and all(seal[key] is None for key in ("current_independent_index_read", "actual_paired_selection",
                                                "actual_reader_allocation", "native_execution_or_TRAIN_admission"))
            and reader["Stage_A_owner_selection"] is None and reader["execution_selected"] is False,
            "Guide571 publisher replay must preserve the exact body roles and leave independent selection open")
    quote = evidence["conditional_cost"]
    ledger = charge["after_full_retained_precharge"]
    balance = min(ledger["global_cap"] - ledger["used"], ledger["internal_cap"] - ledger["internal_used"])
    requests = costs["finite_source_requests_in_owner_order"]
    component_bytes = tuple(request["bytes"] for request in requests)
    require(seal["conditional_cost"] == quote and seal["full_retained_ledger"] == costs["full_retained_precharge"]
            == evidence["current_full_retained_precharge"] == published["Source_only_full_charge_retained"]
            and seal["carried_retained_ledger"] == [evidence["prior_independent_read_precharge"],
                                                   evidence["native_retained_precharge"], seal["full_retained_ledger"]]
            and ledger == evidence["conservative_ledger"] and charge["all_prior_costs_retained"] is True
            and seal["observed_source_capture_count_floor"] == costs["observed_source_capture_count_floor"]
                == evidence["captured_observed_source_io_count"] and seal["observed_source_capture_count_floor"] >= ledger["captures"]
            and costs["publisher_matched_replay"] == rebind
            and costs["current_independent_index_read"] is costs["actual_allocation"] is costs["selector_close"] is None
            and costs["applied_cap_change"] is costs["dispatch_authority"] is evidence["dispatch_authority"]
                is seal["dispatch_authority"] is quote["owner_overhead_included"] is False
            and [(request["role"], request["input"]) for request in requests]
                == [("paired_selector", artifacts["selector.INERT.json"]), ("reader", evidence["reader_pending_current_index"])]
            and balance == costs["retained_headroom_bytes"] == quote["headroom_bytes"]
            and component_bytes == (prior["conditional_selector_bytes"], quote["Reader_with_matrix_bytes"])
            and sum(component_bytes) == quote["selector_and_reader_bytes"]
                == prior["conditional_combined_bytes_before_overhead"] + quote["document_growth_bytes"]
            and sum(component_bytes) - balance == quote["shortfall_before_owner_overhead"]
                == costs["finite_quota_before_original_owner_overhead"]
            and costs["standalone_independent_D_index_read_payload_floor_excluded_from_quote"] == current_raw["bytes"] + 1,
            "Guide571 budget must retain all prior costs and separate the standalone current index request")
    return prior | {
        "observed_guide": 571, "source_frontier": "published_pair_pending_independent_current_read",
