def guide572_stage_a_frontier(reference, prior):
    replay = retained_json(reference)
    publication = replay["Guide572_documentary_publication"]
    published = retained_json(publication)
    old_index = retained_json(prior["recorded_publication"])["index_readback"]
    code = retained_json(published["actual_code_publication"])
    writer = retained_json(published["actual_doc_Source_closed"])
    paid = retained_json(writer["full_charge"])
    root_pair = published["live_main_after"]
    pushes = published["pushes_in_actual_order"]
    roots = ("datasets", "hallucinate", "root")
    require(prior["observed_guide"] == 571
            and published["schema"] == "actual-Guide572-four-docs-live-ordinary33-three-FF-publication/v1"
            and published["evidence_ordinal"] == writer["evidence_ordinal"] == 572
            and published["terminal_returncode"] == writer["terminal_returncode"] == code["terminal_returncode"] == 0
            and code["terminal_success"] is code["publish_selected"] is True
            and writer["only_four_Git_changes"]
                 is writer["module_closed"] is writer["Source_closed"] is True
            and writer["code_publication"] == published["actual_code_publication"]
            and published["live_main_before"] == code["live_main_after"]
            and type(published["only_four_docs"]) is list and len(published["only_four_docs"]) == 4
            and len(writer["committed_docs"]) == 4
            and (writer["prior_D"], writer["HEAD"], writer["A"]) == (
                published["live_main_before"]["datasets"], root_pair["datasets"], root_pair["accelerate"])
            and [row["repository"] for row in pushes] == list(roots)
            and all(row["normal_fast_forward"] is True and row["push_returncode"] == 0
                    and (row["before"], row["after"]) == (published["live_main_before"][root], root_pair[root])
                    for row, root in zip(pushes, roots, strict=True))
            and published["accelerate_published_head_preserved"] is True
            and root_pair["accelerate"] == published["live_main_before"]["accelerate"],
            "Guide572 Stage A basis must retain the original writer and three actual normal publications")
    index, companion = writer["index"], writer["A_index"]
    require(all(type(record) is dict and type(record.get("bytes")) is int and record["bytes"] > 0
                and digest(record.get("sha256")) and str(record.get("path", "")).endswith("/.git/index")
                for record in (index, companion))
            and index["path"] != old_index["datasets"]["after"]["path"]
            and companion["path"] != old_index["accelerate"]["after"]["path"],
            "new Guide572 index observations belong to the new checkout paths")
    roles = replay["protected_body_roles"]
    archived = replay["Guide572_publisher_matched_D_index"]
    raw = Path(archived["path"]).read_bytes()
    delta = replay["direct_byte_delta_only"]
    require(replay["schema"] == "private-retained-stage-a-guide572-publication-reconciliation/v1"
            and replay["Guide571_basis"] == prior["publisher_preflight"]
            and replay["Guide572_source_close"] == published["actual_doc_Source_closed"]
            and replay["Guide572_protected_D_expected_index"] == index
            and replay["current_remote_heads"] == root_pair
            and len(raw) == archived["bytes"] == index["bytes"]
            and sha256(raw).hexdigest() == archived["sha256"] == index["sha256"]
            and len(roles) == replay["protected_role_count"] == 32
            and len({row["protected_old"]["path"] for row in roles}) == 32
            and all(row["closed_ordinary_epoch"]["path"] != row["protected_old"]["path"]
                    and all(row["closed_ordinary_epoch"][key] == row["protected_old"][key]
                            for key in ("bytes", "sha256"))
                    and row["Git"]["stage"] == 0 and row["Git"]["oid"] == row["protected_old"]["expected_Git_blob_oid"]
                    and row["Git"]["mode"] == row["protected_old"]["expected_Git_mode"] for row in roles)
            and replay["protected_body_sha256_size_and_Git_stage0_changes"] == 0
            and replay["protected_role_root_changed"] is True
            and replay["historical_archive_partition"] == {"fresh_roles": 12, "rebound_live": False, "retained_archives": 20}
            and replay["Guide572_independent_postpublication_index_READ1"] is replay["paired_selection"]
                 is replay["Reader_allocation"] is replay["TRAIN_or_Native_admission"] is None
            and replay["quote"]["Guide572_combined"] is None and replay["dispatch_authority"] is False
            and delta["D_index"] == index["bytes"] - old_index["datasets"]["after"]["bytes"]
            and delta["A_index"] == companion["bytes"] - old_index["accelerate"]["after"]["bytes"]
            and delta["32_body_sizes"] == 0
            and set(delta["docs_each"]) == set(published["only_four_docs"])
            and delta["subtotal"] == sum(delta["docs_each"].values()) + delta["D_index"] + delta["A_index"],
            "Guide572 detached index replay must retain its relocated body roles and unresolved archive admission")
    ledger = paid["after_full_retained_precharge"]
    headroom = min(ledger["global_cap"] - ledger["used"], ledger["internal_cap"] - ledger["internal_used"])
    require(paid["all_prior_costs_retained"] is True and ledger["captures"] == replay["observed_source_capture_count_floor"]
            and ledger["captures"] >= prior["latest_retained_capture_floor"]
            and headroom == replay["current_retained_headroom_bytes"]
            and prior["current_independent_read_join"] is prior["actual_paired_selection"]
                 is prior["actual_reader_allocation"] is None,
            "current ledger keeps prior charges and leaves Stage A ownership open")
    return prior | {
        "observed_guide": 572, "source_frontier": "published_new_checkout_pending_independent_index_and_archive_rebind",
        "recorded_publication": publication, "Guide572_offline_reconciliation": reference,
        "verified_relocated_body_roles": replay["protected_role_count"], "verified_direct_bytes_delta": delta["subtotal"],
        "last_verified_published_datasets_sha": root_pair["datasets"],
        "last_verified_published_accelerate_sha": root_pair["accelerate"],
        "recorded_published_datasets_index": index, "recorded_published_accelerate_index": companion,
        "recorded_headroom_bytes": headroom, "latest_retained_capture_floor": ledger["captures"],
        "historical_prior_checkout_paired_quote": {key: prior[key] for key in (
            "quote_basis", "conditional_Reader_bytes", "conditional_selector_bytes",
            "conditional_combined_bytes_before_overhead", "conditional_shortfall_bytes_before_overhead")},
        "quote_basis": "Guide572 owner must rebind absolute checkout paths and original archive admission before a paired quote",
        "conditional_Reader_bytes": None, "conditional_selector_bytes": None,
        "conditional_combined_bytes_before_overhead": None, "conditional_shortfall_bytes_before_overhead": None,
        "publisher_preflight": reference, "candidate_reader_pending_current_index": None,
        "current_source_funding_inputs": None, "current_publication_retained_precharge": writer["full_charge"],
        "reader_candidate_after_independent_index_read": None, "original_index_read_close": None,
        "standalone_independent_index_payload_floor_excluded_from_quote": index["bytes"] + 1,
        "standalone_independent_index_payload_shortfall": max(0, index["bytes"] + 1 - headroom),
    }


