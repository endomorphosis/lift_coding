+def _verify_relocated_a0_capture_roster(expected, captures, archived, datasets_root, output_root):
+    require(type(expected) is list and type(captures) is list and len(expected) == len(captures) == 32
+            and all(type(row) is dict and set(row) == {'path', 'bytes', 'sha256', 'full9'}
+                    and type(row['path']) is str and row['path'].endswith('.py')
+                    and Path(row['path']).is_relative_to(datasets_root)
+                    and type(row['bytes']) is int and 0 < row['bytes'] <= 16 * 1024**2
+                    and _sha_pin(row['sha256']) for row in expected)
+            and list(archived) == expected,
+            'exact selected relocated capture roster must match the archived 32-file tail')
+    for ordinal, (row, event) in enumerate(zip(expected, captures, strict=True)):
+        validate_full9(row['full9'], row['bytes'])
+        require(type(event) is dict and set(event) == {'canonical_path', 'capture', 'raw_reference'}
+                and event['canonical_path'] == row['path'] and type(event['capture']) is dict,
+                'relocated Reader canonical capture order or shape differs')
+        witness, raw = event['capture'], event['raw_reference']
+        require(type(raw) is dict and set(raw) == {'path', 'bytes', 'sha256', 'full9'}
+                and type(raw['bytes']) is int
+                and raw['path'] == str(output_root / 'raw' / f'{ordinal}-stage-a.DATA')
+                and (raw['bytes'], raw['sha256']) == (row['bytes'], row['sha256'])
+                and witness.get('actual_source_result') == row
+                and witness.get('source_parent_all_fields_equal') is True
+                and witness.get('private_output_integrity_and_owner_passed') is True
+                and witness.get('private_raw_readback') == {key: raw[key] for key in ('bytes', 'sha256', 'full9')},
+                'relocated Reader capture lacks matching Source-end and private readback evidence')
+        validate_full9(raw['full9'], raw['bytes'])
+        require(stat.S_IMODE(int(raw['full9']['st_mode'])) == 0o400,
+                'relocated Reader private raw capture is not immutable')
+
+
