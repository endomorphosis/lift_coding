+        "proof_checked": record.positive,
+        "trusted": record.eligible_for_training,
+        "source": "legal_ir_proof_feedback",
+        "schema_version": LEGAL_IR_PROOF_FEEDBACK_SCHEMA_VERSION,
+    }
 
 
