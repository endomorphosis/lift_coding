_WORLD_CITATION_CAMPAIGN_SPLIT_PROFILES: Final = (WORLD_CITATION_CAMPAIGN_SPLIT_PROFILE, WORLD_CITATION_CAMPAIGN_SPLIT_PROFILE_V2)
_UNICODE_CAMPAIGN_SPLIT_PROFILES: Final = (UNICODE_CAMPAIGN_SPLIT_PROFILE, *_WORLD_CITATION_CAMPAIGN_SPLIT_PROFILES)

LEGAL_IR_EVAL_SPLITS: Final = (
