SCHEMA = "reviewed-decoder-relational-heldout-selection/v1"
POLICY_ASSESSMENT_SCHEMA = "reviewed-decoder-policy-heldout-selection/v1"
T5_POLICY_ASSESSMENT_SCHEMA = "reviewed-decoder-t5-policy-heldout-selection/v1"
DECISION_SPAN_POLICY_ASSESSMENT_SCHEMA = "reviewed-decoder-decision-span-policy-heldout-selection/v1"
DECISION_SPAN_VALIDATION_ASSESSMENT_SCHEMA = "reviewed-decoder-decision-span-policy-validation-selection/v1"
DECISION_SPAN_VALIDATION_SPLIT_SCHEMA = "reviewed-decision-span-validation-split/v1"
DECISION_SPAN_VALIDATION_LOOK_SCHEMA = "reviewed-decision-span-validation-threshold-look/v1"
GUIDED_VALIDATION_ASSESSMENT_SCHEMA = "reviewed-decoder-guided-span-policy-validation-selection/v1"
GUIDED_VALIDATION_LOOK_SCHEMA = "reviewed-decoder-guided-span-validation-threshold-look/v1"
GUIDED_SPAN_PAID_VALIDATION_SCHEMA = "reviewed-guided-span-paid-validation-comparison/v1"
GUIDED_SPAN_PREUPDATE_COST_SCHEMA = "reviewed-guided-span-preupdate-discovery-cost/v1"
GUIDED_SPAN_DISCOVERY_PAID_VALIDATION_SCHEMA = "reviewed-guided-span-paid-validation-comparison/v2"
GUIDED_SPAN_DISCOVERY_EVENT_KIND = "guided_preupdate_discovery"
DECISION_SPAN_PAID_VALIDATION_SCHEMA = "reviewed-decision-span-paid-validation-comparison/v1"
T5_FUSION_VALIDATION_ASSESSMENT_SCHEMA = "reviewed-decoder-t5-fusion-span-policy-validation-selection/v1"
T5_FUSION_VALIDATION_LOOK_SCHEMA = "reviewed-decoder-t5-fusion-span-policy-validation-threshold-look/v1"
T5_FUSION_PAID_VALIDATION_SCHEMA = "reviewed-t5-fusion-span-paid-validation-comparison/v1"
T5_FUSION_STARTED_DEVELOPMENT_PAID_VALIDATION_SCHEMA = "reviewed-t5-fusion-span-paid-validation-comparison/v2"
T5_FUSION_INTERRUPTED_PREPARATION_PAID_VALIDATION_SCHEMA = "reviewed-t5-fusion-span-paid-validation-comparison/v3"
T5_FUSION_UPSTREAM_COST_SCHEMA = "reviewed-t5-fusion-upstream-costs/v1"
T5_FUSION_CREDIT_PROFILE_SELECTION_SCHEMA = "reviewed-t5-fusion-estimator-profile-selection/v1"
T5_FUSION_CREDIT_PROFILE_COMPARISON_SCHEMA = "reviewed-t5-fusion-estimator-profile-paid-validation/v1"
_T5_FUSION_UPSTREAM_KINDS = {
    "training_teacher_preparation": "teacher_production",
    "behavior_rollout": "behavior_rollout",
    "development_teacher_preparation": "teacher_production",
}
_T5_POLICY_RUNTIME = "builtin-t5-gpt2-float32/v1"
_T5_FUSION_POLICY_RUNTIME = "builtin-t5-gpt2-float32-teacher-fused/v1"
_T5_FUSION_DEVELOPMENT_BINDING = "reviewed-t5-fusion-development-inference-binding/v1"
_T5_FUSION_DEVELOPMENT_BINDING_FIELDS = {
    "schema", "training_batch_sha256", "development_batch_sha256", "configuration_sha256",
    "model_checkpoint_sha256", "projection_sha256s", "fusion_rule", "mode", "row_ids",
    "development_population_sha256", "matched_inputs_sha256", "rows",
    "candidate_manifest_sha256", "trial_terminal_close_sha256", "policy_candidate_sha256",
}
T5_FUSION_FINAL_ASSESSMENT_SCHEMA = "reviewed-decoder-t5-fusion-span-policy-final-assessment/v1"
T5_FUSION_FINAL_SCORING_SCHEMA = "reviewed-decoder-t5-fusion-span-policy-final-scoring/v1"
T5_FUSION_FINAL_OBSERVATION_SCHEMA = "reviewed-decoder-t5-fusion-span-policy-final-observation/v1"
_T5_FUSION_FINAL_BINDING = "reviewed-t5-fusion-final-inference-binding/v1"
_T5_FUSION_FINAL_BINDING_FIELDS = (_T5_FUSION_DEVELOPMENT_BINDING_FIELDS
    - {"development_batch_sha256", "development_population_sha256"}) | {
        "final_batch_sha256", "final_population_sha256", "frozen_roster_sha256", "dependency_group_sha256"}
_T5_SCOPED_FORWARD_PROFILE = "authenticated-scoped-t5-candidate-forwards/v1"
QWEN = "qwen2-digest-omitted-source-only/v1"
T5 = "t5-full-target-source-only/v1"
FULL_CODEC = "complete-reviewed-norm-json/v2"
INPUT_ROLES = {"binding", "rows", "split_manifest", "exposure_records", "source_contexts",
               "expected_source_contexts_sha256", "expected_admission_inputs_sha256",
               "max_source_tokens", "max_output_tokens", "generation_policy", "compiler_commit", "encoder", "configuration"}
LOAD_ASSETS = ("recipe_artifact", "model_config_artifact", "tokenizer_artifact", "license_artifact")


@dataclass(frozen=True)
class Assessment:
    study_sha256: str
    arm: str
    seed: int
    attempt_sha256: str
    look: str
    candidate_sha256: str
    trial_terminal_close_sha256: str
    panel_sha256: str
    evaluation_policy_sha256: str
    retention_reference_sha256: str
    expected_inputs_sha256: str
    expected_assets_sha256: str
    route: str
    admission_version: str


@dataclass(frozen=True)
class PolicyAssessment(Assessment):
    policy_attempt_sha256: str


@dataclass(frozen=True)
class DecisionSpanValidationAssessment(PolicyAssessment):
    development_split_sha256: str
    dependency_group_sha256: str
    optimizer_step_grid_sha256: str
    optimizer_steps: int


@dataclass(frozen=True)
class GuidedSpanValidationAssessment(DecisionSpanValidationAssessment):
    """One closed guided or control candidate on one selected DEVELOPMENT component."""


@dataclass(frozen=True)
class T5FusionSpanValidationAssessment(DecisionSpanValidationAssessment):
    t5_fusion_assessment_binding_sha256: str
    matched_teacher_inputs_sha256: str


@dataclass(frozen=True)
class T5FusionSpanFinalAssessment(PolicyAssessment):
    dependency_group_sha256: str
    optimizer_steps: int
    t5_fusion_assessment_binding_sha256: str
    matched_teacher_inputs_sha256: str


@dataclass(frozen=True)
class DevelopmentAssessment(Assessment):
    development_split_sha256: str
    armed_attempt_sha256: str
    dependency_group_sha256: str


@dataclass(frozen=True)
class ScheduledDevelopmentAssessment(DevelopmentAssessment):
    optimizer_step_grid_sha256: str
    optimizer_steps: int


@dataclass(frozen=True)
class ScheduledCheckpointIdentity:
    schedule_sha256: str
    checkpoint_close_sha256: str
    owner_stage_record_sha256: str


@dataclass(frozen=True)
class RetrospectiveDevelopmentAssessment(ScheduledDevelopmentAssessment):
    scheduled_checkpoint: ScheduledCheckpointIdentity


@dataclass(frozen=True)
class ScheduledCheckpointEvidence:
    development: "DevelopmentCheckpointSelection | None"
    terminal_candidate_manifest: bytes
    scheduled_close: "ScheduledCheckpointClose"
    verify_scheduled_close: Callable[["ScheduledCheckpointClose"], bool]


DEVELOPMENT_SCORING_SCHEMA = "reviewed-decoder-development-scoring-selection/v1"
SCHEDULED_DEVELOPMENT_SCORING_SCHEMA = "reviewed-decoder-step-bound-development-scoring-selection/v1"
RETROSPECTIVE_DEVELOPMENT_SCORING_SCHEMA = "reviewed-decoder-retrospective-development-scoring-selection/v1"
VALIDATION_OPERATION = "hparam_selection"
VALIDATION_PROFILE = "reviewed-source-span-producer-validation/v1"
DEVELOPMENT_OBSERVATION_SCHEMA = "reviewed-relational-development-source-observation/v1"


def _development_plan(plan):
    return type(plan) is DevelopmentAssessment or _scheduled_development_plan(plan)


def _scheduled_development_plan(plan):
    return type(plan) in (ScheduledDevelopmentAssessment, RetrospectiveDevelopmentAssessment)


def _span_validation_assessment(plan):
    return type(plan) in (DecisionSpanValidationAssessment, GuidedSpanValidationAssessment,
                          T5FusionSpanValidationAssessment)


def _policy_assessment(plan):
    return type(plan) in (PolicyAssessment, T5FusionSpanFinalAssessment) or _span_validation_assessment(plan)


def _validation_assessment(plan):
    return _development_plan(plan) or _span_validation_assessment(plan)


def _span_binding(link, guided):
    return link["guided_decision_span_binding" if guided else "decision_span_binding"]


def _span_cohort(attempt, guided):
    return (guided_policy_cohort_commitment(attempt) if guided
            else decision_span_policy_cohort_commitment(attempt))


def _span_attempt_type(plan):
    if type(plan) is GuidedSpanValidationAssessment:
        return GuidedDecisionSpanPolicyAttempt
    if type(plan) in (T5FusionSpanValidationAssessment, T5FusionSpanFinalAssessment):
        return T5FusionDecisionSpanPolicyAttempt
    return DecisionSpanPolicyAttempt


def _scheduled_checkpoint_pins(identity):
    _need(type(identity) is ScheduledCheckpointIdentity and all(_pin(value) for value in (
        identity.schedule_sha256, identity.checkpoint_close_sha256, identity.owner_stage_record_sha256)),
        "typed scheduled checkpoint identity requires all three exact commitments")
    return asdict(identity)


def _archived_capture_metadata(document):
    """Read optional archived capture provenance from a closed evidence document."""
    if "archived_capture" not in document:
        return None
    capture = document["archived_capture"]
    _need(type(capture) is dict
          and set(capture) == {"archived_arm_sha256", "capture_plan_sha256", "resource_plan_sha256"}
          and all(_pin(value) for value in capture.values()),
          "exact archived arm, capture plan and resource plan pins required")
    return capture.copy()


def _scheduled_optimizer_step(plan, step_grid, study_owner):
    if _span_validation_assessment(plan):
        bind_grid = getattr(study_owner, "development_step_grid_commitment", None)
        _need(step_grid is not None and callable(bind_grid)
              and bind_grid(step_grid) == plan.optimizer_step_grid_sha256
              and step_grid.study_sha256 == plan.study_sha256
              and step_grid.development_design_sha256 == plan.development_split_sha256
              and step_grid.steps == ((plan.look, plan.optimizer_steps),),
              "decision span validation requires its exact one-step study grid")
        return
    if not _scheduled_development_plan(plan):
        _need(step_grid is None, "optimizer-step grid is only used with a scheduled development assessment")
        return
    bind_grid = getattr(study_owner, "development_step_grid_commitment", None)
    _need(step_grid is not None and callable(bind_grid)
          and bind_grid(step_grid) == plan.optimizer_step_grid_sha256
          and step_grid.study_sha256 == plan.study_sha256
          and dict(step_grid.steps).get(plan.look) == plan.optimizer_steps,
          "assessment must bind this look to its exact optimizer step in the selected grid")


def commitment(plan):
    policy = _policy_assessment(plan)
    policy_t5 = policy and plan.route == T5
    arms = T5_POLICY_ARMS if policy_t5 else POLICY_ARMS if policy else ("supervised", "tap_only", "relational")
    guided = type(plan) is GuidedSpanValidationAssessment
    span_arms = GUIDED_DECISION_SPAN_POLICY_ARMS if guided else DECISION_SPAN_POLICY_ARMS
    if guided:
        arms = span_arms
    elif policy:
        arms += span_arms
    _need((type(plan) is Assessment or policy or _development_plan(plan)) and plan.route in (QWEN, T5)
          and (not policy or plan.admission_version == "v3" and _pin(plan.policy_attempt_sha256))
          and plan.admission_version in ("v2", "v3") and (plan.route != QWEN or plan.admission_version == "v3")
          and type(plan.arm) is str and plan.arm in arms
          and type(plan.seed) is int and type(plan.look) is str and 0 < len(plan.look) <= 128
          and all(_pin(value) for value in (plan.study_sha256, plan.attempt_sha256, plan.candidate_sha256,
              plan.trial_terminal_close_sha256, plan.panel_sha256, plan.evaluation_policy_sha256,
              plan.retention_reference_sha256, plan.expected_inputs_sha256, plan.expected_assets_sha256)),
          "explicit closed source-only assessment selection required")
    if _development_plan(plan):
        _need(plan.admission_version == "v3" and all(_pin(value) for value in (
            plan.development_split_sha256, plan.armed_attempt_sha256, plan.dependency_group_sha256)),
            "native development scoring requires the exact V3 split and component selection")
        if _scheduled_development_plan(plan):
            _need(_pin(plan.optimizer_step_grid_sha256) and type(plan.optimizer_steps) is int and plan.optimizer_steps > 0,
                  "exact preregistered optimizer-step grid and scheduled step required")
            if type(plan) is RetrospectiveDevelopmentAssessment:
                _scheduled_checkpoint_pins(plan.scheduled_checkpoint)
                return _commit((RETROSPECTIVE_DEVELOPMENT_SCORING_SCHEMA, asdict(plan)))
            return _commit((SCHEDULED_DEVELOPMENT_SCORING_SCHEMA, asdict(plan)))
        return _commit((DEVELOPMENT_SCORING_SCHEMA, asdict(plan)))
    if _span_validation_assessment(plan):
        _need(plan.arm in span_arms and all(_pin(pin) for pin in (
            plan.development_split_sha256, plan.dependency_group_sha256, plan.optimizer_step_grid_sha256))
            and type(plan.optimizer_steps) is int and plan.optimizer_steps > 0,
            "explicit decision span validation split, component and reached step required")
        if type(plan) is T5FusionSpanValidationAssessment:
            _need(plan.route == T5 and _pin(plan.t5_fusion_assessment_binding_sha256)
                  and _pin(plan.matched_teacher_inputs_sha256),
                  "fused T5 DEVELOPMENT requires exact candidate and matched teacher inference commitments")
            return _commit((T5_FUSION_VALIDATION_ASSESSMENT_SCHEMA, asdict(plan)))
        schema = GUIDED_VALIDATION_ASSESSMENT_SCHEMA if guided else DECISION_SPAN_VALIDATION_ASSESSMENT_SCHEMA
        return _commit((schema, asdict(plan)))
    if type(plan) is T5FusionSpanFinalAssessment:
        _need(plan.route == T5 and plan.look == "final" and plan.arm in DECISION_SPAN_POLICY_ARMS
              and all(_pin(value) for value in (plan.dependency_group_sha256, plan.t5_fusion_assessment_binding_sha256,
                  plan.matched_teacher_inputs_sha256)) and type(plan.optimizer_steps) is int and plan.optimizer_steps > 0,
              "exact fused T5 FINAL component, reached step and conditioning required")
        return _commit((T5_FUSION_FINAL_ASSESSMENT_SCHEMA, asdict(plan)))
    if policy and plan.arm in DECISION_SPAN_POLICY_ARMS:
        return _commit((DECISION_SPAN_POLICY_ASSESSMENT_SCHEMA, asdict(plan)))
    if policy_t5:
        return _commit((T5_POLICY_ASSESSMENT_SCHEMA, asdict(plan)))
    return _commit((POLICY_ASSESSMENT_SCHEMA if policy else SCHEMA, asdict(plan)))


def _t5_policy_link(link):
    arm = link.get("arm")
    binding = link.get("t5_completion_binding")
    if not (arm in T5_POLICY_ARMS and link.get("policy_runtime_profile") == _T5_POLICY_RUNTIME
            and not {"cached_completion_binding", "t5_fusion_binding", "t5_fusion_completion_binding"}.intersection(link)
            and type(binding) is dict and set(binding) == {"profile", "close_bodies_sha256"}
            and binding["profile"] == "reviewed-t5-rollout-completion-binding/v1"
            and _pin(binding["close_bodies_sha256"])):
        return False
    if arm == T5_POLICY_ARM:
        return "t5_allocation_binding" not in link and "t5_scoped_forward_binding" not in link
    pruned = arm not in T5_MATCHED_POLICY_ARMS
    if pruned:
        from .relational_trial import T5_SCOPED_PRUNED_POLICY_ARM

        if arm != T5_SCOPED_PRUNED_POLICY_ARM:
            return False
    elif "t5_scoped_forward_binding" in link:
        return False
    allocation = link.get("t5_allocation_binding")
    hashes = {"cohort_sha256", "credit_localization_pair_sha256", "plan_sha256", "replay_sha256"}
    if not (type(allocation) is dict
            and set(allocation) == hashes | {"ordered_sample_sha256s", "credited_sample_sha256s"}
            and all(_pin(allocation[key]) for key in hashes)):
        return False
    common, credited = (allocation[key] for key in ("ordered_sample_sha256s", "credited_sample_sha256s"))
    if not all(type(items) is list and items and all(_pin(sample) for sample in items)
               and len(set(items)) == len(items) for items in (common, credited)):
        return False
    chosen = set(credited)
    if [sample for sample in common if sample in chosen] != credited:
        return False
    if not pruned:
        return arm != T5_MATCHED_POLICY_ARMS[0] or common == credited
    forward = link.get("t5_scoped_forward_binding")
    attempt = link.get("attempt_sha256")
    return (len(credited) < len(common) and _pin(attempt)
            and type(forward) is dict
            and set(forward) == {"profile", "selection_sha256", "common_sample_sha256s", "skipped_candidate_forwards"}
            and forward["profile"] == _T5_SCOPED_FORWARD_PROFILE
            and forward["selection_sha256"] == _commit((_T5_SCOPED_FORWARD_PROFILE,
                allocation["credit_localization_pair_sha256"], allocation["plan_sha256"], attempt))
            and type(forward["common_sample_sha256s"]) is list
            and forward["common_sample_sha256s"] == common
            and type(forward["skipped_candidate_forwards"]) is list
            and forward["skipped_candidate_forwards"] == [sample for sample in common if sample not in chosen])


def _decision_span_policy_link(link, *, guided=False, fused=False):
    """Check the public link shape emitted by the existing terminal binder."""
    if type(link) is not dict or (guided and fused):
        return False
    tagged = "t5_fusion_binding" in link or "t5_fusion_completion_binding" in link
    if tagged != fused:
        return False
    arms = GUIDED_DECISION_SPAN_POLICY_ARMS if guided else DECISION_SPAN_POLICY_ARMS
    binding_key = "guided_decision_span_binding" if guided else "decision_span_binding"
    arm, binding = link.get("arm"), link.get(binding_key)
    hashes = {"cohort_sha256", "tokenizer_sha256", "sampler_module_sha256", "grouped_module_sha256",
              "starting_pair_sha256", "decision_span_comparison_sha256", "plan_sha256", "replay_sha256"}
    if not (arm in arms and type(binding) is dict
            and set(binding) == hashes | {"architecture", "reduction_profile", "common_sample_sha256s",
                                          "scored_sample_sha256s", "contributing_trajectories"}
            and all(_pin(binding[key]) for key in hashes)
            and binding["reduction_profile"] == _DECISION_SPAN_REDUCTIONS[1 if guided else arms.index(arm)]
            and binding["architecture"] in ("encoder_decoder", "causal_lm")
            and "t5_allocation_binding" not in link and "t5_scoped_forward_binding" not in link
            and link.get("qualified") is False and link.get("whole_arm_cost_required") is True):
        return False
    common, scored = (binding[key] for key in ("common_sample_sha256s", "scored_sample_sha256s"))
    if not all(type(rows) is list and rows and all(_pin(pin) for pin in rows)
               and len(set(rows)) == len(rows) for rows in (common, scored)):
        return False
    credited = set(scored)
    if not ([sample for sample in common if sample in credited] == scored
            and (guided or arm != arms[0] or common == scored)
            and type(binding["contributing_trajectories"]) is int
            and 0 < binding["contributing_trajectories"] <= len(scored)):
        return False
    if guided:
        scope_binding = link.get("guided_scope_binding")
        if not ("decision_span_binding" not in link and len(scored) < len(common) <= 2048
                and type(scope_binding) is dict and set(scope_binding) == {
                    "schema", "arm", "cohort_sha256", "opening_sha256", "native_scope_selection_sha256",
                    "common_reward_receipt_sha256", "decision_span_comparison_sha256", "plan_sha256"}
                and scope_binding["schema"] == "reviewed-decoder-guided-span-policy-scope/v1"
                and scope_binding["arm"] == arm
                and all(scope_binding[key] == binding[key] for key in (
                    "cohort_sha256", "decision_span_comparison_sha256", "plan_sha256"))
                and all(_pin(scope_binding[key]) for key in (
                    "opening_sha256", "native_scope_selection_sha256", "common_reward_receipt_sha256"))
                and _pin(link.get("owner_execution_record_sha256"))):
            return False
    elif "guided_decision_span_binding" in link or "guided_scope_binding" in link:
        return False
    t5 = binding["architecture"] == "encoder_decoder"
    if fused:
        selection, completion = link.get("t5_fusion_binding"), link.get("t5_fusion_completion_binding")
        fusion_pins = {"candidate_policy_sha256", "candidate_batch_sha256", "candidate_source_binding_sha256",
                       "fusion_condition_sha256", "fusion_slot_sha256", "fusion_replay_geometry_sha256",
                       "teacher_prefix_module_sha256"}
        return (t5 and link.get("policy_runtime_profile") == _T5_FUSION_POLICY_RUNTIME
                and _pin(link.get("owner_execution_record_sha256"))
                and not {"t5_completion_binding", "cached_completion_binding"}.intersection(link)
                and type(selection) is dict and set(selection) == fusion_pins | {"fusion_slot_width"}
                and all(_pin(selection[key]) for key in fusion_pins)
                and type(selection["fusion_slot_width"]) is int and 1 <= selection["fusion_slot_width"] <= 65536
                and type(completion) is dict and set(completion) == {"profile", "rollouts_sha256", "rows"}
                and completion["profile"] == "reviewed-t5-fusion-completion-binding/v1"
                and _pin(completion["rollouts_sha256"]) and type(completion["rows"]) is list
                and bool(completion["rows"]))
    key = "t5_completion_binding" if t5 else "cached_completion_binding"
    other = "cached_completion_binding" if t5 else "t5_completion_binding"
    completion = link.get(key)
    return (other not in link and type(completion) is dict
            and set(completion) == {"profile", "close_bodies_sha256"}
            and completion["profile"] == ("reviewed-t5-rollout-completion-binding/v1" if t5
                                          else "reviewed-cached-rollout-completion-binding/v1")
            and _pin(completion["close_bodies_sha256"])
            and (link.get("policy_runtime_profile") == _T5_POLICY_RUNTIME if t5
                 else "policy_runtime_profile" not in link))


def _guided_link_matches_attempt(link, attempt):
    completion_key = "t5_completion_binding" if attempt.architecture == "encoder_decoder" else "cached_completion_binding"
    return (link["guided_scope_binding"] == guided_policy_scope_binding(attempt)
            and link.get("arm_recipe_sha256") == attempt.arm_recipe_sha256
            and _commit(link[completion_key]) == attempt.completion_binding_sha256)


def _require_fused_link_attempt(link, attempt):
    _need(type(attempt) is T5FusionDecisionSpanPolicyAttempt
          and _decision_span_policy_link(link, fused=True)
          and link["t5_fusion_binding"] == _t5_fusion_policy_selection_fields(attempt)
          and link.get("arm_recipe_sha256") == attempt.arm_recipe_sha256,
          "fused validation requires its independently selected exact teacher and candidate role")
    _require_t5_fusion_completion_binding(attempt, link["t5_fusion_completion_binding"])


def _bind_decision_span_assessment_arm(plan, link, plan_pin, link_pin, attempt, dispatch, *, guided=False):
    fused = type(plan) is T5FusionSpanValidationAssessment
    _need(_pin(plan_pin) and commitment(plan) == plan_pin and _pin(link_pin)
          and _decision_span_policy_link(link, guided=guided, fused=fused) and _commit(link) == link_pin
          and _artifact(link.get("candidate"))
          and (link.get("study_sha256"), link.get("arm"), link.get("seed"), link.get("attempt_sha256"),
               link["candidate"]["sha256"], link.get("terminal_close_sha256"), link.get("policy_attempt_sha256")) ==
              (plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256, plan.candidate_sha256,
               plan.trial_terminal_close_sha256, plan.policy_attempt_sha256)
          and _span_binding(link, guided)["architecture"] ==
              ("encoder_decoder" if plan.route == T5 else "causal_lm")
          and policy_attempt_commitment(attempt) == plan.policy_attempt_sha256
          and (attempt.study_sha256, attempt.arm, attempt.seed, attempt.attempt_sha256) ==
              (plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256)
          and _span_binding(link, guided)["cohort_sha256"] == _span_cohort(attempt, guided)
          and dispatch.commitment() == attempt.owner_request_sha256 and dispatch.attempt_sha256 == plan.attempt_sha256
          and (dispatch.parent_manifest.sha256, dispatch.base_model_checkpoint.sha256,
               dispatch.base_optimizer_checkpoint.sha256) == (attempt.parent_manifest_sha256,
               attempt.base_model_sha256, attempt.base_optimizer_sha256),
          "exact decision span assessment requires its owner-closed candidate and architecture")
    _require_selected_span_link(link, attempt, guided=guided, fused=fused)


def _require_selected_span_link(link, attempt, *, guided, fused):
    binding = _span_binding(link, guided)
    shared_fields = ("architecture", "tokenizer_sha256", "sampler_module_sha256", "grouped_module_sha256",
                     "starting_pair_sha256", "plan_sha256", "replay_sha256", "contributing_trajectories")
    _need(all(binding[name] == getattr(attempt, name) for name in shared_fields)
          and binding["decision_span_comparison_sha256"] == attempt.allocation_pair_sha256
          and tuple(binding["common_sample_sha256s"]) == attempt.ordered_sample_sha256s
          and tuple(binding["scored_sample_sha256s"]) == attempt.scored_sample_sha256s
          and link.get("configuration_sha256") == attempt.configuration_sha256
          and link.get("selected_proof_evidence_sha256") == attempt.selected_proof_evidence_sha256
          and (not guided or _guided_link_matches_attempt(link, attempt)),
          "decision span assessment link differs from its typed receipt selection")
    if fused:
        _require_fused_link_attempt(link, attempt)
    elif not guided:
        completion = ("t5_completion_binding" if attempt.architecture == "encoder_decoder"
                      else "cached_completion_binding")
        _need(_commit(link[completion]) == attempt.completion_binding_sha256,
              "decision span assessment completion differs from its typed receipt selection")


def _require_t5_fusion_assessment_role(plan, link, binding):
    _need(type(plan) is T5FusionSpanValidationAssessment and _decision_span_policy_link(link, fused=True)
          and type(binding) is dict and set(binding) == _T5_FUSION_DEVELOPMENT_BINDING_FIELDS
          and binding["schema"] == _T5_FUSION_DEVELOPMENT_BINDING
          and all(_artifact(link.get(key)) for key in ("candidate", "model_checkpoint", "optimizer_checkpoint"))
          and _pin(binding["development_batch_sha256"])
          and binding["candidate_manifest_sha256"] == link["candidate"]["sha256"] == plan.candidate_sha256
          and binding["trial_terminal_close_sha256"] == link["terminal_close_sha256"] == plan.trial_terminal_close_sha256
          and binding["policy_candidate_sha256"] == _commit(link)
          and binding["training_batch_sha256"] == link["t5_fusion_binding"]["candidate_batch_sha256"]
          and binding["configuration_sha256"] == link["configuration_sha256"]
          and binding["model_checkpoint_sha256"] == link["model_checkpoint"]["sha256"]
          and binding["matched_inputs_sha256"] == plan.matched_teacher_inputs_sha256
          and _commit(binding) == plan.t5_fusion_assessment_binding_sha256,
          "fused T5 DEVELOPMENT teacher inputs differ from their independently selected candidate and terminal roles")


def bind_decision_span_assessment_pair(plans, policy_candidates, *, expected_assessment_sha256s,
                                       expected_policy_candidate_sha256s, policy_attempts, dispatches,
                                       t5_fusion_assessment_bindings=None):
    """Bind independently selected per-arm assessments to one matching held-out component."""
    from . import autoencoder_training_worker as worker

    guided = type(plans) is tuple and bool(plans) and type(plans[0]) is GuidedSpanValidationAssessment
    fused = type(plans) is tuple and bool(plans) and type(plans[0]) is T5FusionSpanValidationAssessment
    plan_types = ((GuidedSpanValidationAssessment,) if guided else (T5FusionSpanValidationAssessment,) if fused
                  else (PolicyAssessment, DecisionSpanValidationAssessment))
    attempt_type = _span_attempt_type(plans[0]) if type(plans) is tuple and bool(plans) else DecisionSpanPolicyAttempt
    arms = GUIDED_DECISION_SPAN_POLICY_ARMS if guided else DECISION_SPAN_POLICY_ARMS

    _need(all(type(items) is tuple and len(items) == 2 for items in (
              plans, policy_candidates, expected_assessment_sha256s, expected_policy_candidate_sha256s,
              policy_attempts, dispatches))
          and type(plans[0]) in plan_types
          and type(plans[1]) is type(plans[0])
          and all(type(attempt) is attempt_type for attempt in policy_attempts)
          and all(type(dispatch) is worker.ReviewedPolicyDispatch for dispatch in dispatches)
          and tuple(plan.arm for plan in plans) == arms,
          "ordered guided and control validation assessments required" if guided else
          "ordered broadcast and scoped decision span assessments required")
    for plan, link, plan_pin, link_pin, attempt, dispatch in zip(plans, policy_candidates,
            expected_assessment_sha256s, expected_policy_candidate_sha256s, policy_attempts, dispatches, strict=True):
        _bind_decision_span_assessment_arm(plan, link, plan_pin, link_pin, attempt, dispatch, guided=guided)
    left, right = plans
    common_plan = ("study_sha256", "seed", "look", "panel_sha256", "evaluation_policy_sha256",
                   "retention_reference_sha256", "expected_inputs_sha256", "expected_assets_sha256",
                   "route", "admission_version")
    a, b = policy_candidates
    first, second = dispatches
    bounds = ("maximum_forward_tokens", "maximum_head_elements", "maximum_checkpoint_bytes")
    arm_only = {"plan_sha256", "reduction_profile", "scored_sample_sha256s"}
    if guided or fused:
        from pathlib import Path

        refs = ("parent_manifest", "base_model_checkpoint", "base_optimizer_checkpoint")
        outputs = tuple(Path(item.output_directory) for item in dispatches)
        _need(all(getattr(first, name) == getattr(second, name) for name in refs)
              and outputs[0] != outputs[1] and not any(path.is_relative_to(other) for path, other in (outputs, outputs[::-1]))
              and all(".." not in path.parts for path in outputs)
              and all(_artifact(link.get(role)) and Path(link[role]["path"]) == path / filename
                      for link, path in zip((a,b), outputs, strict=True)
                      for role, filename in (("candidate", "policy-checkpoint.json"),
                          ("model_checkpoint", "model.checkpoint"), ("optimizer_checkpoint", "optimizer.checkpoint")))
              and a["owner_execution_record_sha256"] != b["owner_execution_record_sha256"],
              "policy assessments require independent output artifacts from one exact starting pair")
    if guided:
        arm_only.add("decision_span_comparison_sha256")
        left_scored = _span_binding(a, True)["scored_sample_sha256s"]
        right_scored = _span_binding(b, True)["scored_sample_sha256s"]
        _need(_span_binding(a, True)["decision_span_comparison_sha256"] != _span_binding(b, True)["decision_span_comparison_sha256"]
              and len(left_scored) == len(right_scored) and left_scored != right_scored,
              "guided assessments require distinct scoped comparisons and independent outputs from one start")
    if fused:
        _need(type(t5_fusion_assessment_bindings) is tuple and len(t5_fusion_assessment_bindings) == 2
              and left.matched_teacher_inputs_sha256 == right.matched_teacher_inputs_sha256
              and left.t5_fusion_assessment_binding_sha256 != right.t5_fusion_assessment_binding_sha256
              and a["t5_fusion_binding"] == b["t5_fusion_binding"]
              and a["t5_fusion_completion_binding"] == b["t5_fusion_completion_binding"],
              "paired fused T5 assessments require identical DEVELOPMENT teacher inputs and arm-specific checkpoint bindings")
        for plan, link, binding in zip(plans, policy_candidates, t5_fusion_assessment_bindings, strict=True):
            _require_t5_fusion_assessment_role(plan, link, binding)
        role_fields = {"development_batch_sha256", "model_checkpoint_sha256", "candidate_manifest_sha256",
                       "trial_terminal_close_sha256", "policy_candidate_sha256"}
        matched_bodies = tuple(_commit({key: value for key, value in binding.items() if key not in role_fields})
                               for binding in t5_fusion_assessment_bindings)
        _need(matched_bodies[0] == matched_bodies[1],
              "paired fused T5 assessments disagree on the shared DEVELOPMENT conditioning body")
    else:
        _need(t5_fusion_assessment_bindings is None, "legacy assessments cannot accept fused T5 conditioning")
    cohort = {name: value for name, value in _span_binding(a, guided).items() if name not in arm_only}
    _need(all(getattr(left, name) == getattr(right, name) for name in common_plan)
          and all(getattr(left, name) != getattr(right, name) for name in (
              "attempt_sha256", "candidate_sha256", "trial_terminal_close_sha256", "policy_attempt_sha256"))
          and cohort == {name: value for name, value in _span_binding(b, guided).items() if name not in arm_only}
          and all(getattr(first, name) == getattr(second, name) for name in bounds)
          and first.assets == second.assets
          and _pin(a.get("configuration_sha256")) and a["configuration_sha256"] == b.get("configuration_sha256")
          and _pin(a.get("selected_proof_evidence_sha256"))
          and a["selected_proof_evidence_sha256"] == b.get("selected_proof_evidence_sha256"),
          "decision span assessments require the same cohort, held-out inputs and budgets and distinct attempts")
    if _span_validation_assessment(left):
        validation_fields = ("development_split_sha256", "dependency_group_sha256",
                             "optimizer_step_grid_sha256", "optimizer_steps")
        _need(all(getattr(left, name) == getattr(right, name) for name in validation_fields)
              and all(plan.optimizer_steps == attempt.initial_optimizer_steps + 1
                      for plan, attempt in zip(plans, policy_attempts, strict=True)),
              "decision span assessments require the same VALIDATION split, component and reached optimizer step")
        domain = ("reviewed-decoder-t5-fusion-span-matched-validation-component/v1" if fused
                  else "reviewed-decoder-guided-span-matched-validation-component/v1" if guided
                  else "reviewed-decoder-decision-span-matched-validation-component/v1")
    else:
        domain = "reviewed-decoder-decision-span-matched-heldout-component/v1"
    return _commit((domain, expected_assessment_sha256s, expected_policy_candidate_sha256s))


def _inputs_commit(inputs, consumer, plan):
    operation = VALIDATION_OPERATION if _validation_assessment(plan) else "heldout_evaluation"
    _need(type(inputs) is dict and set(inputs) == INPUT_ROLES
          and consumer._reviewed_binding_version(inputs["binding"]) == plan.admission_version,
          "exact selected source-only assessment inputs and prepared admission domain required")
    rows = inputs["rows"]
    _need(type(rows) is list and 1 <= len(rows) <= 32 and
          all(type(row) is dict and type(row.get("id")) is str and type(row.get("unit_id")) is str
              and type(row.get("source_text")) is str for row in rows) and len({row["id"] for row in rows}) == len(rows),
          "ordered complete held-out roster required")
    encoder = inputs["encoder"]
    _need(type(encoder) is dict and set(encoder) == {"id", "sha256"} and type(encoder["id"]) is str
          and _pin(encoder["sha256"]) and type(inputs["compiler_commit"]) is str
          and 0 < len(inputs["compiler_commit"]) <= 128
          and _pin(inputs["expected_admission_inputs_sha256"])
          and _sha(consumer._preflight(inputs["source_contexts"])) == inputs["expected_source_contexts_sha256"]
          and type(inputs["max_source_tokens"]) is int and 3 <= inputs["max_source_tokens"] <= 65536
          and type(inputs["max_output_tokens"]) is int and 2 <= inputs["max_output_tokens"] <= 65536,
          "selected evaluator declarations, source context or budget differ")
    receipt = inputs["binding"].receipt()
    _need(type(receipt) is dict and receipt.get("status") == "ready"
          and receipt.get("operation") == operation,
          "ready explicit assessment binding for the selected operation required before load")
    if operation == VALIDATION_OPERATION:
        _need(receipt.get("input_sha256s", {}).get("split_manifest") == _commit(inputs["split_manifest"]),
              "validation binding does not commit the exact selected manifest")
    declaration = {**inputs, "binding": receipt}
    if _policy_assessment(plan) and (plan.route == T5 or plan.arm in DECISION_SPAN_POLICY_ARMS or type(plan) is GuidedSpanValidationAssessment):
        # HF configurations can contain integer label keys and optimizer tuples.
        # Commit the native configuration through its existing canonical digest;
        # the loader still checks the exact native object against the selection.
        native_configuration = inputs["configuration"]
        _need(type(native_configuration) is dict, "exact native policy configuration required")
        declaration["configuration"] = {"native_configuration_sha256": _commit(native_configuration)}
    return _sha(consumer._preflight(declaration))


def _assets_commit(worker, assets, max_model_bytes):
    _need(type(assets) is dict and set(assets) == set(LOAD_ASSETS)
          and all(type(item) is worker.CheckpointArtifact and _artifact(asdict(item)) for item in assets.values())
          and len({item.path for item in assets.values()}) == len(LOAD_ASSETS)
          and type(max_model_bytes) is int and 0 < max_model_bytes <= 2 * 1024**3,
          "exact bounded existing local loader assets required")
    return _commit((max_model_bytes, {name:asdict(item) for name,item in assets.items()}))


def _native_validation_receipts(payload, split_sha256):
    config = payload["configuration"]
    before = payload.get("admission_before")
    after = payload.get("admission_after")
    _need(type(before) is dict and before == after and before.get("status") == "ready"
          and before.get("operation") == VALIDATION_OPERATION
          and before.get("input_sha256s", {}).get("split_manifest") == split_sha256
          and config.get("input_sha256s") == before["input_sha256s"]
          and config.get("admission_before_sha256") == config.get("admission_after_sha256") == _commit(before)
          and config.get("heldout_evaluation") is None and payload.get("heldout_evaluation") is None,
          "native validation artifact altered the selected split or operation")


def _fused_statutory_source_admissions(components):
    """Identify statutory provenance only after the saved components have been authenticated."""
    for _, saved in components:
        payload = saved["compiler_artifact"]["reviewed_source_span_producer_evaluation"]
        original = payload["admission_before"]
        if original.get("provenance_kind") != "statutory" or original.get("fictional_fixture_allowed") is not False:
            return False
    return bool(components)


def _closed_observation(saved, *, inputs, checkpoint, model, optimizer, expected_identity, source_pins,
                        operation="heldout_evaluation"):
    profile = VALIDATION_PROFILE if operation == VALIDATION_OPERATION else "reviewed-source-span-producer-heldout/v1"
    _need(type(saved) is dict and type(saved.get("metadata")) is dict
          and type(saved.get("compiler_artifact")) is dict, "existing reviewed evaluation artifact required")
    meta = saved["metadata"]
    observed = meta.get("source_generation_observation")
    _need(type(observed) is dict and type(observed.get("calls")) is int and observed["calls"] == 1,
          "fresh evaluation must contain one actual producer call")
    run = observed.get("last_call")
    _need(type(run) is dict and all(run.get(key) is True for key in ("completed", "entry_pair_match", "exit_pair_match"))
          and run.get("exception_type") is None and run.get("closeout_exception_type") is None,
          "source-only producer call or checkpoint custody did not close")
    declaration = observed.get("input_commitment")
    digest = observed.get("input_commitment_sha256")
    _need(type(declaration) is dict and _pin(digest) and _commit(declaration) == digest
          and meta.get("source_generation_input_commitment_sha256") == digest
          and declaration.get("model_checkpoint") == model and declaration.get("optimizer_checkpoint") == optimizer
          and declaration.get("backend_identity") == expected_identity and declaration.get("source_sha256") == source_pins
          and declaration.get("operation") == operation and declaration.get("training_requested") is False
          and declaration.get("supplied_context_supported") == "empty_permitted_and_retrieved_only"
          and declaration.get("source_contexts_sha256") == inputs["expected_source_contexts_sha256"]
          and declaration.get("admission_inputs_sha256") == inputs["expected_admission_inputs_sha256"]
          and declaration.get("generation_policy") == inputs["generation_policy"]
          and declaration.get("max_source_tokens") == inputs["max_source_tokens"]
          and declaration.get("max_output_tokens") == inputs["max_output_tokens"],
          "existing producer commitment differs from selected exact pair, source-only policy or budget")
    payload = saved["compiler_artifact"].get("reviewed_source_span_producer_evaluation")
    _need(type(payload) is dict and type(payload.get("producer_callback_count")) is int
          and payload["producer_callback_count"] == 1 and payload.get("producer_exception_type") is None
          and all(payload.get(key) is False for key in ("source_fidelity_proved", "semantic_equivalence_proved",
                                                       "native_proof_verified")),
          "closed structural evaluation with explicit authority boundaries required")
    _need(payload.get("reference_population") == inputs["rows"],
          "persisted independent reference population differs from selected panel inputs")
    args, outputs = payload.get("producer_arguments"), payload.get("producer_outputs")
    source_input = run.get("input_receipt")
    config = payload.get("configuration")
    expected_ids = [row["id"] for row in inputs["rows"]]
    _need(type(source_input) is dict and source_input.get("schema") == "reviewed-decoder-generation-input-receipt/v1"
          and source_input.get("profile") == "source-only-reviewed-decoder-generation-inputs/v1"
          and source_input.get("target_access_performed") is False
          and source_input.get("source_contexts_sha256") == inputs["expected_source_contexts_sha256"]
          and source_input.get("record_count") == len(expected_ids)
          and source_input.get("max_source_tokens") == inputs["max_source_tokens"]
          and type(args) is list and len(args) == len(expected_ids)
          and type(config) is dict and config.get("operation") == operation and config.get("profile") == profile
          and config.get("checkpoint_declarations") == {"encoder":inputs["encoder"],
               "decoder":{"id":expected_identity["backend_id"], "sha256":model["sha256"]}}
          and _commit(args) == config.get("producer_arguments_sha256")
          == source_input.get("source_arguments_sha256") == run.get("source_arguments_sha256")
          and _pin(run.get("source_records_sha256")) and source_input.get("prepared_records_sha256") == run["source_records_sha256"],
          "generation did not attest to the selected source-only evaluator arguments")
    if operation == VALIDATION_OPERATION:
        _native_validation_receipts(payload, _commit(inputs["split_manifest"]))
    commitments = source_input.get("row_commitments")
    raw_outputs = run.get("raw_generation_outputs")
    _need(type(commitments) is list and len(commitments) == len(expected_ids)
          and type(outputs) is list and len(outputs) == len(expected_ids)
          and type(raw_outputs) is list and len(raw_outputs) == len(expected_ids)
          and config.get("producer_outputs_sha256") == _commit(outputs)
          and run.get("producer_outputs") == outputs, "complete source-only input and disposition rosters required")
    for row, arg, seen, output, raw in zip(inputs["rows"], args, commitments, outputs, raw_outputs, strict=True):
        _need(arg == {"id":row["id"], "source_text":row["source_text"], "context":{"permitted":[], "retrieved":[]}}
              and type(seen) is dict and seen.get("id") == row["id"] and seen.get("unit_id") == row["unit_id"]
              and seen.get("source_text_sha256") == _sha(row["source_text"].encode("utf-8"))
              and _pin(seen.get("source_wire_sha256")) and _pin(seen.get("source_token_ids_sha256"))
              and type(output) is dict and set(output) == {"id","outcome","candidate"} and output["id"] == row["id"]
              and type(raw) is dict and raw.get("unit_id") == row["unit_id"]
              and all(raw.get(key) == value for key, value in output.items()),
              "observed source-only input or ordered output disposition differs")
    return {"candidate_sha256":checkpoint, "saved_artifact_sha256":_commit(saved),
            "producer_commitment_sha256":digest, "source_records_sha256":run["source_records_sha256"],
            "row_dispositions":tuple((item["id"], item["outcome"]) for item in outputs)}


def bind_t5_fusion_development(train_batch, development_batch, *, teacher_prefix,
                               expected_train_batch_sha256, expected_development_batch_sha256,
                               expected_configuration_sha256, expected_model_checkpoint_sha256):
    """Reuse the selected TRAIN projections on disjoint DEVELOPMENT occurrences."""
    return _bind_t5_fusion_inference(train_batch, development_batch, teacher_prefix=teacher_prefix,
        expected_train_batch_sha256=expected_train_batch_sha256,
        expected_inference_batch_sha256=expected_development_batch_sha256,
        expected_configuration_sha256=expected_configuration_sha256,
        expected_model_checkpoint_sha256=expected_model_checkpoint_sha256, partition="development")


def bind_t5_fusion_final(train_batch, final_batch, *, teacher_prefix, expected_train_batch_sha256,
                         expected_final_batch_sha256, expected_configuration_sha256,
                         expected_model_checkpoint_sha256, frozen_roster_sha256, dependency_group_sha256):
    """Bind newly prepared FINAL inputs under the unchanged TRAIN projections."""
    _need(_pin(frozen_roster_sha256) and _pin(dependency_group_sha256),
          "fused FINAL teacher inputs require the frozen roster and reserved component")
    binding = _bind_t5_fusion_inference(train_batch, final_batch, teacher_prefix=teacher_prefix,
        expected_train_batch_sha256=expected_train_batch_sha256, expected_inference_batch_sha256=expected_final_batch_sha256,
        expected_configuration_sha256=expected_configuration_sha256,
        expected_model_checkpoint_sha256=expected_model_checkpoint_sha256, partition="final")
    return {**binding, "frozen_roster_sha256": frozen_roster_sha256, "dependency_group_sha256": dependency_group_sha256}


def _bind_t5_fusion_inference(train_batch, inference_batch, *, teacher_prefix,
                              expected_train_batch_sha256, expected_inference_batch_sha256,
                              expected_configuration_sha256, expected_model_checkpoint_sha256, partition):
    prefix = teacher_prefix
    prefix._need(type(train_batch) is type(inference_batch) is prefix.T5FusionBatch
          and (train_batch.phase, train_batch.partition) == ("train", "train")
          and (inference_batch.phase, inference_batch.partition) == ("inference", partition)
          and prefix._pin(expected_train_batch_sha256) and prefix._pin(expected_inference_batch_sha256)
          and prefix.batch_commit(train_batch) == expected_train_batch_sha256
          and prefix.batch_commit(inference_batch) == expected_inference_batch_sha256,
          f"exact T5 fusion TRAIN and {partition.upper()} batches required")
    prefix._need(prefix._pin(expected_configuration_sha256) and prefix._pin(expected_model_checkpoint_sha256)
          and train_batch.configuration_sha256 == inference_batch.configuration_sha256
              == expected_configuration_sha256
          and inference_batch.checkpoint_sha256 == expected_model_checkpoint_sha256,
          f"T5 fusion {partition.upper()} configuration or model checkpoint differs")
    projection_pins = prefix._fusion_projection_commits(train_batch.projections)
    prefix._need(prefix._fusion_projection_commits(inference_batch.projections) == projection_pins
          and inference_batch.mode == train_batch.mode,
          f"T5 fusion {partition.upper()} requires the frozen TRAIN projections and treatment")

    def selected_population(batch):
        population = {row.row_id: row for row in batch.population if row.partition == batch.partition}
        prefix._need(len({row.row_id for row in batch.rows}) == len(batch.rows)
              and all(row.row_id in population
                      and (row.source_wire_sha256, row.source_span_sha256) ==
                          (population[row.row_id].source_wire_sha256, population[row.row_id].source_span_sha256)
                      for row in batch.rows),
              "T5 fusion selected rows must retain their ordered partition and original source occurrences")
        return population

    train_population = selected_population(train_batch)
    selected_population(inference_batch)
    train_wires = {row.source_wire_sha256 for row in train_population.values()}
    train_spans = {row.source_span_sha256 for row in train_population.values()}
    prefix._need(all(row.source_wire_sha256 not in train_wires and row.source_span_sha256 not in train_spans
              for row in inference_batch.rows),
          f"T5 fusion {partition.upper()} reuses a known TRAIN source wire or span")
    width = inference_batch.projections[0].output_width
    committed_inputs, rows = [], []
    for row in inference_batch.rows:
        row_commit = prefix._fusion_row_commit(row, inference_batch.projections, projection_pins,
                                                inference_batch.mode)
        fused, _ = prefix._fuse(row, width, projection_pins, inference_batch.mode)
        slot_sha256 = prefix._sha(fused.data)
        rows.append({"row_id": row.row_id, "source_wire_sha256": row.source_wire_sha256,
                     "source_span_sha256": row.source_span_sha256, "actual_fp32_slot_sha256": slot_sha256,
                     "slot_width": width})
        committed_inputs.append((row_commit, slot_sha256))
    matched_inputs_sha256 = prefix._commit((f"reviewed-t5-fusion-matched-{partition}-inputs/v1",
        inference_batch.population_sha256, expected_configuration_sha256, projection_pins,
        prefix.FUSION_RULE, inference_batch.mode, inference_batch.maximum_observations,
        inference_batch.maximum_population_rows, inference_batch.maximum_report_bytes,
        tuple(committed_inputs)))
    return {"schema": f"reviewed-t5-fusion-{partition}-inference-binding/v1",
            "training_batch_sha256": expected_train_batch_sha256,
            f"{partition}_batch_sha256": expected_inference_batch_sha256,
            "configuration_sha256": expected_configuration_sha256,
            "model_checkpoint_sha256": expected_model_checkpoint_sha256,
            "projection_sha256s": projection_pins, "fusion_rule": prefix.FUSION_RULE,
            "mode": inference_batch.mode, "row_ids": tuple(row["row_id"] for row in rows),
            f"{partition}_population_sha256": inference_batch.population_sha256,
            "matched_inputs_sha256": matched_inputs_sha256, "rows": tuple(rows)}


def _t5_fusion_development_observation(saved, *, binding, expected_binding, model_sha256):
    return _t5_fusion_inference_observation(saved, binding=binding, expected_binding=expected_binding,
                                          model_sha256=model_sha256, partition="development")


def _require_final_fusion_members(frame, row, binding):
    from . import teacher_prefix

    mode = binding["mode"]
    active = teacher_prefix._FUSION_ACTIVE.get(mode) if type(mode) is str else None
    members = frame.get("fusion_members")
    projections = binding["projection_sha256s"]
    _need(active is not None and type(projections) in (tuple, list) and len(projections) == 2
          and all(_pin(pin) for pin in projections) and len(set(projections)) == 2
          and type(members) is list and len(members) == 2 and all(type(member) is dict for member in members)
          and frame.get("staged_fusion_f32_sha256") == row["actual_fp32_slot_sha256"],
          "fused FINAL forwards require the exact staged slot and two ordered teacher members")
    base = {"profile_sha256", "projection_sha256", "status", "outcome_sha256", "consumed"}
    embedded_receipts = {"source_input_receipt_sha256", "producer_receipt_sha256", "native_vector_sha256",
                         "materialized_native_f32_sha256", "staged_projection_f32_sha256"}
    available = {"missing_left": (False, True), "missing_right": (True, False)}.get(mode, (True, True))
    for member, projection, consumed, embedded in zip(members, projections, active, available, strict=True):
        pins = (base - {"status", "consumed"}) | (embedded_receipts if embedded else set())
        _need(set(member) == pins | {"status", "consumed"} and all(_pin(member[name]) for name in pins)
              and member["projection_sha256"] == projection and member["consumed"] is consumed
              and (member["status"] == "embedded" if embedded else member["status"] in teacher_prefix._UNAVAILABLE_TEACHER),
              "fused FINAL teacher member order, outcome or treatment differs")
    _need(members[0]["profile_sha256"] != members[1]["profile_sha256"],
          "fused FINAL forwards require distinct teacher profiles")
    return _commit(members)


def _t5_fusion_inference_observation(saved, *, binding, expected_binding, model_sha256, partition):
    """Verify the exact prepared source roster and every retained fused encoder forward."""
    schema, fields = ((_T5_FUSION_FINAL_BINDING, _T5_FUSION_FINAL_BINDING_FIELDS) if partition == "final"
                      else (_T5_FUSION_DEVELOPMENT_BINDING, _T5_FUSION_DEVELOPMENT_BINDING_FIELDS))
    _need(type(binding) is dict and set(binding) == fields and binding["schema"] == schema
          and _commit(binding) == expected_binding and binding["model_checkpoint_sha256"] == model_sha256,
          "fused DEVELOPMENT observation requires its selected conditioning and checkpoint role")
    producer = saved.get("metadata", {}).get("source_generation_observation", {})
    declaration, call = producer.get("input_commitment", {}), producer.get("last_call", {})
    _need(type(declaration) is dict and type(call) is dict
          and declaration.get("t5_fusion_assessment_binding_sha256") == expected_binding
          and _commit(declaration.get("t5_fusion_assessment_binding")) == expected_binding,
          "fused DEVELOPMENT producer did not declare its selected conditioning")
    teacher = call.get("t5_fusion_observation")
    frames = teacher.get("forwards") if type(teacher) is dict else None
    batch_fields = {"profile", "phase", "mode", "partition", "batch_sha256", "population_sha256",
                    "starting_checkpoint_sha256", "forwards", "projection_sha256s", "fusion_rule"}
    _need(type(teacher) is dict and set(teacher) == batch_fields and type(frames) is list
          and (teacher["profile"], teacher["phase"], teacher["partition"], teacher["batch_sha256"],
               teacher["starting_checkpoint_sha256"], teacher["mode"], teacher["population_sha256"],
               teacher["fusion_rule"]) ==
              ("reviewed-t5-encoder-frozen-two-teacher-prefix/v1", "inference", partition,
               binding[f"{partition}_batch_sha256"], model_sha256, binding["mode"],
               binding[f"{partition}_population_sha256"], binding["fusion_rule"])
          and _commit(teacher["projection_sha256s"]) == _commit(binding["projection_sha256s"]),
          "actual fused DEVELOPMENT profile, checkpoint, projection or batch differs")
    inputs = call.get("input_receipt", {})
    contract = inputs.get("tokenizer_contract")
    _need(type(contract) is dict and all(type(contract.get(name)) is int for name in (
              "vocab_size", "bos_token_id", "eos_token_id"))
          and contract["bos_token_id"] != contract["eos_token_id"],
          "fused DEVELOPMENT source preparation requires its exact tokenizer boundaries")
    raw, source = call.get("raw_generation_outputs"), inputs.get("row_commitments")
    source_tokens = call.get("t5_fusion_source_roster")
    rows, ordered = binding["rows"], binding["row_ids"]
    _need(type(rows) in (tuple, list) and bool(rows) and type(ordered) in (list, tuple)
          and all(type(items) is list and len(items) == len(rows) for items in (raw, source, source_tokens))
          and len(ordered) == len(rows),
          "complete fused DEVELOPMENT source, token and result rosters required")
    used = 0
    for row_id, row, source_row, tokens, generated in zip(ordered, rows, source, source_tokens, raw, strict=True):
        _need(all(type(item) is dict for item in (row, source_row, tokens, generated))
              and set(row) == {"row_id", "source_wire_sha256", "source_span_sha256",
                               "actual_fp32_slot_sha256", "slot_width"}
              and type(row_id) is str and bool(row_id) and row_id == row["row_id"]
              and row_id == source_row.get("id") == generated.get("id") == tokens.get("row_id")
              and all(_pin(row[key]) for key in ("source_wire_sha256", "source_span_sha256", "actual_fp32_slot_sha256"))
              and type(row["slot_width"]) is int and 1 <= row["slot_width"] <= 65536
              and source_row.get("source_wire_sha256") == row["source_wire_sha256"]
              and set(tokens) == {"row_id", "source_token_count", "source_token_ids_sha256"}
              and _pin(tokens["source_token_ids_sha256"])
              and tokens["source_token_ids_sha256"] == source_row.get("source_token_ids_sha256")
              and type(tokens["source_token_count"]) is int
              and 3 <= tokens["source_token_count"] <= declaration.get("max_source_tokens", 0)
              and type(generated.get("generated_token_ids")) is list and bool(generated["generated_token_ids"])
              and len(generated["generated_token_ids"]) <= declaration.get("max_output_tokens", 0)
              and all(type(token) is int and 0 <= token < contract["vocab_size"]
                      for token in generated["generated_token_ids"])
              and generated["generated_token_ids"][0] == contract["bos_token_id"]
              and (generated.get("outcome") != "complete" or len(generated["generated_token_ids"]) >= 3
                   and generated["generated_token_ids"][-1] == contract["eos_token_id"]),
              "fused DEVELOPMENT source occurrence or token bounds differ")
        steps = len(generated["generated_token_ids"]) - 1
        _need(used + steps <= len(frames), "fused DEVELOPMENT forward observations are incomplete")
        first_member_trace = None
        for index in range(steps):
            frame = frames[used + index]
            _need(type(frame) is dict and all(frame.get(key) == row[key] for key in (
                      "row_id", "source_wire_sha256", "source_span_sha256", "actual_fp32_slot_sha256"))
                  and frame.get("slot_shape") == [1, 1, row["slot_width"]]
                  and type(frame.get("encoder_input_positions")) is int
                  and frame["encoder_input_positions"] == tokens["source_token_count"] + 1
                  and type(frame.get("decoder_input_positions")) is int
                  and frame["decoder_input_positions"] == index + 1
                  and "decoder_label_positions" in frame and frame["decoder_label_positions"] is None,
                  "fused DEVELOPMENT forward changed its selected slot, encoder mask or decoder prefix extent")
            if partition == "final":
                trace = _require_final_fusion_members(frame, row, binding)
                _need(first_member_trace is None or first_member_trace == trace,
                      "fused FINAL teacher member evidence changed between decoder prefixes")
                first_member_trace = trace
        used += steps
    _need(used == len(frames), "fused DEVELOPMENT report has unselected extra forward observations")
    return _commit(teacher)


def _fused_assessment_proof_options(pair):
    """Use the assessment owner's grouped policy for the optional original proof."""
    if pair is None:
        return {}
    from . import grouped_policy

    return {"fused_proof_pair": pair, "grouped_policy": grouped_policy}


def _require_current_fused_assessment_proof(selection, expected_attempt, pair, terminal_close, expected_terminal_close):
    if pair is not None:
        _need(policy_attempt_commitment(selection) == expected_attempt
              and pair.digest() == selection.allocation_pair_sha256,
              "selected fused policy proof changed after terminal readback")
        _need(policy_close_commitment(terminal_close) == expected_terminal_close,
              "selected fused policy terminal close changed after terminal readback")


DEVELOPMENT_OUTPUT_CAPACITY_SCHEMA = "reviewed-t5-development-output-lower-bounds/v1"


@dataclass(frozen=True)
class DevelopmentOutputCapacityReport:
    assessment_sha256: str
    configuration_sha256: str
    tokenizer_pipeline_sha256: str
    target_codec: str
    # Each count is a lower bound for the complete canonical output including BOS and EOS.
    rows: tuple[tuple[str, str, int], ...]


@dataclass(frozen=True)
class DevelopmentOutputCapacity:
    report: DevelopmentOutputCapacityReport
    expected_report_sha256: str
    verify_owner: Callable[[str, str], bool]


def _development_output_capacity_rows(rows, *, maximum_rows):
    return (type(rows) is tuple and 1 <= len(rows) <= maximum_rows
            and all(type(item) is tuple and len(item) == 3 and type(item[0]) is str
                    and 0 < len(item[0]) <= 4096 and _pin(item[1])
                    and type(item[2]) is int and 3 <= item[2] < 2**31 for item in rows)
            and len({item[0] for item in rows}) == len(rows))


def _enforce_development_output_capacity(rows, output_limit, window):
    effective_limit = min(output_limit, window)
    largest_bound = max(count for _, _, count in rows)
    # A lower bound below the cap does not establish exact-output reachability.
    _need(largest_bound <= effective_limit,
          f"canonical output lower bound {largest_bound} exceeds selected T5 capacity {effective_limit}")


def development_output_capacity_commitment(report):
    """Commit exact DEVELOPMENT reference pins and owner-measured token bounds."""
    _need(type(report) is DevelopmentOutputCapacityReport and all(_pin(pin) for pin in (
        report.assessment_sha256, report.configuration_sha256, report.tokenizer_pipeline_sha256))
          and type(report.target_codec) is str and report.target_codec == FULL_CODEC
          and _development_output_capacity_rows(report.rows, maximum_rows=32),
          "exact bounded canonical T5 output report required")
    return _commit((DEVELOPMENT_OUTPUT_CAPACITY_SCHEMA, asdict(report)))


def _check_development_output_capacity(selected, plan, assessment_sha256, scoring, configuration, output_limit):
    _need(type(plan) in (DecisionSpanValidationAssessment, T5FusionSpanValidationAssessment) and plan.route == T5
          and type(scoring) is DecisionSpanValidationScoring,
          "output capacity evidence requires selected Stage D T5 DEVELOPMENT")
    _need(type(selected) is DevelopmentOutputCapacity and _pin(selected.expected_report_sha256)
          and callable(selected.verify_owner), "independently selected output capacity owner required")
    report, expected, verify = selected.report, selected.expected_report_sha256, selected.verify_owner
    _need(development_output_capacity_commitment(report) == expected,
          "canonical output report differs from the selected commitment")

    def bound_inputs():
        tokenizer = configuration.get("tokenizer")
        _need(type(tokenizer) is dict and _pin(tokenizer.get("pipeline_sha256"))
              and type(configuration.get("max_sequence_tokens")) is int
              and configuration["max_sequence_tokens"] >= 3
              and type(output_limit) is int and 2 <= output_limit <= 65536,
              "selected T5 tokenizer, sequence window and output budget required")
        references = tuple((case.row_id, case.reference_sha256) for case in scoring.policy.cases
                           if case.dependency_group_sha256 == plan.dependency_group_sha256)
        return (commitment(plan), _commit(configuration), tokenizer["pipeline_sha256"],
                references, configuration["max_sequence_tokens"])

    bound = bound_inputs()
    _need((assessment_sha256, report.configuration_sha256, report.tokenizer_pipeline_sha256,
           tuple((row, ref) for row, ref, _ in report.rows)) == bound[:4]
          and report.assessment_sha256 == assessment_sha256,
          "canonical output capacity differs from the selected T5 configuration or ordered DEVELOPMENT roster")
    _need(verify(assessment_sha256, expected) is True, "output capacity owner refused the selected report")
    _need(selected.report is report and selected.expected_report_sha256 == expected
          and selected.verify_owner is verify and development_output_capacity_commitment(report) == expected
          and bound_inputs() == bound, "canonical output capacity inputs changed during owner verification")
    _enforce_development_output_capacity(report.rows, output_limit, bound[-1])




PROSPECTIVE_T5_DEVELOPMENT_OUTPUT_CAPACITY_SCHEMA = 'reviewed-t5-prospective-development-output-capacity/v1'


@dataclass(frozen=True)
class ProspectiveT5DevelopmentOutputCapacityReport:
    study_sha256: str
    development_split_sha256: str
    evaluation_policy_sha256: str
    optimizer_step_grid_sha256: str
    configuration_sha256: str
    tokenizer_pipeline_sha256: str
    target_codec: str
    max_output_tokens: int
    # Ordered DEVELOPMENT reference digests with BOS/EOS-inclusive lower bounds.
    rows: tuple[tuple[str, str, int], ...]


def prospective_t5_development_output_capacity_commitment(report):
    _need(type(report) is ProspectiveT5DevelopmentOutputCapacityReport and all(_pin(pin) for pin in (
              report.study_sha256, report.development_split_sha256, report.evaluation_policy_sha256,
              report.optimizer_step_grid_sha256, report.configuration_sha256, report.tokenizer_pipeline_sha256))
          and type(report.target_codec) is str and report.target_codec == FULL_CODEC
          and type(report.max_output_tokens) is int and 2 <= report.max_output_tokens <= 65536
          and _development_output_capacity_rows(report.rows, maximum_rows=4096),
          'exact prospective T5 DEVELOPMENT output capacity report required')
    return _commit((PROSPECTIVE_T5_DEVELOPMENT_OUTPUT_CAPACITY_SCHEMA, asdict(report)))


def _t5_development_capacity_configuration(configuration, max_output_tokens):
    _need(type(configuration) is dict, 'exact T5 output configuration required')
    tokenizer = configuration.get('tokenizer')
    model_config = configuration.get('model_config')
    window = configuration.get('max_sequence_tokens')
    _need(configuration.get('architecture') == 'encoder_decoder'
          and configuration.get('target_codec') == FULL_CODEC and type(model_config) is dict
          and model_config.get('model_type') == 't5' and type(tokenizer) is dict
          and _pin(tokenizer.get('pipeline_sha256')) and type(window) is int and window >= 3
          and type(max_output_tokens) is int and 2 <= max_output_tokens <= 65536,
          'prospective capacity differs from the selected T5 tokenizer, codec or limits')
    return tokenizer, window


def bind_t5_development_output_capacity_guard(report, *, expected_report_sha256, study_owner, study,
        split, policy, step_grid, configuration, max_output_tokens, verify_owner, execution_guard):
    """Check both arms' shared DEVELOPMENT budget before selecting a loader guard.

    The report belongs to the registered study and has no candidate or terminal
    dependency. The caller can perform this check before any model load. The
    existing execution guard still authorizes the actual operation. The report
    and counts remain outside the loader, training and producer inputs.
    """
    _need(_pin(expected_report_sha256) and callable(verify_owner) and callable(execution_guard)
          and type(study) is study_owner.Study and type(split) is DecisionSpanValidationSplit
          and type(policy) is GatePolicy and type(configuration) is dict,
          'independently selected output capacity and original execution owner required')

    def check_selection():
        _need(prospective_t5_development_output_capacity_commitment(report) == expected_report_sha256
              and tuple(arm for arm, _ in study.arms) == DECISION_SPAN_POLICY_ARMS
              and study_owner.commitment(study) == report.study_sha256,
              'prospective output capacity differs from the selected matched policy study')
        scope = _decision_span_paid_validation_scope(study_owner, study, report.study_sha256, split, policy,
            report.development_split_sha256, step_grid)
        _need(scope['step_grid_sha256'] == report.optimizer_step_grid_sha256
              and report.evaluation_policy_sha256 == gate_policy_commitment(policy)
              and tuple((row, reference) for row, reference, _ in report.rows)
                  == tuple((case.row_id, case.reference_sha256) for case in policy.cases),
              'prospective capacity differs from the selected DEVELOPMENT references or grid')
        tokenizer, window = _t5_development_capacity_configuration(configuration, max_output_tokens)
        _need(tokenizer['pipeline_sha256'] == report.tokenizer_pipeline_sha256
              and max_output_tokens == report.max_output_tokens
              and _commit(configuration) == report.configuration_sha256,
              'prospective capacity differs from the selected T5 tokenizer, codec or limits')
        _enforce_development_output_capacity(report.rows, max_output_tokens, window)

    check_selection()
    _need(verify_owner(report.study_sha256, expected_report_sha256) is True,
          'output capacity owner refused the prospective report')
    check_selection()
    return execution_guard


T5_DEVELOPMENT_WITNESS_SCOPE_SCHEMA = 'reviewed-t5-development-output-witness-scope/v1'
T5_DEVELOPMENT_WITNESS_SCHEMA = 'reviewed-t5-development-output-witness/v1'


def t5_development_output_witness_scope(study_owner, *, study, split, policy, step_grid,
        configuration, max_output_tokens, allow_fictional_tokenizer=False):
    """Commit the registered DEVELOPMENT scope before obtaining reference bodies."""
    _need(type(study) is study_owner.Study and type(split) is DecisionSpanValidationSplit
          and type(policy) is GatePolicy and type(allow_fictional_tokenizer) is bool,
          'exact selected policy DEVELOPMENT study and tokenizer mode required')
    _need(tuple(arm for arm, _ in study.arms) == DECISION_SPAN_POLICY_ARMS,
          'prospective T5 witness requires both matched decision span policy arms')
    study_sha = study_owner.commitment(study)
    split_sha = decision_span_validation_split_commitment(split)
    scope = _decision_span_paid_validation_scope(study_owner, study, study_sha, split, policy, split_sha, step_grid)
    tokenizer_contract, window = _t5_development_capacity_configuration(configuration, max_output_tokens)
    return {'schema': T5_DEVELOPMENT_WITNESS_SCOPE_SCHEMA, 'study_sha256': study_sha,
        'split_sha256': split_sha, 'policy_sha256': gate_policy_commitment(policy),
        'step_grid_sha256': scope['step_grid_sha256'], 'configuration_sha256': _commit(configuration),
        'tokenizer_pipeline_sha256': tokenizer_contract['pipeline_sha256'], 'target_codec': FULL_CODEC,
        'max_output_tokens': max_output_tokens, 'max_sequence_tokens': window,
        'allow_fictional_tokenizer': allow_fictional_tokenizer,
        'ordered_references': tuple((case.dependency_group_sha256, case.row_id, case.reference_sha256)
                                    for case in policy.cases)}


def prepare_t5_development_output_witnesses(study_owner, *, study, split, policy, step_grid,
        configuration, max_output_tokens, tokenizer, components, expected_scope_sha256, verify_owner,
        allow_fictional_tokenizer=False):
    """Measure one exact canonical encoding of each independently selected DEVELOPMENT target.

    The sequence length is an upper bound on the tokens needed for a complete
    encoding. An encoding above the requested limits leaves fit unestablished.
    The report contains counts and commitments, for the reference owner only.
    """
    def current_scope():
        return t5_development_output_witness_scope(study_owner, study=study, split=split, policy=policy,
            step_grid=step_grid, configuration=configuration, max_output_tokens=max_output_tokens,
            allow_fictional_tokenizer=allow_fictional_tokenizer)

    scope = current_scope()
    _need(_pin(expected_scope_sha256) and _commit(scope) == expected_scope_sha256 and callable(verify_owner)
          and verify_owner(scope['study_sha256'], expected_scope_sha256) is True,
          'independently selected DEVELOPMENT witness scope required')
    _need(current_scope() == scope, 'DEVELOPMENT witness scope changed during owner verification')

    groups = _heldout_groups(policy, study)
    _need(type(components) is dict and tuple(components) == tuple(groups)
          and all(type(component) is dict and set(component) == {'rows', 'split_manifest'}
                  and type(component['rows']) is list
                  and all(type(row) is dict and set(row) == {'id', 'unit_id', 'source_text', 'canonical_ir'}
                          for row in component['rows'])
                  for component in components.values()),
          'exact ordered DEVELOPMENT components required for an output witness')
    split_scope, manifest, examples, members, crosswalk = _development_population_scope(
        split.manifest, split.population, split.case_aliases, policy,
        expected_development_sha256=scope['split_sha256'], manifest_sha256=_commit(split.manifest))
    resolved = split_scope, manifest, examples, members, crosswalk, {occurrence for _, occurrence in split.train_occurrences}
    for group, component in components.items():
        _validate_development_component_for_group(group, component, policy, resolved)
    components_sha256 = _commit(components)

    from ...logic.autoformal import training_cycle_inputs as transport

    contract = transport._reviewed_decoder_tokenizer_contract(tokenizer)
    model = configuration['model_config']
    _need(type(contract) is dict and contract == configuration['tokenizer']
          and (contract['pipeline_kind'] == 'huggingface_fast'
               or allow_fictional_tokenizer and contract['pipeline_kind'] == 'fictional_fixed_byte')
          and all(type(model.get(field)) is int for field in ('vocab_size', 'decoder_start_token_id', 'eos_token_id'))
          and model.get('vocab_size') == contract['vocab_size']
          and model.get('decoder_start_token_id') == contract['bos_token_id']
          and model.get('eos_token_id') == contract['eos_token_id'],
          'live tokenizer differs from the selected T5 output transport')
    contract_sha256 = _commit(contract)
    limits = min(scope['max_output_tokens'], scope['max_sequence_tokens'])
    references = {row['id']: row['canonical_ir'] for component in components.values() for row in component['rows']}
    witnesses = []
    for _, row_id, reference_sha256 in scope['ordered_references']:
        target = transport._reviewed_decoder_canonical_formula_target(references[row_id])
        raw = transport._reviewed_wire(target)
        _need(_sha(raw) == reference_sha256, 'canonical DEVELOPMENT target changed before output witnessing')
        # 65,536 is the existing decoder's maximum output budget including
        # transport tokens. A failed roundtrip cannot issue a witness.
        token_ids = transport._reviewed_decoder_tokens(tokenizer, raw.decode('utf-8'), contract,
                                                       65536, 'development witness target')
        witnesses.append({'row_id': row_id, 'reference_sha256': reference_sha256,
            'encoded_tokens_including_bos_eos': len(token_ids), 'encoded_sequence_sha256': _commit(token_ids),
            'fit_witnessed': len(token_ids) <= limits})
    _need(_commit(transport._reviewed_decoder_tokenizer_contract(tokenizer)) == contract_sha256
          and current_scope() == scope and _commit(components) == components_sha256,
          'DEVELOPMENT references, limits or tokenizer changed during output witnessing')
    return {'schema': T5_DEVELOPMENT_WITNESS_SCHEMA, 'scope_sha256': expected_scope_sha256,
            'effective_limit': limits, 'rows': witnesses,
            'all_rows_fit_witnessed': all(row['fit_witnessed'] for row in witnesses)}


QWEN_REGISTERED_DEVELOPMENT_WITNESS_SCOPE = "reviewed-registered-qwen-development-target-witness-scope/v1"
QWEN_REGISTERED_DEVELOPMENT_WITNESS = "reviewed-registered-qwen-development-target-witness/v1"
T5_REGISTERED_DEVELOPMENT_WITNESS_SCOPE = "reviewed-registered-t5-development-target-witness-scope/v1"
T5_REGISTERED_DEVELOPMENT_WITNESS = "reviewed-registered-t5-development-target-witness/v1"
_QWEN_REGISTERED_WITNESS_CODEC = "complete-reviewed-norm-digest-omitted-json/v1"


def _registered_target_witness_route(route):
    _need(type(route) is str and route in (QWEN, T5), "explicit registered Qwen or T5 target-witness route required")
    if route == QWEN:
        return (QWEN_REGISTERED_DEVELOPMENT_WITNESS_SCOPE, QWEN_REGISTERED_DEVELOPMENT_WITNESS,
                _QWEN_REGISTERED_WITNESS_CODEC, "Qwen")
    return (T5_REGISTERED_DEVELOPMENT_WITNESS_SCOPE, T5_REGISTERED_DEVELOPMENT_WITNESS, FULL_CODEC, "T5")


def registered_development_target_witness_scope(study_owner, *, route, registration, matrix, variant,
        study, design, step_grid, policy, split, configuration, max_output_tokens, allow_fictional_tokenizer=False):
    """Commit the selected reference-only lane before processing its target bodies."""
    scope_schema, _, codec, label = _registered_target_witness_route(route)
    causal = route == QWEN
    groups = _heldout_groups(policy, study)
    policy_sha = gate_policy_commitment(policy)
    study_sha = study_owner.commitment(study)
    design_sha = study_owner.development_design_commitment(design)
    grid_sha = study_owner.development_step_grid_commitment(step_grid)
    study_owner._selected_development_grid(study, study_sha, design_sha, step_grid, grid_sha)
    _need(type(registration) is type(matrix) is dict
          and registration.get("schema") == study_owner.TWO_FAMILY_THRESHOLD_REGISTRATION_SCHEMA
          and registration.get("dispatch_authority") is False
          and matrix.get("schema") == study_owner.MATCHED_MATRIX_SCHEMA
          and matrix.get("evidence_kind") in ("native_reviewed", "fictional_fixture")
          and registration.get("evidence_kind") == matrix["evidence_kind"]
          and type(allow_fictional_tokenizer) is bool
          and (not allow_fictional_tokenizer or matrix["evidence_kind"] == "fictional_fixture")
          and 1 <= len(policy.cases) <= 4096 and bool(groups),
          f"exact registered {label} DEVELOPMENT evidence kind and ordered policy required")
    registration_fields = {key: registration.get(key) for key in study_owner._DECODER_TRANSPORT_REGISTRATION_PINS}
    registration_sha = study_owner.two_family_threshold_registration_commitment(**registration_fields)
    matrix_sha = study_owner.commitment(matrix)
    _need(registration_sha == registration.get("registration_sha256")
          and (registration_fields["study_sha256"], registration_fields["design_sha256"], registration_fields["grid_sha256"],
               registration_fields["matrix_sha256"], registration_fields["matrix_plan_sha256"],
               registration_fields["evaluation_policy_sha256"])
              == (study_sha, design_sha, grid_sha, matrix_sha, matrix.get("plan_sha256"), policy_sha)
          and (matrix.get("study_sha256"), matrix.get("development_design_sha256"), design.study_sha256)
              == (study_sha, design_sha, study_sha),
          "target witness requires the original matrix, registration, DEVELOPMENT policy and optimizer grid")

    _need(type(variant) is str and bool(variant), f"exact selected {label} variant label required")
    definition = study_owner._objective_portability_variants(matrix).get(variant)
    config_sha = _commit(configuration)
    profile = "qwen2-causal-last-source/v1" if causal else "t5-encoder-last-source/v1"
    codec_label = "digest-omitted" if causal else "full-codec"
    _need(type(configuration) is dict and definition is not None
          and definition["student_profile"] == profile
          and definition["configuration_sha256"] == config_sha
          and configuration.get("architecture") == ("causal_lm" if causal else "encoder_decoder")
          and (not causal or configuration.get("model_profile") == "builtin-qwen2-bfloat16/v1")
          and configuration.get("target_codec") == codec,
          f"exact selected {label} {codec_label} variant and configuration required")
    model, contract, window = (configuration.get(key) for key in ("model_config", "tokenizer", "max_sequence_tokens"))
    _need(type(model) is type(contract) is dict and model.get("model_type") == ("qwen2" if causal else "t5")
          and type(model.get(definition["native_size_field"])) is int
          and model[definition["native_size_field"]] == definition["native_size"]
          and type(window) is int and 3 <= window <= 262144
          and type(max_output_tokens) is int and 2 <= max_output_tokens <= min(window, 65536)
          and _pin(contract.get("pipeline_sha256"))
          and type(contract.get("vocab_size")) is int and contract["vocab_size"] >= 3
          and all(type(contract.get(field)) is int and 0 <= contract[field] < contract["vocab_size"]
                  for field in ("bos_token_id", "eos_token_id"))
          and contract["bos_token_id"] != contract["eos_token_id"],
          f"selected {label} native context or tokenizer special IDs differ from configuration")
    aliases = ("bos_token_id", "eos_token_id") if causal else ("decoder_start_token_id", "eos_token_id")
    vocab, model_vocab = contract["vocab_size"], model.get("vocab_size")
    _need(type(model_vocab) is int and vocab <= model_vocab <= vocab + (4096 if causal else 0)
          and all(type(model.get(name)) is int and model[name] == contract[field]
                  for name, field in zip(aliases, ("bos_token_id", "eos_token_id"), strict=True))
          and (not causal or type(model.get("max_position_embeddings")) is int and window <= model["max_position_embeddings"]),
          f"selected {label} model vocabulary, context or terminal aliases differ from tokenizer configuration")
    split_sha = decision_span_validation_split_commitment(split)
    _need((split.study_sha256, split.policy_sha256) == (study_sha, policy_sha)
          and _commit(split.manifest) == design.global_split_sha256
          and study_owner.commitment(split.case_aliases) == design.case_aliases_sha256,
          "target witness differs from the registered DEVELOPMENT split and occurrence aliases")
    return {
        "schema": scope_schema, "registration_sha256": registration_sha,
        "matrix_sha256": matrix_sha, "study_sha256": study_sha, "design_sha256": design_sha,
        "optimizer_step_grid_sha256": grid_sha, "evaluation_policy_sha256": policy_sha,
        "development_split_sha256": split_sha, "variant": variant, "configuration_sha256": config_sha,
        "tokenizer_pipeline_sha256": contract["pipeline_sha256"], "target_codec": codec,
        "max_sequence_tokens": window, "max_output_tokens": max_output_tokens, "evidence_kind": matrix["evidence_kind"],
        "allow_fictional_tokenizer": allow_fictional_tokenizer,
    }


def prepare_registered_development_target_witnesses(study_owner, *, route, registration, matrix, variant,
        study, design, step_grid, policy, split, configuration, max_output_tokens, tokenizer, components,
        expected_scope_sha256, verify_owner, allow_fictional_tokenizer=False):
    """Encode the reviewed target on a reference-only lane, without source prefill or model loading."""
    _, report_schema, codec, label = _registered_target_witness_route(route)

    def current_scope():
        return registered_development_target_witness_scope(study_owner, route=route, registration=registration, matrix=matrix,
            variant=variant, study=study, design=design, step_grid=step_grid, policy=policy, split=split,
            configuration=configuration, max_output_tokens=max_output_tokens,
            allow_fictional_tokenizer=allow_fictional_tokenizer)

    scope = current_scope()
    _need(_pin(expected_scope_sha256) and _commit(scope) == expected_scope_sha256 and callable(verify_owner)
          and verify_owner(scope["registration_sha256"], expected_scope_sha256) is True,
          f"independently selected {label} DEVELOPMENT target-witness scope required")
    _need(current_scope() == scope, f"{label} DEVELOPMENT witness scope changed during reviewer selection")

    groups = _heldout_groups(policy, study)
    _need(type(components) is dict and tuple(components) == tuple(groups)
          and all(type(component) is dict and set(component) == {"rows", "split_manifest"}
                  and type(component["rows"]) is list
                  and all(type(row) is dict and set(row) == {"id", "unit_id", "source_text", "canonical_ir"}
                          for row in component["rows"]) for component in components.values()),
          f"exact ordered DEVELOPMENT components required for a {label} target witness")
    split_scope, manifest, examples, members, crosswalk = _development_population_scope(
        split.manifest, split.population, split.case_aliases, policy,
        expected_development_sha256=scope["development_split_sha256"], manifest_sha256=design.global_split_sha256)
    _need((split_scope["population_sha256"], split_scope["reserved_final_count"])
          == (design.population_sha256, design.reserved_final_count),
          "target witness differs from registered population or reserved FINAL count")
    components_sha = _commit(components)
    resolved = split_scope, manifest, examples, members, crosswalk, {occurrence for _, occurrence in split.train_occurrences}
    for group, component in components.items():
        _validate_development_component_for_group(group, component, policy, resolved)

    from ...logic.autoformal import training_cycle_inputs as transport

    contract = transport._reviewed_decoder_tokenizer_contract(tokenizer)
    _need(type(contract) is dict and contract == configuration["tokenizer"]
          and (contract["pipeline_kind"] == "huggingface_fast"
               or allow_fictional_tokenizer and contract["pipeline_kind"] == "fictional_fixed_byte"),
          f"live tokenizer differs from the selected {label} output transport")
    contract_sha = _commit(contract)
    targets = {row["id"]: row["canonical_ir"] for component in components.values() for row in component["rows"]}
    rows = []
    for case in policy.cases:
        target = targets[case.row_id]
        raw = transport._reviewed_wire(target)
        _need(_sha(raw) == case.reference_sha256, f"canonical DEVELOPMENT target changed before {label} witnessing")
        if route == QWEN:
            body = transport.encode_reviewed_decoder_digest_omitted_target(target, target_codec=codec)
            inverse = transport.assemble_reviewed_decoder_digest_omitted_target(body, target_codec=codec)
            _need(transport._reviewed_wire(inverse) == raw, "Qwen target projection did not recover the exact full reference")
        else:
            canonical = transport._reviewed_decoder_canonical_formula_target(target)
            _need(transport._reviewed_wire(canonical) == raw, "T5 full-codec target differs from the exact full reference")
            body = raw.decode("utf-8")
        framed = transport._reviewed_decoder_tokens(tokenizer, body, contract, 65536, f"{label} DEVELOPMENT witness target")
        rows.append({
            "row_id": case.row_id, "unit_id": case.unit_id, "source_wire_sha256": case.source_wire_sha256,
            "source_binding_sha256": case.source_binding_sha256, "reference_sha256": case.reference_sha256,
            "target_wire_sha256": _sha(body.encode("utf-8")), "encoded_sequence_sha256": _commit(framed),
            "encoded_tokens_including_bos_eos": len(framed), "fit_within_output_cap_witnessed": len(framed) <= max_output_tokens,
        })
    _need(_commit(transport._reviewed_decoder_tokenizer_contract(tokenizer)) == contract_sha
          and current_scope() == scope and _commit(components) == components_sha,
          f"{label} DEVELOPMENT references, limits or tokenizer changed during output witnessing")
    return {**scope, "schema": report_schema, "scope_sha256": expected_scope_sha256,
            "rows": rows, "all_rows_fit_within_output_cap_witnessed": all(
                row["fit_within_output_cap_witnessed"] for row in rows),
            "source_prefill_verified": False, "dispatch_authority": False}


def verify_registered_development_target_witness(study_owner, *, route, registration, report,
        expected_report_sha256, lane, verify_close):
    """Verify the pair comparator's target-review role using a selected original close."""
    scope_schema, report_schema, codec, label = _registered_target_witness_route(route)

    def current():
        _need(type(lane) is study_owner.DecoderTransportEvidence
              and type(registration) is type(report) is dict and callable(verify_close)
              and _pin(expected_report_sha256) and _commit(report) == expected_report_sha256
              and report.get("schema") == report_schema
              and report.get("dispatch_authority") is report.get("source_prefill_verified") is False
              and _pin(lane.target_review_close_sha256), f"exact closed registered {label} target witness required")
        scope = {key: value for key, value in report.items() if key not in (
            "scope_sha256", "rows", "all_rows_fit_within_output_cap_witnessed", "source_prefill_verified", "dispatch_authority")}
        scope["schema"] = scope_schema
        expected_fields = {"schema", "registration_sha256", "matrix_sha256", "study_sha256", "design_sha256",
                           "optimizer_step_grid_sha256", "evaluation_policy_sha256", "development_split_sha256",
                           "variant", "configuration_sha256", "tokenizer_pipeline_sha256", "target_codec",
                           "max_sequence_tokens", "max_output_tokens", "evidence_kind", "allow_fictional_tokenizer"}
        _need(set(scope) == expected_fields and _commit(scope) == report.get("scope_sha256")
              and report.get("target_codec") == codec
              and tuple(report.get(key) for key in ("registration_sha256", "matrix_sha256", "evaluation_policy_sha256", "evidence_kind"))
                 == tuple(registration.get(key) for key in ("registration_sha256", "matrix_sha256", "evaluation_policy_sha256", "evidence_kind"))
              and (report.get("evidence_kind") == "fictional_fixture"
                   or report.get("evidence_kind") == "native_reviewed" and report.get("allow_fictional_tokenizer") is False)
              and tuple(report.get(name) for name in ("variant", "configuration_sha256", "tokenizer_pipeline_sha256",
                  "target_codec", "max_sequence_tokens", "max_output_tokens")) == (lane.variant, lane.configuration_sha256,
                  lane.tokenizer_pipeline_sha256, lane.target_codec, lane.max_sequence_tokens, lane.max_output_tokens),
              f"{label} target witness differs from its registration or exact original lane")
        rows = report.get("rows")
        fields = ("row_id", "unit_id", "source_wire_sha256", "source_binding_sha256", "reference_sha256", "target_wire_sha256")
        row_fields = set(fields) | {"encoded_sequence_sha256", "encoded_tokens_including_bos_eos", "fit_within_output_cap_witnessed"}
        _need(type(rows) is list and type(lane.rows) is tuple and bool(lane.rows) and len(rows) == len(lane.rows)
              and all(type(row) is dict and set(row) == row_fields and type(selected) is study_owner.DecoderTransportRow
                      and tuple(row.get(name) for name in fields) == tuple(getattr(selected, name) for name in fields)
                      and (route != T5 or row["target_wire_sha256"] == row["reference_sha256"])
                      and _pin(row.get("encoded_sequence_sha256"))
                      and type(row.get("encoded_tokens_including_bos_eos")) is int
                      and 3 <= row["encoded_tokens_including_bos_eos"] <= 65536
                      and row["encoded_tokens_including_bos_eos"] == selected.target_witness_positions
                      and selected.target_lower_bound_positions is None
                      and row.get("fit_within_output_cap_witnessed") is (
                          row["encoded_tokens_including_bos_eos"] <= lane.max_output_tokens)
                      for row, selected in zip(rows, lane.rows, strict=True))
              and report.get("all_rows_fit_within_output_cap_witnessed") is all(
                  row["fit_within_output_cap_witnessed"] for row in rows),
              f"{label} target witness requires exact ordered references and upper witness positions only")
        return study_owner.commitment((registration, lane)), report["scope_sha256"], lane.target_review_close_sha256

    before, scope_sha, close_sha = current()
    _need(verify_close(scope_sha, expected_report_sha256, close_sha) is True,
          f"independent {label} target witness owner refused the original close")
    _need(current() == (before, scope_sha, close_sha), f"{label} target review changed during close verification")
    return True


def registered_qwen_development_target_witness_scope(study_owner, *, registration, matrix, variant,
        study, design, step_grid, policy, split, configuration, max_output_tokens, allow_fictional_tokenizer=False):
    """Keep the registered Qwen scope and wire contract available to existing callers."""
    return registered_development_target_witness_scope(study_owner, route=QWEN, registration=registration, matrix=matrix,
        variant=variant, study=study, design=design, step_grid=step_grid, policy=policy, split=split,
        configuration=configuration, max_output_tokens=max_output_tokens, allow_fictional_tokenizer=allow_fictional_tokenizer)


def prepare_registered_qwen_development_target_witnesses(study_owner, *, registration, matrix, variant,
        study, design, step_grid, policy, split, configuration, max_output_tokens, tokenizer, components,
        expected_scope_sha256, verify_owner, allow_fictional_tokenizer=False):
    """Keep the existing registered Qwen target-witness entry point."""
    return prepare_registered_development_target_witnesses(study_owner, route=QWEN, registration=registration, matrix=matrix,
        variant=variant, study=study, design=design, step_grid=step_grid, policy=policy, split=split,
        configuration=configuration, max_output_tokens=max_output_tokens, tokenizer=tokenizer, components=components,
        expected_scope_sha256=expected_scope_sha256, verify_owner=verify_owner, allow_fictional_tokenizer=allow_fictional_tokenizer)


def verify_registered_qwen_development_target_witness(study_owner, *, registration, report,
        expected_report_sha256, lane, verify_close):
    """Keep the existing Qwen target-review close entry point."""
    return verify_registered_development_target_witness(study_owner, route=QWEN, registration=registration,
        report=report, expected_report_sha256=expected_report_sha256, lane=lane, verify_close=verify_close)


DEVELOPMENT_PREFILL_SCHEMA = "reviewed-development-source-only-prefill/v1"
DEVELOPMENT_EXACT_INPUT_SCHEMA = "reviewed-development-exact-input-audit/v1"


def development_prefill_scope(inputs, worker, *, route, configuration, generation_policy,
                              source_arguments, source_contexts_sha256, max_source_tokens, max_output_tokens):
    """Bind one original source-only component and the actual prefill route."""
    return _development_prefill_scope(inputs._reviewed_wire, worker, route=route, configuration=configuration,
        generation_policy=generation_policy, source_arguments=source_arguments,
        source_contexts_sha256=source_contexts_sha256, max_source_tokens=max_source_tokens,
        max_output_tokens=max_output_tokens)


def _development_prefill_scope(wire, worker, *, route, configuration, generation_policy,
                               source_arguments, source_contexts_sha256, max_source_tokens, max_output_tokens):
    _need(type(route) is str and route in (T5, QWEN) and type(configuration) is dict
          and type(source_arguments) in (list, tuple) and 1 <= len(source_arguments) <= 32
          and _pin(source_contexts_sha256), "exact bounded source-only component required")
    model = configuration.get("model_config")
    contract = configuration.get("tokenizer")
    window = configuration.get("max_sequence_tokens")
    _need(type(model) is dict and type(contract) is dict and _pin(contract.get("pipeline_sha256"))
          and type(window) is int and 3 <= window <= 262144
          and type(max_source_tokens) is int and 3 <= max_source_tokens <= 65536
          and type(max_output_tokens) is int and 2 <= max_output_tokens <= min(window, 65536),
          "exact selected tokenizer and source, output and sequence bounds required")
    if route == T5:
        _t5_development_capacity_configuration(configuration, max_output_tokens)
        _need(generation_policy is None, "exact source-only T5 default generation policy required")
        policy = None
    else:
        policy = worker._reviewed_decoder_generation_policy(generation_policy)
        _need(configuration.get("architecture") == "causal_lm" and model.get("model_type") == "qwen2"
              and configuration.get("model_profile") == "builtin-qwen2-bfloat16/v1"
              and configuration.get("target_codec") == worker.REVIEWED_DIGEST_OMITTED_TARGET_CODEC
              and policy.get("schema") == worker.REVIEWED_DIGEST_OMITTED_TERMINAL_POLICY_SCHEMA
              and policy.get("conditioning_profile") == worker.REVIEWED_DIGEST_OMITTED_CHATML_PROFILE
              and type(model.get("max_position_embeddings")) is int and window <= model["max_position_embeddings"],
              "exact source-only digest-omitted Qwen2 and ChatML policy required")
        vocab, model_vocab = contract.get("vocab_size"), model.get("vocab_size")
        _need(type(vocab) is int and type(model_vocab) is int and vocab <= model_vocab <= vocab + 4096
              and all(type(contract.get(key)) is type(model.get(key)) is int and model[key] == contract[key]
                      for key in ("bos_token_id", "eos_token_id")),
              "Qwen2 model metadata vocabulary or special IDs differ from the selected tokenizer")
    geometry = {"route": route, "configuration_sha256": _commit(configuration),
                "tokenizer_pipeline_sha256": contract["pipeline_sha256"], "generation_policy": policy,
                "max_sequence_tokens": window, "max_source_tokens": max_source_tokens,
                "max_output_tokens": max_output_tokens}
    return {"schema": DEVELOPMENT_PREFILL_SCHEMA, "geometry": geometry,
            "source_arguments_sha256": _sha(wire(list(source_arguments))),
            "source_contexts_sha256": source_contexts_sha256}


def prepare_development_source_only_prefill(inputs, worker, *, route, configuration, generation_policy,
            source_arguments, source_contexts, source_contexts_sha256, max_source_tokens, max_output_tokens,
            tokenizer, expected_scope_sha256, verify_selection_owner):
    """Replay the held source transport and return commitments to the model's initial inputs."""
    from types import SimpleNamespace

    def current():
        return development_prefill_scope(inputs, worker, route=route, configuration=configuration,
            generation_policy=generation_policy, source_arguments=source_arguments,
            source_contexts_sha256=source_contexts_sha256, max_source_tokens=max_source_tokens,
            max_output_tokens=max_output_tokens)

    scope = current()
    _need(_pin(expected_scope_sha256) and _commit(scope) == expected_scope_sha256
          and callable(verify_selection_owner) and verify_selection_owner(expected_scope_sha256) is True,
          "independently selected source-only prefill component required")
    _need(current() == scope and _sha(inputs._reviewed_wire(source_contexts)) == source_contexts_sha256,
          "source-only prefill selection changed or source contexts differ")
    contract = configuration["tokenizer"]
    _need(type(tokenizer) is worker.ReviewedPretrainedTokenizer and tokenizer.allow_fictional_fixture is False
          and inputs._reviewed_decoder_tokenizer_contract(tokenizer) == contract,
          "actual selected maintained tokenizer required")
    prepared = inputs.prepare_reviewed_decoder_generation_inputs(source_arguments,
        source_contexts=source_contexts, expected_source_contexts_sha256=source_contexts_sha256,
        tokenizer=tokenizer, max_source_tokens=max_source_tokens)
    receipt = prepared["receipt"]
    _need(receipt["source_arguments_sha256"] == scope["source_arguments_sha256"]
          and receipt["source_contexts_sha256"] == source_contexts_sha256
          and receipt["tokenizer_contract"] == contract,
          "source-only preparation differs from the selected inputs")
    policy = scope["geometry"]["generation_policy"]
    window = scope["geometry"]["max_sequence_tokens"]
    frame_owner = SimpleNamespace(tokenizer=tokenizer, target_codec=configuration["target_codec"])
    rows = []
    for row, source in zip(prepared["records"], receipt["row_commitments"], strict=True):
        if route == QWEN:
            frame = worker.TorchReviewedDecoderBackend._chatml_frame(
                frame_owner, row["source_wire"], policy["conditioning_profile"], contract)
            needed = len(frame) + max_output_tokens - 1
            effective_input = ("causal-first-prefill/v1", tuple(frame), "all_ones", "positions_from_zero")
        else:
            frame = row["source_token_ids"]
            needed = max(len(frame), max_output_tokens)
            effective_input = ("encoder-decoder-first-prefill/v1", tuple(frame), "all_ones",
                               (contract["bos_token_id"],))
        _need(needed <= window, "complete prefill and output budget exceed the model window")
        rows.append({"id": row["id"], "unit_id": row["unit_id"],
                     "source_wire_sha256": source["source_wire_sha256"],
                     "prefill_sha256": _commit(effective_input), "prefill_positions": len(frame)})
    _need(inputs._reviewed_decoder_tokenizer_contract(tokenizer) == contract
          and current() == scope and _sha(inputs._reviewed_wire(source_contexts)) == source_contexts_sha256,
          "source-only prefill changed during tokenizer or frame replay")
    return {"schema": DEVELOPMENT_PREFILL_SCHEMA, "scope_sha256": expected_scope_sha256,
            "geometry_sha256": _commit(scope["geometry"]), "source_receipt_sha256": _sha(inputs._reviewed_wire(receipt)),
            "rows": rows}


def audit_development_exact_inputs(policy, *, development_split_sha256, prefills, expected_scope_sha256,
                                   verify_development_owner):
    """Audit exact-reference reachability for a fixed deterministic source-only lane.

    For each identical input, at most the largest multiplicity of a single
    canonical reference can match. Independent legal scoring still owns fidelity.
    The existing owner callback must authenticate the approved DEVELOPMENT panel
    and its original prefill scopes and source receipts.
    """
    from collections import Counter

    def bind():
        _need(type(policy) is GatePolicy and type(policy.cases) is tuple and type(prefills) in (tuple, list)
              and _pin(development_split_sha256) and 1 <= len(prefills) <= len(policy.cases) <= 4096,
              "complete selected DEVELOPMENT prefill population required")
        _policy_groups(policy)
        rows, reports = {}, []
        scopes, source_receipts = set(), set()
        geometry = prefills[0].get("geometry_sha256") if type(prefills[0]) is dict else None
        for report in prefills:
            _need(type(report) is dict and set(report) == {
                    "schema", "scope_sha256", "geometry_sha256", "source_receipt_sha256", "rows"}
                  and report["schema"] == DEVELOPMENT_PREFILL_SCHEMA and all(_pin(report[key]) for key in (
                      "scope_sha256", "geometry_sha256", "source_receipt_sha256"))
                  and type(report["rows"]) is list and 1 <= len(report["rows"]) <= 32,
                  "exact closed prefill report required")
            _need(geometry == report["geometry_sha256"], "all prefill components must share the exact geometry")
            scope, source_receipt = report["scope_sha256"], report["source_receipt_sha256"]
            _need(scope not in scopes and source_receipt not in source_receipts,
                  "prefill scope and source receipt must each be unique across components")
            scopes.add(scope)
            source_receipts.add(source_receipt)
            for row in report["rows"]:
                _need(type(row) is dict and set(row) == {
                        "id", "unit_id", "source_wire_sha256", "prefill_sha256", "prefill_positions"}
                      and type(row["id"]) is str and row["id"] not in rows and type(row["unit_id"]) is str
                      and _pin(row["source_wire_sha256"]) and _pin(row["prefill_sha256"])
                      and type(row["prefill_positions"]) is int and 1 <= row["prefill_positions"] <= 262144,
                      "exact, unique prefill row required")
                rows[row["id"]] = row
            reports.append(_commit(report))
        _need(set(rows) == {case.row_id for case in policy.cases},
              "prefills must cover the exact full DEVELOPMENT roster")
        _need(all((rows[case.row_id]["unit_id"], rows[case.row_id]["source_wire_sha256"])
                  == (case.unit_id, case.source_wire_sha256) for case in policy.cases),
              "prefill sources differ from the selected reference panel")
        scope = _commit((DEVELOPMENT_EXACT_INPUT_SCHEMA, development_split_sha256, gate_policy_commitment(policy),
                         tuple(reports)))
        return scope, rows, geometry

    selected, _, _ = bind()
    _need(_pin(expected_scope_sha256) and selected == expected_scope_sha256 and callable(verify_development_owner)
          and verify_development_owner(development_split_sha256, selected) is True,
          "independently verified DEVELOPMENT split, reference panel and prefill evidence required")
    replayed, rows, geometry = bind()
    _need(replayed == selected, "DEVELOPMENT prefill evidence changed during owner verification")

    by_input, by_wire = {}, {}
    for case in policy.cases:
        row = rows[case.row_id]
        key, wire = row["prefill_sha256"], row["source_wire_sha256"]
        _need(by_wire.setdefault(wire, key) == key,
              "identical complete source wire has inconsistent prefill evidence")
        source, length, references, groups = by_input.setdefault(
            key, (wire, row["prefill_positions"], Counter(), set()))
        _need(source == wire and length == row["prefill_positions"],
              "equal prefills disagree with lossless complete source or position identity")
        references[case.reference_sha256] += 1
        groups.add(case.dependency_group_sha256)
    conflicts = []
    maximum = 0
    for _, _, references, groups in by_input.values():
        largest = max(references.values())
        maximum += largest
        if len(references) > 1:
            size = sum(references.values())
            conflicts.append({"rows": size, "distinct_exact_references": len(references),
                              "dependency_groups": len(groups), "minimum_exact_misses": size - largest})
    return {"schema": DEVELOPMENT_EXACT_INPUT_SCHEMA, "scope_sha256": selected, "geometry_sha256": geometry,
            "total_rows": len(policy.cases), "effective_input_classes": len(by_input),
            "exact_reference_conflict_classes": tuple(conflicts), "deterministic_exact_match_upper_bound": maximum,
            "deterministic_exact_miss_lower_bound": len(policy.cases) - maximum}


REGISTERED_DEVELOPMENT_SOURCE_PREFILL_SCHEMA = "reviewed-registered-development-source-prefill/v1"


@dataclass(frozen=True)
class RegisteredDevelopmentPrefillComponent:
    scope: dict
    report: dict
    source_contexts: dict
    expected_report_sha256: str
    original_close_sha256: str
    evidence_kind: str


def registered_development_source_prefill_commitment(*, registered_scope_sha256, prefill_close_sha256,
        issuer_source_sha256s, components):
    """Select the ordered original prefill results and their source-only context pins."""
    _need(_pin(registered_scope_sha256) and _pin(prefill_close_sha256)
          and type(issuer_source_sha256s) is tuple and len(issuer_source_sha256s) == 2
          and all(type(row) is tuple and len(row) == 2 and row[0] == role and _pin(row[1])
                  for row, role in zip(issuer_source_sha256s, ("inputs", "worker"), strict=True))
          and type(components) is tuple and 1 <= len(components) <= 4096
          and all(type(row) is RegisteredDevelopmentPrefillComponent
                  and _pin(row.expected_report_sha256) and _pin(row.original_close_sha256)
                  and type(row.scope) is type(row.source_contexts) is type(row.report) is dict
                  and row.evidence_kind in ("native_reviewed", "fictional_fixture")
                  for row in components),
          "exact registered scope, selected prefill issuer and original component close pins required")
    original = tuple((_commit(row.scope), row.expected_report_sha256, row.original_close_sha256, row.evidence_kind)
                     for row in components)
    return _commit((REGISTERED_DEVELOPMENT_SOURCE_PREFILL_SCHEMA, registered_scope_sha256, prefill_close_sha256,
                    issuer_source_sha256s, original))


def verify_registered_development_source_prefill(study_owner, inputs, worker, *, route, registration, matrix,
        study, design, step_grid, policy, split, configuration, lane, components, issuer_source_sha256s,
        expected_selection_sha256, verify_close):
    """Verify a paired study's source role from detached original reports, without retokenizing.

    The existing close owner authenticates the aggregate and each original
    issuance, including the selected inputs/framer, report, context, and resource
    custody. Hashes and observations here do not replace original closes.
    """
    _need(type(lane) is study_owner.DecoderTransportEvidence and _pin(expected_selection_sha256)
          and callable(verify_close), "closed source prefill for a selected decoder lane required")

    def current():
        registered = registered_development_target_witness_scope(study_owner, route=route,
            registration=registration, matrix=matrix, variant=lane.variant, study=study, design=design,
            step_grid=step_grid, policy=policy, split=split, configuration=configuration,
            max_output_tokens=lane.max_output_tokens)
        split_scope, _, _, _, _ = _development_population_scope(split.manifest, split.population,
            split.case_aliases, policy, expected_development_sha256=registered["development_split_sha256"],
            manifest_sha256=design.global_split_sha256)
        _need((split_scope["population_sha256"], split_scope["reserved_final_count"])
              == (design.population_sha256, design.reserved_final_count),
              "source prefill differs from registered population or reserved FINAL count")
        _need((lane.configuration_sha256, lane.tokenizer_pipeline_sha256, lane.target_codec, lane.max_sequence_tokens)
              == tuple(registered[key] for key in ("configuration_sha256", "tokenizer_pipeline_sha256",
                                                   "target_codec", "max_sequence_tokens")),
              "source prefill differs from the selected configuration, tokenizer, codec or context window")
        registered_pin = _commit(registered)
        selected = registered_development_source_prefill_commitment(registered_scope_sha256=registered_pin,
            prefill_close_sha256=lane.source_prefill_close_sha256, issuer_source_sha256s=issuer_source_sha256s,
            components=components)
        _need(selected == expected_selection_sha256, "source prefill selection changed or belongs to another lane")
        _need(type(lane.rows) is tuple and all(type(row) is study_owner.DecoderTransportRow for row in lane.rows)
              and tuple((row.row_id, row.unit_id, row.source_wire_sha256, row.source_binding_sha256) for row in lane.rows)
              == tuple((case.row_id, case.unit_id, case.source_wire_sha256, case.source_binding_sha256) for case in policy.cases),
              "source prefill requires the complete ordered registered source roster")
        rows = {row.row_id: row for row in lane.rows}
        original_reports = []
        proof_rows = []
        for component in components:
            scope, report, contexts = component.scope, component.report, component.source_contexts
            _need(component.evidence_kind == registered["evidence_kind"]
                  and set(scope) == {"schema", "geometry", "source_arguments_sha256", "source_contexts_sha256"}
                  and scope["schema"] == DEVELOPMENT_PREFILL_SCHEMA
                  and all(_pin(scope[key]) for key in ("source_arguments_sha256", "source_contexts_sha256"))
                  and _commit(scope) == report.get("scope_sha256")
                  and _commit(report) == component.expected_report_sha256,
                  "source prefill requires matching evidence kind and exact original scope and report")
            geometry = scope["geometry"]
            _need(type(geometry) is dict and set(geometry) == {"route", "configuration_sha256", "tokenizer_pipeline_sha256",
                  "generation_policy", "max_sequence_tokens", "max_source_tokens", "max_output_tokens"}
                  and (geometry["route"], geometry["configuration_sha256"], geometry["tokenizer_pipeline_sha256"],
                       geometry["max_sequence_tokens"], geometry["max_output_tokens"])
                      == (route, lane.configuration_sha256, lane.tokenizer_pipeline_sha256,
                          lane.max_sequence_tokens, lane.max_output_tokens)
                  and type(geometry["max_source_tokens"]) is int and 3 <= geometry["max_source_tokens"] <= 65536
                  and _commit(geometry) == report.get("geometry_sha256"),
                  "source prefill geometry differs from the selected decoder variant")
            if route == QWEN:
                generation = worker._reviewed_decoder_generation_policy(geometry["generation_policy"])
                _need(generation == geometry["generation_policy"]
                      and generation.get("schema") == worker.REVIEWED_DIGEST_OMITTED_TERMINAL_POLICY_SCHEMA
                      and generation.get("conditioning_profile") == worker.REVIEWED_DIGEST_OMITTED_CHATML_PROFILE,
                      "source prefill requires the original Qwen terminal policy and ChatML framing")
            else:
                _need(geometry["generation_policy"] is None, "source prefill requires the original T5 default policy")
            _need(set(contexts) == {"profile", "selection_context", "rows"}
                  and contexts["profile"] == inputs.REVIEWED_DECODER_SOURCE_PROFILE
                  and type(contexts["selection_context"]) is dict
                  and set(contexts["selection_context"]) == {"schema", "interpretation_id", "selection_mode"}
                  and contexts["selection_context"]["schema"] == "caller-known-interpretation-selection/v1"
                  and contexts["selection_context"]["selection_mode"] == "identifier_only"
                  and type(contexts["selection_context"]["interpretation_id"]) is str
                  and bool(contexts["selection_context"]["interpretation_id"])
                  and _sha(inputs._reviewed_wire(contexts)) == scope["source_contexts_sha256"]
                  and type(contexts["rows"]) is list and type(report.get("rows")) is list
                  and 1 <= len(contexts["rows"]) == len(report["rows"]) <= 32,
                  "source prefill requires the original detached source-only contexts")
            for context, observed in zip(contexts["rows"], report["rows"], strict=True):
                _need(type(context) is dict and set(context) == {"id", "unit_id", "governing_context", "source_binding"}
                      and type(context["id"]) is str and context["id"] in rows
                      and type(context["source_binding"]) is dict
                      and set(context["source_binding"]) == {"source_version_cid", "occurrence_cid", "document_revision"}
                      and all(type(value) is str and value for value in context["source_binding"].values())
                      and type(context["governing_context"]) is dict
                      and set(context["governing_context"]) == {"jurisdiction", "instrument_id", "governing_edition",
                                                               "legal_as_of_utc", "valid_from_utc", "valid_until_utc"}
                      and all(type(value) is str and value or key == "valid_until_utc" and value is None
                              for key, value in context["governing_context"].items())
                      and type(observed) is dict, "exact original source-only prefill row and binding required")
                row = rows[context["id"]]
                _need((context["id"], context["unit_id"], _sha(inputs._reviewed_wire(context["source_binding"])),
                        observed.get("id"), observed.get("unit_id"), observed.get("source_wire_sha256"), observed.get("prefill_positions"))
                      == (row.row_id, row.unit_id, row.source_binding_sha256, row.row_id, row.unit_id, row.source_wire_sha256,
                          row.prefill_positions),
                      "prefill positions or source binding differ from the registered occurrence")
                prefill = observed.get("prefill_positions")
                _need(type(prefill) is int and prefill > 0 and (
                      prefill + lane.max_output_tokens - 1 <= lane.max_sequence_tokens if route == QWEN else
                      prefill <= min(geometry["max_source_tokens"], lane.max_sequence_tokens)),
                      "successful source prefill exceeds its original route capacity")
            original_reports.append(report)
            proof_rows.append((report["scope_sha256"], component.expected_report_sha256, report.get("source_receipt_sha256"),
                               scope["source_contexts_sha256"], component.original_close_sha256))
        split_pin = registered["development_split_sha256"]
        digest = _commit((DEVELOPMENT_EXACT_INPUT_SCHEMA, split_pin, registered["evaluation_policy_sha256"],
                          tuple(component.expected_report_sha256 for component in components)))
        # Check the existing complete-roster rules structurally. Actual custody
        # for that roster is authenticated by verify_close below.
        audit = audit_development_exact_inputs(policy, development_split_sha256=split_pin,
            prefills=tuple(original_reports), expected_scope_sha256=digest,
            verify_development_owner=lambda split, scope: (split, scope) == (split_pin, digest))
        return registered_pin, selected, lane.source_prefill_close_sha256, issuer_source_sha256s, tuple(proof_rows), audit["scope_sha256"]

    bound = current()
    _need(verify_close(*bound) is True, "independent source prefill owner refused the original reports and close")
    _need(current() == bound, "source prefill changed during original close verification")
    return True


@dataclass(frozen=True)
class QwenDevelopmentPrefill:
    """A report issued using the selected input encoder and ChatML framer source."""
    report: dict
    expected_report_sha256: str
    issuer_source_sha256s: tuple[tuple[str, str], ...]
    verify_owner: Callable[[str, str, tuple[tuple[str, str], ...]], bool]


def _check_qwen_development_prefill(selected, plan, assessment_sha256, scoring, inputs, consumer, worker, source_pins):
    """Verify a prior same-component tokenizer-only report before checkpoint loading."""
    _need(type(selected) is QwenDevelopmentPrefill and _pin(selected.expected_report_sha256)
          and callable(selected.verify_owner), "independent Qwen2 DEVELOPMENT prefill owner required")
    report, expected, verify = selected.report, selected.expected_report_sha256, selected.verify_owner
    issuer = tuple((name, source_pins[name]) for name in ("inputs", "worker"))
    _need(type(selected.issuer_source_sha256s) is tuple and len(selected.issuer_source_sha256s) == 2
          and all(type(row) is tuple and len(row) == 2 and type(row[0]) is str and _pin(row[1])
                  for row in selected.issuer_source_sha256s)
          and selected.issuer_source_sha256s == issuer,
          "Qwen2 tokenizer-only report issuer differs from the selected input and worker sources")

    def bound_source_receipt():
        arguments = [{"id": row["id"], "source_text": row["source_text"],
                      "context": {"permitted": [], "retrieved": []}} for row in inputs["rows"]]
        scope = _development_prefill_scope(consumer._preflight, worker, route=QWEN,
            configuration=inputs["configuration"], generation_policy=inputs["generation_policy"],
            source_arguments=arguments, source_contexts_sha256=inputs["expected_source_contexts_sha256"],
            max_source_tokens=inputs["max_source_tokens"], max_output_tokens=inputs["max_output_tokens"])
        cases = tuple(case for case in scoring.policy.cases if case.dependency_group_sha256 == plan.dependency_group_sha256)
        _need(type(report) is dict and set(report) == {
            "schema", "scope_sha256", "geometry_sha256", "source_receipt_sha256", "rows"}
            and report["schema"] == DEVELOPMENT_PREFILL_SCHEMA and report["scope_sha256"] == _commit(scope)
            and report["geometry_sha256"] == _commit(scope["geometry"]) and _pin(report["source_receipt_sha256"])
            and type(report["rows"]) is list and 1 <= len(report["rows"]) == len(cases) <= 32,
            "Qwen2 prefill report differs from the selected source arguments, context or geometry")
        _need(all(type(row) is dict and set(row) == {
                      "id", "unit_id", "source_wire_sha256", "prefill_sha256", "prefill_positions"}
                  and (row["id"], row["unit_id"], row["source_wire_sha256"]) ==
                      (case.row_id, case.unit_id, case.source_wire_sha256)
                  and _pin(row["prefill_sha256"]) and type(row["prefill_positions"]) is int
                  and 1 <= row["prefill_positions"] <= 262144
                  for row, case in zip(report["rows"], cases, strict=True))
              and _commit(report) == expected,
              "Qwen2 prefill report differs from the ordered DEVELOPMENT source roster or selected digest")
        return report["source_receipt_sha256"], scope["geometry"]["max_sequence_tokens"]

    before = bound_source_receipt()
    # The verifier must authenticate original issuance under both source digests.
    _need(verify(assessment_sha256, expected, issuer) is True,
          "Qwen2 prefill owner refused the selected report and issuer sources")
    _need(selected.report is report and selected.expected_report_sha256 == expected
          and selected.issuer_source_sha256s == issuer and selected.verify_owner is verify
          and tuple((name, source_pins[name]) for name, _ in issuer) == issuer
          and bound_source_receipt() == before,
          "selected Qwen2 prefill changed during owner verification")
    source_receipt, window = before
    _need(all(row["prefill_positions"] + inputs["max_output_tokens"] - 1 <= window for row in report["rows"]),
          "complete Qwen2 prefill and reserved output exceed the selected model window")
    return source_receipt


def evaluate(selection, *, plan, expected_assessment_sha256, worker_receipt,
             expected_worker_receipt_sha256, candidate_manifest, terminal_close,
             expected_terminal_close_sha256, verify_owner_close, execution_guard, asset_policy_guard,
             registry, current_admission_provider, assets, max_model_bytes, inputs, development_scoring=None,
             step_grid=None, study_owner=None, scheduled_checkpoint_evidence=None,
             t5_fusion_train_batch=None, t5_fusion_development_batch=None, fused_proof_pair=None, development_output_capacity=None,
             qwen_development_prefill=None):
    """Evaluate a closed candidate and recheck the original fused proof when supplied."""
    return _evaluate(selection, plan=plan, expected_assessment_sha256=expected_assessment_sha256,
        worker_receipt=worker_receipt, expected_worker_receipt_sha256=expected_worker_receipt_sha256,
        candidate_manifest=candidate_manifest, terminal_close=terminal_close,
        expected_terminal_close_sha256=expected_terminal_close_sha256, verify_owner_close=verify_owner_close,
        execution_guard=execution_guard, asset_policy_guard=asset_policy_guard, registry=registry,
        current_admission_provider=current_admission_provider, assets=assets, max_model_bytes=max_model_bytes,
        inputs=inputs, development_scoring=development_scoring, step_grid=step_grid, study_owner=study_owner,
        scheduled_checkpoint_evidence=scheduled_checkpoint_evidence, t5_fusion_train_batch=t5_fusion_train_batch,
        t5_fusion_development_batch=t5_fusion_development_batch, fused_proof_pair=fused_proof_pair,
        development_output_capacity=development_output_capacity, qwen_development_prefill=qwen_development_prefill)


def _evaluate(selection, *, plan, expected_assessment_sha256, worker_receipt,
              expected_worker_receipt_sha256, candidate_manifest, terminal_close,
              expected_terminal_close_sha256, verify_owner_close, execution_guard, asset_policy_guard,
              registry, current_admission_provider, assets, max_model_bytes, inputs, development_scoring=None,
              step_grid=None, study_owner=None, scheduled_checkpoint_evidence=None, _frozen_choice=None,
              t5_fusion_train_batch=None, t5_fusion_development_batch=None, fused_proof_pair=None,
              _t5_fusion_final_batch=None, _t5_fusion_final_binding=None, development_output_capacity=None,
              qwen_development_prefill=None):
    """Load one exact trial pair and delegate assessment to its existing owners.

    Run in the existing isolated evaluation owner. The returned artifact is
    a structural observation and needs its own terminal, legal and cost evidence.
    """
    from . import autoencoder_training_worker as worker, legal_span_consumer_binding as consumer

    _need(_pin(expected_assessment_sha256) and commitment(plan) == expected_assessment_sha256
          and callable(execution_guard), "independently selected assessment owner guard required")
    native_development = _validation_assessment(plan)
    _need(qwen_development_prefill is None or (native_development and plan.route == QWEN),
          "Qwen2 prefill requires the source-only DEVELOPMENT assessment route")
    policy_validation = _span_validation_assessment(plan)
    guided = type(plan) is GuidedSpanValidationAssessment
    fused_final = type(plan) is T5FusionSpanFinalAssessment
    fused_development = type(plan) is T5FusionSpanValidationAssessment
    fused = fused_final or fused_development
    _need(fused or fused_proof_pair is None, "original fused proof pair requires a fused policy assessment")
    final_values = (_t5_fusion_final_batch, _t5_fusion_final_binding)
    inference_batch = _t5_fusion_final_batch if fused_final else t5_fusion_development_batch
    _need(fused_development == (t5_fusion_development_batch is not None)
          and fused_final == any(value is not None for value in final_values)
          and (not fused_final or all(value is not None for value in final_values))
          and fused == (t5_fusion_train_batch is not None)
          and (not fused or _frozen_choice is None)
          and fused == (type(selection) is T5FusionDecisionSpanPolicyAttempt),
          "fused T5 requires its exact authorized FINAL assessment and two selected batches" if fused_final else
          "fused T5 requires its exact typed DEVELOPMENT assessment and two selected batches")
    _need(native_development == (development_scoring is not None),
          "native development scoring requires its explicit frozen population")
    _scheduled_optimizer_step(plan, step_grid, study_owner)

    def checkpoint_scope():
        if _frozen_choice is not None:
            _need(type(_frozen_choice) is FinalScoring and type(plan) is Assessment and plan.look == "final",
                  "frozen scheduled evidence requires the final scoring route")
            frozen = _frozen_choice.checkpoint
            identity = _frozen_checkpoint_identity(frozen)
            if identity is not None:
                return (_scheduled_checkpoint_pins(identity), frozen["confirming_look"],
                        _frozen_optimizer_step(frozen), frozen["optimizer_step_grid_sha256"])
        if type(plan) is RetrospectiveDevelopmentAssessment:
            return (_scheduled_checkpoint_pins(plan.scheduled_checkpoint), plan.look,
                    plan.optimizer_steps, plan.optimizer_step_grid_sha256)
        return None

    scheduled_scope = checkpoint_scope()
    _need((scheduled_checkpoint_evidence is None if scheduled_scope is None else
           type(scheduled_checkpoint_evidence) is ScheduledCheckpointEvidence),
          "only retrospective development or frozen final scoring may use typed scheduled checkpoint evidence")
    operation = VALIDATION_OPERATION if native_development else "heldout_evaluation"
    execution_guard(expected_assessment_sha256)
    def validation_component():
        if policy_validation:
            resolved = _decision_span_validation_scope(plan, selection, development_scoring)
            return _validate_development_component(plan, inputs, development_scoring.policy, resolved)
        return _native_development_inputs(plan, selection, inputs, development_scoring)

    development_evidence = validation_component() if native_development else None
    if policy_validation:
        _verify_decision_span_validation_owner(plan, selection, development_scoring)
        _need(commitment(plan) == expected_assessment_sha256 and validation_component() == development_evidence,
              "selected policy validation inputs changed during TRAIN and split verification")
    candidate_arguments = dict(worker_receipt=worker_receipt,
        expected_worker_receipt_sha256=expected_worker_receipt_sha256, candidate_manifest=candidate_manifest,
        terminal_close=terminal_close, expected_terminal_close_sha256=expected_terminal_close_sha256,
        verify_owner_close=verify_owner_close)
    policy_assessment = _policy_assessment(plan)
    span_assessment = policy_assessment and (guided or plan.arm in DECISION_SPAN_POLICY_ARMS)
    if policy_assessment:
        _need(span_assessment == (type(selection) in (DecisionSpanPolicyAttempt, GuidedDecisionSpanPolicyAttempt,
                                                     T5FusionDecisionSpanPolicyAttempt))
              and (not span_assessment or type(selection) is _span_attempt_type(plan)),
              "decision span assessment requires its exact typed candidate attempt")
        link = bind_policy_candidate(selection, expected_policy_attempt_sha256=plan.policy_attempt_sha256,
                                     **candidate_arguments, **_fused_assessment_proof_options(fused_proof_pair))
        if span_assessment:
            _need(_decision_span_policy_link(link, guided=guided, fused=fused) and _span_binding(link, guided)["architecture"] ==
                  ("encoder_decoder" if plan.route == T5 else "causal_lm")
                  and (not guided or _guided_link_matches_attempt(link, selection)),
                  "decision span assessment requires its exact bound candidate and architecture")
            if fused:
                _require_fused_link_attempt(link, selection)
        elif plan.route == T5:
            _need(_t5_policy_link(link), "T5 assessment requires the bound full-target policy candidate")
        else:
            _need("t5_scoped_forward_binding" not in link, "scoped T5 forward evidence requires the T5 policy route")
    elif scheduled_scope is None:
        link = bind_candidate(selection, **candidate_arguments)
    else:
        from .relational_trial import bind_scheduled_candidate

        pins, bound_look, bound_step, bound_grid = scheduled_scope
        evidence = scheduled_checkpoint_evidence
        link = bind_scheduled_candidate(selection, **candidate_arguments, development=evidence.development,
            terminal_candidate_manifest=evidence.terminal_candidate_manifest, scheduled_close=evidence.scheduled_close,
            expected_scheduled_close_sha256=pins["checkpoint_close_sha256"], verify_scheduled_close=evidence.verify_scheduled_close)
        schedule_selection = selection if evidence.development is None else evidence.development
        _need((link["schedule_sha256"], link["scheduled_checkpoint_close_sha256"],
               link["scheduled_checkpoint_owner_stage_record_sha256"], link["look"],
               link["optimizer_step"], link["step_grid_sha256"]) == (pins["schedule_sha256"],
               pins["checkpoint_close_sha256"], pins["owner_stage_record_sha256"], bound_look,
               bound_step, bound_grid) and checkpoint_scope() == scheduled_scope
              and (_frozen_choice is None or schedule_selection.schedule.development_design_sha256
                   == _frozen_choice.checkpoint["development_design_sha256"]),
              "retrospective assessment does not bind the exact scheduled checkpoint, look and optimizer step")
    archived_capture = _archived_capture_metadata(link)
    _need(archived_capture is None or scheduled_scope is not None,
          "archived capture requires a verified scheduled checkpoint")
    if _frozen_choice is not None:
        frozen_capture = _archived_capture_metadata(_frozen_choice.checkpoint)
        _need(frozen_capture is None or archived_capture == frozen_capture,
              "verified archived capture differs from the frozen final checkpoint")
        # Earlier freezes committed only the scheduled checkpoint identity.
        archived_capture = frozen_capture
    _need((plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256, plan.candidate_sha256,
           plan.trial_terminal_close_sha256) ==
          (link["study_sha256"], link["arm"], link["seed"], link["attempt_sha256"], link["candidate"]["sha256"],
           link["terminal_close_sha256"]), "assessment does not select this exact closed trial and attempt")
    checkpoint = _evidence_json(candidate_manifest, 2 * 1024**2)
    source_pins = checkpoint.get("producer_pins")
    identity = checkpoint.get("backend_identity")
    held_assets = checkpoint.get("assets")
    underlying = checkpoint.get("underlying_checkpoint_schema")
    step_count = checkpoint["progress"]["optimizer_steps"]
    if _scheduled_development_plan(plan) or policy_validation or fused_final:
        _need(type(step_count) is int and step_count == plan.optimizer_steps,
              "closed candidate did not reach the exact scheduled optimizer step")
    _need(type(source_pins) is dict and set(source_pins) == {"worker","inputs","consumer","admission","splits"}
          and all(_pin(value) for value in source_pins.values()) and type(identity) is dict
          and _pin(identity.get("implementation_sha256")) and identity["implementation_sha256"] == source_pins["worker"]
          and type(identity.get("backend_id")) is str and type(step_count) is int and step_count > 0
          and type(held_assets) is list and all(_artifact(item) for item in held_assets)
          and _assets_commit(worker, assets, max_model_bytes) == plan.expected_assets_sha256
          and all(asdict(item) in held_assets for item in assets.values()),
          "selected local assets, backend implementation or source epoch do not bind the candidate")
    fused_binding = None
    if fused:
        from . import teacher_prefix

        inference_batch_pin = teacher_prefix.batch_commit(inference_batch)
        if fused_final:
            fused_binding = _t5_fusion_final_binding
            _need(fused_binding["final_batch_sha256"] == inference_batch_pin,
                  "authorized FINAL teacher batch differs from its prepared role")
            _require_t5_fusion_final_role(plan, link, fused_binding)
        else:
            fused_binding = bind_t5_fusion_development(t5_fusion_train_batch, inference_batch,
                teacher_prefix=teacher_prefix, expected_train_batch_sha256=selection.candidate_batch_sha256,
                expected_development_batch_sha256=inference_batch_pin,
                expected_configuration_sha256=selection.configuration_sha256,
                expected_model_checkpoint_sha256=link["model_checkpoint"]["sha256"])
            fused_binding.update(candidate_manifest_sha256=link["candidate"]["sha256"],
                trial_terminal_close_sha256=link["terminal_close_sha256"], policy_candidate_sha256=_commit(link))
            _require_t5_fusion_assessment_role(plan, link, fused_binding)
        _need(tuple(fused_binding["row_ids"]) == tuple(row["id"] for row in inputs["rows"]),
              "fused teacher binding differs from the ordered held-out row roster")

    def selected_inputs():
        if fused:
            _need(teacher_prefix.batch_commit(t5_fusion_train_batch) == selection.candidate_batch_sha256
                  and teacher_prefix.batch_commit(inference_batch) == inference_batch_pin
                  and _commit(fused_binding) == plan.t5_fusion_assessment_binding_sha256,
                  "fused teacher batches changed during evaluation")
        _need((not native_development or commitment(plan) == expected_assessment_sha256)
              and _inputs_commit(inputs, consumer, plan) == plan.expected_inputs_sha256
              and _assets_commit(worker, assets, max_model_bytes) == plan.expected_assets_sha256,
              "frozen assessment inputs or local load assets changed")
        _scheduled_optimizer_step(plan, step_grid, study_owner)
        if fused:
            _require_current_fused_assessment_proof(selection, plan.policy_attempt_sha256, fused_proof_pair,
                                                    terminal_close, plan.trial_terminal_close_sha256)
    def current():
        execution_guard(expected_assessment_sha256)
        if policy_assessment:
            _need(commitment(plan) == expected_assessment_sha256,
                  "policy assessment selection changed during evaluation")
        _scheduled_optimizer_step(plan, step_grid, study_owner)
        if scheduled_scope is not None:
            _need(checkpoint_scope() == scheduled_scope, "scheduled checkpoint assessment changed during evaluation")
        if native_development:
            _need(validation_component() == development_evidence,
                  "native development population changed during evaluation")
        if fused:
            _require_current_fused_assessment_proof(selection, plan.policy_attempt_sha256, fused_proof_pair,
                                                    terminal_close, plan.trial_terminal_close_sha256)

    selected_inputs()
    family = ("causal_lm", "qwen2") if plan.route == QWEN else ("encoder_decoder", "t5")
    configuration = inputs["configuration"]
    selected_configuration = link["configuration_sha256"] if policy_assessment else selection.trial.configuration_sha256
    _need(type(configuration) is dict and type(configuration.get("model_config")) is dict
          and _commit(configuration) == selected_configuration
          and (configuration.get("architecture"), configuration["model_config"].get("model_type")) == family,
          "selected trial configuration has a different model family")
    if span_assessment:
        tokenizer = configuration.get("tokenizer")
        _need(type(tokenizer) is dict and tokenizer.get("pipeline_sha256") ==
              _span_binding(link, guided)["tokenizer_sha256"],
              "decision span assessment tokenizer differs from the selected policy cohort")
    cache_reference = None
    if plan.route == QWEN:
        _need(identity.get("target_codec") == worker.REVIEWED_DIGEST_OMITTED_TARGET_CODEC
              and underlying in (worker.REVIEWED_DIGEST_OMITTED_CHECKPOINT_SCHEMA,
                                 worker.REVIEWED_DIGEST_CACHE_EPOCH_CHECKPOINT_SCHEMA)
              and worker._reviewed_decoder_generation_policy(inputs["generation_policy"])["schema"] ==
                  worker.REVIEWED_DIGEST_OMITTED_TERMINAL_POLICY_SCHEMA,
              "Qwen2 requires the exact digest-omitted terminal source-only lane")
        loader = worker.load_local_reviewed_decoder_digest_omitted_runtime_v1
        factory = worker.make_reviewed_decoder_digest_omitted_source_producer_v1
        if underlying == worker.REVIEWED_DIGEST_CACHE_EPOCH_CHECKPOINT_SCHEMA:
            raw_cache = checkpoint.get("cache_source_epoch_migration")
            receipt = _evidence_json(worker_receipt, 8 * 1024**2)
            _need(_artifact(raw_cache) and raw_cache == receipt.get("cache_source_epoch_migration"),
                  "marked trial requires the same authenticated cache origin in both receipts")
            cache_reference = worker.CheckpointArtifact.from_dict(raw_cache)
    else:
        _need(identity.get("target_codec") == FULL_CODEC and inputs["generation_policy"] is None
              and underlying in (worker.REVIEWED_DECODER_CHECKPOINT_SCHEMA,
                                 worker.REVIEWED_DECODER_CONTINUATION_CHECKPOINT_SCHEMA,
                                 worker.REVIEWED_DECODER_SOURCE_EPOCH_CHECKPOINT_SCHEMA),
              "T5 requires full-target source-only generation in its own existing lane")
        if plan.admission_version == "v3":
            loader, factory = worker.load_local_reviewed_decoder_runtime_v3, worker.make_reviewed_decoder_source_producer_v3
        else:
            loader, factory = worker.load_local_reviewed_decoder_runtime, worker.make_reviewed_decoder_source_producer
    if cache_reference is None:
        _need("cache_source_epoch_migration" not in checkpoint and "cache_epoch_parent_checkpoint_artifact" not in checkpoint,
              "unmarked lane cannot discard an origin marker")
    model, optimizer = (worker.CheckpointArtifact.from_dict(link[key])
                        for key in ("model_checkpoint", "optimizer_checkpoint"))
    load_options = {"admission_profile":worker.REVIEWED_MIXED_ADMISSION_PROFILE} if plan.admission_version == "v3" else {}
    if cache_reference is not None:
        load_options["cache_source_epoch_migration"] = cache_reference
    current()
    if native_development:
        replayed = consumer.validate_reviewed_source_span_consumer_binding_v3(
            inputs["binding"], inputs["rows"], split_manifest=inputs["split_manifest"],
            admission_inputs=current_admission_provider(), exposure_records=inputs["exposure_records"])
        _need(replayed == inputs["binding"].receipt() and replayed.get("status") == "ready"
              and replayed.get("operation") == VALIDATION_OPERATION
              and replayed.get("admission_inputs_sha256") == inputs["expected_admission_inputs_sha256"],
              "current V3 development admission must close before checkpoint loading")
        selected_inputs()
    if development_output_capacity is not None:
        _check_development_output_capacity(development_output_capacity, plan, expected_assessment_sha256,
            development_scoring, configuration, inputs["max_output_tokens"])
        current()
        selected_inputs()
    expected_source_receipt = None
    if qwen_development_prefill is not None:
        expected_source_receipt = _check_qwen_development_prefill(qwen_development_prefill, plan,
            expected_assessment_sha256, development_scoring, inputs, consumer, worker, source_pins)
        current()
        selected_inputs()
    runtime, load = loader(registry=registry, current_admission_provider=current_admission_provider,
        execution_guard=current, asset_policy_guard=asset_policy_guard, **assets, model_checkpoint=model,
        optimizer_checkpoint=optimizer, expected_backend_identity=identity, expected_source_sha256=source_pins,
        expected_admission_inputs_sha256=inputs["expected_admission_inputs_sha256"], max_model_bytes=max_model_bytes,
        runtime_profile="builtin-qwen2-bfloat16/v1" if plan.route == QWEN else "builtin-t5-gpt2-float32/v1", **load_options)
    _need(type(runtime) is worker.ReviewedDecoderRuntime and runtime.relational_trial is None
          and type(runtime.backend) is worker.TorchReviewedDecoderBackend and type(load) is dict
          and load.get("checkpoint_restored") is True and load.get("matched_pair") is True
          and load.get("training_performed") is False and type(load.get("optimizer_steps")) is int
          and load["optimizer_steps"] == runtime.backend._optimizer_steps == step_count
          and load.get("loaded_backend_identity") == runtime.backend.identity() == identity
          and load.get("producer_pins") == source_pins
          and type(load.get("artifacts")) is list and load["artifacts"][-2:] == [asdict(model),asdict(optimizer)],
          "existing numeric loader did not close with the selected exact optimizer/model pair and progress")
    loaded_configuration = runtime.backend._configuration()
    if policy_assessment and (plan.route == T5 or span_assessment):
        # The archived configuration wire JSON-normalizes native label keys and AdamW beta tuples.
        configuration_matches = _commit(loaded_configuration) == selected_configuration
    else:
        configuration_matches = loaded_configuration == configuration
    _need(configuration_matches and runtime.backend.architecture == family[0],
          "loaded decoder family, configuration or tokenizer differs from selected trial")
    selected_inputs()
    current()
    kwargs = {name:inputs[name] for name in INPUT_ROLES - {"compiler_commit","encoder","generation_policy","configuration"}}
    if plan.route == QWEN:
        kwargs["generation_policy"] = inputs["generation_policy"]
    if fused:
        kwargs.update(teacher_prefix_batch=inference_batch, expected_teacher_batch_sha256=inference_batch_pin,
                      t5_fusion_assessment_binding=fused_binding,
                      expected_t5_fusion_assessment_binding_sha256=plan.t5_fusion_assessment_binding_sha256)
    producer = factory(runtime, **kwargs, backend_identity=identity,
        assets=tuple(worker.CheckpointArtifact.from_dict(item) for item in held_assets), model_checkpoint=model,
        optimizer_checkpoint=optimizer, allow_heldout_evaluation=not native_development)
    selected_inputs()
    current()
    artifact = producer.evaluate(compiler_commit=inputs["compiler_commit"], checkpoint_declarations={
        "encoder":inputs["encoder"], "decoder":{"id":identity["backend_id"], "sha256":model.sha256}})
    selected_inputs()
    current()
    saved = artifact.to_dict()
    detail = _closed_observation(saved, inputs=inputs, checkpoint=plan.candidate_sha256,
        model=link["model_checkpoint"], optimizer=link["optimizer_checkpoint"],
        expected_identity=identity, source_pins=source_pins, operation=operation)
    if expected_source_receipt is not None:
        source_receipt = saved["metadata"]["source_generation_observation"]["last_call"]["input_receipt"]
        _need(_sha(consumer._preflight(source_receipt)) == expected_source_receipt,
              "actual Qwen2 source preparation differs from the selected tokenizer-only receipt")
    if fused:
        teacher_observation = _t5_fusion_inference_observation(saved, binding=fused_binding,
            expected_binding=plan.t5_fusion_assessment_binding_sha256, model_sha256=model.sha256,
            partition="final" if fused_final else "development")
        detail.update(t5_fusion_assessment_binding_sha256=plan.t5_fusion_assessment_binding_sha256,
            matched_teacher_inputs_sha256=plan.matched_teacher_inputs_sha256,
            t5_fusion_observation_sha256=teacher_observation)
    if native_development:
        detail.update(operation=operation, development_scoring=development_evidence)
    if _scheduled_development_plan(plan) or policy_validation:
        detail["optimizer_step_grid_sha256"] = plan.optimizer_step_grid_sha256
    if scheduled_scope is not None:
        detail["scheduled_checkpoint"] = scheduled_scope[0]
    if archived_capture is not None:
        detail["archived_capture"] = archived_capture
    if policy_assessment:
        detail["policy_candidate_sha256"] = _commit(link)
    schema = DEVELOPMENT_OBSERVATION_SCHEMA if native_development else OBSERVATION_SCHEMA
    return artifact, {**detail, "schema":schema,
        "assessment_sha256":expected_assessment_sha256, "route":plan.route, "study_sha256":plan.study_sha256,
        "arm":plan.arm, "seed":plan.seed, "attempt_sha256":plan.attempt_sha256, "look":plan.look,
        "trial_terminal_close_sha256":plan.trial_terminal_close_sha256, "panel_sha256":plan.panel_sha256,
        "evaluation_policy_sha256":plan.evaluation_policy_sha256,
        "retention_reference_sha256":plan.retention_reference_sha256, "loader_receipt_sha256":_commit(load),
        "optimizer_steps":step_count, "source_fidelity_proved":False, "formal_validity_proved":False,
        "actual_evaluation_owner_close_required":True, "whole_arm_cost_required":True}


GATE_SCHEMA = "reviewed-relational-heldout-threshold-look/v1"
COMPONENT_SCHEMA = "reviewed-single-component-heldout/v1"
OBSERVATION_SCHEMA = "reviewed-relational-heldout-source-observation/v1"
MODEL_OUTCOMES = ("complete", "invalid", "incomplete", "abstained")
FIDELITY_STATES = ("faithful", "unfaithful", "unresolved", "unavailable", "error")
FORMAL_STATES = ("proved", "invalid", "unavailable", "timeout", "error")


@dataclass(frozen=True)
class HeldoutCase:
    row_id: str
    unit_id: str
    dependency_group_sha256: str
    language: str
    split_sha256: str
    source_wire_sha256: str
    source_binding_sha256: str
    reference_sha256: str
    review_eligible: bool
    formal_required: bool


@dataclass(frozen=True)
class GatePolicy:
    review_policy_sha256: str
    formal_policy_sha256: str
    response_policy_sha256: str
    cases: tuple[HeldoutCase, ...]


@dataclass(frozen=True)
class RetentionReference:
    seed: str
    panel_sha256: str
    evaluation_policy_sha256: str
    baseline_checkpoint_sha256: str
    baseline_receipt_sha256: str
    row_fidelity: tuple[tuple[str, bool | None], ...]


@dataclass(frozen=True)
class ComponentClose:
    observation_sha256: str
    artifact_sha256: str
    owner_close_sha256: str


@dataclass(frozen=True)
class RowReview:
    row_id: str
    generation_sha256: str
    candidate_sha256: str | None
    response: str
    response_receipt_sha256: str
    fidelity: str = "unavailable"
    fidelity_receipt_sha256: str | None = None
    formal: str = "unavailable"
    formal_receipt_sha256: str | None = None
    obligation_sha256: str | None = None
    toolchain_sha256: str | None = None


@dataclass(frozen=True)
class GateReview:
    study_sha256: str
    arm: str
    seed: str
    recipe_sha256: str
    components: tuple[ComponentClose, ...]
    rows: tuple[RowReview, ...]


@dataclass(frozen=True)
class PreparedGateLook:
    look: str
    checkpoint_sha256: str
    evaluation_receipt_sha256: str
    panel_sha256: str
    evaluation_policy_sha256: str
    retention_reference_sha256: str
    study_sha256: str
    attempt_sha256: str
    cost_policy_sha256: str
    gates: dict


@dataclass(frozen=True)
class T5FusionPreparedGateLook(PreparedGateLook):
    """A reviewed look awaiting the whole-arm fusion work and meter join."""

    component_bindings_sha256: str


def gate_policy_commitment(policy):
    return _commit((GATE_SCHEMA, "policy", asdict(policy)))


def retention_commitment(reference):
    return _commit((GATE_SCHEMA, "baseline-retention", asdict(reference)))


def review_commitment(review):
    return _commit((GATE_SCHEMA, "independent-review", asdict(review)))


def _policy_groups(policy):
    _need(type(policy) is GatePolicy and type(policy.cases) is tuple and bool(policy.cases)
          and all(_pin(value) for value in (policy.review_policy_sha256, policy.formal_policy_sha256,
                                           policy.response_policy_sha256))
          and policy.review_policy_sha256 != policy.formal_policy_sha256,
          "closed source review, formal verifier and response policies required")
    groups, roster, seen = {}, [], set()
    for case in policy.cases:
        _need(type(case) is HeldoutCase and type(case.row_id) is str and bool(case.row_id)
              and case.row_id not in seen and type(case.language) is str and bool(case.language)
              and type(case.unit_id) is str and bool(case.unit_id)
              and all(_pin(value) for value in (case.dependency_group_sha256, case.split_sha256,
                        case.source_wire_sha256, case.source_binding_sha256, case.reference_sha256))
              and type(case.review_eligible) is type(case.formal_required) is bool,
              "independently frozen held-out case identity and eligibility required")
        seen.add(case.row_id)
        groups.setdefault(case.dependency_group_sha256, []).append(case)
        roster.append((case.row_id, case.dependency_group_sha256, case.language))
    return groups, tuple(roster)


def _heldout_groups(policy, study):
    groups, roster = _policy_groups(policy)
    _need(roster == study.panel and gate_policy_commitment(policy) == study.evaluation_policy_sha256,
          "exact held-out split population and frozen gate eligibility required")
    return groups


def _closed_component(observation, saved, close, cases, group_sha256, *, development=None, final_scope=None,
                      fused_validation=False, fused_final=False):
    _need(development is None or final_scope is None, "one selected evaluation role required")
    expected_schema = OBSERVATION_SCHEMA if development is None else DEVELOPMENT_OBSERVATION_SCHEMA
    if final_scope is not None:
        expected_schema = T5_FUSION_FINAL_OBSERVATION_SCHEMA if fused_final else FINAL_OBSERVATION_SCHEMA
    _need(type(observation) is dict and observation.get("schema") == expected_schema
          and ("scheduled_checkpoint" not in observation or development is not None or final_scope is not None)
          and (_archived_capture_metadata(observation) is None or ("scheduled_checkpoint" in observation
              and (development is not None or final_scope is not None)))
          and observation.get("source_fidelity_proved") is False
          and observation.get("formal_validity_proved") is False
          and observation.get("actual_evaluation_owner_close_required") is True
          and type(saved) is dict and _commit(observation) == close.observation_sha256
          and _commit(saved) == close.artifact_sha256 == observation.get("saved_artifact_sha256"),
          "exact closed structural assessment and full saved artifact required")
    payload = saved.get("compiler_artifact", {}).get("reviewed_source_span_producer_evaluation", {})
    config = payload.get("configuration", {})
    operation = "heldout_evaluation"
    units = [None] * len(cases)
    if development is None:
        held = config.get("heldout_evaluation", {})
        group = held.get("dependency_group") if type(held) is dict else None
        _need(config.get("profile") == "reviewed-source-span-producer-heldout/v1"
              and config.get("operation") == operation
              and type(group) is dict and held.get("schema") == COMPONENT_SCHEMA and held.get("partition") == "holdout"
              and held.get("dependency_group_sha256") == _commit(group) == group_sha256
              and all(held.get("split_manifest_sha256") == case.split_sha256 for case in cases),
              "selected held-out component, split or structural authority differs")
        units = group.get("source_units")
        if final_scope is not None:
            before = payload.get("admission_before")
            _need(observation.get("final_scope") == final_scope and type(before) is dict
                  and before == payload.get("admission_after")
                  and before.get("heldout_evaluation") == payload.get("heldout_evaluation") == held
                  and before.get("schema") == "reviewed-source-span-consumer-binding/v3"
                  and before.get("profile") == "complete-reviewed-mixed-sort-source-span-supervision/v3"
                  and before.get("status") == "ready" and before.get("operation") == "heldout_evaluation"
                  and type(before.get("input_sha256s")) is dict
                  and before["input_sha256s"].get("split_manifest") == final_scope["component_split_sha256"]
                  and config.get("input_sha256s") == before["input_sha256s"]
                  and config.get("admission_before_sha256") == config.get("admission_after_sha256") == _commit(before)
                  and _pin(before.get("admission_inputs_sha256"))
                  and held.get("purpose") == "frozen-single-component-final-scoring/v1"
                  and held.get("population_scope") == "exact_complete_admitted_component_only"
                  and held.get("inference_context_profile") == "declared_source_only_empty_retrieval_context"
                  and held.get("training_example_ids") == [] and held.get("retrieved_example_ids") == [],
                  "saved final component does not retain its exact source-only V3 admission")
    else:
        operation = VALIDATION_OPERATION
        expected = _development_component_receipt(development, group_sha256, cases)
        _need(observation.get("operation") == operation and observation.get("development_scoring") == expected
              and config.get("operation") == operation and config.get("profile") == VALIDATION_PROFILE
              and config.get("heldout_evaluation") is None and payload.get("heldout_evaluation") is None
              and config.get("input_sha256s", {}).get("split_manifest") == expected["component_split_sha256"],
              "native development component or validation manifest differs")
        _native_validation_receipts(payload, expected["component_split_sha256"])
    _need(type(payload.get("producer_callback_count")) is int and payload["producer_callback_count"] == 1
          and payload.get("producer_exception_type") is None
          and all(payload.get(key) is False for key in (
                "source_fidelity_proved", "semantic_equivalence_proved", "native_proof_verified")),
          "selected held-out component, split or structural authority differs")

    produced = saved.get("metadata", {}).get("source_generation_observation", {})
    call = produced.get("last_call", {})
    source = call.get("input_receipt", {})
    declaration = produced.get("input_commitment", {})
    pair = (declaration.get("model_checkpoint"), declaration.get("optimizer_checkpoint"))
    fusion_declared = (bool({"t5_fusion_assessment_binding", "t5_fusion_assessment_binding_sha256"}.intersection(declaration))
                       or bool({"t5_fusion_observation", "t5_fusion_source_roster"}.intersection(call))
                       or bool({"t5_fusion_assessment_binding_sha256", "matched_teacher_inputs_sha256",
                                "t5_fusion_observation_sha256"}.intersection(observation)))
    _need(not (fused_validation and fused_final) and (fused_validation or fused_final) == fusion_declared
          and (not fused_validation or development is not None and final_scope is None)
          and (not fused_final or final_scope is not None and development is None),
          "fused T5 components require an explicit matching evaluation route" if fused_final else
          "fused T5 components require their explicit DEVELOPMENT evaluation route")
    if fused_validation or fused_final:
        binding = declaration.get("t5_fusion_assessment_binding")
        _need(type(binding) is dict and _artifact(pair[0])
              and binding.get("matched_inputs_sha256") == observation.get("matched_teacher_inputs_sha256"),
              "fused T5 component did not preserve its selected teacher condition")
        teacher_observation = _t5_fusion_inference_observation(saved, binding=binding,
            expected_binding=observation["t5_fusion_assessment_binding_sha256"], model_sha256=pair[0]["sha256"],
            partition="final" if fused_final else "development")
        _need(teacher_observation == observation.get("t5_fusion_observation_sha256"),
              "fused T5 component differs from its retained actual observation")
    _need(type(produced.get("calls")) is int and produced["calls"] == 1 and all(call.get(key) is True for key in (
              "completed", "entry_pair_match", "exit_pair_match"))
          and call.get("exception_type") is None and call.get("closeout_exception_type") is None
          and declaration.get("operation") == operation and declaration.get("training_requested") is False
          and declaration.get("supplied_context_supported") == "empty_permitted_and_retrieved_only"
          and produced.get("input_commitment_sha256") == _commit(declaration)
          == saved["metadata"].get("source_generation_input_commitment_sha256")
          == observation.get("producer_commitment_sha256") and _pin(observation.get("producer_commitment_sha256"))
          and _pin(observation.get("source_records_sha256")) and call.get("source_records_sha256")
            == source.get("prepared_records_sha256") == observation.get("source_records_sha256")
          and source.get("schema") == "reviewed-decoder-generation-input-receipt/v1"
          and source.get("profile") == "source-only-reviewed-decoder-generation-inputs/v1"
          and type(source.get("record_count")) is int and source["record_count"] == len(cases)
          and _pin(declaration.get("source_contexts_sha256"))
          and source.get("source_contexts_sha256") == declaration["source_contexts_sha256"]
          and source.get("target_access_performed") is False and all(_artifact(item) for item in pair)
          and type(declaration.get("backend_identity")) is dict and bool(declaration["backend_identity"]),
          "saved source-only call did not retain exact producer and checkpoint custody")
    if final_scope is not None:
        _need(declaration.get("admission_inputs_sha256") == before["admission_inputs_sha256"],
              "saved final producer admission differs from the verified V3 receipt")

    refs, outputs = payload.get("reference_population"), payload.get("producer_outputs")
    arguments = payload.get("producer_arguments")
    raw, wires = call.get("raw_generation_outputs"), source.get("row_commitments")
    _need(all(type(value) is list and len(value) == len(cases) for value in (refs, outputs, raw, wires, units, arguments))
          and config.get("producer_outputs_sha256") == _commit(outputs)
          and call.get("producer_outputs") == outputs
          and config.get("producer_arguments_sha256") == source.get("source_arguments_sha256")
            == call.get("source_arguments_sha256") == _commit(arguments),
          "held-out evaluation must retain every frozen ordered source, reference and generation")
    joined = {}
    for case, ref, output, generation, wire, unit, argument in zip(
            cases, refs, outputs, raw, wires, units, arguments, strict=True):
        _need(all(type(row) is dict for row in (ref, output, generation, wire))
              and set(output) == {"id", "outcome", "candidate"}
              and all(row.get("id") == case.row_id for row in (ref, output, generation, wire))
              and all(row.get("unit_id") == case.unit_id for row in (ref, generation, wire))
              and all(generation.get(key) == value for key, value in output.items())
              and wire.get("source_wire_sha256") == case.source_wire_sha256
              and type(ref.get("source_text")) is str
              and wire.get("source_text_sha256") == _sha(ref["source_text"].encode("utf-8"))
              and argument == {"id": case.row_id, "source_text": ref["source_text"],
                               "context": {"permitted": [], "retrieved": []}},
              "saved row, source wire or raw generation differs from the frozen case")
        target = ref.get("canonical_ir")
        source_binding = target.get("source_binding") if type(target) is dict else None
        _need(type(source_binding) is dict
              and set(source_binding) == {"source_version_cid", "occurrence_cid", "document_revision"}
              and all(type(item) is str and item for item in source_binding.values())
              and _commit(target) == case.reference_sha256 and _commit(source_binding) == case.source_binding_sha256
              and (development is not None or (
                  type(unit) is dict and unit.get("id") == case.row_id and unit.get("unit_id") == case.unit_id
                  and all(unit.get(key) == source_binding[key] for key in ("source_version_cid", "occurrence_cid")))),
              "selected reference or admitted source occurrence/revision differs")
        outcome, candidate = output["outcome"], output["candidate"]
        _need(type(outcome) is str and outcome in MODEL_OUTCOMES
              and (type(candidate) is dict if outcome == "complete" else candidate is None),
              "exact saved source-only output disposition and candidate required")
        joined[case.row_id] = (outcome, _commit(generation), _commit(candidate) if candidate is not None else None)
    dispositions = observation.get("row_dispositions")
    _need(type(dispositions) in (tuple, list)
          and all(type(item) in (tuple, list) and len(item) == 2 for item in dispositions)
          and tuple(tuple(item) for item in dispositions) == tuple((key, val[0]) for key, val in joined.items()),
          "structural observation does not describe the saved generation roster")
    return joined, _commit((observation["route"], pair, declaration["backend_identity"]))


def _reviewed_row(outcome, generation_sha, candidate_sha, review, case):
    if review is None:
        return {"response": None, "fidelity_state": "unavailable", "formal_state": "unavailable",
                "source_fidelity": None if outcome == "complete" else False,
                "formal_validity": None if outcome == "complete" else False,
                "coverage": None if outcome == "complete" else False,
                "abstention": None if outcome in ("complete", "abstained") else False}

    responses = ("answered", "invalid") if outcome == "complete" else (outcome,)
    _need(review.generation_sha256 == generation_sha and review.candidate_sha256 == candidate_sha
          and review.response in responses and _pin(review.response_receipt_sha256)
          and review.fidelity in FIDELITY_STATES and review.formal in FORMAL_STATES,
          "independent finding applies to a different candidate, generation or response")
    answered = review.response == "answered"
    _need((review.fidelity_receipt_sha256 is None if review.fidelity == "unavailable"
           else answered and case.review_eligible and _pin(review.fidelity_receipt_sha256)),
          "source fidelity requires an eligible answer and a separate review receipt")
    formal_pins = (review.formal_receipt_sha256, review.obligation_sha256, review.toolchain_sha256)
    _need((all(value is None for value in formal_pins) if review.formal == "unavailable"
           else answered and case.formal_required and all(_pin(value) for value in formal_pins)
                and review.formal_receipt_sha256 != review.fidelity_receipt_sha256),
          "formal validity requires an eligible answer and independently verified obligation and toolchain")
    return {"response": review.response, "fidelity_state": review.fidelity, "formal_state": review.formal,
            "source_fidelity": {"faithful": True, "unfaithful": False}.get(review.fidelity) if answered else False,
            "formal_validity": {"proved": True, "invalid": False}.get(review.formal) if answered else False,
            "coverage": answered, "abstention": review.response == "abstained"}


def _gate_counts(threshold, policy, retention, normalized):
    eligible = tuple(case.row_id for case in policy.cases if case.review_eligible)
    successes = ()
    retention_known = False
    if retention is not None:
        _need(type(retention.row_fidelity) is tuple
              and all(type(pair) is tuple and len(pair) == 2 and (pair[1] is None or type(pair[1]) is bool)
                      for pair in retention.row_fidelity)
              and tuple(key for key, _ in retention.row_fidelity) == eligible,
              "retention must freeze all prior eligible source-fidelity findings")
        successes = tuple(key for key, passed in retention.row_fidelity if passed is True)
        retention_known = all(passed is not None for _, passed in retention.row_fidelity)

    def counts(gate_name, roster, *, baseline_known=True):
        values = tuple(normalized[row_id][gate_name] for row_id in roster)
        return threshold.Counts(sum(value is True for value in values), len(values),
                                baseline_known and all(value is not None for value in values))

    return {"source_fidelity": counts("source_fidelity", eligible),
            "formal_validity": counts("formal_validity", (case.row_id for case in policy.cases if case.formal_required)),
            "retention": counts("source_fidelity", successes, baseline_known=retention_known),
            "coverage": counts("coverage", normalized), "abstention": counts("abstention", normalized)}


def prepare_threshold_look(threshold, study_owner, *, study, expected_study_sha256, policy, retention,
                           review, expected_review_sha256, components, verify_review_owner,
                           policy_candidate=None, expected_policy_candidate_sha256=None):
    """Replay the existing owner-authenticated held-out look."""
    return _prepare_threshold_look(threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256,
        policy=policy, retention=retention, review=review, expected_review_sha256=expected_review_sha256,
        components=components, verify_review_owner=verify_review_owner, development=None,
        policy_candidate=policy_candidate, expected_policy_candidate_sha256=expected_policy_candidate_sha256)


def _prepare_threshold_look(threshold, study_owner, *, study, expected_study_sha256, policy, retention,
                            review, expected_review_sha256, components, verify_review_owner, development,
                            policy_candidate=None, expected_policy_candidate_sha256=None,
                            decision_span_validation=False, fused_validation=False):
    """Replay an owner-authenticated look without opening proof, model or legal-review payloads.

    The independent owner resolves the review, policy and retention commitments.
    It authenticates the saved component closes, mapping to the physical attempt,
    each exact candidate's obligations and toolchain, and role-specific findings.
    """
    study_owner._study(threshold, study, expected_study_sha256)
    groups = _heldout_groups(policy, study)
    _need(type(review) is GateReview and review.study_sha256 == expected_study_sha256
          and (review.arm, review.recipe_sha256) in study.arms
          and type(review.components) is type(review.rows) is type(components) is tuple
          and len(review.components) == len(components) == len(groups)
          and all(type(item) is ComponentClose and all(_pin(pin) for pin in asdict(item).values())
                  for item in review.components)
          and all(type(item) is RowReview and type(item.row_id) is str for item in review.rows)
          and _pin(expected_review_sha256) and review_commitment(review) == expected_review_sha256
          and callable(verify_review_owner), "exact independently selected evaluation and review roster required")
    seeds = {seed.identifier: seed for seed in study.seeds}
    panel_sha = _commit(study.panel)
    _need(review.seed in seeds and type(retention) is RetentionReference
          and (retention.seed, retention.panel_sha256, retention.evaluation_policy_sha256)
              == (review.seed, panel_sha, study.evaluation_policy_sha256)
          and all(_pin(pin) for pin in (retention.baseline_checkpoint_sha256, retention.baseline_receipt_sha256))
          and retention_commitment(retention) == seeds[review.seed].retention_reference_sha256,
          "exact per-seed frozen baseline reference required")
    retention_pin = seeds[review.seed].retention_reference_sha256
    guided = review.arm in GUIDED_DECISION_SPAN_POLICY_ARMS
    _need(not guided or (decision_span_validation is True and development is not None),
          "guided policy review requires the selected DEVELOPMENT validation route")
    policy_span = guided or review.arm in DECISION_SPAN_POLICY_ARMS
    policy_t5 = review.arm in T5_POLICY_ARMS
    policy_arm = review.arm in POLICY_ARMS or policy_t5 or policy_span
    policy_route = T5 if policy_t5 else QWEN
    if policy_arm:
        _need((development is None or (decision_span_validation and policy_span)) and type(policy_candidate) is dict
              and _pin(expected_policy_candidate_sha256)
              and _commit(policy_candidate) == expected_policy_candidate_sha256
              and (policy_candidate.get("study_sha256"), policy_candidate.get("arm"), policy_candidate.get("arm_recipe_sha256"))
                   == (expected_study_sha256, review.arm, review.recipe_sha256)
              and type(policy_candidate.get("seed")) is int
              and (not guided or review.seed == str(policy_candidate["seed"]))
              and policy_candidate.get("qualified") is False and policy_candidate.get("whole_arm_cost_required") is True
              and all(_artifact(policy_candidate.get(key)) for key in ("candidate", "model_checkpoint", "optimizer_checkpoint"))
              and all(_pin(policy_candidate.get(key)) for key in ("attempt_sha256", "terminal_close_sha256")),
              "policy look requires the exact owner-closed candidate for its selected arm")
        if policy_span:
            _need(_decision_span_policy_link(policy_candidate, guided=guided, fused=fused_validation),
                  "decision span policy look requires its exact owner-closed span runtime and completion")
            architecture = _span_binding(policy_candidate, guided)["architecture"]
            policy_route = T5 if architecture == "encoder_decoder" else QWEN
        elif policy_t5:
            _need(_t5_policy_link(policy_candidate), "T5 policy look requires its bound full-target runtime and completion")
        else:
            _need("t5_scoped_forward_binding" not in policy_candidate,
                  "scoped T5 forward evidence requires the T5 policy route")
        selected_header = (review.arm, policy_candidate["seed"], policy_candidate["attempt_sha256"],
                           policy_candidate["candidate"]["sha256"], policy_candidate["terminal_close_sha256"])
    else:
        _need(policy_candidate is None and expected_policy_candidate_sha256 is None,
              "policy candidate evidence requires an explicit policy study arm")
    header_fields = ("arm", "seed", "attempt_sha256", "look", "candidate_sha256", "trial_terminal_close_sha256")
    common = None
    common_pair = None
    selected = {}
    for (group, cases), component, close in zip(groups.items(), components, review.components, strict=True):
        _need(type(component) is tuple and len(component) == 2, "ordered saved assessment components required")
        observation, saved = component
        _need(type(observation) is dict and (observation.get("study_sha256"), observation.get("panel_sha256"),
              observation.get("evaluation_policy_sha256"), observation.get("retention_reference_sha256"))
              == (expected_study_sha256, panel_sha, study.evaluation_policy_sha256, retention_pin)
              and (observation.get("arm") == review.arm if policy_arm else
                   observation.get("arm") in ("supervised", "tap_only", "relational"))
              and observation.get("route") in ((policy_route,) if policy_arm else (QWEN, T5))
              and _pin(observation.get("assessment_sha256")) and _pin(observation.get("loader_receipt_sha256"))
              and type(observation.get("seed")) is int and observation.get("look") in study.schedule
              and all(_pin(observation.get(key)) for key in header_fields[2:] if key != "look"),
              "closed component differs from selected study, panel, policy or native look")
        header = tuple(observation[key] for key in header_fields)
        if policy_arm:
            _need(header[:3] + header[4:] == selected_header
                  and observation.get("policy_candidate_sha256") == expected_policy_candidate_sha256,
                  "policy component differs from the selected arm, attempt or terminal candidate")
        else:
            _need("policy_candidate_sha256" not in observation,
                  "policy component requires its selected owner-closed candidate")
        _need(common is None or common == header, "component originates from a different native attempt or checkpoint")
        common = header
        component_rows, component_pair = _closed_component(observation, saved, close, cases, group,
            development=development, fused_validation=fused_validation)
        if policy_arm:
            loaded = saved["metadata"]["source_generation_observation"]["input_commitment"]
            _need(all(loaded[key] == policy_candidate[key] for key in ("model_checkpoint", "optimizer_checkpoint")),
                  "policy component did not load the selected model and optimizer pair")
        _need(common_pair is None or common_pair == component_pair,
              "components must retain the same exact loaded model, optimizer and backend")
        common_pair = component_pair
        selected.update(component_rows)

    _, _, attempt_sha, look, checkpoint, _ = common
    findings = {item.row_id: item for item in review.rows}
    _need(len(findings) == len(review.rows) and findings.keys() <= selected.keys(),
          "owner findings cannot repeat or add an out-of-panel row")
    normalized = {case.row_id: _reviewed_row(*selected[case.row_id], findings.get(case.row_id), case)
                  for case in policy.cases}
    gates = _gate_counts(threshold, policy, retention, normalized)
    _need(tuple(gates[name].denominator for name in threshold.GATES) == seeds[review.seed].gate_denominators,
          "gate denominators differ from the frozen seed design")
    report = {"schema": GATE_SCHEMA, "review_sha256": expected_review_sha256,
              "native_identity": dict(zip(header_fields, common, strict=True)),
              "study_sha256": expected_study_sha256, "arm": review.arm, "seed": review.seed,
              "component_closes": tuple(asdict(close) for close in review.components),
              "panel_sha256": panel_sha, "evaluation_policy_sha256": study.evaluation_policy_sha256,
              "retention_reference_sha256": retention_pin,
              "rows": tuple({"row_id": case.row_id, "producer_outcome": selected[case.row_id][0],
                             "generation_sha256": selected[case.row_id][1], "candidate_sha256": selected[case.row_id][2],
                             "review_eligible": case.review_eligible, "formal_required": case.formal_required,
                             **normalized[case.row_id]} for case in policy.cases),
              "counts": {key: asdict(value) for key, value in gates.items()}}
    if policy_arm:
        report["policy_candidate_sha256"] = expected_policy_candidate_sha256
    _need(verify_review_owner(expected_review_sha256, study.evaluation_policy_sha256, retention_pin) is True
          and study_owner.commitment(study) == expected_study_sha256
          and gate_policy_commitment(policy) == study.evaluation_policy_sha256
          and retention_commitment(retention) == retention_pin and review_commitment(review) == expected_review_sha256
          and (not policy_arm or _commit(policy_candidate) == expected_policy_candidate_sha256)
          and all((_commit(component[0]), _commit(component[1])) == (close.observation_sha256, close.artifact_sha256)
                  for component, close in zip(components, review.components, strict=True)),
          "owner refused review or selected assessment evidence changed during verification")
    return PreparedGateLook(look, checkpoint, _commit(report), panel_sha, study.evaluation_policy_sha256,
                            retention_pin, expected_study_sha256, attempt_sha, study.cost_policy_sha256, gates), report


def prepared_look_commitment(prepared):
    return _commit((GATE_SCHEMA, "prepared-threshold-look", asdict(prepared)))


def bind_threshold_meter(study_owner, *, prepared, expected_look_sha256, meter):
    """Join the final meter after the evaluator has fixed its receipt and checkpoint."""
    _need(type(prepared) is PreparedGateLook,
          "whole-arm meter must describe the exact look and physical attempt")
    return _bind_selected_threshold_meter(study_owner, prepared, expected_look_sha256, meter)


def bind_t5_fusion_threshold_meter(study_owner, *, prepared, expected_look_sha256, meter, gate_report):
    """Join a fused gate report and meter as input to the fused paid comparison.

    The paid comparison independently verifies the physical upstream ledger.
    This handoff checks the identity of the prepared gate and meter.
    """
    _need(type(prepared) is T5FusionPreparedGateLook and type(gate_report) is dict
          and gate_report.get("schema") == T5_FUSION_VALIDATION_LOOK_SCHEMA
          and _pin(prepared.component_bindings_sha256)
          and _commit(gate_report.get("t5_fusion_component_bindings")) == prepared.component_bindings_sha256
          and _commit(gate_report) == prepared.evaluation_receipt_sha256,
          "exact fused T5 gate report and teacher component identities required")
    return _bind_selected_threshold_meter(study_owner, prepared, expected_look_sha256, meter)


def _bind_selected_threshold_meter(study_owner, prepared, expected_look_sha256, meter):
    _need(_pin(expected_look_sha256) and prepared_look_commitment(prepared) == expected_look_sha256
          and type(meter) is study_owner.Meter and meter.stage == prepared.look
          and meter.attempt_sha256 == prepared.attempt_sha256
          and meter.cost_policy_sha256 == prepared.cost_policy_sha256 and meter.scope == study_owner.CUMULATIVE_ARM,
          "whole-arm meter must describe the exact look and physical attempt")
    return study_owner.Assessment(prepared.look, prepared.checkpoint_sha256, prepared.evaluation_receipt_sha256,
                                  prepared.panel_sha256, prepared.evaluation_policy_sha256,
                                  prepared.retention_reference_sha256, dict(prepared.gates), meter)


def build_threshold_assessment(threshold, study_owner, *, study, expected_study_sha256, policy, retention,
                               review, expected_review_sha256, components, meter, verify_review_owner,
                               policy_candidate=None, expected_policy_candidate_sha256=None):
    _need(type(meter) is study_owner.Meter, "exact existing whole-arm meter required")
    meter_pin = _commit(asdict(meter))
    prepared, report = prepare_threshold_look(
        threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256,
        policy=policy, retention=retention, review=review, expected_review_sha256=expected_review_sha256,
        components=components, verify_review_owner=verify_review_owner,
        policy_candidate=policy_candidate, expected_policy_candidate_sha256=expected_policy_candidate_sha256)
    _need(_commit(asdict(meter)) == meter_pin, "selected meter changed during review verification")
    return bind_threshold_meter(study_owner, prepared=prepared, expected_look_sha256=prepared_look_commitment(prepared),
                                meter=meter), report


@dataclass(frozen=True)
class DecisionSpanPaidLook:
    """One matched look on the complete, owner-reviewed component roster."""

    seed: str
    policy_attempts: tuple
    dispatches: tuple
    policy_candidates: tuple
    component_plans: tuple
    component_observations: tuple
    prepared: tuple[PreparedGateLook, PreparedGateLook]
    gate_reports: tuple[dict, dict]


@dataclass(frozen=True)
class DecisionSpanUnobservedArm:
    """The exact close of a selected arm with no graded candidate observation."""

    disposition: str
    owner_close_sha256: str
    outcome_artifact: dict | None = None
    outcome_body: dict | None = None


@dataclass(frozen=True)
class DecisionSpanAsymmetricPaidLook(DecisionSpanPaidLook):
    unobserved: tuple[DecisionSpanUnobservedArm | None, DecisionSpanUnobservedArm | None]


@dataclass(frozen=True)
class DecisionSpanValidationPaidLook(DecisionSpanAsymmetricPaidLook):
    """One registered VALIDATION slot with an explicit disposition for each arm."""


@dataclass(frozen=True)
class GuidedSpanValidationPaidLook(DecisionSpanValidationPaidLook):
    """One registered DEVELOPMENT slot in exact guided/control role order."""


@dataclass(frozen=True)
class T5FusionValidationPaidLook(DecisionSpanValidationPaidLook):
    """A fused DEVELOPMENT look with the selected per-component role bodies."""

    component_teacher_bindings: tuple[tuple[dict | None, dict | None], ...]
    pre_development_close_receipts: tuple[str | None, str | None] = (None, None)


@dataclass(frozen=True)
class T5FusionDevelopmentClose:
    """A physical component execution that closed without a graded arm."""

    dependency_group_sha256: str
    owner_close_sha256: str
    disposition: str


@dataclass(frozen=True)
class T5FusionUngradedDevelopment:
    """Prepared DEVELOPMENT roles and exclusive work before an ungraded close.

    The phase owner receipt attests to preparation, the original ordering and
    complete execution-close roster, and absence of an independent grade.
    """

    policy_candidate: dict
    component_plans: tuple[T5FusionSpanValidationAssessment, ...]
    component_teacher_bindings: tuple[dict, ...]
    owner_receipt_sha256: str
    component_execution_closes: tuple[T5FusionDevelopmentClose, ...]


@dataclass(frozen=True)
class T5FusionStartedDevelopmentPaidLook(T5FusionValidationPaidLook):
    """At least one ungraded arm consumed selected DEVELOPMENT preparation."""

    started_development: tuple[T5FusionUngradedDevelopment | None, T5FusionUngradedDevelopment | None] = (None, None)


@dataclass(frozen=True)
class T5FusionPreparationClose:
    """One original paid preparation event before a usable DEVELOPMENT batch."""

    dependency_group_sha256: str
    source_roster_sha256: str
    event_sha256: str
    owner_close_sha256: str
    disposition: str
    interval: "WallSpan"


@dataclass(frozen=True)
class T5FusionInterruptedPreparation:
    """A candidate-scoped phase close before usable DEVELOPMENT inputs exist."""

    policy_candidate: dict
    owner_receipt_sha256: str
    preparation_closes: tuple[T5FusionPreparationClose, ...]


@dataclass(frozen=True)
class T5FusionInterruptedPreparationPaidLook(T5FusionStartedDevelopmentPaidLook):
    """At least one selected arm closed during DEVELOPMENT preparation."""

    interrupted_preparation: tuple[T5FusionInterruptedPreparation | None, T5FusionInterruptedPreparation | None] = (
        None, None)


_FUSED_PHASE_LOOK_TYPES = (T5FusionStartedDevelopmentPaidLook, T5FusionInterruptedPreparationPaidLook)
_FUSED_PAID_LOOK_TYPES = (T5FusionValidationPaidLook, *_FUSED_PHASE_LOOK_TYPES)


@dataclass(frozen=True)
class T5FusionUpstreamCost:
    """Original physical work for an exact fused cohort and upstream subject."""

    seed: str
    cohort_sha256: str
    role: str
    subject_sha256: str
    event_sha256: str
    close_receipt_sha256: str
    interval: "WallSpan"


@dataclass(frozen=True)
class GuidedPreupdateDiscoveryCost:
    """Owner-observed discovery and downstream start for one guided attempt."""

    opening: "GuidedPolicyWorkerOpening"
    selection: "GuidedDecisionSpanSelection"
    event_sha256: str
    owner_close_sha256: str
    discovery_readback_sha256: str
    clock_domain_sha256: str
    discovery_wall_receipt_sha256: str
    downstream_start_receipt_sha256: str
    discovery_start_ns: int
    discovery_end_ns: int
    downstream_start_ns: int


def guided_preupdate_discovery_costs_commitment(costs, *, study_sha256, matched_looks_sha256, cost_evidence_sha256):
    """Bind the original discovery to the selected study and physical evidence."""
    from .grouped_policy import GuidedDecisionSpanSelection

    _need(all(_pin(pin) for pin in (study_sha256, matched_looks_sha256, cost_evidence_sha256))
          and type(costs) is tuple and bool(costs)
          and all(type(row) is GuidedPreupdateDiscoveryCost for row in costs),
          "exact guided pre-update discovery cost roster required")
    for row in costs:
        guided_policy_worker_opening_commitment(row.opening)
        _need(type(row.selection) is GuidedDecisionSpanSelection
              and _pin(row.selection.discovery_receipt_sha256)
              and row.selection.digest() == row.opening.guided_selection_sha256
              and row.selection.starting_pair_sha256 == row.opening.starting_pair_sha256
              and row.opening.study_sha256 == study_sha256
              and all(_pin(pin) for pin in (row.event_sha256, row.owner_close_sha256, row.discovery_readback_sha256,
                  row.clock_domain_sha256, row.discovery_wall_receipt_sha256, row.downstream_start_receipt_sha256))
              and len({row.owner_close_sha256, row.discovery_wall_receipt_sha256,
                       row.downstream_start_receipt_sha256}) == 3
              and type(row.discovery_start_ns) is type(row.discovery_end_ns) is type(row.downstream_start_ns) is int
              and 0 <= row.discovery_start_ns <= row.discovery_end_ns <= row.downstream_start_ns,
              "guided discovery requires the original selection and a close before its downstream start")
    for get_pin in (lambda row: row.event_sha256, lambda row: row.owner_close_sha256,
                    lambda row: row.discovery_readback_sha256, lambda row: row.selection.discovery_receipt_sha256):
        _need(len({get_pin(row) for row in costs}) == len(costs),
              "guided discovery first-use costs cannot reuse an event, close, readback or original discovery")
    return _commit((GUIDED_SPAN_PREUPDATE_COST_SCHEMA, study_sha256, matched_looks_sha256, cost_evidence_sha256,
                    tuple(asdict(row) for row in costs)))


def _bind_guided_preupdate_discovery_costs(study_owner, costs, matched_looks, attempts, events,
                                          observations, distinct_closes):
    discovery_events = {event_id for event_id, event in events.items()
                        if event.kind == GUIDED_SPAN_DISCOVERY_EVENT_KIND}
    _need(discovery_events == {cost.event_sha256 for cost in costs},
          "guided discovery events require their exact independently bound roster")
    if not costs:
        return ()

    _need(len(costs) == len(matched_looks), "guided discovery must bind every selected seed in order")
    physical = {attempt.attempt_sha256: attempt for attempt in attempts}
    starting_artifacts = {reference.sha256 for look in matched_looks for dispatch in look.dispatches
                          for reference in (dispatch.parent_manifest, dispatch.base_model_checkpoint,
                                            dispatch.base_optimizer_checkpoint, *dispatch.assets)}
    candidate_artifacts = {link[field]["sha256"] for look in matched_looks for link in look.policy_candidates
                           if link is not None for field in ("candidate", "model_checkpoint", "optimizer_checkpoint")}
    artifact_pins = starting_artifacts | candidate_artifacts | {cost.opening.starting_pair_sha256 for cost in costs}
    by_attempt = {}
    for cost, look in zip(costs, matched_looks, strict=True):
        opening_pin = guided_policy_worker_opening_commitment(cost.opening)
        guided, control = look.policy_attempts
        # The physical checkpoint at a scored look is the product of the update.
        # Discovery instead binds the original opening and pre-update model pair.
        _need(all((scope.attempt_sha256, scope.opening_sha256, scope.starting_pair_sha256) ==
                  (arm.attempt_sha256, opening_pin, cost.opening.starting_pair_sha256)
                  for scope, arm in zip((guided, control), cost.opening.arms, strict=True))
              and (cost.selection.starting_model_sha256, cost.selection.configuration_sha256,
                   cost.selection.tokenizer_sha256, cost.selection.common_reward_receipt_sha256) ==
                   (guided.base_model_sha256, guided.configuration_sha256, guided.tokenizer_sha256,
                    guided.common_reward_receipt_sha256)
              and guided.attempt_sha256 in physical,
              "guided discovery must attach to the exact paired opening and starting artifacts")
        event = events[cost.event_sha256]
        _need(event.disposition == "complete" and event.close_receipt_sha256 == cost.owner_close_sha256
              and cost.owner_close_sha256 not in distinct_closes and cost.owner_close_sha256 not in artifact_pins,
              "guided discovery requires its own completed original paid close")
        by_attempt[guided.attempt_sha256] = cost

    for interval, charges in observations:
        cost = by_attempt.get(interval.attempt_sha256)
        required = {} if cost is None else {cost.event_sha256: 1}
        _need({key: share for key, share in charges.entries if key in discovery_events} == required,
              "only the guided attempt must charge its full discovery at every observed cut and close")
        if cost is not None:
            wall = interval.wall
            _need(type(wall) is study_owner.WallSpan and type(wall.end_ns) is int
                  and (wall.clock_domain_sha256, wall.start_ns) ==
                       (cost.clock_domain_sha256, cost.discovery_start_ns)
                  and wall.end_ns >= cost.downstream_start_ns
                  and wall.receipt_sha256 not in (cost.discovery_wall_receipt_sha256,
                                                 cost.downstream_start_receipt_sha256),
                  "guided whole-arm wall must enclose the original discovery and downstream start in one clock")

    rows = []
    for attempt_sha256, cost in by_attempt.items():
        attempt = physical[attempt_sha256]
        event = events[cost.event_sha256]
        rows.append({"attempt_sha256": attempt_sha256, "event_sha256": cost.event_sha256,
                     "original_discovery_sha256": cost.selection.discovery_receipt_sha256,
                     "opening_sha256": guided_policy_worker_opening_commitment(cost.opening),
                     "starting_pair_sha256": cost.opening.starting_pair_sha256,
                     "discovery_inclusive_clocks": _guided_discovery_inclusive_clocks(
                         attempt, event.cpu_ns, event.gpu_ns)})
    return tuple(rows)


def _guided_discovery_inclusive_clocks(attempt, cpu_ns, gpu_ns):
    """List observed clocks only, including all cumulative attempt cuts."""
    meters = (*(look.meter for look in attempt.assessments), attempt.closing_meter)
    # The physical verifier separately validates every non-null counter.
    clocks = (("wall_seconds", True), ("cpu_seconds", cpu_ns is not None), ("gpu_seconds", gpu_ns is not None))
    return tuple(clock for clock, measured in clocks if measured
                 and all(getattr(meter.costs, clock) is not None for meter in meters))


@dataclass(frozen=True)
class DecisionSpanTrailingClose:
    """The arm's own terminal evidence for its unobserved scheduled suffix."""

    disposition: str
    owner_close_sha256: str
    first_missing_look: str


@dataclass(frozen=True)
class DecisionSpanTrailingPaidLook(DecisionSpanAsymmetricPaidLook):
    unobserved: tuple[DecisionSpanUnobservedArm | DecisionSpanTrailingClose | None,
                      DecisionSpanUnobservedArm | DecisionSpanTrailingClose | None]
    scheduled_look: str


def _bind_trailing_decision_span(physical, close, schedule, scheduled_look):
    observed = tuple(look.look for look in physical.assessments)
    next_index = len(observed)
    _need(0 < next_index < len(schedule) and observed == schedule[:next_index]
          and close.first_missing_look == schedule[next_index]
          and scheduled_look in schedule[next_index:],
          "trailing span close must name the first missing slot after its exact graded prefix")
    _need(type(close.disposition) is str and close.disposition in ("complete", "budget_limit", "integrity_failure")
          and physical.closeout_status == close.disposition and _pin(close.owner_close_sha256)
          and physical.closeout_receipt_sha256 == close.owner_close_sha256,
          "trailing span arm requires its own exact paid terminal close and disposition")
    return observed, schedule[next_index:]


def _bind_unobserved_decision_span(attempt, dispatch, physical, close):
    from .relational_trial import decision_span_policy_update_progress

    close_status = {"no_candidate": "open", "budget_limit": "budget_limit",
                    "integrity_failure": "integrity_failure"}
    _need(type(close) is DecisionSpanUnobservedArm and type(close.disposition) is str
          and close.disposition in close_status and physical.assessments == ()
          and physical.closeout_status == close_status[close.disposition]
          and _pin(close.owner_close_sha256) and physical.closeout_receipt_sha256 == close.owner_close_sha256,
          "unobserved span arm requires its own exact paid close and threshold disposition")
    guided = type(attempt) is GuidedDecisionSpanPolicyAttempt
    offered = close.outcome_body
    if close.disposition == "no_candidate":
        ref = close.outcome_artifact
        fields = {"schema", "policy_attempt_sha256", "policy_update", "candidate", "whole_arm_cost_required"}
        schema = "reviewed-decoder-policy-no-candidate/v1"
        if guided:
            fields.add("guided_scope_binding")
            schema = "reviewed-decoder-guided-span-policy-no-candidate/v1"
        _need(_artifact(ref) and ref["path"] == dispatch.output_directory + "/outcome.json"
              and type(offered) is dict and set(offered) == fields
              and offered["schema"] == schema
              and (not guided or offered["guided_scope_binding"] == guided_policy_scope_binding(attempt))
              and offered["policy_attempt_sha256"] == policy_attempt_commitment(attempt)
              and offered["candidate"] is None and offered["whole_arm_cost_required"] is True,
              "unobserved span requires its exact worker no-candidate outcome")
        from .teacher_prefix import _wire

        raw = _wire(offered)
        _need(0 < len(raw) == ref["bytes"] <= 8 * 1024**2 and _sha(raw) == ref["sha256"],
              "no-candidate outcome bytes differ from the selected artifact")
        update = offered["policy_update"]
        _need(decision_span_policy_update_progress(attempt, update, require_step=False) == attempt.initial_optimizer_steps
              and update["update"]["status"] in ("no_active_terms", "no_nonzero_gradients"),
              "unobserved span must record an unchanged optimizer step")
        return "complete"
    _need(close.outcome_artifact is None and offered is None,
          "closed budget or integrity outcome cannot adopt a no-candidate worker report")
    return close.disposition


def _bind_asymmetric_span_look(study_owner, row, study_sha, attempts, physical_looks, *, schedule, validation=None):
    from . import autoencoder_training_worker as worker

    guided = type(row) is GuidedSpanValidationPaidLook
    fused = type(row) in _FUSED_PAID_LOOK_TYPES
    attempt_type = (GuidedDecisionSpanPolicyAttempt if guided else
                    T5FusionDecisionSpanPolicyAttempt if fused else DecisionSpanPolicyAttempt)
    fields = (row.policy_attempts, row.dispatches, row.policy_candidates, row.prepared, row.gate_reports, row.unobserved)
    trailing = type(row) is DecisionSpanTrailingPaidLook
    supported_close = DecisionSpanTrailingClose if trailing else DecisionSpanUnobservedArm
    _need(all(type(items) is tuple and len(items) == 2 for items in fields)
        and (validation is not None or any(type(close) is supported_close for close in row.unobserved))
        and all(type(attempt) is attempt_type for attempt in row.policy_attempts)
        and all(type(dispatch) is worker.ReviewedPolicyDispatch for dispatch in row.dispatches)
        and type(row.component_plans) is type(row.component_observations) is tuple
        and len(row.component_plans) == len(row.component_observations),
        "asymmetric span requires both typed attempts and explicit missing-arm evidence")
    if trailing:
        _need(type(row.scheduled_look) is str and row.scheduled_look in schedule,
              "trailing span look must name a registered scheduled slot")
    left, right = row.policy_attempts
    first, second = row.dispatches
    bounds = ("maximum_forward_tokens", "maximum_head_elements", "maximum_checkpoint_bytes")
    model, optimizer = first.base_model_checkpoint, first.base_optimizer_checkpoint
    start = _commit(("reviewed-decision-span-candidate-start/v1",
                     ("model", model.bytes, model.sha256), ("optimizer", optimizer.bytes, optimizer.sha256)))
    _need(_span_cohort(left, guided) == _span_cohort(right, guided)
          and left.attempt_sha256 != right.attempt_sha256
          and left.starting_pair_sha256 == start
          and (first.parent_manifest, first.base_model_checkpoint, first.base_optimizer_checkpoint, first.assets)
              == (second.parent_manifest, second.base_model_checkpoint, second.base_optimizer_checkpoint, second.assets)
          and all(getattr(first, name) == getattr(second, name) for name in bounds),
          "asymmetric span requires the same training cohort, starting artifacts and budgets")
    if guided:
        outputs = tuple(Path(dispatch.output_directory) for dispatch in row.dispatches)
        _need(validation is not None and (left.arm, right.arm) == GUIDED_DECISION_SPAN_POLICY_ARMS
              and row.seed == str(left.seed) == str(right.seed)
              and all(".." not in path.parts for path in outputs)
              and not any(path.is_relative_to(peer) for path, peer in (outputs, outputs[::-1]))
              and left.allocation_pair_sha256 != right.allocation_pair_sha256
              and left.plan_sha256 != right.plan_sha256
              and len(left.scored_sample_sha256s) == len(right.scored_sample_sha256s)
              and left.scored_sample_sha256s != right.scored_sample_sha256s,
              "paid guided pair requires canonical seed identity, distinct scopes and separate outputs")
    for plans, observations in zip(row.component_plans, row.component_observations, strict=True):
        _need(type(plans) is tuple and type(observations) is tuple and len(plans) == len(observations) == 2,
              "asymmetric span requires both explicit component slots")
    teacher_bindings = (None,) * len(row.component_plans)
    if fused:
        outputs = tuple(Path(dispatch.output_directory) for dispatch in row.dispatches)
        _need(validation is not None and (left.arm, right.arm) == DECISION_SPAN_POLICY_ARMS
              and row.seed == str(left.seed) == str(right.seed)
              and all(path.is_absolute() and ".." not in path.parts for path in outputs)
              and not any(path.is_relative_to(peer) for path, peer in (outputs, outputs[::-1]))
              and type(row.component_teacher_bindings) is tuple
              and len(row.component_teacher_bindings) == len(row.component_plans)
              and all(type(pair) is tuple and len(pair) == 2 for pair in row.component_teacher_bindings),
              "fused paid VALIDATION requires exact component roles and independent arm outputs")
        if type(row) in _FUSED_PHASE_LOOK_TYPES:
            _check_fused_development_phase_roster(row)
        else:
            pre_development = row.pre_development_close_receipts
            _need(type(pre_development) is tuple and len(pre_development) == 2
                  and all(receipt is None if close is None else _pin(receipt)
                          for close, receipt in zip(row.unobserved, pre_development, strict=True)),
                  "an ungraded fused arm requires an independently verifiable pre-DEVELOPMENT close")
        teacher_bindings = row.component_teacher_bindings
    plan_type = PolicyAssessment if validation is None else (
        GuidedSpanValidationAssessment if guided else
        T5FusionSpanValidationAssessment if fused else DecisionSpanValidationAssessment)
    if validation is not None and row.unobserved == (None, None):
        for plans, bindings in zip(row.component_plans, teacher_bindings, strict=True):
            _need(all(type(plan) is plan_type for plan in plans), "exact paid VALIDATION component plans required")
            bind_decision_span_assessment_pair(plans, row.policy_candidates,
                expected_assessment_sha256s=tuple(commitment(plan) for plan in plans),
                expected_policy_candidate_sha256s=tuple(_commit(link) for link in row.policy_candidates),
                policy_attempts=row.policy_attempts, dispatches=row.dispatches,
                t5_fusion_assessment_bindings=bindings)
    observed, skipped, tails = [], [], []
    for index, (attempt, dispatch, physical, link, look, report, close) in enumerate(zip(
            row.policy_attempts, row.dispatches, attempts, row.policy_candidates, row.prepared, row.gate_reports,
            row.unobserved, strict=True)):
        _need((attempt.study_sha256, attempt.arm, attempt.arm_recipe_sha256, attempt.attempt_sha256)
              == (physical.study_sha256, physical.arm, physical.recipe_sha256, physical.attempt_sha256)
              and attempt.study_sha256 == study_sha and physical.seed == row.seed
              and dispatch.commitment() == attempt.owner_request_sha256 and dispatch.attempt_sha256 == attempt.attempt_sha256
              and (dispatch.parent_manifest.sha256, dispatch.base_model_checkpoint.sha256,
                   dispatch.base_optimizer_checkpoint.sha256) == (attempt.parent_manifest_sha256,
                   attempt.base_model_sha256, attempt.base_optimizer_sha256),
              "asymmetric span dispatch differs from the selected study, seed, arm or checkpoints")
        if close is not None:
            _need(link is look is report is None and all(plans[index] is observations[index] is None
                  for plans, observations in zip(row.component_plans, row.component_observations, strict=True))
                  and (not fused or all(bindings[index] is None for bindings in teacher_bindings)),
                  "unobserved span arm cannot carry candidate or graded evaluation evidence")
            if trailing and type(close) is DecisionSpanTrailingClose:
                prefix, suffix = _bind_trailing_decision_span(physical, close, schedule, row.scheduled_look)
                disposition = close.disposition
                tails.append((physical.attempt_sha256, (prefix, suffix)))
            else:
                disposition = _bind_unobserved_decision_span(attempt, dispatch, physical, close)
            skipped.append((physical.attempt_sha256, (close.owner_close_sha256, disposition, close.disposition)))
            continue
        expected_look_type = T5FusionPreparedGateLook if fused else PreparedGateLook
        _need(type(look) is expected_look_type and type(report) is dict and bool(row.component_plans),
              "observed span arm requires its complete graded component evidence")
        if trailing:
            _need(look.look == row.scheduled_look, "observed span peer differs from the selected trailing slot")
        candidate_pin = _commit(link)
        for plans, observations, bindings in zip(row.component_plans, row.component_observations,
                                                   teacher_bindings, strict=True):
            plan = plans[index]
            _need(type(plan) is plan_type and type(observations[index]) is dict,
                  "observed span arm requires its exact component plan and observation")
            _bind_decision_span_assessment_arm(plan, link, commitment(plan), candidate_pin, attempt, dispatch, guided=guided)
            if fused:
                _require_t5_fusion_assessment_role(plan, link, bindings[index])
                _require_fused_paid_outputs(link, dispatch)
        observed.append(_bind_decision_span_paid_arm(
            study_owner, row, study_sha, physical_looks, index, physical, look, report, link, candidate_pin,
            validation=validation))
    _need(bool(observed) == bool(row.component_plans), "empty observed roster requires no graded components")
    return observed, skipped, tails


def decision_span_paid_looks_commitment(looks):
    _need(type(looks) is tuple and bool(looks) and all(type(row) in (
        DecisionSpanPaidLook, DecisionSpanAsymmetricPaidLook, DecisionSpanTrailingPaidLook) for row in looks),
        "exact selected matched decision span look roster required")
    if any(type(row) is DecisionSpanTrailingPaidLook for row in looks):
        return _commit(("reviewed-decision-span-paid-look-roster/v3", tuple(asdict(row) for row in looks)))
    if any(type(row) is DecisionSpanAsymmetricPaidLook for row in looks):
        return _commit(("reviewed-decision-span-paid-look-roster/v2", tuple(asdict(row) for row in looks)))
    return _commit(("reviewed-decision-span-paid-look-roster/v1", tuple(asdict(row) for row in looks)))


def _bind_decision_span_paid_arm(study_owner, row, study_sha, physical_looks, index,
                                 attempt, look, report, link, candidate_pin, *, validation=None):
    physical = physical_looks.get((attempt.attempt_sha256, look.look))
    guided = type(row) is GuidedSpanValidationPaidLook
    fused = type(row) in _FUSED_PAID_LOOK_TYPES
    schema = GATE_SCHEMA if validation is None else (
        GUIDED_VALIDATION_LOOK_SCHEMA if guided else
        T5_FUSION_VALIDATION_LOOK_SCHEMA if fused else DECISION_SPAN_VALIDATION_LOOK_SCHEMA)
    _need(physical is not None and look.study_sha256 == study_sha
          and look.attempt_sha256 == attempt.attempt_sha256
          and _commit(report) == look.evaluation_receipt_sha256
          and report.get("schema") == schema and report.get("study_sha256") == study_sha
          and report.get("arm") == attempt.arm and report.get("seed") == attempt.seed == row.seed
          and report.get("panel_sha256") == look.panel_sha256
          and report.get("evaluation_policy_sha256") == look.evaluation_policy_sha256
          and report.get("retention_reference_sha256") == look.retention_reference_sha256
          and report.get("counts") == {name: asdict(count) for name, count in look.gates.items()}
          and report.get("policy_candidate_sha256") == candidate_pin
          and look.checkpoint_sha256 == link["candidate"]["sha256"]
          and link["arm_recipe_sha256"] == attempt.recipe_sha256
          and _pin(link.get("owner_execution_record_sha256")),
          "paid assessment differs from the selected gate, cumulative meter or training owner close")
    meter_args = {"prepared": look, "expected_look_sha256": prepared_look_commitment(look), "meter": physical.meter}
    rebound = (bind_t5_fusion_threshold_meter(study_owner, gate_report=report, **meter_args) if fused
               else bind_threshold_meter(study_owner, **meter_args))
    _need(rebound == physical, "paid threshold assessment differs from its cumulative meter")
    closes = report.get("component_closes")
    _need(type(closes) in (tuple, list) and len(closes) == len(row.component_plans),
          "paid threshold look must retain every graded component close")
    native = {"arm": attempt.arm, "seed": link["seed"], "attempt_sha256": attempt.attempt_sha256,
              "look": look.look, "candidate_sha256": look.checkpoint_sha256,
              "trial_terminal_close_sha256": link["terminal_close_sha256"]}
    _need(report.get("native_identity") == native
          and (not guided or (type(link["seed"]) is int
              and type(report["native_identity"]["seed"]) is int
              and link["seed"] == row.policy_attempts[index].seed)),
          "paid assessment native identity differs from the selected candidate and look")
    if fused:
        plans = (pair[index] for pair in row.component_plans)
        bound_components = tuple((plan.dependency_group_sha256, plan.t5_fusion_assessment_binding_sha256,
                                  plan.matched_teacher_inputs_sha256) for plan in plans)
        _need(_commit(bound_components) == look.component_bindings_sha256
              and _commit(report.get("t5_fusion_component_bindings")) == look.component_bindings_sha256,
              "fused paid look must retain the selected ordered teacher component identities")
    work = [link["owner_execution_record_sha256"]]
    if validation is not None:
        expected_split = {**validation["split"],
                          "policy_training_scope_sha256": row.policy_attempts[index].training_scope_sha256}
        _need(report.get("development_split") == expected_split and look.look == validation["look"]
              and report.get("optimizer_step_grid_sha256") == validation["step_grid_sha256"]
              and type(report.get("optimizer_steps")) is int and report["optimizer_steps"] == validation["step"]
              and tuple(plans[index].dependency_group_sha256 for plans in row.component_plans)
                    == tuple(validation["components"]),
              "paid VALIDATION review differs from its frozen split, components or reached step")
    for plans, observations, close in zip(row.component_plans, row.component_observations, closes, strict=True):
        plan, obs = plans[index], observations[index]
        _need(type(close) is dict and set(close) == {"observation_sha256", "artifact_sha256", "owner_close_sha256"}
              and all(_pin(pin) for pin in close.values())
              and _commit(obs) == close["observation_sha256"]
              and obs.get("saved_artifact_sha256") == close["artifact_sha256"]
              and obs.get("assessment_sha256") == commitment(plan)
              and obs.get("route") == plan.route and obs.get("policy_candidate_sha256") == candidate_pin
              and all(obs.get(name) == value for name, value in native.items())
              and (not guided or type(obs.get("seed")) is int)
              and (plan.study_sha256, plan.look, plan.panel_sha256, plan.evaluation_policy_sha256,
                   plan.retention_reference_sha256) == (study_sha, look.look, look.panel_sha256,
                   look.evaluation_policy_sha256, look.retention_reference_sha256),
              "paid component differs from its exact graded assessment and owner close")
        if validation is not None:
            _need((plan.development_split_sha256, plan.optimizer_step_grid_sha256, plan.optimizer_steps)
                  == (validation["split"]["selection_sha256"], validation["step_grid_sha256"], validation["step"])
                  and obs.get("schema") == DEVELOPMENT_OBSERVATION_SCHEMA
                  and obs.get("operation") == VALIDATION_OPERATION
                  and obs.get("development_scoring") == validation["components"][plan.dependency_group_sha256]
                  and obs.get("optimizer_step_grid_sha256") == validation["step_grid_sha256"]
                  and type(obs.get("optimizer_steps")) is int and obs["optimizer_steps"] == validation["step"],
                  "paid VALIDATION component is not the original selected projection and reached step")
        if fused:
            _need((obs.get("t5_fusion_assessment_binding_sha256"), obs.get("matched_teacher_inputs_sha256"))
                  == (plan.t5_fusion_assessment_binding_sha256, plan.matched_teacher_inputs_sha256)
                  and _pin(obs.get("t5_fusion_observation_sha256")),
                  "fused paid observation differs from its selected teacher component")
        work.append(close["owner_close_sha256"])
    _need(len(set(work)) == len(work), "training and graded evaluation require distinct physical closes")
    return (attempt.attempt_sha256, look.look), tuple(work)


def _bind_decision_span_paid_look(study_owner, row, study_sha, attempts, physical_looks):
    _need(all(type(items) is tuple and len(items) == 2 for items in (
              row.policy_attempts, row.dispatches, row.policy_candidates, row.prepared, row.gate_reports))
          and all(type(look) is PreparedGateLook for look in row.prepared)
          and all(type(report) is dict for report in row.gate_reports)
          and type(row.component_plans) is type(row.component_observations) is tuple
          and 0 < len(row.component_plans) == len(row.component_observations),
          "both paid arms require their complete selected component and threshold evidence")
    candidate_pins = tuple(_commit(link) for link in row.policy_candidates)
    for plans, observations in zip(row.component_plans, row.component_observations, strict=True):
        _need(type(plans) is tuple and len(plans) == 2 and all(type(plan) is PolicyAssessment for plan in plans)
              and type(observations) is tuple and len(observations) == 2
              and all(type(obs) is dict for obs in observations),
              "both paid arms require one exact plan and observation per component")
        bind_decision_span_assessment_pair(plans, row.policy_candidates,
            expected_assessment_sha256s=tuple(commitment(plan) for plan in plans),
            expected_policy_candidate_sha256s=candidate_pins, policy_attempts=row.policy_attempts,
            dispatches=row.dispatches)

    result = []
    for index, (attempt, look, report, link, candidate_pin) in enumerate(zip(
            attempts, row.prepared, row.gate_reports, row.policy_candidates, candidate_pins, strict=True)):
        result.append(_bind_decision_span_paid_arm(
            study_owner, row, study_sha, physical_looks, index, attempt, look, report, link, candidate_pin))
    return result


def compare_paid_decision_span(threshold, study_owner, *, study, expected_study_sha256, attempts,
        expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256, matched_looks,
        expected_matched_looks_sha256, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner):
    """Compare the retained held-out policy look formats."""
    return _compare_paid_decision_span(threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256, attempts=attempts,
        expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, matched_looks=matched_looks,
        expected_matched_looks_sha256=expected_matched_looks_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner)


def compare_paid_decision_span_validation(threshold, study_owner, *, study, expected_study_sha256, attempts,
        expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256, matched_looks,
        expected_matched_looks_sha256, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner,
        validation_split, policy, expected_validation_split_sha256, step_grid):
    """Compare the same reviewed VALIDATION slot using each arm's first-use costs."""
    return _compare_paid_span_validation(threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, matched_looks=matched_looks,
        expected_matched_looks_sha256=expected_matched_looks_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        validation_split=validation_split, policy=policy, expected_validation_split_sha256=expected_validation_split_sha256,
        step_grid=step_grid, guided=False)


def compare_paid_guided_span_validation(threshold, study_owner, *, study, expected_study_sha256, attempts,
        expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256, matched_looks,
        expected_matched_looks_sha256, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner,
        validation_split, policy, expected_validation_split_sha256, step_grid,
        discovery_costs=None, expected_discovery_costs_sha256=None):
    """Compare guided against control on DEVELOPMENT with independent whole-arm charges.

    With selected discovery evidence, the cost owner also authenticates the
    original discovery, its allocation to the guided arm, and when downstream
    execution first started. The verifier receives the added roster pin.
    """
    return _compare_paid_span_validation(threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, matched_looks=matched_looks,
        expected_matched_looks_sha256=expected_matched_looks_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        validation_split=validation_split, policy=policy, expected_validation_split_sha256=expected_validation_split_sha256,
        step_grid=step_grid, guided=True, discovery_costs=discovery_costs,
        expected_discovery_costs_sha256=expected_discovery_costs_sha256)


def compare_paid_t5_fusion_span_validation(threshold, study_owner, *, study, expected_study_sha256,
        attempts, expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256,
        matched_looks, expected_matched_looks_sha256, cost_evidence, expected_cost_evidence_sha256,
        verify_cost_owner, validation_split, policy, expected_validation_split_sha256, step_grid,
        upstream_costs, expected_upstream_costs_sha256):
    """Compare matched fused DEVELOPMENT arms under one observed first-use work ledger.

    The independent cost owner receives the cost, look and upstream commitments.
    CPU and GPU charge equal shares for original work consumed by both arms.
    Each arm keeps its own observed elapsed interval and all exclusive charges.
    The owner attests that the preparation covers both TRAIN handoff roles and
    that the original rollout event accounts separately for generation work.
    For an ungraded arm the owner verifies its separate phase receipt. That
    receipt identifies whether preparation never began, closed with usable
    inputs before the ungraded stop, or was interrupted before a usable batch
    existed. Actual work and exclusive component closes are retained.
    """
    return _compare_paid_span_validation(threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, matched_looks=matched_looks,
        expected_matched_looks_sha256=expected_matched_looks_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        validation_split=validation_split, policy=policy, expected_validation_split_sha256=expected_validation_split_sha256,
        step_grid=step_grid, guided=False, fused=True, upstream_costs=upstream_costs,
        expected_upstream_costs_sha256=expected_upstream_costs_sha256)


@dataclass(frozen=True)
class T5FusionSeedEstimatorEvidence:
    seed: str
    policy_attempt_sha256s: tuple[str, str]
    proof_module_sha256: str
    proof_evidence_sha256: str
    estimator_source: dict


@dataclass(frozen=True)
class T5FusionEstimatorProfileSelection:
    study_sha256: str
    estimator_profile: str
    seed_evidence: tuple[T5FusionSeedEstimatorEvidence, ...]


def t5_fusion_estimator_profile_selection_commitment(selection):
    """Commit one registered arithmetic profile and its exact per-seed proof selections."""
    _need(type(selection) is T5FusionEstimatorProfileSelection and _pin(selection.study_sha256)
          and type(selection.estimator_profile) is str and bool(selection.estimator_profile)
          and type(selection.seed_evidence) is tuple and bool(selection.seed_evidence)
          and all(type(row) is T5FusionSeedEstimatorEvidence and type(row.seed) is str and bool(row.seed)
                  and type(row.policy_attempt_sha256s) is tuple and len(row.policy_attempt_sha256s) == 2
                  and all(_pin(digest) for digest in (*row.policy_attempt_sha256s,
                                                      row.proof_module_sha256, row.proof_evidence_sha256))
                  and len(set(row.policy_attempt_sha256s)) == 2
                  for row in selection.seed_evidence)
          and len({row.seed for row in selection.seed_evidence}) == len(selection.seed_evidence),
          "exact ordered estimator profile proof selections for each registered seed required")
    for row in selection.seed_evidence:
        evidence = row.estimator_source
        _need(type(evidence) is dict and set(evidence) == {
                  "schema", "registry_role", "estimator_profile", "source_bytes", "source_sha256"}
              and type(evidence["schema"]) is str and evidence["schema"] == "reviewed-group-credit-estimator-source/v1"
              and type(evidence["registry_role"]) is str and evidence["registry_role"] == "group_credit"
              and type(evidence["estimator_profile"]) is str
              and evidence["estimator_profile"] == selection.estimator_profile
              and type(evidence["source_bytes"]) is int and evidence["source_bytes"] > 0
              and _pin(evidence["source_sha256"]),
              "all selected seeds must use the registered group credit estimator profile")
    return _commit((T5_FUSION_CREDIT_PROFILE_SELECTION_SCHEMA, asdict(selection)))


def _require_t5_fusion_estimator_profile_scope(study_owner, selection, profile_pin, *, study, study_pin,
        looks, looks_pin, split_pin, grid):
    _need(t5_fusion_estimator_profile_selection_commitment(selection) == profile_pin
          and selection.study_sha256 == study_pin == study_owner.commitment(study)
          and type(looks) is tuple and len(looks) == len(selection.seed_evidence)
          and tuple(row.seed for row in selection.seed_evidence) == tuple(seed.identifier for seed in study.seeds)
          and t5_fusion_span_validation_paid_looks_commitment(looks, validation_split_sha256=split_pin,
                step_grid_sha256=study_owner.development_step_grid_commitment(grid)) == looks_pin,
          "selected estimator profile must bind this paid study and every registered seed")
    for offered, look in zip(selection.seed_evidence, looks, strict=True):
        _need(type(look) in _FUSED_PAID_LOOK_TYPES and look.seed == offered.seed
              and type(look.policy_attempts) is tuple and len(look.policy_attempts) == 2
              and all(type(attempt) is T5FusionDecisionSpanPolicyAttempt for attempt in look.policy_attempts)
              and tuple(attempt.arm for attempt in look.policy_attempts) == DECISION_SPAN_POLICY_ARMS
              and all(attempt.study_sha256 == study_pin and str(attempt.seed) == offered.seed
                      for attempt in look.policy_attempts)
              and tuple(policy_attempt_commitment(attempt) for attempt in look.policy_attempts)
                    == offered.policy_attempt_sha256s
              and all((attempt.proof_module_sha256, attempt.selected_proof_evidence_sha256) ==
                      (offered.proof_module_sha256, offered.proof_evidence_sha256) for attempt in look.policy_attempts),
              "selected estimator evidence must bind both original attempts and their seed proof")


def compare_paid_t5_fusion_span_validation_with_estimator_profile(threshold, study_owner, *,
        estimator_profile_selection, expected_estimator_profile_selection_sha256,
        verify_estimator_profile_owner, **comparison):
    """Qualify an existing paid comparison with one independently selected arithmetic profile.

    The original proof and Source owner authenticates the pre-outcome profile
    registration and rehashes the admitted proof for each seed. A selection for
    an absent arm identifies its intended proof, without asserting that an update ran.
    """
    study, study_pin = comparison["study"], comparison["expected_study_sha256"]
    looks, looks_pin = comparison["matched_looks"], comparison["expected_matched_looks_sha256"]
    verify_cost_owner = comparison["verify_cost_owner"]
    profile_pin = expected_estimator_profile_selection_sha256
    _need(callable(verify_estimator_profile_owner) and callable(verify_cost_owner)
          and _pin(profile_pin) and _pin(looks_pin),
          "independent estimator profile and original cost owners required")
    study_owner._study(threshold, study, study_pin)
    split_pin = comparison["expected_validation_split_sha256"]
    grid = comparison["step_grid"]
    _decision_span_paid_validation_scope(study_owner, study, study_pin, comparison["validation_split"],
                                         comparison["policy"], split_pin, grid)

    def current_profile():
        _require_t5_fusion_estimator_profile_scope(study_owner, estimator_profile_selection, profile_pin,
            study=study, study_pin=study_pin, looks=looks, looks_pin=looks_pin, split_pin=split_pin, grid=grid)

    current_profile()
    _need(verify_estimator_profile_owner(profile_pin, study_pin, looks_pin) is True,
          "original proof and Source owner did not authenticate the selected estimator profile")
    current_profile()

    def verify_profile_bound_cost(*pins):
        current_profile()
        verified = verify_cost_owner(*pins) is True
        if verified:
            current_profile()
        return verified

    comparison["verify_cost_owner"] = verify_profile_bound_cost
    paid = compare_paid_t5_fusion_span_validation(threshold, study_owner, **comparison)
    current_profile()
    return {"schema": T5_FUSION_CREDIT_PROFILE_COMPARISON_SCHEMA,
            "estimator_profile_selection_sha256": profile_pin,
            "estimator_profile": estimator_profile_selection.estimator_profile,
            "original_paid_comparison_sha256": _commit(paid), "original_paid_comparison": paid}


def t5_fusion_upstream_costs_commitment(costs, *, study_sha256, matched_looks_sha256, cost_evidence_sha256):
    """Bind selected physical upstream closes and clock receipts to the paid look."""
    _need(all(_pin(pin) for pin in (study_sha256, matched_looks_sha256, cost_evidence_sha256))
          and type(costs) is tuple and bool(costs)
          and all(type(row) is T5FusionUpstreamCost and type(row.seed) is str and row.seed
                  and type(row.role) is str and row.role in _T5_FUSION_UPSTREAM_KINDS
                  and all(_pin(pin) for pin in (row.cohort_sha256, row.subject_sha256, row.event_sha256,
                                               row.close_receipt_sha256)) for row in costs),
          "exact fused T5 upstream cost roster required")
    return _commit((T5_FUSION_UPSTREAM_COST_SCHEMA, study_sha256, matched_looks_sha256, cost_evidence_sha256,
                    tuple(asdict(row) for row in costs)))


def _check_fused_development_phase_roster(row):
    started, early = row.started_development, row.pre_development_close_receipts
    interrupted = (row.interrupted_preparation if type(row) is T5FusionInterruptedPreparationPaidLook else (None, None))
    _need(type(started) is type(early) is type(interrupted) is tuple and len(started) == len(early) == len(interrupted) == 2,
          "fused DEVELOPMENT requires its exact two arm phase slots")
    if type(row) is T5FusionInterruptedPreparationPaidLook:
        _need(any(type(phase) is T5FusionInterruptedPreparation for phase in interrupted),
              "interrupted DEVELOPMENT requires a selected interrupted preparation phase")
    else:
        _need(any(type(phase) is T5FusionUngradedDevelopment for phase in started),
              "started fused DEVELOPMENT requires at least one ungraded preparation")
    for close, pre_dev, phase, partial in zip(row.unobserved, early, started, interrupted, strict=True):
        _need((phase is None or type(phase) is T5FusionUngradedDevelopment and partial is None)
              and (partial is None or type(partial) is T5FusionInterruptedPreparation),
              "each arm may retain only one exact ungraded DEVELOPMENT phase")
        if phase is not None or partial is not None:
            _need(pre_dev is None and type(close) is DecisionSpanUnobservedArm
                  and type(close.disposition) is str and close.disposition in ("budget_limit", "integrity_failure"),
                  "observed DEVELOPMENT work requires an exclusive ungraded phase and failed terminal disposition")
        else:
            _need(pre_dev is None if close is None else _pin(pre_dev),
                  "ungraded fused arm outside DEVELOPMENT requires an independent pre-DEVELOPMENT close")


def _require_fused_paid_outputs(link, dispatch):
    output = Path(dispatch.output_directory)
    _need(all(Path(link[role]["path"]) == output / name for role, name in (
        ("candidate", "policy-checkpoint.json"), ("model_checkpoint", "model.checkpoint"),
        ("optimizer_checkpoint", "optimizer.checkpoint"))),
        "fused paid assessment must use its original arm output artifacts")


def _fused_development_inputs(row):
    """Return prepared consumers in arm order after the paid role checks."""
    consumers = []
    for index, close in enumerate(row.unobserved):
        if close is None:
            consumers.append((index, row.policy_candidates[index],
                tuple(plans[index] for plans in row.component_plans),
                tuple(bindings[index] for bindings in row.component_teacher_bindings)))
        elif type(row) in _FUSED_PHASE_LOOK_TYPES and row.started_development[index] is not None:
            phase = row.started_development[index]
            consumers.append((index, phase.policy_candidate, phase.component_plans, phase.component_teacher_bindings))
    return tuple(consumers)


def _bind_fused_started_development(study_owner, study, row, validation):
    panel_pin = study_owner.commitment(study.panel)
    retention = next(seed.retention_reference_sha256 for seed in study.seeds if seed.identifier == row.seed)
    groups = tuple(validation["components"])
    result = {}
    for index, link, plans, bindings in _fused_development_inputs(row):
        phase = row.started_development[index]
        if phase is None:
            continue
        attempt, dispatch = row.policy_attempts[index], row.dispatches[index]
        _need(type(plans) is type(bindings) is tuple and len(plans) == len(bindings) == len(groups)
              and bool(groups) and all(type(plan) is T5FusionSpanValidationAssessment for plan in plans)
              and tuple(plan.dependency_group_sha256 for plan in plans) == groups
              and _pin(phase.owner_receipt_sha256),
              "ungraded fused DEVELOPMENT requires its exact prepared component roster and phase owner receipt")
        candidate_pin = _commit(link)
        for plan, binding in zip(plans, bindings, strict=True):
            _bind_decision_span_assessment_arm(plan, link, commitment(plan), candidate_pin, attempt, dispatch)
            _require_t5_fusion_assessment_role(plan, link, binding)
            teacher_rows, row_ids = binding["rows"], binding["row_ids"]
            expected_sources = validation["component_sources"][plan.dependency_group_sha256]
            _need(type(teacher_rows) in (tuple, list) and type(row_ids) in (tuple, list)
                  and all(type(source) is dict and set(source) == {"row_id", "source_wire_sha256",
                                     "source_span_sha256", "actual_fp32_slot_sha256", "slot_width"}
                          and _pin(source["actual_fp32_slot_sha256"])
                          and type(source["slot_width"]) is int and source["slot_width"] == attempt.fusion_slot_width
                          for source in teacher_rows)
                  and tuple(row_ids) == tuple(row_id for row_id, _, _ in expected_sources)
                  and tuple((source["row_id"], source["source_wire_sha256"], source["source_span_sha256"])
                            for source in teacher_rows) == expected_sources,
                  "ungraded fused teacher input must retain its exact frozen DEVELOPMENT source roster")
            _need((plan.look, plan.optimizer_steps, plan.development_split_sha256, plan.optimizer_step_grid_sha256,
                   plan.panel_sha256, plan.evaluation_policy_sha256, plan.retention_reference_sha256) == (
                      validation["look"], validation["step"], validation["split"]["selection_sha256"],
                      validation["step_grid_sha256"], panel_pin, study.evaluation_policy_sha256, retention),
                  "ungraded fused DEVELOPMENT differs from the frozen split, panel or reached step")
        _require_fused_paid_outputs(link, dispatch)
        training = link.get("owner_execution_record_sha256")
        closes = phase.component_execution_closes
        _need(_pin(training) and type(closes) is tuple
              and all(type(close) is T5FusionDevelopmentClose and _pin(close.owner_close_sha256)
                      and _pin(close.dependency_group_sha256) and close.dependency_group_sha256 in groups
                      and type(close.disposition) is str and close.disposition in study_owner.CLOSED_EVENT_OUTCOMES
                      for close in closes)
              and len({close.owner_close_sha256 for close in closes} | {training}) == len(closes) + 1,
              "ungraded fused DEVELOPMENT requires its own training close and distinct registered component closes")
        result[attempt.attempt_sha256] = {"seed": row.seed, "attempt_sha256": attempt.attempt_sha256,
            "owner_receipt_sha256": phase.owner_receipt_sha256, "training_close_sha256": training,
            "policy_candidate_sha256": candidate_pin,
            "component_execution_closes": tuple(asdict(close) for close in closes)}

    consumers = _fused_development_inputs(row)
    if len(consumers) == 2:
        (_, left, left_plans, left_bindings), (_, right, right_plans, right_bindings) = consumers
        links = left, right
        for plans, bindings in zip(zip(left_plans, right_plans, strict=True),
                                   zip(left_bindings, right_bindings, strict=True), strict=True):
            bind_decision_span_assessment_pair(plans, links,
                expected_assessment_sha256s=tuple(commitment(plan) for plan in plans),
                expected_policy_candidate_sha256s=tuple(_commit(link) for link in links),
                policy_attempts=row.policy_attempts, dispatches=row.dispatches,
                t5_fusion_assessment_bindings=bindings)
    return result


def _bind_fused_interrupted_preparation(study_owner, row, validation):
    reports = {}
    for index, phase in enumerate(row.interrupted_preparation):
        if phase is None:
            continue
        attempt, dispatch = row.policy_attempts[index], row.dispatches[index]
        link = phase.policy_candidate
        _need(_decision_span_policy_link(link, fused=True), "interrupted preparation requires its typed fused candidate")
        _require_selected_span_link(link, attempt, guided=False, fused=True)
        _need((link.get("study_sha256"), link.get("arm"), link.get("seed"), link.get("attempt_sha256"),
               link.get("policy_attempt_sha256"), _span_binding(link, False)["cohort_sha256"]) == (
                   attempt.study_sha256, attempt.arm, attempt.seed, attempt.attempt_sha256,
                   policy_attempt_commitment(attempt), decision_span_policy_cohort_commitment(attempt))
              and all(_artifact(link.get(role)) for role in ("candidate", "model_checkpoint", "optimizer_checkpoint"))
              and _pin(link.get("terminal_close_sha256")) and _pin(link.get("owner_execution_record_sha256"))
              and _pin(phase.owner_receipt_sha256),
              "interrupted preparation requires the original closed TRAIN candidate and separate phase proof")
        _require_fused_paid_outputs(link, dispatch)
        closes = phase.preparation_closes
        _need(type(closes) is tuple and bool(closes)
              and all(type(item) is T5FusionPreparationClose and _pin(item.event_sha256)
                      and _pin(item.owner_close_sha256) and _pin(item.dependency_group_sha256)
                      and item.dependency_group_sha256 in validation["component_sources"]
                      and _pin(item.source_roster_sha256) and type(item.interval) is study_owner.WallSpan
                      and type(item.disposition) is str and item.disposition in study_owner.CLOSED_EVENT_OUTCOMES
                      for item in closes)
              and len({item.event_sha256 for item in closes}) == len(closes),
              "interrupted preparation requires exact distinct closed work on the registered components")
        for item in closes:
            group = item.dependency_group_sha256
            scope = _commit(("reviewed-t5-fusion-interrupted-preparation-source-roster/v1",
                             attempt.study_sha256, validation["split"]["selection_sha256"], group,
                             validation["component_sources"][group]))
            _need(item.source_roster_sha256 == scope,
                  "interrupted preparation must retain its selected frozen DEVELOPMENT source roster")
        reports[attempt.attempt_sha256] = {"seed": row.seed, "attempt_sha256": attempt.attempt_sha256,
            "owner_receipt_sha256": phase.owner_receipt_sha256,
            "training_close_sha256": link["owner_execution_record_sha256"], "policy_candidate_sha256": _commit(link),
            "component_execution_closes": (), "preparation_closes": tuple(asdict(item) for item in closes)}
    return reports


def _fused_interrupted_events(matched_looks):
    events = {}
    for row in matched_looks:
        if type(row) is not T5FusionInterruptedPreparationPaidLook:
            continue
        for phase, attempt in zip(row.interrupted_preparation, row.policy_attempts, strict=True):
            if phase is None:
                continue
            for item in phase.preparation_closes:
                seed, original, consumers = events.setdefault(item.event_sha256, (row.seed, item, []))
                _need(seed == row.seed and original == item and attempt.attempt_sha256 not in consumers,
                      "shared interrupted preparation must retain a single exact physical event in its selected seed")
                consumers.append(attempt.attempt_sha256)
    return events


def _require_paid_ungraded_development(phase, events, charges):
    own_events = [(events[key], share) for key, share in charges.entries if key in events]
    paid_evaluations = {(event.close_receipt_sha256, event.disposition, share)
                        for event, share in own_events if event.kind == "evaluation"}
    expected_evaluations = {(item["owner_close_sha256"], item["disposition"], Fraction(1))
                            for item in phase["component_execution_closes"]}
    _need(paid_evaluations == expected_evaluations
          and any(event.kind == "training" and event.disposition == "complete"
                  and event.close_receipt_sha256 == phase["training_close_sha256"] and share == 1
                  for event, share in own_events),
          "ungraded DEVELOPMENT requires its exact exclusive paid training and component execution closes")


def _fused_upstream_subjects(matched_looks):
    scopes = {}
    for look in matched_looks:
        attempt = look.policy_attempts[0]
        cohort = decision_span_policy_cohort_commitment(attempt)
        pair = tuple(attempt.attempt_sha256 for attempt in look.policy_attempts)
        # Preparation covers both the original behavior batch in the completion
        # binding and the independently selected candidate batch/source handoff.
        training = _commit(("reviewed-t5-fusion-training-teacher-preparation/v1", attempt.candidate_batch_sha256,
                            attempt.candidate_source_binding_sha256, attempt.fusion_condition_sha256,
                            attempt.completion_binding_sha256))
        scopes[look.seed, "training_teacher_preparation"] = cohort, training, pair
        scopes[look.seed, "behavior_rollout"] = cohort, attempt.completion_binding_sha256, pair
        consumers = _fused_development_inputs(look)
        if consumers:
            plans = consumers[0][2]
            components = tuple((plan.dependency_group_sha256, plan.matched_teacher_inputs_sha256) for plan in plans)
            development = _commit(("reviewed-t5-fusion-development-teacher-preparation/v1", components))
            scopes[look.seed, "development_teacher_preparation"] = (
                cohort, development, tuple(pair[index] for index, *_ in consumers))
    return scopes


def _bind_fused_upstream_costs(study_owner, costs, matched_looks, events, observations, arm_closes,
                              started_development_receipts):
    upstream_kinds = set(_T5_FUSION_UPSTREAM_KINDS.values())
    upstream_events = {event_id for event_id, event in events.items() if event.kind in upstream_kinds}
    interrupted = _fused_interrupted_events(matched_looks)
    completed = {row.event_sha256 for row in costs}
    selected = completed | interrupted.keys()
    _need(upstream_events == selected and len(completed) == len(costs)
          and not completed.intersection(interrupted),
          "every physical fused teacher and rollout event needs one original upstream record")
    scopes = _fused_upstream_subjects(matched_looks)
    _need({(row.seed, row.role) for row in costs} == scopes.keys(),
          "fused first-use costs must cover every selected seed and upstream role")
    reserved_receipts = set(arm_closes)
    for interval, _ in observations:
        reserved_receipts.add(interval.scope_receipt_sha256)
        if type(interval.wall) is study_owner.WallSpan:
            reserved_receipts.add(interval.wall.receipt_sha256)
    phase_pins = [receipt for look in matched_looks for receipt in look.pre_development_close_receipts
                  if receipt is not None]
    phase_pins.extend(started_development_receipts)
    event_closes = {event.close_receipt_sha256 for event in events.values()}
    _need(len(set(phase_pins)) == len(phase_pins)
          and not set(phase_pins).intersection(reserved_receipts | event_closes),
          "fused DEVELOPMENT phase evidence cannot reuse other physical receipts")
    reserved_receipts.update(phase_pins)
    by_attempt, by_scope, shared = {}, {}, {}
    receipt_ids = set()
    report_rows = []
    interrupted_report = []

    def allocate(event, span, consumers):
        _need(type(span) is study_owner.WallSpan and _pin(span.clock_domain_sha256) and _pin(span.receipt_sha256)
              and type(span.start_ns) is type(span.end_ns) is int and 0 <= span.start_ns <= span.end_ns,
              "fused upstream work requires its original observed wall interval")
        own_receipts = {event.close_receipt_sha256, span.receipt_sha256}
        _need(len(own_receipts) == 2 and span.receipt_sha256 not in event_closes
              and not own_receipts.intersection(reserved_receipts | receipt_ids),
              "fused upstream interval and close cannot substitute for other physical receipts")
        receipt_ids.update(own_receipts)
        for attempt_sha in consumers:
            by_attempt.setdefault(attempt_sha, {})[event.event_sha256] = (Fraction(1, len(consumers)), span)
        if len(consumers) == 2:
            shared[event.event_sha256] = tuple(consumers)

    for row in costs:
        event, span = events[row.event_sha256], row.interval
        cohort, subject, consumers = scopes[row.seed, row.role]
        _need((row.cohort_sha256, row.subject_sha256) == (cohort, subject)
              and (event.kind, event.disposition, event.close_receipt_sha256)
                    == (_T5_FUSION_UPSTREAM_KINDS[row.role], "complete", row.close_receipt_sha256),
              "fused upstream work differs from the original selected teacher, rollout or development subject")
        allocate(event, span, consumers)
        by_scope.setdefault((row.seed, row.role), []).append(span)
        report_rows.append({**asdict(row), "consumer_attempt_sha256s": consumers,
                            "per_consumer_share": (1, len(consumers)), "cpu_ns": event.cpu_ns, "gpu_ns": event.gpu_ns})
    for key, (seed, item, consumers) in interrupted.items():
        event = events[key]
        _need(len(consumers) in (1, 2) and (event.kind, event.disposition, event.close_receipt_sha256) == (
            "teacher_production", item.disposition, item.owner_close_sha256),
            "interrupted preparation must reproduce its original physical kind, disposition and close")
        allocate(event, item.interval, consumers)
        interrupted_report.append({**asdict(item), "seed": seed, "consumer_attempt_sha256s": tuple(consumers),
            "per_consumer_share": (1, len(consumers)), "cpu_ns": event.cpu_ns, "gpu_ns": event.gpu_ns})
    for look in matched_looks:
        training = by_scope[look.seed, "training_teacher_preparation"]
        rollout = by_scope[look.seed, "behavior_rollout"]
        _need(max(span.end_ns for span in training) <= min(span.start_ns for span in rollout),
              "original fused training teacher preparation must close before behavior rollout")
    for interval, charges in observations:
        allocated = by_attempt.get(interval.attempt_sha256, {})
        _need(bool(allocated) and {event: share for event, share in charges.entries if event in selected}
              == {key: share for key, (share, _) in allocated.items()},
              "fused arm must charge its exact upstream share at every observed cut and close")
        spans = tuple(span for _, span in allocated.values())
        wall = interval.wall
        _need(type(wall) is study_owner.WallSpan and type(wall.start_ns) is type(wall.end_ns) is int
              and {span.clock_domain_sha256 for span in spans} == {wall.clock_domain_sha256}
              and wall.start_ns == min(span.start_ns for span in spans)
              and wall.end_ns >= max(span.end_ns for span in spans),
              "fused whole-arm wall must enclose all applicable upstream work in one observed clock")
    return shared, tuple(report_rows), tuple(interrupted_report)


def _compare_paid_span_validation(threshold, study_owner, *, study, expected_study_sha256, attempts,
        expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256, matched_looks,
        expected_matched_looks_sha256, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner,
        validation_split, policy, expected_validation_split_sha256, step_grid, guided,
        discovery_costs=None, expected_discovery_costs_sha256=None, fused=False,
        upstream_costs=None, expected_upstream_costs_sha256=None):
    study_owner._study(threshold, study, expected_study_sha256)
    _need(callable(verify_cost_owner), "independent policy VALIDATION cost owner required")

    def current_scope():
        return _decision_span_paid_validation_scope(study_owner, study, expected_study_sha256,
            validation_split, policy, expected_validation_split_sha256, step_grid)

    validation = current_scope()

    def verify(cost_pin, roster_pin, *discovery_pins):
        return verify_cost_owner(cost_pin, roster_pin, *discovery_pins) is True and current_scope() == validation

    return _compare_paid_decision_span(threshold, study_owner, study=study, expected_study_sha256=expected_study_sha256, attempts=attempts,
        expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, matched_looks=matched_looks,
        expected_matched_looks_sha256=expected_matched_looks_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify,
        validation=validation, guided=guided, discovery_costs=discovery_costs,
        expected_discovery_costs_sha256=expected_discovery_costs_sha256, fused=fused,
        upstream_costs=upstream_costs, expected_upstream_costs_sha256=expected_upstream_costs_sha256)


def _compare_paid_decision_span(threshold, study_owner, *, study, expected_study_sha256, attempts,
        expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256, matched_looks,
        expected_matched_looks_sha256, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner,
        validation=None, guided=False, discovery_costs=None, expected_discovery_costs_sha256=None,
        fused=False, upstream_costs=None, expected_upstream_costs_sha256=None):
    """Join matched policy observations to the existing verified first-use cost comparator.

    The cost owner verifies the committed paid events and matched look roster,
    including physical identities and paid intervals. This function never
    derives elapsed wall time from event counters.
    """
    study_owner._study(threshold, study, expected_study_sha256)
    arm_order = GUIDED_DECISION_SPAN_POLICY_ARMS if guided else DECISION_SPAN_POLICY_ARMS
    contrast_order = arm_order[::-1] if guided else arm_order
    attempt_type = (GuidedDecisionSpanPolicyAttempt if guided else
                    T5FusionDecisionSpanPolicyAttempt if fused else DecisionSpanPolicyAttempt)
    _need((not (guided or fused) or validation is not None) and not (guided and fused)
          and (fused or upstream_costs is None and expected_upstream_costs_sha256 is None)
          and study.cost_basis == "first_use"
          and tuple(arm for arm, _ in study.arms) == contrast_order
          and type(contrast_plan) is study_owner.ContrastPlan and type(contrast_plan.contrasts) is tuple
          and len(contrast_plan.contrasts) == 1 and type(contrast_plan.contrasts[0]) is study_owner.Contrast
          and (contrast_plan.contrasts[0].baseline, contrast_plan.contrasts[0].candidate,
               contrast_plan.contrasts[0].role) == (*contrast_order, "primary")
          and callable(verify_cost_owner),
          "exact control-to-guided first-use DEVELOPMENT study and cost owner required" if guided else
          "exact broadcast-to-scoped first-use study and cost owner required")
    def roster_commitment():
        if validation is None:
            return decision_span_paid_looks_commitment(matched_looks)
        binder = (guided_span_validation_paid_looks_commitment if guided else
                  t5_fusion_span_validation_paid_looks_commitment if fused else
                  decision_span_validation_paid_looks_commitment)
        return binder(matched_looks,
            validation_split_sha256=validation["split"]["selection_sha256"],
            step_grid_sha256=validation["step_grid_sha256"])

    _need(_pin(expected_matched_looks_sha256) and roster_commitment() == expected_matched_looks_sha256
          and type(attempts) is tuple and all(type(attempt) is study_owner.Attempt
              and type(attempt.assessments) is tuple
              and all(type(look) is study_owner.Assessment for look in attempt.assessments) for attempt in attempts)
          and study_owner.commitment(attempts) == expected_attempts_sha256,
          "independently selected paid attempts and matched look roster required")
    if validation is not None:
        _need(tuple(row.seed for row in matched_looks) == tuple(seed.identifier for seed in study.seeds),
              "paid VALIDATION selection requires one ordered pair for every registered seed")
        _need(len({attempt.closeout_receipt_sha256 for attempt in attempts}) == len(attempts),
              "paid VALIDATION attempts require distinct terminal receipts")
    by_cell = {(attempt.seed, attempt.arm): attempt for attempt in attempts}
    physical_looks = {(attempt.attempt_sha256, look.look): look for attempt in attempts for look in attempt.assessments}
    _need(len(by_cell) == len(attempts) and len(physical_looks) == sum(len(attempt.assessments) for attempt in attempts),
          "duplicate paid attempt or observed look")
    required, unattended, seeds, seed_owners, close_owners = {}, {}, {}, {}, {}
    has_trailing = any(type(row) is DecisionSpanTrailingPaidLook for row in matched_looks)
    tails, dispatches_by_arm, trailing_slots = {}, {}, set()
    evaluation_scopes = {}
    started_development, interrupted_preparation = {}, {}
    architecture_configuration = None
    for row in matched_looks:
        cells = tuple(by_cell.get((row.seed, arm)) for arm in arm_order)
        _need(all(attempt is not None for attempt in cells), "matched look names a foreign paid seed")
        if validation is not None:
            _need(type(row.policy_attempts) is tuple and len(row.policy_attempts) == 2
                  and all(type(attempt) is attempt_type
                          and attempt.initial_optimizer_steps + 1 == validation["step"]
                          for attempt in row.policy_attempts),
                  "paid VALIDATION pair must select the next registered step for both original attempts")
        if type(row) in (DecisionSpanAsymmetricPaidLook, DecisionSpanTrailingPaidLook,
                         DecisionSpanValidationPaidLook, GuidedSpanValidationPaidLook, *_FUSED_PAID_LOOK_TYPES):
            graded, omitted, row_tails = _bind_asymmetric_span_look(
                study_owner, row, expected_study_sha256, cells, physical_looks, schedule=study.schedule,
                validation=validation)
            if type(row) is DecisionSpanTrailingPaidLook:
                slot = row.seed, row.scheduled_look
                _need(slot not in trailing_slots, "duplicate selected trailing span slot")
                trailing_slots.add(slot)
                for attempt_sha, tail in row_tails:
                    _need(tails.setdefault(attempt_sha, tail) == tail,
                          "trailing span arm cannot change its graded prefix or unobserved suffix")
            for attempt_sha, close in omitted:
                _need(unattended.setdefault(attempt_sha, close) == close
                      and close_owners.setdefault(close[0], ("unobserved", attempt_sha)) == ("unobserved", attempt_sha),
                      "unobserved arm cannot change or reuse a physical close")
        else:
            graded = _bind_decision_span_paid_look(study_owner, row, expected_study_sha256, cells, physical_looks)
        if has_trailing:
            for index, (cell, policy, dispatch) in enumerate(zip(cells, row.policy_attempts, row.dispatches, strict=True)):
                scope = policy_attempt_commitment(policy), dispatch.commitment()
                _need(dispatches_by_arm.setdefault(cell.attempt_sha256, scope) == scope,
                      "trailing span look changed an original selected policy attempt or dispatch")
                if row.prepared[index] is not None:
                    # Each plan already passed the exact observed component join. Keep
                    # ordered input/loader commitments while candidate receipts vary.
                    plans = (component[index] for component in row.component_plans)
                    evaluation_scope = tuple((plan.route, plan.admission_version,
                                              plan.expected_inputs_sha256, plan.expected_assets_sha256)
                                             for plan in plans)
                    _need(evaluation_scopes.setdefault(row.seed, evaluation_scope) == evaluation_scope,
                          "matched span evaluation scope changed across graded looks")
        started = (_bind_fused_started_development(study_owner, study, row, validation)
                   if type(row) in _FUSED_PHASE_LOOK_TYPES and any(row.started_development) else {})
        interrupted = (_bind_fused_interrupted_preparation(study_owner, row, validation)
                       if type(row) is T5FusionInterruptedPreparationPaidLook else {})
        for attempt_sha, phase in (started | interrupted).items():
            _need(attempt_sha not in started_development and attempt_sha not in interrupted_preparation,
                  "duplicate ungraded fused DEVELOPMENT phase")
            receipts = (phase["training_close_sha256"],
                        *(item["owner_close_sha256"] for item in phase["component_execution_closes"]))
            for receipt in receipts:
                _need(receipt not in close_owners, "ungraded fused DEVELOPMENT work cannot reuse another arm close")
                close_owners[receipt] = ("ungraded_development", attempt_sha)
        started_development.update(started)
        interrupted_preparation.update(interrupted)
        for key, work in graded:
            _need(key not in required, "duplicate selected paid look")
            required[key] = work
            for index, close in enumerate(work):
                owner = ("training", key[0]) if index == 0 else ("evaluation", *key)
                _need(close_owners.setdefault(close, owner) == owner,
                      "physical training or evaluation close reused outside its selected arm and look")
        native = row.policy_attempts[0]
        architecture = (native.architecture, native.configuration_sha256)
        if architecture_configuration is None:
            architecture_configuration = architecture
        _need(architecture_configuration == architecture
              and seeds.setdefault(row.seed, native.seed) == native.seed
              and seed_owners.setdefault(native.seed, row.seed) == row.seed,
              "paid span study must retain one architecture configuration and distinct selected native seeds")
    _need(required.keys() == physical_looks.keys(), "matched evidence must cover every observed paid look")
    if unattended:
        _need(set(seeds) == {seed.identifier for seed in study.seeds}
              and unattended.keys() - tails.keys() == {attempt.attempt_sha256 for attempt in attempts if not attempt.assessments},
              "asymmetric selection must retain every seed and explicit paid zero-look close")
    if has_trailing:
        _need(tails.keys() == {attempt.attempt_sha256 for attempt in attempts
                               if 0 < len(attempt.assessments) < len(study.schedule)},
              "trailing selection must retain the verified close of every incomplete graded attempt")
        if study.required_streak > 1:
            _need(all(len({look.checkpoint_sha256 for look in attempt.assessments}) == len(attempt.assessments)
                      for attempt in attempts),
                  "multi-checkpoint span confirmation requires distinct graded checkpoints")

    tail_receipts = {unattended[attempt_sha][0]: attempt_sha for attempt_sha in tails}
    _need(all(attempt.attempt_sha256 == tail_receipts[attempt.closeout_receipt_sha256]
              for attempt in attempts if attempt.closeout_receipt_sha256 in tail_receipts),
          "trailing terminal receipt cannot name another attempt")

    _need(type(cost_evidence) is study_owner.CostEvidence and type(cost_evidence.observations) is tuple
          and study_owner.commitment(cost_evidence) == expected_cost_evidence_sha256,
          "exact selected physical cost evidence required")
    events = study_owner._event_roster(cost_evidence.events)
    terminal_roster = {attempt_sha: values[:2] for attempt_sha, values in unattended.items()}
    validation_terminal_receipts = set()
    if validation is not None:
        for attempt in attempts:
            if attempt.attempt_sha256 not in terminal_roster:
                _need(_pin(attempt.closeout_receipt_sha256)
                      and attempt.closeout_status in ("complete", "budget_limit", "integrity_failure"),
                      "graded VALIDATION attempts require an exact terminal close and disposition")
                terminal_roster[attempt.attempt_sha256] = attempt.closeout_receipt_sha256, attempt.closeout_status
        validation_terminal_receipts = {receipt for receipt, _ in terminal_roster.values()}
    upstream_kinds = set(_T5_FUSION_UPSTREAM_KINDS.values()) if fused else {"teacher_production"}
    verified_terminal = set()
    verified_started = set()
    ungraded_work = started_development | interrupted_preparation
    if ungraded_work:
        candidate_links = [link for row in matched_looks for _, link, _, _ in _fused_development_inputs(row)]
        candidate_links.extend(phase.policy_candidate for row in matched_looks
                               if type(row) is T5FusionInterruptedPreparationPaidLook
                               for phase in row.interrupted_preparation if phase is not None)
        if interrupted_preparation:
            _need(len({link["candidate"]["sha256"] for link in candidate_links}) == len(candidate_links),
                  "interrupted preparation requires distinct original candidate manifests across arms")
        candidate_closes = [link["terminal_close_sha256"] for link in candidate_links]
        native_closes = set(candidate_closes)
        _need(len(native_closes) == len(candidate_closes)
              and not native_closes.intersection(validation_terminal_receipts),
              "candidate trial and whole-arm terminal closes must be separate")
        _need(all(owner[0] != "ungraded_development" or receipt not in validation_terminal_receipts | native_closes
                  for receipt, owner in close_owners.items()),
              "ungraded DEVELOPMENT work must retain closes distinct from both terminal boundaries")
    for observation in cost_evidence.observations:
        _need(type(observation) is tuple and len(observation) == 2
              and type(observation[0]) is study_owner.MeterInterval
              and type(observation[1]) is study_owner.ChargeManifest,
              "typed paid interval and charge manifest required")
        interval, charges = observation
        if validation is not None and interval.stage != "close":
            _need(not any(event in events and events[event].close_receipt_sha256 in validation_terminal_receipts
                          for event, _ in charges.entries),
                  "VALIDATION terminal event cannot be charged at a graded look")
        if tail_receipts and interval.stage != "close":
            _need(not any(event in events and events[event].close_receipt_sha256 in tail_receipts
                          for event, _ in charges.entries),
                  "trailing terminal event cannot be charged at a graded look")
        if interval.stage == "close" and interval.attempt_sha256 in terminal_roster:
            terminal = terminal_roster[interval.attempt_sha256]
            non_teacher_required = validation is not None or interval.attempt_sha256 in tails
            _need(any(event in events and share == 1
                      and (not non_teacher_required or events[event].kind not in upstream_kinds)
                      and (events[event].close_receipt_sha256, events[event].disposition) == terminal
                      for event, share in charges.entries),
                  ("paid VALIDATION arm must charge its own exact terminal close" if validation is not None
                   else "trailing span arm must charge its own selected physical close" if interval.attempt_sha256 in tails
                   else "zero-look arm must charge its own selected physical close"))
            verified_terminal.add(interval.attempt_sha256)
        phase = ungraded_work.get(interval.attempt_sha256)
        if phase is not None and interval.stage == "close":
            _require_paid_ungraded_development(phase, events, charges)
            verified_started.add(interval.attempt_sha256)
        work = required.get((interval.attempt_sha256, interval.stage))
        if work is None:
            continue
        covered = {events[event].close_receipt_sha256 for event, share in charges.entries
                   if event in events and share == 1 and events[event].disposition == "complete"
                   and (validation is None or events[event].kind not in upstream_kinds)}
        _need(set(work) <= covered, "paid look must include its training and every graded evaluation close")

    _need(verified_terminal == terminal_roster.keys(),
          "every paid VALIDATION attempt needs its terminal paid meter" if validation is not None
          else "every unobserved span closure needs its terminal paid meter" if has_trailing
          else "every zero-look arm needs its terminal paid meter")

    _need(verified_started == ungraded_work.keys(),
          "every ungraded DEVELOPMENT phase requires the failed arm's own paid terminal cut")

    def current_discovery():
        if discovery_costs is None and expected_discovery_costs_sha256 is None:
            return ()
        _need(guided and _pin(expected_discovery_costs_sha256)
              and guided_preupdate_discovery_costs_commitment(discovery_costs, study_sha256=expected_study_sha256,
                  matched_looks_sha256=expected_matched_looks_sha256,
                  cost_evidence_sha256=expected_cost_evidence_sha256) == expected_discovery_costs_sha256,
              "independently selected guided discovery cost commitment required")
        return (expected_discovery_costs_sha256,)

    discovery_pins = current_discovery()
    discovery_report = _bind_guided_preupdate_discovery_costs(study_owner, discovery_costs or (), matched_looks,
        attempts, events, cost_evidence.observations,
        set(close_owners) | {receipt for receipt, _ in terminal_roster.values()})

    def current_upstream():
        if not fused:
            return ()
        _need(_pin(expected_upstream_costs_sha256)
              and t5_fusion_upstream_costs_commitment(upstream_costs, study_sha256=expected_study_sha256,
                  matched_looks_sha256=expected_matched_looks_sha256,
                  cost_evidence_sha256=expected_cost_evidence_sha256) == expected_upstream_costs_sha256,
              "independently selected fused T5 upstream cost commitment required")
        return (expected_upstream_costs_sha256,)

    upstream_pins = current_upstream()
    upstream_report = ()
    interrupted_report = ()
    shared_kwargs = {}
    if fused:
        reserved_receipts = set(close_owners) | validation_terminal_receipts
        if ungraded_work:
            reserved_receipts.update(native_closes)
            for attempt in attempts:
                meters = (*(look.meter for look in attempt.assessments), attempt.closing_meter)
                reserved_receipts.update((attempt.cap_receipt_sha256, *(meter.record_sha256 for meter in meters)))
                reserved_receipts.update(receipt for meter in meters for receipt in meter.clock_receipts)
        shared, upstream_report, interrupted_report = _bind_fused_upstream_costs(study_owner, upstream_costs,
            matched_looks, events, cost_evidence.observations, reserved_receipts,
            (phase["owner_receipt_sha256"] for phase in ungraded_work.values()))
        interrupted_shared = tuple(sorted(row["event_sha256"] for row in interrupted_report if row["event_sha256"] in shared))
        if interrupted_shared:
            shared_pin = study_owner.first_use_shared_work_commitment(shared,
                interrupted_preparation_events=interrupted_shared)
            shared_kwargs["first_use_interrupted_preparation_events"] = interrupted_shared
        else:
            shared_pin = study_owner.first_use_shared_work_commitment(shared)
        shared_kwargs.update(first_use_shared_work=shared, expected_first_use_shared_work_sha256=shared_pin)

    def verify(cost_sha, *allocation_pins):
        return (allocation_pins == ((shared_pin,) if fused else ())
                and verify_cost_owner(cost_sha, expected_matched_looks_sha256, *discovery_pins, *upstream_pins) is True
                and roster_commitment() == expected_matched_looks_sha256
                and current_discovery() == discovery_pins and current_upstream() == upstream_pins)

    report = study_owner._compare_verified_contrasts(threshold, study=study,
        expected_study_sha256=expected_study_sha256, attempts=attempts,
        expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify,
        exclusive_non_teacher_work=True, **shared_kwargs)
    current_discovery()
    current_upstream()
    if ungraded_work:
        _need(roster_commitment() == expected_matched_looks_sha256,
              "selected ungraded DEVELOPMENT receipts changed during evaluation")
    prefix = "guided_span" if guided else "t5_fusion_span" if fused else "decision_span"
    result = {**report, f"{prefix}_paid_looks_sha256": expected_matched_looks_sha256,
              f"{prefix}_seed_bindings": tuple(seeds.items())}
    if validation is not None:
        result["schema"] = (GUIDED_SPAN_PAID_VALIDATION_SCHEMA if guided else
                            T5_FUSION_PAID_VALIDATION_SCHEMA if fused else DECISION_SPAN_PAID_VALIDATION_SCHEMA)
        result[f"{prefix}_validation"] = {"split_selection_sha256": validation["split"]["selection_sha256"],
            "global_split_sha256": validation["split"]["global_split_sha256"],
            "reserved_final_count": validation["split"]["reserved_final_count"],
            "optimizer_step_grid_sha256": validation["step_grid_sha256"],
            "optimizer_steps": validation["step"], "role": "development"}
    if fused:
        result.update(t5_fusion_upstream_costs_sha256=expected_upstream_costs_sha256,
                      t5_fusion_upstream_costs=upstream_report,
                      t5_fusion_span_cost_scope="observed_elapsed_and_conserved_allocated_cpu_gpu_for_original_matched_work")
        reports = tuple(report for row in matched_looks for report in row.gate_reports if report is not None)
        if reports and all(report.get("source_admission_evidence_kind") == "native_reviewed" for report in reports):
            result["source_admission_evidence_kind"] = "native_reviewed"
    if started_development:
        result.update(schema=T5_FUSION_STARTED_DEVELOPMENT_PAID_VALIDATION_SCHEMA,
                      t5_fusion_span_started_development=tuple(started_development.values()))
    if interrupted_preparation:
        result.update(schema=T5_FUSION_INTERRUPTED_PREPARATION_PAID_VALIDATION_SCHEMA,
                      t5_fusion_span_interrupted_preparation=tuple(interrupted_preparation.values()),
                      t5_fusion_span_interrupted_preparation_costs=interrupted_report)
    if guided:
        result["guided_span_upstream_activation_discovery_cost_verified"] = bool(discovery_report)
    if discovery_report:
        result.update(schema=GUIDED_SPAN_DISCOVERY_PAID_VALIDATION_SCHEMA,
                      guided_span_discovery_costs_sha256=expected_discovery_costs_sha256,
                      guided_span_discovery_costs=discovery_report,
                      guided_span_cost_scope="guided_discovery_plus_attempt_versus_recorded_control_attempt")
    if has_trailing:
        result["decision_span_evaluation_scope_sha256s"] = tuple(
            (seed, _commit(("reviewed-decision-span-fixed-evaluation/v1", scope)))
            for seed, scope in sorted(evaluation_scopes.items()))
    zero_look = unattended.keys() - tails.keys()
    if zero_look:
        result[f"{prefix}_unobserved_arms"] = tuple({"attempt_sha256": attempt_sha,
            "owner_close_sha256": close, "paid_event_disposition": disposition, "reason": reason}
            for attempt_sha, (close, disposition, reason) in unattended.items() if attempt_sha in zero_look)
    if tails:
        result["decision_span_trailing_closes"] = tuple({"attempt_sha256": attempt_sha,
            "owner_close_sha256": unattended[attempt_sha][0], "disposition": unattended[attempt_sha][1],
            "graded_prefix": prefix, "unobserved_suffix": suffix}
            for attempt_sha, (prefix, suffix) in tails.items())
    return result


ARMED_LOOK_SCHEMA = "reviewed-relational-armed-heldout-threshold-look/v1"


@dataclass(frozen=True)
class ArmedAttempt:
    """The study owner's pre-outcome label for one selected physical trial."""

    study_sha256: str
    arm: str
    seed: str
    packet_sha256: str
    trial_sha256: str


def armed_attempt_commitment(selection):
    _need(type(selection) is ArmedAttempt
          and all(_pin(value) for value in (selection.study_sha256, selection.packet_sha256, selection.trial_sha256))
          and all(type(value) is str and 0 < len(value) <= 512 for value in (selection.arm, selection.seed)),
          "exact preselected study arm, seed, packet and trial required")
    return _commit((ARMED_LOOK_SCHEMA, "armed-attempt", asdict(selection)))


def prepare_armed_threshold_look(threshold, study_owner, *, study, expected_study_sha256, policy, retention,
                                 review, expected_review_sha256, components, verify_review_owner,
                                 selection, expected_selection_sha256, packet, assessment_plans,
                                 verify_selection_owner):
    """Verify a pre-outcome armed held-out look with the existing route."""
    return _prepare_armed_threshold_look(threshold, study_owner, study=study,
        expected_study_sha256=expected_study_sha256, policy=policy, retention=retention, review=review,
        expected_review_sha256=expected_review_sha256, components=components, verify_review_owner=verify_review_owner,
        selection=selection, expected_selection_sha256=expected_selection_sha256, packet=packet,
        assessment_plans=assessment_plans, verify_selection_owner=verify_selection_owner, development=None)


def _prepare_armed_threshold_look(threshold, study_owner, *, study, expected_study_sha256, policy, retention,
                                  review, expected_review_sha256, components, verify_review_owner,
                                  selection, expected_selection_sha256, packet, assessment_plans,
                                  verify_selection_owner, development, step_grid=None):
    """Verify a pre-outcome packet-to-study mapping before attaching the existing meter.

    The selection owner authenticates the pre-outcome mapping. The existing
    review owner still authenticates component and trial closures and findings.
    """
    from . import relational_arming as arming

    routes = {arming.geometry.QWEN: QWEN, arming.geometry.T5: T5}
    _need(_pin(expected_selection_sha256) and callable(verify_selection_owner),
          "independent pre-outcome selection authority required")

    def current():
        _need(armed_attempt_commitment(selection) == expected_selection_sha256
              and arming.packet_commitment(packet) == selection.packet_sha256
              and type(review) is GateReview
              and (review.study_sha256, review.arm, review.seed)
                  == (expected_study_sha256, selection.arm, selection.seed)
              and selection.study_sha256 == expected_study_sha256,
              "preselected packet, study arm or seed differs")
        indices = tuple(index for index, entry in enumerate(packet.trials)
                        if arming.trial.commitment(entry) == selection.trial_sha256)
        _need(len(indices) == 1, "selected native trial must occur exactly once in the packet")
        index = indices[0]
        entry = packet.trials[index]
        job = _evidence_json(packet.specs[index], 1024**2)
        student_profile = arming.JOB_GEOMETRY[job["schema_version"]]
        _need(student_profile in routes, "unsupported armed assessment route")
        route = routes[student_profile]
        _need(entry.study_sha256 == expected_study_sha256 and entry.arm_recipe_sha256 == review.recipe_sha256
              and job.get("admission_profile") == "complete-reviewed-mixed-sort-norm-admission/v3",
              "selected native trial has a different study, recipe or admission profile")
        _need(type(assessment_plans) is type(components) is tuple and 0 < len(assessment_plans) == len(components)
              and all(type(component) is tuple and len(component) == 2 and type(component[0]) is dict
                      for component in components),
              "exact ordered assessment plans and saved components required")
        plan_pins = []
        groups = tuple(_heldout_groups(policy, study)) if development is not None else ()
        _need(development is None or len(groups) == len(assessment_plans),
              "native development plans must cover the complete selected component roster")
        step_bound = _scheduled_development_plan(assessment_plans[0])
        native_type = type(assessment_plans[0]) if step_bound else DevelopmentAssessment
        retrospective = native_type is RetrospectiveDevelopmentAssessment
        archived_capture = _archived_capture_metadata(components[0][0])
        _need(archived_capture is None or retrospective,
              "archived capture observation requires the retrospective development plan")
        if step_bound:
            _scheduled_optimizer_step(assessment_plans[0], step_grid, study_owner)
            _need(tuple(label for label, _ in step_grid.steps) == study.schedule,
                  "development look grid must retain the exact preregistered study schedule")
        step_progress = None
        scheduled_checkpoint = None
        for index, (plan, (observation, saved)) in enumerate(zip(assessment_plans, components, strict=True)):
            if development is None:
                _need(type(plan) is Assessment, "native development requires the frozen development look route")
            else:
                _need(type(plan) is native_type
                      and plan.development_split_sha256 == development["selection_sha256"]
                      and plan.armed_attempt_sha256 == expected_selection_sha256
                      and plan.dependency_group_sha256 == groups[index],
                      "native development plan differs from the exact armed component")
            plan_pin = commitment(plan)
            _scheduled_optimizer_step(plan, step_grid, study_owner)
            _need(("scheduled_checkpoint" in observation) == retrospective,
                  "scheduled checkpoint observation requires the retrospective development plan")
            _need(_archived_capture_metadata(observation) == archived_capture,
                  "all development components must agree on the exact archived capture scope")
            if retrospective:
                pins = _scheduled_checkpoint_pins(plan.scheduled_checkpoint)
                _need((scheduled_checkpoint is None or pins == scheduled_checkpoint)
                      and observation["scheduled_checkpoint"] == pins,
                      "all development components must bind the same exact scheduled checkpoint closure")
                scheduled_checkpoint = pins
            if step_bound:
                bound = plan.optimizer_step_grid_sha256, plan.optimizer_steps
                _need((step_progress is None or bound == step_progress)
                      and observation.get("optimizer_step_grid_sha256") == bound[0]
                      and type(observation.get("optimizer_steps")) is int and observation["optimizer_steps"] == bound[1],
                      "all components must close at the same preregistered optimizer step and grid")
                step_progress = bound
            _need(plan_pin == observation.get("assessment_sha256")
                  and (plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256, plan.route, plan.admission_version)
                      == (entry.study_sha256, entry.arm, entry.seed, entry.attempt_sha256, route, "v3")
                  and all(observation.get(key) == getattr(plan, key) for key in (
                      "study_sha256", "arm", "seed", "attempt_sha256", "look", "candidate_sha256",
                      "trial_terminal_close_sha256", "panel_sha256", "evaluation_policy_sha256",
                      "retention_reference_sha256", "route"))
                  and type(observation.get("seed")) is int,
                  "component does not bind the exact armed attempt, assessment plan or route")
            metadata = saved.get("metadata") if type(saved) is dict else None
            observed = metadata.get("source_generation_observation") if type(metadata) is dict else None
            declaration = observed.get("input_commitment") if type(observed) is dict else None
            _need(type(declaration) is dict and type(job.get("backend_identity")) is dict
                  and type(job.get("expected_source_sha256")) is dict
                  and declaration.get("backend_identity") == job["backend_identity"]
                  and declaration.get("source_sha256") == job["expected_source_sha256"]
                  and _pin(declaration.get("admission_inputs_sha256")),
                  "saved producer backend or Source differs from the selected armed job")
            generation_policy = declaration.get("generation_policy")
            _need("generation_policy" in declaration and
                  (generation_policy is None if route == T5 else type(generation_policy) is dict
                   and generation_policy.get("schema") == "reviewed-decoder-digest-omitted-terminal-generation-policy/v1"),
                  "saved producer generation policy differs from the selected armed route")
            plan_pins.append(plan_pin)
        armed = {"selection_sha256": expected_selection_sha256, "packet_sha256": selection.packet_sha256,
                "trial_sha256": selection.trial_sha256, "recipe_sha256": entry.arm_recipe_sha256,
                "job_sha256": entry.job_sha256, "configuration_sha256": entry.configuration_sha256,
                "prepared_inputs_sha256": entry.prepared_inputs_sha256, "route": route,
                "admission_version": "v3",
                "assessment_sha256s": tuple(plan_pins)}
        return armed, step_progress, scheduled_checkpoint, archived_capture

    evidence = current()
    _need(verify_selection_owner(expected_selection_sha256) is True,
          "pre-outcome study arm mapping was not independently approved")
    _need(current() == evidence, "selected armed look changed during mapping verification")
    prepared, report = _prepare_threshold_look(threshold, study_owner, study=study,
        expected_study_sha256=expected_study_sha256, policy=policy, retention=retention, review=review,
        expected_review_sha256=expected_review_sha256, components=components, verify_review_owner=verify_review_owner,
        development=development)
    _need(current() == evidence, "selected armed look changed during review verification")
    armed, step_progress, scheduled_checkpoint, archived_capture = evidence
    report.update(schema=ARMED_LOOK_SCHEMA, armed_attempt=armed)
    if step_progress is not None:
        report.update(optimizer_step_grid_sha256=step_progress[0], optimizer_steps=step_progress[1])
    if scheduled_checkpoint is not None:
        report["scheduled_checkpoint"] = scheduled_checkpoint
    if archived_capture is not None:
        report["archived_capture"] = archived_capture
    return replace(prepared, evaluation_receipt_sha256=_commit(report)), report


DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-development-threshold-look/v1"
NATIVE_DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-native-development-threshold-look/v1"
SCHEDULED_NATIVE_DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-step-bound-native-development-threshold-look/v1"
RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-retrospective-native-development-threshold-look/v1"


@dataclass(frozen=True)
class DevelopmentSplit:
    study_sha256: str
    policy_sha256: str
    prepared: dict
    origin_proof: dict
    manifest: dict
    case_aliases: tuple[tuple[str, str], ...]  # Native evaluator row to global split sample.


def development_split_commitment(value):
    _need(type(value) is DevelopmentSplit and _pin(value.study_sha256) and _pin(value.policy_sha256)
          and type(value.prepared) is type(value.origin_proof) is type(value.manifest) is dict
          and type(value.case_aliases) is tuple and bool(value.case_aliases)
          and all(type(pair) is tuple and len(pair) == 2
                  and all(type(key) is str and bool(key) for key in pair) for pair in value.case_aliases),
          "exact global study split and ordered development aliases required")
    return _commit((DEVELOPMENT_LOOK_SCHEMA, asdict(value)))


_SPLIT_PROFILE_FIELDS = ("campaign_split_profile", "unicode_data_version")


def _split_fingerprint(split_owner, example, sample_id, text, *, split_metadata=None):
    _need(type(text) is str and bool(text), "exact source text is required for split replay")
    if split_metadata is not None and any(key in split_metadata for key in _SPLIT_PROFILE_FIELDS):
        fingerprint = split_owner.legal_ir_split_source_fingerprint(text, metadata=split_metadata)
    else:
        actual = split_owner.LegalIRSplitExample.from_sample({"sample_id": sample_id, "text": text})
        fingerprint = actual.content_hash, actual.token_fingerprint
    _need((example.content_hash, example.token_fingerprint) == fingerprint,
          "source text differs from the frozen split fingerprint")


def _component_split_profile_matches(component, global_split):
    marked = {key: component.metadata[key] for key in _SPLIT_PROFILE_FIELDS if key in component.metadata}
    selected = {key: global_split.metadata[key] for key in _SPLIT_PROFILE_FIELDS if key in global_split.metadata}
    return not marked or marked == selected


def _development_scope(development, expected_development_sha256, *, expected_study_sha256, policy,
                       packet, selection):
    from . import legal_ir_eval_splits as splits, relational_arming as arming, relational_sources as sources
    from .teacher_prefix import population_commit

    _need(_pin(expected_development_sha256)
          and development_split_commitment(development) == expected_development_sha256
          and development.study_sha256 == expected_study_sha256
          and development.policy_sha256 == gate_policy_commitment(policy)
          and type(selection) is ArmedAttempt and arming.packet_commitment(packet) == selection.packet_sha256,
          "independently selected study split, policy and armed packet required")
    chosen = tuple(entry for entry in packet.trials if arming.trial.commitment(entry) == selection.trial_sha256)
    _need(len(chosen) == 1 and chosen[0].study_sha256 == expected_study_sha256
          and chosen[0].prepared_inputs_sha256 == development.prepared.get("prepared_sha256"),
          "split proof does not bind the exact selected TRAIN preparation")
    plans = tuple(batch.geometry_plan for batch in packet.trials[1].batches)
    population = plans[0].population
    population_sha256 = population_commit(population, maximum_rows=4096)
    _need(all(plan.population_sha256 == population_sha256 and plan.population == population for plan in plans),
          "one complete shared split population required for the selected packet")
    cohort = sources.training_cohort_commitment(development.prepared, development.origin_proof, population,
        expected_prepared_sha256=chosen[0].prepared_inputs_sha256,
        expected_origin_proof_sha256=_commit(development.origin_proof))
    origin = development.origin_proof
    _need(origin.get("study_sha256") == expected_study_sha256
          and origin.get("parent_sha256") == chosen[0].parent_manifest_sha256
          and type(origin.get("job_seed")) is int and origin["job_seed"] == chosen[0].seed
          and tuple(_commit((step["row_ids"], step["records_sha256"])) for step in origin["scheduled_batches"])
              == tuple(_commit((step.row_ids, step.records_sha256)) for step in chosen[0].batches),
          "split origin differs from the selected parent, seed or complete TRAIN schedule")

    manifest_sha256 = _commit(development.manifest)
    _need(manifest_sha256 == development.prepared["receipt"].get("split_manifest_sha256"),
          "global manifest differs from the actual prepared TRAIN split")
    scope, manifest, examples, members, crosswalk = _development_population_scope(
        development.manifest, population, development.case_aliases, policy,
        expected_development_sha256=expected_development_sha256, manifest_sha256=manifest_sha256)
    scope["train_cohort_sha256"] = cohort
    train_occurrences = set()
    for row in development.prepared["records"]:
        source = _evidence_json(row["source_wire"].encode("utf-8"), 64*1024**2)
        _split_fingerprint(splits, examples[row["id"]], row["id"], source["source_text"], split_metadata=manifest.metadata)
        train_occurrences.add(source["source_binding"]["occurrence_cid"])

    return scope, manifest, examples, members, crosswalk, train_occurrences


def _development_population_scope(manifest_mapping, population, aliases, policy, *,
                                  expected_development_sha256, manifest_sha256):
    from . import legal_ir_eval_splits as splits
    from .teacher_prefix import population_commit

    manifest = splits.LegalIRSplitManifest.from_mapping(manifest_mapping)
    population_sha256 = population_commit(population, maximum_rows=4096)
    normalized = manifest.to_dict()
    examples = {example.sample_id: example for example in manifest.examples}
    members = {member.row_id: member for member in population}
    roles = {"train": splits.TRAIN_SPLIT, "development": splits.VALIDATION_SPLIT, "final": splits.HOLDOUT_SPLIT}
    _need(normalized == manifest_mapping and normalized["legal_ir_split_guard"]["passed"] is True
          and manifest.protected_splits == splits.PROTECTED_LEGAL_IR_SPLITS
          and manifest.partition_names == splits.LEGAL_IR_EVAL_SPLITS
          and set(examples) == set(manifest.assignments) == set(members)
          and {member.partition for member in population} == set(roles)
          and all(manifest.assignments[key] == roles[member.partition] for key, member in members.items()),
          "global split lacks canonical leakage protection or exact TRAIN, development and final roles")

    lineage_groups = {}
    for sample_id, example in examples.items():
        if example.lineage_group_id:
            group = members[sample_id].dependency_group
            _need(lineage_groups.setdefault(example.lineage_group_id, group) == group,
                  "packet population splits a frozen manifest lineage")

    native_ids = tuple(case.row_id for case in policy.cases)
    mapped_ids = tuple(sample for _, sample in aliases)
    _need(tuple(row for row, _ in aliases) == native_ids and len(set(mapped_ids)) == len(mapped_ids)
          and all(sample in members and members[sample].partition == "development" for sample in mapped_ids),
          "scheduled evaluator aliases must map uniquely to frozen development samples")
    crosswalk = dict(aliases)
    by_group = {}
    for case in policy.cases:
        member = members[crosswalk[case.row_id]]
        _need(case.source_wire_sha256 == member.source_wire_sha256,
              "development alias differs from its frozen source wire")
        by_group.setdefault(case.dependency_group_sha256, []).append(member)
    members_by_group = {}
    for member in population:
        members_by_group.setdefault(member.dependency_group, set()).add(member.row_id)
    selected_groups = set()
    for linked in by_group.values():
        groups = {member.dependency_group for member in linked}
        _need(len(groups) == 1, "one native component cannot mix frozen dependency groups")
        group, = groups
        _need(group not in selected_groups and {member.row_id for member in linked} == members_by_group[group],
              "native development component must cover exactly one complete frozen dependency group")
        selected_groups.add(group)

    scope = {"selection_sha256": expected_development_sha256, "role": "development",
             "global_split_sha256": manifest_sha256, "population_sha256": population_sha256,
             "case_aliases": aliases,
             "reserved_final_count": len(manifest.samples_by_split[splits.HOLDOUT_SPLIT])}
    return scope, manifest, examples, members, crosswalk


def _development_evidence(development, expected_development_sha256, *, expected_study_sha256, policy,
                          packet, selection, components):
    resolved = _development_scope(development, expected_development_sha256,
        expected_study_sha256=expected_study_sha256, policy=policy, packet=packet, selection=selection)
    _validate_development_references(components, policy, resolved)
    return resolved[0]


def _validate_development_references(components, policy, resolved):
    _, manifest, examples, members, crosswalk, train_occurrences = resolved
    native_ids = tuple(case.row_id for case in policy.cases)
    references = {}
    _need(type(components) is tuple, "exact ordered development component closes required")
    for component in components:
        _need(type(component) is tuple and len(component) == 2 and type(component[1]) is dict,
              "exact ordered development component closes required")
        artifact = component[1].get("compiler_artifact", {})
        payload = artifact.get("reviewed_source_span_producer_evaluation", {}) if type(artifact) is dict else {}
        rows = payload.get("reference_population") if type(payload) is dict else None
        _need(type(rows) is list and all(type(row) is dict and type(row.get("id")) is str for row in rows),
              "complete development references required for split replay")
        for row in rows:
            _need(row["id"] not in references, "duplicate development reference")
            references[row["id"]] = row
    _need(references.keys() == set(native_ids), "saved development references differ from the frozen panel")
    for case in policy.cases:
        _development_reference(case, references[case.row_id], members[crosswalk[case.row_id]],
                               examples[crosswalk[case.row_id]], train_occurrences, split_metadata=manifest.metadata)


def _development_reference(case, row, member, example, train_occurrences, *, split_metadata=None):
    from . import legal_ir_eval_splits as splits

    target = row.get("canonical_ir")
    binding = target.get("source_binding") if type(target) is dict else None
    text = row.get("source_text")
    _need(type(binding) is dict and type(binding.get("occurrence_cid")) is str
          and binding["occurrence_cid"] not in train_occurrences
          and _commit(binding) == case.source_binding_sha256 and _commit(target) == case.reference_sha256
          and row.get("unit_id") == case.unit_id
          and type(text) is str and _sha(text.encode("utf-8")) == member.source_span_sha256,
          "development source occurrence overlaps TRAIN or differs from its frozen span")
    _split_fingerprint(splits, example, member.row_id, text, split_metadata=split_metadata)


@dataclass(frozen=True)
class DevelopmentScoring:
    split: DevelopmentSplit
    policy: GatePolicy
    packet: object
    attempt: ArmedAttempt


@dataclass(frozen=True)
class DecisionSpanValidationSplit:
    study_sha256: str
    policy_sha256: str
    manifest: dict
    population: tuple
    case_aliases: tuple[tuple[str, str], ...]
    train_occurrences: tuple[tuple[str, str], ...]


def decision_span_validation_split_commitment(value):
    from .teacher_prefix import population_commit

    _need(type(value) is DecisionSpanValidationSplit and _pin(value.study_sha256) and _pin(value.policy_sha256)
          and type(value.manifest) is dict
          and all(type(rows) is tuple and bool(rows)
                  and all(type(pair) is tuple and len(pair) == 2
                          and all(type(item) is str and 0 < len(item) <= 4096 for item in pair) for pair in rows)
                  and len({key for key, _ in rows}) == len(rows)
                  for rows in (value.case_aliases, value.train_occurrences)),
          "exact policy validation split, aliases and owner-bound TRAIN occurrence roster required")
    population_pin = population_commit(value.population, maximum_rows=4096)
    _need({row for row, _ in value.train_occurrences} == {
        member.row_id for member in value.population if member.partition == "train"},
          "policy validation TRAIN occurrence roster must exhaust the frozen TRAIN partition")
    return _commit((DECISION_SPAN_VALIDATION_SPLIT_SCHEMA, value.study_sha256, value.policy_sha256,
                    _commit(value.manifest), population_pin, value.case_aliases, value.train_occurrences))


@dataclass(frozen=True)
class DecisionSpanValidationScoring:
    split: DecisionSpanValidationSplit
    policy: GatePolicy
    verify_training_owner: Callable[[str, str, str, str], bool]


def _decision_span_validation_scope(plan, selection, scoring):
    expected_attempt = _span_attempt_type(plan)
    _need(_span_validation_assessment(plan) and type(selection) is expected_attempt
          and type(scoring) is DecisionSpanValidationScoring and type(scoring.policy) is GatePolicy
          and decision_span_validation_split_commitment(scoring.split) == plan.development_split_sha256
          and policy_attempt_commitment(selection) == plan.policy_attempt_sha256
          and (selection.study_sha256, selection.arm, selection.seed, selection.attempt_sha256)
              == (plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256)
          and plan.optimizer_steps == selection.initial_optimizer_steps + 1
          and scoring.split.study_sha256 == plan.study_sha256
          and gate_policy_commitment(scoring.policy) == scoring.split.policy_sha256 == plan.evaluation_policy_sha256
          and _commit(tuple((case.row_id, case.dependency_group_sha256, case.language)
                            for case in scoring.policy.cases)) == plan.panel_sha256,
          "policy validation requires the original policy attempt, next optimizer step, split and grading panel")
    split = scoring.split
    scope, manifest, examples, members, crosswalk = _development_population_scope(
        split.manifest, split.population, split.case_aliases, scoring.policy,
        expected_development_sha256=plan.development_split_sha256, manifest_sha256=_commit(split.manifest))
    scope["policy_training_scope_sha256"] = selection.training_scope_sha256
    return scope, manifest, examples, members, crosswalk, {occurrence for _, occurrence in split.train_occurrences}


def _verify_decision_span_validation_owner(plan, selection, scoring):
    verifier = scoring.verify_training_owner
    _need(callable(verifier) and verifier(plan.policy_attempt_sha256, selection.owner_request_sha256,
          selection.training_scope_sha256, plan.development_split_sha256) is True,
          "independent owner must bind the original policy TRAIN scope to this exact split and component roster")

def _native_development_inputs(plan, selection, inputs, choice):
    from . import legal_ir_eval_splits as splits, relational_trial

    _need(type(choice) is DevelopmentScoring and type(choice.policy) is GatePolicy
          and type(choice.attempt) is ArmedAttempt
          and armed_attempt_commitment(choice.attempt) == plan.armed_attempt_sha256
          and relational_trial.commitment(selection.trial) == choice.attempt.trial_sha256
          and choice.attempt.study_sha256 == plan.study_sha256
          and choice.split.policy_sha256 == plan.evaluation_policy_sha256
          and _commit(tuple((item.row_id, item.dependency_group_sha256, item.language)
                            for item in choice.policy.cases)) == plan.panel_sha256,
          "native development scoring differs from the frozen study, attempt or panel")
    resolved = _development_scope(choice.split, plan.development_split_sha256,
        expected_study_sha256=plan.study_sha256, policy=choice.policy, packet=choice.packet, selection=choice.attempt)
    return _validate_development_component(plan, inputs, choice.policy, resolved, allow_global_manifest=True)


def _validate_development_component(plan, inputs, policy, resolved, *, allow_global_manifest=False):
    return _validate_development_component_for_group(plan.dependency_group_sha256, inputs, policy, resolved,
                                                     allow_global_manifest=allow_global_manifest)


def _validate_development_component_for_group(group, inputs, policy, resolved, *, allow_global_manifest=False):
    from . import legal_ir_eval_splits as splits

    scope, manifest, examples, members, crosswalk, train_occurrences = resolved
    cases = tuple(case for case in policy.cases if case.dependency_group_sha256 == group)
    rows = inputs.get("rows")
    local = inputs.get("split_manifest")
    _need(cases and type(rows) is list and len(rows) == len(cases)
          and all(type(row) is dict for row in rows)
          and tuple(row.get("id") for row in rows) == tuple(case.row_id for case in cases)
          and type(local) is dict and all(case.split_sha256 == _commit(local) for case in cases),
          "exact approved development component rows and validation manifest required")
    local_manifest = splits.LegalIRSplitManifest.from_mapping(local)
    native_examples = {example.sample_id: example for example in local_manifest.examples}
    _need(local_manifest.to_dict() == local and local_manifest.guard_result().passed
          and local_manifest.config_digest == manifest.config_digest
          and local_manifest.protected_splits == manifest.protected_splits
          and local_manifest.partition_names == manifest.partition_names
          and _component_split_profile_matches(local_manifest, manifest)
          and ((allow_global_manifest and local == manifest.to_dict())
               or set(native_examples) == set(local_manifest.assignments) == {case.row_id for case in cases}),
          "development requires the exact global split or a validation-only component projection")
    splits.require_hparam_selection_split(local_manifest, [{"sample_id": case.row_id} for case in cases])
    for case, row in zip(cases, rows, strict=True):
        sample = crosswalk[case.row_id]
        example = examples[sample]
        _need(native_examples.get(case.row_id) == replace(example, sample_id=case.row_id),
              "validation component projection altered a frozen split example")
        _development_reference(case, row, members[sample], example, train_occurrences,
                               split_metadata=manifest.metadata)
    return _development_component_receipt(scope, group, cases)


def _development_component_receipt(scope, group_sha256, cases):
    split_sha256 = cases[0].split_sha256
    _need(all(case.split_sha256 == split_sha256 for case in cases),
          "each native development component must share one selected validation manifest")
    return {"split_selection_sha256": scope["selection_sha256"], "global_split_sha256": scope["global_split_sha256"],
            "dependency_group_sha256": group_sha256, "component_split_sha256": split_sha256,
            "role": "development"}


def prepare_development_threshold_look(threshold, study_owner, *, development, expected_development_sha256,
                                       verify_development_owner, study, expected_study_sha256, policy,
                                       packet, selection, components, step_grid=None, **armed_arguments):
    """Bind the scheduled look to development; reserve global final rows."""
    study_owner._study(threshold, study, expected_study_sha256)
    _heldout_groups(policy, study)

    def current():
        return _development_evidence(development, expected_development_sha256,
            expected_study_sha256=expected_study_sha256, policy=policy, packet=packet,
            selection=selection, components=components)

    split = current()
    _need(callable(verify_development_owner) and verify_development_owner(expected_development_sha256) is True,
          "independent frozen split and component alias authority required")
    _need(current() == split, "selected development projection changed during split verification")
    plans = armed_arguments.get("assessment_plans")
    native = type(plans) is tuple and any(_development_plan(plan) for plan in plans)
    prepared, report = _prepare_armed_threshold_look(threshold, study_owner, study=study,
        expected_study_sha256=expected_study_sha256, policy=policy, packet=packet, selection=selection,
        components=components, development=split if native else None, step_grid=step_grid, **armed_arguments)
    _need(current() == split, "selected development projection changed during armed look verification")
    schema = NATIVE_DEVELOPMENT_LOOK_SCHEMA if native else DEVELOPMENT_LOOK_SCHEMA
    if "scheduled_checkpoint" in report:
        schema = RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA
    elif "optimizer_step_grid_sha256" in report:
        schema = SCHEDULED_NATIVE_DEVELOPMENT_LOOK_SCHEMA
    report.update(schema=schema, development_split=split)
    return replace(prepared, evaluation_receipt_sha256=_commit(report)), report


def prepare_decision_span_validation_look(threshold, study_owner, *, selection, scoring, study,
                                          expected_study_sha256, assessment_plans, expected_assessment_sha256s,
                                          step_grid, retention, review, expected_review_sha256, components,
                                          verify_review_owner, policy_candidate, expected_policy_candidate_sha256):
    """Join one registered policy update to its exact VALIDATION component reviews."""
    study_owner._study(threshold, study, expected_study_sha256)
    guided = type(selection) is GuidedDecisionSpanPolicyAttempt
    fused = type(selection) is T5FusionDecisionSpanPolicyAttempt
    expected_plan = (T5FusionSpanValidationAssessment if fused else
                     GuidedSpanValidationAssessment if guided else DecisionSpanValidationAssessment)
    _need((guided or fused or type(selection) is DecisionSpanPolicyAttempt) and type(scoring) is DecisionSpanValidationScoring
          and type(assessment_plans) is type(expected_assessment_sha256s) is type(components) is tuple
          and 0 < len(assessment_plans) == len(expected_assessment_sha256s) == len(components)
          and all(type(plan) is expected_plan for plan in assessment_plans)
          and all(type(component) is tuple and len(component) == 2
                  and all(type(item) is dict for item in component) for component in components)
          and type(review) is GateReview and callable(verify_review_owner)
          and _pin(expected_review_sha256),
          "exact one-step policy selection and ordered VALIDATION plans and closes required")
    lead = assessment_plans[0]
    policy, training_verifier = scoring.policy, scoring.verify_training_owner
    attempt_pin = policy_attempt_commitment(selection)
    scope_pin = lead.development_split_sha256
    look, grid_pin, step = lead.look, lead.optimizer_step_grid_sha256, lead.optimizer_steps
    route = T5 if selection.architecture == "encoder_decoder" else QWEN

    def current():
        _need(study_owner.commitment(study) == expected_study_sha256 == selection.study_sha256
              and scoring.policy is policy and scoring.verify_training_owner is training_verifier
              and policy_attempt_commitment(selection) == attempt_pin
              and review_commitment(review) == expected_review_sha256
              and (review.study_sha256, review.arm, review.recipe_sha256) ==
                  (expected_study_sha256, selection.arm, selection.arm_recipe_sha256)
              and study.schedule == (look,) and step == selection.initial_optimizer_steps + 1,
              "selected policy VALIDATION study, original attempt, review or one-step schedule differs")
        _need(_pin(expected_policy_candidate_sha256)
              and _decision_span_policy_link(policy_candidate, guided=guided, fused=fused)
              and _commit(policy_candidate) == expected_policy_candidate_sha256
              and (policy_candidate.get("study_sha256"), policy_candidate.get("arm"), policy_candidate.get("seed"),
                   policy_candidate.get("attempt_sha256"), policy_candidate.get("arm_recipe_sha256"),
                   policy_candidate.get("policy_attempt_sha256"), policy_candidate.get("configuration_sha256"),
                   policy_candidate.get("selected_proof_evidence_sha256")) ==
                  (expected_study_sha256, selection.arm, selection.seed, selection.attempt_sha256,
                   selection.arm_recipe_sha256, attempt_pin, selection.configuration_sha256,
                   selection.selected_proof_evidence_sha256)
              and type(policy_candidate.get("seed")) is int
              and _span_binding(policy_candidate, guided)["architecture"] == selection.architecture
              and _span_binding(policy_candidate, guided)["cohort_sha256"] == _span_cohort(selection, guided)
              and (not guided or _guided_link_matches_attempt(policy_candidate, selection))
              and _artifact(policy_candidate.get("candidate")) and _pin(policy_candidate.get("terminal_close_sha256")),
              "policy VALIDATION look requires the exact owner-closed candidate of the selected attempt")
        if fused:
            _require_fused_link_attempt(policy_candidate, selection)
        groups = tuple(_heldout_groups(policy, study))
        _need(len(groups) == len(assessment_plans), "policy VALIDATION look must cover every ordered component")
        common_fields = ("study_sha256", "arm", "seed", "attempt_sha256", "look", "candidate_sha256",
                         "trial_terminal_close_sha256", "panel_sha256", "evaluation_policy_sha256",
                         "retention_reference_sha256", "route")
        common = (expected_study_sha256, selection.arm, selection.seed, selection.attempt_sha256, look,
                  policy_candidate["candidate"]["sha256"], policy_candidate["terminal_close_sha256"],
                  _commit(study.panel), study.evaluation_policy_sha256, retention_commitment(retention), route)
        for group, plan, plan_pin, (observation, saved) in zip(
                groups, assessment_plans, expected_assessment_sha256s, components, strict=True):
            _scheduled_optimizer_step(plan, step_grid, study_owner)
            _need(_pin(plan_pin) and commitment(plan) == plan_pin == observation.get("assessment_sha256")
                  and plan.policy_attempt_sha256 == attempt_pin and plan.admission_version == "v3"
                  and (plan.development_split_sha256, plan.dependency_group_sha256,
                       plan.optimizer_step_grid_sha256, plan.optimizer_steps) == (scope_pin, group, grid_pin, step)
                  and tuple(getattr(plan, key) for key in common_fields) == common
                  and tuple(observation.get(key) for key in common_fields) == common
                  and type(observation.get("seed")) is int
                  and observation.get("policy_candidate_sha256") == expected_policy_candidate_sha256
                  and observation.get("operation") == VALIDATION_OPERATION
                  and observation.get("optimizer_step_grid_sha256") == grid_pin
                  and type(observation.get("optimizer_steps")) is int and observation["optimizer_steps"] == step,
                  "policy VALIDATION component differs from its ordered assessment, closed pair or reached step")
            if fused:
                _need(observation.get("t5_fusion_assessment_binding_sha256") == plan.t5_fusion_assessment_binding_sha256
                      and observation.get("matched_teacher_inputs_sha256") == plan.matched_teacher_inputs_sha256
                      and _pin(observation.get("t5_fusion_observation_sha256")),
                      "policy VALIDATION teacher observation differs from its independently selected plan")
                declaration = saved["metadata"]["source_generation_observation"]["input_commitment"]
                _require_t5_fusion_assessment_role(plan, policy_candidate, declaration.get("t5_fusion_assessment_binding"))
        _need(step_grid.steps == ((look, step),), "policy VALIDATION look requires the exact single-step grid")
        resolved = _decision_span_validation_scope(lead, selection, scoring)
        _validate_development_references(components, policy, resolved)
        return resolved

    resolved = current()
    _verify_decision_span_validation_owner(lead, selection, scoring)
    _need(current() == resolved, "selected policy VALIDATION scope changed during TRAIN owner verification")
    prepared, report = _prepare_threshold_look(threshold, study_owner, study=study,
        expected_study_sha256=expected_study_sha256, policy=policy, retention=retention, review=review,
        expected_review_sha256=expected_review_sha256, components=components, verify_review_owner=verify_review_owner,
        development=resolved[0], policy_candidate=policy_candidate,
        expected_policy_candidate_sha256=expected_policy_candidate_sha256, decision_span_validation=True,
        fused_validation=fused)
    _need(current() == resolved, "selected policy VALIDATION scope changed during review owner verification")
    schema = (T5_FUSION_VALIDATION_LOOK_SCHEMA if fused else
              GUIDED_VALIDATION_LOOK_SCHEMA if guided else DECISION_SPAN_VALIDATION_LOOK_SCHEMA)
    if fused:
        report["t5_fusion_component_bindings"] = tuple(
            (plan.dependency_group_sha256, plan.t5_fusion_assessment_binding_sha256, plan.matched_teacher_inputs_sha256)
            for plan in assessment_plans)
        if _fused_statutory_source_admissions(components):
            report["source_admission_evidence_kind"] = "native_reviewed"
    report.update(schema=schema, development_split=resolved[0],
                  optimizer_step_grid_sha256=grid_pin, optimizer_steps=step)
    if fused:
        gate_fields = {field.name: getattr(prepared, field.name) for field in fields(PreparedGateLook)}
        prepared = T5FusionPreparedGateLook(**gate_fields,
            component_bindings_sha256=_commit(report["t5_fusion_component_bindings"]))
    return replace(prepared, evaluation_receipt_sha256=_commit(report)), report


def decision_span_validation_paid_looks_commitment(looks, *, validation_split_sha256, step_grid_sha256):
    """Commit an independent VALIDATION roster without exposing the split body."""
    _need(_pin(validation_split_sha256) and _pin(step_grid_sha256)
          and type(looks) is tuple and bool(looks)
          and all(type(row) is DecisionSpanValidationPaidLook for row in looks),
          "exact paid VALIDATION observations, split and step grid required")
    return _commit(("reviewed-decision-span-paid-validation-look-roster/v1", validation_split_sha256,
                    step_grid_sha256, tuple(asdict(row) for row in looks)))


def guided_span_validation_paid_looks_commitment(looks, *, validation_split_sha256, step_grid_sha256):
    """Commit the ordered paid DEVELOPMENT observations under the guided role schema."""
    _need(_pin(validation_split_sha256) and _pin(step_grid_sha256)
          and type(looks) is tuple and bool(looks)
          and all(type(row) is GuidedSpanValidationPaidLook for row in looks),
          "exact paid guided DEVELOPMENT observations, split and step grid required")
    return _commit(("reviewed-guided-span-paid-validation-look-roster/v1", validation_split_sha256,
                    step_grid_sha256, tuple(asdict(row) for row in looks)))


def t5_fusion_span_validation_paid_looks_commitment(looks, *, validation_split_sha256, step_grid_sha256):
    """Commit only fused DEVELOPMENT observations, including their teacher role bodies."""
    _need(_pin(validation_split_sha256) and _pin(step_grid_sha256)
          and type(looks) is tuple and bool(looks)
          and all(type(row) in _FUSED_PAID_LOOK_TYPES for row in looks),
          "exact paid fused T5 DEVELOPMENT observations, split and step grid required")
    version = max({T5FusionValidationPaidLook: 1, T5FusionStartedDevelopmentPaidLook: 2,
                   T5FusionInterruptedPreparationPaidLook: 3}[type(row)] for row in looks)
    schema = f"reviewed-t5-fusion-span-paid-validation-look-roster/v{version}"
    return _commit((schema, validation_split_sha256, step_grid_sha256, tuple(asdict(row) for row in looks)))


def _decision_span_paid_validation_scope(study_owner, study, study_sha, split, policy, split_sha, step_grid):
    _need(_pin(split_sha) and decision_span_validation_split_commitment(split) == split_sha
          and split.study_sha256 == study_sha and type(policy) is GatePolicy
          and gate_policy_commitment(policy) == split.policy_sha256 == study.evaluation_policy_sha256
          and len(study.schedule) == 1 and study.required_streak == 1,
          "paid policy VALIDATION requires its exact split, grading policy and one registered look")
    grid_sha = study_owner.development_step_grid_commitment(step_grid)
    _need(step_grid.study_sha256 == study_sha and step_grid.development_design_sha256 == split_sha
          and tuple(look for look, _ in step_grid.steps) == study.schedule,
          "paid policy VALIDATION step grid differs from the original split and schedule")
    (look, step), = step_grid.steps
    scope, _, _, members, crosswalk = _development_population_scope(split.manifest, split.population, split.case_aliases, policy,
        expected_development_sha256=split_sha, manifest_sha256=_commit(split.manifest))
    groups = _heldout_groups(policy, study)
    components = {group: _development_component_receipt(scope, group, cases) for group, cases in groups.items()}
    component_sources = {}
    for group, cases in groups.items():
        component_sources[group] = tuple((case.row_id, member.source_wire_sha256, member.source_span_sha256)
                                         for case in cases for member in (members[crosswalk[case.row_id]],))
    return {"split": scope, "look": look, "step": step, "step_grid_sha256": grid_sha,
            "components": components, "component_sources": component_sources}

DECISION_SPAN_FINAL_FREEZE_SCHEMA = "reviewed-frozen-decision-span-final-checkpoint-roster/v1"
DECISION_SPAN_FINAL_FREEZE_PLAN_SCHEMA = "reviewed-decision-span-final-freeze-plan/v1"
GUIDED_SPAN_FINAL_FREEZE_SCHEMA = "reviewed-frozen-guided-span-final-checkpoint-roster/v1"
GUIDED_SPAN_FINAL_FREEZE_PLAN_SCHEMA = "reviewed-guided-span-final-freeze-plan/v1"
T5_FUSION_SPAN_FINAL_FREEZE_SCHEMA = "reviewed-frozen-t5-fusion-span-final-checkpoint-roster/v1"
T5_FUSION_SPAN_FINAL_FREEZE_PLAN_SCHEMA = "reviewed-t5-fusion-span-final-freeze-plan/v1"
T5_FUSION_ESTIMATOR_FREEZE_SELECTION_SCHEMA = "reviewed-t5-fusion-estimator-profile-freeze-selection/v1"
T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE_SCHEMA = "reviewed-t5-fusion-estimator-profile-freeze-provenance/v1"
_T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE = "t5_fusion_estimator_profile_provenance"
_FUSED_PAID_VALIDATION_SCHEMAS = (T5_FUSION_PAID_VALIDATION_SCHEMA,
    T5_FUSION_STARTED_DEVELOPMENT_PAID_VALIDATION_SCHEMA, T5_FUSION_INTERRUPTED_PREPARATION_PAID_VALIDATION_SCHEMA)


@dataclass(frozen=True)
class DecisionSpanFinalFreezePlan:
    study_sha256: str
    validation_split_sha256: str
    global_split_sha256: str
    optimizer_step_grid_sha256: str
    contrast_plan_sha256: str
    final_policy_sha256: str
    final_reservation_sha256: str
    reserved_final_count: int
    clock: str


@dataclass(frozen=True)
class GuidedSpanFinalFreezePlan(DecisionSpanFinalFreezePlan):
    discovery_costs_sha256: str


@dataclass(frozen=True)
class T5FusionSpanFinalFreezePlan(DecisionSpanFinalFreezePlan):
    development_cost_evidence_sha256: str
    development_upstream_costs_sha256: str


def t5_fusion_span_final_freeze_plan_commitment(plan):
    _need(type(plan) is T5FusionSpanFinalFreezePlan
          and _pin(plan.development_cost_evidence_sha256) and _pin(plan.development_upstream_costs_sha256),
          "exact fused T5 FINAL plan with the original physical and upstream cost evidence required")
    return _span_final_freeze_plan_commitment(plan, T5_FUSION_SPAN_FINAL_FREEZE_PLAN_SCHEMA)


def decision_span_final_freeze_plan_commitment(plan):
    _need(type(plan) is DecisionSpanFinalFreezePlan, "exact decision-span FINAL plan required")
    return _span_final_freeze_plan_commitment(plan, DECISION_SPAN_FINAL_FREEZE_PLAN_SCHEMA)


def guided_span_final_freeze_plan_commitment(plan):
    _need(type(plan) is GuidedSpanFinalFreezePlan and _pin(plan.discovery_costs_sha256),
          "exact guided FINAL plan with original discovery costs required")
    return _span_final_freeze_plan_commitment(plan, GUIDED_SPAN_FINAL_FREEZE_PLAN_SCHEMA)


def _span_final_freeze_plan_commitment(plan, schema):
    _need(all(_pin(value) for value in (
        plan.study_sha256, plan.validation_split_sha256, plan.global_split_sha256,
        plan.optimizer_step_grid_sha256, plan.contrast_plan_sha256, plan.final_policy_sha256,
        plan.final_reservation_sha256)) and type(plan.reserved_final_count) is int and plan.reserved_final_count > 0
        and type(plan.clock) is str and plan.clock in ("wall_seconds", "cpu_seconds", "gpu_seconds"),
        "preselected policy FINAL reservation, policy, split and limiting clock required")
    return _commit((schema, asdict(plan)))


def _freeze_decision_span_checkpoint(threshold, study_owner, plan, pair, prefix, physical, reported, row, index, step,
                                     *, guided=False, fused=False):
    from math import isfinite

    decision = reported.get("decision")
    _need(type(decision) is dict and decision.get("status") == "reached"
          and "confirmation_budget_block" in reported and reported["confirmation_budget_block"] is None
          and len(physical.assessments) == 1,
          "eligible policy FINAL slot requires its original unblocked confirmation")
    graded, = physical.assessments
    look = graded.look
    evidence = study_owner._one_final_row(reported.get("look_evidence"), lambda item: item.get("look") == look,
                                          "one exact paid policy confirming look required")
    measured = pair.get("observed_" + prefix + "_confirmation")
    costs = decision.get("confirming_costs")
    meter = graded.meter
    clock_index = tuple(threshold.CLOCKS).index(plan.clock)
    recorded_cost = getattr(meter.costs, plan.clock)
    paid = reported.get("cost_evidence")
    meter_row = study_owner._one_final_row(paid.get("looks") if type(paid) is dict else None,
        lambda item: item.get("look") == look, "one selected physical confirming meter required")
    _need(decision.get("confirming_checkpoint") == look and type(measured) is float and isfinite(measured)
          and 0 <= measured <= pair["horizon"] and type(recorded_cost) is float and recorded_cost == measured
          and type(costs) is dict and type(costs.get(plan.clock)) is float and costs[plan.clock] == measured
          and study_owner.commitment(meter_row.get("meter")) == study_owner.commitment(meter)
          and meter.stage == look and meter.attempt_sha256 == physical.attempt_sha256
          and type(meter.clock_receipts) is tuple and len(meter.clock_receipts) == len(threshold.CLOCKS)
          and _pin(meter.clock_receipts[clock_index])
          and all(_pin(value) for value in (meter.record_sha256, meter.charge_manifest_sha256, meter.interval_manifest_sha256))
          and meter.record_sha256 == evidence.get("meter_record_sha256")
          and _commit(asdict(meter.costs)) == _commit(costs),
          "policy FINAL freeze requires the exact measured confirming meter within the selected horizon")

    selection, prepared, report, link = (row.policy_attempts[index], row.prepared[index], row.gate_reports[index],
                                         row.policy_candidates[index])
    selection_type = (GuidedDecisionSpanPolicyAttempt if guided else
                      T5FusionDecisionSpanPolicyAttempt if fused else DecisionSpanPolicyAttempt)
    prepared_type = T5FusionPreparedGateLook if fused else PreparedGateLook
    report_schema = (GUIDED_VALIDATION_LOOK_SCHEMA if guided else
                     T5_FUSION_VALIDATION_LOOK_SCHEMA if fused else DECISION_SPAN_VALIDATION_LOOK_SCHEMA)
    _need(type(selection) is selection_type and type(prepared) is prepared_type
          and type(report) is dict and _decision_span_policy_link(link, guided=guided, fused=fused)
          and (not guided or _guided_link_matches_attempt(link, selection))
          and report.get("schema") == report_schema
          and report.get("optimizer_step_grid_sha256") == plan.optimizer_step_grid_sha256
          and type(report.get("optimizer_steps")) is int and report["optimizer_steps"] == step
          and step == selection.initial_optimizer_steps + 1
          and row.unobserved[index] is None
          and (selection.study_sha256, selection.arm, selection.attempt_sha256, selection.arm_recipe_sha256)
                == (plan.study_sha256, physical.arm, physical.attempt_sha256, physical.recipe_sha256)
          and type(report.get("development_split")) is dict
          and report["development_split"].get("selection_sha256") == plan.validation_split_sha256
          and report["development_split"].get("global_split_sha256") == plan.global_split_sha256
          and report["development_split"].get("policy_training_scope_sha256") == selection.training_scope_sha256
          and report.get("policy_candidate_sha256") == _commit(link)
          and policy_attempt_commitment(selection) == link.get("policy_attempt_sha256")
          and row.dispatches[index].commitment() == selection.owner_request_sha256
          and all(_artifact(link.get(key)) for key in ("candidate", "model_checkpoint", "optimizer_checkpoint"))
          and all(_pin(link.get(key)) for key in ("terminal_close_sha256", "worker_receipt_sha256"))
          and link["candidate"]["sha256"] == evidence.get("checkpoint_sha256") == graded.checkpoint_sha256
          and _commit(report) == evidence.get("evaluation_receipt_sha256") == graded.evaluation_receipt_sha256,
          "policy FINAL freeze differs from its original candidate, validation report or optimizer step")
    meter_arguments = {"prepared": prepared, "expected_look_sha256": prepared_look_commitment(prepared), "meter": meter}
    measured_grade = (bind_t5_fusion_threshold_meter(study_owner, gate_report=report, **meter_arguments) if fused
                      else bind_threshold_meter(study_owner, **meter_arguments))
    _need(measured_grade == graded, "policy FINAL freeze must bind the exact graded meter")
    _need(report.get("native_identity") == {"arm": physical.arm, "seed": selection.seed,
        "attempt_sha256": physical.attempt_sha256, "look": look, "candidate_sha256": graded.checkpoint_sha256,
        "trial_terminal_close_sha256": link["terminal_close_sha256"]},
        "policy FINAL freeze must retain the exact closed candidate identity")
    scope = {"guided_scope_sha256": _commit(link["guided_scope_binding"])} if guided else {}
    if fused:
        _require_fused_link_attempt(link, selection)
        scope = {"t5_fusion_training_binding": dict(link["t5_fusion_binding"]),
                 "t5_fusion_development_component_bindings_sha256": prepared.component_bindings_sha256,
                 "t5_fusion_development_component_bindings": tuple(tuple(item) for item in report["t5_fusion_component_bindings"])}
    return {**{key: dict(link[key]) for key in ("candidate", "model_checkpoint", "optimizer_checkpoint")},
            "optimizer_steps": step, "confirming_look": look, "development_evaluation_sha256": graded.evaluation_receipt_sha256,
            "development_meter_sha256": meter.record_sha256, "trial_terminal_close_sha256": link["terminal_close_sha256"],
            "policy_attempt_sha256": link["policy_attempt_sha256"], "worker_receipt_sha256": link["worker_receipt_sha256"],
            "elapsed": measured, **scope}


def freeze_decision_span_validation_final(threshold, study_owner, *, plan, expected_plan_sha256, study, comparison,
                                          expected_comparison_sha256, attempts, matched_looks, verify_final_owner):
    """Freeze the eligible original paid policy slots against an opaque FINAL reservation."""
    return _freeze_span_validation_final(threshold, study_owner, plan=plan, expected_plan_sha256=expected_plan_sha256,
        study=study, comparison=comparison, expected_comparison_sha256=expected_comparison_sha256,
        attempts=attempts, matched_looks=matched_looks, verify_final_owner=verify_final_owner, guided=False)


def freeze_guided_span_validation_final(threshold, study_owner, *, plan, expected_plan_sha256, study, comparison,
                                       expected_comparison_sha256, attempts, matched_looks, verify_final_owner):
    """Freeze verified guided DEVELOPMENT checkpoints without opening FINAL.

    The FINAL owner verifies the selected reservation, comparison, look
    roster and original discovery cost commitment. This prepares checkpoint
    metadata only and does not authorize FINAL scoring.
    """
    return _freeze_span_validation_final(threshold, study_owner, plan=plan, expected_plan_sha256=expected_plan_sha256,
        study=study, comparison=comparison, expected_comparison_sha256=expected_comparison_sha256,
        attempts=attempts, matched_looks=matched_looks, verify_final_owner=verify_final_owner, guided=True)


def _current_t5_fusion_final_cost_scope(study_owner, plan, study, roster_pin, *, cost_evidence,
        upstream_costs, validation_split, policy, step_grid, contrast_plan):
    return (type(cost_evidence) is study_owner.CostEvidence
            and study_owner.commitment(cost_evidence) == plan.development_cost_evidence_sha256
            and t5_fusion_upstream_costs_commitment(upstream_costs, study_sha256=plan.study_sha256,
                matched_looks_sha256=roster_pin, cost_evidence_sha256=plan.development_cost_evidence_sha256)
                    == plan.development_upstream_costs_sha256
            and decision_span_validation_split_commitment(validation_split) == plan.validation_split_sha256
            and gate_policy_commitment(policy) == study.evaluation_policy_sha256
            and study_owner.development_step_grid_commitment(step_grid) == plan.optimizer_step_grid_sha256
            and study_owner.commitment(contrast_plan) == plan.contrast_plan_sha256)


def freeze_t5_fusion_span_validation_final(threshold, study_owner, *, plan, expected_plan_sha256, study, comparison,
        expected_comparison_sha256, attempts, matched_looks, contrast_plan, cost_evidence, verify_cost_owner,
        validation_split, policy, step_grid, upstream_costs, verify_final_owner):
    """Replay original paid fused DEVELOPMENT before freezing opaque FINAL checkpoint metadata.

    The original resource owner authenticates all selected physical work again.
    The separate FINAL verification receives only commitments, including the
    exact freeze plan that binds the opaque reservation and FINAL policy.
    """
    _need(_pin(expected_plan_sha256) and _pin(expected_comparison_sha256) and callable(verify_final_owner)
          and t5_fusion_span_final_freeze_plan_commitment(plan) == expected_plan_sha256
          and type(comparison) is dict and comparison.get("schema") in _FUSED_PAID_VALIDATION_SCHEMAS
          and study_owner.commitment(comparison) == expected_comparison_sha256,
          "independently selected fused T5 FINAL plan, paid comparison and FINAL owner required")
    roster_pin = t5_fusion_span_validation_paid_looks_commitment(matched_looks,
        validation_split_sha256=plan.validation_split_sha256, step_grid_sha256=plan.optimizer_step_grid_sha256)

    def current_cost_scope():
        return _current_t5_fusion_final_cost_scope(study_owner, plan, study, roster_pin,
            cost_evidence=cost_evidence, upstream_costs=upstream_costs, validation_split=validation_split,
            policy=policy, step_grid=step_grid, contrast_plan=contrast_plan)

    _need(current_cost_scope(), "fused T5 FINAL requires the original selected physical and upstream cost evidence")
    replay = compare_paid_t5_fusion_span_validation(threshold, study_owner, study=study,
        expected_study_sha256=plan.study_sha256, attempts=attempts,
        expected_attempts_sha256=comparison.get("attempts_sha256"), contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=plan.contrast_plan_sha256, matched_looks=matched_looks,
        expected_matched_looks_sha256=roster_pin, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=plan.development_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        validation_split=validation_split, policy=policy, expected_validation_split_sha256=plan.validation_split_sha256,
        step_grid=step_grid, upstream_costs=upstream_costs,
        expected_upstream_costs_sha256=plan.development_upstream_costs_sha256)
    _need(study_owner.commitment(replay) == expected_comparison_sha256 and current_cost_scope(),
          "fused T5 FINAL requires the replayed original paid comparison and cost scope")

    def verify(*pins):
        return verify_final_owner(*pins) is True and current_cost_scope()

    return _freeze_span_validation_final(threshold, study_owner, plan=plan, expected_plan_sha256=expected_plan_sha256,
        study=study, comparison=comparison, expected_comparison_sha256=expected_comparison_sha256,
        attempts=attempts, matched_looks=matched_looks, verify_final_owner=verify, guided=False, fused=True)


def t5_fusion_estimator_freeze_selection_commitment(plan_sha256, profiled_comparison_sha256):
    """Bind the original opaque freeze plan and independently selected paid profile report."""
    _need(_pin(plan_sha256) and _pin(profiled_comparison_sha256),
          "exact fused freeze plan and profiled paid comparison commitments required")
    return _commit((T5_FUSION_ESTIMATOR_FREEZE_SELECTION_SCHEMA, plan_sha256, profiled_comparison_sha256))


def freeze_t5_fusion_span_validation_final_with_estimator_profile(threshold, study_owner, *, plan,
        expected_plan_sha256, study, matched_looks, verify_cost_owner, verify_final_owner,
        estimator_profile_selection, expected_estimator_profile_selection_sha256, profiled_comparison,
        expected_profiled_comparison_sha256, expected_estimator_freeze_selection_sha256,
        verify_estimator_profile_owner, **freeze_inputs):
    """Preserve the estimator profile on the original unopened FINAL checkpoint roster.

    Replay the original paid comparison once. Before its cost owner approves,
    the proof and Source owner reauthenticates the selected seed evidence.
    The FINAL owner receives its original commitments followed by the profile
    freeze selection and the profiled paid comparison commitments.
    """
    _need(all(callable(owner) for owner in (verify_estimator_profile_owner, verify_cost_owner, verify_final_owner))
          and _pin(expected_estimator_profile_selection_sha256) and _pin(expected_estimator_freeze_selection_sha256)
          and t5_fusion_estimator_freeze_selection_commitment(expected_plan_sha256, expected_profiled_comparison_sha256)
                 == expected_estimator_freeze_selection_sha256
          and not {"comparison", "expected_comparison_sha256"}.intersection(freeze_inputs)
          and t5_fusion_span_final_freeze_plan_commitment(plan) == expected_plan_sha256,
          "independently selected profile freeze plan, paid report and owners required")
    profile_pin = expected_estimator_profile_selection_sha256
    looks_pin = t5_fusion_span_validation_paid_looks_commitment(matched_looks,
        validation_split_sha256=plan.validation_split_sha256, step_grid_sha256=plan.optimizer_step_grid_sha256)
    cost_scope = {key: freeze_inputs[key] for key in ("cost_evidence", "upstream_costs", "validation_split",
                                                        "policy", "step_grid", "contrast_plan")}

    def current():
        _require_t5_fusion_estimator_profile_scope(study_owner, estimator_profile_selection, profile_pin,
            study=study, study_pin=plan.study_sha256, looks=matched_looks, looks_pin=looks_pin,
            split_pin=plan.validation_split_sha256, grid=freeze_inputs["step_grid"])
        _need(type(profiled_comparison) is dict and set(profiled_comparison) == {"schema", "estimator_profile",
                  "estimator_profile_selection_sha256", "original_paid_comparison_sha256", "original_paid_comparison"}
              and profiled_comparison["schema"] == T5_FUSION_CREDIT_PROFILE_COMPARISON_SCHEMA
              and profiled_comparison["estimator_profile_selection_sha256"] == profile_pin
              and profiled_comparison["estimator_profile"] == estimator_profile_selection.estimator_profile
              and _commit(profiled_comparison) == expected_profiled_comparison_sha256
              and t5_fusion_span_final_freeze_plan_commitment(plan) == expected_plan_sha256,
              "profiled paid comparison or selected freeze plan changed")
        paid = profiled_comparison["original_paid_comparison"]
        _need(type(paid) is dict and paid.get("schema") in _FUSED_PAID_VALIDATION_SCHEMAS
              and paid.get("study_sha256") == plan.study_sha256
              and paid.get("contrast_plan_sha256") == plan.contrast_plan_sha256
              and paid.get("cost_evidence_sha256") == plan.development_cost_evidence_sha256
              and paid.get("t5_fusion_upstream_costs_sha256") == plan.development_upstream_costs_sha256
              and paid.get("t5_fusion_span_paid_looks_sha256") == looks_pin
              and _pin(profiled_comparison["original_paid_comparison_sha256"])
              and study_owner.commitment(paid) == profiled_comparison["original_paid_comparison_sha256"],
              "profiled report must retain the exact original paid comparison and roster")
        _need(study_owner.commitment(freeze_inputs["attempts"]) == paid.get("attempts_sha256")
              and _current_t5_fusion_final_cost_scope(study_owner, plan, study, looks_pin, **cost_scope),
              "original paid attempts, split or cost inputs changed during profile freeze")

    current()

    def verify_cost(*pins):
        current()
        _need(verify_estimator_profile_owner(profile_pin, plan.study_sha256, looks_pin) is True,
              "original proof and Source owner refused the frozen estimator profile")
        current()
        approved = verify_cost_owner(*pins) is True
        if approved:
            current()
        return approved

    def verify_final(*pins):
        current()
        approved = verify_final_owner(*pins, expected_estimator_freeze_selection_sha256,
            expected_profiled_comparison_sha256) is True
        if approved:
            current()
        return approved

    frozen = freeze_t5_fusion_span_validation_final(threshold, study_owner, plan=plan,
        expected_plan_sha256=expected_plan_sha256, study=study, matched_looks=matched_looks,
        comparison=profiled_comparison["original_paid_comparison"],
        expected_comparison_sha256=profiled_comparison["original_paid_comparison_sha256"],
        verify_cost_owner=verify_cost, verify_final_owner=verify_final, **freeze_inputs)
    current()
    provenance = {"schema": T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE_SCHEMA,
        "estimator_freeze_selection_sha256": expected_estimator_freeze_selection_sha256,
        "profiled_paid_comparison_sha256": expected_profiled_comparison_sha256,
        "estimator_profile_selection_sha256": profile_pin,
        "estimator_profile": estimator_profile_selection.estimator_profile,
        "original_frozen_roster_sha256": _commit(frozen)}
    return {**frozen, _T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE: provenance}


def read_t5_fusion_frozen_estimator_profile(frozen, *, expected_frozen_roster_sha256,
        expected_estimator_freeze_selection_sha256, estimator_profile_selection,
        expected_estimator_profile_selection_sha256):
    """Verify the selected frozen profile metadata without opening or scoring FINAL."""
    _need(type(frozen) is dict and all(_pin(pin) for pin in (expected_frozen_roster_sha256,
              expected_estimator_freeze_selection_sha256, expected_estimator_profile_selection_sha256))
          and _commit(frozen) == expected_frozen_roster_sha256
          and frozen.get("schema") == T5_FUSION_SPAN_FINAL_FREEZE_SCHEMA
          and frozen.get("final_scoring_selected") is False,
          "exact original unopened fused FINAL roster required for profile readback")
    item = frozen.get(_T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE)
    _need(type(item) is dict and set(item) == {"schema", "estimator_freeze_selection_sha256",
              "profiled_paid_comparison_sha256", "estimator_profile_selection_sha256",
              "estimator_profile", "original_frozen_roster_sha256"}
          and item["schema"] == T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE_SCHEMA
          and item["estimator_freeze_selection_sha256"] == expected_estimator_freeze_selection_sha256
          and t5_fusion_estimator_freeze_selection_commitment(frozen.get("plan_sha256"),
                  item["profiled_paid_comparison_sha256"]) == expected_estimator_freeze_selection_sha256
          and t5_fusion_estimator_profile_selection_commitment(estimator_profile_selection)
                  == expected_estimator_profile_selection_sha256 == item["estimator_profile_selection_sha256"]
          and frozen.get("study_sha256") == estimator_profile_selection.study_sha256
          and item["estimator_profile"] == estimator_profile_selection.estimator_profile
          and _commit({key: value for key, value in frozen.items() if key != _T5_FUSION_ESTIMATOR_FREEZE_PROVENANCE})
                  == item["original_frozen_roster_sha256"],
          "frozen roster must retain the independently selected estimator profile and original freeze")
    return dict(item)


def _guided_discovery_freeze_clocks(plan, comparison, attempts, matched_looks):
    _need(comparison.get("guided_span_upstream_activation_discovery_cost_verified") is True
          and comparison.get("guided_span_discovery_costs_sha256") == plan.discovery_costs_sha256
          and comparison.get("guided_span_cost_scope") ==
              "guided_discovery_plus_attempt_versus_recorded_control_attempt",
          "guided FINAL freeze requires the original discovery-inclusive DEVELOPMENT cost scope")
    roster = comparison.get("guided_span_discovery_costs")
    events = comparison.get("physical_paid_events")
    _need(type(roster) in (tuple, list) and len(roster) == len(matched_looks)
          and type(events) in (tuple, list) and all(type(event) is dict and _pin(event.get("event_sha256"))
              for event in events), "guided FINAL freeze requires the exact discovery event roster")
    by_attempt = {attempt.attempt_sha256: attempt for attempt in attempts}
    by_event = {event["event_sha256"]: event for event in events}
    discovery_ids = {event_id for event_id, event in by_event.items()
                     if event.get("kind") == GUIDED_SPAN_DISCOVERY_EVENT_KIND}
    _need(len(by_event) == len(events) and len(discovery_ids) == len(roster),
          "guided FINAL freeze requires one distinct original discovery event per seed")
    clocks = {}
    for paid, look in zip(roster, matched_looks, strict=True):
        guided = look.policy_attempts[0]
        _need(type(paid) is dict and paid.get("attempt_sha256") == guided.attempt_sha256
              and paid.get("opening_sha256") == guided.opening_sha256
              and paid.get("starting_pair_sha256") == guided.starting_pair_sha256
              and _pin(paid.get("original_discovery_sha256")) and _pin(paid.get("event_sha256"))
              and paid["event_sha256"] in discovery_ids and guided.attempt_sha256 in by_attempt,
              "guided FINAL discovery evidence differs from its exact guided attempt and starting pair")
        event = by_event[paid["event_sha256"]]
        counters = (event.get("cpu_ns"), event.get("gpu_ns"))
        _need(event.get("disposition") == "complete" and _pin(event.get("close_receipt_sha256"))
              and all(value is None or type(value) is int and value >= 0 for value in counters),
              "guided FINAL discovery event must retain its completed measured close")
        measured = _guided_discovery_inclusive_clocks(by_attempt[guided.attempt_sha256], *counters)
        recorded = paid.get("discovery_inclusive_clocks")
        _need(type(recorded) in (tuple, list) and tuple(recorded) == measured and "wall_seconds" in measured,
              "guided FINAL observed discovery clock scope differs from the original meters")
        discovery_ids.remove(paid["event_sha256"])
        clocks[guided.attempt_sha256] = measured
    return clocks


def _freeze_span_validation_final(threshold, study_owner, *, plan, expected_plan_sha256, study, comparison,
                                  expected_comparison_sha256, attempts, matched_looks, verify_final_owner, guided,
                                  fused=False):
    commit_plan = (guided_span_final_freeze_plan_commitment if guided else
                   t5_fusion_span_final_freeze_plan_commitment if fused else decision_span_final_freeze_plan_commitment)
    commit_roster = (guided_span_validation_paid_looks_commitment if guided else
                     t5_fusion_span_validation_paid_looks_commitment if fused else decision_span_validation_paid_looks_commitment)
    _need(_pin(expected_plan_sha256) and _pin(expected_comparison_sha256) and callable(verify_final_owner)
          and commit_plan(plan) == expected_plan_sha256,
          "independently selected policy FINAL freeze plan and owner required")
    _, horizons, _ = study_owner._study(threshold, study, plan.study_sha256)
    horizon = horizons[plan.clock]
    worker_arms = GUIDED_DECISION_SPAN_POLICY_ARMS if guided else DECISION_SPAN_POLICY_ARMS
    arms = worker_arms[::-1] if guided else worker_arms
    selection_type = (GuidedDecisionSpanPolicyAttempt if guided else
                      T5FusionDecisionSpanPolicyAttempt if fused else DecisionSpanPolicyAttempt)
    paid_schemas = ((GUIDED_SPAN_DISCOVERY_PAID_VALIDATION_SCHEMA,) if guided else
                    _FUSED_PAID_VALIDATION_SCHEMAS if fused else (DECISION_SPAN_PAID_VALIDATION_SCHEMA,))
    prefix = "guided_span" if guided else "t5_fusion_span" if fused else "decision_span"
    roster_key = f"{prefix}_paid_looks_sha256"
    seeds = tuple(seed.identifier for seed in study.seeds)
    _need(horizon is not None and tuple(arm for arm, _ in study.arms) == arms and study.cost_basis == "first_use"
          and len(study.schedule) == 1 and study.required_streak == 1,
          "policy FINAL freeze requires its original one-step study and measured horizon")
    _need(type(matched_looks) is tuple and len(matched_looks) == len(seeds),
          "policy FINAL freeze requires its original matched seed roster")
    roster_pin = commit_roster(matched_looks,
        validation_split_sha256=plan.validation_split_sha256, step_grid_sha256=plan.optimizer_step_grid_sha256)
    _need(type(comparison) is dict and study_owner.commitment(comparison) == expected_comparison_sha256
          and comparison.get("schema") in paid_schemas
          and comparison.get("study_sha256") == plan.study_sha256 and comparison.get("cost_basis") == "first_use"
          and comparison.get("contrast_plan_sha256") == plan.contrast_plan_sha256
          and comparison.get(roster_key) == roster_pin
          and comparison.get("panel_sha256") == study_owner.commitment(study.panel)
          and all(_pin(comparison.get(key)) for key in ("attempts_sha256", "cost_evidence_sha256")),
          "policy FINAL freeze requires the exact verified paid VALIDATION comparison and roster")
    scope = comparison.get(f"{prefix}_validation")
    _need(type(scope) is dict and scope.get("role") == "development"
          and type(scope.get("reserved_final_count")) is int and type(scope.get("optimizer_steps")) is int
          and scope["optimizer_steps"] > 0
          and (scope.get("split_selection_sha256"), scope.get("global_split_sha256"),
               scope.get("optimizer_step_grid_sha256"), scope["reserved_final_count"])
                 == (plan.validation_split_sha256, plan.global_split_sha256,
                     plan.optimizer_step_grid_sha256, plan.reserved_final_count),
          "policy FINAL freeze differs from the original split, step grid or opaque reservation count")
    cells = tuple((seed, arm) for seed in seeds for arm in arms)
    _need(type(attempts) is tuple and all(type(row) is study_owner.Attempt for row in attempts)
          and tuple((row.seed, row.arm) for row in attempts) == cells
          and len({row.attempt_sha256 for row in attempts}) == len(cells)
          and len({row.closeout_receipt_sha256 for row in attempts}) == len(cells)
          and all(_pin(row.attempt_sha256) and _pin(row.closeout_receipt_sha256) for row in attempts)
          and study_owner.commitment(attempts) == comparison["attempts_sha256"]
          and tuple(row.seed for row in matched_looks) == seeds,
          "policy FINAL freeze must retain every original seed and arm attempt")
    _need(all(type(row.policy_attempts) is tuple and all(type(worker) is selection_type for worker in row.policy_attempts)
              and tuple(worker.arm for worker in row.policy_attempts) == worker_arms for row in matched_looks),
          "policy FINAL freeze requires the original worker role order")
    attempts_pin = comparison["attempts_sha256"]
    replay, outcomes, _ = study_owner._evaluate_roster(threshold, study, plan.study_sha256,
        attempts, attempts_pin, require_complete_cap_observation=True)
    discovery_clocks = _guided_discovery_freeze_clocks(plan, comparison, attempts, matched_looks) if guided else {}
    contrast = study_owner._one_final_row(comparison.get("contrasts"),
        lambda item: (item.get("baseline"), item.get("candidate"), item.get("role")) == (*arms, "primary"),
        "one original registered policy contrast required")
    slots = []
    for seed, row in zip(seeds, matched_looks, strict=True):
        pair = study_owner._one_final_row(comparison.get("pairs"),
            lambda item: (item.get("seed"), item.get("clock"), item.get("contrast_id")) == (seed, plan.clock, contrast["identifier"]),
            "one original paid policy pair at the selected clock required")
        _need((pair.get("baseline"), pair.get("candidate"), pair.get("role"), pair.get("horizon"))
              == (*arms, "primary", horizon), "paid policy pair differs from the selected direction and horizon")
        for arm, side in zip(arms, ("baseline", "candidate"), strict=True):
            physical = attempts[len(slots)]
            reported = study_owner._one_final_row(comparison.get("attempts"),
                lambda item: (item.get("seed"), item.get("arm")) == (seed, arm),
                "one original paid policy attempt required per FINAL slot")
            original_report = replay["attempts"][len(slots)]
            verdict, blocked = outcomes[(seed, arm)]
            attained, reason, observed = study_owner._threshold_horizon(verdict, blocked, plan.clock, horizon)
            _need(study_owner.commitment({key: reported.get(key) for key in original_report})
                    == study_owner.commitment(original_report)
                  and study_owner.commitment((pair.get(side + "_attained"), pair.get(side + "_reason"),
                                              pair.get("observed_" + side + "_confirmation")))
                    == study_owner.commitment((attained, reason, observed))
                  and pair.get(side + "_attempt_sha256") == physical.attempt_sha256
                  and (attained != 1 or verdict.confirming_checkpoint == study.schedule[0]),
                  "policy FINAL slot differs from its original paid attempt and attainment disposition")
            selected_clocks = discovery_clocks.get(physical.attempt_sha256)
            blocked_clock = attained == 1 and selected_clocks is not None and plan.clock not in selected_clocks
            checkpoint = (_freeze_decision_span_checkpoint(threshold, study_owner, plan, pair, side,
                          physical, reported, row, worker_arms.index(arm), scope["optimizer_steps"],
                          guided=guided, fused=fused)
                          if attained == 1 and not blocked_clock else None)
            eligibility = {"freeze_block": "incomplete_discovery_inclusive_clock"} if blocked_clock else {}
            slots.append({"seed": seed, "arm": arm, "attempt_sha256": physical.attempt_sha256,
                          "closeout_receipt_sha256": physical.closeout_receipt_sha256,
                          "attained": attained, "reason": reason, "checkpoint": checkpoint,
                          "status": "frozen" if checkpoint is not None else "unavailable", **eligibility})
    cost_pins = ((plan.discovery_costs_sha256,) if guided else
                 (plan.development_cost_evidence_sha256, plan.development_upstream_costs_sha256) if fused else ())
    _need(verify_final_owner(expected_plan_sha256, expected_comparison_sha256, roster_pin, *cost_pins) is True
          and commit_plan(plan) == expected_plan_sha256
          and study_owner.commitment(study) == plan.study_sha256
          and study_owner.commitment(comparison) == expected_comparison_sha256
          and study_owner.commitment(attempts) == attempts_pin
          and commit_roster(matched_looks,
              validation_split_sha256=plan.validation_split_sha256, step_grid_sha256=plan.optimizer_step_grid_sha256) == roster_pin,
          "policy FINAL owner refused or original freeze inputs changed during verification")
    extra = ({"guided_span_discovery_costs_sha256": plan.discovery_costs_sha256,
              "guided_span_cost_scope": comparison["guided_span_cost_scope"]} if guided else {})
    if fused:
        extra = {"t5_fusion_development_cost_evidence_sha256": plan.development_cost_evidence_sha256,
                 "t5_fusion_upstream_costs_sha256": plan.development_upstream_costs_sha256,
                 "t5_fusion_paid_comparison_schema": comparison["schema"],
                 "confirming_clock_basis": "observed_elapsed" if plan.clock == "wall_seconds" else "allocated_work"}
    freeze_schema = (GUIDED_SPAN_FINAL_FREEZE_SCHEMA if guided else
                     T5_FUSION_SPAN_FINAL_FREEZE_SCHEMA if fused else DECISION_SPAN_FINAL_FREEZE_SCHEMA)
    return {"schema": freeze_schema,
            "plan_sha256": expected_plan_sha256,
            "study_sha256": plan.study_sha256, "development_comparison_sha256": expected_comparison_sha256,
            roster_key: roster_pin, "clock": plan.clock,
            "final_policy_sha256": plan.final_policy_sha256, "final_reservation_sha256": plan.final_reservation_sha256,
            "global_split_sha256": plan.global_split_sha256, "reserved_final_count": plan.reserved_final_count,
            "slots": tuple(slots), "final_scoring_selected": False, **extra}

FINAL_CHECKPOINT_SCHEMA = "reviewed-frozen-final-checkpoint/v1"
FINAL_SCORING_SCHEMA = "reviewed-final-component-scoring/v1"
FINAL_OBSERVATION_SCHEMA = "reviewed-relational-final-source-observation/v1"


@dataclass(frozen=True)
class FinalScoring:
    checkpoint: dict
    development: DevelopmentScoring
    final_policy: GatePolicy
    case_aliases: tuple[tuple[str, str], ...]


def final_scoring_commitment(choice, plan):
    _need(type(choice) is FinalScoring and type(choice.checkpoint) is dict
          and type(choice.development) is DevelopmentScoring and type(choice.final_policy) is GatePolicy
          and type(plan) is Assessment and plan.admission_version == "v3" and plan.look == "final"
          and type(choice.case_aliases) is tuple
          and all(type(pair) is tuple and len(pair) == 2
                  and all(type(key) is str and key for key in pair) for pair in choice.case_aliases),
          "exact frozen final plan, development lineage and component aliases required")
    dev = choice.development
    return _commit((FINAL_SCORING_SCHEMA, commitment(plan), choice.checkpoint,
                    development_split_commitment(dev.split), gate_policy_commitment(dev.policy),
                    armed_attempt_commitment(dev.attempt), gate_policy_commitment(choice.final_policy), choice.case_aliases))


def _frozen_optimizer_step(frozen):
    if "optimizer_step_grid_sha256" not in frozen and "optimizer_steps" not in frozen:
        return None
    step = frozen.get("optimizer_steps")
    _need(_pin(frozen.get("optimizer_step_grid_sha256")) and type(step) is int and step > 0,
          "frozen final selection requires its exact confirming optimizer step and grid")
    return step


def _frozen_checkpoint_identity(frozen):
    if "scheduled_checkpoint" not in frozen:
        return None
    identity = frozen["scheduled_checkpoint"]
    fields = ("schedule_sha256", "checkpoint_close_sha256", "owner_stage_record_sha256")
    _need(type(identity) is dict and set(identity) == set(fields)
          and all(_pin(identity[key]) for key in fields)
          and _frozen_optimizer_step(frozen) is not None
          and _pin(frozen.get("trial_terminal_close_sha256"))
          and type(frozen.get("confirming_look")) is str and bool(frozen["confirming_look"])
          and frozen["confirming_look"] != "final",
          "frozen scheduled checkpoint requires its exact three pins, development look, step grid and terminal")
    return ScheduledCheckpointIdentity(*(identity[key] for key in fields))


def _retains_frozen_checkpoint_identity(observation, expected):
    if expected is None:
        return "scheduled_checkpoint" not in observation
    identity = observation.get("scheduled_checkpoint")
    return (type(identity) is dict and all(_pin(value) for value in identity.values())
            and identity == asdict(expected))


def _final_panel_scope(choice, plan, selection):
    from math import isfinite
    from . import legal_ir_eval_splits as splits, relational_trial

    frozen = choice.checkpoint
    _frozen_optimizer_step(frozen)
    scheduled_checkpoint = _frozen_checkpoint_identity(frozen)
    _need(_archived_capture_metadata(frozen) is None or scheduled_checkpoint is not None,
          "frozen archived capture requires the exact scheduled checkpoint")
    dev = choice.development
    policy = choice.final_policy
    _need(frozen.get("schema") == FINAL_CHECKPOINT_SCHEMA
          and all(_pin(frozen.get(key)) for key in (
              "plan_sha256", "development_comparison_sha256", "development_design_sha256", "development_evaluation_sha256",
              "development_owner_close_sha256", "development_meter_sha256", "trial_sha256",
              "development_split_sha256", "development_policy_sha256", "train_cohort_sha256"))
          and type(frozen.get("confirming_look")) is str and bool(frozen["confirming_look"])
          and frozen["confirming_look"] != "final" and frozen.get("clock") in ("wall_seconds", "cpu_seconds", "gpu_seconds")
          and type(frozen.get("elapsed")) is float and isfinite(frozen["elapsed"]) and frozen["elapsed"] >= 0
          and gate_policy_commitment(dev.policy) == frozen["development_policy_sha256"]
          and (plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256, plan.candidate_sha256,
               plan.trial_terminal_close_sha256, plan.route, plan.evaluation_policy_sha256)
              == tuple(frozen.get(key) for key in ("study_sha256", "native_arm", "native_seed", "attempt_sha256",
                  "candidate_sha256", "trial_terminal_close_sha256", "route", "final_policy_sha256"))
          and type(frozen.get("native_seed")) is int
          and (dev.attempt.arm, dev.attempt.seed, dev.attempt.packet_sha256, armed_attempt_commitment(dev.attempt))
              == tuple(frozen.get(key) for key in ("arm", "seed", "packet_sha256", "armed_attempt_sha256"))
          and relational_trial.commitment(selection.trial) == dev.attempt.trial_sha256 == frozen.get("trial_sha256")
          and selection.trial.arm_recipe_sha256 == frozen.get("recipe_sha256"),
          "native final scoring may only use the exact frozen confirmed study checkpoint")

    scope, global_split, examples, members, _, train_occurrences = _development_scope(
        dev.split, frozen["development_split_sha256"], expected_study_sha256=plan.study_sha256,
        policy=dev.policy, packet=dev.packet, selection=dev.attempt)
    final_ids = set(global_split.samples_by_split[splits.HOLDOUT_SPLIT])
    _need(type(frozen.get("reserved_final_count")) is int and len(final_ids) == frozen["reserved_final_count"]
          and (frozen.get("global_split_sha256"), frozen.get("population_sha256"), frozen.get("train_cohort_sha256"))
              == (scope["global_split_sha256"], scope["population_sha256"], scope["train_cohort_sha256"]),
          "final panel differs from the frozen global split and untouched reservation")
    _need(gate_policy_commitment(policy) == plan.evaluation_policy_sha256,
          "final scoring policy differs from the precommitted panel")
    aliases, native_groups = _final_panel_membership(policy, choice.case_aliases, plan.panel_sha256,
        frozen["reserved_final_count"], global_split, members, dev.policy)
    return scope, global_split, examples, members, aliases, train_occurrences, native_groups


def _final_component_scope(choice, plan, selection, inputs):
    scope, global_split, examples, members, aliases, train_occurrences, native_groups = _final_panel_scope(
        choice, plan, selection)
    local_pin, group_sha256, _ = _final_component_projection(inputs, global_split, examples, members, aliases,
        train_occurrences, native_groups)
    return {"frozen_checkpoint_sha256": _commit(choice.checkpoint), "global_split_sha256": scope["global_split_sha256"],
            "component_split_sha256": local_pin, "dependency_group_sha256": group_sha256, "role": "final"}


def _final_panel_membership(policy, case_aliases, expected_panel_sha256, reserved_count, global_split, members, development_policy):
    from . import legal_ir_eval_splits as splits

    final_ids = set(global_split.samples_by_split[splits.HOLDOUT_SPLIT])
    _need(len(final_ids) == reserved_count, "FINAL population differs from the frozen reservation")
    native_groups, roster = _policy_groups(policy)
    _need(_commit(roster) == expected_panel_sha256,
          "final scoring policy differs from the precommitted panel")
    aliases = dict(case_aliases)
    _need(tuple(key for key, _ in case_aliases) == tuple(case.row_id for case in policy.cases)
          and len(aliases) == len(case_aliases) == len(final_ids) and set(aliases.values()) == final_ids,
          "final aliases must cover every reserved final sample exactly once")

    frozen_groups = {}
    for member in members.values():
        if member.partition == "final":
            frozen_groups.setdefault(member.dependency_group, set()).add(member.row_id)
    development_bindings = {case.source_binding_sha256 for case in development_policy.cases}
    for case in policy.cases:
        member = members[aliases[case.row_id]]
        _need(case.source_wire_sha256 == member.source_wire_sha256
              and case.source_binding_sha256 not in development_bindings,
              "final case differs from the frozen source or reuses a development binding")
    completed = set()
    for cases in native_groups.values():
        group_ids = {members[aliases[case.row_id]].dependency_group for case in cases}
        _need(len(group_ids) == 1, "a final native component cannot mix frozen dependency groups")
        group, = group_ids
        _need(group not in completed and {aliases[case.row_id] for case in cases} == frozen_groups[group],
              "a final native component must retain one complete frozen dependency group")
        completed.add(group)
    return aliases, native_groups

def _final_component_projection(inputs, global_split, examples, members, aliases, train_occurrences, native_groups,
                                *, preserve_split_profile=False):
    from . import legal_ir_eval_splits as splits
    from .relational_sources import SOURCE_PROFILE

    local = inputs.get("split_manifest")
    rows = inputs.get("rows")
    _need(type(local) is dict and type(rows) is list and all(type(row) is dict for row in rows),
          "one exact local final manifest and its source references required")
    ids = tuple(row.get("id") for row in rows)
    matches = tuple((key, cases) for key, cases in native_groups.items()
                    if tuple(case.row_id for case in cases) == ids)
    _need(len(matches) == 1, "source references must cover exactly one frozen final component")
    group_sha256, cases = matches[0]
    local_pin = _commit(local)
    manifest = splits.LegalIRSplitManifest.from_mapping(local)
    _need(manifest.to_dict() == local and manifest.guard_result().passed
          and manifest.config_digest == global_split.config_digest
          and manifest.protected_splits == global_split.protected_splits
          and manifest.partition_names == global_split.partition_names
          and set(manifest.assignments) == set(ids)
          and all(manifest.assignments[row_id] == splits.HOLDOUT_SPLIT for row_id in ids)
          and all(case.split_sha256 == local_pin for case in cases)
          and {example.sample_id: example for example in manifest.examples}
              == {row_id: replace(examples[aliases[row_id]], sample_id=row_id) for row_id in ids},
          "final manifest must project the frozen holdout component without changing examples or roles")
    split_metadata = global_split.metadata if preserve_split_profile else None
    if preserve_split_profile:
        _need(all((key in manifest.metadata) == (key in split_metadata)
                  and manifest.metadata.get(key) == split_metadata.get(key) for key in _SPLIT_PROFILE_FIELDS),
              "FINAL component changed the frozen source fingerprint profile")
    contexts = inputs.get("source_contexts")
    _need(type(contexts) is dict and set(contexts) == {"profile", "selection_context", "rows"}
          and contexts["profile"] == SOURCE_PROFILE and type(contexts["rows"]) is list
          and len(contexts["rows"]) == len(rows) and type(contexts["selection_context"]) is dict,
          "complete ordered final source contexts required before loading")
    for case, row, context in zip(cases, rows, contexts["rows"], strict=True):
        member = members[aliases[case.row_id]]
        _development_reference(case, row, member, examples[member.row_id], train_occurrences, split_metadata=split_metadata)
        _need(type(context) is dict and set(context) == {"id", "unit_id", "source_binding", "governing_context"}
              and (context["id"], context["unit_id"], context["source_binding"])
                  == (case.row_id, case.unit_id, row["canonical_ir"]["source_binding"]),
              "final input sources differ from the approved references")
        wire = {"profile": SOURCE_PROFILE, "source_text": row["source_text"],
                "governing_context": context["governing_context"], "source_binding": context["source_binding"],
                "selection_context": contexts["selection_context"]}
        _need(_commit(wire) == case.source_wire_sha256,
              "final source context does not reproduce the frozen source wire")
    return local_pin, group_sha256, cases

def _replay_final_component_admission(consumer, inputs, current_admission_provider, scope):
    replayed = consumer.validate_reviewed_source_span_consumer_binding_v3(
        inputs["binding"], inputs["rows"], split_manifest=inputs["split_manifest"],
        admission_inputs=current_admission_provider(), exposure_records=inputs["exposure_records"])
    heldout = replayed.get("heldout_evaluation")
    _need(replayed == inputs["binding"].receipt() and replayed.get("status") == "ready"
          and replayed.get("operation") == "heldout_evaluation"
          and replayed.get("admission_inputs_sha256") == inputs["expected_admission_inputs_sha256"]
          and type(heldout) is dict and heldout.get("schema") == COMPONENT_SCHEMA
          and heldout.get("purpose") == consumer.REVIEWED_HELDOUT_PURPOSE
          and heldout.get("partition") == "holdout"
          and heldout.get("population_scope") == "exact_complete_admitted_component_only"
          and heldout.get("inference_context_profile") == "declared_source_only_empty_retrieval_context"
          and heldout.get("retrieved_example_ids") == [] and heldout.get("training_example_ids") == []
          and heldout.get("split_manifest_sha256") == scope["component_split_sha256"]
          and heldout.get("dependency_group_sha256") == scope["dependency_group_sha256"]
          and type(heldout.get("dependency_group")) is dict
          and _commit(heldout["dependency_group"]) == scope["dependency_group_sha256"],
          "exact current ready V3 final holdout admission required before loading")
    units = heldout["dependency_group"].get("source_units")
    _need(type(units) is list and len(units) == len(inputs["rows"])
          and all(type(unit) is dict and (unit.get("id"), unit.get("unit_id"),
                  unit.get("source_version_cid"), unit.get("occurrence_cid"))
                 == (row["id"], row["unit_id"], row["canonical_ir"]["source_binding"].get("source_version_cid"),
                     row["canonical_ir"]["source_binding"].get("occurrence_cid"))
                  for unit, row in zip(units, inputs["rows"], strict=True)),
          "final V3 admission did not retain every selected source occurrence in order")
    return replayed

def _check_final_source_observation(snapshot, replayed, cases):
    native = snapshot["compiler_artifact"]["reviewed_source_span_producer_evaluation"]
    _need(native["configuration"].get("heldout_evaluation") == replayed["heldout_evaluation"]
          and native.get("admission_before") == native.get("admission_after") == replayed,
          "saved final artifact differs from the exact replayed final admission")
    records = snapshot["metadata"]["source_generation_observation"]["last_call"]["input_receipt"]["row_commitments"]
    _need(type(records) is list and len(records) == len(cases)
          and all(type(record) is dict and (record.get("id"), record.get("unit_id"), record.get("source_wire_sha256"))
                  == (case.row_id, case.unit_id, case.source_wire_sha256)
                  for record, case in zip(records, cases, strict=True)),
          "native final generation did not consume the frozen source wires")

@dataclass(frozen=True)
class T5FusionSpanFinalScoring:
    frozen_roster_sha256: str
    study_seed: str
    final_panel_binding_sha256: str
    dependency_group_sha256: str


def t5_fusion_span_final_panel_binding(policy, aliases):
    _policy_groups(policy)
    _need(type(aliases) is tuple and len(aliases) == len(policy.cases)
          and all(type(pair) is tuple and len(pair) == 2
                  and all(type(key) is str and 0 < len(key) <= 4096 for key in pair) for pair in aliases),
          "exact ordered assignments of fused FINAL aliases to reserved samples required")
    return _commit((T5_FUSION_FINAL_SCORING_SCHEMA, "panel", gate_policy_commitment(policy), aliases))


def t5_fusion_span_final_scoring_commitment(scoring, plan):
    _need(type(scoring) is T5FusionSpanFinalScoring and type(scoring.study_seed) is str
          and 0 < len(scoring.study_seed) <= 512
          and all(_pin(pin) for pin in (scoring.frozen_roster_sha256, scoring.final_panel_binding_sha256,
                                        scoring.dependency_group_sha256))
          and type(plan) is T5FusionSpanFinalAssessment and scoring.dependency_group_sha256 == plan.dependency_group_sha256,
          "exact confirmed fused T5 FINAL slot and approved component selection required")
    return _commit((T5_FUSION_FINAL_SCORING_SCHEMA, commitment(plan), asdict(scoring)))


def _t5_fusion_final_checkpoint(scoring, plan, selection, frozen, freeze_plan, validation_split, validation_policy):
    _need(type(frozen) is dict and _commit(frozen) == scoring.frozen_roster_sha256
          and frozen.get("schema") == T5_FUSION_SPAN_FINAL_FREEZE_SCHEMA
          and frozen.get("final_scoring_selected") is False
          and t5_fusion_span_final_freeze_plan_commitment(freeze_plan) == frozen.get("plan_sha256")
          and decision_span_validation_split_commitment(validation_split) == freeze_plan.validation_split_sha256
          and gate_policy_commitment(validation_policy) == validation_split.policy_sha256
          and _commit(validation_split.manifest) == freeze_plan.global_split_sha256
          and (frozen.get("study_sha256"), freeze_plan.study_sha256, validation_split.study_sha256) == (plan.study_sha256,) * 3
          and (frozen.get("global_split_sha256"), frozen.get("final_reservation_sha256"),
               frozen.get("final_policy_sha256"), frozen.get("reserved_final_count"), frozen.get("clock"),
               frozen.get("t5_fusion_development_cost_evidence_sha256"), frozen.get("t5_fusion_upstream_costs_sha256"))
              == (freeze_plan.global_split_sha256, freeze_plan.final_reservation_sha256, freeze_plan.final_policy_sha256,
                  freeze_plan.reserved_final_count, freeze_plan.clock, freeze_plan.development_cost_evidence_sha256,
                  freeze_plan.development_upstream_costs_sha256)
          and plan.evaluation_policy_sha256 == freeze_plan.final_policy_sha256
          and frozen.get("t5_fusion_paid_comparison_schema") in _FUSED_PAID_VALIDATION_SCHEMAS,
          "fused FINAL requires the exact paid freeze, original split and untouched reservation")
    slots = frozen.get("slots")
    _need(type(slots) in (tuple, list) and all(type(slot) is dict for slot in slots),
          "exact frozen fused T5 FINAL roster required")
    matches = [slot for slot in slots if (slot.get("seed"), slot.get("arm")) == (scoring.study_seed, plan.arm)]
    _need(len(matches) == 1 and matches[0].get("status") == "frozen" and type(matches[0].get("attained")) is int
          and matches[0]["attained"] == 1 and matches[0].get("attempt_sha256") == plan.attempt_sha256
          and type(selection) is T5FusionDecisionSpanPolicyAttempt
          and policy_attempt_commitment(selection) == plan.policy_attempt_sha256
          and (selection.study_sha256, selection.arm, selection.seed, selection.attempt_sha256)
              == (plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256)
          and scoring.study_seed == str(selection.seed),
          "fused FINAL may only load the original confirmed policy slot and native seed")
    checkpoint = matches[0].get("checkpoint")
    _need(type(checkpoint) is dict and all(_artifact(checkpoint.get(key)) for key in (
              "candidate", "model_checkpoint", "optimizer_checkpoint")) and _pin(checkpoint.get("worker_receipt_sha256"))
          and type(checkpoint.get("optimizer_steps")) is int
          and checkpoint["optimizer_steps"] == plan.optimizer_steps == selection.initial_optimizer_steps + 1
          and (checkpoint["candidate"]["sha256"], checkpoint.get("trial_terminal_close_sha256"),
               checkpoint.get("policy_attempt_sha256"))
              == (plan.candidate_sha256, plan.trial_terminal_close_sha256, plan.policy_attempt_sha256)
          and checkpoint.get("t5_fusion_training_binding") == _t5_fusion_policy_selection_fields(selection),
          "fused FINAL selection changed the original closed candidate, TRAIN conditioning or optimizer step")
    return checkpoint


def _require_t5_fusion_final_role(plan, link, binding):
    _need(type(plan) is T5FusionSpanFinalAssessment and _decision_span_policy_link(link, fused=True)
          and type(binding) is dict and set(binding) == _T5_FUSION_FINAL_BINDING_FIELDS
          and binding["schema"] == _T5_FUSION_FINAL_BINDING
          and all(_artifact(link.get(key)) for key in ("candidate", "model_checkpoint", "optimizer_checkpoint"))
          and _pin(binding["final_batch_sha256"]) and _pin(binding["frozen_roster_sha256"])
          and binding["dependency_group_sha256"] == plan.dependency_group_sha256
          and binding["candidate_manifest_sha256"] == link["candidate"]["sha256"] == plan.candidate_sha256
          and binding["trial_terminal_close_sha256"] == link["terminal_close_sha256"] == plan.trial_terminal_close_sha256
          and binding["policy_candidate_sha256"] == _commit(link)
          and binding["training_batch_sha256"] == link["t5_fusion_binding"]["candidate_batch_sha256"]
          and binding["configuration_sha256"] == link["configuration_sha256"]
          and binding["model_checkpoint_sha256"] == link["model_checkpoint"]["sha256"]
          and binding["matched_inputs_sha256"] == plan.matched_teacher_inputs_sha256
          and _commit(binding) == plan.t5_fusion_assessment_binding_sha256,
          "fused FINAL conditioning differs from its selected reserved component and candidate role")


def _bind_fused_final_policy_candidate(selection, plan, checkpoint, candidate_manifest, worker_receipt,
                                       terminal_close, verify_owner_close, *, fused_proof_pair=None):
    link = bind_policy_candidate(selection, expected_policy_attempt_sha256=plan.policy_attempt_sha256,
        worker_receipt=worker_receipt, expected_worker_receipt_sha256=checkpoint["worker_receipt_sha256"],
        candidate_manifest=candidate_manifest, terminal_close=terminal_close,
        expected_terminal_close_sha256=plan.trial_terminal_close_sha256, verify_owner_close=verify_owner_close,
        **_fused_assessment_proof_options(fused_proof_pair))
    _require_fused_link_attempt(link, selection)
    _need(all(link[key] == checkpoint[key] for key in (
              "candidate", "model_checkpoint", "optimizer_checkpoint", "worker_receipt_sha256"))
          and link["terminal_close_sha256"] == plan.trial_terminal_close_sha256
          and link["t5_fusion_binding"] == checkpoint["t5_fusion_training_binding"],
          "closed fused policy binding differs from the frozen candidate checkpoint and TRAIN condition")
    return link


def evaluate_t5_fusion_span_final(selection, *, scoring, expected_final_scoring_sha256, frozen, freeze_plan,
        validation_split, validation_policy, verify_final_scoring_owner, open_final_component, plan,
        expected_assessment_sha256, current_admission_provider, execution_guard, t5_fusion_train_batch, fused_proof_pair=None,
        **evaluator_arguments):
    """Open a separately approved fictional or governed FINAL source component within split custody."""
    from . import autoencoder_training_worker as worker, legal_span_consumer_binding as consumer, teacher_prefix

    loader_fields = {"worker_receipt", "expected_worker_receipt_sha256", "candidate_manifest", "terminal_close",
                     "expected_terminal_close_sha256", "verify_owner_close", "asset_policy_guard", "registry",
                     "assets", "max_model_bytes"}
    _need(set(evaluator_arguments) == loader_fields and _pin(expected_final_scoring_sha256)
          and all(callable(callback) for callback in (verify_final_scoring_owner, open_final_component,
              current_admission_provider, execution_guard, evaluator_arguments.get("asset_policy_guard"),
              evaluator_arguments.get("verify_owner_close"))),
          "exact evaluator arguments and independent reserved fused FINAL component owner required")

    def current_checkpoint():
        _need(t5_fusion_span_final_scoring_commitment(scoring, plan) == expected_final_scoring_sha256
              and commitment(plan) == expected_assessment_sha256,
              "fused FINAL scoring plan changed")
        exact = _t5_fusion_final_checkpoint(scoring, plan, selection, frozen, freeze_plan, validation_split, validation_policy)
        _need(type(t5_fusion_train_batch) is teacher_prefix.T5FusionBatch
              and (t5_fusion_train_batch.phase, t5_fusion_train_batch.partition) == ("train", "train")
              and teacher_prefix.batch_commit(t5_fusion_train_batch) == selection.candidate_batch_sha256
              and t5_fusion_train_batch.configuration_sha256 == selection.configuration_sha256,
              "fused FINAL requires the exact frozen TRAIN projections and original batch")
        return exact

    checkpoint = current_checkpoint()
    checkpoint_pin = _commit(checkpoint)
    candidate_raw = evaluator_arguments.get("candidate_manifest")
    candidate = _evidence_json(candidate_raw, 2 * 1024**2)
    worker_raw = evaluator_arguments.get("worker_receipt")
    worker_pin = checkpoint["worker_receipt_sha256"]
    progress = candidate.get("progress")
    _need(_sha(candidate_raw) == checkpoint["candidate"]["sha256"] and len(candidate_raw) == checkpoint["candidate"]["bytes"]
          and type(worker_raw) is bytes and _sha(worker_raw) == worker_pin == evaluator_arguments.get("expected_worker_receipt_sha256")
          and plan.trial_terminal_close_sha256 == evaluator_arguments.get("expected_terminal_close_sha256")
          and (candidate.get("model_state"), candidate.get("optimizer_state"))
              == (checkpoint["model_checkpoint"], checkpoint["optimizer_checkpoint"])
          and type(progress) is dict and type(progress.get("optimizer_steps")) is int
          and progress["optimizer_steps"] == checkpoint["optimizer_steps"],
          "exact frozen fused candidate, worker, terminal and checkpoint pair required before opening FINAL")
    assets = evaluator_arguments.get("assets")
    held_assets = candidate.get("assets")
    def current_loader_assets():
        _need(_assets_commit(worker, assets, evaluator_arguments["max_model_bytes"]) == plan.expected_assets_sha256
              and type(held_assets) is list and all(asdict(item) in held_assets for item in assets.values()),
              "frozen fused FINAL loader assets and byte bounds must match before opening the reserved component")

    current_loader_assets()

    def authorize_execution():
        execution_guard(expected_final_scoring_sha256)
        _need(_commit(current_checkpoint()) == checkpoint_pin, "fused FINAL checkpoint changed during authorization")
        current_loader_assets()

    authorize_execution()
    link = _bind_fused_final_policy_candidate(selection, plan, checkpoint, candidate_raw, worker_raw,
        evaluator_arguments["terminal_close"], evaluator_arguments["verify_owner_close"],
        fused_proof_pair=fused_proof_pair)

    def current_policy_proof():
        _require_current_fused_assessment_proof(selection, plan.policy_attempt_sha256, fused_proof_pair,
                                                evaluator_arguments["terminal_close"], plan.trial_terminal_close_sha256)

    _need(_commit(current_checkpoint()) == checkpoint_pin, "closed fused policy binding changed before FINAL approval")
    scope, global_split, examples, members, _ = _development_population_scope(validation_split.manifest,
        validation_split.population, validation_split.case_aliases, validation_policy,
        expected_development_sha256=freeze_plan.validation_split_sha256, manifest_sha256=freeze_plan.global_split_sha256)
    _need(scope["reserved_final_count"] == freeze_plan.reserved_final_count,
          "fused FINAL reservation count differs from the original protected split")
    reserved_members = tuple(member for member in members.values() if member.partition == "final")
    train_members = tuple(member for member in t5_fusion_train_batch.population if member.partition == "train")
    _need(not {member.source_wire_sha256 for member in reserved_members}.intersection(
                  member.source_wire_sha256 for member in train_members)
          and not {member.source_span_sha256 for member in reserved_members}.intersection(
                  member.source_span_sha256 for member in train_members),
          "fused FINAL reservation overlaps the selected TRAIN wires or spans before opening")
    _need(verify_final_scoring_owner(expected_final_scoring_sha256, scoring.frozen_roster_sha256,
          freeze_plan.final_reservation_sha256) is True and _commit(current_checkpoint()) == checkpoint_pin,
          "independent owner refused or changed the fused FINAL reservation and component")
    current_policy_proof()
    authorize_execution()
    current_policy_proof()
    opened = open_final_component(expected_final_scoring_sha256)
    _need(type(opened) is tuple and len(opened) == 4, "one authorized reserved fused FINAL component and batch required")
    policy, aliases, inputs, final_batch = opened
    _need(type(final_batch) is teacher_prefix.T5FusionBatch, "exact authorized fused FINAL inference batch required")
    final_batch_pin = teacher_prefix.batch_commit(final_batch)

    def current_inputs():
        _need(t5_fusion_span_final_panel_binding(policy, aliases) == scoring.final_panel_binding_sha256
              and gate_policy_commitment(policy) == plan.evaluation_policy_sha256
              and _inputs_commit(inputs, consumer, plan) == plan.expected_inputs_sha256
              and teacher_prefix.batch_commit(final_batch) == final_batch_pin,
              "fused FINAL panel, component, teacher batch or admission inputs changed")

    current_inputs()
    crosswalk, groups = _final_panel_membership(policy, aliases, plan.panel_sha256, freeze_plan.reserved_final_count,
                                               global_split, members, validation_policy)
    component, group, cases = _final_component_projection(inputs, global_split, examples, members, crosswalk,
        {occurrence for _, occurrence in validation_split.train_occurrences}, groups, preserve_split_profile=True)
    _need(group == scoring.dependency_group_sha256,
          "opened fused FINAL component differs from the independently selected group")
    binding = bind_t5_fusion_final(t5_fusion_train_batch, final_batch, teacher_prefix=teacher_prefix,
        expected_train_batch_sha256=selection.candidate_batch_sha256, expected_final_batch_sha256=final_batch_pin,
        expected_configuration_sha256=selection.configuration_sha256,
        expected_model_checkpoint_sha256=link["model_checkpoint"]["sha256"],
        frozen_roster_sha256=scoring.frozen_roster_sha256, dependency_group_sha256=group)
    binding.update(candidate_manifest_sha256=link["candidate"]["sha256"],
        trial_terminal_close_sha256=link["terminal_close_sha256"], policy_candidate_sha256=_commit(link))
    _require_t5_fusion_final_role(plan, link, binding)
    expected = tuple((case.row_id, member.source_wire_sha256, member.source_span_sha256)
                     for case in cases for member in (members[crosswalk[case.row_id]],))
    held_members = tuple(member for member in members.values() if member.partition != "final")
    held_wires = {member.source_wire_sha256 for member in held_members}
    held_spans = {member.source_span_sha256 for member in held_members}
    _need(tuple((item["row_id"], item["source_wire_sha256"], item["source_span_sha256"])
                for item in binding["rows"]) == expected
          and all(wire not in held_wires and span not in held_spans for _, wire, span in expected),
          "fused FINAL teacher rows must reproduce the reserved source wires and spans disjoint from TRAIN and DEVELOPMENT")
    final_scope = {"frozen_roster_sha256": scoring.frozen_roster_sha256, "global_split_sha256": freeze_plan.global_split_sha256,
                   "component_split_sha256": component, "dependency_group_sha256": group, "role": "final"}
    authorize_execution()
    current_policy_proof()
    replayed = _replay_final_component_admission(consumer, inputs, current_admission_provider, final_scope)
    replayed_pin = _commit(replayed)

    def guarded(assessment_sha256):
        _need(assessment_sha256 == expected_assessment_sha256, "existing evaluator changed the fused FINAL assessment")
        authorize_execution()
        current_inputs()
        current_policy_proof()
        _need(_commit(replayed) == replayed_pin, "current V3 fused FINAL admission changed during evaluation")

    guarded(expected_assessment_sha256)
    artifact, observation = _evaluate(selection, plan=plan, expected_assessment_sha256=expected_assessment_sha256,
        execution_guard=guarded, current_admission_provider=current_admission_provider, inputs=inputs,
        t5_fusion_train_batch=t5_fusion_train_batch, _t5_fusion_final_batch=final_batch, _t5_fusion_final_binding=binding,
        fused_proof_pair=fused_proof_pair, **evaluator_arguments)
    guarded(expected_assessment_sha256)
    snapshot = artifact.to_dict()
    _check_final_source_observation(snapshot, replayed, cases)
    _need(observation.get("optimizer_steps") == checkpoint["optimizer_steps"]
          and observation.get("candidate_sha256") == checkpoint["candidate"]["sha256"]
          and observation.get("saved_artifact_sha256") == _commit(snapshot)
          and observation.get("policy_candidate_sha256") == _commit(link),
          "fused FINAL observation did not retain the frozen candidate, role and artifact")
    return artifact, {**observation, "schema": T5_FUSION_FINAL_OBSERVATION_SCHEMA, "operation": "heldout_evaluation",
                      "final_scoring_sha256": expected_final_scoring_sha256, "final_scope": final_scope}


def evaluate_final(selection, *, choice, expected_final_scoring_sha256, verify_final_scoring_owner,
                   plan, expected_assessment_sha256, inputs, current_admission_provider, execution_guard,
                   scheduled_checkpoint_evidence=None, **evaluator_arguments):
    """Evaluate one frozen final component and retain its selected archive provenance."""
    from . import legal_span_consumer_binding as consumer

    def current():
        _need(_pin(expected_final_scoring_sha256)
              and final_scoring_commitment(choice, plan) == expected_final_scoring_sha256
              and commitment(plan) == expected_assessment_sha256
              and _inputs_commit(inputs, consumer, plan) == plan.expected_inputs_sha256,
              "final selection or native evaluation inputs changed")
        return _final_component_scope(choice, plan, selection, inputs)

    _need(callable(execution_guard) and callable(verify_final_scoring_owner)
          and {"development_scoring", "_frozen_choice", "qwen_development_prefill"}.isdisjoint(evaluator_arguments),
          "existing final evaluation and independent frozen-selection owners required")
    scope = current()
    scheduled_checkpoint = _frozen_checkpoint_identity(choice.checkpoint)
    archived_capture = _archived_capture_metadata(choice.checkpoint)
    _need((scheduled_checkpoint is None and scheduled_checkpoint_evidence is None)
          or (scheduled_checkpoint is not None and type(scheduled_checkpoint_evidence) is ScheduledCheckpointEvidence),
          "scheduled final evaluation requires exactly the evidence selected by its frozen checkpoint")
    _need(verify_final_scoring_owner(expected_final_scoring_sha256, scope["frozen_checkpoint_sha256"]) is True
          and current() == scope, "final owner refused or changed the selected checkpoint and component")
    expected_step = _frozen_optimizer_step(choice.checkpoint)
    if expected_step is not None:
        raw = evaluator_arguments.get("candidate_manifest")
        candidate = _evidence_json(raw, 2 * 1024**2)
        progress = candidate.get("progress")
        _need(_sha(raw) == plan.candidate_sha256 and type(progress) is dict
              and type(progress.get("optimizer_steps")) is int and progress["optimizer_steps"] == expected_step,
              "final candidate must retain the frozen confirming optimizer step before loading")
    execution_guard(expected_final_scoring_sha256)
    _need(current() == scope, "final component changed before current admission replay")
    replayed = _replay_final_component_admission(consumer, inputs, current_admission_provider, scope)
    replayed_pin = _commit(replayed)

    def guarded(assessment_sha256):
        _need(assessment_sha256 == expected_assessment_sha256, "existing evaluator changed the selected assessment")
        execution_guard(expected_final_scoring_sha256)
        _need(current() == scope and _commit(replayed) == replayed_pin,
              "final component or admission changed during evaluation")

    scheduled_arguments = ({"scheduled_checkpoint_evidence": scheduled_checkpoint_evidence, "_frozen_choice": choice}
                           if scheduled_checkpoint is not None else {})
    artifact, observation = _evaluate(selection, plan=plan, expected_assessment_sha256=expected_assessment_sha256,
        execution_guard=guarded, current_admission_provider=current_admission_provider, inputs=inputs,
        **evaluator_arguments, **scheduled_arguments)
    snapshot = artifact.to_dict()
    _need(current() == scope and _retains_frozen_checkpoint_identity(observation, scheduled_checkpoint)
          and _archived_capture_metadata(observation) == archived_capture,
          "saved final artifact differs from the exact replayed final admission")
    cases = tuple(case for case in choice.final_policy.cases if case.dependency_group_sha256 == scope["dependency_group_sha256"])
    _check_final_source_observation(snapshot, replayed, cases)
    return artifact, {**observation, "schema": FINAL_OBSERVATION_SCHEMA, "final_scoring_sha256": expected_final_scoring_sha256,
                      "final_scope": scope}


FINAL_REVIEW_SCHEMA = "reviewed-final-panel-review/v1"
FINAL_RETENTION_SCHEMA = "reviewed-final-baseline-selection/v1"
FINAL_REPORT_SCHEMA = "reviewed-relational-final-panel-report/v1"


@dataclass(frozen=True)
class FinalRetentionSelection:
    frozen_checkpoint_sha256: str
    final_panel_sha256: str
    final_policy_sha256: str
    baseline_checkpoint_sha256: str | None


@dataclass(frozen=True)
class FinalReview:
    frozen_checkpoint_sha256: str
    final_policy_sha256: str
    final_panel_sha256: str
    final_evaluation_sha256: str
    final_terminal_close_sha256: str
    retention_selection_sha256: str
    retention_reference_sha256: str | None
    components: tuple[ComponentClose, ...]
    rows: tuple[RowReview, ...]


def final_retention_selection_commitment(selection):
    _need(type(selection) is FinalRetentionSelection and all(_pin(value) for value in (
        selection.frozen_checkpoint_sha256, selection.final_panel_sha256, selection.final_policy_sha256))
        and (selection.baseline_checkpoint_sha256 is None or _pin(selection.baseline_checkpoint_sha256)),
        "explicit final-panel baseline selection required")
    return _commit((FINAL_RETENTION_SCHEMA, asdict(selection)))


def final_review_commitment(review):
    _need(type(review) is FinalReview and all(_pin(value) for value in (
        review.frozen_checkpoint_sha256, review.final_policy_sha256, review.final_panel_sha256,
        review.final_evaluation_sha256, review.final_terminal_close_sha256, review.retention_selection_sha256))
        and (review.retention_reference_sha256 is None or _pin(review.retention_reference_sha256))
        and type(review.components) is tuple and bool(review.components)
        and all(type(close) is ComponentClose and all(_pin(pin) for pin in asdict(close).values())
                for close in review.components)
        and type(review.rows) is tuple
        and all(type(row) is RowReview and type(row.row_id) is str for row in review.rows),
        "exact final-only evaluation closes and independent review roster required")
    return _commit((FINAL_REVIEW_SCHEMA, asdict(review)))


def prepare_final_evaluation_report(threshold, *, choice, selection, candidate_manifest, plans, components,
                                     retention_selection, expected_retention_selection_sha256,
                                     retention_reference, review, expected_review_sha256,
                                     verify_final_review_owner, verify_final_baseline_owner=None):
    """Join the complete final panel to independent findings without a development look."""
    from . import relational_trial

    _need(type(plans) is type(components) is tuple and bool(plans)
          and callable(verify_final_review_owner) and _pin(expected_review_sha256)
          and _pin(expected_retention_selection_sha256)
          and final_retention_selection_commitment(retention_selection) == expected_retention_selection_sha256
          and final_review_commitment(review) == expected_review_sha256,
          "independently selected final plans, baseline policy and review required")
    lead = plans[0]
    final_scoring_commitment(choice, lead)
    scope, _, examples, members, aliases, train_occurrences, groups = _final_panel_scope(choice, lead, selection)
    frozen_pin = _commit(choice.checkpoint)
    candidate = _evidence_json(candidate_manifest, 2 * 1024**2)
    model_pair = (candidate.get("model_state"), candidate.get("optimizer_state"))
    progress = candidate.get("progress")
    expected_step = _frozen_optimizer_step(choice.checkpoint)
    scheduled_checkpoint = _frozen_checkpoint_identity(choice.checkpoint)
    archived_capture = _archived_capture_metadata(choice.checkpoint)
    _need(_sha(candidate_manifest) == lead.candidate_sha256
          and candidate.get("schema") == relational_trial.CHECKPOINT_SCHEMA
          and candidate.get("parent_checkpoint_sha256") == selection.trial.parent_manifest_sha256
          and all(_artifact(item) for item in model_pair) and model_pair[0]["path"] != model_pair[1]["path"]
          and type(progress) is dict and type(progress.get("optimizer_steps")) is int and progress["optimizer_steps"] > 0
          and (expected_step is None or progress["optimizer_steps"] == expected_step)
          and type(candidate.get("backend_identity")) is dict and type(candidate.get("producer_pins")) is dict,
          "exact frozen candidate manifest and matched numerical asset references required")
    pair_pin = _commit((lead.route, model_pair, candidate["backend_identity"]))
    _need((frozen_pin, lead.panel_sha256, lead.evaluation_policy_sha256) ==
          (review.frozen_checkpoint_sha256, review.final_panel_sha256, review.final_policy_sha256) ==
          (retention_selection.frozen_checkpoint_sha256, retention_selection.final_panel_sha256,
           retention_selection.final_policy_sha256)
          and review.retention_selection_sha256 == expected_retention_selection_sha256
          and review.final_evaluation_sha256 != lead.attempt_sha256
          and review.final_terminal_close_sha256 != lead.trial_terminal_close_sha256
          and len(plans) == len(components) == len(review.components) == len(groups)
          and all(len({getattr(close, key) for close in review.components}) == len(groups)
                  for key in ("observation_sha256", "artifact_sha256", "owner_close_sha256")),
          "exact frozen final panel and one distinct close per complete component required")
    baseline_pin = None
    if retention_reference is not None:
        _need(type(retention_reference) is RetentionReference and callable(verify_final_baseline_owner)
              and (retention_reference.seed, retention_reference.panel_sha256, retention_reference.evaluation_policy_sha256)
                  == (choice.checkpoint["seed"], review.final_panel_sha256, review.final_policy_sha256)
              and _pin(retention_reference.baseline_checkpoint_sha256)
              and retention_reference.baseline_checkpoint_sha256 == retention_selection.baseline_checkpoint_sha256
              and _pin(retention_reference.baseline_receipt_sha256),
              "retention requires the preregistered baseline on the exact final panel and policy")
        baseline_pin = retention_commitment(retention_reference)
    _need(baseline_pin == review.retention_reference_sha256,
          "final review does not bind the exact independently selected baseline receipt")

    found = {}
    scoring_pins = []
    header = ("study_sha256", "arm", "seed", "attempt_sha256", "look", "candidate_sha256",
              "trial_terminal_close_sha256", "route", "panel_sha256", "evaluation_policy_sha256",
              "retention_reference_sha256")
    for (group, cases), plan, component, close in zip(groups.items(), plans, components, review.components, strict=True):
        scoring_pin = final_scoring_commitment(choice, plan)
        _need(type(component) is tuple and len(component) == 2, "one selected final artifact per component required")
        observation, saved = component
        local_pin = cases[0].split_sha256
        expected_scope = {"frozen_checkpoint_sha256": frozen_pin, "global_split_sha256": scope["global_split_sha256"],
                          "component_split_sha256": local_pin, "dependency_group_sha256": group, "role": "final"}
        _need(all(case.split_sha256 == local_pin for case in cases)
              and type(observation) is dict
              and _retains_frozen_checkpoint_identity(observation, scheduled_checkpoint)
              and _archived_capture_metadata(observation) == archived_capture
              and all(observation.get(key) == getattr(plan, key) == getattr(lead, key) for key in header)
              and type(observation.get("seed")) is int and _pin(observation.get("loader_receipt_sha256"))
              and type(observation.get("optimizer_steps")) is int
              and observation["optimizer_steps"] == progress["optimizer_steps"]
              and plan.retention_reference_sha256 == expected_retention_selection_sha256
              and observation.get("assessment_sha256") == commitment(plan)
              and observation.get("final_scoring_sha256") == scoring_pin,
              "final component differs from the frozen checkpoint, policy or selected scoring plan")
        joined, pair = _closed_component(observation, saved, close, cases, group, final_scope=expected_scope)
        declaration = saved["metadata"]["source_generation_observation"]["input_commitment"]
        _need(pair_pin == pair and declaration.get("source_sha256") == candidate["producer_pins"],
              "final component did not use the frozen candidate model, optimizer and source")
        payload = saved["compiler_artifact"]["reviewed_source_span_producer_evaluation"]
        for case, row in zip(cases, payload["reference_population"], strict=True):
            member = members[aliases[case.row_id]]
            _development_reference(case, row, member, examples[member.row_id], train_occurrences)
        found.update(joined)
        scoring_pins.append(scoring_pin)

    findings = {row.row_id: row for row in review.rows}
    _need(len(findings) == len(review.rows) and findings.keys() <= found.keys(),
          "final findings cannot repeat or introduce an out-of-panel row")
    policy = choice.final_policy
    normalized = {case.row_id: _reviewed_row(*found[case.row_id], findings.get(case.row_id), case)
                  for case in policy.cases}
    counts = _gate_counts(threshold, policy, retention_reference, normalized)
    result = {"schema": FINAL_REPORT_SCHEMA, "review_sha256": expected_review_sha256,
              "frozen_checkpoint_sha256": frozen_pin, "study_sha256": choice.checkpoint["study_sha256"],
              "trained_attempt_sha256": choice.checkpoint["attempt_sha256"], "checkpoint_sha256": lead.candidate_sha256,
              "matched_pair_sha256": pair_pin, "final_evaluation_sha256": review.final_evaluation_sha256,
              "final_terminal_close_sha256": review.final_terminal_close_sha256,
              "final_panel_sha256": review.final_panel_sha256, "final_policy_sha256": review.final_policy_sha256,
              "retention_selection_sha256": expected_retention_selection_sha256, "retention_reference_sha256": baseline_pin,
              "baseline_checkpoint_sha256": retention_selection.baseline_checkpoint_sha256,
              "component_scoring_sha256s": tuple(scoring_pins), "component_closes": tuple(asdict(close) for close in review.components),
              "rows": tuple({"row_id": case.row_id, "producer_outcome": found[case.row_id][0],
                             "generation_sha256": found[case.row_id][1], "candidate_sha256": found[case.row_id][2],
                             "review_eligible": case.review_eligible, "formal_required": case.formal_required,
                             **normalized[case.row_id]} for case in policy.cases),
              "counts": {key: asdict(value) for key, value in counts.items()}}
    if expected_step is not None:
        result.update(optimizer_step_grid_sha256=choice.checkpoint["optimizer_step_grid_sha256"],
                      optimizer_steps=expected_step)
    if scheduled_checkpoint is not None:
        result["scheduled_checkpoint"] = asdict(scheduled_checkpoint)
    if archived_capture is not None:
        result["archived_capture"] = archived_capture
    if baseline_pin is not None:
        _need(verify_final_baseline_owner(expected_retention_selection_sha256, baseline_pin) is True,
              "independent final baseline owner refused its exact receipt")
    _need(verify_final_review_owner(expected_review_sha256, frozen_pin) is True
          and final_review_commitment(review) == expected_review_sha256
          and final_retention_selection_commitment(retention_selection) == expected_retention_selection_sha256
          and (retention_reference is None or retention_commitment(retention_reference) == baseline_pin)
          and tuple(final_scoring_commitment(choice, plan) for plan in plans) == tuple(scoring_pins)
          and all((_commit(component[0]), _commit(component[1])) == (close.observation_sha256, close.artifact_sha256)
                  for component, close in zip(components, review.components, strict=True)),
          "final owner refused or selected final evidence changed during verification")
    return result


T5_FUSION_FINAL_REPORT_SCHEMA = "reviewed-t5-fusion-span-policy-final-panel-report/v1"


def t5_fusion_span_final_review_subject(scoring, plan):
    t5_fusion_span_final_scoring_commitment(scoring, plan)
    return _commit((T5_FUSION_FINAL_REPORT_SCHEMA, "slot", scoring.frozen_roster_sha256, scoring.study_seed,
        scoring.final_panel_binding_sha256, plan.study_sha256, plan.arm, plan.seed, plan.attempt_sha256,
        plan.candidate_sha256, plan.trial_terminal_close_sha256, plan.panel_sha256, plan.evaluation_policy_sha256))


def t5_fusion_span_final_review_roster_commitment(plans, scorings):
    _need(type(plans) is type(scorings) is tuple and bool(plans) and len(plans) == len(scorings),
          "one ordered policy FINAL scoring selection per component required")
    pins = tuple(t5_fusion_span_final_scoring_commitment(scoring, plan)
                 for plan, scoring in zip(plans, scorings, strict=True))
    _need(len(pins) == len(set(pins)) and len(pins) == len({scoring.dependency_group_sha256 for scoring in scorings}),
          "policy FINAL scoring selections cannot repeat a component")
    return _commit((T5_FUSION_FINAL_REPORT_SCHEMA, "scoring-roster", pins))


def prepare_t5_fusion_span_final_report(threshold, *, selection, frozen, freeze_plan, validation_split,
        validation_policy, final_policy, case_aliases, candidate_manifest, worker_receipt, terminal_close,
        verify_policy_owner_close, plans, scorings, expected_scoring_roster_sha256, components,
        retention_selection, expected_retention_selection_sha256, retention_reference, review, expected_review_sha256,
        verify_final_review_owner, verify_final_baseline_owner=None, fused_proof_pair=None):
    """Join the exact closed policy FINAL panel to independent review and retention facts."""
    from .relational_trial import policy_close_commitment

    _need(type(components) is tuple and callable(verify_final_review_owner)
          and all(_pin(value) for value in (expected_scoring_roster_sha256, expected_retention_selection_sha256,
                                           expected_review_sha256))
          and t5_fusion_span_final_review_roster_commitment(plans, scorings) == expected_scoring_roster_sha256
          and final_retention_selection_commitment(retention_selection) == expected_retention_selection_sha256
          and final_review_commitment(review) == expected_review_sha256,
          "independently selected policy FINAL scoring roster, retention and review required")
    lead, choice = plans[0], scorings[0]
    subject = t5_fusion_span_final_review_subject(choice, lead)

    def current_checkpoint():
        _need(t5_fusion_span_final_review_roster_commitment(plans, scorings) == expected_scoring_roster_sha256
              and t5_fusion_span_final_review_subject(choice, lead) == subject
              and t5_fusion_span_final_panel_binding(final_policy, case_aliases) == choice.final_panel_binding_sha256
              and gate_policy_commitment(final_policy) == lead.evaluation_policy_sha256,
              "policy FINAL panel or scoring selection changed during review")
        return _t5_fusion_final_checkpoint(choice, lead, selection, frozen, freeze_plan,
                                              validation_split, validation_policy)

    checkpoint = current_checkpoint()
    scope, global_split, examples, members, _ = _development_population_scope(validation_split.manifest,
        validation_split.population, validation_split.case_aliases, validation_policy,
        expected_development_sha256=freeze_plan.validation_split_sha256, manifest_sha256=freeze_plan.global_split_sha256)
    _need(scope["reserved_final_count"] == freeze_plan.reserved_final_count,
          "fused FINAL review reserve differs from the protected split")
    aliases, groups = _final_panel_membership(final_policy, case_aliases, lead.panel_sha256,
                                             freeze_plan.reserved_final_count, global_split, members, validation_policy)
    _need((subject, lead.panel_sha256, lead.evaluation_policy_sha256) ==
          (review.frozen_checkpoint_sha256, review.final_panel_sha256, review.final_policy_sha256) ==
          (retention_selection.frozen_checkpoint_sha256, retention_selection.final_panel_sha256,
           retention_selection.final_policy_sha256)
          and review.retention_selection_sha256 == expected_retention_selection_sha256
          and len(plans) == len(components) == len(review.components) == len(groups)
          and tuple(scoring.dependency_group_sha256 for scoring in scorings) == tuple(groups)
          and all(len({getattr(close, field) for close in review.components}) == len(groups)
                  for field in ("observation_sha256", "artifact_sha256", "owner_close_sha256")),
          "policy FINAL review must cover the exact selected slot and every ordered closed component")
    prior_ids = set()
    for slot in frozen["slots"]:
        prior = slot.get("checkpoint")
        _need("checkpoint" in slot and (prior is None or type(prior) is dict),
              "policy FINAL roster must retain its original checkpoint or unavailability")
        pins = (slot.get("attempt_sha256"), slot.get("closeout_receipt_sha256"))
        if prior is not None:
            pins += (prior.get("development_evaluation_sha256"), prior.get("trial_terminal_close_sha256"))
        _need(all(_pin(pin) for pin in pins), "policy FINAL roster must retain its original activity identities")
        prior_ids.update(pins)
    final_ids = (review.final_evaluation_sha256, review.final_terminal_close_sha256,
                 *(close.owner_close_sha256 for close in review.components))
    _need(len(set(final_ids)) == len(final_ids) and prior_ids.isdisjoint(final_ids),
          "policy FINAL closure cannot reuse its prior training or VALIDATION activity")

    baseline_pin = None
    if retention_reference is not None:
        _need(type(retention_reference) is RetentionReference and callable(verify_final_baseline_owner)
              and (retention_reference.seed, retention_reference.panel_sha256, retention_reference.evaluation_policy_sha256)
                  == (choice.study_seed, lead.panel_sha256, lead.evaluation_policy_sha256)
              and retention_reference.baseline_checkpoint_sha256 == retention_selection.baseline_checkpoint_sha256
              and retention_reference.baseline_checkpoint_sha256 != lead.candidate_sha256
              and _pin(retention_reference.baseline_checkpoint_sha256)
              and _pin(retention_reference.baseline_receipt_sha256),
              "policy FINAL retention must use its separately selected baseline on the same panel and policy")
        baseline_pin = retention_commitment(retention_reference)
    _need(baseline_pin == review.retention_reference_sha256,
          "policy FINAL review differs from its selected independent baseline receipt")

    checkpoint_pin = _commit(checkpoint)
    link = _bind_fused_final_policy_candidate(selection, lead, checkpoint, candidate_manifest, worker_receipt,
                                              terminal_close, verify_policy_owner_close, fused_proof_pair=fused_proof_pair)
    _need(_commit(current_checkpoint()) == checkpoint_pin, "policy FINAL checkpoint changed during closed worker binding")
    _need(_pin(link.get("owner_execution_record_sha256"))
          and set(final_ids).isdisjoint((link["owner_execution_record_sha256"], link["worker_receipt_sha256"])),
          "fused FINAL closures cannot reuse the selected TRAIN owner or worker receipt")
    candidate = _evidence_json(candidate_manifest, 2 * 1024**2)
    pair_pin = _commit((lead.route, (link["model_checkpoint"], link["optimizer_checkpoint"]), candidate["backend_identity"]))
    link_pin = _commit(link)
    train_occurrences = {occurrence for _, occurrence in validation_split.train_occurrences}
    header = ("study_sha256", "arm", "seed", "attempt_sha256", "look", "candidate_sha256",
              "trial_terminal_close_sha256", "route", "panel_sha256", "evaluation_policy_sha256",
              "retention_reference_sha256")
    found, scoring_pins, teacher_bindings = {}, [], []
    for (group, cases), plan, scoring, component, close in zip(
            groups.items(), plans, scorings, components, review.components, strict=True):
        _need(type(component) is tuple and len(component) == 2, "one saved policy FINAL artifact per component required")
        observation, saved = component
        scoring_pin = t5_fusion_span_final_scoring_commitment(scoring, plan)
        local_pin = cases[0].split_sha256
        scope = {"frozen_roster_sha256": choice.frozen_roster_sha256, "global_split_sha256": freeze_plan.global_split_sha256,
                 "component_split_sha256": local_pin, "dependency_group_sha256": group, "role": "final"}
        _need(t5_fusion_span_final_review_subject(scoring, plan) == subject
              and all(case.split_sha256 == local_pin for case in cases)
              and type(observation) is dict and {"scheduled_checkpoint", "archived_capture"}.isdisjoint(observation)
              and all(observation.get(key) == getattr(plan, key) == getattr(lead, key) for key in header)
              and type(observation.get("seed")) is int and _pin(observation.get("loader_receipt_sha256"))
              and type(observation.get("optimizer_steps")) is int
              and observation["optimizer_steps"] == plan.optimizer_steps == checkpoint["optimizer_steps"]
              and plan.retention_reference_sha256 == expected_retention_selection_sha256
              and observation.get("assessment_sha256") == commitment(plan)
              and observation.get("final_scoring_sha256") == scoring_pin
              and observation.get("policy_candidate_sha256") == link_pin
              and observation.get("t5_fusion_assessment_binding_sha256") == plan.t5_fusion_assessment_binding_sha256
              and observation.get("matched_teacher_inputs_sha256") == plan.matched_teacher_inputs_sha256,
              "fused FINAL observation differs from the exact arm, closed model, step or component selection")
        joined, pair = _closed_component(observation, saved, close, cases, group, final_scope=scope, fused_final=True)
        declaration = saved["metadata"]["source_generation_observation"]["input_commitment"]
        _need(pair == pair_pin and declaration.get("source_sha256") == candidate["producer_pins"],
              "policy FINAL component did not use the frozen candidate model, optimizer and source epoch")
        teacher_binding = declaration.get("t5_fusion_assessment_binding")
        _require_t5_fusion_final_role(plan, link, teacher_binding)
        expected_sources = tuple((case.row_id, members[aliases[case.row_id]].source_wire_sha256,
                                  members[aliases[case.row_id]].source_span_sha256) for case in cases)
        _need(teacher_binding["frozen_roster_sha256"] == choice.frozen_roster_sha256
              and tuple((row["row_id"], row["source_wire_sha256"], row["source_span_sha256"])
                        for row in teacher_binding["rows"]) == expected_sources
              and all(row["slot_width"] == checkpoint["t5_fusion_training_binding"]["fusion_slot_width"]
                      for row in teacher_binding["rows"]),
              "fused FINAL review requires the exact frozen source wires, spans and scoring roster")
        teacher_bindings.append({"dependency_group_sha256": group, "final_batch_sha256": teacher_binding["final_batch_sha256"],
            "t5_fusion_assessment_binding_sha256": plan.t5_fusion_assessment_binding_sha256,
            "matched_teacher_inputs_sha256": plan.matched_teacher_inputs_sha256,
            "component_owner_close_sha256": close.owner_close_sha256})
        payload = saved["compiler_artifact"]["reviewed_source_span_producer_evaluation"]
        for case, row in zip(cases, payload["reference_population"], strict=True):
            member = members[aliases[case.row_id]]
            _development_reference(case, row, member, examples[member.row_id], train_occurrences,
                                   split_metadata=global_split.metadata)
        found.update(joined)
        scoring_pins.append(scoring_pin)

    findings = {row.row_id: row for row in review.rows}
    _need(len(findings) == len(review.rows) and findings.keys() <= found.keys(),
          "policy FINAL findings cannot repeat or introduce an out-of-panel row")
    normalized = {case.row_id: _reviewed_row(*found[case.row_id], findings.get(case.row_id), case)
                  for case in final_policy.cases}
    counts = _gate_counts(threshold, final_policy, retention_reference, normalized)
    if baseline_pin is not None:
        _need(verify_final_baseline_owner(expected_retention_selection_sha256, baseline_pin) is True,
              "independent policy FINAL baseline owner refused its exact receipt")
        _require_current_fused_assessment_proof(selection, lead.policy_attempt_sha256, fused_proof_pair,
                                                terminal_close, lead.trial_terminal_close_sha256)
    _need(_commit(current_checkpoint()) == checkpoint_pin
          and verify_final_review_owner(expected_review_sha256, subject, expected_scoring_roster_sha256) is True
          and _commit(current_checkpoint()) == checkpoint_pin and final_review_commitment(review) == expected_review_sha256
          and policy_close_commitment(terminal_close) == lead.trial_terminal_close_sha256
          and final_retention_selection_commitment(retention_selection) == expected_retention_selection_sha256
          and (retention_reference is None or retention_commitment(retention_reference) == baseline_pin)
          and all((_commit(component[0]), _commit(component[1])) == (close.observation_sha256, close.artifact_sha256)
                  for component, close in zip(components, review.components, strict=True)),
          "policy FINAL review owner refused or changed the selected evidence")
    _require_current_fused_assessment_proof(selection, lead.policy_attempt_sha256, fused_proof_pair,
                                            terminal_close, lead.trial_terminal_close_sha256)
    report = {"schema": T5_FUSION_FINAL_REPORT_SCHEMA, "review_sha256": expected_review_sha256,
            "component_teacher_bindings": tuple(teacher_bindings),
            "frozen_checkpoint_sha256": subject, "frozen_roster_sha256": choice.frozen_roster_sha256,
            "final_reservation_sha256": freeze_plan.final_reservation_sha256, "study_sha256": lead.study_sha256,
            "study_seed": choice.study_seed, "arm": lead.arm, "trained_attempt_sha256": lead.attempt_sha256,
            "checkpoint_sha256": lead.candidate_sha256, "matched_pair_sha256": pair_pin,
            "optimizer_steps": checkpoint["optimizer_steps"], "optimizer_step_grid_sha256": freeze_plan.optimizer_step_grid_sha256,
            "final_evaluation_sha256": review.final_evaluation_sha256, "final_terminal_close_sha256": review.final_terminal_close_sha256,
            "final_panel_sha256": lead.panel_sha256, "final_policy_sha256": lead.evaluation_policy_sha256,
            "retention_selection_sha256": expected_retention_selection_sha256, "retention_reference_sha256": baseline_pin,
            "baseline_checkpoint_sha256": retention_selection.baseline_checkpoint_sha256,
            "scoring_roster_sha256": expected_scoring_roster_sha256, "component_scoring_sha256s": tuple(scoring_pins),
            "component_closes": tuple(asdict(close) for close in review.components),
            "rows": tuple({"row_id": case.row_id, "producer_outcome": found[case.row_id][0],
                           "generation_sha256": found[case.row_id][1], "candidate_sha256": found[case.row_id][2],
                           "review_eligible": case.review_eligible, "formal_required": case.formal_required,
                           **normalized[case.row_id]} for case in final_policy.cases),
            "counts": {key: asdict(value) for key, value in counts.items()}}
    if _fused_statutory_source_admissions(components):
        report["source_admission_evidence_kind"] = "native_reviewed"
    return report
