"""Pair the existing threshold decisions across a frozen training experiment.

The existing evaluator and resource owners authenticate the assessment,
membership, meter coverage and charge manifests before supplying them here.
This comparison never infers legal correctness from a generated artifact.
"""
from collections import Counter
from copy import deepcopy
from dataclasses import asdict, dataclass, is_dataclass, replace
from fractions import Fraction
from hashlib import sha256
import json
from math import isfinite, log, sqrt


SCHEMA = "paired-cost-to-confirmed-heldout-threshold/v1"
CONTRAST_SCHEMA = "paired-cost-to-confirmed-heldout-threshold-contrasts/v1"
CUMULATIVE_ARM = "whole-arm-from-start-through-closed-observation/v1"
UNCERTAINTY_SCOPE = "bounds_over_unknown_observations_only"


@dataclass(frozen=True)
class Study:
    arms: tuple[tuple[str, str], ...]   # First arm is the declared baseline.
    seeds: tuple["Seed", ...]
    panel: tuple[tuple[str, str, str], ...]  # Row, dependency component, language.
    evaluation_policy_sha256: str
    cost_policy_sha256: str
    schedule: tuple[str, ...]
    gates: tuple[Fraction, ...]  # Existing GATES order.
    required_streak: int
    horizons: tuple[float | None, ...]  # Existing CLOCKS order.
    budget_caps: tuple[float | None, ...]  # Execution caps are separate from analysis horizons.
    cost_basis: str
    reuse_count: int | None
    stop_after_confirmation: bool


@dataclass(frozen=True)
class Seed:
    identifier: str
    retention_reference_sha256: str
    gate_denominators: tuple[int, ...]  # Existing GATES order.


@dataclass(frozen=True)
class Meter:
    stage: str
    scope: str
    attempt_sha256: str
    cost_policy_sha256: str
    record_sha256: str
    interval_manifest_sha256: str
    charge_manifest_sha256: str
    includes_failed_attempts: bool
    costs: object  # Existing threshold.Costs.
    clock_receipts: tuple[str | None, ...]


@dataclass(frozen=True)
class Assessment:
    look: str
    checkpoint_sha256: str
    evaluation_receipt_sha256: str
    panel_sha256: str
    evaluation_policy_sha256: str
    retention_reference_sha256: str
    gates: dict  # Existing threshold.Counts or None for each gate.
    meter: Meter


@dataclass(frozen=True)
class Attempt:
    arm: str
    seed: str
    recipe_sha256: str
    attempt_sha256: str
    study_sha256: str
    assessments: tuple[Assessment, ...]
    closeout_status: str
    closing_meter: Meter
    closeout_receipt_sha256: str
    budget_clock: str | None = None
    cap_receipt_sha256: str | None = None


@dataclass(frozen=True)
class Contrast:
    identifier: str
    baseline: str
    candidate: str
    role: str


@dataclass(frozen=True)
class ContrastPlan:
    study_sha256: str
    contrasts: tuple[Contrast, ...]


def _require(ok, message):
    if not ok:
        raise ValueError(message)


def _pin(value):
    return type(value) is str and len(value) == 64 and all(c in "0123456789abcdef" for c in value)


def _name(value):
    return type(value) is str and 0 < len(value) <= 512


def _wire(value):
    if type(value) is Fraction:
        return (value.numerator, value.denominator)
    if is_dataclass(value):
        return _wire(asdict(value))
    if type(value) is dict:
        return {key: _wire(item) for key, item in value.items()}
    if type(value) in (list, tuple):
        return tuple(_wire(item) for item in value)
    return value


def commitment(value):
    raw = json.dumps(_wire(value), ensure_ascii=True, allow_nan=False, sort_keys=True, separators=(",", ":"))
    return sha256(raw.encode("ascii")).hexdigest()


def _arm_names(study):
    _require(type(study.arms) is tuple and len(study.arms) >= 2
             and all(type(entry) is tuple and len(entry) == 2 and _name(entry[0]) and _pin(entry[1])
                     for entry in study.arms), "ordered distinct baseline and candidate recipes required")
    names = {entry[0] for entry in study.arms}
    _require(len(names) == len(study.arms), "ordered distinct baseline and candidate recipes required")
    return names


def _study(validator, study, expected):
    _require(type(study) is Study and _pin(expected) and commitment(study) == expected
             and _pin(study.evaluation_policy_sha256) and _pin(study.cost_policy_sha256),
             "independently selected threshold study required")
    _arm_names(study)
    _require(type(study.panel) is tuple and study.panel
             and all(type(row) is tuple and len(row) == 3 and all(_name(x) for x in row) for row in study.panel)
             and len({row[0] for row in study.panel}) == len(study.panel),
             "one frozen dependency and language membership per panel row required")
    _require(type(study.seeds) is tuple and study.seeds
             and all(type(seed) is Seed and _name(seed.identifier) and _pin(seed.retention_reference_sha256)
                     and type(seed.gate_denominators) is tuple and len(seed.gate_denominators) == len(validator.GATES)
                     and all(type(n) is int and 0 <= n <= len(study.panel) for n in seed.gate_denominators)
                     and seed.gate_denominators[validator.GATES.index("coverage")] == len(study.panel)
                     for seed in study.seeds)
             and len({seed.identifier for seed in study.seeds}) == len(study.seeds),
             "complete distinct seed roster with fixed review and retention denominators required")
    _require(type(study.schedule) is tuple and "close" not in study.schedule
             and type(study.gates) is tuple and len(study.gates) == len(validator.GATES)
             and type(study.horizons) is tuple and len(study.horizons) == len(validator.CLOCKS)
             and any(value is not None for value in study.horizons)
             and all(value is None or type(value) is float and isfinite(value) and value > 0 for value in study.horizons)
             and type(study.stop_after_confirmation) is bool,
             "matched evaluation grid, gate cutoffs and finite common horizons required")
    _require(type(study.budget_caps) is tuple and len(study.budget_caps) == len(validator.CLOCKS)
             and all(value is None or type(value) is float and isfinite(value) and value > 0
                     for value in study.budget_caps)
             and (study.cost_basis == "first_use" and study.reuse_count is None
                  or study.cost_basis == "amortized" and type(study.reuse_count) is int and study.reuse_count >= 1),
             "predeclared execution caps and first-use or measured amortization basis required")
    return (dict(zip(validator.GATES, study.gates, strict=True)),
            dict(zip(validator.CLOCKS, study.horizons, strict=True)),
            dict(zip(validator.CLOCKS, study.budget_caps, strict=True)))


def _meter(validator, meter, attempt, study, stage):
    return _meter_costs(validator, meter, attempt_sha256=attempt.attempt_sha256,
                        cost_policy_sha256=study.cost_policy_sha256, stage=stage, scope=CUMULATIVE_ARM)


def _meter_costs(validator, meter, *, attempt_sha256, cost_policy_sha256, stage, scope):
    _require(type(meter) is Meter and meter.stage == stage and meter.scope == scope
             and meter.attempt_sha256 == attempt_sha256 and meter.cost_policy_sha256 == cost_policy_sha256
             and all(_pin(value) for value in (meter.record_sha256, meter.interval_manifest_sha256,
                                               meter.charge_manifest_sha256))
             and meter.includes_failed_attempts is True and type(meter.costs) is validator.Costs
             and type(meter.clock_receipts) is tuple and len(meter.clock_receipts) == len(validator.CLOCKS),
             "whole-arm meter with charged-event and interval evidence required")
    for clock, receipt in zip(validator.CLOCKS, meter.clock_receipts, strict=True):
        value = getattr(meter.costs, clock)
        _require((value is None and receipt is None)
                 or type(value) is float and isfinite(value) and value >= 0 and _pin(receipt),
                 "measured clock must bind its own receipt and absence carries no value")
    return meter.costs


def _evaluate(validator, study, study_pin, attempt, arm, seed, thresholds, budget_caps, panel_pin):
    _require(type(attempt) is Attempt
             and (attempt.arm, attempt.seed, attempt.recipe_sha256, attempt.study_sha256) ==
                 (arm[0], seed.identifier, arm[1], study_pin)
             and _pin(attempt.attempt_sha256) and _pin(attempt.closeout_receipt_sha256)
             and type(attempt.assessments) is tuple,
             "attempt differs from the frozen arm, seed, recipe or study roster")
    observed = []
    evaluation_receipts = set()
    for assessment in attempt.assessments:
        _require(type(assessment) is Assessment
                 and assessment.panel_sha256 == panel_pin
                 and assessment.evaluation_policy_sha256 == study.evaluation_policy_sha256
                 and assessment.retention_reference_sha256 == seed.retention_reference_sha256
                 and _pin(assessment.checkpoint_sha256)
                 and _pin(assessment.evaluation_receipt_sha256)
                 and assessment.evaluation_receipt_sha256 not in evaluation_receipts
                 and type(assessment.gates) is dict and set(assessment.gates) == set(validator.GATES),
                 "assessment differs from the frozen panel, policy or retention reference")
        evaluation_receipts.add(assessment.evaluation_receipt_sha256)
        for name, denominator in zip(validator.GATES, seed.gate_denominators, strict=True):
            count = assessment.gates[name]
            _require(count is None or type(count) is validator.Counts and type(count.denominator) is int
                     and count.denominator == denominator, "gate denominator drift for " + name)
        costs = _meter(validator, assessment.meter, attempt, study, assessment.look)
        observed.append(validator.Look(assessment.look, assessment.gates, costs))
    costs = _meter(validator, attempt.closing_meter, attempt, study, "close")
    cap = None
    if attempt.closeout_status == "budget_limit":
        clock = attempt.budget_clock
        cap = budget_caps.get(clock) if type(clock) is str else None
        _require(cap is not None and _pin(attempt.cap_receipt_sha256), "cap not bound to a frozen execution ceiling and exact evidence")
    close = validator.Closeout(attempt.closeout_status, costs, attempt.budget_clock, cap, attempt.cap_receipt_sha256)
    decision = validator.evaluate_threshold(schedule=study.schedule, thresholds=thresholds,
        required_streak=study.required_streak, observed=tuple(observed), closeout=close)
    if close.status == "complete" and len(observed) < len(study.schedule):
        _require(study.stop_after_confirmation and bool(observed)
                 and decision.confirming_checkpoint == observed[-1].checkpoint_id,
                 "early successful close needs the predeclared stop rule at its actual confirming look")
    return decision


def _confirmation_block(decision, attempt, budget_caps, *, require_complete_cap_observation=False):
    if decision.status != "reached":
        return None
    for clock, cap in budget_caps.items():
        stamp = getattr(decision.confirming_costs, clock)
        if cap is not None and stamp is not None and stamp > cap:
            return clock, cap, "confirmation_beyond_execution_cap"
    if attempt.closeout_status == "budget_limit":
        clock = attempt.budget_clock
        if getattr(decision.confirming_costs, clock) is None:
            return clock, budget_caps[clock], "confirmation_limiting_clock_unavailable"
    if require_complete_cap_observation:
        for clock, cap in budget_caps.items():
            if cap is not None and getattr(decision.confirming_costs, clock) is None:
                return clock, cap, "confirmation_cap_clock_unavailable"
    return None


def _at_horizon(decision, clock, horizon, blocked):
    """Return an operational scheduled-confirmation indicator or explicit unknown."""
    if blocked is not None:
        limiting, cap, reason = blocked
        known_absent = reason == "confirmation_beyond_execution_cap" and clock == limiting and horizon <= cap
        return (0 if known_absent else None), reason
    if decision.status == "reached":
        stamp = getattr(decision.confirming_costs, clock)
        if stamp is None:
            return None, "confirmation_clock_unavailable"
        return int(stamp <= horizon), "confirmed_within_horizon" if stamp <= horizon else "confirmed_after_horizon"
    if decision.status in ("integrity_failure", "unfinished"):
        return None, decision.status
    closing = getattr(decision.closing_costs, clock)
    if closing is None:
        return None, "closing_clock_unavailable"
    if decision.status == "closed_without_reach":
        return 0, "complete_grid_without_confirmation"
    if closing >= horizon:
        return 0, "no_confirmation_through_budget_close"
    return None, "censored_before_this_clock_horizon"



def _evaluate_roster(validator, study, expected_study_sha256, attempts, expected_attempts_sha256, *,
                     require_complete_cap_observation=False):
    thresholds, horizons, budget_caps = _study(validator, study, expected_study_sha256)
    expected = tuple((arm, seed) for seed in study.seeds for arm in study.arms)
    _require(type(attempts) is tuple and len(attempts) == len(expected)
             and all(type(row) is Attempt and _pin(row.attempt_sha256) for row in attempts)
             and len({row.attempt_sha256 for row in attempts}) == len(attempts)
             and _pin(expected_attempts_sha256) and commitment(attempts) == expected_attempts_sha256,
             "complete independently committed paired attempt roster required")
    panel_pin = commitment(study.panel)
    outcomes, decisions = {}, []
    threshold_pin = commitment(thresholds)
    for (arm, seed), attempt in zip(expected, attempts, strict=True):
        selection = {name: Fraction(value.numerator, value.denominator) if type(value) is Fraction else value
                     for name, value in thresholds.items()}
        verdict = _evaluate(validator, study, expected_study_sha256, attempt, arm, seed, selection, budget_caps, panel_pin)
        _require(commitment(selection) == threshold_pin, "selected gate cutoffs changed during evaluation")
        blocked = _confirmation_block(verdict, attempt, budget_caps,
                                      require_complete_cap_observation=require_complete_cap_observation)
        outcomes[(seed.identifier, arm[0])] = (verdict, blocked)
        decisions.append({"arm": arm[0], "seed": seed.identifier, "attempt_sha256": attempt.attempt_sha256,
                          "decision": _wire(verdict), "confirmation_budget_block": blocked, "closeout_receipt_sha256": attempt.closeout_receipt_sha256,
                          "closing_meter_sha256": attempt.closing_meter.record_sha256,
                          "look_evidence": tuple({"look": look.look, "checkpoint_sha256": look.checkpoint_sha256,
                              "evaluation_receipt_sha256": look.evaluation_receipt_sha256,
                              "meter_record_sha256": look.meter.record_sha256, "gate_counts": _wire(look.gates)}
                              for look in attempt.assessments)})
    report = {"study_sha256": expected_study_sha256, "attempts_sha256": expected_attempts_sha256,
              "panel_sha256": panel_pin, "panel_rows": len(study.panel),
              "dependency_components": len({row[1] for row in study.panel}),
              "languages": tuple(sorted({row[2] for row in study.panel})),
              "seed_count": len(study.seeds), "cost_basis": study.cost_basis, "reuse_count": study.reuse_count,
              "attempts": tuple(decisions)}
    return report, outcomes, horizons


def _threshold_horizon(decision, blocked, clock, horizon):
    attained, reason = _at_horizon(decision, clock, horizon, blocked)
    measured = getattr(decision.confirming_costs, clock) if decision.status == "reached" and blocked is None else None
    return attained, reason, measured


def _paired_contrast(seeds, horizons, outcomes, baseline, candidate, *, resolve=_threshold_horizon):
    pairs, bounds = [], []
    seed_count = len(seeds)
    for clock, horizon in horizons.items():
        if horizon is None:
            continue
        lower, upper, both = 0, 0, 0
        known_baseline = known_candidate = confirmed_baseline = confirmed_candidate = 0
        for seed in seeds:
            (left, a_block), (right, b_block) = (outcomes[(seed.identifier, tag)] for tag in (baseline, candidate))
            a, a_reason, before = resolve(left, a_block, clock, horizon)
            b, b_reason, after = resolve(right, b_block, clock, horizon)
            known_baseline += int(a is not None)
            known_candidate += int(b is not None)
            confirmed_baseline += int(a == 1)
            confirmed_candidate += int(b == 1)
            lower += (0 if b is None else b) - (1 if a is None else a)
            upper += (1 if b is None else b) - (0 if a is None else a)
            delta = after-before if before is not None and after is not None else None
            both += int(delta is not None)
            pairs.append({"seed": seed.identifier, "baseline": baseline, "candidate": candidate, "clock": clock,
                          "horizon": horizon, "baseline_attained": a, "baseline_reason": a_reason,
                          "candidate_attained": b, "candidate_reason": b_reason,
                          "observed_baseline_confirmation": before, "observed_candidate_confirmation": after,
                          "candidate_minus_baseline_seconds_if_both_observed": delta})
        bounds.append({"baseline": baseline, "candidate": candidate, "clock": clock, "horizon": horizon,
                       "paired_seeds": seed_count, "observed_time_pairs": both,
                       "known_baseline": known_baseline, "known_candidate": known_candidate,
                       "confirmed_baseline": confirmed_baseline, "confirmed_candidate": confirmed_candidate,
                       "paired_attainment_delta_bounds": (_wire(Fraction(lower, seed_count)),
                                                           _wire(Fraction(upper, seed_count)))})
    return pairs, bounds


def compare(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256):
    """Return the original baseline-to-all-candidates report."""
    report, outcomes, horizons = _evaluate_roster(
        validator, study, expected_study_sha256, attempts, expected_attempts_sha256)
    baseline = study.arms[0][0]
    pairs, bounds = [], []
    for arm, _ in study.arms[1:]:
        pair_rows, bound_rows = _paired_contrast(study.seeds, horizons, outcomes, baseline, arm)
        pairs.extend(pair_rows)
        bounds.extend(bound_rows)
    return {"schema": SCHEMA, **report, "pairs": tuple(pairs), "fixed_horizon_attainment": tuple(bounds),
            "uncertainty_scope": UNCERTAINTY_SCOPE}


def _selected_contrasts(study, expected_study_sha256, plan, expected_plan_sha256):
    _require(type(study) is Study and _pin(expected_study_sha256) and commitment(study) == expected_study_sha256
             and type(plan) is ContrastPlan and plan.study_sha256 == expected_study_sha256
             and type(plan.contrasts) is tuple and bool(plan.contrasts) and _pin(expected_plan_sha256)
             and all(type(item) is Contrast for item in plan.contrasts),
             "independently selected directed contrast plan for this study required")
    arm_names = _arm_names(study)
    identifiers, compared, selected = set(), set(), []
    for contrast in plan.contrasts:
        _require(_name(contrast.identifier)
                 and _name(contrast.baseline) and _name(contrast.candidate) and type(contrast.role) is str
                 and contrast.role in ("primary", "exploratory")
                 and contrast.baseline in arm_names and contrast.candidate in arm_names
                 and contrast.baseline != contrast.candidate, "exact contrast direction, declared arms and role required")
        pair = frozenset((contrast.baseline, contrast.candidate))
        _require(contrast.identifier not in identifiers and pair not in compared,
                 "contrast identifiers and arm pairs must be unique")
        identifiers.add(contrast.identifier)
        compared.add(pair)
        selected.append(asdict(contrast))
    _require(any(contrast["role"] == "primary" for contrast in selected), "at least one primary contrast required")
    _require(commitment(plan) == expected_plan_sha256,
             "independently selected directed contrast plan for this study required")
    return tuple(selected)


def compare_contrasts(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256,
                      contrast_plan, expected_contrast_plan_sha256):
    """Join preselected directional contrasts to one complete, unchanged attempt roster."""
    contrasts = _selected_contrasts(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    _require(type(attempts) is tuple and all(type(row) is Attempt for row in attempts)
             and _pin(expected_attempts_sha256) and commitment(attempts) == expected_attempts_sha256,
             "complete independently committed paired attempt roster required")
    selected_study, selected_attempts = deepcopy((study, attempts))
    report, outcomes, horizons = _evaluate_roster(
        validator, selected_study, expected_study_sha256, selected_attempts, expected_attempts_sha256,
        require_complete_cap_observation=True)
    _require(commitment(study) == commitment(selected_study) == expected_study_sha256
             and commitment(attempts) == commitment(selected_attempts) == expected_attempts_sha256
             and commitment(contrast_plan) == expected_contrast_plan_sha256,
             "study, attempts or contrast plan changed during evaluation")
    attempt_ids = {(row.seed, row.arm): row.attempt_sha256 for row in selected_attempts}
    for decision, attempt in zip(report["attempts"], selected_attempts, strict=True):
        decision["cost_evidence"] = {"closing_meter": _wire(attempt.closing_meter),
            "looks": tuple({"look": assessment.look, "meter": _wire(assessment.meter)}
                           for assessment in attempt.assessments)}
    pairs, bounds = [], []
    for contrast in contrasts:
        baseline, candidate = contrast["baseline"], contrast["candidate"]
        label = {"contrast_id": contrast["identifier"], "role": contrast["role"]}
        pair_rows, bound_rows = _paired_contrast(selected_study.seeds, horizons, outcomes, baseline, candidate)
        for pair in pair_rows:
            pairs.append({**pair, **label, "baseline_attempt_sha256": attempt_ids[(pair["seed"], baseline)],
                          "candidate_attempt_sha256": attempt_ids[(pair["seed"], candidate)]})
        bounds.extend({**row, **label} for row in bound_rows)
    return {"schema": CONTRAST_SCHEMA, **report, "contrasts": contrasts,
            "contrast_plan_sha256": expected_contrast_plan_sha256, "pairs": tuple(pairs),
            "fixed_horizon_attainment": tuple(bounds), "uncertainty_scope": UNCERTAINTY_SCOPE,
            "cost_accounting_scope": "original_cumulative_attempt_meters_no_cross_contrast_sum"}


COST_EVIDENCE_SCHEMA = "reviewed-physical-event-and-meter-evidence/v1"
VERIFIED_CONTRAST_SCHEMA = "paired-cost-to-confirmed-heldout-threshold-verified-cost/v1"
COVERED_CLOCKS = ("wall_seconds", "cpu_seconds", "gpu_seconds")
CLOSED_EVENT_OUTCOMES = frozenset({"complete", "failed", "cancelled", "refused", "budget_limit", "integrity_failure"})
ACTIVATION_CHARGES_SCHEMA = "reviewed-checkpoint-activation-diagnostic-charges/v1"
ACTIVATION_EVENT_KIND = "activation_diagnostic"


@dataclass(frozen=True)
class PaidEvent:
    """Canonical owner event with exclusive additive counters, when measured."""

    event_sha256: str
    close_receipt_sha256: str
    kind: str
    disposition: str
    cpu_ns: int | None
    gpu_ns: int | None


@dataclass(frozen=True)
class WallSpan:
    """Owner-observed elapsed interval from arm start to a closed observation."""

    clock_domain_sha256: str
    start_ns: int
    end_ns: int
    receipt_sha256: str


@dataclass(frozen=True)
class MeterInterval:
    attempt_sha256: str
    stage: str
    subject_sha256: str
    scope_receipt_sha256: str
    wall: WallSpan | None


@dataclass(frozen=True)
class ChargeManifest:
    attempt_sha256: str
    stage: str
    entries: tuple[tuple[str, Fraction], ...]


@dataclass(frozen=True)
class CostEvidence:
    study_sha256: str
    attempts_sha256: str
    events: tuple[PaidEvent, ...]
    observations: tuple[tuple[MeterInterval, ChargeManifest], ...]
    schema: str = COST_EVIDENCE_SCHEMA


@dataclass(frozen=True)
class ActivationDiagnosticCharge:
    """One exclusive diagnostic close and its first covered cumulative cut."""

    event_sha256: str
    attempt_sha256: str
    owner_close_sha256: str
    first_stage: str
    checkpoint_look: str | None = None
    checkpoint_sha256: str | None = None
    strict_readback_sha256: str | None = None


def activation_diagnostic_charges_commitment(charges):
    _require(type(charges) is tuple and bool(charges)
             and all(type(row) is ActivationDiagnosticCharge
                     and all(_pin(pin) for pin in (row.event_sha256, row.attempt_sha256, row.owner_close_sha256))
                     and _name(row.first_stage)
                     and ((row.checkpoint_look is row.checkpoint_sha256 is None)
                          or (_name(row.checkpoint_look) and row.checkpoint_look != "close"
                              and _pin(row.checkpoint_sha256)))
                     and (row.strict_readback_sha256 is None
                          or (row.checkpoint_sha256 is not None and _pin(row.strict_readback_sha256)))
                     for row in charges),
             "exact activation diagnostic events, first costs and optional observed checkpoint evidence required")
    event_ids = tuple(row.event_sha256 for row in charges)
    _require(event_ids == tuple(sorted(set(event_ids))), "activation diagnostic events must be ordered and unique")
    return commitment((ACTIVATION_CHARGES_SCHEMA, charges))


def _activation_charge_scopes(attempts, events, diagnostics):
    checkpoints = {row.attempt_sha256: {look.look: look.checkpoint_sha256 for look in row.assessments}
                   for row in attempts} if diagnostics else {}
    return _activation_charge_scopes_from_checkpoints(checkpoints, events, diagnostics)


def _activation_charge_scopes_from_checkpoints(checkpoints_by_attempt, events, diagnostics):
    diagnostic_events = {key for key, event in events.items() if event.kind == ACTIVATION_EVENT_KIND}
    _require(diagnostic_events == {row.event_sha256 for row in diagnostics},
             "paid activation diagnostics require their exact approved event roster")
    if not diagnostics:
        return diagnostic_events, {}
    close_counts = Counter(event.close_receipt_sha256 for event in events.values())
    scopes = {}
    for row in diagnostics:
        checkpoints = checkpoints_by_attempt.get(row.attempt_sha256)
        event = events[row.event_sha256]
        _require(checkpoints is not None and event.close_receipt_sha256 == row.owner_close_sha256
                 and close_counts[row.owner_close_sha256] == 1,
                 "activation diagnostic requires its exact attempt and exclusive paid owner close")
        stages = (*checkpoints, "close")
        _require(row.first_stage in stages, "activation diagnostic first charge must name an observed stage")
        first = stages.index(row.first_stage)
        if row.checkpoint_look is None:
            _require(row.first_stage == "close", "activation diagnostic without an observed checkpoint is terminal cost only")
        else:
            _require(checkpoints.get(row.checkpoint_look) == row.checkpoint_sha256
                     and stages.index(row.checkpoint_look) <= first,
                     "activation diagnostic must bind the exact observed checkpoint at or before its first charge")
        _require(row.strict_readback_sha256 is None or event.disposition == "complete",
                 "strict activation readback requires completed diagnostic work")
        for stage in stages[first:]:
            scopes.setdefault((row.attempt_sha256, stage), {})[row.event_sha256] = Fraction(1)
    return diagnostic_events, scopes


def meter_subject(attempt, assessment):
    """Bind an interval to the exact look or terminal observation it covers."""
    if assessment is None:
        subject = ("close", attempt.closeout_status, attempt.closeout_receipt_sha256,
                   attempt.budget_clock, attempt.cap_receipt_sha256)
    else:
        subject = (assessment.look, assessment.checkpoint_sha256, assessment.evaluation_receipt_sha256)
    return commitment((COST_EVIDENCE_SCHEMA, attempt.study_sha256, attempt.seed, attempt.arm,
                       attempt.recipe_sha256, attempt.attempt_sha256, subject))


def _event_roster(events):
    _require(type(events) is tuple and all(type(event) is PaidEvent and _pin(event.event_sha256)
             and _pin(event.close_receipt_sha256) and _name(event.kind) and type(event.disposition) is str
             and event.disposition in CLOSED_EVENT_OUTCOMES
             and all(value is None or type(value) is int and value >= 0 for value in (event.cpu_ns, event.gpu_ns))
             for event in events), "ordered physical paid event records and measured deltas required")
    ids = tuple(event.event_sha256 for event in events)
    _require(ids == tuple(sorted(set(ids))), "physical event identities must be unique and ordered")
    return {event.event_sha256: event for event in events}


def _event_shares(charges, events, previous):
    _require(type(charges.entries) is tuple
             and all(type(entry) is tuple and len(entry) == 2 and _pin(entry[0]) and entry[0] in events
                     and type(entry[1]) is Fraction and 0 < entry[1] <= 1 for entry in charges.entries),
             "exact known paid events and positive rational allocation required")
    shares = dict(charges.entries)
    _require(tuple(event_id for event_id, _ in charges.entries) == tuple(sorted(shares))
             and all(shares.get(event_id) == share for event_id, share in previous.items()),
             "cumulative paid events cannot disappear, repeat or change allocation")
    return shares


def _charged_seconds(events, shares, clock):
    values = [(getattr(events[event_id], clock), share) for event_id, share in shares.items()]
    if not values or any(value is None for value, _ in values):
        return None
    return float(sum(value * share for value, share in values) / 1_000_000_000)


def _wall_evidence(meter, wall, previous, cost_basis):
    elapsed, receipt = None, None
    if wall is not None:
        _require(type(wall) is WallSpan and _pin(wall.clock_domain_sha256) and _pin(wall.receipt_sha256)
                 and type(wall.start_ns) is type(wall.end_ns) is int and 0 <= wall.start_ns <= wall.end_ns,
                 "whole-arm wall endpoints and receipt required")
        _require(previous is None or (wall.clock_domain_sha256, wall.start_ns) ==
                 (previous.clock_domain_sha256, previous.start_ns) and wall.end_ns >= previous.end_ns,
                 "whole-arm wall clock origin changed or endpoint regressed")
        elapsed, receipt = (wall.end_ns - wall.start_ns) / 1_000_000_000, wall.receipt_sha256
    selected = (elapsed, receipt) if cost_basis == "first_use" else (None, None)
    _require((meter.costs.wall_seconds, meter.clock_receipts[0]) == selected,
             "wall must match observed whole-arm elapsed and cannot be amortized")
    return wall if wall is not None else previous


def _cost_observation(validator, study, attempt, look, observation, events, previous):
    stage = "close" if look is None else look.look
    meter = attempt.closing_meter if look is None else look.meter
    _meter(validator, meter, attempt, study, stage)
    _require(type(observation) is tuple and len(observation) == 2
             and type(observation[0]) is MeterInterval and type(observation[1]) is ChargeManifest,
             "typed interval and charge manifest required")
    interval, charges = observation
    _require((interval.attempt_sha256, interval.stage) == (charges.attempt_sha256, charges.stage)
             == (attempt.attempt_sha256, stage)
             and interval.subject_sha256 == meter_subject(attempt, look)
             and _pin(interval.scope_receipt_sha256)
             and commitment(interval) == meter.interval_manifest_sha256
             and commitment(charges) == meter.charge_manifest_sha256,
             "interval, charge or evaluation subject differs from the selected meter")
    return interval, charges, _event_shares(charges, events, previous)


def _cost_roster(validator, study, study_pin, attempts, attempts_pin, evidence, evidence_pin, *,
                 retrospective_look_closes=None, teacher_policy=None, activation_diagnostic_charges=(),
                 exclusive_non_teacher_work=False, require_original_terminal_event=False,
                 first_use_shared_work=None, first_use_interrupted_preparation_events=()):
    _study(validator, study, study_pin)
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS
             and (study.cost_basis == "first_use" or all(cap is None for cap in study.budget_caps)),
             "physical budget caps require first-use clocks; amortized costs are allocated work")
    expected = tuple((seed.identifier, *arm) for seed in study.seeds for arm in study.arms)
    _require(type(attempts) is tuple and len(attempts) == len(expected)
             and all(type(attempt) is Attempt and attempt.study_sha256 == study_pin
                     and (attempt.seed, attempt.arm, attempt.recipe_sha256) == cell
                     and _pin(attempt.attempt_sha256) and type(attempt.assessments) is tuple
                     and all(type(look) is Assessment for look in attempt.assessments)
                     for cell, attempt in zip(expected, attempts, strict=True))
             and len({attempt.attempt_sha256 for attempt in attempts}) == len(attempts)
             and _pin(attempts_pin) and commitment(attempts) == attempts_pin,
             "cost evidence requires the exact complete physical attempt roster")
    _require(type(evidence) is CostEvidence and evidence.schema == COST_EVIDENCE_SCHEMA and _pin(evidence_pin)
             and (evidence.study_sha256, evidence.attempts_sha256) == (study_pin, attempts_pin)
             and type(evidence.observations) is tuple
             and len(evidence.observations) == sum(len(attempt.assessments) + 1 for attempt in attempts)
             and commitment(evidence) == evidence_pin,
             "exact cost evidence for every look and terminal attempt required")
    if retrospective_look_closes is not None:
        _require(type(retrospective_look_closes) is dict
                 and set(retrospective_look_closes) == {
                     (attempt.attempt_sha256, look.look) for attempt in attempts for look in attempt.assessments}
                 and all(type(closes) is tuple and len(closes) == 2 and all(_pin(close) for close in closes)
                         and closes[0] != closes[1] for closes in retrospective_look_closes.values()),
                 "retrospective charge requirements must cover the exact observed look roster")

    events = _event_roster(evidence.events)
    shared_events = set()
    shared_by_attempt = {}
    _require(type(first_use_interrupted_preparation_events) is tuple
             and (first_use_shared_work is not None or not first_use_interrupted_preparation_events),
             "interrupted teacher preparation requires an exact selected shared roster")
    if first_use_shared_work is not None:
        first_use_shared_work_commitment(
            first_use_shared_work, interrupted_preparation_events=first_use_interrupted_preparation_events)
        shared_events = set(first_use_shared_work)
        interrupted = set(first_use_interrupted_preparation_events)
        attempt_by_id = {attempt.attempt_sha256: attempt for attempt in attempts}
        _require(study.cost_basis == "first_use" and teacher_policy is None
                 and shared_events <= events.keys()
                 and all(events[key].disposition == "complete" and events[key].kind in FIRST_USE_SHARED_WORK_EVENT_KINDS
                         for key in shared_events - interrupted),
                 "only completed selected first-use teacher production or behavior rollout can be split across arms")
        # The physical event roster already checks the canonical set of closed
        # dispositions. Sharing an interrupted event is specific to teacher
        # preparation; even a named rollout cannot use this exception.
        _require(all(events[key].kind == "teacher_production" for key in interrupted),
                 "interrupted first-use sharing requires selected closed teacher production")
        _require(study.budget_caps[1:] == (None, None),
                 "allocated first-use costs cannot enforce physical CPU or GPU budget caps")
        for event, (left, right) in first_use_shared_work.items():
            _require(left in attempt_by_id and right in attempt_by_id
                     and attempt_by_id[left].seed == attempt_by_id[right].seed
                     and attempt_by_id[left].arm != attempt_by_id[right].arm,
                     "first-use shared work requires two different selected arms at the same seed")
            for attempt_sha in (left, right):
                shared_by_attempt.setdefault(attempt_sha, {})[event] = Fraction(1, 2)
    diagnostic_events, diagnostic_scopes = _activation_charge_scopes(attempts, events, activation_diagnostic_charges)
    teacher_events = set()
    if teacher_policy is not None:
        teacher_roster_sha256, teacher_events, teacher_shares = teacher_policy
        _require(study.cost_basis == "amortized" and _pin(teacher_roster_sha256)
                 and teacher_events == {key for key, event in events.items() if event.kind == "teacher_production"}
                 and set(teacher_shares) == {attempt.attempt_sha256 for attempt in attempts},
                 "exact matched teacher producer events and consumer attempts required in amortized cost evidence")
        _require(all(any(events[event_id].disposition == "complete" for event_id in shares)
                     for shares in teacher_shares.values() if shares),
                 "each selected packet requires completed teacher production in its paid evidence")
    _require(len({event.close_receipt_sha256 for event in events.values()}) == len(events),
             "one physical close cannot be charged under multiple pilot event identities"
             if exclusive_non_teacher_work or shared_events else "one physical close cannot be charged under multiple event identities")
    allocations = {event_id: [] for event_id in events}
    observations = iter(evidence.observations)
    elapsed = []
    for attempt in attempts:
        _require(study.cost_basis == "first_use" or attempt.closeout_status != "budget_limit",
                 "allocated clocks cannot stand in for physical budget-limit evidence")
        previous = {}
        previous_wall = None
        for look in (*attempt.assessments, None):
            stage = "close" if look is None else look.look
            meter = attempt.closing_meter if look is None else look.meter
            interval, _, shares = _cost_observation(validator, study, attempt, look,
                                                    next(observations), events, previous)
            if diagnostic_events:
                _require({key: value for key, value in shares.items() if key in diagnostic_events}
                         == diagnostic_scopes.get((attempt.attempt_sha256, stage), {}),
                         "activation diagnostic charges must start at the exact stage and remain exclusive through close")
            if teacher_policy is not None:
                _require({key: value for key, value in shares.items() if key in teacher_events}
                         == teacher_shares[attempt.attempt_sha256],
                         "every look and terminal meter must retain the exact teacher production allocation")
            if shared_events:
                # This pre-use preparation is carried at every look and through
                # close, including on an arm that has no observed look.
                _require({key: value for key, value in shares.items() if key in shared_events}
                         == shared_by_attempt.get(attempt.attempt_sha256, {}),
                         "each selected first-use shared event requires exactly one half on both arms at every paid cut")
            if exclusive_non_teacher_work or shared_events:
                non_teacher = set(shares) - teacher_events - shared_events
                _require(all(shares[key] == 1 for key in non_teacher)
                         and (stage != "close" or bool(non_teacher)),
                         "every pilot attempt must pay its own non-teacher work, including zero-look failures")
            if require_original_terminal_event and look is None:
                _require(any(events[key].kind == "closeout"
                             and events[key].close_receipt_sha256 == attempt.closeout_receipt_sha256
                             and events[key].disposition == attempt.closeout_status
                             and shares[key] == 1 for key in shares),
                         "shuffled comparison must charge each original terminal close, including zero-look failures")
            if look is not None and retrospective_look_closes is not None:
                training_close, evaluation_close = retrospective_look_closes[attempt.attempt_sha256, stage]
                covered_closes = {events[event_id].close_receipt_sha256 for event_id in shares
                                  if events[event_id].disposition == "complete"
                                  and event_id not in diagnostic_events
                                  and event_id not in shared_events
                                  and (teacher_policy is None or event_id not in teacher_events)}
                _require(training_close in covered_closes and evaluation_close in covered_closes,
                         "retrospective look must charge its completed training and evaluation closes")
            previous_wall = _wall_evidence(meter, interval.wall, previous_wall, study.cost_basis)
            for seconds, nanoseconds in (("cpu_seconds", "cpu_ns"), ("gpu_seconds", "gpu_ns")):
                value = getattr(meter.costs, seconds)
                _require(value is None or value == _charged_seconds(events, shares, nanoseconds),
                         "additive measured clock differs from its complete charged-event deltas")
            previous = shares
            elapsed.append({"attempt_sha256": attempt.attempt_sha256, "stage": stage,
                            "wall": _wire(interval.wall)})
        for event_id, share in previous.items():
            allocations[event_id].append(share)

    _require(all(allocations[key] == [Fraction(1, 2), Fraction(1, 2)] for key in shared_events),
             "first-use shared work needs its exact conserved two-arm final allocation")
    _require_conserved_allocations({key: shares for key, shares in allocations.items() if key not in shared_events},
                                  study.reuse_count if study.cost_basis == "amortized" else None)
    return tuple(elapsed), _physical_work_ns(events)


def _require_conserved_allocations(allocations, reuse_count):
    for shares in allocations.values():
        count = len(shares)
        _require((count == 1 or count == reuse_count)
                 and sum(shares) == 1, "every paid event needs one conserved final allocation or exact measured reuse")


def _physical_work_ns(events):
    work = {}
    for clock in ("cpu_ns", "gpu_ns"):
        values = [getattr(event, clock) for event in events.values()]
        work[clock] = sum(values) if values and all(value is not None for value in values) else None
    return work


CONFIRMATION_COST_BOUNDS_SCHEMA = "reviewed-scheduled-confirmation-cost-bounds/v1"


def _confirmation_meter_window(attempt, clock, horizon, attainment, observed, reason):
    """Bracket a certified look only with verified cumulative meters on its own attempt."""
    decision = attempt["decision"]
    lower = upper = confirming = None
    if decision["status"] == "reached" and attempt["confirmation_budget_block"] is None:
        confirming = decision["confirming_checkpoint"]
        meters = attempt["cost_evidence"]
        looks = meters["looks"]
        index = next(index for index, row in enumerate(looks) if row["look"] == confirming)

        def measured(rows):
            return next((meter for meter in rows if meter["costs"][clock] is not None), None)

        if observed is not None:
            lower = upper = looks[index]["meter"]
        else:
            lower = measured(row["meter"] for row in reversed(looks[:index]))
            upper = measured([*(row["meter"] for row in looks[index + 1:]), meters["closing_meter"]])
            if upper is not None and upper["costs"][clock] <= horizon:
                attainment, reason = 1, "confirmed_by_later_authenticated_meter"
            elif lower is not None and lower["costs"][clock] > horizon:
                attainment, reason = 0, "after_horizon_by_earlier_authenticated_meter"
    low = None if lower is None else lower["costs"][clock]
    high = None if upper is None else upper["costs"][clock]
    restricted_lower = horizon if attainment == 0 else 0.0 if low is None else min(low, horizon)
    restricted_upper = horizon if attainment == 0 or high is None else min(high, horizon)
    return {"confirming_look": confirming, "attainment": attainment, "reason": reason,
            "observed_confirmation_seconds": observed, "lower_seconds": low, "upper_seconds": high,
            "lower_meter_sha256": None if lower is None else lower["record_sha256"],
            "upper_meter_sha256": None if upper is None else upper["record_sha256"],
            "restricted_confirmation_seconds": (restricted_lower, restricted_upper)}


def _verified_confirmation_cost_bounds(report, *, censor_followup=None):
    """Tighten finite paired-seed bounds without changing an assessed look or its clock."""
    attempts = {row["attempt_sha256"]: row for row in report["attempts"]}
    censor_followup = {} if censor_followup is None else censor_followup
    rows, grouped = [], {}
    for pair in report["pairs"]:
        clock, horizon = pair["clock"], pair["horizon"]
        baseline, candidate = (_confirmation_meter_window(attempts[pair[f"{role}_attempt_sha256"]], clock, horizon,
                pair[f"{role}_attained"], pair[f"observed_{role}_confirmation"], pair[f"{role}_reason"])
            for role in ("baseline", "candidate"))
        for role, window in (("baseline", baseline), ("candidate", candidate)):
            witness = censor_followup.get((pair[f"{role}_attempt_sha256"], clock))
            if witness is not None:
                lower, upper = window["restricted_confirmation_seconds"]
                window["restricted_confirmation_seconds"] = (max(lower, min(witness["through_seconds"], horizon)), upper)
                window["censor_followup"] = dict(witness)
        a_low, a_high = (Fraction.from_float(value) for value in baseline["restricted_confirmation_seconds"])
        b_low, b_high = (Fraction.from_float(value) for value in candidate["restricted_confirmation_seconds"])
        time_delta = (b_low - a_high, b_high - a_low)
        a, b = baseline["attainment"], candidate["attainment"]
        attained_delta = ((0 if b is None else b) - (1 if a is None else a),
                          (1 if b is None else b) - (0 if a is None else a))
        row = {"seed": pair["seed"], "contrast_id": pair["contrast_id"], "clock": clock, "horizon": horizon,
               "baseline_attempt_sha256": pair["baseline_attempt_sha256"],
               "candidate_attempt_sha256": pair["candidate_attempt_sha256"],
               "baseline": baseline, "candidate": candidate,
               "restricted_candidate_minus_baseline_seconds_bounds": _wire(time_delta),
               "candidate_minus_baseline_attainment_bounds": attained_delta}
        rows.append(row)
        grouped.setdefault((pair["contrast_id"], clock, horizon), []).append((time_delta, attained_delta))
    contrasts = []
    for (contrast, clock, horizon), evidence in grouped.items():
        timings, indicators = zip(*evidence, strict=True)
        count = len(evidence)
        time_mean = tuple(sum(values) / count for values in zip(*timings, strict=True))
        attainment_mean = tuple(Fraction(sum(values), count) for values in zip(*indicators, strict=True))
        contrasts.append({"contrast_id": contrast, "clock": clock, "horizon": horizon, "paired_seeds": count,
                          "restricted_mean_candidate_minus_baseline_seconds_bounds": _wire(time_mean),
                          "mean_candidate_minus_baseline_attainment_bounds": _wire(attainment_mean)})
    return {"schema": CONFIRMATION_COST_BOUNDS_SCHEMA, "pairs": tuple(rows), "contrasts": tuple(contrasts),
            "scope": "finite_registered_seed_pairs_and_scheduled_confirmation_clocks",
            "cost_basis": report["cost_basis"], "cost_evidence_sha256": report["cost_evidence_sha256"]}


CENSOR_FOLLOWUP_BOUNDS_SCHEMA = "reviewed-scheduled-confirmation-cost-bounds-with-censor-followup/v1"


@dataclass(frozen=True)
class CensorFollowup:
    attempt_sha256: str
    clock: str
    closing_meter_sha256: str
    closing_clock_receipt_sha256: str
    closeout_receipt_sha256: str
    no_confirmation_through_close_receipt_sha256: str


def verify_censored_confirmation_cost_bounds(report, *, expected_paid_report_sha256, followups,
        expected_followups_sha256, verify_original_followup_owner):
    """Tighten partial follow-up using same-attempt paid closure and independent absence evidence."""
    _require(type(report) is dict and report.get("schema") in (
        VERIFIED_CONTRAST_SCHEMA, VERIFIED_DEVELOPMENT_SCHEMA, VERIFIED_COMPACT_DEVELOPMENT_SCHEMA)
        and _pin(expected_paid_report_sha256) and commitment(report) == expected_paid_report_sha256
        and _pin(report.get("cost_evidence_sha256")) and type(followups) is tuple and bool(followups)
        and all(type(row) is CensorFollowup for row in followups)
        and _pin(expected_followups_sha256) and commitment(followups) == expected_followups_sha256
        and callable(verify_original_followup_owner), "exact paid report and original no-confirmation proof required")
    paid = deepcopy(report)
    selected = deepcopy(followups)
    attempts = {row["attempt_sha256"]: row for row in paid["attempts"]}
    _require(len(attempts) == len(paid["attempts"]), "paid attempt identities must be unique")
    meter_uses = Counter(
        meter["record_sha256"] for row in attempts.values()
        for meter in (row["cost_evidence"]["closing_meter"], *(look["meter"] for look in row["cost_evidence"]["looks"])))
    close_uses = Counter(row["closeout_receipt_sha256"] for row in attempts.values())
    compared = {(pair[f"{role}_attempt_sha256"], pair["clock"])
                for pair in paid["pairs"] for role in ("baseline", "candidate")}
    witnessed = {}
    for followup in selected:
        key = (followup.attempt_sha256, followup.clock)
        _require(all(_pin(pin) for pin in (followup.attempt_sha256, followup.closing_meter_sha256,
            followup.closing_clock_receipt_sha256, followup.closeout_receipt_sha256,
            followup.no_confirmation_through_close_receipt_sha256))
            and type(followup.clock) is str and followup.clock in COVERED_CLOCKS
            and key in compared and key not in witnessed,
            "exact unique right-censored attempt and compared clock required")
        row = attempts[followup.attempt_sha256]
        verdict = row["decision"]
        closing = row["cost_evidence"]["closing_meter"]
        stamp = closing["costs"].get(followup.clock)
        _require(verdict["status"] == "right_censored" and verdict["confirming_checkpoint"] is None
            and row["confirmation_budget_block"] is None
            and closing["stage"] == "close" and closing["attempt_sha256"] == followup.attempt_sha256
            and closing["record_sha256"] == row["closing_meter_sha256"] == followup.closing_meter_sha256
            and meter_uses[followup.closing_meter_sha256] == 1
            and row["closeout_receipt_sha256"] == followup.closeout_receipt_sha256
            and close_uses[followup.closeout_receipt_sha256] == 1
            and closing["clock_receipts"][COVERED_CLOCKS.index(followup.clock)] == followup.closing_clock_receipt_sha256
            and type(stamp) is float and isfinite(stamp) and stamp >= 0
            and stamp == verdict["closing_costs"][followup.clock],
            "paid right-censored follow-up requires its own observed closing clock and unaliased meter")
        witnessed[key] = {
            "through_seconds": stamp,
            "closing_meter_sha256": followup.closing_meter_sha256,
            "closing_clock_receipt_sha256": followup.closing_clock_receipt_sha256,
            "closeout_receipt_sha256": followup.closeout_receipt_sha256,
            "no_confirmation_through_close_receipt_sha256": followup.no_confirmation_through_close_receipt_sha256}
    _require(verify_original_followup_owner(expected_paid_report_sha256, paid["cost_evidence_sha256"],
                                            expected_followups_sha256) is True
        and commitment(report) == commitment(paid) == expected_paid_report_sha256
        and commitment(followups) == commitment(selected) == expected_followups_sha256,
        "original follow-up owner refused coverage or exact selected evidence changed")
    bounds = _verified_confirmation_cost_bounds(paid, censor_followup=witnessed)
    return {**bounds, "schema": CENSOR_FOLLOWUP_BOUNDS_SCHEMA, "paid_report_sha256": expected_paid_report_sha256,
            "followups_sha256": expected_followups_sha256}


def compare_verified_contrasts(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256,
                               contrast_plan, expected_contrast_plan_sha256, cost_evidence,
                               expected_cost_evidence_sha256, verify_cost_owner, retrospective_look_closes=None,
                               include_confirmation_cost_bounds=False):
    """Compare selected attempts with complete, owner-authenticated paid-work evidence.

    The independent verifier resolves the selected commitment and authenticates
    event identity, exclusive counters, complete stage coverage and the actual
    meter, clock and scope receipts. At retrospective looks it authenticates
    that the wall observations cover the completed training and evaluation.
    Arithmetic here checks that exact evidence.
    """
    return _compare_verified_contrasts(validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        retrospective_look_closes=retrospective_look_closes,
        include_confirmation_cost_bounds=include_confirmation_cost_bounds)


def _compare_verified_contrasts(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256,
                                contrast_plan, expected_contrast_plan_sha256, cost_evidence,
                                expected_cost_evidence_sha256, verify_cost_owner, retrospective_look_closes=None,
                                teacher_policy=None, activation_diagnostic_charges=None,
                                expected_activation_diagnostic_charges_sha256=None, exclusive_non_teacher_work=False,
                                expected_teacher_request_roster_sha256=None, require_original_terminal_event=False,
                                first_use_shared_work=None, expected_first_use_shared_work_sha256=None,
                                first_use_interrupted_preparation_events=(), include_confirmation_cost_bounds=False):
    _require(type(include_confirmation_cost_bounds) is bool, "explicit boolean confirmation bounds selection required")
    _require(callable(verify_cost_owner), "independent resource owner verification required")
    request_pin = expected_teacher_request_roster_sha256
    _require(request_pin is None or (_pin(request_pin) and teacher_policy is not None),
             "selected teacher requests require an exact digest and teacher cost roster")
    contrasts = _selected_contrasts(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    has_diagnostics = activation_diagnostic_charges is not None or expected_activation_diagnostic_charges_sha256 is not None
    _require(type(first_use_interrupted_preparation_events) is tuple,
             "interrupted teacher preparation selection must be an exact tuple")
    has_shared = (first_use_shared_work is not None or expected_first_use_shared_work_sha256 is not None
                  or bool(first_use_interrupted_preparation_events))

    def current_diagnostics():
        if has_diagnostics:
            _require(_pin(expected_activation_diagnostic_charges_sha256)
                     and activation_diagnostic_charges_commitment(activation_diagnostic_charges)
                         == expected_activation_diagnostic_charges_sha256,
                     "exact independently approved activation diagnostic charge roster required")

    def current_shared():
        if has_shared:
            _require(_pin(expected_first_use_shared_work_sha256)
                     and first_use_shared_work_commitment(first_use_shared_work,
                         interrupted_preparation_events=first_use_interrupted_preparation_events)
                         == expected_first_use_shared_work_sha256,
                     "independently selected first-use shared work commitment differs")

    current_diagnostics()
    current_shared()
    shared_work = dict(first_use_shared_work) if has_shared else None
    elapsed, physical_work = _cost_roster(validator, study, expected_study_sha256, attempts,
                                          expected_attempts_sha256, cost_evidence, expected_cost_evidence_sha256,
                                          retrospective_look_closes=retrospective_look_closes, teacher_policy=teacher_policy,
                                          activation_diagnostic_charges=activation_diagnostic_charges or (),
                                          exclusive_non_teacher_work=exclusive_non_teacher_work,
                                          require_original_terminal_event=require_original_terminal_event,
                                          first_use_shared_work=shared_work,
                                          first_use_interrupted_preparation_events=first_use_interrupted_preparation_events)
    events = tuple(_wire(event) for event in cost_evidence.events)
    selection = (expected_cost_evidence_sha256,)
    if teacher_policy is not None:
        # The owner resolves the producer receipt to physical events. Its
        # aggregate close need not equal any individual event's close.
        selection = (*selection, teacher_policy[0])
    if has_diagnostics:
        selection = (*selection, expected_activation_diagnostic_charges_sha256)
    if request_pin is not None:
        selection = (*selection, request_pin)
    if has_shared:
        current_shared()
        arms = {attempt.attempt_sha256: attempt.arm for attempt in attempts}
        directions = {(contrast["baseline"], contrast["candidate"]) for contrast in contrasts}
        _require(all((arms[left], arms[right]) in directions for left, right in shared_work.values()),
                 "first-use shared work must retain its selected left-to-right contrast direction")
        selection = (*selection, expected_first_use_shared_work_sha256)
    _require(verify_cost_owner(*selection) is True
             and commitment(cost_evidence) == expected_cost_evidence_sha256,
             "resource owner refused evidence or selected cost evidence changed during verification")
    current_diagnostics()
    current_shared()
    report = compare_contrasts(
        validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256,
        contrast_plan=contrast_plan, expected_contrast_plan_sha256=expected_contrast_plan_sha256)
    _require(commitment(cost_evidence) == expected_cost_evidence_sha256, "selected cost evidence changed during evaluation")
    current_diagnostics()
    current_shared()
    output = {**report, "schema": VERIFIED_CONTRAST_SCHEMA, "cost_evidence_sha256": expected_cost_evidence_sha256,
              "physical_paid_events": events, "physical_work_ns": physical_work, "observed_elapsed_wall": elapsed}
    if has_diagnostics:
        output.update(activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
                      activation_diagnostic_charges=tuple(_wire(row) for row in activation_diagnostic_charges))
    if request_pin is not None:
        output["teacher_request_roster_sha256"] = request_pin
    if has_shared:
        output.update(first_use_shared_work_sha256=expected_first_use_shared_work_sha256,
                      first_use_shared_work=dict(sorted(shared_work.items())))
    if first_use_interrupted_preparation_events:
        output["first_use_interrupted_preparation_events"] = first_use_interrupted_preparation_events
    if include_confirmation_cost_bounds:
        output["confirmation_cost_bounds"] = _verified_confirmation_cost_bounds(output)
    return output


T5_EXTERNAL_PROJECTOR_PAID_SCHEMA = "reviewed-t5-external-projector-paid-fixed-checkpoint-comparison/v1"
_T5_EXTERNAL_PROJECTOR_REPORT_SCHEMA = "reviewed-t5-external-projector-development-assessment/v1"
_T5_EXTERNAL_PROJECTOR_PAID_ROLES = ("baseline", "targeted", "seeded", "restored_baseline")
_T5_EXTERNAL_PROJECTOR_CONTRASTS = (("baseline", "targeted", "primary"),
    ("baseline", "seeded", "exploratory"), ("seeded", "targeted", "exploratory"))


def t5_external_projector_evaluation_receipt(study_sha256, assessment_sha256, role):
    """Identify one issued projector assessment arm as an existing meter subject."""
    return _external_projector_evaluation_receipt(T5_EXTERNAL_PROJECTOR_PAID_SCHEMA, study_sha256, assessment_sha256, role)


def _external_projector_evaluation_receipt(schema, study_sha256, assessment_sha256, role):
    _require(_pin(study_sha256) and _pin(assessment_sha256) and role in _T5_EXTERNAL_PROJECTOR_PAID_ROLES,
             "exact external projector assessment and study role required")
    return commitment((schema, "evaluated-arm", study_sha256, assessment_sha256, role))


def compare_verified_t5_external_projector(validator, *, study, expected_study_sha256,
        attempts, expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256,
        assessment_reports, expected_assessment_report_sha256s, verify_assessment_owner,
        evaluation_event_sha256s, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner):
    """Compare one assessed look per seed at a fixed checkpoint under original first-use meters.

    The assessment owner authenticates each issued report for the selected
    study, seed, and exact conditioning recipe roles, including the links from
    each logical generation close to the original physical evaluation close.
    The cost owner resolves
    the original whole-arm events and authenticates each interval, its clock
    domain and its complete coverage, including any unsuccessful work.
    """
    return _compare_verified_external_projector(validator, paid_schema=T5_EXTERNAL_PROJECTOR_PAID_SCHEMA,
        report_schema=_T5_EXTERNAL_PROJECTOR_REPORT_SCHEMA, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, assessment_reports=assessment_reports,
        expected_assessment_report_sha256s=expected_assessment_report_sha256s, verify_assessment_owner=verify_assessment_owner,
        evaluation_event_sha256s=evaluation_event_sha256s, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner)

def _compare_verified_external_projector(validator, *, paid_schema, report_schema, study, expected_study_sha256,
        attempts, expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256,
        assessment_reports, expected_assessment_report_sha256s, verify_assessment_owner,
        evaluation_event_sha256s, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner):
    _study(validator, study, expected_study_sha256)
    contrasts = _selected_contrasts(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    _require(tuple(role for role, _ in study.arms) == _T5_EXTERNAL_PROJECTOR_PAID_ROLES
             and study.cost_basis == "first_use" and len(study.schedule) == study.required_streak == 1
             and tuple((item["baseline"], item["candidate"], item["role"]) for item in contrasts)
                 == _T5_EXTERNAL_PROJECTOR_CONTRASTS,
             "fixed-checkpoint first-use study needs four arms and three preregistered scientific contrasts")
    _require(type(assessment_reports) is type(expected_assessment_report_sha256s) is tuple
             and len(assessment_reports) == len(expected_assessment_report_sha256s) == len(study.seeds)
             and callable(verify_assessment_owner) and callable(verify_cost_owner)
             and all(type(raw) is bytes and 0 < len(raw) <= 4 * 1024**2
                     and _pin(pin) and sha256(raw).hexdigest() == pin
                     for raw, pin in zip(assessment_reports, expected_assessment_report_sha256s, strict=True)),
             "exact independently selected external projector assessment reports required")
    _require(type(attempts) is tuple and len(attempts) == len(study.seeds) * len(study.arms)
             and _pin(expected_attempts_sha256) and commitment(attempts) == expected_attempts_sha256
             and all(type(attempt) is Attempt and type(attempt.assessments) is tuple
                     and len(attempt.assessments) == 1 and type(attempt.assessments[0]) is Assessment
                     and attempt.closeout_status in ("complete", "budget_limit", "integrity_failure")
                     for attempt in attempts),
             "every selected projector arm needs its actual assessed look and terminal close")

    _require(type(evaluation_event_sha256s) is tuple and len(evaluation_event_sha256s) == len(attempts)
             and all(_pin(event) for event in evaluation_event_sha256s)
             and len(set(evaluation_event_sha256s)) == len(attempts),
             "exact distinct physical evaluation event for every selected arm required")

    panel_pin = commitment(study.panel)
    panel_rows = tuple(row[0] for row in study.panel)
    by_arm = iter(attempts)
    selection, restoration_checks = [], []
    for seed, raw, raw_pin in zip(study.seeds, assessment_reports, expected_assessment_report_sha256s, strict=True):
        report = json.loads(raw)
        _require(type(report) is dict and commitment(report) == raw_pin
                 and report.get("schema") == report_schema
                 and (report.get("seed"), report.get("panel_sha256"), report.get("evaluation_policy_sha256"),
                      report.get("retention_reference_sha256")) == (seed.identifier, panel_pin,
                         study.evaluation_policy_sha256, seed.retention_reference_sha256)
                 and report.get("whole_arm_cost_required") is True and report.get("dispatch_authority") is False
                 and all(_pin(report.get(key)) for key in (
                     "model_checkpoint_sha256", "assessment_sha256", "returns_sha256", "binding_sha256")),
                 "projector assessment report changed its original fixed checkpoint, panel, policy or retention")
        arms, denominators = report.get("arms"), report.get("denominator_rows")
        _require(type(arms) is list and all(type(arm) is dict for arm in arms)
                 and tuple(arm.get("role") for arm in arms) == _T5_EXTERNAL_PROJECTOR_PAID_ROLES
                 and type(denominators) is dict and set(denominators) == set(validator.GATES),
                 "original external projector assessment must cover the exact role and gate rosters")
        for gate, size in zip(validator.GATES, seed.gate_denominators, strict=True):
            rows = denominators[gate]
            _require(type(rows) is list and all(type(row) is str for row in rows) and len(rows) == size
                     and tuple(rows) == tuple(row for row in panel_rows if row in rows)
                     and (gate not in ("coverage", "abstention") or tuple(rows) == panel_rows),
                     "projector assessment gate denominator differs from the exact frozen panel")
        _require(arms[0].get("development_batch_sha256") == arms[-1].get("development_batch_sha256"),
                 "restored projector assessment must select the original baseline conditioning batch")
        for arm, (role, recipe) in zip(arms, study.arms, strict=True):
            attempt = next(by_arm)
            look, = attempt.assessments
            receipt = _external_projector_evaluation_receipt(paid_schema, expected_study_sha256, raw_pin, role)
            close = arm.get("original_close_sha256")
            arm_rows = arm.get("rows")
            _require(type(arm_rows) is list and all(type(row) is dict for row in arm_rows)
                     and tuple(row.get("row_id") for row in arm_rows) == panel_rows and _pin(close)
                     and _pin(arm.get("development_batch_sha256")) and _pin(arm.get("return_sha256"))
                     and (attempt.seed, attempt.arm, attempt.recipe_sha256, attempt.study_sha256) ==
                        (seed.identifier, role, recipe, expected_study_sha256)
                     and (look.look, look.checkpoint_sha256, look.evaluation_receipt_sha256, look.panel_sha256,
                          look.evaluation_policy_sha256, look.retention_reference_sha256) ==
                         (study.schedule[0], report["model_checkpoint_sha256"], receipt, panel_pin,
                          study.evaluation_policy_sha256, seed.retention_reference_sha256)
                     and type(look.gates) is dict and set(look.gates) == set(validator.GATES)
                     and all(type(count) is validator.Counts for count in look.gates.values())
                     and type(arm.get("counts")) is dict and commitment(look.gates) == commitment(arm["counts"]),
                     "projector paid look changed its role, checkpoint, denominator roster or independent gate outcome")
            selection.append({"seed": seed.identifier, "role": role, "attempt_sha256": attempt.attempt_sha256,
                "assessment_report_sha256": raw_pin, "evaluation_receipt_sha256": receipt,
                "original_evaluation_close_sha256": close, "returned_payload_sha256": arm["return_sha256"]})
            if role == "restored_baseline":
                same_return = arms[0]["return_sha256"] == arm["return_sha256"]
                diagnostic = {}
                restored = same_return and attempt.closeout_status == "complete"
                if report_schema == _QWEN2_PROJECTOR_REPORT_SCHEMA:
                    slots = report.get("row_slot_comparison")
                    _require(type(slots) is list and all(type(row) is dict for row in slots)
                             and tuple(row.get("row_id") for row in slots) == panel_rows
                             and all(row.get("restored_bf16_matches_baseline") is None
                                     or type(row.get("restored_bf16_matches_baseline")) is bool for row in slots)
                             and all(type(row.get("restored_generation_matches_baseline")) is bool for row in slots),
                             "Qwen2 restoration diagnostics require the exact ordered observed slot roster")
                    for before, after, row in zip(arms[0]["rows"], arm_rows, slots, strict=True):
                        observed_pins = []
                        for sample in (before, after):
                            count = sample.get("observed_forward_count")
                            value = sample.get("observed_bf16_slot_sha256")
                            _require(type(count) is int and count >= 0 and (_pin(value) if count else value is None),
                                     "Qwen2 restoration needs an observed slot hash or an explicit zero-forward row")
                            observed_pins.append(value)
                        actual = None if None in observed_pins else observed_pins[0] == observed_pins[1]
                        _require(row["restored_bf16_matches_baseline"] is actual
                                 and row["restored_generation_matches_baseline"] is
                                     (before.get("generation_sha256") == after.get("generation_sha256")),
                                 "Qwen2 restoration diagnostics differ from the original slot or generated result")
                    observed = sum(row["restored_bf16_matches_baseline"] is not None for row in slots)
                    diagnostic = {"observed_restoration_rows": observed, "unobserved_restoration_rows": len(slots) - observed}
                    restored = restored and all(row["restored_bf16_matches_baseline"] is True
                                             and row["restored_generation_matches_baseline"] is True for row in slots)
                restoration_checks.append({"seed": seed.identifier, "original_return_reproduced": same_return,
                    "terminal_disposition": attempt.closeout_status, "restoration_confirmed": restored, **diagnostic})
    _require(len({row["original_evaluation_close_sha256"] for row in selection}) == len(selection),
             "each paid projector arm requires its own original assessment execution")

    def verify_paid(evidence_pin):
        events = {event.event_sha256: event for event in cost_evidence.events}
        by_close = {event.close_receipt_sha256: event for event in cost_evidence.events}
        observations = iter(cost_evidence.observations)
        execution_links = []
        for attempt, row, event_id in zip(attempts, selection, evaluation_event_sha256s, strict=True):
            evaluation = events.get(event_id)
            terminal = by_close.get(attempt.closeout_receipt_sha256)
            _, at_look = next(observations)
            _, at_close = next(observations)
            _require(evaluation is not None and (evaluation.kind, evaluation.disposition) == ("evaluation", "complete")
                     and dict(at_look.entries).get(evaluation.event_sha256) == 1
                     and terminal is not None and terminal.disposition == attempt.closeout_status
                     and (terminal.kind == "closeout" or terminal == evaluation)
                     and dict(at_close.entries).get(terminal.event_sha256) == 1,
                     "each projector arm must pay its own original evaluation and terminal closes")
            row["original_physical_evaluation_close_sha256"] = evaluation.close_receipt_sha256
            row["physical_evaluation_event_sha256"] = evaluation.event_sha256
            execution_links.append((row["role"], row["original_evaluation_close_sha256"],
                                    evaluation.event_sha256, evaluation.close_receipt_sha256))
        for index, (seed, raw, pin) in enumerate(zip(
                study.seeds, assessment_reports, expected_assessment_report_sha256s, strict=True)):
            start = index * len(study.arms)
            links = tuple(execution_links[start:start + len(study.arms)])
            _require(verify_assessment_owner(expected_study_sha256, seed.identifier, pin, raw, links) is True,
                     "original projector assessment owner refused the selected report and physical links")
        _require(commitment(attempts) == expected_attempts_sha256 and commitment(study) == expected_study_sha256
                 and commitment(cost_evidence) == expected_cost_evidence_sha256,
                 "projector paid selection changed during assessment verification")
        return verify_cost_owner(evidence_pin) is True

    comparison = compare_verified_contrasts(validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_paid)
    terminal_walls = tuple(row["wall"] for row in comparison["observed_elapsed_wall"] if row["stage"] == "close")
    wall = None
    if len(terminal_walls) == len(attempts) and all(span is not None for span in terminal_walls):
        domains = {span["clock_domain_sha256"] for span in terminal_walls}
        if len(domains) == 1:
            start, end = min(span["start_ns"] for span in terminal_walls), max(span["end_ns"] for span in terminal_walls)
            wall = {"clock_domain_sha256": next(iter(domains)), "start_ns": start, "end_ns": end,
                    "elapsed_ns": end - start, "scope": "earliest-observed-arm-start-to-latest-terminal-end/v1"}
    return {"schema": paid_schema, "selection": tuple(selection),
            "scientific_contrasts": comparison, "observed_arm_wall_envelope": wall,
            "restoration_checks": tuple(restoration_checks), "restored_baseline_charged_as_control": True,
            "restoration_confirmed_for_all_seeds": all(row["restoration_confirmed"] for row in restoration_checks),
            "fixed_checkpoint_only": True, "dispatch_authority": False}


T5_EXTERNAL_PROJECTOR_PHYSICAL_SNAPSHOT_SCHEMA = "reviewed-t5-external-projector-physical-snapshot/v1"


@dataclass(frozen=True)
class T5ProjectorEventScope:
    event_sha256: str
    arms: tuple[tuple[str, str], ...]  # Frozen seed and role order, including shared preparation scopes.


@dataclass(frozen=True)
class T5ProjectorArmWork:
    seed: str
    arm: str
    state: str  # unresolved, unstarted, closed
    terminal_event_sha256s: tuple[str, ...]
    no_dispatch_receipt_sha256: str | None = None


@dataclass(frozen=True)
class T5ProjectorPhysicalSnapshot:
    study_sha256: str
    predecessor_report_sha256: str | None
    event_scopes: tuple[T5ProjectorEventScope, ...]
    arms: tuple[T5ProjectorArmWork, ...]
    coverage_receipt_sha256: str | None = None
    enclosing_wall: WallSpan | None = None


def t5_external_projector_physical_snapshot_commitment(snapshot, events):
    return _external_projector_physical_snapshot_commitment(T5_EXTERNAL_PROJECTOR_PHYSICAL_SNAPSHOT_SCHEMA, snapshot, events)


def _external_projector_physical_snapshot_commitment(schema, snapshot, events):
    _require(type(snapshot) is T5ProjectorPhysicalSnapshot and type(events) is tuple,
             "exact external projector physical snapshot and event roster required")
    return commitment((schema, snapshot, events))


def readback_t5_external_projector_physical_work(validator, physical_owner, *, study, expected_study_sha256,
        snapshot, events, expected_snapshot_sha256, physical_roster_raw, expected_physical_roster_sha256,
        physical_scope, replay_close, verify_snapshot_owner, predecessor_raw=None, verify_predecessor_owner=None,
        teacher_roster=None, replay_teacher_aggregate=None, teacher_request_binding=None):
    """Read incurred work from original closes, independently of scientific assessment.

    The snapshot owner attests exact event-to-arm scope, role terminal history,
    any no-dispatch evidence and, when present, exhaustive original coverage
    and the measured enclosing wall receipt. A successor rechecks the entire
    physical union and retains its independently authenticated predecessor.
    """
    return _readback_external_projector_physical_work(validator, physical_owner,
        snapshot_schema=T5_EXTERNAL_PROJECTOR_PHYSICAL_SNAPSHOT_SCHEMA, study=study, expected_study_sha256=expected_study_sha256,
        snapshot=snapshot, events=events, expected_snapshot_sha256=expected_snapshot_sha256,
        physical_roster_raw=physical_roster_raw, expected_physical_roster_sha256=expected_physical_roster_sha256,
        physical_scope=physical_scope, replay_close=replay_close, verify_snapshot_owner=verify_snapshot_owner,
        predecessor_raw=predecessor_raw, verify_predecessor_owner=verify_predecessor_owner, teacher_roster=teacher_roster,
        replay_teacher_aggregate=replay_teacher_aggregate, teacher_request_binding=teacher_request_binding)

def _readback_external_projector_physical_work(validator, physical_owner, *, snapshot_schema, study, expected_study_sha256,
        snapshot, events, expected_snapshot_sha256, physical_roster_raw, expected_physical_roster_sha256,
        physical_scope, replay_close, verify_snapshot_owner, predecessor_raw=None, verify_predecessor_owner=None,
        teacher_roster=None, replay_teacher_aggregate=None, teacher_request_binding=None):
    from types import SimpleNamespace

    _study(validator, study, expected_study_sha256)
    _require(tuple(role for role, _ in study.arms) == _T5_EXTERNAL_PROJECTOR_PAID_ROLES
             and study.cost_basis == "first_use" and len(study.schedule) == study.required_streak == 1
             and callable(replay_close) and callable(verify_snapshot_owner)
             and _pin(expected_snapshot_sha256) and _pin(expected_physical_roster_sha256)
             and _external_projector_physical_snapshot_commitment(snapshot_schema, snapshot, events) == expected_snapshot_sha256
             and snapshot.study_sha256 == expected_study_sha256,
             "exact first-use external projector study, selected snapshot and physical owners required")
    by_event = _event_roster(events)
    slots = tuple((seed.identifier, role) for seed in study.seeds for role, _ in study.arms)
    _require(bool(by_event) and type(snapshot.event_scopes) is tuple
             and all(type(row) is T5ProjectorEventScope for row in snapshot.event_scopes)
             and tuple(row.event_sha256 for row in snapshot.event_scopes) == tuple(by_event)
             and type(snapshot.arms) is tuple and all(type(row) is T5ProjectorArmWork for row in snapshot.arms)
             and tuple((row.seed, row.arm) for row in snapshot.arms) == slots,
             "exact original event scopes and complete registered projector arm roster required")
    exclusive = {slot: [] for slot in slots}
    shared = {}
    for entry in snapshot.event_scopes:
        _require(type(entry.arms) is tuple and bool(entry.arms)
                 and all(type(slot) is tuple and len(slot) == 2 and all(_name(value) for value in slot)
                         for slot in entry.arms)
                 and tuple(slot for slot in slots if slot in entry.arms) == entry.arms,
                 "projector physical event scope must keep the exact registered arm order")
        if len(entry.arms) == 1:
            exclusive[entry.arms[0]].append(entry.event_sha256)
        else:
            shared[entry.event_sha256] = by_event[entry.event_sha256]

    arm_rows, no_dispatch_pins = [], []
    for row in snapshot.arms:
        key = row.seed, row.arm
        history = row.terminal_event_sha256s
        _require(type(row.state) is str and row.state in ("unresolved", "unstarted", "closed")
                 and type(history) is tuple and all(_pin(pin) and pin in exclusive[key] for pin in history)
                 and len(history) == len(set(history))
                 and (row.state != "closed" or bool(history))
                 and (not history and not exclusive[key] and _pin(row.no_dispatch_receipt_sha256)
                      if row.state == "unstarted" else row.no_dispatch_receipt_sha256 is None),
                 "projector terminal history or unstarted evidence differs from the scoped arm")
        if row.no_dispatch_receipt_sha256 is not None:
            no_dispatch_pins.append(row.no_dispatch_receipt_sha256)
        arm_rows.append({**asdict(row), "exclusive_event_sha256s": tuple(exclusive[key]),
                         "terminal_disposition": by_event[history[-1]].disposition if row.state == "closed" else None})
    _require(len(set(no_dispatch_pins)) == len(no_dispatch_pins) and not {
                 event.close_receipt_sha256 for event in events}.intersection(no_dispatch_pins),
             "unstarted evidence requires original non-physical dispatch receipts scoped to each arm")
    complete = snapshot.coverage_receipt_sha256 is not None
    _require(not complete or (_pin(snapshot.coverage_receipt_sha256)
             and all(row.state != "unresolved" for row in snapshot.arms)),
             "exhaustive projector coverage requires original closed or unstarted evidence for every role")
    wall = snapshot.enclosing_wall
    _require(wall is None or (complete and type(wall) is WallSpan
             and _pin(wall.clock_domain_sha256) and _pin(wall.receipt_sha256)
             and type(wall.start_ns) is type(wall.end_ns) is int and 0 <= wall.start_ns < wall.end_ns),
             "experiment elapsed wall requires exhaustive scope and an original enclosing clock receipt")

    predecessor_pin = snapshot.predecessor_report_sha256
    predecessor = None
    if predecessor_pin is not None:
        _require(_pin(predecessor_pin) and callable(verify_predecessor_owner)
                 and type(predecessor_raw) is bytes and 0 < len(predecessor_raw) <= 8 * 1024**2
                 and sha256(predecessor_raw).hexdigest() == predecessor_pin,
                 "projector snapshot extension requires the exact original predecessor report")
        predecessor = json.loads(predecessor_raw)
        _require(type(predecessor) is dict and commitment(predecessor) == predecessor_pin
                 and predecessor.get("schema") == snapshot_schema
                 and predecessor.get("study_sha256") == expected_study_sha256
                 and verify_predecessor_owner(predecessor_pin, predecessor_raw) is True,
                 "independent predecessor owner refused the exact prior projector snapshot")
    else:
        _require(predecessor_raw is None and verify_predecessor_owner is None,
                 "unselected prior projector snapshot evidence")

    closes = {}

    def original_close(row):
        key = row["event_sha256"]
        close = replay_close(row)
        closes[key] = close
        return close

    event_contract = SimpleNamespace(_pin=_pin, _name=_name, _event_roster=_event_roster,
        _physical_work_ns=_physical_work_ns, commitment=commitment, TeacherCostRoster=TeacherCostRoster,
        teacher_cost_roster_commitment=teacher_cost_roster_commitment)
    physical_proof = physical_owner.verify_event_roster(event_contract, events, physical_roster_raw,
        expected_roster_sha256=expected_physical_roster_sha256, expected_selection_sha256=expected_snapshot_sha256,
        expected_scope=physical_scope, replay_close=original_close, teacher_roster=teacher_roster,
        replay_teacher_aggregate=replay_teacher_aggregate, teacher_request_binding=teacher_request_binding)
    _require(tuple(closes) == tuple(by_event) and type(physical_proof) is dict
             and (physical_proof.get("scope"), physical_proof.get("selection_sha256"),
                  physical_proof.get("physical_close_roster_sha256"), physical_proof.get("event_count"),
                  physical_proof.get("exclusive_paid_work")) ==
                 (physical_scope, expected_snapshot_sha256, expected_physical_roster_sha256, len(by_event),
                  _physical_work_ns(by_event)), "projector physical replay must cover every selected original close")
    observed = {scope.event_sha256: {"paid_event": _wire(by_event[scope.event_sha256]), "scoped_arms": scope.arms,
                                     "original_close": _wire(closes[scope.event_sha256])}
                for scope in snapshot.event_scopes}
    if predecessor is not None:
        prior_events, prior_arms = predecessor.get("events"), predecessor.get("arms")
        _require(type(prior_events) is list and bool(prior_events)
                 and all(type(row) is dict and type(row.get("paid_event")) is dict
                         and _pin(row["paid_event"].get("event_sha256"))
                         and row["paid_event"]["event_sha256"] in observed
                         and commitment(row) == commitment(observed[row["paid_event"]["event_sha256"]])
                         for row in prior_events),
                 "projector successor removed or changed original paid work or scope")
        _require(type(prior_arms) is list and len(prior_arms) == len(arm_rows)
                 and all(type(prior) is dict and (prior.get("seed"), prior.get("arm")) == (now["seed"], now["arm"])
                         and type(prior.get("terminal_event_sha256s")) is list
                         and tuple(prior["terminal_event_sha256s"]) ==
                             now["terminal_event_sha256s"][:len(prior["terminal_event_sha256s"])]
                         for prior, now in zip(prior_arms, arm_rows, strict=True)),
                 "projector successor removed or reordered original terminal history")
    for arm in snapshot.arms:
        terminal_endpoints = {}
        for event_sha256 in arm.terminal_event_sha256s:
            close = closes[event_sha256]
            previous_end = terminal_endpoints.get(close.clock_domain_sha256)
            _require(previous_end is None or previous_end <= close.start_ns,
                     "projector terminal history conflicts with original same-clock close order")
            terminal_endpoints[close.clock_domain_sha256] = close.end_ns
    if wall is not None:
        _require(all(close.clock_domain_sha256 == wall.clock_domain_sha256 and
                     wall.start_ns <= close.start_ns < close.end_ns <= wall.end_ns for close in closes.values()),
                 "original experiment wall must enclose every charged close in one clock domain")
    _require(verify_snapshot_owner(expected_snapshot_sha256, expected_physical_roster_sha256, predecessor_pin) is True
             and commitment(study) == expected_study_sha256
             and _external_projector_physical_snapshot_commitment(snapshot_schema, snapshot, events) == expected_snapshot_sha256,
             "independent projector snapshot owner refused or selected evidence changed")
    return {"schema": snapshot_schema, "study_sha256": expected_study_sha256,
            "snapshot_sha256": expected_snapshot_sha256, "predecessor_report_sha256": predecessor_pin,
            "physical_proof": physical_proof, "events": tuple(observed.values()), "arms": tuple(arm_rows),
            "shared_scope_paid_work_ns": _physical_work_ns(shared), "observed_paid_work_ns": _physical_work_ns(by_event),
            "coverage_receipt_sha256": snapshot.coverage_receipt_sha256,
            "exhaustive_incurred_work_verified": complete,
            "enclosing_wall": None if wall is None else {**asdict(wall), "elapsed_ns": wall.end_ns - wall.start_ns},
            "scientific_assessment_authority": False, "dispatch_authority": False}


T5_EXTERNAL_PROJECTOR_EXPERIMENT_SCHEMA = "reviewed-t5-external-projector-experiment-accounting/v1"


def _selected_projector_report(raw, expected_sha256, schema):
    _require(type(raw) is bytes and 0 < len(raw) <= 8 * 1024**2 and _pin(expected_sha256)
             and sha256(raw).hexdigest() == expected_sha256,
             "exact original projector report required")
    report = json.loads(raw)
    _require(type(report) is dict and report.get("schema") == schema and commitment(report) == expected_sha256,
             "canonical original projector report schema or bytes differ")
    return report


def reconcile_t5_external_projector_experiment(validator, *, study, expected_study_sha256,
        attempts, cost_evidence, comparison_raw, expected_comparison_sha256, verify_comparison_owner,
        snapshot_raw, expected_snapshot_report_sha256, verify_snapshot_owner):
    """Join the original scientific comparison to complete incurred experiment work.

    Each independent owner authenticates its issued report. Terminal charge
    manifests must exhaust each arm's exclusive work. Shared preparation stays
    at experiment scope and is counted once. Existing scientific observations,
    denominators and scoped meters are retained by their original report.
    """
    return _reconcile_external_projector_experiment(validator, paid_schema=T5_EXTERNAL_PROJECTOR_PAID_SCHEMA,
        snapshot_schema=T5_EXTERNAL_PROJECTOR_PHYSICAL_SNAPSHOT_SCHEMA, experiment_schema=T5_EXTERNAL_PROJECTOR_EXPERIMENT_SCHEMA,
        study=study, expected_study_sha256=expected_study_sha256, attempts=attempts, cost_evidence=cost_evidence,
        comparison_raw=comparison_raw, expected_comparison_sha256=expected_comparison_sha256,
        verify_comparison_owner=verify_comparison_owner, snapshot_raw=snapshot_raw,
        expected_snapshot_report_sha256=expected_snapshot_report_sha256, verify_snapshot_owner=verify_snapshot_owner)

def _reconcile_external_projector_experiment(validator, *, paid_schema, snapshot_schema, experiment_schema, study, expected_study_sha256,
        attempts, cost_evidence, comparison_raw, expected_comparison_sha256, verify_comparison_owner,
        snapshot_raw, expected_snapshot_report_sha256, verify_snapshot_owner):
    _study(validator, study, expected_study_sha256)
    _require(callable(verify_comparison_owner) and callable(verify_snapshot_owner)
             and tuple(role for role, _ in study.arms) == _T5_EXTERNAL_PROJECTOR_PAID_ROLES
             and study.cost_basis == "first_use" and len(study.schedule) == study.required_streak == 1,
             "exact fixed-checkpoint projector study and both original report owners required")
    comparison = _selected_projector_report(comparison_raw, expected_comparison_sha256, paid_schema)
    snapshot = _selected_projector_report(snapshot_raw, expected_snapshot_report_sha256,
                                          snapshot_schema)
    scientific = comparison.get("scientific_contrasts")
    _require(type(scientific) is dict and scientific.get("schema") == VERIFIED_CONTRAST_SCHEMA
             and scientific.get("study_sha256") == snapshot.get("study_sha256") == expected_study_sha256
             and scientific.get("cost_basis") == study.cost_basis
             and comparison.get("fixed_checkpoint_only") is True and comparison.get("dispatch_authority") is False
             and snapshot.get("exhaustive_incurred_work_verified") is True
             and _pin(snapshot.get("coverage_receipt_sha256")) and _pin(snapshot.get("snapshot_sha256"))
             and snapshot.get("scientific_assessment_authority") is False and snapshot.get("dispatch_authority") is False,
             "same study and exhaustively verified incurred projector work required")

    attempts_pin, evidence_pin = scientific.get("attempts_sha256"), scientific.get("cost_evidence_sha256")
    elapsed, scoped_work = _cost_roster(validator, study, expected_study_sha256, attempts, attempts_pin,
                                       cost_evidence, evidence_pin)
    _require(commitment(scientific.get("physical_paid_events")) == commitment(cost_evidence.events)
             and scientific.get("physical_work_ns") == scoped_work
             and commitment(scientific.get("observed_elapsed_wall")) == commitment(elapsed),
             "scientific projector report differs from its original typed events or meter evidence")

    slots = tuple((seed.identifier, role) for seed in study.seeds for role, _ in study.arms)
    arm_rows, selected, decisions = snapshot.get("arms"), comparison.get("selection"), scientific.get("attempts")
    _require(all(type(rows) is list and len(rows) == len(slots) and all(type(row) is dict for row in rows)
                 for rows in (arm_rows, selected, decisions))
             and tuple((row.get("seed"), row.get("arm")) for row in arm_rows) == slots
             and tuple((row.get("seed"), row.get("role")) for row in selected) == slots
             and tuple((row.get("seed"), row.get("arm")) for row in decisions) == slots
             and all(len(attempt.assessments) == 1 for attempt in attempts),
             "both projector reports must retain each registered arm and its original assessed look")

    all_rows = snapshot.get("events")
    event_fields = {"event_sha256", "close_receipt_sha256", "kind", "disposition", "cpu_ns", "gpu_ns"}
    _require(type(all_rows) is list and bool(all_rows) and all(
             type(row) is dict and set(row) == {"paid_event", "scoped_arms", "original_close"}
             and type(row["paid_event"]) is dict and set(row["paid_event"]) == event_fields
             and type(row["original_close"]) is dict and type(row["scoped_arms"]) is list and bool(row["scoped_arms"])
             and all(type(slot) is list and len(slot) == 2 and all(_name(x) for x in slot)
                     for slot in row["scoped_arms"])
             for row in all_rows), "exact projector physical event records and scopes required")
    all_events = _event_roster(tuple(PaidEvent(**row["paid_event"]) for row in all_rows))
    scoped_events = _event_roster(cost_evidence.events)
    exclusive = {slot: [] for slot in slots}
    shared, close_ids = {}, set()
    for (key, event), row in zip(all_events.items(), all_rows, strict=True):
        close = row["original_close"]
        scopes = tuple(tuple(slot) for slot in row["scoped_arms"])
        _require(tuple(slot for slot in slots if slot in scopes) == scopes
                 and event.close_receipt_sha256 not in close_ids
                 and (close.get("close_sha256"), close.get("kind"), close.get("disposition"),
                      close.get("cpu_ns"), close.get("gpu_ns")) ==
                     (event.close_receipt_sha256, event.kind, event.disposition, event.cpu_ns, event.gpu_ns),
                 "projector physical event changed its original close or registered scopes")
        close_ids.add(event.close_receipt_sha256)
        if len(scopes) == 1:
            exclusive[scopes[0]].append(key)
        else:
            _require(paid_schema != QWEN2_EXTERNAL_PROJECTOR_PAID_SCHEMA or event.kind not in ("evaluation", "closeout"),
                     "Qwen2 evaluation or closeout work cannot be hidden in shared preparation")
            shared[key] = event
    _require(set(all_events) == set(scoped_events) | set(shared) and not set(scoped_events).intersection(shared)
             and all(all_events[key] == event for key, event in scoped_events.items()),
             "projector physical union differs from the original exclusive meters plus separate shared work")

    terminal_charges = {row.attempt_sha256: row for _, row in cost_evidence.observations if row.stage == "close"}
    for attempt, filters, arm, link, decision in zip(attempts, slots, arm_rows, selected, decisions, strict=True):
        charge = terminal_charges[attempt.attempt_sha256]
        expected_events = tuple(exclusive[filters])
        _require(charge.entries == tuple((key, Fraction(1)) for key in expected_events)
                 and arm.get("exclusive_event_sha256s") == list(expected_events),
                 "each projector meter must retain every original exclusive event in its own arm")
        history = arm.get("terminal_event_sha256s")
        _require(arm.get("state") == "closed" and arm.get("no_dispatch_receipt_sha256") is None
                 and type(history) is list and bool(history) and all(_pin(pin) and pin in expected_events for pin in history)
                 and len(history) == len(set(history))
                 and all_events[history[-1]].close_receipt_sha256 == attempt.closeout_receipt_sha256 ==
                     decision.get("closeout_receipt_sha256")
                 and arm.get("terminal_disposition") == all_events[history[-1]].disposition == attempt.closeout_status,
                 "projector snapshot and comparison must name the same latest original terminal close")
        evaluation_id = link.get("physical_evaluation_event_sha256")
        _require((link.get("attempt_sha256"), link.get("evaluation_receipt_sha256")) ==
                     (attempt.attempt_sha256, attempt.assessments[0].evaluation_receipt_sha256)
                 and decision.get("attempt_sha256") == attempt.attempt_sha256
                 and _pin(evaluation_id) and evaluation_id in expected_events
                 and all_events[evaluation_id].close_receipt_sha256 == link.get("original_physical_evaluation_close_sha256")
                 and (all_events[evaluation_id].kind, all_events[evaluation_id].disposition) == ("evaluation", "complete"),
                 "projector assessment must retain its original exclusively metered evaluation close")

    total, shared_work = _physical_work_ns(all_events), _physical_work_ns(shared)
    proof = snapshot.get("physical_proof")
    _require(type(proof) is dict and proof.get("event_count") == len(all_events)
             and proof.get("selection_sha256") == snapshot["snapshot_sha256"]
             and proof.get("exclusive_paid_work") == snapshot.get("observed_paid_work_ns") == total
             and snapshot.get("shared_scope_paid_work_ns") == shared_work,
             "projector total or shared resource counters differ from their original physical union")
    route = {}
    if paid_schema == QWEN2_EXTERNAL_PROJECTOR_PAID_SCHEMA:
        evidence_kind = comparison.get("original_projector_evidence_kind")
        _require(type(evidence_kind) is str and evidence_kind in _QWEN2_PROJECTOR_PHYSICAL_SCOPES
                 and proof.get("scope") == _QWEN2_PROJECTOR_PHYSICAL_SCOPES[evidence_kind],
                 "Qwen2 comparison evidence class differs from its original experiment physical scope")
        route["original_projector_evidence_kind"] = evidence_kind
        if "request_selection_sha256s" in comparison:
            request_pins = comparison["request_selection_sha256s"]
            _require(type(request_pins) is list and len(request_pins) == len(study.seeds)
                     and all(_pin(pin) for pin in request_pins),
                     "Qwen2 experiment requires the exact selected request commitment for each seed")
            route["request_selection_sha256s"] = tuple(request_pins)
        if "original_prelaunch_bound_releases" in comparison:
            _require("request_selection_sha256s" in route and comparison["original_prelaunch_bound_releases"] is True,
                     "prelaunch-bound Qwen2 experiment requires the selected requests and release evidence")
            route["original_prelaunch_bound_releases"] = True
    wall = snapshot.get("enclosing_wall")
    if wall is not None:
        _require(type(wall) is dict and set(wall) == {"clock_domain_sha256", "start_ns", "end_ns", "receipt_sha256", "elapsed_ns"}
                 and _pin(wall["clock_domain_sha256"]) and _pin(wall["receipt_sha256"])
                 and all(type(wall[key]) is int for key in ("start_ns", "end_ns", "elapsed_ns"))
                 and 0 <= wall["start_ns"] < wall["end_ns"]
                 and wall["elapsed_ns"] == wall["end_ns"] - wall["start_ns"],
                 "original enclosing projector wall receipt must have measured exact endpoints")
        spans = tuple(row["original_close"] for row in all_rows) + tuple(
            row["wall"] for row in elapsed if row["wall"] is not None)
        _require(all(span.get("clock_domain_sha256") == wall["clock_domain_sha256"]
                     and type(span.get("start_ns")) is type(span.get("end_ns")) is int
                     and wall["start_ns"] <= span["start_ns"] <= span["end_ns"] <= wall["end_ns"] for span in spans),
                 "enclosing experiment wall must include all original event and arm-meter spans on one clock")

    _require(verify_comparison_owner(expected_comparison_sha256, comparison_raw, evidence_pin) is True,
             "original projector comparison owner refused the selected report")
    _require(verify_snapshot_owner(expected_snapshot_report_sha256, snapshot_raw, snapshot["snapshot_sha256"]) is True,
             "original projector physical snapshot owner refused the selected report")
    _require(commitment(study) == expected_study_sha256 and commitment(attempts) == attempts_pin
             and commitment(cost_evidence) == evidence_pin,
             "projector study, attempts or metering changed during owner verification")
    return {"schema": experiment_schema, **route, "study_sha256": expected_study_sha256,
            "original_comparison_sha256": expected_comparison_sha256,
            "original_snapshot_report_sha256": expected_snapshot_report_sha256,
            "prior_snapshot_report_sha256": snapshot.get("predecessor_report_sha256"),
            "cost_evidence_sha256": evidence_pin, "unique_physical_event_count": len(all_events),
            "exclusive_attempt_work_ns": scoped_work, "shared_experiment_work_ns": shared_work,
            "shared_event_sha256s": tuple(shared), "experiment_work_ns": total,
            "experiment_enclosing_wall": wall,
            "per_arm_first_use_scope": "exclusive_with_unallocated_shared_work" if shared else "exhaustive_exclusive_work",
            "restoration_confirmed_for_all_seeds": comparison["restoration_confirmed_for_all_seeds"],
            "fixed_checkpoint_only": True, "dispatch_authority": False}


DEVELOPMENT_DESIGN_SCHEMA = "reviewed-threshold-development-study/v1"
DEVELOPMENT_RECEIPTS_SCHEMA = "reviewed-threshold-development-look-evidence/v1"
NATIVE_DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-native-development-threshold-look/v1"
SCHEDULED_NATIVE_DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-step-bound-native-development-threshold-look/v1"
RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA = "reviewed-relational-retrospective-native-development-threshold-look/v1"
DEVELOPMENT_STEP_GRID_SCHEMA = "reviewed-development-optimizer-step-grid/v1"
VERIFIED_DEVELOPMENT_SCHEMA = "paired-cost-to-confirmed-development-threshold-verified/v1"
MATCHED_CAPTURE_ROSTER_SCHEMA = "reviewed-matched-capture-roster/v1"
TEACHER_COST_ROSTER_SCHEMA = "reviewed-matched-teacher-cost-roster/v1"
SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA = "reviewed-relational-shuffle-development/v1"
SHUFFLED_DEVELOPMENT_ARMS = ("matched-relational", "shuffled-relational")


@dataclass(frozen=True)
class DevelopmentDesign:
    study_sha256: str
    global_split_sha256: str
    population_sha256: str
    case_aliases_sha256: str
    reserved_final_count: int
    seed_cohorts: tuple[tuple[str, int, str], ...]


@dataclass(frozen=True)
class DevelopmentReceipt:
    report: dict
    owner_close_sha256: str


@dataclass(frozen=True)
class DevelopmentStepGrid:
    study_sha256: str
    development_design_sha256: str
    steps: tuple[tuple[str, int], ...]


@dataclass(frozen=True)
class MatchedCaptureRoster:
    matrix_sha256: str
    study_sha256: str
    development_design_sha256: str
    step_grid_sha256: str
    packets: tuple[tuple[str, str, str], ...]


def matched_capture_roster_commitment(roster):
    _require(type(roster) is MatchedCaptureRoster and all(_pin(value) for value in (
                 roster.matrix_sha256, roster.study_sha256, roster.development_design_sha256, roster.step_grid_sha256))
             and type(roster.packets) is tuple and bool(roster.packets)
             and all(type(row) is tuple and len(row) == 3 and all(_pin(value) for value in row)
                      for row in roster.packets)
             and tuple(row[0] for row in roster.packets) == tuple(sorted({row[0] for row in roster.packets})),
             "exact ordered and unique approved packet capture roster required")
    return commitment((MATCHED_CAPTURE_ROSTER_SCHEMA, roster))


@dataclass(frozen=True)
class TeacherCostRoster:
    capture_roster_sha256: str
    packets: tuple[tuple[str, str, tuple[str, ...]], ...]


def teacher_cost_roster_commitment(roster):
    _require(type(roster) is TeacherCostRoster and _pin(roster.capture_roster_sha256)
             and type(roster.packets) is tuple and bool(roster.packets)
             and all(type(row) is tuple and len(row) == 3 and _pin(row[0]) and _pin(row[1])
                     and type(row[2]) is tuple and bool(row[2]) and all(_pin(event) for event in row[2])
                     and row[2] == tuple(sorted(set(row[2]))) for row in roster.packets)
             and tuple(row[0] for row in roster.packets) == tuple(sorted({row[0] for row in roster.packets})),
             "exact ordered and unique teacher producer packets and physical event identities required")
    return commitment((TEACHER_COST_ROSTER_SCHEMA, roster))


def development_step_grid_commitment(grid):
    _require(type(grid) is DevelopmentStepGrid and _pin(grid.study_sha256) and _pin(grid.development_design_sha256)
             and type(grid.steps) is tuple and bool(grid.steps)
             and all(type(row) is tuple and len(row) == 2 and _name(row[0]) and row[0] not in ("close", "final")
                     and type(row[1]) is int and row[1] > 0 for row in grid.steps)
             and len({look for look, _ in grid.steps}) == len(grid.steps)
             and all(first[1] < next_step[1] for first, next_step in zip(grid.steps, grid.steps[1:])),
             "ordered unique development labels and strictly increasing positive optimizer steps required")
    return commitment((DEVELOPMENT_STEP_GRID_SCHEMA, grid))


def _selected_development_grid(study, study_sha, design_sha, grid, expected_grid_sha):
    if grid is None and expected_grid_sha is None:
        return
    _require(_pin(expected_grid_sha) and development_step_grid_commitment(grid) == expected_grid_sha
             and (grid.study_sha256, grid.development_design_sha256) == (study_sha, design_sha)
             and tuple(look for look, _ in grid.steps) == study.schedule,
             "optimizer-step grid must bind the original study, development design and exact schedule order")


def development_design_commitment(design):
    _require(type(design) is DevelopmentDesign
             and all(_pin(value) for value in (design.study_sha256, design.global_split_sha256,
                                               design.population_sha256, design.case_aliases_sha256))
             and type(design.reserved_final_count) is int and design.reserved_final_count > 0
             and type(design.seed_cohorts) is tuple and bool(design.seed_cohorts)
             and all(type(entry) is tuple and len(entry) == 3 and _name(entry[0])
                     and type(entry[1]) is int and _pin(entry[2]) for entry in design.seed_cohorts)
             and len({label for label, _, _ in design.seed_cohorts})
                 == len({native_seed for _, native_seed, _ in design.seed_cohorts}) == len(design.seed_cohorts),
             "exact preregistered development split, final reservation and seed cohorts required")
    return commitment((DEVELOPMENT_DESIGN_SCHEMA, design))


def development_receipts_commitment(receipts, *, design_sha256, attempts_sha256):
    _require(_pin(design_sha256) and _pin(attempts_sha256) and type(receipts) is tuple
             and all(type(entry) is DevelopmentReceipt and type(entry.report) is dict
                     and _pin(entry.owner_close_sha256) for entry in receipts),
             "exact ordered native development receipts and owner closes required")
    return commitment((DEVELOPMENT_RECEIPTS_SCHEMA, design_sha256, attempts_sha256, receipts))


def _scheduled_checkpoint_metadata(record):
    if "scheduled_checkpoint" not in record:
        return None
    selected = record["scheduled_checkpoint"]
    _require(type(selected) is dict
             and set(selected) == {"schedule_sha256", "checkpoint_close_sha256", "owner_stage_record_sha256"}
             and all(_pin(value) for value in selected.values()),
             "exact scheduled checkpoint, readback close and stage record required")
    return selected


def _archived_capture_metadata(record):
    if "archived_capture" not in record:
        return None
    archived = record["archived_capture"]
    _require(type(archived) is dict
             and set(archived) == {"archived_arm_sha256", "capture_plan_sha256", "resource_plan_sha256"}
             and all(_pin(value) for value in archived.values()),
             "exact archived arm, checkpoint capture plan and resource plan required")
    return archived


def _capture_approval_metadata(record):
    fields = ("capture_matrix_sha256", "capture_roster_sha256")
    strict_teacher_requests = "teacher_request_roster_sha256" in record
    if "teacher_cost_roster_sha256" in record or strict_teacher_requests:
        fields = (*fields, "teacher_cost_roster_sha256")
    if strict_teacher_requests:
        fields = (*fields, "teacher_request_roster_sha256")
    if not any(key in record for key in fields):
        return {}
    _require(all(_pin(record.get(key)) for key in fields), "exact matched capture matrix and roster approvals required")
    return {key: record[key] for key in fields}


def _activation_charge_metadata(record):
    key = "activation_diagnostic_charges_sha256"
    if key not in record:
        return {}
    _require(_pin(record[key]), "exact activation diagnostic charge commitment required")
    return {key: record[key]}


def _teacher_evidence(record, profile_sha256):
    if "teacher_evidence" not in record:
        return None
    evidence = record["teacher_evidence"]
    _require(type(evidence) is dict and set(evidence) == {"profile_sha256", "teacher_sha256", "owner_close_sha256"}
             and all(_pin(value) for value in evidence.values())
             and evidence["profile_sha256"] == profile_sha256,
             "teacher evidence must retain its exact selected profile, artifact and owner close")
    return evidence


def selected_teacher_pilot_packets(preparation):
    """Read the original producer evidence for each ordered pilot profile."""
    _require(type(preparation) is dict and preparation.get("schema") == TEACHER_PILOT_PREPARATION_SCHEMA
             and preparation.get("dispatch_authority") is False,
             "exact teacher pilot preparation required for producer evidence")
    rows = preparation.get("teachers")
    _require(type(rows) in (tuple, list) and len(rows) == len(MATRIX_TEACHERS)
             and all(type(row) is dict and _pin(row.get("packet_sha256"))
                     and type(row.get("width")) is int and type(row.get("teacher")) is str for row in rows)
             and tuple((row["teacher"], row["width"]) for row in rows) == MATRIX_TEACHERS,
             "teacher pilot producer evidence requires the exact ordered teacher profiles")
    packets, profiles = {}, set()
    for row in rows:
        evidence = row.get("teacher_evidence")
        _require(type(evidence) is dict and _pin(evidence.get("profile_sha256"))
                 and row["packet_sha256"] not in packets and evidence["profile_sha256"] not in profiles,
                 "pilot requires original distinct packet and producer profile evidence")
        packets[row["packet_sha256"]] = _teacher_evidence(row, evidence["profile_sha256"])
        profiles.add(evidence["profile_sha256"])
    return packets


def _matrix_teacher_packets(attempts, teachers):
    if not any("teacher_evidence" in row for row in attempts):
        return {}
    _require(type(teachers) in (tuple, list) and all(
                 type(row) in (tuple, list) and len(row) == 3 and _pin(row[2]) for row in teachers)
             and tuple(tuple(row[:2]) for row in teachers) == MATRIX_TEACHERS
             and len({row[2] for row in teachers}) == len(teachers),
             "teacher producer evidence requires the exact matrix profile roster")
    profiles = {name: profile for name, _, profile in teachers}
    packets = {}
    for row in attempts:
        evidence = _teacher_evidence(row, profiles.get(row.get("teacher")))
        _require(evidence is not None and _pin(row.get("packet_sha256"))
                 and packets.setdefault(row["packet_sha256"], evidence) == evidence,
                 "all matched matrix arms must retain the same producer evidence for their packet")
    return packets


def _shuffled_development_contrast(study, study_sha256, plan, expected_plan_sha256):
    directions = _selected_contrasts(study, study_sha256, plan, expected_plan_sha256)
    _require(tuple(name for name, _ in study.arms) == SHUFFLED_DEVELOPMENT_ARMS
             and study.cost_basis == "amortized" and study.reuse_count == 2
             and study.horizons[0] is None and not study.stop_after_confirmation
             and len(directions) == 1
             and (directions[0]["baseline"], directions[0]["candidate"], directions[0]["role"])
                 == (*SHUFFLED_DEVELOPMENT_ARMS, "primary"),
             "one fixed matched-to-shuffled primary contrast and two-consumer additive work required")


def selected_shuffled_teacher_packets(preparation):
    """Project the exact original shared teacher evidence in each approved pair."""
    _require(type(preparation) is dict and set(preparation) == {
                "schema", "study_sha256", "development_design_sha256", "step_grid_sha256",
                "contrast_plan_sha256", "seed_cohorts", "attempts"}
             and preparation["schema"] == SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA
             and all(_pin(preparation[key]) for key in ("study_sha256", "development_design_sha256",
                                                       "step_grid_sha256", "contrast_plan_sha256"))
             and type(preparation["attempts"]) in (tuple, list)
             and bool(preparation["attempts"]) and len(preparation["attempts"]) % 2 == 0,
             "closed paired shuffle preparation required")
    packets = {}
    rows = preparation["attempts"]
    for left, right in zip(rows[::2], rows[1::2], strict=True):
        _require(all(type(row) is dict and set(row) == {
                    "seed", "arm", "native_arm", "native_seed", "recipe_sha256", "attempt_sha256",
                    "packet_sha256", "trial_sha256", "job_sha256", "configuration_sha256",
                    "prepared_inputs_sha256", "route", "paired_contrast_sha256", "teacher_evidence"}
                  and _name(row["seed"]) and row["native_arm"] == "relational"
                  and type(row["native_seed"]) is int
                  and row["route"] in ("qwen2-digest-omitted-source-only/v1", "t5-full-target-source-only/v1")
                  and all(_pin(value) for key, value in row.items() if key.endswith("_sha256"))
                  and type(row["teacher_evidence"]) is dict
                  and set(row["teacher_evidence"]) == {"profile_sha256", "teacher_sha256", "owner_close_sha256"}
                  and all(_pin(value) for value in row["teacher_evidence"].values())
                  for row in (left, right))
                 and (left["arm"], right["arm"]) == SHUFFLED_DEVELOPMENT_ARMS
                 and all(left[key] == right[key] for key in (
                    "seed", "native_seed", "configuration_sha256", "prepared_inputs_sha256",
                    "route", "paired_contrast_sha256", "teacher_evidence"))
                 and all(left[key] != right[key] for key in ("attempt_sha256", "trial_sha256", "job_sha256"))
                 and left["packet_sha256"] != right["packet_sha256"]
                 and not {left["packet_sha256"], right["packet_sha256"]}.intersection(packets),
                 "every shuffle contrast needs two original packets sharing one teacher selection")
        packets.update(((left["packet_sha256"], left["teacher_evidence"]),
                        (right["packet_sha256"], right["teacher_evidence"])))
    return packets


def prepare_shuffled_development(validator, arming, *, study, expected_study_sha256, design, expected_design_sha256,
        step_grid, expected_step_grid_sha256, contrast_plan, expected_contrast_plan_sha256,
        pairs, verify_preparation_owner):
    """Select original relational attempts from independently prepared matched/shuffled packets.

    Each entry supplies the seed label, two prepared packets, the selected
    pair digest, teacher evidence, and the two original arming declarations.
    The owner verifies the source/cohort and prospective evaluation design.
    This selection does not dispatch either packet or any unused arm.
    """
    _study(validator, study, expected_study_sha256)
    _shuffled_development_contrast(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    _require(_pin(expected_design_sha256) and development_design_commitment(design) == expected_design_sha256
             and design.study_sha256 == expected_study_sha256 and _pin(expected_step_grid_sha256)
             and tuple(seed for seed, _, _ in design.seed_cohorts) == tuple(seed.identifier for seed in study.seeds)
             and type(pairs) is tuple and len(pairs) == len(study.seeds)
             and callable(verify_preparation_owner),
             "original seed cohorts and independent shuffle preparation owner required")
    _selected_development_grid(study, expected_study_sha256, expected_design_sha256,
                               step_grid, expected_step_grid_sha256)

    def current():
        _require(commitment(study) == expected_study_sha256
                 and development_design_commitment(design) == expected_design_sha256
                 and development_step_grid_commitment(step_grid) == expected_step_grid_sha256
                 and commitment(contrast_plan) == expected_contrast_plan_sha256,
                 "selected study, design or grid changed during shuffle preparation")
        rows = []
        for choice, (seed, native_seed, _) in zip(pairs, design.seed_cohorts, strict=True):
            _require(type(choice) is tuple and len(choice) == 7 and choice[0] == seed,
                     "one original matched and shuffled packet pair per registered seed required")
            _, matched, shuffled, pair_sha256, teacher, matched_arming, shuffled_arming = choice
            _require(_pin(pair_sha256) and arming.shuffled_contrast_commitment(matched, shuffled) == pair_sha256,
                     "selected same-scope shuffle packet contrast differs")
            teacher_sha256 = arming.teacher_commitment(teacher)
            _require(type(matched_arming) is arming.Arming and type(shuffled_arming) is arming.ShuffledArming
                     and all(arming.arming_commitment(declaration) == packet.arming_sha256
                             and declaration.teacher_sha256 == teacher_sha256
                             and declaration.arms == packet.arms
                             for declaration, packet in ((matched_arming, matched), (shuffled_arming, shuffled)))
                     and matched_arming.origin_proof_sha256 == shuffled_arming.origin_proof_sha256
                     and shuffled_arming.shuffle_assignments
                         == tuple(batch.geometry_plan.shuffle for batch in shuffled.trials[2].batches),
                     "shuffle preparation must retain both original arming and teacher producer identities")
            population_sha256 = arming.population_commit(teacher.population, maximum_rows=4096)
            _require(population_sha256 == design.population_sha256
                     and sum(row.partition == "final" for row in teacher.population) == design.reserved_final_count,
                     "shuffle teacher population differs from the selected study and final reservation")
            teacher_evidence = {"profile_sha256": teacher.profile_sha256, "teacher_sha256": teacher_sha256,
                                "owner_close_sha256": teacher.vector_owner_close_sha256}
            vectors = {row.row_id: row for row in teacher.rows}
            approved = set(teacher.approved_edges)
            for packet, (arm, recipe_sha256) in zip((matched, shuffled), study.arms, strict=True):
                trial = packet.trials[2]
                _require((trial.arm, trial.seed, trial.study_sha256, trial.arm_recipe_sha256)
                         == ("relational", native_seed, expected_study_sha256, recipe_sha256)
                         and step_grid.steps[-1][1] <= len(trial.batches),
                         "shuffle contrast trial differs from its original recipe, study, native seed or step grid")
                for batch in trial.batches:
                    plan = batch.geometry_plan
                    source_pairs = plan.source_pairs
                    edges = tuple((i, j) for i, left in enumerate(batch.row_ids)
                                  for j, right in enumerate(batch.row_ids) if i < j
                                  and tuple(sorted((left, right))) in approved)
                    _require(plan.population == teacher.population and plan.population_sha256 == population_sha256
                             and plan.teacher_profile_sha256 == teacher.profile_sha256
                             and plan.teacher_width == arming.TEACHER_WIDTHS[teacher.name]
                             and (plan.coefficient, plan.maximum_hidden_elements)
                                 == (teacher.coefficient, teacher.maximum_hidden_elements)
                             and (source_pairs.train_admission_sha256, source_pairs.pair_authority_sha256, source_pairs.edges)
                                 == (teacher.train_admission_sha256, teacher.pair_authority_sha256, edges)
                             and all(vectors.get(vector.row_id) == vector for vector in plan.rows),
                             "selected shuffle teacher evidence must be the original vector and edge owner")
                route = ("t5-full-target-source-only/v1" if trial.batches[0].geometry_plan.student_profile == arming.geometry.T5
                         else "qwen2-digest-omitted-source-only/v1")
                rows.append({"seed": seed, "arm": arm, "native_arm": trial.arm, "native_seed": native_seed,
                    "recipe_sha256": recipe_sha256, "attempt_sha256": trial.attempt_sha256,
                    "packet_sha256": arming.packet_commitment(packet), "trial_sha256": arming.trial.commitment(trial),
                    "job_sha256": trial.job_sha256, "configuration_sha256": trial.configuration_sha256,
                    "prepared_inputs_sha256": trial.prepared_inputs_sha256, "route": route,
                    "paired_contrast_sha256": pair_sha256, "teacher_evidence": teacher_evidence})
        _require(len({row["attempt_sha256"] for row in rows}) == len(rows)
                 and len({row["configuration_sha256"] for row in rows}) == 1
                 and len({row["teacher_evidence"]["profile_sha256"] for row in rows}) == 1,
                 "one registered configuration and teacher profile, with distinct physical attempts")
        report = {"schema": SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA, "study_sha256": expected_study_sha256,
            "development_design_sha256": expected_design_sha256, "step_grid_sha256": expected_step_grid_sha256,
            "contrast_plan_sha256": expected_contrast_plan_sha256, "seed_cohorts": design.seed_cohorts,
            "attempts": tuple(rows)}
        selected_shuffled_teacher_packets(report)
        return report

    report = current()
    report_sha256 = commitment(report)
    _require(verify_preparation_owner(expected_study_sha256, report_sha256) is True
             and commitment(current()) == report_sha256,
             "independent owner refused the exact prospective shuffle comparison or its inputs changed")
    return report


SHUFFLED_TEACHER_COVERAGE_PLAN_SCHEMA = "reviewed-shuffled-teacher-coverage-plan/v1"
SHUFFLED_TEACHER_COVERAGE_READBACK_SCHEMA = "reviewed-shuffled-teacher-coverage-readback/v2"


@dataclass(frozen=True)
class ShuffledTeacherCoveragePlan:
    study_sha256: str
    development_design_sha256: str
    step_grid_sha256: str
    contrast_plan_sha256: str
    teacher: str
    profile_sha256: str
    student_variant: str
    # Seed label, source selection, TRAIN roster, producer request roster, selected request, controls.
    seeds: tuple[tuple[str, str, str, str, str, str], ...]


def shuffled_teacher_coverage_plan_commitment(plan):
    """Pin the scope and selected producer before any teacher outcomes."""
    _require(type(plan) is ShuffledTeacherCoveragePlan and type(plan.teacher) is str
             and plan.teacher in dict(MATRIX_TEACHERS)
             and _name(plan.student_variant)
             and all(_pin(pin) for pin in (plan.study_sha256, plan.development_design_sha256,
                 plan.step_grid_sha256, plan.contrast_plan_sha256, plan.profile_sha256))
             and type(plan.seeds) is tuple and bool(plan.seeds)
             and all(type(row) is tuple and len(row) == 6 and _name(row[0])
                     and all(_pin(pin) for pin in row[1:]) for row in plan.seeds)
             and len({row[0] for row in plan.seeds}) == len(plan.seeds),
             "exact preregistered shuffle teacher coverage scope required")
    return commitment((SHUFFLED_TEACHER_COVERAGE_PLAN_SCHEMA, plan))


def shuffled_teacher_train_controls_commitment(approved_edges, batch_row_and_donor_ids, *, pair_authority_sha256,
        coefficient, maximum_hidden_elements, parent_sha256, configuration_sha256, origin_proof_sha256):
    """Commit TRAIN treatment and parent choices before producer vectors exist."""
    _require(all(_pin(pin) for pin in (pair_authority_sha256, parent_sha256, configuration_sha256, origin_proof_sha256))
             and type(coefficient) is float and 0 < coefficient <= 1
             and type(maximum_hidden_elements) is int and 0 < maximum_hidden_elements <= 2**27,
             "exact prospective parent, pair authority and bounded teacher treatment required")
    return commitment(("reviewed-shuffled-teacher-train-controls/v1", approved_edges, batch_row_and_donor_ids,
                       pair_authority_sha256, coefficient, maximum_hidden_elements, parent_sha256,
                       configuration_sha256, origin_proof_sha256))


def _shuffled_teacher_coverage_rows(plan, design, evidence):
    _require(type(evidence) is tuple and len(evidence) == len(plan.seeds) == len(design.seed_cohorts),
             "one authenticated coverage report per preregistered seed required")
    rows = []
    for entry, selected, cohort in zip(evidence, plan.seeds, design.seed_cohorts, strict=True):
        label, source_pin, roster_pin, requests_pin, request_pin, control_pin = selected
        _require(type(entry) is tuple and len(entry) == 3 and entry[0] == label == cohort[0],
                 "coverage cannot drop, reorder or replace a registered seed")
        _, source, report = entry
        _require(type(source) is dict and source.get("schema") == "reviewed-relational-matched-teacher-source-selection/v1"
                 and source.get("selection_sha256") == source_pin
                 and commitment({key: value for key, value in source.items() if key != "selection_sha256"}) == source_pin
                 and (source.get("study_sha256"), source.get("job_seed"), source.get("train_cohort_sha256"),
                      source.get("population_sha256")) == (plan.study_sha256, cohort[1], cohort[2], design.population_sha256)
                 and _pin(source.get("producer_projection_sha256")) and type(source.get("fixture_only")) is bool
                 and type(source.get("job_seed")) is int,
                 "teacher coverage source differs from the selected TRAIN cohort, population or seed")
        variants = source.get("variants")
        _require(type(variants) is list and 2 <= len(variants) <= 8
                 and all(type(row) is dict and _name(row.get("variant"))
                         and _pin(row.get("prepared_sha256")) and _pin(row.get("origin_proof_sha256")) for row in variants)
                 and len({row["variant"] for row in variants}) == len(variants)
                 and plan.student_variant in {row["variant"] for row in variants},
                 "independently matched source selection lacks the selected student preparation")
        student = next(row for row in variants if row["variant"] == plan.student_variant)
        _require(type(report) is dict and report.get("schema") == "reviewed-matched-teacher-source-coverage/v1"
                 and _pin(report.get("coverage_sha256"))
                 and commitment({key: value for key,value in report.items() if key != "coverage_sha256"})
                     == report["coverage_sha256"]
                 and (report.get("source_selection_sha256"), report.get("source_projection_sha256"), report.get("requests_sha256"),
                      report.get("population_sha256"), report.get("train_cohort_sha256"))
                     == (source_pin, source["producer_projection_sha256"], requests_pin, design.population_sha256, cohort[2])
                 and report.get("fixture_only") is source["fixture_only"] and _pin(report.get("train_admission_sha256")),
                 "exact independently authenticated teacher coverage for the selected source and request roster required")
        roster, profiles = report.get("source_roster"), report.get("profiles")
        _require(type(roster) is list and 2 <= len(roster) <= 4096
                 and type(report.get("frozen_row_count")) is int and len(roster) == report["frozen_row_count"]
                 and all(type(row) is dict and _name(row.get("row_id")) and _pin(row.get("source_wire_sha256")) for row in roster)
                 and len({row["row_id"] for row in roster}) == len(roster) and commitment(roster) == roster_pin
                 and type(profiles) is list and len(profiles) == len(MATRIX_TEACHERS)
                 and all(type(profile) is dict for profile in profiles)
                 and tuple((profile.get("teacher"), profile.get("width")) for profile in profiles) == MATRIX_TEACHERS,
                 "exact full TRAIN denominator and original four-profile coverage roster required")
        profile = next(profile for profile in profiles if profile["teacher"] == plan.teacher)
        observed = profile.get("rows")
        _require(profile.get("profile_sha256") == plan.profile_sha256 and profile.get("request_sha256") == request_pin
                 and all(_pin(profile.get(key)) for key in ("owner_close_sha256", "source_outcome_sha256", "original_observation_sha256"))
                 and type(observed) is list and len(observed) == len(roster)
                 and all(type(row) is dict and _name(row.get("status")) for row in observed)
                 and [(row.get("row_id"), row.get("source_wire_sha256")) for row in observed]
                     == [(row["row_id"], row["source_wire_sha256"]) for row in roster],
                 "selected shuffle teacher request or ordered producer dispositions changed")
        events = profile.get("charged_event_refs")
        _require(type(events) is list and all(type(pair) is list and len(pair) == 2
                     and all(_pin(pin) for pin in pair) for pair in events),
                 "retained original teacher charge identities required")
        unavailable = tuple(row["row_id"] for row in observed if row["status"] != "embedded")
        status, refusal = profile.get("status"), profile.get("refusal_reason")
        _require((status == "closed_dispositions" and refusal is None
                     and all(row["status"] != "pre_dispatch_refusal" for row in observed))
                 or (status == "pre_dispatch_refusal" and _name(refusal)
                     and all(row["status"] == "pre_dispatch_refusal" for row in observed)),
                 "original teacher request disposition contradicts its rows")
        rows.append({"seed":label, "native_seed":cohort[1], "train_cohort_sha256":cohort[2],
            "coverage_sha256":report["coverage_sha256"], "producer_request_sha256":request_pin,
            "source_selection_sha256":source_pin, "source_projection_sha256":source["producer_projection_sha256"],
            "student_prepared_sha256":student["prepared_sha256"], "student_origin_sha256":student["origin_proof_sha256"],
            "control_sha256":control_pin, "frozen_train_row_count":len(roster), "unavailable_train_row_ids":unavailable,
            "producer_status":status, "refusal_reason":refusal, "fixture_only":report["fixture_only"],
            "original_observation_sha256":profile["original_observation_sha256"],
            "owner_close_sha256":profile["owner_close_sha256"], "selected_profile_event_refs":tuple(map(tuple, events))})
    return tuple(rows)


def _check_shuffle_coverage_pairs(arming, plan, pairs, evidence, readback):
    _require(type(pairs) is tuple and len(pairs) == len(evidence),
             "full coverage requires the original matched and shuffled packet pair per seed")
    vector_fields = ("row_id", "source_wire_sha256", "source_input_receipt_sha256", "producer_receipt_sha256",
                     "native_vector_sha256", "materialized_f32_sha256")
    for pair, (seed, _, report), selected, expected in zip(pairs, evidence, plan.seeds, readback, strict=True):
        _require(type(pair) is tuple and len(pair) == 7 and pair[0] == seed,
                 "exact original prepared pair for each coverage seed required")
        _, matched, shuffled, _, teacher, original_selection, arming_selection = pair
        profile = next(profile for profile in report["profiles"] if profile["teacher"] == plan.teacher)
        _require(type(teacher) is arming.Teacher and type(matched) is type(shuffled) is arming.Prepared
                 and type(original_selection) is arming.Arming and type(arming_selection) is arming.ShuffledArming
                 and (teacher.name, teacher.profile_sha256, teacher.vector_owner_close_sha256, teacher.train_admission_sha256)
                     == (plan.teacher, plan.profile_sha256, profile["owner_close_sha256"], report["train_admission_sha256"])
                 and tuple(tuple(getattr(row, key) for key in vector_fields) for row in teacher.rows)
                     == tuple(tuple(row.get(key) for key in vector_fields) for row in profile["rows"]),
                 "original arming must retain the selected complete teacher materialization and close")
        _require(all(declaration.origin_proof_sha256 == expected["student_origin_sha256"]
                     and packet.trials[2].prepared_inputs_sha256 == expected["student_prepared_sha256"]
                     for packet,declaration in ((matched, original_selection), (shuffled, arming_selection))),
                 "original decoder packets differ from the selected student origin or prepared inputs")
        _require(all(arming.trial._evidence_json(packet.specs[2], 1024**2).get("allow_fictional_fixture")
                     is report["fixture_only"] for packet in (matched, shuffled)),
                 "teacher coverage and selected decoder packets have different fixture scope")
        controls = tuple((tuple(batch.row_ids), assignment.donor_row_ids) for batch,assignment in
                         zip(shuffled.trials[2].batches, arming_selection.shuffle_assignments, strict=True))
        _require(shuffled_teacher_train_controls_commitment(teacher.approved_edges, controls,
                 pair_authority_sha256=teacher.pair_authority_sha256, coefficient=teacher.coefficient,
                 maximum_hidden_elements=teacher.maximum_hidden_elements, parent_sha256=original_selection.parent_sha256,
                 configuration_sha256=original_selection.configuration_sha256,
                 origin_proof_sha256=original_selection.origin_proof_sha256) == selected[-1],
                 "TRAIN treatment, parent or donor controls differ from preregistration")


def prepare_coverage_bound_shuffled_development(validator, arming, *, study, expected_study_sha256, design, expected_design_sha256,
        step_grid, expected_step_grid_sha256, contrast_plan, expected_contrast_plan_sha256, coverage_plan,
        expected_coverage_plan_sha256, coverage_evidence, pairs, verify_coverage_owner, verify_preparation_owner):
    """Prepare the existing comparison or retain a separate pre-arming refusal.

    The coverage owner authenticates the preregistration and the original
    producer outcomes behind the readback digest. This keeps selected TRAIN
    requirements separate from the untouched DEVELOPMENT study design.
    Event references preserve observed work for the existing cost owner.
    They do not allocate costs to a decoder that did not run.
    """
    _study(validator, study, expected_study_sha256)
    _shuffled_development_contrast(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    _selected_development_grid(study, expected_study_sha256, expected_design_sha256, step_grid, expected_step_grid_sha256)
    _require(callable(verify_coverage_owner) and callable(verify_preparation_owner)
             and _pin(expected_step_grid_sha256) and _pin(expected_coverage_plan_sha256),
             "existing coverage and preparation owner verification and exact plan required")

    def current():
        _require(commitment(study) == expected_study_sha256 and development_design_commitment(design) == expected_design_sha256
                 and design.study_sha256 == expected_study_sha256
                 and development_step_grid_commitment(step_grid) == expected_step_grid_sha256
                 and commitment(contrast_plan) == expected_contrast_plan_sha256
                 and shuffled_teacher_coverage_plan_commitment(coverage_plan) == expected_coverage_plan_sha256
                 and (coverage_plan.study_sha256, coverage_plan.development_design_sha256,
                      coverage_plan.step_grid_sha256, coverage_plan.contrast_plan_sha256)
                     == (expected_study_sha256, expected_design_sha256, expected_step_grid_sha256, expected_contrast_plan_sha256)
                 and tuple(row[0] for row in design.seed_cohorts) == tuple(seed.identifier for seed in study.seeds),
                 "selected study, development, grid, contrast or teacher coverage plan changed")
        rows = _shuffled_teacher_coverage_rows(coverage_plan, design, coverage_evidence)
        ready = all(not row["unavailable_train_row_ids"] for row in rows)
        if ready:
            _check_shuffle_coverage_pairs(arming, coverage_plan, pairs, coverage_evidence, rows)
        else:
            _require(pairs == (), "no decoder pairs may be presented for incomplete selected coverage")
        return {"schema":SHUFFLED_TEACHER_COVERAGE_READBACK_SCHEMA,
                "coverage_plan_sha256":expected_coverage_plan_sha256, "study_sha256":expected_study_sha256,
                "development_design_sha256":expected_design_sha256, "teacher":coverage_plan.teacher,
                "profile_sha256":coverage_plan.profile_sha256, "student_variant":coverage_plan.student_variant,
                "planned_arms":study.arms, "seeds":rows,
                "status":"complete_for_existing_preparation" if ready else "unavailable_before_decoder_arming",
                "charged_work_allocated":False}

    readback = current()
    readback_sha256 = commitment(readback)
    _require(verify_coverage_owner(expected_coverage_plan_sha256, readback_sha256) is True
             and commitment(current()) == readback_sha256,
             "original coverage owner refused or changed the selected teacher support readback")
    sidecar = {**readback, "readback_sha256":readback_sha256}
    if readback["status"] == "unavailable_before_decoder_arming":
        return None, sidecar

    def verify_preparation(study_sha256, preparation_sha256):
        _require(commitment(current()) == readback_sha256, "selected teacher coverage changed before arming approval")
        accepted = verify_preparation_owner(study_sha256, preparation_sha256, readback_sha256)
        _require(commitment(current()) == readback_sha256, "selected teacher coverage changed during arming approval")
        return accepted is True

    preparation = prepare_shuffled_development(validator, arming, study=study, expected_study_sha256=expected_study_sha256,
        design=design, expected_design_sha256=expected_design_sha256, step_grid=step_grid,
        expected_step_grid_sha256=expected_step_grid_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, pairs=pairs, verify_preparation_owner=verify_preparation)
    return preparation, sidecar


def _shuffled_capture_scope(matrix, roster, study, design, attempts):
    packets = selected_shuffled_teacher_packets(matrix)
    policies = {packet: (capture, resource) for packet, capture, resource in roster.packets}
    rows = matrix["attempts"]
    _require(study.cost_basis == "amortized" and study.reuse_count == 2
             and matrix["step_grid_sha256"] == roster.step_grid_sha256
             and commitment(matrix["seed_cohorts"]) == commitment(design.seed_cohorts)
             and set(policies) == set(packets) and len(rows) == len(attempts)
             and len({row["configuration_sha256"] for row in rows}) == 1
             and len({row["teacher_evidence"]["profile_sha256"] for row in rows}) == 1,
             "approved shuffle capture roster must cover both original packets per seed")
    cohorts = {seed: native for seed, native, _ in design.seed_cohorts}
    scope = {}
    for row, attempt in zip(rows, attempts, strict=True):
        _require((row["seed"], row["arm"], row["recipe_sha256"], row["attempt_sha256"])
                 == (attempt.seed, attempt.arm, attempt.recipe_sha256, attempt.attempt_sha256)
                 and row["native_seed"] == cohorts.get(attempt.seed),
                 "shuffle capture must bind every original selected attempt, including failures")
        scope[attempt.attempt_sha256] = row, policies[row["packet_sha256"]]
    _require(len(scope) == len(attempts), "shuffle capture contains reused physical attempt identities")
    return scope


def _selected_capture_roster(roster, expected_roster_sha256, matrix, *,
                             study, study_sha256, design, design_sha256, grid_sha256, contrast_sha256, attempts):
    inputs = (roster, expected_roster_sha256, matrix)
    if all(value is None for value in inputs):
        return None
    pilot = type(matrix) is dict and matrix.get("schema") == TEACHER_PILOT_PREPARATION_SCHEMA
    shuffled = type(matrix) is dict and matrix.get("schema") == SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA
    _require(_pin(expected_roster_sha256) and matched_capture_roster_commitment(roster) == expected_roster_sha256
             and (roster.study_sha256, roster.development_design_sha256, roster.step_grid_sha256)
                 == (study_sha256, design_sha256, grid_sha256)
             and study.stop_after_confirmation is False
             and type(matrix) is dict and (pilot or shuffled or matrix.get("schema") == MATCHED_MATRIX_SCHEMA)
             and commitment(matrix) == roster.matrix_sha256
             and (matrix.get("study_sha256"), matrix.get("development_design_sha256"), matrix.get("contrast_plan_sha256"))
                 == (study_sha256, design_sha256, contrast_sha256),
             "approved capture matrix, roster and fixed study grid must be supplied together")
    if pilot:
        return _pilot_capture_scope(matrix, roster, study, design, attempts)
    if shuffled:
        return _shuffled_capture_scope(matrix, roster, study, design, attempts)
    _require(commitment(matrix.get("seed_cohorts")) == commitment(design.seed_cohorts),
             "approved capture matrix must retain the exact development seed cohorts")

    variants, teachers, rows = (matrix.get(key) for key in ("variants", "teachers", "attempts"))
    _require(type(variants) in (tuple, list) and len(variants) >= 2
             and all(type(row) is dict and _name(row.get("label")) and _pin(row.get("configuration_sha256"))
                     for row in variants)
             and len({row["label"] for row in variants}) == len(variants)
             and type(teachers) in (tuple, list)
             and all(type(row) in (tuple, list) and len(row) == 3 and _pin(row[2]) for row in teachers)
             and tuple(tuple(row[:2]) for row in teachers) == MATRIX_TEACHERS
             and type(rows) in (tuple, list) and len(rows) == len(attempts),
             "exact issued capture matrix axes and full physical attempt roster required")
    expected = tuple((seed, native_seed, variant["label"], variant["configuration_sha256"], teacher[0], native_arm)
                     for seed, native_seed, _ in design.seed_cohorts for variant in variants
                     for teacher in teachers for native_arm in MATRIX_ARMS)
    _require(len(rows) == len(expected), "all three native arms are required in every matched capture cell")

    packets = {packet: (capture, resource) for packet, capture, resource in roster.packets}
    cell_packets = {}
    scope = {}
    for row, attempt, cell in zip(rows, attempts, expected, strict=True):
        _require(type(row) is dict and type(row.get("native_seed")) is int
                 and tuple(row.get(key) for key in ("seed", "native_seed", "variant", "configuration_sha256",
                                                      "teacher", "native_arm")) == cell
                 and tuple(row.get(key) for key in ("arm", "seed", "recipe_sha256", "attempt_sha256"))
                     == (attempt.arm, attempt.seed, attempt.recipe_sha256, attempt.attempt_sha256)
                 and all(_pin(row.get(key)) for key in ("packet_sha256", "trial_sha256", "job_sha256", "prepared_inputs_sha256"))
                 and row["packet_sha256"] in packets,
                 "capture matrix must bind every original attempt, including attempts without an observed look")
        packet = row["packet_sha256"]
        cell_key = row["seed"], row["variant"], row["teacher"]
        _require(cell_packets.setdefault(cell_key, packet) == packet,
                 "all three native arms of a matched capture cell must share one approved packet")
        scope[attempt.attempt_sha256] = row, packets[packet]
    _require(len(cell_packets) == len(packets) and set(cell_packets.values()) == set(packets),
             "approved capture packet roster must exhaust the issued matrix exactly once per cell")
    return scope


def _selected_teacher_cost_roster(roster, expected_roster_sha256, matrix, capture_scope, *, capture_roster_sha256, study):
    if capture_scope is None:
        packets = {}
    elif matrix["schema"] == TEACHER_PILOT_PREPARATION_SCHEMA:
        packets = selected_teacher_pilot_packets(matrix)
    elif matrix["schema"] == SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA:
        packets = selected_shuffled_teacher_packets(matrix)
    else:
        packets = _matrix_teacher_packets(matrix["attempts"], matrix["teachers"])
    if not packets and roster is None and expected_roster_sha256 is None:
        return None
    _require(bool(packets) and study.cost_basis == "amortized" and _pin(expected_roster_sha256)
             and teacher_cost_roster_commitment(roster) == expected_roster_sha256
             and roster.capture_roster_sha256 == capture_roster_sha256
             and {packet for packet, _, _ in roster.packets} == set(packets)
             and all(packets[packet]["owner_close_sha256"] == close for packet, close, _ in roster.packets),
             "teacher-evidence matrix requires an exact approved amortized producer cost roster and owner closes")

    by_packet = {packet: events for packet, _, events in roster.packets}
    if matrix["schema"] == SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA:
        rows = matrix["attempts"]
        _require(all(by_packet[left["packet_sha256"]] == by_packet[right["packet_sha256"]]
                     for left, right in zip(rows[::2], rows[1::2], strict=True)),
                 "both selected shuffle attempts must share exactly the original producer events")
    event_profiles = {}
    for packet, events in by_packet.items():
        profile = packets[packet]["profile_sha256"]
        _require(all(event_profiles.setdefault(event, profile) == profile for event in events),
                 "one physical teacher production event cannot serve different selected profiles")
    consumers = {event: set() for event in event_profiles}
    for attempt_sha256, (row, _) in capture_scope.items():
        if row["native_arm"] in MATRIX_ARMS[1:]:
            for event in by_packet[row["packet_sha256"]]:
                consumers[event].add(attempt_sha256)
    _require(all(len(arms) == study.reuse_count for arms in consumers.values()),
             "each teacher production event must have exactly the declared number of matched consumers")
    share = Fraction(1, study.reuse_count)
    shares = {attempt_sha256: {} for attempt_sha256 in capture_scope}
    for event, arms in consumers.items():
        for attempt_sha256 in arms:
            shares[attempt_sha256][event] = share
    return expected_roster_sha256, set(event_profiles), shares


def _require_matrix_development_identity(report, cell):
    identity, armed = (report.get(key) for key in ("native_identity", "armed_attempt"))
    _require(type(identity) is dict and type(armed) is dict
             and (report.get("arm"), report.get("seed"), identity.get("arm"), identity.get("seed"))
                 == (cell["arm"], cell["seed"], cell["native_arm"], cell["native_seed"])
             and all(armed.get(key) == cell[key] for key in (
                 "packet_sha256", "trial_sha256", "job_sha256", "configuration_sha256", "prepared_inputs_sha256", "recipe_sha256")),
             "development evidence must retain the native matrix packet and trial")
    if "paired_contrast_sha256" in cell:
        _require(armed.get("route") == cell["route"],
                 "shuffle development must use the selected original evaluator route")


def _development_roster(validator, study, attempts, design, receipts, expected_study_sha256, *,
                        step_grid=None, step_grid_sha256=None, capture_scope=None):
    _require(all(tuple(look.look for look in attempt.assessments) == study.schedule[:len(attempt.assessments)]
                 for attempt in attempts), "observed development looks must cover the exact scheduled prefix")
    expected = tuple((attempt, look) for attempt in attempts for look in attempt.assessments)
    _require(len(receipts) == len(expected), "every observed look needs exactly one native development receipt")
    cohorts = {label: (native_seed, cohort) for label, native_seed, cohort in design.seed_cohorts}
    rows = tuple(row[0] for row in study.panel)
    panel_sha256 = commitment(study.panel)
    component_count = len({row[1] for row in study.panel})
    selected = []
    bound_trials = {}
    scheduled_steps = None if step_grid is None else dict(step_grid.steps)
    checkpoint_ids, terminal_ids = set(), set()
    schema = NATIVE_DEVELOPMENT_LOOK_SCHEMA if scheduled_steps is None else SCHEDULED_NATIVE_DEVELOPMENT_LOOK_SCHEMA
    retrospective = any(receipt.report.get("schema") == RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA
                        for receipt in receipts)
    checkpoint_closes, evaluation_closes = set(), set()
    attempt_terminals, bound_schedules = {}, {}
    attempt_archives, archive_attempts = {}, {}
    if retrospective:
        _require(scheduled_steps is not None and study.stop_after_confirmation is False,
                 "retrospective development requires a fixed optimizer-step grid without confirmation-based stopping")
        schema = RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA
    for receipt, (attempt, assessment) in zip(receipts, expected, strict=True):
        report = receipt.report
        _require(report.get("schema") == schema
                 and commitment(report) == assessment.evaluation_receipt_sha256,
                 "assessment must bind the exact existing native development report")
        scheduled_checkpoint = _scheduled_checkpoint_metadata(report)
        _require(retrospective == (scheduled_checkpoint is not None),
                 "one retrospective or legacy checkpoint evidence mode required for the whole study")
        archived = _archived_capture_metadata(report)
        if capture_scope is None:
            _require(archived is None, "archived capture evidence requires its approved matched capture roster")
        else:
            cell, packet_policy = capture_scope[attempt.attempt_sha256]
            _require(retrospective and archived is not None
                     and (archived["capture_plan_sha256"], archived["resource_plan_sha256"]) == packet_policy,
                     "observed retrospective look must retain the approved packet capture and resource plan")
            _require_matrix_development_identity(report, cell)
            _require(attempt_archives.setdefault(attempt.attempt_sha256, archived) == archived
                     and archive_attempts.setdefault(archived["archived_arm_sha256"], attempt.attempt_sha256)
                         == attempt.attempt_sha256,
                     "archived capture must match exactly one original attempt across its observed looks")
        _require((report.get("study_sha256"), report.get("arm"), report.get("seed"),
                  report.get("panel_sha256"), report.get("evaluation_policy_sha256"),
                  report.get("retention_reference_sha256"))
                 == (expected_study_sha256, attempt.arm, attempt.seed, panel_sha256,
                     assessment.evaluation_policy_sha256, assessment.retention_reference_sha256)
                 and report["panel_sha256"] == assessment.panel_sha256
                 and report["evaluation_policy_sha256"] == study.evaluation_policy_sha256
                 and _pin(report.get("review_sha256")),
                 "native report differs from the exact study, arm, seed, panel or review selection")

        identity = report.get("native_identity")
        armed = report.get("armed_attempt")
        _require(type(identity) is dict and type(armed) is dict
                 and (identity.get("attempt_sha256"), identity.get("look"), identity.get("candidate_sha256"))
                     == (attempt.attempt_sha256, assessment.look, assessment.checkpoint_sha256)
                 and identity.get("arm") in ("supervised", "tap_only", "relational")
                 and type(identity.get("seed")) is int and identity["seed"] == cohorts[attempt.seed][0]
                 and _pin(identity.get("trial_terminal_close_sha256"))
                 and armed.get("recipe_sha256") == attempt.recipe_sha256 and armed.get("admission_version") == "v3"
                 and armed.get("route") in ("qwen2-digest-omitted-source-only/v1", "t5-full-target-source-only/v1")
                 and all(_pin(armed.get(key)) for key in ("selection_sha256", "packet_sha256", "trial_sha256",
                                                         "job_sha256", "configuration_sha256", "prepared_inputs_sha256")),
                 "native report differs from the selected physical attempt, candidate, route or look")
        if scheduled_steps is not None:
            _require(report.get("optimizer_step_grid_sha256") == step_grid_sha256
                     and type(report.get("optimizer_steps")) is int
                     and report["optimizer_steps"] == scheduled_steps[assessment.look],
                     "native report does not certify the exact scheduled optimizer step for this look")
            checkpoint = attempt.attempt_sha256, assessment.checkpoint_sha256
            terminal_sha = identity["trial_terminal_close_sha256"]
            terminal = attempt.attempt_sha256, terminal_sha
            if retrospective:
                close_sha = scheduled_checkpoint["checkpoint_close_sha256"]
                schedule_sha = scheduled_checkpoint["schedule_sha256"]
                evaluation_sha = receipt.owner_close_sha256
                _require(checkpoint not in checkpoint_ids and close_sha not in checkpoint_closes
                         and evaluation_sha not in evaluation_closes
                         and len({close_sha, terminal_sha, evaluation_sha}) == 3,
                         "each retrospective look needs a distinct candidate, readback close and evaluation close")
                _require(attempt_terminals.setdefault(terminal_sha, attempt.attempt_sha256) == attempt.attempt_sha256
                         and bound_schedules.setdefault(attempt.attempt_sha256, (terminal_sha, schedule_sha))
                             == (terminal_sha, schedule_sha),
                         "retrospective looks must retain one whole-trial terminal and checkpoint schedule per attempt")
                checkpoint_closes.add(close_sha)
                evaluation_closes.add(evaluation_sha)
            else:
                _require(checkpoint not in checkpoint_ids and terminal not in terminal_ids,
                         "one checkpoint or training terminal close cannot fill two scheduled optimizer steps")
            checkpoint_ids.add(checkpoint)
            terminal_ids.add(terminal)

        split = report.get("development_split")
        _require(type(split) is dict and split.get("role") == "development" and _pin(split.get("selection_sha256"))
                 and (split.get("global_split_sha256"), split.get("population_sha256"), split.get("train_cohort_sha256"))
                     == (design.global_split_sha256, design.population_sha256, cohorts[attempt.seed][1])
                 and type(split.get("reserved_final_count")) is int
                 and split["reserved_final_count"] == design.reserved_final_count
                 and commitment(split.get("case_aliases")) == design.case_aliases_sha256,
                 "native report differs from the preregistered development split or matched seed cohort")

        native_trial = (identity["arm"], identity["seed"], armed["selection_sha256"], armed["packet_sha256"],
                        armed["trial_sha256"], armed["job_sha256"], armed["configuration_sha256"],
                        armed["prepared_inputs_sha256"], armed["route"], split["selection_sha256"])
        _require(bound_trials.setdefault(attempt.attempt_sha256, native_trial) == native_trial,
                 "scheduled development looks changed the same attempt's armed trial")

        roster = report.get("rows")
        closes = report.get("component_closes")
        plan_pins = armed.get("assessment_sha256s")
        _require(type(roster) in (tuple, list) and all(type(row) is dict for row in roster)
                 and tuple(row.get("row_id") for row in roster) == rows
                 and type(closes) in (tuple, list) and len(closes) == component_count
                 and all(type(close) is dict
                         and set(close) == {"observation_sha256", "artifact_sha256", "owner_close_sha256"}
                         and all(_pin(value) for value in close.values()) for close in closes)
                 and len({close["observation_sha256"] for close in closes}) == component_count
                 and type(plan_pins) in (tuple, list) and len(plan_pins) == component_count
                 and all(_pin(value) for value in plan_pins) and len(set(plan_pins)) == component_count,
                 "native report must retain every frozen component, case and evaluation plan")
        _require(type(assessment.gates) is dict and set(assessment.gates) == set(validator.GATES)
                 and all(type(value) is validator.Counts for value in assessment.gates.values())
                 and type(report.get("counts")) is dict
                 and commitment(report["counts"]) == commitment(assessment.gates),
                 "native development report and assessment gate counts differ")
        selected.append({"attempt_sha256": attempt.attempt_sha256, "look": assessment.look,
                         "checkpoint_sha256": assessment.checkpoint_sha256,
                         "evaluation_receipt_sha256": assessment.evaluation_receipt_sha256,
                         "owner_close_sha256": receipt.owner_close_sha256,
                         "trial_terminal_close_sha256": identity["trial_terminal_close_sha256"],
                         "meter_record_sha256": assessment.meter.record_sha256})
        if scheduled_steps is not None:
            selected[-1]["optimizer_steps"] = report["optimizer_steps"]
        if retrospective:
            selected[-1]["scheduled_checkpoint"] = dict(scheduled_checkpoint)
        if archived is not None:
            selected[-1]["archived_capture"] = dict(archived)
    if retrospective:
        terminal_closes = set(attempt_terminals)
        _require(not checkpoint_closes & (evaluation_closes | terminal_closes)
                 and not evaluation_closes & terminal_closes,
                 "retrospective checkpoint, evaluation and training closes must have distinct identities")
    return tuple(selected)


def _development_component_cost_rows(receipts):
    _require(type(receipts) is tuple and all(type(receipt) is DevelopmentReceipt and type(receipt.report) is dict
             and receipt.report.get("schema") == RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA
             and type(receipt.report.get("native_identity")) is dict
             and type(receipt.report.get("component_closes")) in (tuple, list)
             and bool(receipt.report["component_closes"])
             and all(type(row) is dict and _pin(row.get("owner_close_sha256"))
                     for row in receipt.report["component_closes"]) for receipt in receipts),
             "exclusive component costs require the original retrospective reports and component closes")
    rows = tuple((receipt.report["native_identity"].get("attempt_sha256"), receipt.report["native_identity"].get("look"),
                  tuple(row["owner_close_sha256"] for row in receipt.report["component_closes"]))
                 for receipt in receipts)
    _require(all(_pin(attempt) and _name(look) and look != "close" for attempt, look, _ in rows)
             and len({(attempt, look) for attempt, look, _ in rows}) == len(rows),
             "one original component cost roster per retrospective look required")
    return rows


def development_component_costs_commitment(receipts, *, development_receipts_sha256, cost_evidence_sha256):
    """Bind the selected exclusive component accounting to the original look and cost rosters."""
    _require(_pin(development_receipts_sha256) and _pin(cost_evidence_sha256),
             "component costs require the selected report and physical cost evidence commitments")
    return commitment(("reviewed-retrospective-development-component-costs/v1", development_receipts_sha256,
                       cost_evidence_sha256, _development_component_cost_rows(receipts)))


def _verify_development_component_charges(rows, selected, attempts, evidence):
    _require(type(evidence) is CostEvidence and type(evidence.observations) is tuple,
             "component charges require the original typed cost evidence")
    reserved = {attempt.closeout_receipt_sha256 for attempt in attempts}
    for look in selected:
        reserved.update((look["trial_terminal_close_sha256"], look["owner_close_sha256"],
                         look["scheduled_checkpoint"]["checkpoint_close_sha256"],
                         look["scheduled_checkpoint"]["owner_stage_record_sha256"]))
    closes = tuple(close for _, _, component_closes in rows for close in component_closes)
    close_set = set(closes)
    _require(len(close_set) == len(closes) and reserved.isdisjoint(close_set),
             "exclusive development component closes must be distinct from other components and look or terminal closes")
    events = tuple(event for event in _event_roster(evidence.events).values() if event.close_receipt_sha256 in close_set)
    by_close = {event.close_receipt_sha256: event for event in events}
    _require(len(events) == len(closes) and set(by_close) == close_set
             and all(event.kind == "development" and event.disposition == "complete" for event in events),
             "component costs require each original completed development event")
    selected_events = {(attempt, look): tuple(by_close[close].event_sha256 for close in component_closes)
                       for attempt, look, component_closes in rows}
    component_ids = {event.event_sha256 for event in by_close.values()}
    accumulated = {}
    for interval, charges in evidence.observations:
        _require(type(interval) is MeterInterval and type(charges) is ChargeManifest,
                 "component costs require the original meter and charge manifests")
        expected = accumulated.setdefault(interval.attempt_sha256, set())
        expected.update(selected_events.get((interval.attempt_sha256, interval.stage), ()))
        paid = {key: value for key, value in charges.entries if key in component_ids}
        _require(paid == {key: Fraction(1) for key in expected},
                 "each paid look and later close must charge exactly its own reached development components")
    return tuple((attempt, look, tuple(zip(component_closes, selected_events[attempt, look], strict=True)))
                 for attempt, look, component_closes in rows)


def _check_shuffled_paid_coverage(study, design, readback, readback_pin, matrix, teacher_roster, expected_teacher_roster_sha256,
        paid, request_roster_raw, expected_request_roster_sha256):
    """Join the pre-arming coverage to the exact original producer and paid leaves."""
    from .physical_cost import PACKET_TEACHER_REQUEST_ROSTER_SCHEMA, read_selected

    _require(type(readback) is dict and readback.get("schema") == SHUFFLED_TEACHER_COVERAGE_READBACK_SCHEMA
             and readback.get("readback_sha256") == readback_pin
             and commitment({key: value for key, value in readback.items() if key != "readback_sha256"}) == readback_pin
             and readback.get("status") == "complete_for_existing_preparation"
             and readback.get("charged_work_allocated") is False
             and _pin(readback.get("coverage_plan_sha256")) and _pin(readback.get("profile_sha256"))
             and readback.get("study_sha256") == matrix["study_sha256"]
             and readback.get("development_design_sha256") == matrix["development_design_sha256"]
             and commitment(readback.get("planned_arms")) == commitment(study.arms),
             "paid shuffle comparison requires the original complete preregistered teacher coverage readback")
    rows = readback.get("seeds")
    _require(type(rows) in (tuple, list) and len(rows) == len(design.seed_cohorts)
             and all(type(row) is dict for row in rows)
             and tuple(tuple(row.get(key) for key in ("seed", "native_seed", "train_cohort_sha256"))
                       for row in rows) == design.seed_cohorts,
             "paid teacher coverage must retain every registered seed and TRAIN cohort")
    by_seed = {row["seed"]: row for row in rows}
    for row in rows:
        _require(row.get("producer_status") == "closed_dispositions" and row.get("refusal_reason") is None
                 and row.get("unavailable_train_row_ids") in ((), [])
                 and type(row.get("frozen_train_row_count")) is int and row["frozen_train_row_count"] >= 2
                 and all(_pin(row.get(key)) for key in ("owner_close_sha256", "source_selection_sha256",
                     "source_projection_sha256", "producer_request_sha256", "student_prepared_sha256", "coverage_sha256")),
                 "paid teacher coverage must retain complete native dispositions on the frozen TRAIN roster")
    _require(type(paid) is CostEvidence and _pin(expected_request_roster_sha256),
             "paid teacher coverage requires exact original physical and producer request evidence")
    events = _event_roster(paid.events)
    by_packet = {row["packet_sha256"]: row for row in matrix["attempts"]}
    requests = []
    for packet, aggregate, event_ids in teacher_roster.packets:
        original = by_packet[packet]
        row = by_seed[original["seed"]]
        _require(original["teacher_evidence"]["profile_sha256"] == readback["profile_sha256"]
                 and original["teacher_evidence"]["owner_close_sha256"] == aggregate == row["owner_close_sha256"]
                 and original["prepared_inputs_sha256"] == row["student_prepared_sha256"],
                 "paid packet differs from its coverage-bound teacher, aggregate or student preparation")
        refs = row.get("selected_profile_event_refs")
        _require(type(refs) in (tuple, list) and all(type(ref) in (tuple, list) and len(ref) == 2
                     and all(_pin(pin) for pin in ref) for ref in refs)
                 and len(refs) == len({ref[0] for ref in refs})
                 and all(event in events and events[event].kind == "teacher_production" for event in event_ids)
                 and {tuple(ref) for ref in refs} == {(event, events[event].close_receipt_sha256) for event in event_ids},
                 "paid teacher events or original physical closes differ from the selected coverage")
        requests.append({"packet_sha256": packet, "profile_sha256": readback["profile_sha256"],
                         **{key: row[key] for key in ("producer_request_sha256", "train_cohort_sha256",
                                                    "source_selection_sha256", "source_projection_sha256")}})
    selected = read_selected(request_roster_raw, expected_request_roster_sha256)
    _require(selected == {"schema": PACKET_TEACHER_REQUEST_ROSTER_SCHEMA,
                          "teacher_cost_roster_sha256": expected_teacher_roster_sha256, "packets": requests},
             "paid packet request, profile or TRAIN source differs from the selected coverage")


def compare_verified_development_contrasts(validator, *, study, expected_study_sha256, attempts,
                                           expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256,
                                           cost_evidence, expected_cost_evidence_sha256, verify_cost_owner,
                                           development_design, expected_development_design_sha256,
                                           development_receipts, expected_development_receipts_sha256,
                                           verify_development_owner, step_grid=None, expected_step_grid_sha256=None,
                                           capture_roster=None, expected_capture_roster_sha256=None, capture_matrix=None,
                                           teacher_cost_roster=None, expected_teacher_cost_roster_sha256=None,
                                           activation_diagnostic_charges=None,
                                           expected_activation_diagnostic_charges_sha256=None,
                                           expected_teacher_request_roster_sha256=None,
                                           expected_development_component_costs_sha256=None,
                                           shuffle_coverage_readback=None, expected_shuffle_coverage_readback_sha256=None,
                                           shuffle_teacher_request_roster_raw=None, verify_shuffle_coverage_preparation=None,
                                           include_confirmation_cost_bounds=False):
    """Authenticate each actual validation look before the existing paid comparison.

    The selected owner resolves the preregistration, candidate and training
    close, component evaluations, review findings and their terminal closes.
    Cost-only attempts keep their closing evidence with no manufactured look.
    A selected teacher pilot uses its preparation as the capture source and
    retains the original per-packet plans and exclusive non-teacher events.
    The cost owner authenticates any selected activation charges and then
    any selected teacher request roster against the original paid work. With
    exclusive component accounting selected, its final callback pin binds the
    original component closes to their physical events and cumulative meters.
    A selected shuffle coverage readback replays the original preparation
    approval and must match the complete paid teacher leaves and packet requests.
    """
    _study(validator, study, expected_study_sha256)
    _selected_development_grid(study, expected_study_sha256, expected_development_design_sha256,
                               step_grid, expected_step_grid_sha256)
    expected_trials = tuple((seed.identifier, *arm) for seed in study.seeds for arm in study.arms)
    _require(callable(verify_development_owner) and _pin(expected_development_design_sha256)
             and _pin(expected_development_receipts_sha256) and _pin(expected_attempts_sha256)
             and type(attempts) is tuple and len(attempts) == len(expected_trials)
             and all(type(attempt) is Attempt and attempt.study_sha256 == expected_study_sha256
                     and (attempt.seed, attempt.arm, attempt.recipe_sha256) == trial
                     and _pin(attempt.attempt_sha256) and type(attempt.assessments) is tuple
                     and all(type(assessment) is Assessment and type(assessment.meter) is Meter
                             for assessment in attempt.assessments)
                     for attempt, trial in zip(attempts, expected_trials, strict=True))
             and len({attempt.attempt_sha256 for attempt in attempts}) == len(attempts),
             "exact complete paired attempt roster and independent development owner required")
    coverage_selected = any(value is not None for value in (shuffle_coverage_readback,
        expected_shuffle_coverage_readback_sha256, shuffle_teacher_request_roster_raw, verify_shuffle_coverage_preparation))
    if coverage_selected:
        _require(_pin(expected_shuffle_coverage_readback_sha256) and callable(verify_shuffle_coverage_preparation),
                 "independent original coverage and preparation verification required")

    def current():
        _require(commitment(study) == expected_study_sha256
                 and commitment(attempts) == expected_attempts_sha256
                 and development_design_commitment(development_design) == expected_development_design_sha256
                 and development_design.study_sha256 == expected_study_sha256
                 and tuple(label for label, _, _ in development_design.seed_cohorts)
                     == tuple(seed.identifier for seed in study.seeds)
                 and development_receipts_commitment(development_receipts,
                     design_sha256=expected_development_design_sha256, attempts_sha256=expected_attempts_sha256)
                     == expected_development_receipts_sha256,
                 "selected development design, attempts or receipts differ")
        _selected_development_grid(study, expected_study_sha256, expected_development_design_sha256,
                                   step_grid, expected_step_grid_sha256)
        capture_scope = _selected_capture_roster(capture_roster, expected_capture_roster_sha256, capture_matrix,
            study=study, study_sha256=expected_study_sha256, design=development_design,
            design_sha256=expected_development_design_sha256, grid_sha256=expected_step_grid_sha256,
            contrast_sha256=expected_contrast_plan_sha256, attempts=attempts)
        teacher_policy = _selected_teacher_cost_roster(teacher_cost_roster, expected_teacher_cost_roster_sha256,
            capture_matrix, capture_scope, capture_roster_sha256=expected_capture_roster_sha256, study=study)
        if coverage_selected:
            _require(capture_scope is not None and teacher_policy is not None
                     and capture_matrix["schema"] == SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA,
                     "coverage-bound paid comparison requires the original shuffle preparation and capture roster")
            _check_shuffled_paid_coverage(study, development_design, shuffle_coverage_readback,
                expected_shuffle_coverage_readback_sha256, capture_matrix, teacher_cost_roster,
                expected_teacher_cost_roster_sha256, cost_evidence, shuffle_teacher_request_roster_raw,
                expected_teacher_request_roster_sha256)
        return capture_scope, teacher_policy

    capture_scope, teacher_policy = current()
    is_shuffled = capture_scope is not None and capture_matrix["schema"] == SHUFFLED_DEVELOPMENT_PREPARATION_SCHEMA
    if is_shuffled:
        _require(_pin(expected_teacher_request_roster_sha256) and teacher_policy is not None,
                 "shuffled comparison requires the original selected teacher request roster")
        _shuffled_development_contrast(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    _require(expected_teacher_request_roster_sha256 is None or
             (_pin(expected_teacher_request_roster_sha256) and teacher_policy is not None),
             "selected teacher requests require an exact digest and teacher cost roster")
    if coverage_selected:
        _require(verify_shuffle_coverage_preparation(expected_study_sha256, capture_roster.matrix_sha256,
                     expected_shuffle_coverage_readback_sha256) is True,
                 "original preparation owner refused the joint shuffle coverage selection")
        current()
    selected = _development_roster(validator, study, attempts, development_design, development_receipts,
                                   expected_study_sha256, step_grid=step_grid, step_grid_sha256=expected_step_grid_sha256,
                                   capture_scope=capture_scope)
    component_cost_charges = None
    if expected_development_component_costs_sha256 is not None:
        _require(callable(verify_cost_owner) and _pin(expected_development_component_costs_sha256)
                 and development_component_costs_commitment(development_receipts,
                        development_receipts_sha256=expected_development_receipts_sha256,
                        cost_evidence_sha256=expected_cost_evidence_sha256) == expected_development_component_costs_sha256,
                 "independent exclusive development component cost selection required")
        component_cost_charges = _verify_development_component_charges(
            _development_component_cost_rows(development_receipts), selected, attempts, cost_evidence)

        def component_cost_owner(*pins):
            return verify_cost_owner(*pins, expected_development_component_costs_sha256)

    else:
        component_cost_owner = verify_cost_owner
    selection = (expected_development_design_sha256, expected_development_receipts_sha256)
    if step_grid is not None:
        selection = (*selection, expected_step_grid_sha256)
    if capture_scope is not None:
        selection = (*selection, expected_capture_roster_sha256)
    _require(verify_development_owner(*selection) is True,
             "independent owner refused the development selection or evaluation receipts")
    current()
    cost_options = {}
    is_teacher_pilot = capture_scope is not None and capture_matrix["schema"] == TEACHER_PILOT_PREPARATION_SCHEMA
    if is_teacher_pilot or is_shuffled:
        cost_options["exclusive_non_teacher_work"] = True
    if is_shuffled:
        cost_options["require_original_terminal_event"] = True
    if selected and "scheduled_checkpoint" in selected[0]:
        cost_options["retrospective_look_closes"] = {
            (row["attempt_sha256"], row["look"]): (row["trial_terminal_close_sha256"], row["owner_close_sha256"])
            for row in selected
        }
    if activation_diagnostic_charges is not None:
        _require(activation_diagnostic_charges_commitment(activation_diagnostic_charges)
                 == expected_activation_diagnostic_charges_sha256,
                 "exact independently approved activation diagnostic charge roster required")
        other_closes = {row[key] for row in selected for key in (
            "trial_terminal_close_sha256", "owner_close_sha256")}
        other_closes.update(row["scheduled_checkpoint"][key] for row in selected if "scheduled_checkpoint" in row
                            for key in ("checkpoint_close_sha256", "owner_stage_record_sha256"))
        other_closes.update(close["owner_close_sha256"] for receipt in development_receipts
                            for close in receipt.report["component_closes"])
        _require(other_closes.isdisjoint(row.owner_close_sha256 for row in activation_diagnostic_charges),
                 "activation diagnostic close cannot be a training, evaluation or checkpoint receipt")
    report = _compare_verified_contrasts(validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=component_cost_owner,
        teacher_policy=teacher_policy, activation_diagnostic_charges=activation_diagnostic_charges,
        expected_activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
        expected_teacher_request_roster_sha256=expected_teacher_request_roster_sha256,
        include_confirmation_cost_bounds=include_confirmation_cost_bounds, **cost_options)
    current()
    output = {**report, "schema": VERIFIED_DEVELOPMENT_SCHEMA,
            "development_design_sha256": expected_development_design_sha256,
            "development_receipts_sha256": expected_development_receipts_sha256,
            "development_looks": selected}
    if step_grid is not None:
        output.update(optimizer_step_grid_sha256=expected_step_grid_sha256, optimizer_step_schedule=step_grid.steps)
    if capture_scope is not None:
        output.update(capture_matrix_sha256=capture_roster.matrix_sha256,
                      capture_roster_sha256=expected_capture_roster_sha256)
        if is_teacher_pilot:
            output.update(teacher_pilot_preparation_sha256=capture_roster.matrix_sha256,
                          evidence_kind=capture_matrix["evidence_kind"])
        if is_shuffled:
            output.update(shuffled_preparation_sha256=capture_roster.matrix_sha256,
                          shuffled_native_contrasts=tuple((row["seed"], row["paired_contrast_sha256"])
                                                         for row in capture_matrix["attempts"][::2]),
                          shared_production_accounting="two_consumer_amortized_additive_work")
    if teacher_policy is not None:
        output["teacher_cost_roster_sha256"] = expected_teacher_cost_roster_sha256
    if component_cost_charges is not None:
        output.update(development_component_costs_sha256=expected_development_component_costs_sha256,
                      development_component_charges=component_cost_charges)
    if coverage_selected:
        output["shuffle_coverage_readback_sha256"] = expected_shuffle_coverage_readback_sha256
    return output


COMPACT_DEVELOPMENT_LOOK_SCHEMA = "reviewed-compact-development-threshold-look/v1"
COMPACT_DEVELOPMENT_CELLS_SCHEMA = "reviewed-compact-development-terminal-cells/v1"
VERIFIED_COMPACT_DEVELOPMENT_SCHEMA = "paired-cost-to-confirmed-compact-development-threshold-verified/v1"


def compact_development_cells_commitment(cells, *, design_sha256, attempts_sha256):
    """Bind ordered compact look selections and terminal evidence, including empty rosters."""
    _require(_pin(design_sha256) and _pin(attempts_sha256) and type(cells) is tuple
             and all(type(cell) is tuple and len(cell) == 2 and all(type(item) is dict for item in cell)
                     for cell in cells),
             "exact ordered compact look and terminal evidence roster required")
    return commitment((COMPACT_DEVELOPMENT_CELLS_SCHEMA, design_sha256, attempts_sha256, cells))


def _compact_terminal_identity(terminal, *, selection, report, checkpoint_sha256, split_sha256):
    _require(type(terminal) is dict and set(terminal) == {"binding", "backend_identity", "source_sha256"}
             and selection.get("terminal_selection_sha256") == commitment(terminal)
             and type(terminal["binding"]) is dict and type(terminal["backend_identity"]) is dict
             and type(terminal["source_sha256"]) is dict
             and set(terminal["source_sha256"]) == {"worker", "inputs", "consumer", "admission", "splits"}
             and all(_pin(value) for value in terminal["source_sha256"].values()),
             "compact terminal metadata differs from the selected look or source roles")
    binding = terminal["binding"]
    backend = terminal["backend_identity"]
    references = ("terminal_manifest", "worker_receipt", "model_checkpoint", "optimizer_checkpoint")
    _require(binding.get("schema") == "reviewed-packed-decoder-terminal-evaluation-binding/v1"
             and binding.get("training_split_manifest_sha256") == split_sha256
             and type(binding.get("optimizer_steps")) is int
             and binding["optimizer_steps"] == report["optimizer_steps"]
             and all(type(binding.get(name)) is dict and set(binding[name]) == {"path", "sha256", "bytes"}
                     and type(binding[name]["path"]) is str and binding[name]["path"].startswith("/")
                     and _pin(binding[name]["sha256"]) and type(binding[name]["bytes"]) is int
                     and binding[name]["bytes"] > 0 for name in references)
             and len({binding[name]["path"] for name in references}) == len(references)
             and binding["terminal_manifest"]["sha256"] == checkpoint_sha256
             and all(_pin(binding.get(key)) for key in ("training_binding_sha256", "prepared_inputs_sha256", "job_spec_sha256"))
             and backend.get("target_codec") == "complete-reviewed-norm-packed-json/v1"
             and backend.get("checkpoint_format") == "torch-weights-only-packed-reviewed-state-pair/v1"
             and backend.get("implementation_sha256") == terminal["source_sha256"]["worker"],
             "compact checkpoint, sealed runtime or original TRAIN evidence differs")
    train_ids = binding.get("training_record_ids")
    budget = binding.get("token_budgets")
    _require(type(train_ids) is list and bool(train_ids) and all(_name(value) for value in train_ids)
             and len(set(train_ids)) == len(train_ids)
             and type(budget) is dict and set(budget) == {"max_source_tokens", "max_target_tokens", "tokenizer_contract"}
             and all(type(budget[name]) is int and budget[name] > 0 for name in ("max_source_tokens", "max_target_tokens"))
             and type(budget["tokenizer_contract"]) is dict and bool(budget["tokenizer_contract"]),
             "ordered compact TRAIN IDs and exact tokenizer and token budgets required")
    return (tuple(train_ids), commitment((backend, terminal["source_sha256"], budget)),
            binding["worker_receipt"]["sha256"], binding["job_spec_sha256"])


def _compact_development_roster(validator, study, attempts, design, grid, receipts, terminal_cells):
    expected = tuple((attempt, assessment) for attempt in attempts for assessment in attempt.assessments)
    _require(len(receipts) == len(terminal_cells) == len(expected),
             "every scored compact look needs its own development receipt and terminal evidence")
    rows = tuple(row[0] for row in study.panel)
    groups = {row[1] for row in study.panel}
    _require(len(groups) == 1 and design.case_aliases_sha256 == commitment(tuple((row, row) for row in rows)),
             "compact comparison must retain one registered validation component and identity aliases")
    group, = groups
    panel = commitment(study.panel)
    step = grid.steps[0][1]
    seeds = {seed.identifier: seed for seed in study.seeds}
    design_pin = development_design_commitment(design)
    grid_pin = development_step_grid_commitment(grid)
    planned_fields = {"study_sha256", "development_design_sha256", "optimizer_step_grid_sha256", "arm", "seed",
                      "recipe_sha256", "attempt_sha256", "look", "terminal_owner_close_sha256", "artifact_sha256",
                      "inputs_sha256", "terminal_selection_sha256"}
    scopes = {}
    physical_ids = {"checkpoint": set(), "worker": set(), "job": set(), "artifact": set(), "close": set()}
    selected = []
    for receipt, (selection, terminal), (attempt, assessment) in zip(receipts, terminal_cells, expected, strict=True):
        report = receipt.report
        _require(report.get("schema") == COMPACT_DEVELOPMENT_LOOK_SCHEMA
                 and commitment(report) == assessment.evaluation_receipt_sha256
                 and set(selection) == planned_fields
                 and all(_pin(selection.get(key)) for key in ("inputs_sha256", "artifact_sha256", "terminal_selection_sha256"))
                 and report.get("selection_sha256") == commitment((COMPACT_DEVELOPMENT_LOOK_SCHEMA, "selection", selection))
                 and (assessment.look, report.get("look")) == (grid.steps[0][0], grid.steps[0][0])
                 and all(selection[key] == value == report.get(key) for key, value in {
                     "study_sha256": attempt.study_sha256, "development_design_sha256": design_pin,
                     "optimizer_step_grid_sha256": grid_pin, "arm": attempt.arm, "seed": attempt.seed,
                     "recipe_sha256": attempt.recipe_sha256, "attempt_sha256": attempt.attempt_sha256,
                     "look": assessment.look}.items()),
                 "compact look receipt or selection differs from the exact registered physical attempt")
        _require(report.get("checkpoint_sha256") == assessment.checkpoint_sha256
                 and (report.get("split_manifest_sha256"), report.get("reserved_final_count"))
                     == (design.global_split_sha256, design.reserved_final_count)
                 and type(report.get("optimizer_steps")) is int and report["optimizer_steps"] == step
                 and report.get("panel_sha256") == assessment.panel_sha256 == panel
                 and report.get("evaluation_policy_sha256") == assessment.evaluation_policy_sha256 == study.evaluation_policy_sha256
                 and report.get("retention_reference_sha256") == assessment.retention_reference_sha256
                     == seeds[attempt.seed].retention_reference_sha256
                 and report.get("dependency_group_sha256") == group and _pin(report.get("review_sha256")),
                 "compact report differs from the registered split, case policy, checkpoint or optimizer step")
        body = report.get("rows")
        _require(type(body) in (list, tuple) and all(type(row) is dict for row in body)
                 and tuple(row.get("row_id") for row in body) == rows
                 and type(assessment.gates) is dict and set(assessment.gates) == set(validator.GATES)
                 and all(type(value) is validator.Counts for value in assessment.gates.values())
                 and type(report.get("counts")) is dict and commitment(report["counts"]) == commitment(assessment.gates),
                 "complete ordered compact validation findings and the exact gate counts are required")
        component = report.get("component_close")
        train_close = report.get("terminal_owner_close_sha256")
        _require(type(component) is dict and set(component) == {
                     "observation_sha256", "artifact_sha256", "owner_close_sha256"}
                 and all(_pin(value) for value in component.values())
                 and component["artifact_sha256"] == selection["artifact_sha256"]
                 and train_close == selection.get("terminal_owner_close_sha256") and _pin(train_close)
                 and len({train_close, component["owner_close_sha256"], receipt.owner_close_sha256,
                          attempt.closeout_receipt_sha256}) == 4,
                 "distinct training, component, aggregate review and attempt close evidence required")
        train_ids, runtime_scope, worker_pin, job_pin = _compact_terminal_identity(
            terminal, selection=selection, report=report, checkpoint_sha256=assessment.checkpoint_sha256,
            split_sha256=design.global_split_sha256)
        _require(not set(rows).intersection(train_ids)
                 and scopes.setdefault(attempt.seed, (train_ids, runtime_scope)) == (train_ids, runtime_scope),
                 "matched compact arms must retain the same ordered TRAIN cohort, runtime and budgets")
        for key, values in {
                "checkpoint": (assessment.checkpoint_sha256,), "worker": (worker_pin,), "job": (job_pin,),
                "artifact": (component["artifact_sha256"],),
                "close": (train_close, component["owner_close_sha256"], receipt.owner_close_sha256,
                          attempt.closeout_receipt_sha256)}.items():
            _require(not physical_ids[key].intersection(values), "compact physical evidence cannot be reused across attempts")
            physical_ids[key].update(values)
        selected.append({"attempt_sha256": attempt.attempt_sha256, "look": assessment.look,
            "checkpoint_sha256": assessment.checkpoint_sha256, "optimizer_steps": step,
            "selection_sha256": report["selection_sha256"], "terminal_selection_sha256": selection["terminal_selection_sha256"],
            "evaluation_receipt_sha256": assessment.evaluation_receipt_sha256, "owner_close_sha256": receipt.owner_close_sha256,
            "terminal_owner_close_sha256": train_close, "component_owner_close_sha256": component["owner_close_sha256"],
            "meter_record_sha256": assessment.meter.record_sha256})
    return tuple(selected)


def compare_verified_compact_development_contrasts(validator, *, study, expected_study_sha256, attempts,
        expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256, cost_evidence,
        expected_cost_evidence_sha256, verify_cost_owner, development_design, expected_development_design_sha256,
        step_grid, expected_step_grid_sha256, development_receipts, expected_development_receipts_sha256,
        terminal_cells, expected_terminal_cells_sha256, verify_development_owner,
        activation_diagnostic_charges=None, expected_activation_diagnostic_charges_sha256=None,
        include_confirmation_cost_bounds=False):
    """Compare the paid, source-only compact development attempts at one terminal step.

    The development owner independently resolves the selected physical
    attempt, source, split, review evidence and matched training controls.
    Existing cost replay authenticates actual cumulative paid work. Unscored
    attempts remain in that roster. This schema has no legacy final authority.
    A selected activation roster is verified by the same first-use cost owner.
    """
    _study(validator, study, expected_study_sha256)
    _require(study.cost_basis == "first_use" and len(study.schedule) == 1
             and _pin(expected_step_grid_sha256) and callable(verify_development_owner),
             "compact terminal comparison requires one registered first-use look and an independent owner")
    expected = tuple((seed.identifier, *arm) for seed in study.seeds for arm in study.arms)
    _require(type(attempts) is tuple and len(attempts) == len(expected)
             and all(type(attempt) is Attempt and attempt.study_sha256 == expected_study_sha256
                     and (attempt.seed, attempt.arm, attempt.recipe_sha256) == cell
                     and _pin(attempt.attempt_sha256) and _pin(attempt.closeout_receipt_sha256)
                     and type(attempt.assessments) is tuple and len(attempt.assessments) <= 1
                     and all(type(look) is Assessment and type(look.meter) is Meter for look in attempt.assessments)
                     for attempt, cell in zip(attempts, expected, strict=True))
             and len({attempt.attempt_sha256 for attempt in attempts}) == len(attempts)
             and len({attempt.closeout_receipt_sha256 for attempt in attempts}) == len(attempts),
             "exact complete matched compact attempt roster required, including unscored failures")

    def current():
        _require(commitment(study) == expected_study_sha256 and commitment(attempts) == expected_attempts_sha256
                 and development_design_commitment(development_design) == expected_development_design_sha256
                 and development_design.study_sha256 == expected_study_sha256
                 and tuple(label for label, _, _ in development_design.seed_cohorts)
                     == tuple(seed.identifier for seed in study.seeds)
                 and development_receipts_commitment(development_receipts, design_sha256=expected_development_design_sha256,
                                                      attempts_sha256=expected_attempts_sha256)
                     == expected_development_receipts_sha256
                 and compact_development_cells_commitment(terminal_cells, design_sha256=expected_development_design_sha256,
                                                          attempts_sha256=expected_attempts_sha256)
                     == expected_terminal_cells_sha256,
                 "selected compact study, development design, receipts or terminal cells changed")
        _selected_development_grid(study, expected_study_sha256, expected_development_design_sha256,
                                   step_grid, expected_step_grid_sha256)
        _fixed_stage_activation_selection(study, activation_diagnostic_charges,
                                          expected_activation_diagnostic_charges_sha256)

    current()
    selected = _compact_development_roster(validator, study, attempts, development_design, step_grid,
                                           development_receipts, terminal_cells)
    expected_cost_closes = {(row["attempt_sha256"], row["look"]):
                             (row["terminal_owner_close_sha256"], row["component_owner_close_sha256"])
                             for row in selected}
    _require(type(cost_evidence) is CostEvidence and commitment(cost_evidence) == expected_cost_evidence_sha256,
             "exact private compact cost evidence required")
    events = _event_roster(cost_evidence.events)
    completed_training = {event.close_receipt_sha256 for event in events.values()
                          if event.kind == "training" and event.disposition == "complete"}
    completed_evaluation = {event.close_receipt_sha256 for event in events.values()
                            if event.kind == "evaluation" and event.disposition == "complete"}
    _require(all(train in completed_training and evaluation in completed_evaluation
                 for train, evaluation in expected_cost_closes.values()),
             "every scored compact look must charge its completed training and evaluation closes")
    expected_attempt_closes = {attempt.attempt_sha256: attempt.closeout_receipt_sha256 for attempt in attempts}
    if activation_diagnostic_charges is not None:
        other_receipts = set(expected_attempt_closes.values())
        other_receipts.update(row[key] for row in selected for key in (
            "terminal_owner_close_sha256", "component_owner_close_sha256", "owner_close_sha256",
            "evaluation_receipt_sha256"))
        _require(other_receipts.isdisjoint(row.owner_close_sha256 for row in activation_diagnostic_charges)
                 and expected_activation_diagnostic_charges_sha256 not in other_receipts,
                 "compact diagnostic costs cannot replace training, evaluation, review or attempt evidence")
    paid_terminal_closes = {}
    for interval, charges in cost_evidence.observations:
        if type(interval) is not MeterInterval or type(charges) is not ChargeManifest:
            raise ValueError("typed compact meter intervals and charge manifests required")
        if interval.stage == "close":
            _require(interval.attempt_sha256 in expected_attempt_closes
                     and interval.attempt_sha256 not in paid_terminal_closes,
                     "one terminal charge ledger for each physical compact attempt required")
            closed = expected_attempt_closes[interval.attempt_sha256]
            _require(any(event_id in events and events[event_id].kind == "closeout"
                         and events[event_id].close_receipt_sha256 == closed for event_id, _ in charges.entries),
                     "compact terminal ledger must charge the exact attempt close, including unscored failures")
            paid_terminal_closes[interval.attempt_sha256] = closed
    _require(paid_terminal_closes == expected_attempt_closes, "compact paid terminal close roster is incomplete")
    _require(verify_development_owner(expected_development_design_sha256, expected_development_receipts_sha256,
                                      expected_step_grid_sha256, expected_terminal_cells_sha256) is True,
             "independent owner refused compact development selection, receipts or physical terminal cells")
    current()
    report = _compare_verified_contrasts(validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        retrospective_look_closes=expected_cost_closes, exclusive_non_teacher_work=True,
        activation_diagnostic_charges=activation_diagnostic_charges,
        expected_activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
        include_confirmation_cost_bounds=include_confirmation_cost_bounds)
    current()
    return {**report, "schema": VERIFIED_COMPACT_DEVELOPMENT_SCHEMA,
            "development_design_sha256": expected_development_design_sha256,
            "development_receipts_sha256": expected_development_receipts_sha256,
            "optimizer_step_grid_sha256": expected_step_grid_sha256, "optimizer_step_schedule": step_grid.steps,
            "terminal_cells_sha256": expected_terminal_cells_sha256, "development_looks": selected}


FINAL_PLAN_SCHEMA = "reviewed-final-checkpoint-plan/v1"
FINAL_CHECKPOINT_SCHEMA = "reviewed-frozen-final-checkpoint/v1"


@dataclass(frozen=True)
class FinalCheckpointPlan:
    study_sha256: str
    development_design_sha256: str
    arm: str
    seed: str
    clock: str
    final_policy_sha256: str


def final_checkpoint_plan_commitment(plan):
    _require(type(plan) is FinalCheckpointPlan and all(_pin(value) for value in (
        plan.study_sha256, plan.development_design_sha256, plan.final_policy_sha256))
        and _name(plan.arm) and _name(plan.seed) and plan.clock in COVERED_CLOCKS,
        "predeclared study cell, final policy and limiting clock required")
    return commitment((FINAL_PLAN_SCHEMA, plan))


def _one_final_row(rows, predicate, message):
    _require(type(rows) in (list, tuple) and all(type(row) is dict for row in rows), message)
    selected = tuple(row for row in rows if predicate(row))
    _require(len(selected) == 1, message)
    return selected[0]


def _confirming_grid_metadata(comparison, report, matched, *, study, design_sha, look):
    grid_sha = comparison.get("optimizer_step_grid_sha256")
    schedule = comparison.get("optimizer_step_schedule")
    fields = ("optimizer_step_grid_sha256", "optimizer_step_schedule")
    scheduled_checkpoint = _scheduled_checkpoint_metadata(report)
    matched_checkpoint = _scheduled_checkpoint_metadata(matched)
    approval = _capture_approval_metadata(comparison)
    archived = _archived_capture_metadata(report)
    _require(bool(approval) == (archived is not None)
             and archived == _archived_capture_metadata(matched)
             and (not approval or report.get("schema") == RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA),
             "final freeze must retain the exact approved matched capture from the confirming look")
    if not any(key in comparison for key in fields):
        _require(report.get("schema") == NATIVE_DEVELOPMENT_LOOK_SCHEMA
                 and not any(key in report for key in ("optimizer_step_grid_sha256", "optimizer_steps"))
                 and "optimizer_steps" not in matched and scheduled_checkpoint is None and matched_checkpoint is None,
                 "scheduled confirmation cannot be frozen without its selected optimizer-step grid")
        return {}
    _require(type(schedule) in (tuple, list)
             and all(type(row) in (tuple, list) and len(row) == 2 for row in schedule),
             "exact verified optimizer-step grid required at final freeze")
    grid = DevelopmentStepGrid(commitment(study), design_sha, tuple(tuple(row) for row in schedule))
    _selected_development_grid(study, grid.study_sha256, design_sha, grid, grid_sha)
    step = dict(grid.steps)[look]
    retrospective = report.get("schema") == RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA
    _require((retrospective and study.stop_after_confirmation is False and scheduled_checkpoint is not None
              and scheduled_checkpoint == matched_checkpoint)
             or (not retrospective and report.get("schema") == SCHEDULED_NATIVE_DEVELOPMENT_LOOK_SCHEMA
                 and scheduled_checkpoint is None and matched_checkpoint is None),
             "final freeze must bind its original retrospective checkpoint readback or legacy look")
    _require(report.get("optimizer_step_grid_sha256") == grid_sha
             and type(report.get("optimizer_steps")) is int and type(matched.get("optimizer_steps")) is int
             and report["optimizer_steps"] == matched["optimizer_steps"] == step,
             "final freeze must use the exact confirming optimizer step from the selected grid")
    evidence = {"optimizer_step_grid_sha256": grid_sha, "optimizer_steps": step}
    if retrospective:
        evidence["scheduled_checkpoint"] = dict(scheduled_checkpoint)
    if approval:
        evidence.update(approval)
        evidence["archived_capture"] = dict(archived)
    return evidence


def freeze_final_checkpoint(validator, *, study, development_design, plan, expected_plan_sha256,
                            comparison, expected_comparison_sha256, development_receipt, verify_final_owner):
    """Freeze the eligible checkpoint for one preregistered cell before final scoring."""
    _require(_pin(expected_plan_sha256) and _pin(expected_comparison_sha256) and callable(verify_final_owner)
             and type(development_receipt) is DevelopmentReceipt
             and type(development_receipt.report) is dict and _pin(development_receipt.owner_close_sha256)
             and final_checkpoint_plan_commitment(plan) == expected_plan_sha256,
             "independently selected final plan and closed development receipt required")
    _, horizons, _ = _study(validator, study, plan.study_sha256)
    recipes = dict(study.arms)
    _require(plan.arm in recipes and plan.seed in {seed.identifier for seed in study.seeds}
             and horizons[plan.clock] is not None and "final" not in study.schedule
             and development_design_commitment(development_design) == plan.development_design_sha256
             and development_design.study_sha256 == plan.study_sha256
             and tuple(label for label, _, _ in development_design.seed_cohorts)
                 == tuple(seed.identifier for seed in study.seeds),
             "final plan differs from the selected study, seed, design or analysis horizon")
    _require(type(comparison) is dict and commitment(comparison) == expected_comparison_sha256
             and comparison.get("schema") == VERIFIED_DEVELOPMENT_SCHEMA
             and comparison.get("study_sha256") == plan.study_sha256
             and comparison.get("development_design_sha256") == plan.development_design_sha256
             and all(_pin(comparison.get(key)) for key in ("attempts_sha256", "development_receipts_sha256",
                                                           "contrast_plan_sha256", "cost_evidence_sha256")),
             "exact verified development comparison required")

    attempt = _one_final_row(comparison.get("attempts"),
        lambda row: (row.get("arm"), row.get("seed")) == (plan.arm, plan.seed),
        "one verified physical attempt required for the preregistered final cell")
    decision = attempt.get("decision")
    _require(type(decision) is dict and decision.get("status") == "reached"
             and "confirmation_budget_block" in attempt and attempt["confirmation_budget_block"] is None
             and decision.get("confirming_checkpoint") in study.schedule
             and _pin(attempt.get("attempt_sha256")) and _pin(attempt.get("closeout_receipt_sha256")),
             "final cell requires an eligible closed development confirmation")
    look_label = decision["confirming_checkpoint"]
    look = _one_final_row(attempt.get("look_evidence"), lambda row: row.get("look") == look_label,
                         "exact confirming look evidence required")
    matched = _one_final_row(comparison.get("development_looks"),
        lambda row: (row.get("attempt_sha256"), row.get("look")) == (attempt["attempt_sha256"], look_label),
        "exact native development close required at the confirming look")
    clock_evidence = attempt.get("cost_evidence")
    meters = clock_evidence.get("looks") if type(clock_evidence) is dict else None
    meter_row = _one_final_row(meters, lambda row: row.get("look") == look_label,
                              "exact paid meter required at the confirming look")
    meter = meter_row.get("meter")
    costs = decision.get("confirming_costs")
    measured = costs.get(plan.clock) if type(costs) is dict else None
    _require(type(meter) is dict and meter.get("stage") == look_label
             and meter.get("attempt_sha256") == attempt["attempt_sha256"]
             and meter.get("record_sha256") == look.get("meter_record_sha256") == matched.get("meter_record_sha256")
             and all(_pin(meter.get(key)) for key in ("record_sha256", "charge_manifest_sha256", "interval_manifest_sha256"))
             and commitment(meter.get("costs")) == commitment(costs)
             and type(measured) is float and isfinite(measured) and 0 <= measured <= horizons[plan.clock],
             "confirming cost is unavailable or outside the selected measured horizon")

    report = development_receipt.report
    identity = report.get("native_identity")
    armed = report.get("armed_attempt")
    seed, cohort = next((number, cohort) for label, number, cohort in development_design.seed_cohorts
                        if label == plan.seed)
    split = report.get("development_split")
    _require(type(split) is dict and split.get("role") == "development"
             and _pin(split.get("selection_sha256"))
             and (split.get("global_split_sha256"), split.get("population_sha256"), split.get("train_cohort_sha256"))
                 == (development_design.global_split_sha256, development_design.population_sha256, cohort)
             and type(split.get("reserved_final_count")) is int
             and split["reserved_final_count"] == development_design.reserved_final_count
             and commitment(split.get("case_aliases")) == development_design.case_aliases_sha256
             and report.get("evaluation_policy_sha256") == study.evaluation_policy_sha256,
             "confirming look must retain its exact registered development split, policy and cohort")
    step_evidence = _confirming_grid_metadata(comparison, report, matched, study=study,
                                             design_sha=plan.development_design_sha256, look=look_label)
    _require(commitment(report) == look.get("evaluation_receipt_sha256") == matched.get("evaluation_receipt_sha256")
             and (report.get("study_sha256"), report.get("arm"), report.get("seed")) == (plan.study_sha256, plan.arm, plan.seed)
             and development_receipt.owner_close_sha256 == matched.get("owner_close_sha256")
             and type(identity) is dict and type(identity.get("seed")) is int and identity["seed"] == seed
             and (identity.get("attempt_sha256"), identity.get("look"), identity.get("candidate_sha256"))
                 == (attempt["attempt_sha256"], look_label, look.get("checkpoint_sha256"))
             and _pin(identity.get("candidate_sha256")) and identity["candidate_sha256"] == matched.get("checkpoint_sha256")
             and _pin(identity.get("trial_terminal_close_sha256"))
             and identity["trial_terminal_close_sha256"] == matched.get("trial_terminal_close_sha256")
             and identity.get("arm") in ("supervised", "tap_only", "relational")
             and type(armed) is dict and armed.get("recipe_sha256") == recipes[plan.arm]
             and armed.get("admission_version") == "v3"
             and armed.get("route") in ("qwen2-digest-omitted-source-only/v1", "t5-full-target-source-only/v1")
             and all(_pin(armed.get(key)) for key in ("selection_sha256", "packet_sha256", "trial_sha256")),
             "confirming candidate, armed trial or development close differs from the verified look")
    selected = {"schema": FINAL_CHECKPOINT_SCHEMA, "plan_sha256": expected_plan_sha256,
                "study_sha256": plan.study_sha256, "development_comparison_sha256": expected_comparison_sha256,
                "development_design_sha256": plan.development_design_sha256,
                "development_split_sha256": split["selection_sha256"],
                "development_policy_sha256": study.evaluation_policy_sha256, "train_cohort_sha256": cohort,
                "global_split_sha256": development_design.global_split_sha256,
                "population_sha256": development_design.population_sha256,
                "reserved_final_count": development_design.reserved_final_count, "final_policy_sha256": plan.final_policy_sha256,
                "arm": plan.arm, "seed": plan.seed, "native_arm": identity["arm"], "native_seed": seed,
                "attempt_sha256": attempt["attempt_sha256"], "recipe_sha256": recipes[plan.arm],
                "route": armed["route"], "armed_attempt_sha256": armed["selection_sha256"],
                "packet_sha256": armed["packet_sha256"], "trial_sha256": armed["trial_sha256"],
                "confirming_look": look_label, "candidate_sha256": identity["candidate_sha256"],
                "development_evaluation_sha256": look["evaluation_receipt_sha256"],
                "development_owner_close_sha256": development_receipt.owner_close_sha256,
                "trial_terminal_close_sha256": identity["trial_terminal_close_sha256"],
                "development_meter_sha256": meter["record_sha256"], "clock": plan.clock, "elapsed": measured,
                **step_evidence, **_activation_charge_metadata(comparison)}
    receipt_pin = commitment(development_receipt)
    _require(verify_final_owner(expected_plan_sha256, expected_comparison_sha256, receipt_pin) is True
             and final_checkpoint_plan_commitment(plan) == expected_plan_sha256
             and commitment(study) == selected["study_sha256"]
             and development_design_commitment(development_design) == selected["development_design_sha256"]
             and commitment(comparison) == expected_comparison_sha256 and commitment(development_receipt) == receipt_pin,
             "final selection owner refused or selected development evidence changed")
    return selected


COMPACT_FINAL_CHECKPOINT_SCHEMA = "reviewed-frozen-compact-final-checkpoint/v1"


def freeze_compact_final_checkpoint(validator, *, study, development_design, step_grid,
                                    plan, expected_plan_sha256, comparison, expected_comparison_sha256,
                                    development_receipt, terminal_cell, verify_final_owner):
    """Freeze the preregistered compact cell before any final evaluation.

    The independent owner authenticates the final plan's preregistration,
    the verified comparison (including its paid work and original split),
    and the selected development receipt and terminal cell. This operation
    reads no final cases and issues no permission to access them.
    """
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and callable(verify_final_owner)
             and _pin(expected_plan_sha256) and _pin(expected_comparison_sha256)
             and final_checkpoint_plan_commitment(plan) == expected_plan_sha256
             and type(development_receipt) is DevelopmentReceipt
             and type(development_receipt.report) is dict and _pin(development_receipt.owner_close_sha256)
             and type(terminal_cell) is tuple and len(terminal_cell) == 2
             and all(type(item) is dict for item in terminal_cell),
             "independent final plan, closed development receipt and compact terminal cell required")
    _, horizons, _ = _study(validator, study, plan.study_sha256)
    recipes = dict(study.arms)
    seeds = {seed.identifier: seed for seed in study.seeds}
    _require(plan.arm in recipes and plan.seed in seeds and horizons[plan.clock] is not None
             and study.cost_basis == "first_use" and len(study.schedule) == 1
             and len({row[1] for row in study.panel}) == 1
             and development_design_commitment(development_design) == plan.development_design_sha256
             and development_design.study_sha256 == plan.study_sha256
             and tuple(label for label, _, _ in development_design.seed_cohorts) == tuple(seeds),
             "compact final plan differs from the original first-use study, seed, design or horizon")
    _require(type(comparison) is dict and commitment(comparison) == expected_comparison_sha256
             and comparison.get("schema") == VERIFIED_COMPACT_DEVELOPMENT_SCHEMA
             and comparison.get("study_sha256") == plan.study_sha256
             and comparison.get("development_design_sha256") == plan.development_design_sha256
             and comparison.get("panel_sha256") == commitment(study.panel)
             and comparison.get("cost_basis") == study.cost_basis and comparison.get("reuse_count") is None
             and all(_pin(comparison.get(key)) for key in (
                 "attempts_sha256", "development_receipts_sha256", "contrast_plan_sha256",
                 "cost_evidence_sha256", "terminal_cells_sha256", "optimizer_step_grid_sha256")),
             "exact verified compact development comparison required")
    grid_sha = comparison["optimizer_step_grid_sha256"]
    _selected_development_grid(study, plan.study_sha256, plan.development_design_sha256, step_grid, grid_sha)
    _require(commitment(comparison.get("optimizer_step_schedule")) == commitment(step_grid.steps),
             "compact comparison must retain the exact preregistered terminal grid")
    (look_label, step), = step_grid.steps
    attempt = _one_final_row(comparison.get("attempts"),
        lambda row: (row.get("arm"), row.get("seed")) == (plan.arm, plan.seed),
        "one verified compact physical attempt required for the preregistered final cell")
    decision = attempt.get("decision")
    _require(type(decision) is dict and decision.get("status") == "reached"
             and decision.get("confirming_checkpoint") == look_label
             and "confirmation_budget_block" in attempt and attempt["confirmation_budget_block"] is None
             and _pin(attempt.get("attempt_sha256")) and _pin(attempt.get("closeout_receipt_sha256")),
             "compact final cell requires an eligible closed development confirmation")
    attempt_sha = attempt["attempt_sha256"]
    look = _one_final_row(attempt.get("look_evidence"), lambda row: row.get("look") == look_label,
                         "exact confirming compact look evidence required")
    matched = _one_final_row(comparison.get("development_looks"),
        lambda row: (row.get("attempt_sha256"), row.get("look")) == (attempt_sha, look_label),
        "exact confirming compact development close required")
    cost_evidence = attempt.get("cost_evidence")
    meter_row = _one_final_row(cost_evidence.get("looks") if type(cost_evidence) is dict else None,
                             lambda row: row.get("look") == look_label,
                             "exact paid meter required for the confirming compact look")
    meter = meter_row.get("meter")
    _require(type(meter) is dict and set(meter) == set(Meter.__dataclass_fields__)
             and type(meter["clock_receipts"]) in (list, tuple)
             and type(meter["costs"]) is dict and set(meter["costs"]) == set(COVERED_CLOCKS)
             and meter["record_sha256"] == look.get("meter_record_sha256") == matched.get("meter_record_sha256"),
             "exact confirming compact meter record and clock evidence required")
    typed_meter = Meter(**{**meter, "costs": validator.Costs(**meter["costs"]),
                          "clock_receipts": tuple(meter["clock_receipts"])})
    _meter_costs(validator, typed_meter, attempt_sha256=attempt_sha, cost_policy_sha256=study.cost_policy_sha256,
                 stage=look_label, scope=CUMULATIVE_ARM)
    measured = meter["costs"][plan.clock]
    _require(commitment(meter["costs"]) == commitment(decision.get("confirming_costs"))
             and measured is not None and measured <= horizons[plan.clock],
             "confirming compact cost is unavailable or outside the selected measured horizon")

    selection, terminal = terminal_cell
    report = development_receipt.report
    checkpoint_sha = look.get("checkpoint_sha256")
    evaluation_sha = commitment(report)
    _require(report.get("schema") == COMPACT_DEVELOPMENT_LOOK_SCHEMA
             and _pin(checkpoint_sha) and checkpoint_sha == report.get("checkpoint_sha256") == matched.get("checkpoint_sha256")
             and evaluation_sha == look.get("evaluation_receipt_sha256") == matched.get("evaluation_receipt_sha256")
             and development_receipt.owner_close_sha256 == matched.get("owner_close_sha256")
             and type(report.get("optimizer_steps")) is int and type(matched.get("optimizer_steps")) is int
             and report["optimizer_steps"] == matched["optimizer_steps"] == step
             and all(report.get(key) == value for key, value in {
                 "panel_sha256": comparison["panel_sha256"],
                 "evaluation_policy_sha256": study.evaluation_policy_sha256,
                 "retention_reference_sha256": seeds[plan.seed].retention_reference_sha256,
                 "split_manifest_sha256": development_design.global_split_sha256,
                 "dependency_group_sha256": study.panel[0][1],
             }.items())
             and type(report.get("reserved_final_count")) is int
             and report["reserved_final_count"] == development_design.reserved_final_count
             and commitment(report.get("counts")) == commitment(look.get("gate_counts"))
             and _pin(report.get("review_sha256")),
             "exact reviewed compact development receipt, reservation and optimizer step required")
    _require(all(selection.get(key) == value == report.get(key) for key, value in {
                 "study_sha256": plan.study_sha256, "development_design_sha256": plan.development_design_sha256,
                 "optimizer_step_grid_sha256": grid_sha, "arm": plan.arm, "seed": plan.seed,
                 "recipe_sha256": recipes[plan.arm], "attempt_sha256": attempt_sha, "look": look_label,
             }.items())
             and commitment((COMPACT_DEVELOPMENT_LOOK_SCHEMA, "selection", selection))
                 == report.get("selection_sha256") == matched.get("selection_sha256")
             and commitment(terminal) == selection.get("terminal_selection_sha256") == matched.get("terminal_selection_sha256")
             and _pin(selection.get("inputs_sha256")),
             "confirming compact cell differs from the selected recipe, look or terminal pair")
    component = report.get("component_close")
    train_close = report.get("terminal_owner_close_sha256")
    _require(type(component) is dict
             and set(component) == {"observation_sha256", "artifact_sha256", "owner_close_sha256"}
             and all(_pin(value) for value in component.values())
             and component["artifact_sha256"] == selection.get("artifact_sha256")
             and component["owner_close_sha256"] == matched.get("component_owner_close_sha256")
             and _pin(train_close) and train_close == selection.get("terminal_owner_close_sha256")
                 == matched.get("terminal_owner_close_sha256")
             and len({train_close, component["owner_close_sha256"], development_receipt.owner_close_sha256,
                      attempt["closeout_receipt_sha256"]}) == 4,
             "distinct compact training, component, review and attempt closes required")
    _compact_terminal_identity(terminal, selection=selection, report=report, checkpoint_sha256=checkpoint_sha,
                               split_sha256=development_design.global_split_sha256)
    receipt_sha = commitment(development_receipt)
    cell_sha = commitment(terminal_cell)
    _require(verify_final_owner(expected_plan_sha256, expected_comparison_sha256, receipt_sha, cell_sha) is True
             and final_checkpoint_plan_commitment(plan) == expected_plan_sha256
             and commitment(study) == plan.study_sha256
             and development_design_commitment(development_design) == plan.development_design_sha256
             and development_step_grid_commitment(step_grid) == grid_sha
             and commitment(comparison) == expected_comparison_sha256
             and commitment(development_receipt) == receipt_sha and commitment(terminal_cell) == cell_sha,
             "final selection owner refused or selected compact development evidence changed")
    binding = terminal["binding"]
    train_cohort = next(cohort for label, _, cohort in development_design.seed_cohorts if label == plan.seed)
    return {
        "schema": COMPACT_FINAL_CHECKPOINT_SCHEMA, "plan_sha256": expected_plan_sha256,
        "study_sha256": plan.study_sha256, "development_design_sha256": plan.development_design_sha256,
        "development_comparison_sha256": expected_comparison_sha256, "development_receipt_sha256": receipt_sha,
        "global_split_sha256": development_design.global_split_sha256,
        "population_sha256": development_design.population_sha256, "train_cohort_sha256": train_cohort,
        "reserved_final_count": development_design.reserved_final_count, "final_policy_sha256": plan.final_policy_sha256,
        "arm": plan.arm, "seed": plan.seed, "recipe_sha256": recipes[plan.arm], "attempt_sha256": attempt_sha,
        "attempt_closeout_sha256": attempt["closeout_receipt_sha256"], "confirming_look": look_label,
        "optimizer_step_grid_sha256": grid_sha, "optimizer_steps": step, "candidate_sha256": checkpoint_sha,
        "terminal_cell_sha256": cell_sha, "terminal_selection_sha256": selection["terminal_selection_sha256"],
        "terminal_pair": {name: dict(binding[name]) for name in (
            "terminal_manifest", "worker_receipt", "model_checkpoint", "optimizer_checkpoint")},
        "development_evaluation_sha256": evaluation_sha, "development_owner_close_sha256": development_receipt.owner_close_sha256,
        "training_owner_close_sha256": train_close, "component_owner_close_sha256": component["owner_close_sha256"],
        "development_meter_sha256": typed_meter.record_sha256, "cost_evidence_sha256": comparison["cost_evidence_sha256"],
        "development_interval_sha256": typed_meter.interval_manifest_sha256,
        "development_charge_manifest_sha256": typed_meter.charge_manifest_sha256,
        "clock_receipt_sha256": typed_meter.clock_receipts[COVERED_CLOCKS.index(plan.clock)], "clock": plan.clock,
        "elapsed": measured, "horizon": horizons[plan.clock],
        **_activation_charge_metadata(comparison),
    }


FINAL_RESOURCE_PLAN_SCHEMA = "reviewed-final-evaluation-resource-plan/v1"
FINAL_RESOURCE_EVIDENCE_SCHEMA = "reviewed-final-evaluation-resource-evidence/v1"
FINAL_RESOURCE_RESULT_SCHEMA = "verified-final-evaluation-resources/v1"
FINAL_RESOURCE_SCOPE = "whole-final-evaluation-through-terminal-close/v1"
FINAL_PANEL_REPORT_SCHEMA = "reviewed-relational-final-panel-report/v1"
COMPACT_FINAL_PANEL_REPORT_SCHEMA = "reviewed-compact-final-panel-report/v1"
COMPACT_FINAL_RESOURCE_RESULT_SCHEMA = "verified-compact-final-evaluation-resources/v1"


@dataclass(frozen=True)
class FinalActivity:
    evaluation_sha256: str
    role: str
    frozen_checkpoint_sha256: str
    checkpoint_sha256: str


@dataclass(frozen=True)
class FinalResourcePlan:
    study_sha256: str
    candidate_freeze_sha256: str
    development_comparison_sha256: str
    final_panel_sha256: str
    final_policy_sha256: str
    final_retention_selection_sha256: str
    cost_policy_sha256: str
    activities: tuple[FinalActivity, ...]
    shared_event_consumers: int | None = None


@dataclass(frozen=True)
class FinalTerminal:
    evaluation_sha256: str
    terminal_close_sha256: str
    status: str
    component_owner_close_sha256s: tuple[str, ...]
    report: dict | None
    baseline_receipt_sha256: str | None = None


@dataclass(frozen=True)
class FinalResourceEvidence:
    plan_sha256: str
    events: tuple[PaidEvent, ...]
    closes: tuple[tuple[FinalTerminal, Meter, MeterInterval, ChargeManifest], ...]


def final_resource_plan_commitment(plan):
    _require(type(plan) is FinalResourcePlan and all(_pin(value) for value in (
        plan.study_sha256, plan.candidate_freeze_sha256, plan.development_comparison_sha256, plan.final_panel_sha256,
        plan.final_policy_sha256, plan.final_retention_selection_sha256, plan.cost_policy_sha256))
        and type(plan.activities) is tuple and bool(plan.activities)
        and all(type(activity) is FinalActivity and activity.role in ("candidate", "baseline")
                and all(_pin(value) for value in (activity.evaluation_sha256,
                        activity.frozen_checkpoint_sha256, activity.checkpoint_sha256)) for activity in plan.activities)
        and len({activity.evaluation_sha256 for activity in plan.activities}) == len(plan.activities)
        and any(activity.role == "candidate" for activity in plan.activities)
        and (plan.shared_event_consumers is None or type(plan.shared_event_consumers) is int
             and 2 <= plan.shared_event_consumers <= len(plan.activities)),
        "exact final activities, policies and selected event reuse required")
    return commitment((FINAL_RESOURCE_PLAN_SCHEMA, plan))


def final_resource_subject(plan_sha256, activity, terminal):
    """Bind existing interval records to a final activity's exact terminal evidence."""
    return commitment((FINAL_RESOURCE_EVIDENCE_SCHEMA, plan_sha256, activity, terminal))


def _check_final_terminal_header(activity, terminal):
    _require(type(terminal) is FinalTerminal and terminal.evaluation_sha256 == activity.evaluation_sha256
             and _pin(terminal.terminal_close_sha256)
             and type(terminal.status) is str and terminal.status in CLOSED_EVENT_OUTCOMES
             and type(terminal.component_owner_close_sha256s) is tuple
             and all(_pin(value) for value in terminal.component_owner_close_sha256s)
             and len(set(terminal.component_owner_close_sha256s)) == len(terminal.component_owner_close_sha256s),
             "exact physical terminal close and recorded final component closures required")


def _final_report_binding(plan, activity, terminal, frozen_checkpoint, *, compact=False):
    _check_final_terminal_header(activity, terminal)
    report = terminal.report
    if terminal.status != "complete":
        _require(report is None and terminal.baseline_receipt_sha256 is None,
                 "unsuccessful final closure cannot supply a completed panel report or baseline result")
        return None
    if activity.role == "baseline":
        _require(report is None and _pin(terminal.baseline_receipt_sha256)
                 and bool(terminal.component_owner_close_sha256s),
                 "complete baseline close requires its independent baseline receipt and component closures")
        return None
    schema = COMPACT_FINAL_PANEL_REPORT_SCHEMA if compact else FINAL_PANEL_REPORT_SCHEMA
    _require(type(report) is dict and report.get("schema") == schema
             and (report.get("study_sha256"), report.get("final_panel_sha256"), report.get("final_policy_sha256"))
                 == (plan.study_sha256, plan.final_panel_sha256, plan.final_policy_sha256)
             and (report.get("final_evaluation_sha256"), report.get("final_terminal_close_sha256"),
                  report.get("frozen_checkpoint_sha256"), report.get("checkpoint_sha256"))
                 == (activity.evaluation_sha256, terminal.terminal_close_sha256,
                     activity.frozen_checkpoint_sha256, activity.checkpoint_sha256)
             and _pin(report.get("review_sha256"))
             and terminal.baseline_receipt_sha256 is None
             and report.get("trained_attempt_sha256") == frozen_checkpoint["attempt_sha256"]
             and report.get("retention_selection_sha256") == plan.final_retention_selection_sha256,
             "complete candidate close must bind its exact panel report and frozen checkpoint")
    if compact:
        _require(report.get("evidence_kind") in ("fictional_fixture", "native_reviewed")
                 and all(_pin(report.get(field)) for field in ("final_scoring_sha256", "dependency_group_sha256",
                                                               "reservation_close_sha256"))
                 and type(report.get("optimizer_steps")) is int and report["optimizer_steps"] > 0
                 and all(report.get(field) == frozen_checkpoint.get(field) for field in (
                     "terminal_selection_sha256", "optimizer_step_grid_sha256", "optimizer_steps"))
                 and report.get("split_manifest_sha256") == frozen_checkpoint.get("global_split_sha256")
                 and type(report.get("rows")) in (list, tuple)
                 and len(report["rows"]) == frozen_checkpoint.get("reserved_final_count")
                 and len(terminal.component_owner_close_sha256s) == 1,
                 "paid compact final report must retain the exact frozen pair, step and complete reserved component")
    else:
        _require(_pin(report.get("matched_pair_sha256")),
                 "complete candidate close must bind its exact panel report and frozen checkpoint")
        checkpoint = _scheduled_checkpoint_metadata(frozen_checkpoint)
        _require(_scheduled_checkpoint_metadata(report) == checkpoint
                 and (checkpoint is None or report.get("optimizer_step_grid_sha256") == frozen_checkpoint.get("optimizer_step_grid_sha256")
                      and type(report.get("optimizer_steps")) is int
                      and report["optimizer_steps"] == frozen_checkpoint.get("optimizer_steps")),
                 "paid final report must retain the exact frozen scheduled checkpoint and step")
        archived = _archived_capture_metadata(frozen_checkpoint)
        _require(bool(_capture_approval_metadata(frozen_checkpoint)) == (archived is not None)
                 and _archived_capture_metadata(report) == archived
                 and (archived is None or checkpoint is not None),
                 "paid final report must retain the exact approved matched capture from the frozen checkpoint")
    closes = report.get("component_closes")
    _require(type(closes) in (tuple, list) and bool(closes)
             and all(type(close) is dict and all(_pin(close.get(key)) for key in (
                     "observation_sha256", "artifact_sha256", "owner_close_sha256")) for close in closes)
             and tuple(close["owner_close_sha256"] for close in closes) == terminal.component_owner_close_sha256s,
             "completed final cost must retain every reported component close in order")
    return commitment(report)


def _check_compact_development_activation(comparison, attempts, events, looks):
    metadata = _activation_charge_metadata(comparison)
    if not metadata:
        _require("activation_diagnostic_charges" not in comparison,
                 "compact diagnostic roster requires its selected commitment")
        return ()
    rows = comparison.get("activation_diagnostic_charges")
    _require(type(rows) in (tuple, list)
             and all(type(row) is dict and set(row) == set(ActivationDiagnosticCharge.__dataclass_fields__) for row in rows),
             "exact serialized compact activation roster required")
    typed = tuple(ActivationDiagnosticCharge(**row) for row in rows)
    _require(activation_diagnostic_charges_commitment(typed) == metadata["activation_diagnostic_charges_sha256"],
             "compact activation roster differs from its original commitment")
    checkpoints = {row["attempt_sha256"]: {} for row in attempts}
    other_receipts = {row["closeout_receipt_sha256"] for row in attempts}
    for look in looks:
        attempt_id = look.get("attempt_sha256")
        _require(attempt_id in checkpoints and not checkpoints[attempt_id]
                 and _name(look.get("look")) and look["look"] != "close"
                 and _pin(look.get("checkpoint_sha256")),
                 "compact activation evidence requires an original observed checkpoint")
        checkpoints[attempt_id][look["look"]] = look["checkpoint_sha256"]
        other_receipts.update(look.get(key) for key in ("terminal_owner_close_sha256",
            "component_owner_close_sha256", "owner_close_sha256", "evaluation_receipt_sha256"))
    _require(other_receipts.isdisjoint(row.owner_close_sha256 for row in typed)
             and metadata["activation_diagnostic_charges_sha256"] not in other_receipts,
             "inherited activation evidence cannot replace another development receipt")
    _activation_charge_scopes_from_checkpoints(checkpoints, events, typed)
    return typed


def _compact_final_development_closes(frozen, comparison, attempts, events, looks):
    """Join the exact confirming evidence and retain every prior paid close."""
    _require(comparison.get("cost_basis") == "first_use" and comparison.get("reuse_count") is None
             and _pin(frozen.get("optimizer_step_grid_sha256"))
             and frozen["optimizer_step_grid_sha256"] == comparison.get("optimizer_step_grid_sha256")
             and _pin(frozen.get("development_design_sha256"))
             and frozen["development_design_sha256"] == comparison.get("development_design_sha256")
             and _pin(frozen.get("cost_evidence_sha256"))
             and frozen["cost_evidence_sha256"] == comparison.get("cost_evidence_sha256")
             and type(frozen.get("reserved_final_count")) is int and frozen["reserved_final_count"] > 0
             and _pin(frozen.get("global_split_sha256"))
             and all(set(event) == set(PaidEvent.__dataclass_fields__) for event in events)
             and bool(events), "complete paid compact development comparison and frozen split required")
    prior = _event_roster(tuple(PaidEvent(**event) for event in events))
    paid_closes = {event.close_receipt_sha256 for event in prior.values()}
    attempt_closes = {row["closeout_receipt_sha256"] for row in attempts}
    completed_training = {event.close_receipt_sha256 for event in prior.values()
                          if event.kind == "training" and event.disposition == "complete"}
    completed_evaluation = {event.close_receipt_sha256 for event in prior.values()
                            if event.kind == "evaluation" and event.disposition == "complete"}
    _require(len(paid_closes) == len(events) and len(attempt_closes) == len(attempts)
             and len({row["attempt_sha256"] for row in attempts}) == len(attempts)
             and attempt_closes <= {event.close_receipt_sha256 for event in prior.values() if event.kind == "closeout"}
             and {row["terminal_owner_close_sha256"] for row in looks} <= completed_training
             and {row["component_owner_close_sha256"] for row in looks} <= completed_evaluation
             and comparison.get("physical_work_ns") == _physical_work_ns(prior),
             "every compact development attempt and physical event must retain its exact paid close")
    _check_compact_development_activation(comparison, attempts, prior, looks)
    selected = _one_final_row(attempts,
        lambda row: (row.get("arm"), row.get("seed"), row.get("attempt_sha256"))
            == (frozen.get("arm"), frozen.get("seed"), frozen["attempt_sha256"]),
        "exact confirming compact development attempt required")
    label = frozen.get("confirming_look")
    matched = _one_final_row(looks,
        lambda row: (row.get("attempt_sha256"), row.get("look")) == (frozen["attempt_sha256"], label),
        "exact confirming compact development look required")
    decision = selected.get("decision")
    pins = {
        "checkpoint_sha256": "candidate_sha256", "terminal_selection_sha256": "terminal_selection_sha256",
        "evaluation_receipt_sha256": "development_evaluation_sha256", "meter_record_sha256": "development_meter_sha256",
        "owner_close_sha256": "development_owner_close_sha256",
        "terminal_owner_close_sha256": "training_owner_close_sha256",
        "component_owner_close_sha256": "component_owner_close_sha256",
    }
    _require(type(decision) is dict and decision.get("status") == "reached"
             and _name(label) and decision.get("confirming_checkpoint") == label
             and "confirmation_budget_block" in selected and selected["confirmation_budget_block"] is None
             and selected["closeout_receipt_sha256"] == frozen.get("attempt_closeout_sha256")
             and type(frozen.get("optimizer_steps")) is int and type(matched.get("optimizer_steps")) is int
             and matched["optimizer_steps"] == frozen["optimizer_steps"] > 0
             and commitment(comparison.get("optimizer_step_schedule")) == commitment(((label, frozen["optimizer_steps"]),))
             and all(_pin(matched.get(key)) and matched[key] == frozen.get(field) for key, field in pins.items()),
             "compact final resource evidence differs from the original confirming checkpoint, meter or closes")
    return paid_closes


def verify_compact_final_resource_evidence(validator, *, plan, expected_plan_sha256, frozen_checkpoint,
        development_comparison, retention_selection, retention_reference, evidence, expected_evidence_sha256,
        verify_final_resource_owner):
    """Verify final-only work for a compact freeze, including failed activity.

    The independent resource owner authenticates the original comparison and
    each physical terminal scope, including the paid mapping of component and
    baseline closes, complete charges and exclusive counters. Logical close
    records need not correspond to distinct physical events.
    """
    return _verify_final_resource_evidence(validator, plan=plan, expected_plan_sha256=expected_plan_sha256,
        frozen_checkpoint=frozen_checkpoint, development_comparison=development_comparison,
        retention_selection=retention_selection, retention_reference=retention_reference, evidence=evidence,
        expected_evidence_sha256=expected_evidence_sha256, verify_final_resource_owner=verify_final_resource_owner,
        compact=True)


def verify_final_resource_evidence(validator, *, plan, expected_plan_sha256, frozen_checkpoint, development_comparison,
                                    retention_selection, retention_reference, evidence, expected_evidence_sha256,
                                    verify_final_resource_owner):
    """Verify final-only physical closures without changing the development comparison.

    The owner resolves the evidence and authenticates the candidate report and
    complete component roster from the final-review owner, and each baseline
    receipt's link to its evaluation and close. It also authenticates partial
    work, canonical event identity, exclusive counters and completeness of charges.
    """
    return _verify_final_resource_evidence(validator, plan=plan, expected_plan_sha256=expected_plan_sha256,
        frozen_checkpoint=frozen_checkpoint, development_comparison=development_comparison,
        retention_selection=retention_selection, retention_reference=retention_reference, evidence=evidence,
        expected_evidence_sha256=expected_evidence_sha256, verify_final_resource_owner=verify_final_resource_owner,
        compact=False)


def _measure_final_activity(validator, plan, plan_pin, activity, terminal, meter, interval, charges, events,
                            report_pin, *, require_paid_terminal):
    _meter_costs(validator, meter, attempt_sha256=activity.evaluation_sha256,
                 cost_policy_sha256=plan.cost_policy_sha256, stage="close", scope=FINAL_RESOURCE_SCOPE)
    _require(type(interval) is MeterInterval and type(charges) is ChargeManifest
             and (interval.attempt_sha256, interval.stage) == (charges.attempt_sha256, charges.stage)
                 == (activity.evaluation_sha256, "close")
             and interval.subject_sha256 == final_resource_subject(plan_pin, activity, terminal)
             and _pin(interval.scope_receipt_sha256)
             and commitment(interval) == meter.interval_manifest_sha256
             and commitment(charges) == meter.charge_manifest_sha256,
             "final meter must bind the exact physical activity, terminal subject and allocation")
    shares = _event_shares(charges, events, {})
    if require_paid_terminal:
        _require(any(share == 1 and events[event_id].close_receipt_sha256 == terminal.terminal_close_sha256
                     and events[event_id].disposition == terminal.status for event_id, share in shares.items()),
                 "every compact final activity must charge its exact terminal work, including failed attempts")
    _wall_evidence(meter, interval.wall, None, "first_use")
    for seconds, nanoseconds in (("cpu_seconds", "cpu_ns"), ("gpu_seconds", "gpu_ns")):
        observed = getattr(meter.costs, seconds)
        _require(observed is None or observed == _charged_seconds(events, shares, nanoseconds),
                 "measured final additive clock differs from complete allocated event deltas")
    return shares, {"activity": _wire(activity), "status": terminal.status,
        "terminal_close_sha256": terminal.terminal_close_sha256, "report_sha256": report_pin,
        "component_owner_close_sha256s": terminal.component_owner_close_sha256s,
        "baseline_receipt_sha256": terminal.baseline_receipt_sha256,
        "meter": _wire(meter), "wall": _wire(interval.wall), "charged_events": _wire(charges)}


def _verify_final_resource_evidence(validator, *, plan, expected_plan_sha256, frozen_checkpoint,
        development_comparison, retention_selection, retention_reference, evidence, expected_evidence_sha256,
        verify_final_resource_owner, compact):
    frozen_schema = COMPACT_FINAL_CHECKPOINT_SCHEMA if compact else FINAL_CHECKPOINT_SCHEMA
    comparison_schema = VERIFIED_COMPACT_DEVELOPMENT_SCHEMA if compact else VERIFIED_DEVELOPMENT_SCHEMA
    train_close_field = "training_owner_close_sha256" if compact else "trial_terminal_close_sha256"
    look_close_fields = ("owner_close_sha256", "terminal_owner_close_sha256", "component_owner_close_sha256") if compact else (
        "owner_close_sha256", "trial_terminal_close_sha256")
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and callable(verify_final_resource_owner)
             and _pin(expected_plan_sha256) and _pin(expected_evidence_sha256)
             and final_resource_plan_commitment(plan) == expected_plan_sha256
             and type(frozen_checkpoint) is dict and frozen_checkpoint.get("schema") == frozen_schema
             and commitment(frozen_checkpoint) == plan.candidate_freeze_sha256
             and (frozen_checkpoint.get("study_sha256"), frozen_checkpoint.get("development_comparison_sha256"),
                  frozen_checkpoint.get("final_policy_sha256"))
                 == (plan.study_sha256, plan.development_comparison_sha256, plan.final_policy_sha256)
             and all(_pin(frozen_checkpoint.get(key)) for key in (
                 "candidate_sha256", "attempt_sha256", train_close_field)),
             "exact frozen model selection and final resource owner required")
    _require(type(development_comparison) is dict and development_comparison.get("schema") == comparison_schema
             and development_comparison.get("study_sha256") == plan.study_sha256
             and commitment(development_comparison) == plan.development_comparison_sha256
             and type(retention_selection) is dict
             and set(retention_selection) == {"frozen_checkpoint_sha256", "final_panel_sha256",
                                              "final_policy_sha256", "baseline_checkpoint_sha256"}
             and commitment(("reviewed-final-baseline-selection/v1", retention_selection))
                 == plan.final_retention_selection_sha256
             and (retention_selection["frozen_checkpoint_sha256"], retention_selection["final_panel_sha256"],
                  retention_selection["final_policy_sha256"])
                 == (plan.candidate_freeze_sha256, plan.final_panel_sha256, plan.final_policy_sha256)
             and (retention_selection["baseline_checkpoint_sha256"] is None
                  or _pin(retention_selection["baseline_checkpoint_sha256"])),
             "exact retained development comparison and preregistered final baseline required")
    reference_pin = None
    if retention_reference is not None:
        _require(type(retention_reference) is dict and set(retention_reference) == {
            "seed", "panel_sha256", "evaluation_policy_sha256", "baseline_checkpoint_sha256",
            "baseline_receipt_sha256", "row_fidelity"}
            and (retention_reference["seed"], retention_reference["panel_sha256"],
                  retention_reference["evaluation_policy_sha256"], retention_reference["baseline_checkpoint_sha256"])
                == (frozen_checkpoint.get("seed"), plan.final_panel_sha256, plan.final_policy_sha256,
                    retention_selection["baseline_checkpoint_sha256"])
            and all(_pin(retention_reference[key]) for key in ("baseline_checkpoint_sha256", "baseline_receipt_sha256")),
            "final retention reference must identify its exact baseline receipt and final panel")
        reference_pin = commitment(("reviewed-relational-heldout-threshold-look/v1", "baseline-retention", retention_reference))
    _require(type(evidence) is FinalResourceEvidence and evidence.plan_sha256 == expected_plan_sha256
             and type(evidence.closes) is tuple and len(evidence.closes) == len(plan.activities)
             and all(type(close) is tuple and len(close) == 4 for close in evidence.closes)
             and commitment(evidence) == expected_evidence_sha256,
             "exact ordered final resource evidence required")
    compared_attempts = development_comparison.get("attempts")
    compared_events = development_comparison.get("physical_paid_events")
    compared_looks = development_comparison.get("development_looks")
    _require(type(compared_attempts) in (tuple, list) and type(compared_events) in (tuple, list)
             and type(compared_looks) in (tuple, list)
             and all(type(row) is dict and _pin(row.get("attempt_sha256"))
                     and _pin(row.get("closeout_receipt_sha256")) for row in compared_attempts)
             and all(type(row) is dict and _pin(row.get("event_sha256")) for row in compared_events)
             and all(type(row) is dict and all(_pin(row.get(key)) for key in look_close_fields)
                     for row in compared_looks),
             "verified development attempt, event and closure rosters required")
    development_attempts = {row["attempt_sha256"] for row in compared_attempts}
    development_events = {row["event_sha256"] for row in compared_events}
    recorded_closes = {row["closeout_receipt_sha256"] for row in compared_attempts}
    recorded_closes.update(row[key] for row in compared_looks
                           for key in look_close_fields)
    recorded_closes.add(frozen_checkpoint[train_close_field])
    activation_charges = _activation_charge_metadata(development_comparison)
    _require(_activation_charge_metadata(frozen_checkpoint) == activation_charges,
             "final resource evidence must retain the approved activation diagnostic charges")
    if compact:
        frozen_scheduled = None
        recorded_closes.update(_compact_final_development_closes(
            frozen_checkpoint, development_comparison, compared_attempts, compared_events, compared_looks))
        if retention_selection["baseline_checkpoint_sha256"] is not None:
            _require(retention_selection["baseline_checkpoint_sha256"] != frozen_checkpoint["candidate_sha256"],
                     "compact final baseline must select a different checkpoint")
    else:
        frozen_scheduled = _scheduled_checkpoint_metadata(frozen_checkpoint)
        scheduled_looks = tuple(_scheduled_checkpoint_metadata(row) for row in compared_looks)
        frozen_archive = _archived_capture_metadata(frozen_checkpoint)
        approval = _capture_approval_metadata(frozen_checkpoint)
        _require(approval == _capture_approval_metadata(development_comparison)
                 and bool(approval) == (frozen_archive is not None)
                 and all(bool(approval) == (_archived_capture_metadata(row) is not None) for row in compared_looks)
                 and (not approval or frozen_scheduled is not None),
                 "final resource evidence must retain the approved matrix capture scope")
        if frozen_scheduled is not None or any(checkpoint is not None for checkpoint in scheduled_looks):
            _require(frozen_scheduled is not None and all(checkpoint is not None for checkpoint in scheduled_looks),
                     "final resource evidence must retain the original retrospective checkpoint scope")
            confirming_look = _one_final_row(compared_looks,
                lambda row: (row.get("attempt_sha256"), row.get("look")) == (
                    frozen_checkpoint["attempt_sha256"], frozen_checkpoint.get("confirming_look")),
                "exact retrospective confirming look required for final resource evidence")
            _require(_scheduled_checkpoint_metadata(confirming_look) == frozen_scheduled
                     and _archived_capture_metadata(confirming_look) == frozen_archive
                     and type(confirming_look.get("optimizer_steps")) is int
                     and type(frozen_checkpoint.get("optimizer_steps")) is int
                     and (confirming_look.get("checkpoint_sha256"), confirming_look["trial_terminal_close_sha256"],
                          confirming_look["optimizer_steps"]) == (frozen_checkpoint["candidate_sha256"],
                          frozen_checkpoint["trial_terminal_close_sha256"], frozen_checkpoint["optimizer_steps"]),
                     "final resource evidence differs from the original confirming checkpoint and closes")
            recorded_closes.update(checkpoint[key] for checkpoint in scheduled_looks
                                   for key in ("checkpoint_close_sha256", "owner_stage_record_sha256"))
    events = _event_roster(evidence.events)
    _require(not development_events.intersection(events)
             and not development_attempts.intersection(activity.evaluation_sha256 for activity in plan.activities),
             "final evaluation cannot recharge a development event or reuse a training attempt")
    _require(all(event.kind != ACTIVATION_EVENT_KIND for event in events.values()),
             "final evaluation has no selected activation diagnostic charge scope")
    activation_closes = tuple(row.get("close_receipt_sha256") for row in compared_events
                              if row.get("kind") == ACTIVATION_EVENT_KIND)
    _require(bool(activation_closes) == bool(activation_charges) and all(_pin(close) for close in activation_closes),
             "final evaluation must retain the exact development activation diagnostic scope")
    _require(all(event.close_receipt_sha256 not in activation_closes for event in events.values()),
             "final evaluation cannot recharge a development activation diagnostic close")
    recorded_closes.update(activation_closes)
    if frozen_scheduled is not None:
        _require(all(_pin(row.get("close_receipt_sha256")) for row in compared_events),
                 "retrospective development paid events must retain exact close receipts")
        development_paid_closes = recorded_closes | {row["close_receipt_sha256"] for row in compared_events}
        _require(all(event.close_receipt_sha256 not in development_paid_closes for event in events.values()),
                 "final evaluation cannot recharge a development close under another event identity")
    if compact:
        _require(len({event.close_receipt_sha256 for event in events.values()}) == len(events),
                 "one compact final physical close cannot be charged under multiple event identities")
        recorded_closes.update(development_attempts)
        recorded_closes.update(development_events)
        _require(recorded_closes.isdisjoint(events)
                 and all(event.close_receipt_sha256 not in recorded_closes for event in events.values()),
                 "compact final evaluation cannot recharge a development close under another event identity")
        reservation_pins = tuple(terminal.report.get("reservation_close_sha256")
                                 for terminal, _, _, _ in evidence.closes
                                 if type(terminal) is FinalTerminal and terminal.status == "complete"
                                 and type(terminal.report) is dict
                                 and terminal.report.get("schema") == COMPACT_FINAL_PANEL_REPORT_SCHEMA)
        _require(all(_pin(pin) for pin in reservation_pins), "exact compact final reservation close required")
        reservations = set(reservation_pins)
        _require(reservations.isdisjoint(recorded_closes) and reservations.isdisjoint(events)
                 and all(event.close_receipt_sha256 not in reservations for event in events.values()),
                 "compact final resource evidence cannot reuse the prior reservation as paid evaluation work")
        recorded_closes.update(reservations)
    allocations = {event_id: [] for event_id in events}
    activities, baselines = [], set()
    for activity, (terminal, meter, interval, charges) in zip(plan.activities, evidence.closes, strict=True):
        _require(activity.evaluation_sha256 != frozen_checkpoint["attempt_sha256"]
                 and (activity.role == "candidate" and (activity.frozen_checkpoint_sha256, activity.checkpoint_sha256)
                       == (plan.candidate_freeze_sha256, frozen_checkpoint["candidate_sha256"])
                      or activity.role == "baseline" and activity.checkpoint_sha256
                          == retention_selection["baseline_checkpoint_sha256"]),
                 "physical final activity differs from the selected candidate or baseline")
        report_pin = _final_report_binding(plan, activity, terminal, frozen_checkpoint, compact=compact)
        new_closes = (terminal.terminal_close_sha256, *terminal.component_owner_close_sha256s)
        _require(len(set(new_closes)) == len(new_closes) and not recorded_closes.intersection(new_closes),
                 "final terminal and component closure identities must be distinct from each other and development")
        recorded_closes.update(new_closes)
        if terminal.baseline_receipt_sha256 is not None:
            _require(terminal.baseline_receipt_sha256 not in baselines, "one physical closure per baseline result required")
            if compact:
                _require(terminal.baseline_receipt_sha256 not in recorded_closes,
                         "compact baseline result cannot reuse a development or final close")
                recorded_closes.add(terminal.baseline_receipt_sha256)
            baselines.add(terminal.baseline_receipt_sha256)
        if activity.role == "candidate" and report_pin is not None:
            _require("retention_reference_sha256" in terminal.report
                     and (terminal.report["retention_reference_sha256"] == reference_pin if compact
                          else terminal.report["retention_reference_sha256"] in (None, reference_pin))
                     and terminal.report.get("baseline_checkpoint_sha256") == retention_selection["baseline_checkpoint_sha256"],
                     "final candidate report named a different baseline selection or reference")
        shares, activity_receipt = _measure_final_activity(validator, plan, expected_plan_sha256, activity, terminal,
            meter, interval, charges, events, report_pin, require_paid_terminal=compact)
        for event_id, share in shares.items():
            allocations[event_id].append(share)
        activities.append(activity_receipt)
    _require(retention_reference is None or retention_reference["baseline_receipt_sha256"] in baselines,
             "referenced final baseline receipt has no selected complete physical closure")
    _require_conserved_allocations(allocations, plan.shared_event_consumers)
    selection_pins = tuple(commitment(value) for value in (
        frozen_checkpoint, development_comparison, retention_selection, retention_reference))
    result_schema = COMPACT_FINAL_RESOURCE_RESULT_SCHEMA if compact else FINAL_RESOURCE_RESULT_SCHEMA
    report = {"schema": result_schema, "final_resource_plan_sha256": expected_plan_sha256,
              "final_resource_evidence_sha256": expected_evidence_sha256,
              "development_comparison_sha256": plan.development_comparison_sha256,
              "retention_reference_sha256": reference_pin, "activities": tuple(activities),
              "physical_paid_events": tuple(_wire(event) for event in evidence.events),
              "physical_work_ns": _physical_work_ns(events), **activation_charges}
    _require(verify_final_resource_owner(expected_plan_sha256, expected_evidence_sha256, selection_pins) is True
             and final_resource_plan_commitment(plan) == expected_plan_sha256
             and commitment(evidence) == expected_evidence_sha256
             and tuple(commitment(value) for value in (frozen_checkpoint, development_comparison,
                 retention_selection, retention_reference)) == selection_pins,
             "final resource owner refused or the exact selected evidence changed")
    return report


FINAL_DECISION_PLAN_SCHEMA = "reviewed-frozen-final-decision-plan/v1"
FINAL_DECISION_SCHEMA = "reviewed-frozen-final-panel-decision/v1"
COMPACT_FINAL_DECISION_SCHEMA = "reviewed-frozen-compact-final-panel-decision/v1"
FINAL_GATE_NAMES = ("source_fidelity", "formal_validity", "retention", "coverage", "abstention")


@dataclass(frozen=True)
class FinalDecisionPlan:
    final_resource_plan_sha256: str
    final_evaluation_sha256: str
    evidence_kind: str
    panel: tuple[tuple[str, str, str], ...]
    cutoffs: tuple[tuple[str, Fraction], ...]


def _final_panel_cutoffs(validator, panel, cutoffs):
    return (tuple(validator.GATES) == FINAL_GATE_NAMES and type(panel) is tuple and bool(panel)
             and all(type(row) is tuple and len(row) == 3 and _name(row[0]) and _pin(row[1]) and _name(row[2])
                     for row in panel)
             and len({row[0] for row in panel}) == len(panel)
             and type(cutoffs) is tuple
             and all(type(item) is tuple and len(item) == 2 and type(item[1]) is Fraction and 0 <= item[1] <= 1
                     for item in cutoffs)
             and tuple(key for key, _ in cutoffs) == FINAL_GATE_NAMES)


def final_decision_plan_commitment(validator, plan):
    _require(type(plan) is FinalDecisionPlan and _pin(plan.final_resource_plan_sha256) and _pin(plan.final_evaluation_sha256)
             and type(plan.evidence_kind) is str and plan.evidence_kind in ("fictional_fixture", "native_reviewed")
             and _final_panel_cutoffs(validator, plan.panel, plan.cutoffs),
             "independently selected final roster, candidate evaluation and exact gate cutoffs required")
    return commitment((FINAL_DECISION_PLAN_SCHEMA, plan))


def _final_gate_observations(validator, plan, final_report, retention_reference):
    rows = final_report.get("rows")
    names = ("source_fidelity", "formal_validity", "coverage", "abstention")
    _require(type(rows) in (tuple, list)
             and all(type(row) is dict and all(type(row.get(flag)) is bool for flag in ("review_eligible", "formal_required"))
                     and all(key in row and (row[key] is None or type(row[key]) is bool) for key in names) for row in rows)
             and tuple(row.get("row_id") for row in rows) == tuple(row[0] for row in plan.panel),
             "final report must retain exact ordered panel rows, eligibility and gate observations")
    eligible = tuple(row for row in rows if row["review_eligible"])
    required = tuple(row for row in rows if row["formal_required"])
    baseline_known = retention_reference is not None
    retained = ()
    if baseline_known:
        fidelity = retention_reference.get("row_fidelity")
        _require(type(fidelity) in (tuple, list)
                 and all(type(pair) in (tuple, list) and len(pair) == 2
                         and (pair[1] is None or type(pair[1]) is bool) for pair in fidelity)
                 and tuple(pair[0] for pair in fidelity) == tuple(row["row_id"] for row in eligible),
                 "retention reference must cover exactly the original eligible roster in order")
        baseline_known = all(passed is not None for _, passed in fidelity)
        retained = tuple(row for row, (_, passed) in zip(eligible, fidelity, strict=True) if passed is True)
    rosters = {"source_fidelity": ("source_fidelity", eligible), "formal_validity": ("formal_validity", required),
               "retention": ("source_fidelity", retained), "coverage": ("coverage", rows), "abstention": ("abstention", rows)}
    counts = {}
    for gate, (key, roster) in rosters.items():
        values = tuple(row[key] for row in roster)
        known = all(value is not None for value in values) and (gate != "retention" or baseline_known)
        counts[gate] = validator.Counts(sum(value is True for value in values), len(values), known)
    raw_counts = final_report.get("counts")
    _require(type(raw_counts) is dict and commitment(raw_counts) == commitment(counts),
             "final gate counts must reconcile with the authenticated rows and independent baseline")
    return counts


def evaluate_frozen_compact_final_decision(validator, *, plan, expected_plan_sha256, resource_plan,
        frozen_checkpoint, verified_resources, expected_resources_sha256, final_report, retention_reference,
        verify_final_decision_owner):
    """Apply preregistered final cutoffs to one exact compact evaluation.

    The independent owner verifies that the cutoff, panel and evaluation
    selection predates final access and that the exact freeze, paid result,
    review and baseline are issued evidence of the selected kind.
    """
    return _evaluate_frozen_final_decision(validator, plan=plan, expected_plan_sha256=expected_plan_sha256,
        resource_plan=resource_plan, frozen_checkpoint=frozen_checkpoint, verified_resources=verified_resources,
        expected_resources_sha256=expected_resources_sha256, final_report=final_report,
        retention_reference=retention_reference, verify_final_decision_owner=verify_final_decision_owner,
        compact=True)


def evaluate_frozen_final_decision(validator, *, plan, expected_plan_sha256, resource_plan, frozen_checkpoint,
                                    verified_resources, expected_resources_sha256, final_report, retention_reference,
                                    verify_final_decision_owner):
    """Evaluate the separate final cutoffs with the existing threshold rules.

    The owner independently resolves the exact freeze, issued report and paid
    resource result. The owner verifies the evidence kind from admitted source
    and execution evidence, and that the decision plan predates final access.
    Returned statuses describe the selected panel, with no corpus admission.
    """
    return _evaluate_frozen_final_decision(validator, plan=plan, expected_plan_sha256=expected_plan_sha256,
        resource_plan=resource_plan, frozen_checkpoint=frozen_checkpoint, verified_resources=verified_resources,
        expected_resources_sha256=expected_resources_sha256, final_report=final_report,
        retention_reference=retention_reference, verify_final_decision_owner=verify_final_decision_owner,
        compact=False)


def _evaluate_frozen_final_decision(validator, *, plan, expected_plan_sha256, resource_plan, frozen_checkpoint,
        verified_resources, expected_resources_sha256, final_report, retention_reference, verify_final_decision_owner,
        compact):
    frozen_schema = COMPACT_FINAL_CHECKPOINT_SCHEMA if compact else FINAL_CHECKPOINT_SCHEMA
    resource_schema = COMPACT_FINAL_RESOURCE_RESULT_SCHEMA if compact else FINAL_RESOURCE_RESULT_SCHEMA
    _require(callable(verify_final_decision_owner) and _pin(expected_plan_sha256) and _pin(expected_resources_sha256)
             and final_decision_plan_commitment(validator, plan) == expected_plan_sha256
             and final_resource_plan_commitment(resource_plan) == plan.final_resource_plan_sha256
             and commitment(plan.panel) == resource_plan.final_panel_sha256
             and type(frozen_checkpoint) is dict and frozen_checkpoint.get("schema") == frozen_schema
             and commitment(frozen_checkpoint) == resource_plan.candidate_freeze_sha256
             and type(frozen_checkpoint.get("reserved_final_count")) is int
             and frozen_checkpoint["reserved_final_count"] == len(plan.panel)
             and (frozen_checkpoint.get("study_sha256"), frozen_checkpoint.get("final_policy_sha256"),
                  frozen_checkpoint.get("development_comparison_sha256"))
                 == (resource_plan.study_sha256, resource_plan.final_policy_sha256, resource_plan.development_comparison_sha256),
             "exact frozen checkpoint, untouched final population and selected cost scope required")
    _require(type(verified_resources) is dict and verified_resources.get("schema") == resource_schema
             and commitment(verified_resources) == expected_resources_sha256
             and verified_resources.get("final_resource_plan_sha256") == plan.final_resource_plan_sha256
             and verified_resources.get("development_comparison_sha256") == resource_plan.development_comparison_sha256
             and _activation_charge_metadata(verified_resources) == _activation_charge_metadata(frozen_checkpoint)
             and _pin(verified_resources.get("final_resource_evidence_sha256")),
             "exact independently verified paid final result required")
    subject = next((activity for activity in resource_plan.activities
                    if activity.evaluation_sha256 == plan.final_evaluation_sha256), None)
    _require(subject is not None and subject.role == "candidate" and
             (subject.frozen_checkpoint_sha256, subject.checkpoint_sha256)
                 == (resource_plan.candidate_freeze_sha256, frozen_checkpoint.get("candidate_sha256")),
             "final decision must select one original candidate evaluation")
    scope = verified_resources.get("activities")
    _require(type(scope) in (tuple, list) and len(scope) == len(resource_plan.activities)
             and all(type(row) is dict and row.get("activity") == _wire(activity)
                     and _pin(row.get("terminal_close_sha256")) and type(row.get("status")) is str
                     and row["status"] in CLOSED_EVENT_OUTCOMES
                     for row, activity in zip(scope, resource_plan.activities, strict=True)),
             "paid resource closure roster differs from the exact selected activities")
    selected = next(row for row in scope if row["activity"]["evaluation_sha256"] == subject.evaluation_sha256)
    status, counts, gate_decisions, reference_pin = "final_evaluation_incomplete", None, None, None
    if selected["status"] == "complete":
        _require(type(final_report) is dict and commitment(final_report) == selected.get("report_sha256"),
                 "complete final evaluation requires its exact authenticated final report")
        component_ids = selected.get("component_owner_close_sha256s")
        _require(type(component_ids) in (list, tuple), "complete final result lacks component closes")
        terminal = FinalTerminal(subject.evaluation_sha256, selected["terminal_close_sha256"],
                                 selected["status"], tuple(component_ids), final_report)
        _final_report_binding(resource_plan, subject, terminal, frozen_checkpoint, compact=compact)
        reference_pin = final_report.get("retention_reference_sha256")
        if compact:
            _require(final_report["evidence_kind"] == plan.evidence_kind
                     and {row[1] for row in plan.panel} == {final_report["dependency_group_sha256"]}
                     and "retention_reference_sha256" in final_report
                     and "retention_reference_sha256" in verified_resources
                     and reference_pin == verified_resources["retention_reference_sha256"],
                     "compact final decision must retain the verified evidence kind, component and baseline")
        if retention_reference is None:
            _require(reference_pin is None, "final retention reference is missing")
        else:
            _require(type(retention_reference) is dict and _pin(reference_pin)
                     and reference_pin == verified_resources.get("retention_reference_sha256")
                        == commitment(("reviewed-relational-heldout-threshold-look/v1", "baseline-retention", retention_reference))
                     and (retention_reference.get("seed"), retention_reference.get("panel_sha256"),
                          retention_reference.get("evaluation_policy_sha256"), retention_reference.get("baseline_checkpoint_sha256"))
                         == (frozen_checkpoint.get("seed"), resource_plan.final_panel_sha256,
                             resource_plan.final_policy_sha256, final_report.get("baseline_checkpoint_sha256"))
                     and _pin(retention_reference.get("baseline_receipt_sha256"))
                     and sum(row["activity"]["role"] == "baseline" and row["status"] == "complete"
                             and row["activity"]["checkpoint_sha256"] == retention_reference["baseline_checkpoint_sha256"]
                             and row.get("baseline_receipt_sha256") == retention_reference["baseline_receipt_sha256"]
                             for row in scope) == 1,
                     "final retention requires one complete exact baseline receipt on the selected panel")
        counts = _final_gate_observations(validator, plan, final_report, retention_reference)
        unmeasured = validator.Costs(None, None, None)
        evaluated = validator.evaluate_threshold(schedule=("final",), thresholds=dict(plan.cutoffs), required_streak=1,
            observed=(validator.Look("final", counts, unmeasured),), closeout=validator.Closeout("complete", unmeasured))
        looks = getattr(evaluated, "looks", None)
        _require(type(looks) is tuple and len(looks) == 1 and type(looks[0]) is tuple and len(looks[0]) == 2
                 and looks[0][0] == "final" and type(looks[0][1]) is tuple,
                 "threshold reducer must return one final observation")
        _, gates = looks[0]
        _require(all(type(gate) is validator.GateDecision and type(gate.status) is str
                     and gate.status in ("pass", "fail", "unavailable") for gate in gates)
                 and tuple(gate.name for gate in gates) == FINAL_GATE_NAMES,
                 "threshold reducer must return every final gate with a recognized disposition")
        gate_decisions = _wire(gates)
        dispositions = {gate.status for gate in gates}
        status = ("cutoffs_passed" if dispositions == {"pass"} else "cutoffs_failed"
                  if "fail" in dispositions else "cutoffs_unavailable")
    else:
        _require(final_report is None and retention_reference is None and selected.get("report_sha256") is None,
                 "incomplete final evaluation cannot supply panel findings")

    evidence = (frozen_checkpoint, verified_resources, final_report, retention_reference)
    pins = tuple(commitment(item) for item in evidence)
    _require(verify_final_decision_owner(expected_plan_sha256, pins) is True
             and final_decision_plan_commitment(validator, plan) == expected_plan_sha256
             and final_resource_plan_commitment(resource_plan) == plan.final_resource_plan_sha256
             and tuple(commitment(item) for item in evidence) == pins,
             "final decision owner refused or selected evidence changed during verification")
    schema = COMPACT_FINAL_DECISION_SCHEMA if compact else FINAL_DECISION_SCHEMA
    return {"schema": schema, "final_decision_plan_sha256": expected_plan_sha256,
            "evidence_kind": plan.evidence_kind,
            "study_sha256": resource_plan.study_sha256, "checkpoint_sha256": subject.checkpoint_sha256,
            "frozen_checkpoint_sha256": resource_plan.candidate_freeze_sha256,
            "development_comparison_sha256": resource_plan.development_comparison_sha256,
            "final_panel_sha256": resource_plan.final_panel_sha256, "final_policy_sha256": resource_plan.final_policy_sha256,
            "final_resource_plan_sha256": plan.final_resource_plan_sha256, "final_resources_sha256": expected_resources_sha256,
            "final_evaluation_sha256": subject.evaluation_sha256, "final_terminal_close_sha256": selected["terminal_close_sha256"],
            "final_report_sha256": None if final_report is None else pins[2],
            "retention_reference_sha256": reference_pin, "cutoffs": _wire(plan.cutoffs),
            "final_status": selected["status"], "decision": status, "gate_counts": _wire(counts), "gates": gate_decisions,
            **_activation_charge_metadata(frozen_checkpoint)}


MATCHED_MATRIX_PLAN_SCHEMA = "reviewed-matched-decoder-matrix-plan/v1"
MATCHED_MATRIX_SCHEMA = "reviewed-matched-decoder-matrix/v1"
MATCHED_MATRIX_COMPARISON_SCHEMA = "reviewed-matched-decoder-matrix-comparison/v1"
MATRIX_TEACHERS = (("spacy", 8), ("gte-small", 384), ("gte-base-multilingual", 768), ("leanstral", 4096))
MATRIX_ARMS = ("supervised", "tap_only", "relational")
MATRIX_SIZE_FIELDS = {"qwen2-causal-last-source/v1": "hidden_size", "t5-encoder-last-source/v1": "d_model"}


@dataclass(frozen=True)
class MatrixCell:
    variant: str
    teacher: str
    arms: tuple[str, str, str]  # In the existing native arm order.
    objective_contrast: str
    instrumentation_contrast: str | None = None


@dataclass(frozen=True)
class MatrixPlan:
    study_sha256: str
    development_design_sha256: str
    contrast_plan_sha256: str
    evidence_kind: str
    variants: tuple[tuple[str, str], ...]  # Label, exact configuration SHA.
    teachers: tuple[tuple[str, int, str], ...]  # Name, native width, profile SHA.
    seed_receipts: tuple[tuple[str, str], ...]  # Study seed label, full prepared receipt SHA.
    cells: tuple[MatrixCell, ...]


def matched_matrix_plan_commitment(plan):
    _require(type(plan) is MatrixPlan and all(_pin(pin) for pin in (
                plan.study_sha256, plan.development_design_sha256, plan.contrast_plan_sha256))
             and type(plan.evidence_kind) is str and plan.evidence_kind in ("fictional_fixture", "native_reviewed")
             and type(plan.variants) is tuple and 2 <= len(plan.variants) <= 8
             and all(type(row) is tuple and len(row) == 2 and _name(row[0]) and _pin(row[1]) for row in plan.variants)
             and all(len({row[index] for row in plan.variants}) == len(plan.variants) for index in (0, 1))
             and type(plan.teachers) is tuple
             and all(type(row) is tuple and len(row) == 3 and type(row[1]) is int and _pin(row[2]) for row in plan.teachers)
             and tuple(row[:2] for row in plan.teachers) == MATRIX_TEACHERS
             and len({row[2] for row in plan.teachers}) == len(plan.teachers)
             and type(plan.seed_receipts) is tuple and len(plan.seed_receipts) >= 2
             and all(type(row) is tuple and len(row) == 2 and _name(row[0]) and _pin(row[1])
                     for row in plan.seed_receipts)
             and all(len({row[index] for row in plan.seed_receipts}) == len(plan.seed_receipts) for index in (0, 1))
             and type(plan.cells) is tuple
             and all(type(cell) is MatrixCell and type(cell.arms) is tuple and len(cell.arms) == 3
                     and all(_name(arm) for arm in cell.arms) and _name(cell.objective_contrast)
                     and (cell.instrumentation_contrast is None or _name(cell.instrumentation_contrast))
                     for cell in plan.cells)
             and tuple((cell.variant, cell.teacher) for cell in plan.cells)
                 == tuple((variant, teacher) for variant, _ in plan.variants for teacher, _, _ in plan.teachers),
             "exact multi-seed decoder, teacher and contrast cells required")
    return commitment((MATCHED_MATRIX_PLAN_SCHEMA, plan))


def _matrix_study(validator, plan, study, design, contrasts):
    _study(validator, study, plan.study_sha256)
    _require(development_design_commitment(design) == plan.development_design_sha256
             and design.study_sha256 == plan.study_sha256
             and tuple(label for label, _, _ in design.seed_cohorts) == tuple(label for label, _ in plan.seed_receipts)
                 == tuple(seed.identifier for seed in study.seeds)
             and tuple(arm for arm, _ in study.arms) == tuple(arm for cell in plan.cells for arm in cell.arms),
             "common study must preselect exactly every matrix seed and native arm alias")
    selected = _selected_contrasts(study, plan.study_sha256, contrasts, plan.contrast_plan_sha256)
    directions = {row["identifier"]: (row["baseline"], row["candidate"]) for row in selected}
    expected, aliases = {}, {}
    for cell in plan.cells:
        for contrast, pair, kind in ((cell.objective_contrast, cell.arms[1:], "relational_objective"),
                                     (cell.instrumentation_contrast, cell.arms[:2], "tap_instrumentation")):
            if contrast is None:
                continue
            _require(contrast not in expected, "a declared contrast can describe only one matrix cell")
            expected[contrast] = pair
            aliases[contrast] = (cell.variant, cell.teacher, kind)
    _require(directions == expected, "every declared contrast must retain its own variant and teacher control")
    return aliases


def _matrix_variant(arming, selection, configuration):
    label, config_sha = selection
    _require(commitment(configuration) == config_sha, "student configuration differs from its exact selected bytes")
    profile = arming._student_profile(configuration)
    size_field = MATRIX_SIZE_FIELDS.get(profile)
    size = configuration["model_config"].get(size_field)
    _require(size_field is not None and type(size) is int and size > 0,
             "selected architecture requires a positive native hidden dimension")
    return {"label": label, "configuration_sha256": config_sha, "student_profile": profile,
            "native_size_field": size_field, "native_size": size}


def _matrix_packet(arming, packet, proof, study_sha, native_seed, variant, prepared, teacher, cell, recipes, fixture):
    _require(type(proof) is dict and arming.packet_commitment(packet) == proof.get("packet_sha256")
             and commitment(tuple(arming.trial.commitment(entry) for entry in packet.trials))
                 == commitment(proof.get("trial_sha256s")),
             "portable preparation must bind the original packet and all three exact trials")
    producer = _teacher_evidence(proof, teacher[2])
    out = []
    worker_cutoff = None
    for alias, native, entry, job in zip(cell.arms, MATRIX_ARMS, packet.trials, packet.specs, strict=True):
        body = arming.trial._evidence_json(job, 1024**2)
        _require((entry.study_sha256, entry.seed, entry.arm, entry.arm_recipe_sha256)
                     == (study_sha, native_seed, native, recipes[alias])
                 and (entry.configuration_sha256, entry.parent_manifest_sha256, entry.prepared_inputs_sha256)
                     == (variant["configuration_sha256"], prepared.get("parent_sha256"), prepared.get("prepared_sha256"))
                 and type(body.get("seed")) is int and body["seed"] == native_seed
                 and body.get("allow_fictional_fixture") is fixture,
                 "native study, seed, recipe, configuration or evidence class differs from selected matrix arm")
        cutoff = body.get("max_seconds")
        _require(type(cutoff) in (int, float) and 0 < cutoff <= 3600
                 and (worker_cutoff is None or cutoff == worker_cutoff),
                 "matched matrix packet requires one common training job max_seconds")
        worker_cutoff = cutoff
        if native != "supervised":
            _require(all(type(batch.geometry_plan) is arming.geometry.Plan for batch in entry.batches),
                     "ordinary matrix requires exact unshuffled teacher geometry")
            _require(all((batch.geometry_plan.teacher_width, batch.geometry_plan.teacher_profile_sha256,
                          batch.geometry_plan.student_profile)
                         == (teacher[1], teacher[2], variant["student_profile"]) for batch in entry.batches),
                     "exact teacher profile and native geometry required for each instrumented batch")
        out.append({"arm": alias, "native_arm": native, "attempt_sha256": entry.attempt_sha256,
                    "recipe_sha256": entry.arm_recipe_sha256, "packet_sha256": proof["packet_sha256"],
                    "trial_sha256": arming.trial.commitment(entry), "job_sha256": entry.job_sha256,
                    "configuration_sha256": entry.configuration_sha256,
                    "prepared_inputs_sha256": entry.prepared_inputs_sha256})
        if producer is not None:
            out[-1]["teacher_evidence"] = dict(producer)
    return out, worker_cutoff


def _matrix_geometry(packet):
    # Exclude student-specific context, paths, framing, observed size cap and lineage.
    plans = (batch.geometry_plan for batch in packet.trials[1].batches)
    return tuple((plan.population_sha256, plan.source_pairs, plan.teacher_profile_sha256,
                  plan.teacher_width, plan.coefficient, plan.rows) for plan in plans)


def prepare_matched_study_matrix(validator, arming, *, plan, expected_plan_sha256, study, design, contrasts,
                                 configurations, seed_materials, verify_matrix_owner):
    """Link exact existing packets to a single multi-variant analytical Study.

    The owner resolves original prepared receipts, selected asset/configuration
    provenance and evidence type. The inner training deadline must match across
    the study's compared jobs. Packet preparation carries no dispatch authority.
    """
    _require(callable(verify_matrix_owner) and _pin(expected_plan_sha256)
             and matched_matrix_plan_commitment(plan) == expected_plan_sha256
             and tuple(arming.TEACHER_WIDTHS.items()) == MATRIX_TEACHERS and tuple(arming.trial.ARMS) == MATRIX_ARMS
             and type(configurations) is tuple and len(configurations) == len(plan.variants)
             and type(seed_materials) is tuple and len(seed_materials) == len(plan.seed_receipts),
             "exact preselected matrix, configurations and seed preparation required")
    aliases = _matrix_study(validator, plan, study, design, contrasts)
    variants = tuple(_matrix_variant(arming, row, config)
                     for row, config in zip(plan.variants, configurations, strict=True))
    recipes = dict(study.arms)
    attempts = []
    common_worker_cutoff = None
    for (label, native_seed, cohort), (_, receipt_sha), material in zip(
            design.seed_cohorts, plan.seed_receipts, seed_materials, strict=True):
        _require(type(material) is tuple and len(material) == 2, "one exact portable preparation per selected seed required")
        receipt, groups = material
        _require(type(receipt) is dict and commitment(receipt) == receipt_sha and receipt.get("schema") == arming.MATCHED_PANEL_SCHEMA
                 and (receipt.get("study_sha256"), receipt.get("seed_label"), receipt.get("job_seed"), receipt.get("train_cohort_sha256"))
                     == (plan.study_sha256, label, native_seed, cohort)
                 and type(receipt.get("job_seed")) is int and _pin(receipt.get("selection_sha256"))
                 and commitment({key: value for key, value in receipt.items()
                                 if key not in ("selection_sha256", "packet_proofs")}) == receipt["selection_sha256"],
                 "exact portable receipt must bind this native seed, shared study and TRAIN cohort")
        selected, proofs, teachers = (receipt.get(key) for key in ("variants", "packet_proofs", "common_teacher_inputs_sha256s"))
        _require(all(type(value) in (tuple, list) and len(value) == len(variants) for value in (selected, proofs, groups))
                 and type(teachers) in (tuple, list) and len(teachers) == len(MATRIX_TEACHERS) and all(_pin(pin) for pin in teachers),
                 "portable receipt and packets must exhaust the matrix variants and teachers")
        cells = iter(plan.cells)
        common_geometry = None
        for variant, prepared, packet_proofs, packets in zip(variants, selected, proofs, groups, strict=True):
            _require(type(prepared) is dict and all(variant[key] == prepared.get(key)
                         for key in ("label", "configuration_sha256", "student_profile"))
                     and all(type(value) in (tuple, list) and len(value) == len(plan.teachers)
                             for value in (packet_proofs, packets)),
                     "portable variant, selected configuration or teacher packet order differs")
            for teacher, packet, proof in zip(plan.teachers, packets, packet_proofs, strict=True):
                cell = next(cells)
                rows, cutoff = _matrix_packet(arming, packet, proof, plan.study_sha256, native_seed,
                    variant, prepared, teacher, cell, recipes, plan.evidence_kind == "fictional_fixture")
                _require(common_worker_cutoff is None or cutoff == common_worker_cutoff,
                         "matched matrix requires one common training job max_seconds")
                common_worker_cutoff = cutoff
                attempts.extend({**row, "seed": label, "native_seed": native_seed,
                                 "variant": variant["label"], "teacher": teacher[0]} for row in rows)
            geometry = tuple(_matrix_geometry(packet) for packet in packets)
            _require(all(packet.trials[0].batches == packets[0].trials[0].batches for packet in packets)
                     and (common_geometry is None or geometry == common_geometry),
                     "matched variants need identical per-seed teacher data, pair order and objective coefficients")
            common_geometry = geometry
    _require(len({row["attempt_sha256"] for row in attempts}) == len(attempts),
             "every matrix cell arm needs its own original physical attempt")
    _matrix_teacher_packets(attempts, plan.teachers)
    _require(verify_matrix_owner(expected_plan_sha256, tuple(pin for _, pin in plan.seed_receipts)) is True
             and matched_matrix_plan_commitment(plan) == expected_plan_sha256
             and tuple(commitment(config) for config in configurations) == tuple(pin for _, pin in plan.variants)
             and all(commitment(receipt) == pin and all(
                 tuple(arming.packet_commitment(packet) for packet in group)
                   == tuple(proof["packet_sha256"] for proof in proofs)
                 for group, proofs in zip(groups, receipt["packet_proofs"], strict=True))
                 for (receipt, groups), (_, pin) in zip(seed_materials, plan.seed_receipts, strict=True)),
             "matrix owner refused or selected configurations and packets changed")
    _matrix_study(validator, plan, study, design, contrasts)
    return {"schema": MATCHED_MATRIX_SCHEMA, "plan_sha256": expected_plan_sha256, "study_sha256": plan.study_sha256,
            "development_design_sha256": plan.development_design_sha256, "contrast_plan_sha256": plan.contrast_plan_sha256,
            "evidence_kind": plan.evidence_kind, "variants": variants, "teachers": plan.teachers, "seed_cohorts": design.seed_cohorts,
            "seed_receipts": plan.seed_receipts, "attempts": tuple(attempts), "contrast_cells": aliases}


def project_verified_matrix_comparison(validator, *, matrix, expected_matrix_sha256, study, contrasts, comparison,
                                        expected_comparison_sha256, development_receipts, verify_projection_owner,
                                        expected_teacher_request_roster_sha256=None):
    """Preserve paid paired results under their original contrasts and horizons.

    The owner authenticates the issued matrix and complete paid comparison,
    including prior unsuccessful work. Their exact receipts retain the metrics.
    """
    _require(callable(verify_projection_owner) and _pin(expected_matrix_sha256) and _pin(expected_comparison_sha256)
             and type(matrix) is dict and matrix.get("schema") == MATCHED_MATRIX_SCHEMA
             and commitment(matrix) == expected_matrix_sha256
             and type(comparison) is dict and comparison.get("schema") == VERIFIED_DEVELOPMENT_SCHEMA
             and commitment(comparison) == expected_comparison_sha256
             and all(matrix.get(key) == comparison.get(key)
                     for key in ("study_sha256", "development_design_sha256", "contrast_plan_sha256"))
             and all(_pin(comparison.get(key)) for key in ("attempts_sha256", "cost_evidence_sha256", "development_receipts_sha256")),
             "exact prepared matrix and independently verified paid development comparison required")
    _study(validator, study, matrix["study_sha256"])
    selected = _selected_contrasts(study, matrix["study_sha256"], contrasts, matrix["contrast_plan_sha256"])
    attempts, observed = matrix.get("attempts"), comparison.get("attempts")
    _require(type(attempts) in (list, tuple) and type(observed) in (list, tuple) and len(attempts) == len(observed)
             and all(type(left) is dict and type(right) is dict and _pin(left.get("attempt_sha256"))
                     and all(left.get(key) == right.get(key) for key in ("arm", "seed", "attempt_sha256"))
                     for left, right in zip(attempts, observed, strict=True)),
             "paid comparison must retain every original matrix attempt in order")
    _require(development_receipts_commitment(development_receipts, design_sha256=matrix["development_design_sha256"],
                  attempts_sha256=comparison["attempts_sha256"]) == comparison["development_receipts_sha256"],
             "exact original native development receipts required")
    approval = _capture_approval_metadata(comparison)
    _require(expected_teacher_request_roster_sha256 is None or
             (_pin(expected_teacher_request_roster_sha256) and
              approval.get("teacher_request_roster_sha256") == expected_teacher_request_roster_sha256),
             "paid projection differs from the selected teacher request roster")
    _require(not approval or approval["capture_matrix_sha256"] == expected_matrix_sha256,
             "matched capture approval must identify the exact projected matrix")
    _require(bool(_matrix_teacher_packets(attempts, matrix.get("teachers")))
             == ("teacher_cost_roster_sha256" in approval),
             "teacher-evidence projection must retain the exact approved teacher production cost roster")
    looks = comparison.get("development_looks")
    if approval:
        _require(type(looks) in (tuple, list) and len(looks) == len(development_receipts)
                 and all(type(row) is dict for row in looks),
                 "exact original matched capture look roster required for projection")
    cells = {row["attempt_sha256"]: row for row in attempts}
    for index, receipt in enumerate(development_receipts):
        identity = receipt.report.get("native_identity")
        _require(type(identity) is dict and type(identity.get("attempt_sha256")) is str
                 and identity["attempt_sha256"] in cells, "foreign native development receipt")
        cell = cells[identity["attempt_sha256"]]
        _require_matrix_development_identity(receipt.report, cell)
        archived = _archived_capture_metadata(receipt.report)
        _require(bool(approval) == (archived is not None),
                 "development look and projection must agree on matched capture approval")
        if approval:
            row = looks[index]
            _require(receipt.report.get("schema") == RETROSPECTIVE_NATIVE_DEVELOPMENT_LOOK_SCHEMA
                     and (row.get("attempt_sha256"), row.get("evaluation_receipt_sha256"), row.get("owner_close_sha256"))
                         == (cell["attempt_sha256"], commitment(receipt.report), receipt.owner_close_sha256)
                     and _archived_capture_metadata(row) == archived,
                     "paid projection must retain each exact approved archived look")
    slots = {(row["seed"], row["arm"]): row for row in attempts}
    _require(len(slots) == len(cells) == len(attempts)
             and set(slots) == {(seed.identifier, arm) for seed in study.seeds for arm, _ in study.arms},
             "matrix physical attempts must exhaust the study seed and arm grid exactly once")
    clocks = tuple((key, horizon) for key, horizon in zip(validator.CLOCKS, study.horizons, strict=True) if horizon is not None)
    expected_bounds = tuple((row["identifier"], row["role"], row["baseline"], row["candidate"], clock, horizon)
                            for row in selected for clock, horizon in clocks)
    expected_pairs = tuple((*entry, seed.identifier, slots[seed.identifier, entry[2]]["attempt_sha256"],
                            slots[seed.identifier, entry[3]]["attempt_sha256"])
                           for entry in expected_bounds for seed in study.seeds)
    keys = ("contrast_id", "role", "baseline", "candidate", "clock", "horizon")
    pairs, bounds = (comparison.get(key) for key in ("pairs", "fixed_horizon_attainment"))
    _require(all(type(rows) in (tuple, list) and all(type(row) is dict for row in rows) for rows in (pairs, bounds))
             and tuple(tuple(row.get(key) for key in keys) for row in bounds) == expected_bounds
             and tuple(tuple(row.get(key) for key in (*keys, "seed", "baseline_attempt_sha256", "candidate_attempt_sha256"))
                       for row in pairs) == expected_pairs,
             "paired comparison must preserve each original contrast, clock, horizon, seed and attempt")
    aliases = matrix["contrast_cells"]
    _require(type(aliases) is dict and set(aliases) == {row["identifier"] for row in selected},
             "exact preselected matrix contrast labels required")
    kinds = {MATRIX_ARMS[:2]: "tap_instrumentation", MATRIX_ARMS[1:]: "relational_objective"}
    for contrast in selected:
        for seed in study.seeds:
            before, after = (slots[seed.identifier, contrast[key]] for key in ("baseline", "candidate"))
            identities = tuple(before.get(key) for key in ("variant", "teacher"))
            kind = kinds.get((before.get("native_arm"), after.get("native_arm")))
            _require(kind is not None and identities == tuple(after.get(key) for key in ("variant", "teacher"))
                     and commitment((*identities, kind)) == commitment(aliases[contrast["identifier"]]),
                     "contrast label must describe the same actual variant, teacher and arm directions across seeds")
    joined = tuple({"contrast_id": row["identifier"], "cell": _wire(aliases[row["identifier"]]),
                    "pairs": tuple(_wire(pair) for pair in pairs if pair["contrast_id"] == row["identifier"]),
                    "fixed_horizon_attainment": tuple(_wire(bound) for bound in bounds if bound["contrast_id"] == row["identifier"])}
                   for row in selected)
    _require(verify_projection_owner(expected_matrix_sha256, expected_comparison_sha256) is True
             and commitment(matrix) == expected_matrix_sha256 and commitment(comparison) == expected_comparison_sha256
             and commitment(study) == matrix["study_sha256"]
             and commitment(contrasts) == matrix["contrast_plan_sha256"]
             and development_receipts_commitment(development_receipts, design_sha256=matrix["development_design_sha256"],
                  attempts_sha256=comparison["attempts_sha256"]) == comparison["development_receipts_sha256"],
             "projection owner refused or exact paired evidence changed")
    output = {"schema": MATCHED_MATRIX_COMPARISON_SCHEMA, "matrix_sha256": expected_matrix_sha256,
            "development_comparison_sha256": expected_comparison_sha256, "evidence_kind": matrix["evidence_kind"],
            "cost_evidence_sha256": comparison["cost_evidence_sha256"], "cost_basis": comparison["cost_basis"],
            "uncertainty_scope": comparison["uncertainty_scope"], "contrasts": joined,
            **_activation_charge_metadata(comparison)}
    if "optimizer_step_grid_sha256" in comparison:
        output["optimizer_step_grid_sha256"] = comparison["optimizer_step_grid_sha256"]
    if approval:
        output.update(approval)
        output["development_looks"] = _wire(looks)
    return output


@dataclass(frozen=True)
class TeacherComplementarityPlan:
    matrix_sha256: str
    step_grid_sha256: str
    variant: str
    teachers: tuple[str, str]
    look: str
    minimum_groups_per_direction: int


def teacher_complementarity_plan_commitment(plan):
    _require(type(plan) is TeacherComplementarityPlan and _pin(plan.matrix_sha256)
             and _pin(plan.step_grid_sha256) and _name(plan.variant) and _name(plan.look)
             and type(plan.teachers) is tuple and len(plan.teachers) == 2
             and all(type(name) is str and name in dict(MATRIX_TEACHERS) for name in plan.teachers)
             and plan.teachers[0] != plan.teachers[1]
             and type(plan.minimum_groups_per_direction) is int and plan.minimum_groups_per_direction >= 1,
             "select one configuration, two distinct teachers, a fixed look and a group minimum")
    return commitment(("reviewed-development-teacher-complementarity-plan/v1", plan))


def _complementarity_row(row):
    facts = tuple(row.get(name) for name in ("source_fidelity", "formal_validity", "coverage", "abstention"))
    _require(all(type(row.get(name)) is bool for name in ("review_eligible", "formal_required"))
             and all(name in row for name in ("source_fidelity", "formal_validity", "coverage", "abstention"))
             and all(value is None or type(value) is bool for value in facts),
             "exact evaluator row flags and original three-valued findings required")
    source, formal, covered, abstained = facts
    _require(source is not True or covered is True and abstained is False,
             "source-fidelity success requires the retained answered disposition")
    combined = None
    if row["review_eligible"]:
        # A known fidelity failure settles joint success even when the
        # producer abstention is still pending separate review.
        if source is False:
            combined = False
        elif source is True:
            combined = formal if row["formal_required"] else True
    return (row["review_eligible"], row["formal_required"], *facts, combined)


def _complementarity_group(rows):
    if not rows:
        return "ineligible"
    if any(left is None or right is None or left[-1] is None or right[-1] is None for left, right in rows):
        return "unavailable"
    left_wins = any(left[-1] is True and right[2] is False for left, right in rows)
    right_wins = any(right[-1] is True and left[2] is False for left, right in rows)
    if left_wins and right_wins:
        return "mixed"
    return "left" if left_wins else "right" if right_wins else "tie"


def teacher_complementarity_budget_commitment(*, plan_sha256, paid_comparison_sha256,
                                              attempts_sha256, cost_evidence_sha256, clock):
    """Select one registered clock and the exact original paid look evidence."""
    _require(all(_pin(pin) for pin in (plan_sha256, paid_comparison_sha256, attempts_sha256, cost_evidence_sha256))
             and type(clock) is str and clock in COVERED_CLOCKS,
             "exact screen plan, original paid cost and selected budget clock required")
    return commitment(("reviewed-development-teacher-complementarity-budget/v1", plan_sha256,
                       paid_comparison_sha256, attempts_sha256, cost_evidence_sha256, clock))


def _complementarity_look_budget(validator, study, attempt, selected, *, label, clock, horizon, caps):
    original = tuple(look for look in attempt.assessments if look.look == label)
    _require(len(original) == len(selected) <= 1, "selected paid look differs from its original attempt")
    status, measured, receipt = "missing_paid_look", None, None
    if original:
        look, = original
        evidence, = selected
        _require((evidence["checkpoint_sha256"], evidence["evaluation_receipt_sha256"], evidence["meter_record_sha256"])
                 == (look.checkpoint_sha256, look.evaluation_receipt_sha256, look.meter.record_sha256),
                 "selected paid look must retain its original checkpoint, evaluation and meter record")
        costs = _meter(validator, look.meter, attempt, study, label)
        measured = getattr(costs, clock)
        receipt = look.meter.clock_receipts[COVERED_CLOCKS.index(clock)]
        limit_costs = tuple((cap, getattr(costs, name)) for name, cap in caps.items() if cap is not None)
        if any(value is not None and value > cap for cap, value in limit_costs):
            status = "beyond_execution_cap"
        elif measured is not None and measured > horizon:
            status = "after_registered_horizon"
        elif measured is None or any(value is None for _, value in limit_costs):
            status = "clock_unavailable"
        else:
            status = "within_registered_budget"
    return {"status": status, "seconds": measured, "clock_receipt_sha256": receipt}


def screen_teacher_complementarity(validator, *, plan, expected_plan_sha256, matrix, study, contrasts,
                                   comparison, expected_comparison_sha256, development_receipts,
                                   step_grid, verify_screen_owner, expected_teacher_request_roster_sha256=None,
                                   budget_clock=None, budget_attempts=None, expected_budget_sha256=None):
    """Screen two single-teacher relational arms at one original DEVELOPMENT look.

    A directional win requires a known fidelity failure in the other arm and
    a faithful answer with any required formal success in the winning arm.
    Require the same direction in every planned seed of a counted dependency
    component. Retain the original paid comparison for costs and all gates.
    A selected budget uses the original typed look meter under the same paid
    attempt commitment. Without that binding the result is exploratory.
    """
    _require(callable(verify_screen_owner) and _pin(expected_plan_sha256)
             and teacher_complementarity_plan_commitment(plan) == expected_plan_sha256,
             "independent complementarity plan owner required")
    _selected_development_grid(study, matrix["study_sha256"], matrix["development_design_sha256"],
                               step_grid, plan.step_grid_sha256)
    steps = dict(step_grid.steps)
    _require(plan.look in steps and comparison.get("optimizer_step_grid_sha256") == plan.step_grid_sha256
             and (matrix.get("evidence_kind") == "fictional_fixture" or _pin(expected_teacher_request_roster_sha256)),
             "screen requires the original fixed optimizer step and, for native evidence, a paid producer request roster")

    budget_selected = any(value is not None for value in (budget_clock, budget_attempts, expected_budget_sha256))
    budget_pin = (expected_budget_sha256,) if budget_selected else ()
    _, horizons, caps = _study(validator, study, matrix["study_sha256"])
    horizon = horizons.get(budget_clock) if type(budget_clock) is str else None

    def verify_budget_selection():
        if budget_selected:
            _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and horizon is not None
                     and (budget_clock != "wall_seconds" or study.cost_basis == "first_use")
                     and type(budget_attempts) is tuple
                     and all(type(attempt) is Attempt for attempt in budget_attempts)
                     and commitment(budget_attempts) == comparison.get("attempts_sha256")
                     and tuple((attempt.attempt_sha256, attempt.seed, attempt.arm) for attempt in budget_attempts)
                         == tuple((row["attempt_sha256"], row["seed"], row["arm"]) for row in comparison["attempts"])
                     and _pin(expected_budget_sha256)
                     and teacher_complementarity_budget_commitment(plan_sha256=expected_plan_sha256,
                         paid_comparison_sha256=expected_comparison_sha256,
                         attempts_sha256=comparison["attempts_sha256"], cost_evidence_sha256=comparison["cost_evidence_sha256"],
                         clock=budget_clock) == expected_budget_sha256,
                     "screen budget requires original ordered paid attempts, cost evidence and a registered clock")

    verify_budget_selection()

    def authorize(matrix_pin, comparison_pin):
        accepted = verify_screen_owner(expected_plan_sha256, matrix_pin, comparison_pin, *budget_pin)
        _require(teacher_complementarity_plan_commitment(plan) == expected_plan_sha256
                 and development_step_grid_commitment(step_grid) == plan.step_grid_sha256,
                 "complementarity plan or selected step changed during verification")
        verify_budget_selection()
        return accepted

    projected = project_verified_matrix_comparison(validator, matrix=matrix, expected_matrix_sha256=plan.matrix_sha256,
        study=study, contrasts=contrasts, comparison=comparison, expected_comparison_sha256=expected_comparison_sha256,
        development_receipts=development_receipts, verify_projection_owner=authorize,
        expected_teacher_request_roster_sha256=expected_teacher_request_roster_sha256)
    profiles = {name: (width, profile) for name, width, profile in matrix["teachers"]}
    variants = {row["label"]: row["configuration_sha256"] for row in matrix["variants"]}
    _require(plan.variant in variants and all(teacher in profiles for teacher in plan.teachers),
             "complementarity must use two original teacher cells of the same variant")
    config = variants[plan.variant]
    selected = {(row["seed"], row["teacher"]): row for row in matrix["attempts"]
                if row["variant"] == plan.variant and row["teacher"] in plan.teachers and row["native_arm"] == "relational"}
    _require(set(selected) == {(seed.identifier, name) for seed in study.seeds for name in plan.teachers}
             and all(cell["configuration_sha256"] == config for cell in selected.values()),
             "one trained relational candidate per planned seed and teacher required")
    paid_attempts = {row["attempt_sha256"]: row for row in comparison["attempts"]}
    budget_roster = {attempt.attempt_sha256: attempt for attempt in budget_attempts} if budget_selected else {}
    reports = {commitment(receipt.report): receipt for receipt in development_receipts}
    _require(len(reports) == len(development_receipts), "duplicate development report")
    grouping = tuple(dict.fromkeys(group for _, group, _ in study.panel))
    _require(len(study.seeds) >= 2 and plan.minimum_groups_per_direction <= len(grouping) // 2,
             "planned directional support requires repeated seeds and enough distinct dependency components")
    seed_reports = []
    for seed in study.seeds:
        arms, row_facts = [], []
        for name in plan.teachers:
            cell = selected[seed.identifier, name]
            paid = paid_attempts[cell["attempt_sha256"]]
            look = tuple(item for item in paid["look_evidence"] if item["look"] == plan.look)
            _require(len(look) <= 1, "duplicate selected development look")
            receipt_pin = owner_close = None
            if look:
                original, = look
                receipt_pin = original["evaluation_receipt_sha256"]
                receipt = reports[receipt_pin]
                report, owner_close = receipt.report, receipt.owner_close_sha256
                identity = report["native_identity"]
                _require((identity["attempt_sha256"], identity["look"], identity["candidate_sha256"])
                          == (cell["attempt_sha256"], plan.look, original["checkpoint_sha256"])
                         and type(report["optimizer_steps"]) is int and report["optimizer_steps"] == steps[plan.look]
                         and report["development_split"]["role"] == "development"
                         and tuple(row["row_id"] for row in report["rows"]) == tuple(row_id for row_id, _, _ in study.panel),
                         "selected receipt must retain the exact paid DEVELOPMENT candidate, step and ordered cohort")
                row_facts.append(tuple(_complementarity_row(row) for row in report["rows"]))
            else:
                row_facts.append((None,) * len(study.panel))
            usable = bool(look) and paid["decision"]["status"] not in ("integrity_failure", "unfinished")
            budget = {}
            if budget_selected:
                budget["selected_look_budget"] = _complementarity_look_budget(
                    validator, study, budget_roster[cell["attempt_sha256"]], look, label=plan.look,
                    clock=budget_clock, horizon=horizon, caps=caps)
                usable = usable and budget["selected_look_budget"]["status"] == "within_registered_budget"
            arms.append({"teacher": name, "attempt_sha256": cell["attempt_sha256"], "report_sha256": receipt_pin,
                         "report_owner_close_sha256": owner_close, "terminal_receipt_sha256": paid["closeout_receipt_sha256"],
                         "decision": _wire(paid["decision"]), "confirmation_budget_block": paid["confirmation_budget_block"],
                         "usable_for_screen": usable, **budget})

        grouped = {group: [] for group in grouping}
        rows = []
        for (row_id, group, language), left, right in zip(study.panel, *row_facts, strict=True):
            if left is not None and right is not None:
                _require(left[:2] == right[:2], "teacher candidates must share the evaluator's legal and formal eligibility")
            first = left if left is not None else right
            if first is None or first[0]:
                grouped[group].append(tuple(finding if arm["usable_for_screen"] else None
                                            for finding, arm in zip((left, right), arms, strict=True)))
            rows.append((row_id, group, language, left, right))
        groups = {key: _complementarity_group(values) for key, values in grouped.items()}
        seed_reports.append({"seed": seed.identifier, "arms": tuple(arms), "rows": tuple(rows), "groups": groups})

    directional = {direction: tuple(group for group in grouping
                                      if all(seed["groups"][group] == direction for seed in seed_reports))
                   for direction in ("left", "right")}
    supported = all(len(groups) >= plan.minimum_groups_per_direction for groups in directional.values())
    return {"schema": "reviewed-development-teacher-complementarity-screen/v1", "plan_sha256": expected_plan_sha256,
            "matrix_projection_sha256": commitment(projected), "paid_comparison_sha256": expected_comparison_sha256,
            "paid_cost_evidence_sha256": projected["cost_evidence_sha256"], "evidence_kind": projected["evidence_kind"],
            "teacher_profiles": tuple((name, *profiles[name]) for name in plan.teachers),
            "configuration_sha256": config, "look": plan.look, "optimizer_steps": steps[plan.look],
            "budget_qualification": {
                "scope": "original_paid_look_budget" if budget_selected else "exploratory_budget_unverified",
                "clock": budget_clock, "horizon_seconds": horizon, "binding_sha256": expected_budget_sha256},
            "group_support_across_all_seeds": directional, "screen_criterion_met": supported,
            "native_support_for_fusion_hypothesis": (
                supported if budget_selected and projected["evidence_kind"] == "native_reviewed" else None),
            "row_fields": ("review_eligible", "formal_required", "source_fidelity", "formal_validity", "coverage", "abstention", "joint_success"),
            "per_seed": tuple(seed_reports)}


PAIRED_FINAL_PLAN_SCHEMA = "reviewed-paired-final-panel-plan/v1"
PAIRED_FINAL_EVIDENCE_SCHEMA = "reviewed-paired-final-panel-evidence/v1"
PAIRED_FINAL_SCHEMA = "reviewed-paired-final-panel/v1"


@dataclass(frozen=True)
class PairedFinalSampling:
    independently_sampled_seed_and_group_frame_sha256: str
    alpha: Fraction


@dataclass(frozen=True)
class PairedFinalPlan:
    matrix_sha256: str
    contrast_id: str
    clock: str
    final_policy_sha256: str
    panel: tuple[tuple[str, str, str], ...]
    case_aliases: tuple[tuple[str, str], ...]
    fidelity_eligible: tuple[str, ...]
    cutoffs: tuple[tuple[str, Fraction], ...]
    retention_references: tuple[tuple[str, str | None, str | None], ...]  # Seed, checkpoint, shared reference.
    sampling: PairedFinalSampling | None = None


@dataclass(frozen=True)
class PairedFinalCell:
    seed: str
    arm: str
    development_receipt: DevelopmentReceipt | None = None
    frozen_checkpoint: dict | None = None
    final_resources: dict | None = None
    final_decision: dict | None = None
    final_report: dict | None = None
    final_case_aliases_sha256: str | None = None


def paired_final_plan_commitment(validator, plan):
    _require(type(plan) is PairedFinalPlan and all(_pin(pin) for pin in (plan.matrix_sha256, plan.final_policy_sha256))
             and _name(plan.contrast_id) and plan.clock in COVERED_CLOCKS
             and _final_panel_cutoffs(validator, plan.panel, plan.cutoffs)
             and type(plan.case_aliases) is tuple and all(type(item) is tuple and len(item) == 2
                 and all(_name(name) for name in item) for item in plan.case_aliases)
             and len({member for _, member in plan.case_aliases}) == len(plan.case_aliases)
             and type(plan.fidelity_eligible) is tuple and plan.fidelity_eligible
             and all(_name(row) for row in plan.fidelity_eligible)
             and type(plan.retention_references) is tuple and all(type(item) is tuple and len(item) == 3
                 and _name(item[0]) and (item[1] is None or _pin(item[1]))
                 and (item[2] is None or _pin(item[1]) and _pin(item[2])) for item in plan.retention_references)
             and (plan.sampling is None or type(plan.sampling) is PairedFinalSampling
                  and _pin(plan.sampling.independently_sampled_seed_and_group_frame_sha256)
                  and type(plan.sampling.alpha) is Fraction and 0 < plan.sampling.alpha < 1),
             "preselected final contrast, held-out aliases, eligibility and baseline roster required")
    order = tuple(row[0] for row in plan.panel)
    _require(tuple(alias for alias, _ in plan.case_aliases) == order
             and tuple(row for row in order if row in plan.fidelity_eligible) == plan.fidelity_eligible,
             "final source aliases and fidelity eligibility must retain the exact frozen order")
    return commitment((PAIRED_FINAL_PLAN_SCHEMA, plan))


def paired_final_evidence_commitment(plan_sha256, projection_sha256, cells):
    _require(_pin(plan_sha256) and _pin(projection_sha256) and type(cells) is tuple
             and all(type(cell) is PairedFinalCell and _name(cell.seed) and _name(cell.arm) for cell in cells),
             "exact ordered paired final cells required")
    return commitment((PAIRED_FINAL_EVIDENCE_SCHEMA, plan_sha256, projection_sha256, cells))


def _final_pair_slots(plan, projected, comparison, matrix, study):
    named = _one_final_row(projected.get("contrasts"), lambda row: row.get("contrast_id") == plan.contrast_id,
                           "exact preselected projected contrast required")
    records = named.get("pairs")
    original = comparison.get("pairs")
    _require(all(type(value) in (tuple, list) and all(type(row) is dict for row in value)
                 for value in (records, original)),
             "exact original paired development records required")
    records = tuple(row for row in records if row.get("clock") == plan.clock)
    original = tuple(row for row in original if (row.get("contrast_id"), row.get("clock")) == (plan.contrast_id, plan.clock))
    _require(commitment(records) == commitment(original),
             "projected final contrast must preserve its exact original paid rows and direction")
    expected_seeds = tuple(seed.identifier for seed in study.seeds)
    _require(tuple(row.get("seed") for row in records) == expected_seeds and len(records) >= 2,
             "final panel must keep every original seed at its selected analysis clock")
    before, after = records[0].get("baseline"), records[0].get("candidate")
    horizon = study.horizons[COVERED_CLOCKS.index(plan.clock)]
    _require(_name(before) and _name(after) and before != after
             and all((row.get("contrast_id"), row.get("baseline"), row.get("candidate"), row.get("horizon"))
                    == (plan.contrast_id, before, after, horizon) for row in records),
             "both original arm directions are required for every seed")
    joined = []
    for record in records:
        for role, arm in (("baseline", before), ("candidate", after)):
            seed = record["seed"]
            item = _one_final_row(matrix.get("attempts"), lambda row: (row.get("seed"), row.get("arm")) == (seed, arm),
                                  "one original matrix attempt required for each paired final cell")
            compared = _one_final_row(comparison.get("attempts"),
                                      lambda row: (row.get("seed"), row.get("arm")) == (seed, arm),
                                      "one original paid development attempt required for each paired final cell")
            state, reason = record.get(role + "_attained"), record.get(role + "_reason")
            _require(_pin(item.get("attempt_sha256")) and item["attempt_sha256"] == compared.get("attempt_sha256")
                     == record.get(role + "_attempt_sha256")
                     and (state is None or type(state) is int and state in (0, 1)) and _name(reason),
                     "original matrix and paid development slots disagree")
            joined.append((seed, arm, item, state, reason))
    _require(len({item["attempt_sha256"] for _, _, item, _, _ in joined}) == len(joined),
             "distinct original attempts required for both arms of every seed")
    return joined


def _paired_cell(validator, plan, cell, slot, *, study, design, comparison, comparison_sha, verify_checkpoint_owner,
                 evidence_kind, expected_baseline, expected_retention_reference):
    seed, arm, native, development, reason = slot
    _require((cell.seed, cell.arm) == (seed, arm), "paired final cells must exhaust the original ordered seed and arm slots")
    frozen = cell.frozen_checkpoint
    header = {"seed": seed, "arm": arm, "attempt_sha256": native["attempt_sha256"],
              "development_attainment": development, "development_disposition": reason,
              "frozen_checkpoint_sha256": None, "final_resources_sha256": None, "final_decision_sha256": None,
              "final_report_sha256": None, "gate_counts": None, "gates": None}
    if frozen is None:
        _require(all(value is None for value in (
            cell.development_receipt, cell.final_resources, cell.final_decision, cell.final_report,
            cell.final_case_aliases_sha256)),
            "unfrozen cell cannot supply paid final or reviewed findings")
        status = "eligible_final_evidence_unavailable" if development == 1 else "development_not_eligible"
        return {**header, "status": status}, (None,) * len(plan.fidelity_eligible)
    _require(development == 1 and type(frozen) is dict, "final checkpoint must come from an eligible original attempt")
    study_sha = commitment(study)
    freeze_plan = FinalCheckpointPlan(study_sha, development_design_commitment(design), arm, seed, plan.clock, plan.final_policy_sha256)
    issued = freeze_final_checkpoint(validator, study=study, development_design=design, plan=freeze_plan,
        expected_plan_sha256=final_checkpoint_plan_commitment(freeze_plan), comparison=comparison,
        expected_comparison_sha256=comparison_sha, development_receipt=cell.development_receipt,
        verify_final_owner=verify_checkpoint_owner)
    _require(commitment(frozen) == commitment(issued)
             and all(frozen.get(key) == native.get(key) for key in (
                 "attempt_sha256", "native_arm", "native_seed", "packet_sha256", "trial_sha256", "recipe_sha256")),
             "final freeze must use the exact authenticated native matrix checkpoint and original confirmation")
    return _paired_cell_outcome(validator, plan, cell, header, frozen, study_sha=study_sha,
        comparison_sha=comparison_sha, attempt_sha=native["attempt_sha256"], evidence_kind=evidence_kind,
        aliases_sha=commitment(plan.case_aliases), expected_baseline=expected_baseline,
        expected_retention_reference=expected_retention_reference)


def _paired_cell_outcome(validator, plan, cell, header, frozen, *, study_sha, comparison_sha, attempt_sha,
        evidence_kind, aliases_sha, expected_baseline, expected_retention_reference, compact=False):
    resources, decision, report = cell.final_resources, cell.final_decision, cell.final_report
    resource_schema = COMPACT_FINAL_RESOURCE_RESULT_SCHEMA if compact else FINAL_RESOURCE_RESULT_SCHEMA
    decision_schema = COMPACT_FINAL_DECISION_SCHEMA if compact else FINAL_DECISION_SCHEMA
    report_schema = COMPACT_FINAL_PANEL_REPORT_SCHEMA if compact else FINAL_PANEL_REPORT_SCHEMA
    header["frozen_checkpoint_sha256"] = commitment(frozen)
    if resources is None:
        _require(decision is None and report is None and cell.final_case_aliases_sha256 is None,
                 "unmetered final scope cannot supply a decision or findings")
        return {**header, "status": "frozen_final_evidence_unavailable"}, (None,) * len(plan.fidelity_eligible)
    if compact and decision is None:
        _require(type(resources) is dict and resources.get("schema") == resource_schema
                 and resources.get("development_comparison_sha256") == comparison_sha
                 and _activation_charge_metadata(resources) == _activation_charge_metadata(frozen)
                 and _pin(resources.get("final_resource_plan_sha256"))
                 and _pin(resources.get("final_resource_evidence_sha256"))
                 and type(resources.get("activities")) in (tuple, list)
                 and any(type(row) is dict and type(row.get("activity")) is dict
                         and (row["activity"].get("role"), row["activity"].get("frozen_checkpoint_sha256"),
                              row["activity"].get("checkpoint_sha256"))
                             == ("candidate", header["frozen_checkpoint_sha256"], frozen["candidate_sha256"])
                         for row in resources["activities"])
                 and report is None and cell.final_case_aliases_sha256 is None,
                 "compact paid slot without a decision must retain only exact resource evidence")
        return {**header, "final_resources_sha256": commitment(resources),
                "status": "paid_final_decision_unavailable"}, (None,) * len(plan.fidelity_eligible)
    _require(type(resources) is dict and resources.get("schema") == resource_schema
             and resources.get("development_comparison_sha256") == comparison_sha
             and type(decision) is dict and decision.get("schema") == decision_schema
             and _activation_charge_metadata(resources) == _activation_charge_metadata(decision)
                 == _activation_charge_metadata(frozen)
             and (decision.get("study_sha256"), decision.get("development_comparison_sha256"),
                  decision.get("evidence_kind"), decision.get("checkpoint_sha256"), decision.get("frozen_checkpoint_sha256"),
                  decision.get("final_panel_sha256"), decision.get("final_policy_sha256"), decision.get("final_resources_sha256"))
                 == (study_sha, comparison_sha, evidence_kind, frozen.get("candidate_sha256"), commitment(frozen),
                     commitment(plan.panel), plan.final_policy_sha256, commitment(resources))
             and decision.get("final_resource_plan_sha256") == resources.get("final_resource_plan_sha256")
             and _pin(decision.get("final_decision_plan_sha256"))
             and commitment(decision.get("cutoffs")) == commitment(plan.cutoffs),
             "exact final decision, paid result and common final policy required")
    selected = _one_final_row(resources.get("activities"), lambda row: type(row.get("activity")) is dict and
                   row["activity"].get("evaluation_sha256") == decision.get("final_evaluation_sha256"),
                   "paid result must retain the exact selected final evaluation")
    activity = selected["activity"]
    closes = selected.get("component_owner_close_sha256s")
    _require(activity.get("role") == "candidate" and activity.get("checkpoint_sha256") == frozen["candidate_sha256"]
             and activity.get("frozen_checkpoint_sha256") == commitment(frozen)
             and _pin(activity.get("evaluation_sha256"))
             and _pin(selected.get("terminal_close_sha256"))
             and selected["terminal_close_sha256"] == decision.get("final_terminal_close_sha256")
             and type(closes) in (list, tuple) and all(_pin(close) for close in closes)
             and len(set(closes)) == len(closes) and selected["terminal_close_sha256"] not in closes
             and type(selected.get("status")) is str and selected["status"] in CLOSED_EVENT_OUTCOMES
             and selected["status"] == decision.get("final_status"),
             "paired final decision and paid closure disagree on the original final activity")
    status = decision.get("decision")
    header.update(final_resources_sha256=commitment(resources), final_decision_sha256=commitment(decision),
                  terminal_close_sha256=selected["terminal_close_sha256"], component_owner_close_sha256s=tuple(closes),
                  terminal_status=selected["status"], status=status)
    if selected["status"] != "complete":
        _require(status == "final_evaluation_incomplete" and report is None and cell.final_case_aliases_sha256 is None
                 and all(key in decision and decision[key] is None for key in ("final_report_sha256", "gate_counts", "gates"))
                 and "report_sha256" in selected and selected["report_sha256"] is None,
                 "incomplete final closure cannot supply authenticated comparisons")
        if compact:
            _require("retention_reference_sha256" in decision and decision["retention_reference_sha256"] is None,
                     "incomplete compact final closure cannot supply a retention finding")
        return header, (None,) * len(plan.fidelity_eligible)
    _require(type(report) is dict and report.get("schema") == report_schema
             and commitment(report) == decision.get("final_report_sha256") == selected.get("report_sha256")
             and (report.get("study_sha256"), report.get("trained_attempt_sha256"), report.get("frozen_checkpoint_sha256"),
                  report.get("checkpoint_sha256"), report.get("final_panel_sha256"), report.get("final_policy_sha256"),
                  report.get("baseline_checkpoint_sha256"), report.get("final_evaluation_sha256"), report.get("final_terminal_close_sha256"))
                 == (study_sha, attempt_sha, commitment(frozen), frozen["candidate_sha256"], commitment(plan.panel),
                     plan.final_policy_sha256, expected_baseline, activity["evaluation_sha256"], selected["terminal_close_sha256"])
             and cell.final_case_aliases_sha256 == aliases_sha
             and commitment(decision.get("gate_counts")) == commitment(report.get("counts"))
             and status in ("cutoffs_passed", "cutoffs_failed", "cutoffs_unavailable"),
             "complete result must use the exact paid issued final report, eligibility and reserved source crosswalk")
    reference = report.get("retention_reference_sha256")
    if compact:
        _require(report.get("evidence_kind") == evidence_kind
                 and type(report.get("optimizer_steps")) is int
                 and all(report.get(key) == frozen.get(key) for key in (
                     "terminal_selection_sha256", "optimizer_step_grid_sha256", "optimizer_steps"))
                 and report.get("split_manifest_sha256") == frozen.get("global_split_sha256")
                 and report.get("dependency_group_sha256") == plan.panel[0][1]
                 and "retention_reference_sha256" in resources
                 and reference == resources["retention_reference_sha256"],
                 "compact paired final report differs from its selected kind, pair, step, component or baseline")
    counts = report.get("counts")
    _require(type(counts) is dict and type(counts.get("retention")) is dict
             and reference == decision.get("retention_reference_sha256")
             and (reference is None and commitment(counts["retention"]) == commitment(validator.Counts(0, 0, False))
                  or _pin(reference) and reference == expected_retention_reference == resources.get("retention_reference_sha256")),
             "both paired arms must keep the same preselected retention reference or retain unavailable retention")
    component_reports = report.get("component_closes")
    _require(bool(closes) and type(component_reports) in (list, tuple)
             and all(type(row) is dict and all(_pin(row.get(key)) for key in (
                 "owner_close_sha256", "observation_sha256", "artifact_sha256")) for row in component_reports)
             and tuple(row["owner_close_sha256"] for row in component_reports) == tuple(closes),
             "complete paid result lacks its exact ordered component closures")
    reports = report.get("rows")
    _require(type(reports) in (list, tuple) and all(type(row) is dict
                 and type(row.get("review_eligible")) is bool and "source_fidelity" in row
                 and (row["source_fidelity"] is None or type(row["source_fidelity"]) is bool) for row in reports)
             and tuple(row.get("row_id") for row in reports) == tuple(row[0] for row in plan.panel)
             and tuple(row["row_id"] for row in reports if row["review_eligible"]) == plan.fidelity_eligible,
             "exact frozen fidelity eligibility and complete ordered final rows required")
    header.update(final_report_sha256=commitment(report), gate_counts=_wire(decision["gate_counts"]), gates=_wire(decision["gates"]))
    return header, tuple(row["source_fidelity"] for row in reports if row["review_eligible"])


def _paired_group_bounds(plan, seeds, values):
    columns = {row: index for index, row in enumerate(plan.fidelity_eligible)}
    groups = {}
    for row, dependency, _ in plan.panel:
        if row in columns:
            groups.setdefault(dependency, []).append(columns[row])
    bounds = []
    for seed, (before, after) in zip(seeds, zip(values[::2], values[1::2], strict=True), strict=True):
        for key, indices in groups.items():
            pairs = tuple((before[i], after[i]) for i in indices)
            point = sum(int(b is True) - int(a is True) for a, b in pairs)
            left = Fraction(point - sum(a is None for a, _ in pairs), len(indices))
            right = Fraction(point + sum(b is None for _, b in pairs), len(indices))
            bounds.append({"seed": seed, "dependency_group_sha256": key, "eligible_rows": len(indices),
                           "known_pairs": sum(a is not None and b is not None for a, b in pairs),
                           "fidelity_delta_bounds": (left, right)})
    lower, upper = (sum(row["fidelity_delta_bounds"][index] for row in bounds) / len(bounds) for index in (0, 1))
    confidence = None
    sampling = getattr(plan, "sampling", None)
    if sampling is not None:
        _require(len(seeds) >= 2 and len(groups) >= 2 and len(groups) == len({group for _, group, _ in plan.panel}),
                 "population inference needs independent seed and dependency-group replication on the complete sampled frame")
        alpha = sampling.alpha
        radius = sqrt(2 * (log(2 * alpha.denominator) - log(alpha.numerator)) * (1 / len(seeds) + 1 / len(groups)))
        confidence = {"method": "crossed_independent_seed_and_group_bounded_differences/v1",
                      "frame_sha256": sampling.independently_sampled_seed_and_group_frame_sha256,
                      "alpha": _wire(alpha), "radius": radius,
                      "interval": (max(-1., float(lower) - radius), min(1., float(upper) + radius))}
    return {"estimand": "candidate_minus_control_mean_with_equal_seed_and_dependency_group_weights",
            "missingness_scope": "finite_preselected_panel_and_seed_partial_identification",
            "seed_count": len(seeds), "dependency_groups": len(groups), "eligible_rows_per_seed": len(columns),
            "fidelity_delta_bounds": _wire((lower, upper)), "by_seed_and_group": _wire(bounds), "confidence": confidence}


def assemble_paired_final_panel(validator, *, plan, expected_plan_sha256, matrix, study, design, comparison,
                               projected, expected_projection_sha256, cells, expected_evidence_sha256,
                               verify_checkpoint_owner, verify_paired_final_owner):
    """Join existing paid final decisions for both members of a preselected contrast.

    The paired owner authenticates issued receipts, one reserved holdout crosswalk
    across all slots, independent source findings and per-scope paid evidence.
    If a sampling frame was selected, the owner verifies independent prospective
    seed/group draws and the declared error allocation for this contrast.
    """
    _require(callable(verify_checkpoint_owner) and callable(verify_paired_final_owner)
             and paired_final_plan_commitment(validator, plan) == expected_plan_sha256
             and type(matrix) is dict and matrix.get("schema") == MATCHED_MATRIX_SCHEMA
             and commitment(matrix) == plan.matrix_sha256 and type(comparison) is dict
             and comparison.get("schema") == VERIFIED_DEVELOPMENT_SCHEMA
             and type(projected) is dict and projected.get("schema") == MATCHED_MATRIX_COMPARISON_SCHEMA
             and commitment(projected) == expected_projection_sha256 and projected.get("matrix_sha256") == plan.matrix_sha256
             and projected.get("development_comparison_sha256") == commitment(comparison)
             and projected.get("evidence_kind") == matrix.get("evidence_kind")
             and projected.get("optimizer_step_grid_sha256") == comparison.get("optimizer_step_grid_sha256")
             and _capture_approval_metadata(projected) == _capture_approval_metadata(comparison)
             and _activation_charge_metadata(projected) == _activation_charge_metadata(comparison)
             and all(matrix.get(key) == comparison.get(key) for key in (
                 "study_sha256", "development_design_sha256", "contrast_plan_sha256")),
             "exact preselected paired panel and issued matrix comparison required")
    evidence = paired_final_evidence_commitment(expected_plan_sha256, expected_projection_sha256, cells)
    _require(evidence == expected_evidence_sha256
             and development_design_commitment(design) == matrix["development_design_sha256"]
             and design.study_sha256 == matrix["study_sha256"] and len(plan.panel) == design.reserved_final_count,
             "exact paired evidence and untouched final reservation required")
    _, horizons, _ = _study(validator, study, matrix["study_sha256"])
    seeds = tuple(row.identifier for row in study.seeds)
    _require(tuple(seed for seed, _, _ in plan.retention_references) == seeds,
             "preselected final retention references must retain the exact seed roster")
    slots = _final_pair_slots(plan, projected, comparison, matrix, study)
    _require(horizons[plan.clock] is not None and len(cells) == len(slots),
             "both final evidence slots for each preselected seed are required")
    baseline = {seed: (checkpoint, reference) for seed, checkpoint, reference in plan.retention_references}
    comparison_sha = commitment(comparison)
    selected_cells, selected_comparison = deepcopy((cells, comparison))
    results, observations, evaluation_ids, closes = [], [], set(), set()
    for cell, slot in zip(selected_cells, slots, strict=True):
        checkpoint, baseline_reference = baseline[slot[0]]
        result, findings = _paired_cell(validator, plan, cell, slot, study=study, design=design, comparison=selected_comparison,
            comparison_sha=comparison_sha, verify_checkpoint_owner=verify_checkpoint_owner,
            evidence_kind=matrix["evidence_kind"], expected_baseline=checkpoint, expected_retention_reference=baseline_reference)
        if cell.final_decision is not None:
            evaluation = cell.final_decision["final_evaluation_sha256"]
            activity_closes = (result["terminal_close_sha256"], *result["component_owner_close_sha256s"])
            _require(evaluation not in evaluation_ids and not closes.intersection(activity_closes),
                     "one physical final evaluation or selected closure cannot fill two paired slots")
            evaluation_ids.add(evaluation)
            closes.update(activity_closes)
        results.append(result)
        observations.append(findings)
    grouped = _paired_group_bounds(plan, seeds, observations)
    _require(verify_paired_final_owner(expected_plan_sha256, expected_evidence_sha256, comparison_sha) is True
             and paired_final_plan_commitment(validator, plan) == expected_plan_sha256
             and paired_final_evidence_commitment(expected_plan_sha256, expected_projection_sha256, cells) == evidence
             and commitment(matrix) == plan.matrix_sha256 and commitment(comparison) == comparison_sha
             and commitment(projected) == expected_projection_sha256
             and commitment(study) == matrix["study_sha256"]
             and development_design_commitment(design) == matrix["development_design_sha256"],
             "paired final owner refused or exact paired evidence changed")
    return {"schema": PAIRED_FINAL_SCHEMA, "paired_final_plan_sha256": expected_plan_sha256,
            "paired_final_evidence_sha256": evidence, "matrix_sha256": plan.matrix_sha256,
            "development_comparison_sha256": comparison_sha, "projection_sha256": expected_projection_sha256,
            "evidence_kind": matrix["evidence_kind"], "contrast_id": plan.contrast_id, "eligible_clock": plan.clock,
            "final_panel_sha256": commitment(plan.panel), "final_policy_sha256": plan.final_policy_sha256,
            "final_cost_scope": "original_verified_per_slot_receipts_only", "cells": tuple(results), "fidelity": grouped,
            **_activation_charge_metadata(comparison)}


COMPACT_PAIRED_FINAL_PLAN_SCHEMA = "reviewed-compact-paired-final-panel-plan/v1"
COMPACT_PAIRED_FINAL_EVIDENCE_SCHEMA = "reviewed-compact-paired-final-panel-evidence/v1"
COMPACT_PAIRED_FINAL_SCHEMA = "reviewed-compact-paired-final-panel/v1"
COMPACT_PAIRED_PAID_WORK_SCHEMA = "reviewed-compact-paired-paid-work/v1"


@dataclass(frozen=True)
class CompactPairedFinalPlan:
    study_sha256: str
    development_design_sha256: str
    contrast_plan_sha256: str
    contrast_id: str
    clock: str
    evidence_kind: str
    final_policy_sha256: str
    panel: tuple[tuple[str, str, str], ...]
    fidelity_eligible: tuple[str, ...]
    cutoffs: tuple[tuple[str, Fraction], ...]
    retention_references: tuple[tuple[str, str | None, str | None], ...]


@dataclass(frozen=True)
class CompactPairedFinalCell(PairedFinalCell):
    terminal_cell: tuple[dict, dict] | None = None


def compact_paired_final_plan_commitment(validator, plan):
    _require(type(plan) is CompactPairedFinalPlan and all(_pin(value) for value in (
                 plan.study_sha256, plan.development_design_sha256, plan.contrast_plan_sha256, plan.final_policy_sha256))
             and _name(plan.contrast_id) and plan.clock in COVERED_CLOCKS
             and type(plan.evidence_kind) is str and plan.evidence_kind in ("fictional_fixture", "native_reviewed")
             and _final_panel_cutoffs(validator, plan.panel, plan.cutoffs)
             and len({group for _, group, _ in plan.panel}) == 1
             and type(plan.fidelity_eligible) is tuple and bool(plan.fidelity_eligible)
             and all(_name(row) for row in plan.fidelity_eligible)
             and tuple(row[0] for row in plan.panel if row[0] in plan.fidelity_eligible) == plan.fidelity_eligible
             and type(plan.retention_references) is tuple
             and all(type(item) is tuple and len(item) == 3 and _name(item[0])
                     and (item[1] is None or _pin(item[1]))
                     and (item[2] is None or _pin(item[1]) and _pin(item[2])) for item in plan.retention_references),
             "preselected compact contrast, single final component, fidelity roster and shared baseline policy required")
    return commitment((COMPACT_PAIRED_FINAL_PLAN_SCHEMA, plan))


def compact_paired_final_evidence_commitment(plan_sha256, comparison_sha256, cells):
    _require(_pin(plan_sha256) and _pin(comparison_sha256) and type(cells) is tuple
             and all(type(cell) is CompactPairedFinalCell and _name(cell.seed) and _name(cell.arm) for cell in cells),
             "exact ordered compact final evidence slots required")
    return commitment((COMPACT_PAIRED_FINAL_EVIDENCE_SCHEMA, plan_sha256, comparison_sha256, cells))


def _compact_final_pair_slots(plan, comparison, study, seeds, horizon):
    contrast = _one_final_row(comparison.get("contrasts"), lambda row: row.get("identifier") == plan.contrast_id,
                              "exact preselected compact development contrast required")
    arms = dict(study.arms)
    before, after = contrast.get("baseline"), contrast.get("candidate")
    _require(_name(before) and _name(after) and before in arms and after in arms and before != after,
             "compact final comparison requires distinct registered arms")
    records = comparison.get("pairs")
    attempts = comparison.get("attempts")
    _require(type(records) in (tuple, list) and all(type(row) is dict for row in records)
             and type(attempts) in (tuple, list) and all(type(row) is dict and _pin(row.get("attempt_sha256"))
                                                         for row in attempts)
             and tuple((row.get("seed"), row.get("arm")) for row in attempts)
                 == tuple((seed, arm) for seed in seeds for arm in arms)
             and len({row["attempt_sha256"] for row in attempts}) == len(attempts),
             "compact final comparison must retain the complete original development attempt roster")
    paired = tuple(row for row in records if (row.get("contrast_id"), row.get("clock")) == (plan.contrast_id, plan.clock))
    _require(tuple(row.get("seed") for row in paired) == seeds
             and all((row.get("baseline"), row.get("candidate"), row.get("horizon")) == (before, after, horizon)
                     for row in paired),
             "compact final slots must use every original seed at the same contrast, direction and horizon")
    attempts_by_cell = {(row["seed"], row["arm"]): row for row in attempts}
    slots = []
    for pair in paired:
        for role, arm in (("baseline", before), ("candidate", after)):
            seed = pair["seed"]
            attempt = attempts_by_cell[(seed, arm)]
            attainment, reason = pair.get(role + "_attained"), pair.get(role + "_reason")
            _require(attempt["attempt_sha256"] == pair.get(role + "_attempt_sha256")
                     and (attainment is None or type(attainment) is int and attainment in (0, 1))
                     and _name(reason),
                     "compact final slot differs from the original paid development attempt")
            slots.append((seed, arm, attempt["attempt_sha256"], attainment, reason))
    return paired, tuple(slots)


def _compact_paired_cell(validator, plan, cell, slot, *, study, design, step_grid, comparison, comparison_sha,
                         verify_checkpoint_owner, expected_baseline, expected_retention_reference):
    seed, arm, attempt_sha, attainment, reason = slot
    _require((cell.seed, cell.arm) == (seed, arm), "compact final cells must retain the original ordered seed and arm slots")
    header = {"seed": seed, "arm": arm, "attempt_sha256": attempt_sha,
              "development_attainment": attainment, "development_disposition": reason,
              "frozen_checkpoint_sha256": None, "final_resources_sha256": None, "final_decision_sha256": None,
              "final_report_sha256": None, "gate_counts": None, "gates": None}
    frozen = cell.frozen_checkpoint
    if frozen is None:
        _require(all(item is None for item in (cell.development_receipt, cell.terminal_cell, cell.final_resources,
                                              cell.final_decision, cell.final_report, cell.final_case_aliases_sha256)),
                 "unfrozen compact slot cannot supply terminal evidence or final findings")
        status = "eligible_final_evidence_unavailable" if attainment == 1 else "development_not_eligible"
        return {**header, "status": status}, (None,) * len(plan.fidelity_eligible)
    _require(attainment == 1 and type(frozen) is dict,
             "compact final checkpoint must come from an eligible original attempt")
    freeze_plan = FinalCheckpointPlan(plan.study_sha256, plan.development_design_sha256, arm, seed,
                                      plan.clock, plan.final_policy_sha256)
    issued = freeze_compact_final_checkpoint(validator, study=study, development_design=design, step_grid=step_grid,
        plan=freeze_plan, expected_plan_sha256=final_checkpoint_plan_commitment(freeze_plan), comparison=comparison,
        expected_comparison_sha256=comparison_sha, development_receipt=cell.development_receipt,
        terminal_cell=cell.terminal_cell, verify_final_owner=verify_checkpoint_owner)
    _require(commitment(issued) == commitment(frozen) and frozen["attempt_sha256"] == attempt_sha,
             "compact paired final slot must retain the exact confirming checkpoint and terminal pair")
    aliases = commitment(tuple((row, row) for row, _, _ in plan.panel))
    return _paired_cell_outcome(validator, plan, cell, header, frozen, study_sha=plan.study_sha256,
        comparison_sha=comparison_sha, attempt_sha=attempt_sha, evidence_kind=plan.evidence_kind,
        aliases_sha=aliases, expected_baseline=expected_baseline,
        expected_retention_reference=expected_retention_reference, compact=True)


def _compact_paired_activation_identities(comparison):
    metadata = _activation_charge_metadata(comparison)
    events = comparison.get("physical_paid_events")
    if not metadata:
        observed = type(events) in (tuple, list) and any(
            type(row) is dict and row.get("kind") == ACTIVATION_EVENT_KIND for row in events)
        _require("activation_diagnostic_charges" not in comparison and not observed,
                 "paired compact diagnostic costs require the original selected commitment")
        return {}
    looks = comparison.get("development_looks")
    _require(type(events) in (tuple, list)
             and all(type(row) is dict and set(row) == set(PaidEvent.__dataclass_fields__) for row in events)
             and type(looks) in (tuple, list) and all(type(row) is dict for row in looks),
             "paired compact diagnostic costs require exact original events and observed looks")
    prior = _event_roster(tuple(PaidEvent(**row) for row in events))
    diagnostics = _check_compact_development_activation(comparison, comparison["attempts"], prior, looks)
    return {row.event_sha256: row.owner_close_sha256 for row in diagnostics}


def _check_compact_paired_activation_reuse(resources, inherited):
    if resources is None or not inherited:
        return
    events, activities = (resources.get(key) for key in ("physical_paid_events", "activities"))
    inherited_closes = set(inherited.values())
    _require(type(events) in (list, tuple) and all(
        type(row) is dict and _pin(row.get("event_sha256")) and _pin(row.get("close_receipt_sha256"))
        and row.get("kind") != ACTIVATION_EVENT_KIND and row["event_sha256"] not in inherited
        and row["close_receipt_sha256"] not in inherited_closes for row in events),
        "paired compact final events cannot recharge a development activation diagnostic")
    _require(type(activities) in (list, tuple) and all(
        type(row) is dict and _pin(row.get("terminal_close_sha256"))
        and type(row.get("component_owner_close_sha256s")) in (list, tuple)
        and all(_pin(close) for close in row["component_owner_close_sha256s"])
        and inherited_closes.isdisjoint((row["terminal_close_sha256"], row.get("baseline_receipt_sha256"),
                                         *row["component_owner_close_sha256s"])) for row in activities),
        "paired compact final closure cannot reuse a development activation diagnostic")


def compact_paired_paid_work_commitment(plan_sha256, comparison_sha256, evidence_sha256, *,
                                       shared_baseline_activity_sha256s=()):
    """Select exact paired receipts and the original baseline work they share."""
    shared = shared_baseline_activity_sha256s
    _require(all(_pin(value) for value in (plan_sha256, comparison_sha256, evidence_sha256))
             and type(shared) is tuple and all(_pin(value) for value in shared)
             and shared == tuple(sorted(set(shared))),
             "exact compact paired paid-work selections and ordered shared baseline activities required")
    return commitment((COMPACT_PAIRED_PAID_WORK_SCHEMA, plan_sha256, comparison_sha256, evidence_sha256, shared))


def _compact_paid_event_roster(receipt):
    wire = receipt.get("physical_paid_events")
    _require(type(wire) in (tuple, list) and bool(wire)
             and all(type(row) is dict and set(row) == set(PaidEvent.__dataclass_fields__) for row in wire),
             "complete original physical paid-event roster required")
    events = _event_roster(tuple(PaidEvent(**row) for row in wire))
    _require(len({event.close_receipt_sha256 for event in events.values()}) == len(events)
             and commitment(receipt.get("physical_work_ns")) == commitment(_physical_work_ns(events)),
             "original paid-event closes and additive counters must reconcile")
    return events


def _compact_final_paid_activity(row, events):
    activity, charges, meter = (row.get(key) for key in ("activity", "charged_events", "meter"))
    _require(type(activity) is dict and set(activity) == set(FinalActivity.__dataclass_fields__)
             and activity["role"] in ("candidate", "baseline")
             and all(_pin(activity[key]) for key in (
                 "evaluation_sha256", "frozen_checkpoint_sha256", "checkpoint_sha256"))
             and type(charges) is dict and set(charges) == set(ChargeManifest.__dataclass_fields__)
             and type(meter) is dict and set(meter) == set(Meter.__dataclass_fields__),
             "original compact final activity, meter and allocations required")
    evaluation = activity["evaluation_sha256"]
    entries, components = charges["entries"], row.get("component_owner_close_sha256s")
    status, terminal, baseline_result = (row.get(key) for key in (
        "status", "terminal_close_sha256", "baseline_receipt_sha256"))
    _require(charges["attempt_sha256"] == meter["attempt_sha256"] == evaluation
             and charges["stage"] == meter["stage"] == "close" and meter["scope"] == FINAL_RESOURCE_SCOPE
             and meter["includes_failed_attempts"] is True and _pin(meter["cost_policy_sha256"])
             and meter["charge_manifest_sha256"] == commitment(charges)
             and type(entries) in (tuple, list) and bool(entries)
             and all(type(entry) in (tuple, list) and len(entry) == 2 and _pin(entry[0])
                     and type(entry[1]) in (list, tuple) and len(entry[1]) == 2
                     and all(type(value) is int and value > 0 for value in entry[1]) for entry in entries)
             and type(status) is str and status in CLOSED_EVENT_OUTCOMES and _pin(terminal)
             and type(components) in (tuple, list) and all(_pin(value) for value in components)
             and (baseline_result is None or _pin(baseline_result)),
             "compact final activity must retain its original closes and rational charge manifest")
    manifest = ChargeManifest(evaluation, "close", tuple((key, Fraction(*share)) for key, share in entries))
    shares = _event_shares(manifest, events, {})
    _require(commitment(manifest) == commitment(charges)
             and any(share == 1 and events[key].close_receipt_sha256 == terminal
                     and events[key].disposition == status for key, share in shares.items()),
             "compact final activity must include its exact terminal paid event")
    claims = [(terminal, "terminal"), *((close, "component") for close in components)]
    if baseline_result is not None:
        claims.append((baseline_result, "baseline_result"))
    _require(len({close for close, _ in claims}) == len(claims),
             "compact final activity close identities must be distinct")
    # The enclosing plan can change the interval and meter commitment. The
    # physical observations, clock receipts and original allocations must agree.
    signature = commitment((activity, status, claims, row.get("report_sha256"), row.get("wall"),
                            meter["cost_policy_sha256"], meter["costs"], meter["clock_receipts"], manifest))
    return activity, shares, claims, signature


def _compact_paired_paid_work(cells, comparison, baseline, *, selected_shared):
    development = _compact_paid_event_roster(comparison)
    prior = set(development) | {event.close_receipt_sha256 for event in development.values()}
    for roster, keys in (("attempts", ("attempt_sha256", "closeout_receipt_sha256")),
                         ("development_looks", ("owner_close_sha256", "terminal_owner_close_sha256",
                                                "component_owner_close_sha256", "evaluation_receipt_sha256"))):
        rows = comparison.get(roster)
        _require(type(rows) in (tuple, list) and all(type(row) is dict and all(_pin(row.get(key)) for key in keys)
                     for row in rows), "complete original compact development custody roster required")
        prior.update(row[key] for row in rows for key in keys)

    for cell in cells:
        if cell.final_report is not None:
            reservation = cell.final_report.get("reservation_close_sha256")
            _require(_pin(reservation), "original compact final reservation required")
            prior.add(reservation)

    activities, activity_closes, events, consumers, paid_closes = {}, {}, {}, {}, {}
    shared, resource_slots = set(), []
    for cell in cells:
        receipt = cell.final_resources
        if receipt is None:
            continue
        resource_slots.append((cell.seed, cell.arm))
        local_events = _compact_paid_event_roster(receipt)
        allocations = {event: {} for event in local_events}
        checkpoint, reference = baseline[cell.seed]
        selected_reference = receipt.get("retention_reference_sha256")
        _require(selected_reference in (None, reference) and "retention_reference_sha256" in receipt
                 and type(receipt.get("activities")) in (tuple, list) and bool(receipt["activities"])
                 and all(type(row) is dict for row in receipt["activities"]),
                 "compact paid work must use the preselected retention scope and final activities")
        local_activities = set()
        for row in receipt["activities"]:
            activity, shares, claims, signature = _compact_final_paid_activity(row, local_events)
            evaluation = activity["evaluation_sha256"]
            role = activity["role"]
            _require(evaluation not in local_activities and
                     (role == "candidate" and (activity["frozen_checkpoint_sha256"], activity["checkpoint_sha256"])
                      == (commitment(cell.frozen_checkpoint), cell.frozen_checkpoint["candidate_sha256"])
                      or role == "baseline" and activity["checkpoint_sha256"] == checkpoint),
                     "each compact paid activity must match one original slot and selected checkpoint")
            local_activities.add(evaluation)
            scope = (cell.seed, checkpoint, reference) if role == "baseline" and _pin(selected_reference) else None
            if evaluation in activities:
                _require(evaluation in selected_shared and scope is not None
                         and activities[evaluation] == (scope, signature),
                         "only original baseline work explicitly selected under the same retention scope may repeat")
                shared.add(evaluation)
            else:
                activities[evaluation] = scope, signature
            for close, kind in claims:
                _require(activity_closes.setdefault(close, (evaluation, kind)) == (evaluation, kind),
                         "one compact final activity close cannot identify different work")
            for event, share in shares.items():
                allocations[event][evaluation] = share
        for key, event in local_events.items():
            allocation = allocations[key]
            _require(sum(allocation.values()) == 1, "compact final paid events require conserved original allocations")
            if key in events:
                _require(events[key] == event and consumers[key] == allocation and set(allocation) <= shared,
                         "repeated compact final event must retain the same physical evidence and baseline consumers")
            else:
                events[key], consumers[key] = event, allocation
            _require(paid_closes.setdefault(event.close_receipt_sha256, key) == key,
                     "one compact final physical close cannot be charged under different event identities")

    _require(shared == set(selected_shared), "every selected shared baseline activity must be observed")
    _require(prior.isdisjoint(set(events) | set(paid_closes) | set(activities) | set(activity_closes))
             and set(events).isdisjoint(set(paid_closes) | set(activities) | set(activity_closes))
             and set(activities).isdisjoint(set(paid_closes) | set(activity_closes)),
             "compact final paid-work identities must stay separate from development, reservation and other evidence roles")
    for close in paid_closes.keys() & activity_closes.keys():
        evaluation, kind = activity_closes[close]
        _require(kind != "baseline_result" and evaluation in consumers[paid_closes[close]],
                 "compact paid event cannot borrow an unrelated activity or baseline result close")
    return {
        "schema": COMPACT_PAIRED_PAID_WORK_SCHEMA,
        "scope": "original_paid_development_and_observed_selected_final_slots",
        "slots_with_final_resources": tuple(resource_slots),
        "final_event_sha256s": tuple(sorted(events)),
        "observed_final_activity_count": len(activities),
        "shared_baseline_activity_sha256s": tuple(sorted(shared)),
        "development_work_ns": _physical_work_ns(development),
        "observed_final_work_ns": _physical_work_ns(events),
        "observed_development_and_final_work_ns": _physical_work_ns(development | events),
    }


def assemble_compact_paired_final_panel(validator, *, plan, expected_plan_sha256, study, design, step_grid,
        comparison, expected_comparison_sha256, cells, expected_evidence_sha256,
        verify_checkpoint_owner, verify_paired_final_owner, expected_paid_work_sha256=None, shared_baseline_activity_sha256s=()):
    """Join both compact arms per seed and bound fidelity on the fixed panel.

    The paired owner authenticates the issued paid comparison, preregistered
    contrast and final plan, common original holdout reservation and all
    issued final receipts. The optional fourth owner pin additionally selects
    observation coverage and the exact shared baseline activities (including
    any selected paid retries). It authenticates physical identity, reserved
    evidence and exclusive counters across scopes, including evidence absent
    from the compact wire and distinct receipts for the same process. The
    union summarizes additive work only. Wall observations stay per slot.
    """
    _require(callable(verify_checkpoint_owner) and callable(verify_paired_final_owner)
             and tuple(validator.CLOCKS) == COVERED_CLOCKS and _pin(expected_plan_sha256)
             and _pin(expected_comparison_sha256) and _pin(expected_evidence_sha256)
             and compact_paired_final_plan_commitment(validator, plan) == expected_plan_sha256
             and type(comparison) is dict and comparison.get("schema") == VERIFIED_COMPACT_DEVELOPMENT_SCHEMA
             and commitment(comparison) == expected_comparison_sha256
             and (comparison.get("study_sha256"), comparison.get("development_design_sha256"),
                  comparison.get("contrast_plan_sha256")) == (
                  plan.study_sha256, plan.development_design_sha256, plan.contrast_plan_sha256)
             and comparison.get("cost_basis") == "first_use" and comparison.get("reuse_count") is None
             and development_design_commitment(design) == plan.development_design_sha256
             and design.study_sha256 == plan.study_sha256 and len(plan.panel) == design.reserved_final_count,
             "exact verified compact comparison, preselected direction and untouched final reservation required")
    evidence_sha = compact_paired_final_evidence_commitment(expected_plan_sha256, expected_comparison_sha256, cells)
    _require(evidence_sha == expected_evidence_sha256, "independently pinned compact paired final slots required")
    owner_pins = (expected_plan_sha256, expected_evidence_sha256, expected_comparison_sha256)
    if expected_paid_work_sha256 is None:
        _require(shared_baseline_activity_sha256s == (), "shared baseline activities require selected paid-work evidence")
    else:
        _require(compact_paired_paid_work_commitment(expected_plan_sha256, expected_comparison_sha256, evidence_sha,
                     shared_baseline_activity_sha256s=shared_baseline_activity_sha256s) == expected_paid_work_sha256,
                 "independently selected compact paired paid-work evidence required")
        owner_pins += (expected_paid_work_sha256,)
    _, horizons, _ = _study(validator, study, plan.study_sha256)
    grid_sha = comparison.get("optimizer_step_grid_sha256")
    _require(_pin(grid_sha) and len(study.schedule) == 1 and study.cost_basis == "first_use"
             and horizons[plan.clock] is not None,
             "compact paired final requires the registered terminal step and first-use analysis clock")
    _selected_development_grid(study, plan.study_sha256, plan.development_design_sha256, step_grid, grid_sha)
    _require(commitment(comparison.get("optimizer_step_schedule")) == commitment(step_grid.steps),
             "compact paired final must retain the exact original optimizer step grid")
    seeds = tuple(seed.identifier for seed in study.seeds)
    _require(len(seeds) >= 2 and tuple(label for label, _, _ in plan.retention_references)
             == tuple(label for label, _, _ in design.seed_cohorts) == seeds,
             "compact paired final requires all registered seed and shared baseline slots")
    selected_plan, selected_study, selected_design, selected_grid, selected_comparison, selected_cells = deepcopy(
        (plan, study, design, step_grid, comparison, cells))
    records, slots = _compact_final_pair_slots(
        selected_plan, selected_comparison, selected_study, seeds, horizons[selected_plan.clock])
    activation_identities = _compact_paired_activation_identities(selected_comparison)
    _require(len(cells) == len(slots), "both compact final slots for every registered seed are required")
    baseline = {seed: (checkpoint, reference) for seed, checkpoint, reference in selected_plan.retention_references}

    def verify_checkpoint(*pins):
        accepted = verify_checkpoint_owner(*pins)
        _require(compact_paired_final_plan_commitment(validator, plan) == expected_plan_sha256,
                 "selected compact final evidence changed during checkpoint verification")
        return accepted

    results, findings, evaluation_ids, closes = [], [], set(), set()
    for cell, slot in zip(selected_cells, slots, strict=True):
        checkpoint, reference = baseline[slot[0]]
        result, observed = _compact_paired_cell(validator, selected_plan, cell, slot, study=selected_study,
            design=selected_design, step_grid=selected_grid, comparison=selected_comparison,
            comparison_sha=expected_comparison_sha256,
            verify_checkpoint_owner=verify_checkpoint, expected_baseline=checkpoint, expected_retention_reference=reference)
        _check_compact_paired_activation_reuse(cell.final_resources, activation_identities)
        if cell.final_decision is not None:
            evaluation = cell.final_decision["final_evaluation_sha256"]
            activity_closes = (result["terminal_close_sha256"], *result["component_owner_close_sha256s"])
            _require(evaluation not in evaluation_ids and closes.isdisjoint(activity_closes),
                     "one compact final evaluation or close cannot fill two paired slots")
            evaluation_ids.add(evaluation)
            closes.update(activity_closes)
        results.append(result)
        findings.append(observed)
    grouped = _paired_group_bounds(selected_plan, seeds, findings)

    def current():
        _require(compact_paired_final_plan_commitment(validator, plan) == expected_plan_sha256
                 and compact_paired_final_evidence_commitment(expected_plan_sha256, expected_comparison_sha256, cells) == evidence_sha
                 and commitment(comparison) == expected_comparison_sha256 and commitment(study) == selected_plan.study_sha256
                 and development_design_commitment(design) == selected_plan.development_design_sha256
                 and development_step_grid_commitment(step_grid) == grid_sha,
                 "selected compact final evidence changed")

    work = {}
    if expected_paid_work_sha256 is not None:
        paid = _compact_paired_paid_work(selected_cells, selected_comparison, baseline,
                                         selected_shared=frozenset(shared_baseline_activity_sha256s))
        missing = tuple((row["seed"], row["arm"], row["status"]) for row in results
                        if row["final_resources_sha256"] is None)
        work["paid_work"] = {**paid, "selection_sha256": expected_paid_work_sha256,
                             "slots_without_final_resources": missing}
    current()
    _require(verify_paired_final_owner(*owner_pins) is True,
             "independent paired final owner refused compact evidence")
    current()
    return {"schema": COMPACT_PAIRED_FINAL_SCHEMA, "paired_final_plan_sha256": expected_plan_sha256,
            "paired_final_evidence_sha256": expected_evidence_sha256, "development_comparison_sha256": expected_comparison_sha256,
            "evidence_kind": selected_plan.evidence_kind, "contrast_id": selected_plan.contrast_id,
            "eligible_clock": selected_plan.clock, "final_panel_sha256": commitment(selected_plan.panel),
            "final_policy_sha256": selected_plan.final_policy_sha256, "split_manifest_sha256": selected_design.global_split_sha256,
            "development_pairs": _wire(records),
            "final_cost_scope": ("original_per_slot_and_observed_paid_event_union" if work
                                 else "original_verified_per_slot_receipts_only"),
            "cells": tuple(results), "fidelity": grouped, **_activation_charge_metadata(selected_comparison), **work}


FIXED_STAGE_PAID_ROSTER_SCHEMA = "reviewed-compact-fixed-stage-paid-close-roster/v1"
FIXED_STAGE_PAID_RESULT_SCHEMA = "verified-compact-fixed-stage-paid-close/v1"
FIXED_STAGE_GATE_SCHEMA = "compact-boundary-scheduled-independent-gates/v1"
FIXED_STAGE_ARMS = ("baseline", "programmed", "random", "adam")


@dataclass(frozen=True)
class FixedStagePaidArm:
    attempt_sha256: str
    terminal_event_sha256: str
    owned_event_sha256s: tuple[str, ...]


@dataclass(frozen=True)
class FixedStagePaidSeed:
    seed: str
    panel_sha256: str
    gate_report_sha256: str
    gate_report: dict
    arms: tuple[FixedStagePaidArm, ...]


def fixed_stage_paid_roster_commitment(roster, *, study_sha256, attempts_sha256):
    _require(_pin(study_sha256) and _pin(attempts_sha256) and type(roster) is tuple and bool(roster)
             and all(type(cell) is FixedStagePaidSeed and _name(cell.seed)
                     and _pin(cell.panel_sha256) and _pin(cell.gate_report_sha256) and type(cell.gate_report) is dict
                     and commitment(cell.gate_report) == cell.gate_report_sha256
                     and type(cell.arms) is tuple and len(cell.arms) == len(FIXED_STAGE_ARMS)
                     and all(type(arm) is FixedStagePaidArm and _pin(arm.attempt_sha256)
                             and _pin(arm.terminal_event_sha256)
                             and type(arm.owned_event_sha256s) is tuple
                             and all(_pin(event_id) for event_id in arm.owned_event_sha256s)
                             and arm.owned_event_sha256s == tuple(sorted(set(arm.owned_event_sha256s)))
                             and arm.terminal_event_sha256 in arm.owned_event_sha256s for arm in cell.arms)
                     for cell in roster), "exact fixed-stage gate reports and closed physical attempt associations required")
    return commitment((FIXED_STAGE_PAID_ROSTER_SCHEMA, study_sha256, attempts_sha256, roster))


FIXED_STAGE_ACTIVATION_GUIDANCE_ROSTER_SCHEMA = "reviewed-compact-fixed-stage-activation-guidance-roster/v1"
_FIXED_STAGE_ACTIVATION_GUIDANCE_SCHEMA = "compact-boundary-activation-guided-followup/v1"
_FIXED_STAGE_ACTIVATION_GUIDANCE_PINS = frozenset((
    "diagnostic_sha256", "recipe_sha256", "proposal_pair_sha256", "plan_sha256",
    "discovery_sha256", "confirmation_panel_sha256",
))


def fixed_stage_activation_guidance_roster_commitment(rows, *, study_sha256):
    """Commit independent expected guidance pins in study seed order."""
    _require(_pin(study_sha256) and type(rows) is tuple and bool(rows)
             and all(type(row) is tuple and len(row) == 2 and _name(row[0]) and _pin(row[1]) for row in rows)
             and len({seed for seed, _ in rows}) == len(rows),
             "exact ordered fixed-stage activation guidance selection required")
    return commitment((FIXED_STAGE_ACTIVATION_GUIDANCE_ROSTER_SCHEMA, study_sha256, rows))


def _fixed_stage_activation_guidance(study_sha256, roster, rows, expected_sha256):
    if rows is expected_sha256 is None:
        _require(all("activation_guidance" not in cell.gate_report for cell in roster),
                 "marked fixed-stage gate reports require independent activation guidance selection")
        return ()

    _require(_pin(expected_sha256)
             and fixed_stage_activation_guidance_roster_commitment(rows, study_sha256=study_sha256) == expected_sha256
             and tuple(seed for seed, _ in rows) == tuple(cell.seed for cell in roster),
             "selected activation guidance must preserve the original fixed-stage seed order")
    selected = []
    for cell, (seed, pin) in zip(roster, rows, strict=True):
        guidance = cell.gate_report.get("activation_guidance")
        _require(type(guidance) is dict and set(guidance) == _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS | {"schema"}
                 and guidance["schema"] == _FIXED_STAGE_ACTIVATION_GUIDANCE_SCHEMA
                 and all(_pin(guidance[key]) for key in _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS)
                 and guidance["confirmation_panel_sha256"] == cell.panel_sha256 == cell.gate_report.get("panel_sha256")
                 and commitment(guidance) == pin,
                 "fixed-stage gate report lacks the exact selected activation guidance and reserved panel")
        selected.append((seed, pin, dict(guidance)))
    return tuple(selected)


def _fixed_stage_gate_rows(validator, report, *, panel_sha256, policy_sha256, retention_sha256, row_ids):
    identity_fields = ("plan_sha256", "numerical_report_sha256", "evaluation_plan_sha256",
                       "followup_report_sha256", "training_close_sha256", "observation_manifest_sha256",
                       "translation_handoffs_sha256")
    _require(report.get("schema") == FIXED_STAGE_GATE_SCHEMA
             and report.get("status") in ("assessed", "incomplete_selected_stage")
             and report.get("panel_sha256") == panel_sha256 and report.get("policy_sha256") == policy_sha256
             and "retention_reference_sha256" in report
             and report["retention_reference_sha256"] in (None, retention_sha256)
             and (report["status"] == "assessed" or report["retention_reference_sha256"] is None)
             and all(_pin(report.get(field)) for field in identity_fields)
             and type(report.get("stage")) is int and 1 <= report["stage"] <= 16
             and all(type(report.get(key)) is dict and set(report[key]) == set(FIXED_STAGE_ARMS)
                     for key in ("availability", "arms")),
             "exact fixed-stage independent gate report required")
    assessed = report["status"] == "assessed"
    rows = {}
    for name in FIXED_STAGE_ARMS:
        availability = report["availability"][name]
        arm = report["arms"][name]
        _require(type(availability) is dict and set(availability) == {"status", "selected_postimage_sha256", "reason"}
                 and availability["status"] in ("reached", "rejected_at_stage", "stopped_before_stage")
                 and type(arm) is dict and {"rows", "gate_counts", "status"} <= arm.keys() and type(arm["rows"]) is dict,
                 "fixed-stage gate report must retain every original arm and its availability")
        reached = availability["status"] == "reached"
        _require((_pin(availability["selected_postimage_sha256"]) and availability["reason"] is None)
                 if reached else (availability["selected_postimage_sha256"] is None
                                  and availability["reason"] in ("over_budget", "zero_gradient", "no_numeric_displacement")),
                 "fixed-stage postimage availability contradicts its terminal reason")
        if assessed:
            _require(arm["status"] in ("all_gates_passed", "did_not_clear", "evidence_incomplete")
                     and set(arm["rows"]) == row_ids and type(arm["gate_counts"]) is dict
                     and set(arm["gate_counts"]) == set(validator.GATES),
                     "assessed fixed-stage gate result must retain its exact panel and gate roster")
        else:
            _require(arm["status"] == ("comparison_not_scored" if reached else "checkpoint_unavailable")
                     and not arm["rows"] and arm["gate_counts"] is None,
                     "an unavailable fixed stage cannot carry gate findings")
        rows[name] = {**availability, "gate_status": arm["status"],
                      "assessment_status": ("assessed" if assessed else "reached_unscored")
                      if reached else availability["status"]}
    _require(assessed == all(row["status"] == "reached" for row in rows.values()),
             "fixed-stage gate scope disagrees with its matched availability")
    return rows


def verify_fixed_stage_paid_close(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256,
                                  roster, expected_roster_sha256, cost_evidence, expected_cost_evidence_sha256,
                                  verify_cost_owner, activation_diagnostic_charges=None,
                                  expected_activation_diagnostic_charges_sha256=None,
                                  activation_guidance_roster=None, expected_activation_guidance_roster_sha256=None):
    """Verify original terminal-only charges for one selected fixed stage.

    The owner resolves both commitments and verifies the exact gate, TRAIN and
    resource closes, their original attempt associations, and clock coverage.
    The gate disposition and the physical terminal status retain separate
    identities. This entry point does not construct threshold observations.
    The cost owner receives any selected first-use diagnostic charge pin,
    then any independently selected activation guidance roster pin.
    """
    return _verify_fixed_stage_paid(validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, roster=roster,
        expected_roster_sha256=expected_roster_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner,
        activation_diagnostic_charges=activation_diagnostic_charges,
        expected_activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
        activation_guidance_roster=activation_guidance_roster,
        expected_activation_guidance_roster_sha256=expected_activation_guidance_roster_sha256)


def _fixed_stage_activation_selection(study, charges, expected_charges_sha256):
    if charges is None and expected_charges_sha256 is None:
        return ()
    _require(study.cost_basis == "first_use" and _pin(expected_charges_sha256)
             and activation_diagnostic_charges_commitment(charges) == expected_charges_sha256,
             "fixed-stage activation charges require an exact first-use diagnostic selection")
    return (expected_charges_sha256,)


def _verify_fixed_stage_paid(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256,
                             roster, expected_roster_sha256, cost_evidence, expected_cost_evidence_sha256,
                             verify_cost_owner, look_closes=None, activation_diagnostic_charges=None,
                             expected_activation_diagnostic_charges_sha256=None,
                             activation_guidance_roster=None, expected_activation_guidance_roster_sha256=None):
    _require(callable(verify_cost_owner) and _pin(expected_roster_sha256),
             "independent fixed-stage resource owner required")

    def current():
        _require(commitment(study) == expected_study_sha256
                 and commitment(attempts) == expected_attempts_sha256
                 and commitment(cost_evidence) == expected_cost_evidence_sha256
                 and fixed_stage_paid_roster_commitment(roster, study_sha256=expected_study_sha256,
                     attempts_sha256=expected_attempts_sha256) == expected_roster_sha256,
                 "selected fixed-stage reports, attempts or cost evidence changed")
        diagnostics = _fixed_stage_activation_selection(study, activation_diagnostic_charges,
                                                       expected_activation_diagnostic_charges_sha256)
        guidance = _fixed_stage_activation_guidance(expected_study_sha256, roster,
            activation_guidance_roster, expected_activation_guidance_roster_sha256)
        return diagnostics, guidance

    diagnostic_selection, guidance = current()
    guidance_selection = (expected_activation_guidance_roster_sha256,) if guidance else ()
    _study(validator, study, expected_study_sha256)
    _require(tuple(arm for arm, _ in study.arms) == FIXED_STAGE_ARMS
             and tuple(cell.seed for cell in roster) == tuple(seed.identifier for seed in study.seeds)
             and len({cell.gate_report_sha256 for cell in roster}) == len(roster),
             "fixed-stage costs require one original gate report per ordered compact seed")
    _require(type(attempts) is tuple and all(type(attempt) is Attempt and
             (attempt.assessments == () if look_closes is None else
              type(attempt.assessments) is tuple and len(attempt.assessments) <= 1)
             and _pin(attempt.closeout_receipt_sha256) and type(attempt.closeout_status) is str
             and (attempt.closeout_status in CLOSED_EVENT_OUTCOMES or attempt.closeout_status == "stopped_at_checkpoint")
             for attempt in attempts), "fixed-stage costs require original closed attempts and selected look cardinality")
    elapsed, physical_work = _cost_roster(validator, study, expected_study_sha256, attempts,
        expected_attempts_sha256, cost_evidence, expected_cost_evidence_sha256, retrospective_look_closes=look_closes,
        activation_diagnostic_charges=activation_diagnostic_charges or ())
    events = _event_roster(cost_evidence.events)
    distinct_closes = {event.close_receipt_sha256 for event in events.values()}
    _require(len(distinct_closes) == len(events), "one physical close cannot be charged under multiple event identities")
    stages = {cell.gate_report.get("stage") for cell in roster if type(cell.gate_report.get("stage")) is int}
    for field in ("numerical_report_sha256", "followup_report_sha256", "training_close_sha256"):
        pins = tuple(cell.gate_report.get(field) for cell in roster)
        _require(all(_pin(pin) for pin in pins) and len(set(pins)) == len(roster),
                 "one original numerical, TRAIN report and TRAIN close per seed required")
    _require(len(stages) == 1, "fixed-stage paid comparison requires one common selected stage")
    if diagnostic_selection:
        other_closes = {attempt.closeout_receipt_sha256 for attempt in attempts}
        other_closes.update(cell.gate_report["training_close_sha256"] for cell in roster)
        other_closes.update(close for closes in (look_closes or {}).values() for close in closes)
        _require(other_closes.isdisjoint(row.owner_close_sha256 for row in activation_diagnostic_charges),
                 "fixed-stage activation diagnostic close cannot replace a training, evaluation or terminal close")

    ordered_attempts = iter(attempts)
    observations = iter(cost_evidence.observations)
    terminal_events = set()
    meter_receipts = {}
    terminal_rows = []
    panel_rows = tuple((row_id, dependency) for row_id, dependency, _ in study.panel)
    row_ids = {row_id for row_id, _ in panel_rows}
    for cell, seed in zip(roster, study.seeds, strict=True):
        # Historical terminal-only receipts can lack the ordered projection.
        # The typed gate populations emitted by the current reviewer require it.
        if "panel_rows" in cell.gate_report or "gate_rows" in cell.gate_report:
            _require(commitment(cell.gate_report.get("panel_rows")) == commitment(panel_rows),
                     "paid gate report differs from the ordered fixed-stage panel and dependency roster")
        gate_rows = _fixed_stage_gate_rows(validator, cell.gate_report, panel_sha256=cell.panel_sha256,
            policy_sha256=study.evaluation_policy_sha256, retention_sha256=seed.retention_reference_sha256,
            row_ids=row_ids)
        for name, association in zip(FIXED_STAGE_ARMS, cell.arms, strict=True):
            attempt = next(ordered_attempts)
            if attempt.assessments:
                look_interval, _ = next(observations)
                _fixed_stage_meter_receipts(meter_receipts, (), attempt.assessments[0].meter, look_interval)
            interval, charges = next(observations)
            _fixed_stage_meter_receipts(meter_receipts, (), attempt.closing_meter, interval)
            event_id = association.terminal_event_sha256
            status = attempt.closeout_status
            _require(association.attempt_sha256 == attempt.attempt_sha256 and event_id in events
                     and event_id not in terminal_events
                     and events[event_id].close_receipt_sha256 == attempt.closeout_receipt_sha256
                     and tuple(event_id for event_id, _ in charges.entries) == association.owned_event_sha256s
                     and dict(charges.entries).get(event_id) == 1,
                     "each original attempt must cover its exact terminal event and full paid association")
            terminal_events.add(event_id)
            disposition = events[event_id].disposition
            selected_stage = gate_rows[name]
            _require((selected_stage["status"] in ("rejected_at_stage", "stopped_before_stage")
                      and disposition in ("complete", "refused"))
                     if status == "stopped_at_checkpoint" else status == disposition,
                     "terminal physical disposition differs from original close or selected checkpoint stop")
            if status == "budget_limit":
                limit = dict(zip(validator.CLOCKS, study.budget_caps, strict=True)).get(attempt.budget_clock)
                _require(limit is not None and _pin(attempt.cap_receipt_sha256)
                         and (observed := getattr(attempt.closing_meter.costs, attempt.budget_clock)) is not None
                         and observed >= limit, "physical budget closure requires its measured cap receipt")
            else:
                _require(attempt.budget_clock is attempt.cap_receipt_sha256 is None,
                         "cap evidence belongs to a physical budget-limit close")
            terminal_rows.append({"seed": cell.seed, "arm": name, "attempt_sha256": attempt.attempt_sha256,
                "gate_report_sha256": cell.gate_report_sha256, "panel_sha256": cell.panel_sha256,
                "policy_sha256": study.evaluation_policy_sha256,
                "gate_plan_sha256": cell.gate_report["plan_sha256"],
                "numerical_report_sha256": cell.gate_report["numerical_report_sha256"],
                "evaluation_plan_sha256": cell.gate_report["evaluation_plan_sha256"],
                "followup_report_sha256": cell.gate_report["followup_report_sha256"],
                "training_close_sha256": cell.gate_report["training_close_sha256"],
                "retention_reference_sha256": cell.gate_report["retention_reference_sha256"],
                "stage": cell.gate_report["stage"], "availability": selected_stage,
                "closeout_status": status, "closeout_receipt_sha256": attempt.closeout_receipt_sha256,
                "terminal_event_sha256": event_id, "terminal_event_disposition": disposition,
                "meter": _wire(attempt.closing_meter), "interval": _wire(interval), "charges": _wire(charges)})
    output = {"schema": FIXED_STAGE_PAID_RESULT_SCHEMA, "study_sha256": expected_study_sha256,
              "attempts_sha256": expected_attempts_sha256, "roster_sha256": expected_roster_sha256,
              "cost_evidence_sha256": expected_cost_evidence_sha256, "stage": next(iter(stages)),
              "cost_basis": study.cost_basis, "arms": tuple(terminal_rows),
              "physical_paid_events": tuple(_wire(event) for event in cost_evidence.events),
              "physical_work_ns": physical_work, "observed_elapsed_wall": elapsed}
    _require(verify_cost_owner(expected_cost_evidence_sha256, expected_roster_sha256,
                               *diagnostic_selection, *guidance_selection) is True,
             "resource owner refused the selected fixed-stage paid close")
    current()
    if diagnostic_selection:
        output.update(activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
                      activation_diagnostic_charges=tuple(_wire(row) for row in activation_diagnostic_charges))
    if guidance:
        output.update(activation_guidance_roster_sha256=expected_activation_guidance_roster_sha256,
                      activation_guidance_roster=guidance)
    return output


FIXED_STAGE_PAID_LOOK_SCHEMA = "reviewed-compact-fixed-stage-paid-look-roster/v1"
FIXED_STAGE_COMPARISON_SCHEMA = "verified-compact-fixed-stage-paid-comparison/v1"


@dataclass(frozen=True)
class FixedStagePaidLook:
    attempt_sha256: str
    training_close_sha256: str
    evaluation_close_sha256: str


def fixed_stage_paid_looks_commitment(look_closes, *, roster_sha256, cost_evidence_sha256):
    _require(_pin(roster_sha256) and _pin(cost_evidence_sha256) and type(look_closes) is tuple
             and all(type(look) is FixedStagePaidLook
                     and all(_pin(value) for value in asdict(look).values())
                     and look.training_close_sha256 != look.evaluation_close_sha256
                     for look in look_closes)
             and len({look.attempt_sha256 for look in look_closes}) == len(look_closes)
             and len({close for look in look_closes
                      for close in (look.training_close_sha256, look.evaluation_close_sha256)}) == 2 * len(look_closes),
             "fixed-stage looks require distinct original attempts and per-arm completed training and evaluation closes")
    return commitment((FIXED_STAGE_PAID_LOOK_SCHEMA, roster_sha256, cost_evidence_sha256, look_closes))


def _fixed_stage_count_rosters(validator, report, row_ids):
    selected = report.get("gate_rows")
    complete = report.get("retention_roster_complete")
    if report["status"] == "incomplete_selected_stage":
        _require(selected is None and complete is None, "unscored stage cannot carry gate populations")
        return None, None
    _require(type(selected) is dict and set(selected) == set(validator.GATES) and type(complete) is bool
             and all(type(rows) in (tuple, list) and all(type(row) is str for row in rows) for rows in selected.values()),
             "independently reviewed gate row rosters and retention completeness required")
    rosters = {gate: tuple(rows) for gate, rows in selected.items()}
    _require(all(rows == tuple(row for row in row_ids if row in rows) for rows in rosters.values())
             and rosters["coverage"] == rosters["abstention"] == row_ids
             and set(rosters["retention"]) <= set(rosters["source_fidelity"])
             and (report["retention_reference_sha256"] is not None or (not rosters["retention"] and not complete)),
             "gate rows must retain their selected panel order and common original-parent retention mask")
    return rosters, complete


def _fixed_stage_counts(validator, arm_report, seed, thresholds, gate_rows, retention_complete):
    raw = arm_report["gate_counts"]
    rows = arm_report["rows"]
    counts, expected_gates = {}, {}
    unknown = []
    for name, denominator in zip(validator.GATES, seed.gate_denominators, strict=True):
        item = raw[name]
        field = {"source_fidelity": "source_success", "formal_validity": "formal_success", "retention": "source_success",
                 "coverage": "covered", "abstention": "abstained"}[name]
        selected = gate_rows[name]
        _require(all(type(rows[row]) is dict and field in rows[row]
                     and (rows[row][field] is None or type(rows[row][field]) is bool) for row in selected),
                 "fixed-stage row findings must be exact independent booleans or unavailable")
        values = tuple(rows[row][field] for row in selected)
        unknown.extend((row, name) for row, value in zip(selected, values, strict=True) if value is None)
        known = all(value is not None for value in values) and (name != "retention" or retention_complete)
        _require(type(item) is dict and set(item) == {"numerator", "denominator", "verified"}
                 and type(item["numerator"]) is int and type(item["denominator"]) is int
                 and type(item["verified"]) is bool
                 and (item["numerator"], item["denominator"], item["verified"]) ==
                     (sum(value is True for value in values), len(selected), known)
                 and (len(selected) == denominator or (name == "retention" and not retention_complete
                                                        and len(selected) < denominator)),
                 "fixed-stage counts differ from independent rows or the preregistered gate denominator")
        counts[name] = validator.Counts(**item)
        rate = Fraction(item["numerator"], item["denominator"]) if item["verified"] and item["denominator"] else None
        status = "unavailable"
        if rate is not None:
            passed = rate <= thresholds[name] if name == "abstention" else rate >= thresholds[name]
            status = "pass" if passed else "fail"
        expected_gates[name] = {"status": status, "rate": None if rate is None else rate.as_integer_ratio()}
    if not retention_complete:
        unknown.append((None, "retention_reference"))
    missing = arm_report.get("missing_responses")
    _require(commitment(arm_report.get("gates")) == commitment(expected_gates)
             and type(missing) in (tuple, list)
             and tuple(missing) == tuple(row for row in gate_rows["coverage"] if row in missing)
             and all(type(value) is dict and (value.get("response") != "unavailable" or row in missing)
                     for row, value in rows.items())
             and commitment(arm_report.get("unknown_findings")) == commitment(tuple(unknown)),
             "fixed-stage gate status or rate differs from its original counts and cutoffs")
    incomplete = (arm_report["missing_responses"] or arm_report["unknown_findings"] or
                  any(gate["status"] == "unavailable" for gate in expected_gates.values()))
    status = ("evidence_incomplete" if incomplete else "all_gates_passed"
              if all(gate["status"] == "pass" for gate in expected_gates.values()) else "did_not_clear")
    _require(arm_report["status"] == status, "fixed-stage independent evidence disposition differs")
    return counts


def _fixed_stage_horizon(decision, block_or_reason, clock, horizon):
    if decision is None:
        return None, block_or_reason, None
    return _threshold_horizon(decision, block_or_reason, clock, horizon)


def _fixed_stage_decision(validator, study, study_pin, attempt, seed, arm, gate_status, has_assessed_stage,
                          thresholds, budget_caps, panel_pin):
    terminal = attempt.closeout_status
    if terminal not in ("complete", "budget_limit"):
        reason = gate_status if terminal == "stopped_at_checkpoint" else terminal
        return None, reason
    # A closed, scored gate report with unknown or unmetered evidence does
    # not establish attainment or nonattainment, even if the terminal clock exists.
    if has_assessed_stage:
        if gate_status == "evidence_incomplete":
            return None, "assessment_unavailable"
        if not attempt.assessments:
            return None, "measurement_unavailable"
    elif terminal != "budget_limit" or gate_status == "comparison_not_scored":
        return None, gate_status
    verdict = _evaluate(validator, study, study_pin, attempt, arm, seed, dict(thresholds), budget_caps, panel_pin)
    return verdict, _confirmation_block(verdict, attempt, budget_caps, require_complete_cap_observation=True)


def compare_fixed_stage_paid(validator, *, study, expected_study_sha256, attempts, expected_attempts_sha256,
        roster, expected_roster_sha256, cost_evidence, expected_cost_evidence_sha256, look_closes,
        expected_look_closes_sha256, contrast_plan, expected_contrast_plan_sha256,
        verify_cost_owner, verify_assessment_owner, activation_diagnostic_charges=None,
        expected_activation_diagnostic_charges_sha256=None, activation_guidance_roster=None,
        expected_activation_guidance_roster_sha256=None):
    """Pair actual paid observations at one preregistered stage across all original slots.

    The assessment owner authenticates preregistration, per-arm findings and
    its actual evaluation receipt. The cost owner authenticates the scoped
    training and evaluation closes and meters through the availability of
    those findings. An aggregate report must use its actual availability time.
    A counted stage cannot borrow a terminal meter or an aggregate arm clock.
    The cost owner receives any selected first-use diagnostic charge pin.
    Both owners then receive any independently selected activation guidance pin.
    """
    _require(callable(verify_cost_owner) and callable(verify_assessment_owner)
             and _pin(expected_look_closes_sha256), "fixed-stage comparison requires independent assessment and cost owners")
    contrasts = _selected_contrasts(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    thresholds, horizons, budget_caps = _study(validator, study, expected_study_sha256)
    panel_pin = commitment(study.panel)
    cutoffs = tuple((gate, rate.as_integer_ratio()) for gate, rate in thresholds.items())
    panel_rows = tuple((row, group) for row, group, _ in study.panel)

    def current():
        _require(commitment(study) == expected_study_sha256 and commitment(attempts) == expected_attempts_sha256
                 and commitment(cost_evidence) == expected_cost_evidence_sha256
                 and commitment(contrast_plan) == expected_contrast_plan_sha256
                 and fixed_stage_paid_roster_commitment(roster, study_sha256=expected_study_sha256,
                     attempts_sha256=expected_attempts_sha256) == expected_roster_sha256
                 and fixed_stage_paid_looks_commitment(look_closes, roster_sha256=expected_roster_sha256,
                     cost_evidence_sha256=expected_cost_evidence_sha256) == expected_look_closes_sha256,
                 "selected fixed-stage comparison inputs changed")
        _fixed_stage_activation_selection(study, activation_diagnostic_charges,
                                          expected_activation_diagnostic_charges_sha256)
        return _fixed_stage_activation_guidance(expected_study_sha256, roster,
            activation_guidance_roster, expected_activation_guidance_roster_sha256)

    guidance = current()
    guidance_selection = (expected_activation_guidance_roster_sha256,) if guidance else ()
    stage = roster[0].gate_report.get("stage")
    _require(type(stage) is int and 1 <= stage <= 16 and study.schedule == (f"step-{stage}",)
             and study.required_streak == 1 and study.stop_after_confirmation is False
             and all(commitment(cell.gate_report.get("cutoffs")) == commitment(cutoffs)
                     and commitment(cell.gate_report.get("panel_rows")) == commitment(panel_rows) for cell in roster),
             "one exact preregistered stage with matching gate cutoffs and ordered dependency roster required")
    _require(type(attempts) is tuple and all(type(attempt) is Attempt and type(attempt.assessments) is tuple
             and len(attempt.assessments) <= 1 and all(type(look) is Assessment for look in attempt.assessments)
             for attempt in attempts)
             and tuple(attempt.attempt_sha256 for attempt in attempts if attempt.assessments)
                 == tuple(row.attempt_sha256 for row in look_closes),
             "paid look roster must exactly cover the original assessed attempts in order")
    look_key = study.schedule[0]
    close_map = {(row.attempt_sha256, look_key): (row.training_close_sha256, row.evaluation_close_sha256)
                 for row in look_closes}

    def authenticate_cost(cost_pin, roster_pin, *selections):
        accepted = verify_cost_owner(cost_pin, roster_pin, expected_look_closes_sha256, *selections)
        current()
        return accepted

    paid = _verify_fixed_stage_paid(validator, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, roster=roster,
        expected_roster_sha256=expected_roster_sha256, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=authenticate_cost,
        look_closes=close_map, activation_diagnostic_charges=activation_diagnostic_charges,
        expected_activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
        activation_guidance_roster=activation_guidance_roster,
        expected_activation_guidance_roster_sha256=expected_activation_guidance_roster_sha256)

    physical = _event_roster(cost_evidence.events)
    event_by_close = {event.close_receipt_sha256: event_id for event_id, event in physical.items()}
    protected_receipts = set(event_by_close)
    for cell in roster:
        protected_receipts.add(cell.gate_report_sha256)
        protected_receipts.update(value for key, value in cell.gate_report.items() if key.endswith("_sha256") and _pin(value))
    protected_receipts.update((expected_study_sha256, expected_roster_sha256, expected_look_closes_sha256,
                               expected_cost_evidence_sha256, expected_contrast_plan_sha256))
    if expected_activation_diagnostic_charges_sha256 is not None:
        protected_receipts.add(expected_activation_diagnostic_charges_sha256)
    protected_receipts.update(guidance_selection)
    protected_receipts.update(pin for _, pin, _ in guidance)
    used_meters, used_assessments = {}, set()
    outcomes, decisions = {}, []
    observations = iter(cost_evidence.observations)
    by_seed = {cell.seed: cell.gate_report for cell in roster}
    count_rosters = {seed: _fixed_stage_count_rosters(validator, report, tuple(row for row, _ in panel_rows))
                     for seed, report in by_seed.items()}
    seeds = {seed.identifier: seed for seed in study.seeds}
    for attempt, terminal in zip(attempts, paid["arms"], strict=True):
        seed = seeds[attempt.seed]
        arm = (attempt.arm, attempt.recipe_sha256)
        gate_report = by_seed[attempt.seed]
        local = gate_report["arms"][attempt.arm]
        assessed = gate_report["status"] == "assessed"
        counts = (_fixed_stage_counts(validator, local, seed, thresholds, *count_rosters[attempt.seed])
                  if assessed else None)
        look_record = None
        if attempt.assessments:
            look, = attempt.assessments
            interval, charges = next(observations)
            ids = dict(charges.entries)
            eval_pin = look.evaluation_receipt_sha256
            _require(assessed and look.look == look_key
                     and look.checkpoint_sha256 == terminal["availability"]["selected_postimage_sha256"]
                     and look.panel_sha256 == panel_pin and look.evaluation_policy_sha256 == study.evaluation_policy_sha256
                     and look.retention_reference_sha256 == seed.retention_reference_sha256
                     and type(look.gates) is dict and set(look.gates) == set(validator.GATES)
                     and all(type(value) is validator.Counts for value in look.gates.values())
                     and commitment(look.gates) == commitment(counts)
                     and _pin(eval_pin) and eval_pin not in protected_receipts and eval_pin not in used_assessments
                     and eval_pin not in used_meters and attempt.closeout_status != "stopped_at_checkpoint"
                     and all(ids.get(event_by_close[pin]) == 1 for pin in close_map[(attempt.attempt_sha256, look_key)])
                     and terminal["terminal_event_sha256"] not in ids,
                     "paid look must bind its exact accepted checkpoint, independent findings and per-arm closes")
            used_assessments.add(eval_pin)
            _fixed_stage_meter_receipts(used_meters, used_assessments, look.meter, interval)
            look_record = {"look": look_key, "checkpoint_sha256": look.checkpoint_sha256,
                "evaluation_receipt_sha256": eval_pin, "meter": _wire(look.meter), "interval": _wire(interval),
                "charges": _wire(charges), "training_and_evaluation_closes": close_map[(attempt.attempt_sha256, look_key)]}
        closing_interval, _ = next(observations)
        _fixed_stage_meter_receipts(used_meters, used_assessments, attempt.closing_meter, closing_interval)
        verdict, block = _fixed_stage_decision(validator, study, expected_study_sha256, attempt, seed, arm,
            local["status"], assessed, thresholds, budget_caps, panel_pin)
        outcomes[attempt.seed, attempt.arm] = verdict, block
        decisions.append({"seed": attempt.seed, "arm": attempt.arm, "attempt_sha256": attempt.attempt_sha256,
            "status": block if verdict is None else verdict.status, "decision": None if verdict is None else _wire(verdict),
            "gate_counts": deepcopy(local["gate_counts"]), "look_evidence": look_record,
            "confirmation_budget_block": None if verdict is None else block})
    _require(verify_assessment_owner(expected_study_sha256, expected_roster_sha256, expected_look_closes_sha256,
                                     expected_contrast_plan_sha256, *guidance_selection) is True,
             "independent assessment owner refused the fixed-stage comparison")
    current()

    pairs, bounds = [], []
    attempt_ids = {(attempt.seed, attempt.arm): attempt.attempt_sha256 for attempt in attempts}
    for contrast in contrasts:
        baseline, candidate = contrast["baseline"], contrast["candidate"]
        pair_rows, bound_rows = _paired_contrast(study.seeds, horizons, outcomes, baseline, candidate,
                                                 resolve=_fixed_stage_horizon)
        label = {"contrast_id": contrast["identifier"], "role": contrast["role"]}
        pairs.extend({**row, **label, "baseline_attempt_sha256": attempt_ids[row["seed"], baseline],
                      "candidate_attempt_sha256": attempt_ids[row["seed"], candidate]} for row in pair_rows)
        bounds.extend({**row, **label} for row in bound_rows)
    return {**paid, "schema": FIXED_STAGE_COMPARISON_SCHEMA, "cutoffs": cutoffs, "contrast_plan_sha256": expected_contrast_plan_sha256,
        "contrasts": contrasts, "fixed_stage_paid_looks_sha256": expected_look_closes_sha256,
        "attempt_decisions": tuple(decisions), "pairs": tuple(pairs), "fixed_horizon_attainment": tuple(bounds),
        "uncertainty_scope": UNCERTAINTY_SCOPE}


FIXED_STAGE_SUSTAINED_EVIDENCE_SCHEMA = "reviewed-compact-fixed-stage-sustained-evidence/v1"
FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA = "verified-compact-fixed-stage-sustained-comparison/v1"


@dataclass(frozen=True)
class FixedStageScheduledReview:
    seed: str
    look: str
    panel_sha256: str
    gate_report_sha256: str
    gate_report: dict


@dataclass(frozen=True)
class FixedStageScheduledLook:
    attempt_sha256: str
    look: str
    training_close_sha256: str
    evaluation_close_sha256: str
    readback_sha256: str
    readback: dict


def fixed_stage_scheduled_evidence_commitment(reviews, look_closes, terminal_arms, *, study_sha256,
        attempts_sha256, cost_evidence_sha256, step_grid_sha256):
    """Bind each scheduled original review, archive readback and physical close."""
    _require(all(_pin(pin) for pin in (study_sha256, attempts_sha256, cost_evidence_sha256, step_grid_sha256))
             and type(reviews) is tuple and reviews
             and all(type(row) is FixedStageScheduledReview and _name(row.seed) and _name(row.look)
                     and _pin(row.panel_sha256) and _pin(row.gate_report_sha256)
                     and type(row.gate_report) is dict and commitment(row.gate_report) == row.gate_report_sha256
                     for row in reviews)
             and len({(row.seed, row.look) for row in reviews}) == len(reviews)
             and len({row.gate_report_sha256 for row in reviews}) == len(reviews),
             "distinct scheduled independent gate reports required")
    _require(type(look_closes) is tuple
             and all(type(row) is FixedStageScheduledLook and _name(row.look)
                     and all(_pin(pin) for pin in (row.attempt_sha256, row.training_close_sha256,
                                                  row.evaluation_close_sha256, row.readback_sha256))
                     and type(row.readback) is dict and commitment(row.readback) == row.readback_sha256
                     for row in look_closes)
             and len({(row.attempt_sha256, row.look) for row in look_closes}) == len(look_closes)
             and len({row.readback_sha256 for row in look_closes}) == len(look_closes)
             and len({row.evaluation_close_sha256 for row in look_closes}) == len(look_closes)
             and {row.evaluation_close_sha256 for row in look_closes}.isdisjoint(
                 row.training_close_sha256 for row in look_closes),
             "distinct accepted readbacks and independent evaluation closes required for scheduled looks")
    _require(type(terminal_arms) is tuple and terminal_arms
             and all(type(row) is FixedStagePaidArm and _pin(row.attempt_sha256) and _pin(row.terminal_event_sha256)
                     and type(row.owned_event_sha256s) is tuple and all(_pin(pin) for pin in row.owned_event_sha256s)
                     and row.owned_event_sha256s == tuple(sorted(set(row.owned_event_sha256s)))
                     and row.terminal_event_sha256 in row.owned_event_sha256s for row in terminal_arms)
             and len({row.attempt_sha256 for row in terminal_arms}) == len(terminal_arms)
             and len({row.terminal_event_sha256 for row in terminal_arms}) == len(terminal_arms),
             "distinct original terminal physical associations required")
    return commitment((FIXED_STAGE_SUSTAINED_EVIDENCE_SCHEMA, study_sha256, attempts_sha256,
                       cost_evidence_sha256, step_grid_sha256, reviews, look_closes, terminal_arms))


def _scheduled_fixed_stage_reviews(validator, study, reviews, steps, thresholds):
    panel = tuple((row, group) for row, group, _ in study.panel)
    row_ids = tuple(row for row, _ in panel)
    cutoffs = tuple((gate, rate.as_integer_ratio()) for gate, rate in thresholds.items())
    _require(tuple((row.seed, row.look) for row in reviews) == tuple(
                 (seed.identifier, look) for seed in study.seeds for look in study.schedule),
             "scheduled reviews must cover each original seed and selected look in order")
    seeds = {seed.identifier: seed for seed in study.seeds}
    lineage = {}
    selected = {}
    for cell in reviews:
        report, seed = cell.gate_report, seeds[cell.seed]
        stage = steps[cell.look]
        _require(type(report.get("stage")) is int and report["stage"] == stage
                 and commitment(report.get("cutoffs")) == commitment(cutoffs)
                 and commitment(report.get("panel_rows")) == commitment(panel),
                 "scheduled stage cutoffs and ordered dependency panel differ")
        arms = _fixed_stage_gate_rows(validator, report, panel_sha256=cell.panel_sha256,
            policy_sha256=study.evaluation_policy_sha256, retention_sha256=seed.retention_reference_sha256,
            row_ids=set(row_ids))
        # The numerical readbacks at different stages must replay one closed
        # TRAIN trajectory and the same independently selected review panel.
        identity = (cell.panel_sha256, report["followup_report_sha256"], report["training_close_sha256"],
                    commitment(report.get("activation_guidance")))
        _require(lineage.setdefault(cell.seed, identity) == identity,
                 "scheduled gate evidence changed the original panel, TRAIN trajectory or activation guidance")
        roster, retention_complete = _fixed_stage_count_rosters(validator, report, row_ids)
        counts = {}
        for name, arm in report["arms"].items():
            if report["status"] != "assessed":
                continue
            original = _fixed_stage_counts(validator, arm, seed, thresholds, roster, retention_complete)
            # A partially observed retention roster cannot be used with the
            # fixed study denominator. Keep the original count in the report.
            counts[name] = {gate: count if count.denominator == denominator else None
                for (gate, count), denominator in zip(original.items(), seed.gate_denominators, strict=True)}
            if arm["status"] == "evidence_incomplete" and all(
                    count is not None and count.verified and count.denominator for count in counts[name].values()):
                counts[name] = dict.fromkeys(validator.GATES)
        selected[cell.seed, cell.look] = (cell, arms, counts)
    _require(all(len({identity[position] for identity in lineage.values()}) == len(seeds)
                 for position in (1, 2))
             and len({cell.gate_report["numerical_report_sha256"] for cell in reviews}) == len(reviews),
             "independent seeds and scheduled looks require distinct original TRAIN and numerical evidence")
    return selected


def _scheduled_fixed_stage_readback(review, observed_look, *, arm, stage, postimage,
        expected_joint_affine_readback_sha256=None):
    return _check_scheduled_postimage_readback(review.gate_report, observed_look.readback,
        panel_sha256=review.panel_sha256, arm=arm, stage=stage, postimage=postimage,
        expected_joint_affine_readback_sha256=expected_joint_affine_readback_sha256)


def _check_scheduled_postimage_readback(report, readback, *, panel_sha256, arm, stage, postimage,
        expected_joint_affine_readback_sha256=None):
    common = ("evaluation_plan_sha256", "numerical_report_sha256", "followup_report_sha256", "training_close_sha256")
    static = ("parent_sha256", "preimage_sha256", "architecture_sha256", "codec_sha256",
              "edit_split_sha256", "confirmation_split_sha256", "activation_guidance_sha256")
    field = "joint_affine_readback_sha256"
    joint = expected_joint_affine_readback_sha256 is not None
    extra = {field} if joint else set()
    schema = ("compact-boundary-scheduled-joint-affine-postimage-readback/v1" if joint
              else "compact-boundary-scheduled-postimage-readback/v1")
    _require(set(readback) == set(common + static) | {"schema", "stage", "arm", "panel_sha256",
                  "postimage_sha256", "optimizer_capture_sha256"} | extra
             and readback["schema"] == schema
             and type(readback["stage"]) is int and readback["stage"] == stage and readback["arm"] == arm
             and all(readback[key] == report[key] for key in common)
             and all(_pin(readback[key]) for key in static + ("optimizer_capture_sha256",))
             and readback["edit_split_sha256"] != readback["confirmation_split_sha256"]
             and readback["panel_sha256"] == panel_sha256
             and readback["postimage_sha256"] == postimage,
             "scheduled readback differs from the accepted postimage, stage, panel or TRAIN closure")
    guidance = report.get("activation_guidance")
    _require(type(guidance) is dict and guidance.get("schema") == _FIXED_STAGE_ACTIVATION_GUIDANCE_SCHEMA
             and set(guidance) == _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS | {"schema"} | extra
             and all(_pin(guidance[key]) for key in _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS)
             and guidance["confirmation_panel_sha256"] == panel_sha256
             and commitment(guidance) == readback["activation_guidance_sha256"],
             "scheduled readback requires its original activation guidance and confirmation panel")
    if joint:
        _require(_pin(expected_joint_affine_readback_sha256)
                 and readback[field] == guidance[field] == expected_joint_affine_readback_sha256
                 and all(guidance[key] != expected_joint_affine_readback_sha256
                         for key in _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS)
                 and all(readback[key] != expected_joint_affine_readback_sha256
                         for key in common + static + ("postimage_sha256", "optimizer_capture_sha256")),
                 "scheduled readback requires its exact separate joint affine evidence")
    return tuple(readback[key] for key in static)


def verify_joint_affine_scheduled_readback(*, readback, expected_readback_sha256, gate_report, expected_gate_report_sha256,
        numerical_report, expected_numerical_report_sha256, expected_joint_affine_readback_sha256,
        expected_parent_sha256, expected_preimage_sha256, arm, verify_archive_owner):
    """Authenticate read-only replay of an issued joint capture and its independent gate.

    The archive owner resolves the original issued readback, the original numerical
    and independently reviewed gate reports, and the independently selected joint
    evidence and original parent. This verdict has no paid, freeze or opening scope.
    """
    pins = (expected_readback_sha256, expected_gate_report_sha256, expected_numerical_report_sha256,
            expected_joint_affine_readback_sha256, expected_parent_sha256, expected_preimage_sha256)
    _require(callable(verify_archive_owner) and all(_pin(pin) for pin in pins)
             and len(set(pins)) == len(pins)
             and type(arm) is str and arm in FIXED_STAGE_ARMS
             and all(type(item) is dict for item in (readback, gate_report, numerical_report)),
             "independent joint archive, parent and original reviewed reports required")

    def require_current():
        _require(tuple(map(commitment, (readback, gate_report, numerical_report))) == pins[:3],
                 "selected joint archive, numerical report or independent gate changed")

    require_current()
    stage = gate_report.get("stage")
    panel = gate_report.get("panel_sha256")
    _require(gate_report.get("schema") == FIXED_STAGE_GATE_SCHEMA and gate_report.get("status") == "assessed"
             and type(stage) is int and 1 <= stage <= 16 and _pin(panel)
             and gate_report.get("numerical_report_sha256") == expected_numerical_report_sha256
             and numerical_report.get("schema") == "compact-boundary-scheduled-checkpoint-panel/v1"
             and numerical_report.get("status") == "scored" and type(numerical_report.get("stage")) is int
             and (numerical_report["stage"], numerical_report.get("panel_sha256"), numerical_report.get("plan_sha256"),
                  numerical_report.get("followup_report_sha256"), numerical_report.get("training_close_sha256")) ==
                 (stage, panel, gate_report.get("evaluation_plan_sha256"), gate_report.get("followup_report_sha256"),
                  gate_report.get("training_close_sha256"))
             and all(_pin(gate_report.get(key)) for key in ("evaluation_plan_sha256", "followup_report_sha256", "training_close_sha256"))
             and numerical_report.get("activation_guidance") == gate_report.get("activation_guidance"),
             "joint archive requires the exact original numerical stage and independent assessed gate")
    available, postimages, closes, generation = (numerical_report.get(key)
        for key in ("availability", "postimages", "closed_arms", "generation"))
    _require(all(type(item) is dict and set(item) == set(FIXED_STAGE_ARMS)
                 for item in (available, postimages, closes, generation))
             and available == gate_report.get("availability"), "joint archive must preserve the complete selected stage")
    postimage = postimages[arm]
    _require((readback.get("parent_sha256"), readback.get("preimage_sha256"))
                 == (numerical_report.get("parent_sha256"), numerical_report.get("before_sha256"))
                 == (expected_parent_sha256, expected_preimage_sha256)
             and readback.get("architecture_sha256") == numerical_report.get("architecture_sha256")
             and readback.get("codec_sha256") == numerical_report.get("codec_sha256"),
             "joint archive requires its exact original parent and restored accepted postimage")
    _require(all(type(generation[name]) is dict and bool(generation[name])
                 and all(type(row) is dict for row in generation[name].values())
                 and _pin(postimages[name])
                 and available[name] == {"status": "reached", "selected_postimage_sha256": postimages[name],
                                         "reason": None}
                 and type(closes[name]) is dict
                 and closes[name] == {"postimage_sha256": postimages[name],
                                      "restored_sha256": expected_preimage_sha256,
                                      "generation_sha256": commitment(generation[name])}
                 for name in FIXED_STAGE_ARMS),
             "joint archive requires the exact original comparative generation and each restored arm closure")
    _check_scheduled_postimage_readback(gate_report, readback, panel_sha256=panel, arm=arm, stage=stage,
        postimage=postimage, expected_joint_affine_readback_sha256=expected_joint_affine_readback_sha256)
    _require(verify_archive_owner(*pins, arm) is True, "independent joint archive owner refused the original scope")
    require_current()
    return True


def fixed_stage_discovery_cost_commitment(bindings, *, study_sha256, scheduled_evidence_sha256,
                                          diagnostic_charges_sha256):
    """Select exact seed, discovery, diagnostic, event and strict readback joins."""
    _require(all(_pin(pin) for pin in (study_sha256, scheduled_evidence_sha256, diagnostic_charges_sha256))
             and type(bindings) is tuple and bool(bindings)
             and all(type(row) is tuple and len(row) == 5 and _name(row[0])
                     and all(_pin(pin) for pin in row[1:]) for row in bindings)
             and all(len({row[position] for row in bindings}) == len(bindings) for position in (0, 3, 4)),
             "ordered discovery cost bindings require an exact seed and distinct paid event and readback")
    return commitment(("reviewed-fixed-stage-activation-discovery-cost/v1", study_sha256,
                       scheduled_evidence_sha256, diagnostic_charges_sha256, bindings))


def _bind_sustained_discovery_costs(study, selected_reviews, attempts, charges, events, bindings):
    _require(tuple(row[0] for row in bindings) == tuple(seed.identifier for seed in study.seeds),
             "discovery costs must cover each original seed in order")
    programmed = {attempt.seed: attempt for attempt in attempts if attempt.arm == "programmed"}
    by_event = {charge.event_sha256: charge for charge in charges}
    for seed, discovery, diagnostic, event_id, readback in bindings:
        review, _, _ = selected_reviews[seed, study.schedule[0]]
        guidance = review.gate_report.get("activation_guidance")
        _require(type(guidance) is dict
                 and (guidance.get("discovery_sha256"), guidance.get("diagnostic_sha256")) == (discovery, diagnostic),
                 "paid discovery or diagnostic differs from the selected activation guidance")
        selected, attempt = by_event.get(event_id), programmed[seed]
        _require(selected is not None and selected.attempt_sha256 == attempt.attempt_sha256
                 and selected.strict_readback_sha256 == readback and events[event_id].disposition == "complete",
                 "the selected discovery requires its original completed paid event and strict readback")
        _require(bool(attempt.assessments) and selected.first_stage == attempt.assessments[0].look,
                 "first-use discovery charge must already cover the first paid programmed look")


JOINT_AFFINE_SUSTAINED_EVIDENCE_SCHEMA = "reviewed-compact-fixed-stage-joint-affine-scheduled-input/v1"
_JOINT_STAGE_PIN = "joint_affine_readback_sha256"


@dataclass(frozen=True)
class FixedStageJointAffineReport:
    gate_report_sha256: str
    parent_sha256: str
    preimage_sha256: str
    joint_affine_sha256: str
    numerical_report: dict


def fixed_stage_joint_affine_scheduled_commitment(rows, *, scheduled_evidence_sha256):
    _require(_pin(scheduled_evidence_sha256) and type(rows) is tuple and bool(rows)
             and all(type(row) is FixedStageJointAffineReport and type(row.numerical_report) is dict
                     and all(_pin(pin) for pin in (row.gate_report_sha256, row.parent_sha256,
                                                 row.preimage_sha256, row.joint_affine_sha256))
                     for row in rows)
             and len({row.gate_report_sha256 for row in rows}) == len(rows),
             "exact independent joint numerical reports and original gate roster required")
    return commitment((JOINT_AFFINE_SUSTAINED_EVIDENCE_SCHEMA, scheduled_evidence_sha256, rows))


def _sustained_joint_affine_report_map(rows, expected_sha256, scheduled_evidence_sha256,
                                       reviews, look_closes, attempts, archive_owner):
    seed_by_attempt = {row.attempt_sha256: row.seed for row in attempts}
    touched = {(seed_by_attempt[row.attempt_sha256], row.look) for row in look_closes}
    marked = tuple(row for row in reviews if (row.seed, row.look) in touched
                   and type(row.gate_report.get("activation_guidance")) is dict
                   and _JOINT_STAGE_PIN in row.gate_report["activation_guidance"])
    if not marked:
        _require(rows is expected_sha256 is archive_owner is None,
                 "joint archive inputs require their original marked paid gates")
        return {}
    _require(callable(archive_owner) and _pin(expected_sha256)
             and fixed_stage_joint_affine_scheduled_commitment(rows, scheduled_evidence_sha256=scheduled_evidence_sha256)
                 == expected_sha256
             and tuple(row.gate_report_sha256 for row in rows) == tuple(row.gate_report_sha256 for row in marked),
             "marked paid looks need the independently selected joint archive roster in gate order")
    return {row.gate_report_sha256: row for row in rows}


def compare_fixed_stage_sustained(validator, *, study, expected_study_sha256, development_design,
        expected_development_design_sha256, step_grid, expected_step_grid_sha256,
        attempts, expected_attempts_sha256, reviews, look_closes, terminal_arms,
        expected_scheduled_evidence_sha256, cost_evidence, expected_cost_evidence_sha256,
        contrast_plan, expected_contrast_plan_sha256, verify_cost_owner, verify_assessment_owner,
        activation_diagnostic_charges=None, expected_activation_diagnostic_charges_sha256=None,
        activation_discovery_cost_bindings=None, expected_activation_discovery_cost_sha256=None,
        joint_affine_reports=None, expected_joint_affine_reports_sha256=None, verify_joint_archive_owner=None):
    """Compare sustained DEVELOPMENT performance on original closed trajectories.

    The independent assessment owner authenticates the exact gate reports and
    numerical archive readbacks before Science may use the result. The cost
    owner authenticates the original per-look clocks and physical close union.
    Neither callback receives an invented cost, re-scored look or FINAL row.
    A selected discovery cost binding makes both original owners authenticate
    the discovery admission, diagnostic, original strict readback and owned
    paid event together. It does not establish discovery-inclusive wall time.
    For the opt-in joint wire, the original archive owner verifies each
    distinct selected paid look against its original numerical and gate report.
    """
    _require(callable(verify_cost_owner) and callable(verify_assessment_owner),
             "independent cost and assessment owners required")
    thresholds, horizons, budget_caps = _study(validator, study, expected_study_sha256)
    contrasts = _selected_contrasts(study, expected_study_sha256, contrast_plan, expected_contrast_plan_sha256)
    _require(tuple(name for name, _ in study.arms) == FIXED_STAGE_ARMS
             and type(study.required_streak) is int and 2 <= study.required_streak <= len(study.schedule)
             and study.stop_after_confirmation is False and _pin(expected_step_grid_sha256),
             "fixed-stage sustained comparison requires the original arms and at least two scheduled passes")
    selected_discovery = (activation_discovery_cost_bindings is not None
                          or expected_activation_discovery_cost_sha256 is not None)
    discovery_owner_pins = (expected_activation_discovery_cost_sha256,) if selected_discovery else ()
    joint_selected = expected_joint_affine_reports_sha256 is not None
    joint_owner_pins = (expected_joint_affine_reports_sha256,) if joint_selected else ()

    def current():
        _require(development_design_commitment(development_design) == expected_development_design_sha256
                 and development_design.study_sha256 == expected_study_sha256
                 and tuple(row[0] for row in development_design.seed_cohorts) == tuple(seed.identifier for seed in study.seeds),
                 "selected fixed-stage DEVELOPMENT design or seed cohort differs")
        _selected_development_grid(study, expected_study_sha256, expected_development_design_sha256,
                                  step_grid, expected_step_grid_sha256)
        _require(commitment(study) == expected_study_sha256 and commitment(attempts) == expected_attempts_sha256
                 and commitment(cost_evidence) == expected_cost_evidence_sha256
                 and commitment(contrast_plan) == expected_contrast_plan_sha256
                 and fixed_stage_scheduled_evidence_commitment(reviews, look_closes, terminal_arms,
                     study_sha256=expected_study_sha256, attempts_sha256=expected_attempts_sha256,
                     cost_evidence_sha256=expected_cost_evidence_sha256,
                     step_grid_sha256=expected_step_grid_sha256) == expected_scheduled_evidence_sha256,
                 "selected scheduled fixed-stage evidence changed")
        diagnostics = _fixed_stage_activation_selection(study, activation_diagnostic_charges,
                                                        expected_activation_diagnostic_charges_sha256)
        if selected_discovery:
            _require(bool(diagnostics) and _pin(expected_activation_discovery_cost_sha256)
                     and fixed_stage_discovery_cost_commitment(activation_discovery_cost_bindings,
                         study_sha256=expected_study_sha256,
                         scheduled_evidence_sha256=expected_scheduled_evidence_sha256,
                         diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256)
                         == expected_activation_discovery_cost_sha256,
                     "selected discovery cost requires the original paid diagnostic roster and exact binding")
        if joint_selected:
            _require(fixed_stage_joint_affine_scheduled_commitment(joint_affine_reports,
                         scheduled_evidence_sha256=expected_scheduled_evidence_sha256)
                     == expected_joint_affine_reports_sha256,
                     "selected original joint archive evidence changed")
        return diagnostics

    diagnostics = current()
    steps = dict(step_grid.steps)
    _require(all(look == f"step-{stage}" and stage <= 16 for look, stage in step_grid.steps),
             "scheduled fixed-stage labels must name their registered accepted optimizer stage")
    selected = _scheduled_fixed_stage_reviews(validator, study, reviews, steps, thresholds)
    close_map = {(row.attempt_sha256, row.look): (row.training_close_sha256, row.evaluation_close_sha256)
                 for row in look_closes}
    elapsed, work = _cost_roster(validator, study, expected_study_sha256, attempts, expected_attempts_sha256,
        cost_evidence, expected_cost_evidence_sha256, retrospective_look_closes=close_map,
        activation_diagnostic_charges=activation_diagnostic_charges or ())
    _require(tuple(row.attempt_sha256 for row in terminal_arms) == tuple(row.attempt_sha256 for row in attempts)
             and tuple(close_map) == tuple((attempt.attempt_sha256, look.look)
                       for attempt in attempts for look in attempt.assessments),
             "paid look and terminal rosters differ from original ordered attempts")
    joint_by_gate = _sustained_joint_affine_report_map(joint_affine_reports, expected_joint_affine_reports_sha256,
        expected_scheduled_evidence_sha256, reviews, look_closes, attempts, verify_joint_archive_owner)
    physical = _event_roster(cost_evidence.events)
    if diagnostics:
        other_closes = {attempt.closeout_receipt_sha256 for attempt in attempts}
        other_closes.update(cell.gate_report["training_close_sha256"] for cell in reviews)
        other_closes.update(close for closes in close_map.values() for close in closes)
        _require(other_closes.isdisjoint(row.owner_close_sha256 for row in activation_diagnostic_charges),
                 "scheduled activation diagnostic close cannot replace original TRAIN, assessment or terminal evidence")
    if selected_discovery:
        _bind_sustained_discovery_costs(study, selected, attempts, activation_diagnostic_charges,
                                        physical, activation_discovery_cost_bindings)
    event_by_close = {event.close_receipt_sha256: event_id for event_id, event in physical.items()}
    protected = set(event_by_close) | {expected_study_sha256, expected_development_design_sha256,
        expected_step_grid_sha256, expected_scheduled_evidence_sha256, expected_cost_evidence_sha256,
        expected_contrast_plan_sha256, *diagnostics, *discovery_owner_pins, *joint_owner_pins}
    joint_archive_ids = {row.joint_affine_sha256 for row in joint_by_gate.values()}
    paid_ids = set(physical) | {row.attempt_sha256 for row in attempts}
    paid_ids.update(look.evaluation_receipt_sha256 for row in attempts for look in row.assessments)
    _require(joint_archive_ids.isdisjoint(protected | paid_ids),
             "joint archive evidence cannot serve as an original paid attempt, assessment, event or close")
    protected.update(joint_archive_ids)
    for cell in reviews:
        protected.add(cell.gate_report_sha256)
        protected.update(value for key, value in cell.gate_report.items() if key.endswith("_sha256") and _pin(value))
    protected.update(row.readback_sha256 for row in look_closes)
    readbacks = {(row.attempt_sha256, row.look): row for row in look_closes}
    observations = iter(cost_evidence.observations)
    seeds = {seed.identifier: seed for seed in study.seeds}
    seen_assessments, used_meters = set(), {}
    records, outcomes = [], {}
    seed_archive_identities = {}
    panel_pin = commitment(study.panel)
    for attempt, terminal in zip(attempts, terminal_arms, strict=True):
        seed, name = seeds[attempt.seed], attempt.arm
        label = (attempt.seed, name)
        expected_prefix = study.schedule[:len(attempt.assessments)]
        _require(tuple(look.look for look in attempt.assessments) == expected_prefix,
                 "scheduled assessments must cover the original optimizer-look prefix")
        seen_postimages, look_records = set(), []
        optimizer_capture = None
        incomplete = False
        for look in attempt.assessments:
            interval, charges = next(observations)
            receipt = readbacks[attempt.attempt_sha256, look.look]
            review, arms, counts = selected[seed.identifier, look.look]
            postimage = arms[name]["selected_postimage_sha256"]
            _require(name in counts and postimage == look.checkpoint_sha256 and postimage not in seen_postimages
                     and look.panel_sha256 == panel_pin and look.evaluation_policy_sha256 == study.evaluation_policy_sha256
                     and look.retention_reference_sha256 == seed.retention_reference_sha256
                     and type(look.gates) is dict and set(look.gates) == set(validator.GATES)
                     and all(type(value) is validator.Counts or value is None for value in look.gates.values())
                     and commitment(look.gates) == commitment(counts[name]),
                     "each paid scheduled look requires distinct accepted checkpoints and its exact independent counts")
            selected_joint = joint_by_gate.get(review.gate_report_sha256)
            joint_pin = None if selected_joint is None else selected_joint.joint_affine_sha256
            identity = _scheduled_fixed_stage_readback(review, receipt, arm=name, stage=steps[look.look],
                postimage=postimage, expected_joint_affine_readback_sha256=joint_pin)
            if selected_joint is not None:
                verify_joint_affine_scheduled_readback(readback=receipt.readback,
                    expected_readback_sha256=receipt.readback_sha256, gate_report=review.gate_report,
                    expected_gate_report_sha256=review.gate_report_sha256, numerical_report=selected_joint.numerical_report,
                    expected_numerical_report_sha256=review.gate_report["numerical_report_sha256"],
                    expected_joint_affine_readback_sha256=joint_pin, expected_parent_sha256=selected_joint.parent_sha256,
                    expected_preimage_sha256=selected_joint.preimage_sha256, arm=name,
                    verify_archive_owner=verify_joint_archive_owner)
                current()
            _require(seed_archive_identities.setdefault(seed.identifier, identity) == identity,
                     "scheduled matched arms changed parent, architecture, codec or reserved split")
            capture = receipt.readback["optimizer_capture_sha256"]
            _require(optimizer_capture is None or capture == optimizer_capture,
                     "scheduled arm changed its original accepted optimizer capture")
            optimizer_capture = capture
            eval_pin = look.evaluation_receipt_sha256
            shares = dict(charges.entries)
            _require(_pin(eval_pin) and eval_pin not in protected and eval_pin not in seen_assessments
                     and eval_pin not in used_meters and terminal.terminal_event_sha256 not in shares
                     and all(shares.get(event_by_close[pin]) == 1 for pin in close_map[attempt.attempt_sha256, look.look]),
                     "scheduled look must bind its original evaluation and complete training and assessment charges")
            seen_assessments.add(eval_pin)
            _fixed_stage_meter_receipts(used_meters, seen_assessments, look.meter, interval)
            seen_postimages.add(postimage)
            incomplete |= arms[name]["gate_status"] == "evidence_incomplete"
            look_records.append({"look": look.look, "optimizer_step": steps[look.look], "checkpoint_sha256": postimage,
                "gate_report_sha256": review.gate_report_sha256, "evaluation_receipt_sha256": eval_pin,
                "gate_counts": deepcopy(review.gate_report["arms"][name]["gate_counts"]),
                "gate_status": arms[name]["gate_status"], "readback_sha256": receipt.readback_sha256,
                "meter": _wire(look.meter), "interval": _wire(interval), "charges": _wire(charges),
                "training_and_evaluation_closes": close_map[attempt.attempt_sha256, look.look]})
            if selected_joint is not None:
                look_records[-1][_JOINT_STAGE_PIN] = joint_pin
        interval, charges = next(observations)
        _fixed_stage_meter_receipts(used_meters, seen_assessments, attempt.closing_meter, interval)
        closing = physical.get(terminal.terminal_event_sha256)
        status = attempt.closeout_status
        _require(closing is not None and closing.close_receipt_sha256 == attempt.closeout_receipt_sha256
                 and tuple(key for key, _ in charges.entries) == terminal.owned_event_sha256s
                 and dict(charges.entries).get(terminal.terminal_event_sha256) == 1
                 and ((closing.disposition == status) if status != "stopped_at_checkpoint" else
                      (closing.disposition in ("complete", "refused") and len(expected_prefix) < len(study.schedule)
                       and selected[seed.identifier, study.schedule[len(expected_prefix)]][1][name]["status"] != "reached")),
                 "scheduled attempt terminal status or owned charge association differs")
        if status == "budget_limit":
            clock = attempt.budget_clock
            cap = budget_caps.get(clock) if type(clock) is str else None
            _require(cap is not None and _pin(attempt.cap_receipt_sha256)
                     and (stamp := getattr(attempt.closing_meter.costs, clock)) is not None and stamp >= cap,
                     "scheduled physical budget closure requires its original measured cap receipt")
        else:
            _require(attempt.budget_clock is attempt.cap_receipt_sha256 is None,
                     "cap evidence belongs to a physical budget-limit close")
        remaining = [selected[seed.identifier, look][1][name]["assessment_status"]
                     for look in study.schedule[len(expected_prefix):]]
        verdict, block = None, status
        if status in ("complete", "budget_limit"):
            if "assessed" in remaining:
                block = "measurement_unavailable"
            elif status == "complete" and remaining:
                block = "assessment_unavailable"
            else:
                verdict = _evaluate(validator, study, expected_study_sha256, attempt, (name, attempt.recipe_sha256),
                                    seed, thresholds, budget_caps, panel_pin)
                block = _confirmation_block(verdict, attempt, budget_caps, require_complete_cap_observation=True)
        confirming = None
        if verdict is not None and verdict.status == "reached" and block is None:
            confirming = deepcopy(next(item for item in look_records if item["look"] == verdict.confirming_checkpoint))
        indeterminate = (incomplete and verdict is not None
                         and verdict.status in ("closed_without_reach", "right_censored"))
        outcomes[label] = (None, "assessment_unavailable") if indeterminate else (verdict, block)
        records.append({"seed": seed.identifier, "arm": name, "attempt_sha256": attempt.attempt_sha256,
            "status": "assessment_unavailable" if indeterminate else block if verdict is None else verdict.status,
            "decision": None if verdict is None else _wire(verdict), "confirmation_budget_block": block if verdict else None,
            "look_evidence": tuple(look_records), "confirming_postimage": confirming,
            "terminal_event_sha256": terminal.terminal_event_sha256, "closeout_status": status,
            "closeout_receipt_sha256": attempt.closeout_receipt_sha256, "closing_meter": _wire(attempt.closing_meter),
            "closing_interval": _wire(interval), "closing_charges": _wire(charges)})

    _require(verify_cost_owner(expected_cost_evidence_sha256, expected_scheduled_evidence_sha256,
                              expected_attempts_sha256, *diagnostics, *discovery_owner_pins, *joint_owner_pins) is True,
             "resource owner refused original scheduled paid evidence")
    current()
    _require(verify_assessment_owner(expected_study_sha256, expected_development_design_sha256,
                                    expected_step_grid_sha256, expected_scheduled_evidence_sha256,
                                    expected_contrast_plan_sha256, *discovery_owner_pins, *joint_owner_pins) is True,
             "independent assessment owner refused the scheduled gate or postimage evidence")
    current()
    pairs, bounds = [], []
    for contrast in contrasts:
        pair_rows, bound_rows = _paired_contrast(study.seeds, horizons, outcomes, contrast["baseline"],
                                                 contrast["candidate"], resolve=_fixed_stage_horizon)
        tags = {"contrast_id": contrast["identifier"], "role": contrast["role"]}
        pairs.extend({**row, **tags} for row in pair_rows)
        bounds.extend({**row, **tags} for row in bound_rows)
    result = {"schema": FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA, "study_sha256": expected_study_sha256,
        "attempts_sha256": expected_attempts_sha256, "development_design_sha256": expected_development_design_sha256,
        "step_grid_sha256": expected_step_grid_sha256, "scheduled_evidence_sha256": expected_scheduled_evidence_sha256,
        "contrast_plan_sha256": expected_contrast_plan_sha256, "cost_evidence_sha256": expected_cost_evidence_sha256,
        "cost_basis": study.cost_basis, "schedule": study.schedule, "required_streak": study.required_streak,
        "physical_paid_events": tuple(_wire(row) for row in cost_evidence.events), "physical_work_ns": work,
        "observed_elapsed_wall": elapsed, "attempt_decisions": tuple(records), "pairs": tuple(pairs),
        "fixed_horizon_attainment": tuple(bounds), "uncertainty_scope": UNCERTAINTY_SCOPE}
    if joint_selected:
        result["joint_affine_scheduled_reports_sha256"] = expected_joint_affine_reports_sha256
    if diagnostics:
        result.update(activation_diagnostic_charges_sha256=expected_activation_diagnostic_charges_sha256,
                      activation_diagnostic_charges=tuple(_wire(row) for row in activation_diagnostic_charges))
    if selected_discovery or any("activation_guidance" in row.gate_report for row in reviews):
        result["activation_discovery_cost_scope"] = ("original_paid_discovery_through_first_programmed_look"
                                                     if selected_discovery else "incomplete_discovery_cost")
        result["activation_discovery_wall_scope"] = "discovery_inclusive_wall_not_established"
    if selected_discovery:
        result.update(activation_discovery_cost_binding_sha256=expected_activation_discovery_cost_sha256,
                      activation_discovery_cost_bindings=activation_discovery_cost_bindings)
    return result


_FIXED_STAGE_READBACK_PINS = frozenset((
    "evaluation_plan_sha256", "numerical_report_sha256", "followup_report_sha256",
    "training_close_sha256", "panel_sha256", "parent_sha256", "architecture_sha256",
    "codec_sha256", "preimage_sha256", "postimage_sha256", "optimizer_capture_sha256",
    "edit_split_sha256", "confirmation_split_sha256", "activation_guidance_sha256",
))


def _fixed_stage_sustained_confirmation(comparison, study, seed, arm):
    """Resolve the original eligible confirmation without projecting the study."""
    schedule = comparison.get("schedule")
    _require(type(study.required_streak) is int and 2 <= study.required_streak <= len(study.schedule)
             and study.stop_after_confirmation is False and type(schedule) in (tuple, list)
             and tuple(schedule) == study.schedule
             and type(comparison.get("required_streak")) is int
             and comparison["required_streak"] == study.required_streak,
             "sustained paid comparison must retain the original schedule and streak")
    decisions = comparison.get("attempt_decisions")
    slots = tuple((item.identifier, name) for item in study.seeds for name, _ in study.arms)
    _require(tuple(name for name, _ in study.arms) == FIXED_STAGE_ARMS
             and (seed, arm) in slots and type(decisions) in (tuple, list)
             and all(type(row) is dict for row in decisions)
             and tuple((row.get("seed"), row.get("arm")) for row in decisions) == slots,
             "sustained paid comparison must retain every original seed and arm")
    row = decisions[slots.index((seed, arm))]
    decision, chosen, evidence = (row.get(key) for key in ("decision", "confirming_postimage", "look_evidence"))
    _require(row.get("status") == "reached" and type(decision) is dict and decision.get("status") == "reached"
             and "confirmation_budget_block" in row and row["confirmation_budget_block"] is None
             and row.get("closeout_status") in ("complete", "budget_limit")
             and _pin(row.get("attempt_sha256")) and _pin(row.get("terminal_event_sha256"))
             and _pin(row.get("closeout_receipt_sha256")) and type(chosen) is dict
             and type(evidence) in (tuple, list) and all(type(look) is dict for look in evidence)
             and tuple(look.get("look") for look in evidence) == study.schedule[:len(evidence)],
             "sustained archive requires the original reached, unblocked confirmation and paid look prefix")
    # Replay the ordering of the already authenticated gate dispositions.
    # This catches a resealed result that nominates an earlier or later stage.
    streak, selected, start = 0, None, None
    for item in evidence:
        streak = streak + 1 if item.get("gate_status") == "all_gates_passed" else 0
        if streak == 1:
            start = item["look"]
        if streak == study.required_streak:
            selected = item
            break
    _require(selected is not None and chosen == selected
             and selected["look"] == decision.get("confirming_checkpoint") and start == decision.get("streak_start")
             and type(chosen.get("optimizer_step")) is int and 1 <= chosen["optimizer_step"] <= 16
             and chosen.get("look") == f"step-{chosen['optimizer_step']}"
             and all(_pin(chosen.get(key)) for key in ("gate_report_sha256", "checkpoint_sha256",
                                                      "readback_sha256", "evaluation_receipt_sha256")),
             "sustained archive must select exactly the original eligible confirming checkpoint")
    return row, selected


def _selected_fixed_stage_sustained_postimage(*, study, expected_study_sha256, paid_comparison,
        expected_paid_comparison_sha256, readback, expected_readback_sha256, seed, arm):
    _require(type(study) is Study and _name(seed) and _name(arm)
             and all(_pin(pin) for pin in (expected_study_sha256, expected_paid_comparison_sha256, expected_readback_sha256))
             and commitment(study) == expected_study_sha256
             and commitment(paid_comparison) == expected_paid_comparison_sha256
             and paid_comparison.get("study_sha256") == expected_study_sha256
             and paid_comparison.get("cost_basis") == study.cost_basis
             and all(_pin(paid_comparison.get(key)) for key in ("development_design_sha256", "step_grid_sha256",
                     "scheduled_evidence_sha256", "attempts_sha256", "cost_evidence_sha256")),
             "exact original sustained paid comparison, selected readback and study required")
    row, look = _fixed_stage_sustained_confirmation(paid_comparison, study, seed, arm)
    joint_pin = look.get(_JOINT_STAGE_PIN)
    joint = _JOINT_STAGE_PIN in look
    fields = _FIXED_STAGE_READBACK_PINS | {"schema", "stage", "arm"}
    schema = "compact-boundary-scheduled-postimage-readback/v1"
    if joint:
        _require(_pin(joint_pin) and _pin(paid_comparison.get("joint_affine_scheduled_reports_sha256"))
                 and type(readback) is dict and readback.get(_JOINT_STAGE_PIN) == joint_pin,
                 "joint scheduled archive must match the independently paid original look")
        fields = fields | {_JOINT_STAGE_PIN}
        schema = "compact-boundary-scheduled-joint-affine-postimage-readback/v1"
    _require(type(readback) is dict and set(readback) == fields and readback["schema"] == schema
             and all(_pin(readback[key]) for key in _FIXED_STAGE_READBACK_PINS)
             and readback["edit_split_sha256"] != readback["confirmation_split_sha256"]
             and type(readback["stage"]) is int and readback["stage"] == look["optimizer_step"]
             and readback["arm"] == arm and readback["postimage_sha256"] == look["checkpoint_sha256"]
             and commitment(readback) == expected_readback_sha256 == look["readback_sha256"],
             "scheduled archive readback must bind the exact sustained confirming checkpoint")
    return {"schema": "reviewed-compact-fixed-stage-paid-postimage-binding/v1",
            "study_sha256": expected_study_sha256, "seed": seed, "arm": arm,
            "attempt_sha256": row["attempt_sha256"], "gate_report_sha256": look["gate_report_sha256"],
            "paid_comparison_sha256": expected_paid_comparison_sha256, "postimage_readback_sha256": expected_readback_sha256,
            "postimage_sha256": look["checkpoint_sha256"], "optimizer_capture_sha256": readback["optimizer_capture_sha256"]}


def _selected_fixed_stage_paid_postimage(*, study, expected_study_sha256, paid_comparison,
        expected_paid_comparison_sha256, readback, expected_readback_sha256, seed, arm):
    """Validate the wire identities shared by archive readback and freeze."""
    if type(paid_comparison) is dict and paid_comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA:
        return _selected_fixed_stage_sustained_postimage(study=study, expected_study_sha256=expected_study_sha256,
            paid_comparison=paid_comparison, expected_paid_comparison_sha256=expected_paid_comparison_sha256,
            readback=readback, expected_readback_sha256=expected_readback_sha256, seed=seed, arm=arm)
    readback_pins = _FIXED_STAGE_READBACK_PINS
    _require(_name(seed) and _name(arm)
             and all(_pin(pin) for pin in (expected_study_sha256, expected_paid_comparison_sha256,
                                            expected_readback_sha256)),
             "independent paid comparison, numerical readback and archive owner required")

    def current():
        _require(type(study) is Study and commitment(study) == expected_study_sha256
                 and type(paid_comparison) is dict and commitment(paid_comparison) == expected_paid_comparison_sha256
                 and paid_comparison.get("schema") == FIXED_STAGE_COMPARISON_SCHEMA
                 and paid_comparison.get("study_sha256") == expected_study_sha256
                 and paid_comparison.get("cost_basis") == study.cost_basis
                 and all(_pin(paid_comparison.get(key)) for key in (
                     "roster_sha256", "fixed_stage_paid_looks_sha256", "cost_evidence_sha256")),
                 "exact original paid fixed-stage comparison and study required")
        _require(type(readback) is dict and commitment(readback) == expected_readback_sha256
                 and set(readback) == readback_pins | {"schema", "stage", "arm"}
                 and readback["schema"] == "compact-boundary-scheduled-postimage-readback/v1"
                 and all(_pin(readback[key]) for key in readback_pins)
                 and type(readback["stage"]) is int and 1 <= readback["stage"] <= 16
                 and type(paid_comparison.get("stage")) is int and paid_comparison["stage"] == readback["stage"]
                 and study.schedule == (f"step-{readback['stage']}",)
                 and readback["arm"] == arm
                 and readback["edit_split_sha256"] != readback["confirmation_split_sha256"],
                 "exact selected numerical readback, stage, arm and distinct split required")

        ordered_seeds = tuple(row.identifier for row in study.seeds)
        ordered_arms = tuple(name for name, _ in study.arms)
        slots = tuple((label, name) for label in ordered_seeds for name in ordered_arms)
        _require(ordered_arms == FIXED_STAGE_ARMS and (seed, arm) in slots,
                 "selected seed and arm must be original fixed-stage study slots")
        for key in ("arms", "attempt_decisions"):
            rows = paid_comparison.get(key)
            _require(type(rows) in (list, tuple) and all(type(row) is dict for row in rows)
                     and tuple((row.get("seed"), row.get("arm")) for row in rows) == slots,
                     "paid fixed-stage evidence must retain the original seed and arm roster")

        guidance_rows = paid_comparison.get("activation_guidance_roster")
        _require(type(guidance_rows) in (list, tuple)
                 and all(type(row) in (list, tuple) and len(row) == 3 for row in guidance_rows)
                 and tuple(row[0] for row in guidance_rows) == ordered_seeds
                 and fixed_stage_activation_guidance_roster_commitment(
                     tuple((row[0], row[1]) for row in guidance_rows), study_sha256=expected_study_sha256)
                     == paid_comparison.get("activation_guidance_roster_sha256"),
                 "exact original paid activation guidance roster required")
        guidance_seed, guidance_pin, guidance = guidance_rows[ordered_seeds.index(seed)]
        _require(guidance_seed == seed and type(guidance) is dict
                 and set(guidance) == _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS | {"schema"}
                 and guidance["schema"] == _FIXED_STAGE_ACTIVATION_GUIDANCE_SCHEMA
                 and all(_pin(guidance[key]) for key in _FIXED_STAGE_ACTIVATION_GUIDANCE_PINS)
                 and commitment(guidance) == guidance_pin == readback["activation_guidance_sha256"]
                 and guidance["confirmation_panel_sha256"] == readback["panel_sha256"],
                 "numerical readback differs from the original paid activation guidance and panel")

        index = slots.index((seed, arm))
        terminal, decision = (paid_comparison[key][index] for key in ("arms", "attempt_decisions"))
        availability, look = terminal.get("availability"), decision.get("look_evidence")
        shared_pins = ("evaluation_plan_sha256", "numerical_report_sha256", "followup_report_sha256",
                       "training_close_sha256", "panel_sha256")
        _require(type(terminal.get("stage")) is int and terminal["stage"] == readback["stage"]
                 and _pin(terminal.get("gate_report_sha256")) and _pin(terminal.get("attempt_sha256"))
                 and terminal["attempt_sha256"] == decision.get("attempt_sha256")
                 and all(terminal.get(key) == readback[key] for key in shared_pins)
                 and type(availability) is dict and availability.get("status") == "reached"
                 and availability.get("assessment_status") == "assessed"
                 and type(look) is dict and look.get("look") == study.schedule[0]
                 and _pin(look.get("evaluation_receipt_sha256"))
                 and availability.get("selected_postimage_sha256") == look.get("checkpoint_sha256")
                     == readback["postimage_sha256"],
                 "exact original assessed paid look, TRAIN close and postimage required")
        return (terminal["attempt_sha256"], terminal["gate_report_sha256"],
                readback["postimage_sha256"], readback["optimizer_capture_sha256"])

    attempt_sha256, gate_report_sha256, postimage_sha256, optimizer_capture_sha256 = current()
    return {"schema": "reviewed-compact-fixed-stage-paid-postimage-binding/v1",
            "study_sha256": expected_study_sha256, "seed": seed, "arm": arm,
            "attempt_sha256": attempt_sha256, "gate_report_sha256": gate_report_sha256,
            "paid_comparison_sha256": expected_paid_comparison_sha256, "postimage_readback_sha256": expected_readback_sha256,
            "postimage_sha256": postimage_sha256, "optimizer_capture_sha256": optimizer_capture_sha256}


def bind_fixed_stage_paid_postimage(*, study, expected_study_sha256, paid_comparison,
        expected_paid_comparison_sha256, readback, expected_readback_sha256, seed, arm,
        verify_archive_owner):
    """Bind one assessed paid stage to an independently authenticated numerical readback.

    The paid comparison and the readback keep their original wire identities.
    The owner resolves the exact snapshots and optimizer capture behind the
    readback, including fields the paid comparison does not observe. This join
    issues no packed terminal, checkpoint approval, or FINAL authority.
    """
    _require(callable(verify_archive_owner), "independent archive owner required")

    def current():
        return _selected_fixed_stage_paid_postimage(study=study, expected_study_sha256=expected_study_sha256,
            paid_comparison=paid_comparison, expected_paid_comparison_sha256=expected_paid_comparison_sha256,
            readback=readback, expected_readback_sha256=expected_readback_sha256, seed=seed, arm=arm)

    selected = current()
    _require(verify_archive_owner(expected_study_sha256, expected_paid_comparison_sha256, expected_readback_sha256,
                                  seed, arm) is True and current() == selected,
             "archive owner refused or selected paid postimage evidence changed")
    return selected


FIXED_STAGE_FINAL_RESERVATION_SCHEMA = "reviewed-fixed-stage-opaque-final-reservation/v1"
FIXED_STAGE_FINAL_ARCHIVE_SCHEMA = "reviewed-fixed-stage-final-archive/v1"
FIXED_STAGE_FROZEN_FINAL_SCHEMA = "reviewed-frozen-fixed-stage-archive-final/v1"


@dataclass(frozen=True)
class FixedStageFinalReservation:
    development_design_sha256: str
    global_split_sha256: str
    population_sha256: str
    final_policy_sha256: str
    reserved_final_count: int
    opaque_final_sha256: str
    access_policy_sha256: str
    owner_close_sha256: str


@dataclass(frozen=True)
class FixedStageFinalArchive:
    paid_postimage_binding_sha256: str
    training_close_sha256: str
    archive_manifest_sha256: str
    owner_close_sha256: str


def fixed_stage_final_reservation_commitment(reservation):
    _require(type(reservation) is FixedStageFinalReservation
             and type(reservation.reserved_final_count) is int and reservation.reserved_final_count > 0
             and all(_pin(getattr(reservation, key)) for key in (
                 "development_design_sha256", "global_split_sha256", "population_sha256",
                 "final_policy_sha256", "opaque_final_sha256", "access_policy_sha256", "owner_close_sha256")),
             "exact opaque FINAL reservation, protected split, scope and owner close required")
    return commitment((FIXED_STAGE_FINAL_RESERVATION_SCHEMA, reservation))


def fixed_stage_final_archive_commitment(archive):
    _require(type(archive) is FixedStageFinalArchive and all(_pin(pin) for pin in asdict(archive).values())
             and len(set(asdict(archive).values())) == 4,
             "exact sealed fixed-stage archive, original TRAIN close and distinct archive-owner close required")
    return commitment((FIXED_STAGE_FINAL_ARCHIVE_SCHEMA, archive))


def _fixed_stage_final_look(validator, *, study, plan, comparison, binding, look_label, horizon, budget_caps):
    slot = lambda row: (row.get("seed"), row.get("arm")) == (plan.seed, plan.arm)
    if comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA:
        row, look = _fixed_stage_sustained_confirmation(comparison, study, plan.seed, plan.arm)
        terminal = row
        gate_status = look["gate_status"]
        terminal_disposition = terminal["closeout_status"]  # Checked against its original physical event below.
    else:
        terminal = _one_final_row(comparison.get("arms"), slot, "one original fixed-stage paid terminal required")
        row = _one_final_row(comparison.get("attempt_decisions"), slot, "one original fixed-stage decision required")
        look = row.get("look_evidence")
        gate_status = terminal["availability"].get("gate_status")
        terminal_disposition = terminal.get("terminal_event_disposition")
    decision = row.get("decision")
    _require(row.get("status") == "reached" and type(decision) is dict and decision.get("status") == "reached"
             and decision.get("confirming_checkpoint") == look_label and _name(decision.get("scope"))
             and "confirmation_budget_block" in row and row["confirmation_budget_block"] is None
             and gate_status == "all_gates_passed"
             and type(look) is dict and look.get("look") == look_label
             and look.get("checkpoint_sha256") == binding["postimage_sha256"]
             and terminal.get("closeout_status") in ("complete", "budget_limit")
             and terminal_disposition == terminal["closeout_status"]
             and _pin(terminal.get("closeout_receipt_sha256")) and _pin(terminal.get("terminal_event_sha256")),
             "archive FINAL freeze requires the original eligible paid confirmation and terminal")
    terminal_event = _one_final_row(comparison.get("physical_paid_events"),
        lambda event: event.get("event_sha256") == terminal["terminal_event_sha256"],
        "original paid terminal event required")
    _require((terminal_event.get("close_receipt_sha256"), terminal_event.get("disposition"))
                 == (terminal["closeout_receipt_sha256"], terminal["closeout_status"]),
             "original paid terminal event differs from its close or disposition")
    meter = look.get("meter")
    _require(type(meter) is dict and set(meter) == set(Meter.__dataclass_fields__)
             and type(meter["costs"]) is dict and set(meter["costs"]) == set(COVERED_CLOCKS)
             and type(meter["clock_receipts"]) in (list, tuple),
             "archive FINAL freeze requires the exact confirming meter")
    typed_meter = Meter(**{**meter, "costs": validator.Costs(**meter["costs"]),
                          "clock_receipts": tuple(meter["clock_receipts"])})
    costs = _meter_costs(validator, typed_meter, attempt_sha256=binding["attempt_sha256"],
                         cost_policy_sha256=study.cost_policy_sha256, stage=look_label, scope=CUMULATIVE_ARM)
    interval, charges = look.get("interval"), look.get("charges")
    _require(type(interval) is dict and set(interval) == set(MeterInterval.__dataclass_fields__)
             and type(charges) is dict and set(charges) == set(ChargeManifest.__dataclass_fields__)
             and (interval["attempt_sha256"], interval["stage"]) == (charges["attempt_sha256"], charges["stage"])
                 == (binding["attempt_sha256"], look_label)
             and commitment(interval) == typed_meter.interval_manifest_sha256
             and commitment(charges) == typed_meter.charge_manifest_sha256,
             "confirming meter must bind the original paid interval and charge manifests")
    wall = interval["wall"]
    _require(wall is None or type(wall) is dict and set(wall) == set(WallSpan.__dataclass_fields__),
             "confirming meter requires its original measured wall span")
    _wall_evidence(typed_meter, None if wall is None else WallSpan(**wall), None, study.cost_basis)
    elapsed = getattr(costs, plan.clock)
    _require(elapsed is not None and elapsed <= horizon
             and commitment(costs) == commitment(decision.get("confirming_costs")),
             "archive FINAL freeze requires the measured confirming cost within the selected horizon")
    _require(all(cap is None or (stamp := getattr(costs, clock)) is not None and stamp <= cap
                 for clock, cap in budget_caps.items()),
             "archive FINAL freeze requires measured confirming cost within every execution cap")
    return {"confirming_look": look_label, "development_evaluation_sha256": look["evaluation_receipt_sha256"],
            "development_meter_sha256": typed_meter.record_sha256,
            "development_clock_receipt_sha256": typed_meter.clock_receipts[COVERED_CLOCKS.index(plan.clock)],
            "attempt_closeout_sha256": terminal["closeout_receipt_sha256"],
            "decision_scope": decision["scope"], "clock": plan.clock, "elapsed": elapsed, "horizon": horizon}


def freeze_fixed_stage_archive_final(validator, *, study, development_design, step_grid,
        expected_step_grid_sha256, plan, expected_plan_sha256, paid_comparison, expected_paid_comparison_sha256,
        readback, expected_readback_sha256, expected_binding_sha256, archive, expected_archive_sha256,
        reservation, expected_reservation_sha256, verify_archive_owner, verify_final_owner):
    """Freeze one eligible archive against an independently preregistered opaque FINAL reserve.

    The archive owner authenticates the original staged snapshot, optimizer
    capture, and closure behind the artifact commitment. The FINAL owner
    authenticates preregistration, original split ancestry across the edit,
    discovery and confirmation populations, and the separate untouched FINAL
    reserve and access policy. No FINAL rows, opener or scoring grant enter
    this function, and the archive is not a packed terminal.
    """
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS, "archive FINAL requires the original physical clock order")
    _require(callable(verify_archive_owner) and callable(verify_final_owner)
             and all(_pin(pin) for pin in (expected_plan_sha256, expected_step_grid_sha256,
                 expected_binding_sha256, expected_archive_sha256, expected_reservation_sha256)),
             "independently selected fixed-stage plan, archive, opaque reservation and owners required")

    def current():
        _require(final_checkpoint_plan_commitment(plan) == expected_plan_sha256
                 and development_design_commitment(development_design) == plan.development_design_sha256
                 and development_design.study_sha256 == plan.study_sha256,
                 "exact preregistered fixed-stage plan and original development design required")
        thresholds, horizons, budget_caps = _study(validator, study, plan.study_sha256)
        horizon = horizons[plan.clock]
        _require(study.cost_basis == "first_use" and study.reuse_count is None
                 and study.stop_after_confirmation is False and horizon is not None
                 and tuple(label for label, _, _ in development_design.seed_cohorts)
                     == tuple(seed.identifier for seed in study.seeds),
                 "original first-use cohort and selected measured horizon required")
        _selected_development_grid(study, plan.study_sha256, plan.development_design_sha256,
                                   step_grid, expected_step_grid_sha256)
        binding = _selected_fixed_stage_paid_postimage(study=study, expected_study_sha256=plan.study_sha256,
            paid_comparison=paid_comparison, expected_paid_comparison_sha256=expected_paid_comparison_sha256,
            readback=readback, expected_readback_sha256=expected_readback_sha256, seed=plan.seed, arm=plan.arm)
        if paid_comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA:
            look_label, step = f"step-{readback['stage']}", readback["stage"]
            _require(paid_comparison["development_design_sha256"] == plan.development_design_sha256
                     and paid_comparison["step_grid_sha256"] == expected_step_grid_sha256
                     and dict(step_grid.steps).get(look_label) == step,
                     "sustained FINAL freeze requires the original DEVELOPMENT design and full optimizer grid")
        else:
            _require(len(study.schedule) == study.required_streak == 1,
                     "original one-stage comparison requires one selected look")
            (look_label, step), = step_grid.steps
            cutoffs = tuple((gate, value.as_integer_ratio()) for gate, value in thresholds.items())
            _require(commitment(paid_comparison.get("cutoffs")) == commitment(cutoffs),
                     "archive FINAL requires the original paid gate order and cutoffs")
        _require(commitment(binding) == expected_binding_sha256
                 and step == readback["stage"] and look_label == f"step-{step}",
                 "exact selected binding and fixed-stage optimizer step required")
        _require(fixed_stage_final_archive_commitment(archive) == expected_archive_sha256
                 and archive.paid_postimage_binding_sha256 == expected_binding_sha256
                 and archive.training_close_sha256 == readback["training_close_sha256"],
                 "archive must bind the original TRAIN close and exact selected paid postimage")
        _require(fixed_stage_final_reservation_commitment(reservation) == expected_reservation_sha256
                 and (reservation.development_design_sha256, reservation.global_split_sha256,
                      reservation.population_sha256, reservation.reserved_final_count, reservation.final_policy_sha256)
                     == (plan.development_design_sha256, development_design.global_split_sha256,
                         development_design.population_sha256, development_design.reserved_final_count,
                         plan.final_policy_sha256)
                 and reservation.opaque_final_sha256 not in (
                     reservation.global_split_sha256, readback["edit_split_sha256"],
                     readback["confirmation_split_sha256"], readback["panel_sha256"]),
                 "untouched opaque FINAL reserve must belong to the original protected split and policy")

        if paid_comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA:
            _, protected = _fixed_stage_prior_paid_identities(paid_comparison, (readback, binding))
            _independent_sustained_final_closes((archive.owner_close_sha256, reservation.owner_close_sha256), protected)
        observed = _fixed_stage_final_look(validator, study=study, plan=plan, comparison=paid_comparison,
            binding=binding, look_label=look_label, horizon=horizon, budget_caps=budget_caps)
        _require(len({archive.owner_close_sha256, reservation.owner_close_sha256, archive.training_close_sha256,
                      observed["attempt_closeout_sha256"], observed["development_evaluation_sha256"]}) == 5,
                 "archive, reservation, TRAIN, evaluation and attempt closes must keep distinct identities")
        train_cohort = next(cohort for label, _, cohort in development_design.seed_cohorts if label == plan.seed)
        return {"schema": FIXED_STAGE_FROZEN_FINAL_SCHEMA, "plan_sha256": expected_plan_sha256,
                "study_sha256": plan.study_sha256, "development_design_sha256": plan.development_design_sha256,
                "original_global_split_sha256": reservation.global_split_sha256,
                "population_sha256": reservation.population_sha256, "train_cohort_sha256": train_cohort,
                "final_policy_sha256": plan.final_policy_sha256, "final_reservation_sha256": expected_reservation_sha256,
                "opaque_final_sha256": reservation.opaque_final_sha256, "reserved_final_count": reservation.reserved_final_count,
                "final_access_policy_sha256": reservation.access_policy_sha256,
                "reservation_owner_close_sha256": reservation.owner_close_sha256,
                "seed": plan.seed, "arm": plan.arm, "recipe_sha256": dict(study.arms)[plan.arm],
                "attempt_sha256": binding["attempt_sha256"], "gate_report_sha256": binding["gate_report_sha256"],
                "candidate_sha256": binding["postimage_sha256"], "optimizer_capture_sha256": binding["optimizer_capture_sha256"],
                "optimizer_steps": step, "optimizer_step_grid_sha256": expected_step_grid_sha256,
                "training_close_sha256": archive.training_close_sha256, "archive_sha256": expected_archive_sha256,
                "archive_manifest_sha256": archive.archive_manifest_sha256, "archive_owner_close_sha256": archive.owner_close_sha256,
                "paid_postimage_binding_sha256": expected_binding_sha256, "postimage_readback_sha256": expected_readback_sha256,
                "paid_comparison_sha256": expected_paid_comparison_sha256,
                "activation_guidance_sha256": readback["activation_guidance_sha256"], **observed,
                **({_JOINT_STAGE_PIN: readback[_JOINT_STAGE_PIN]} if _JOINT_STAGE_PIN in readback else {})}

    selected = current()
    _require(verify_archive_owner(expected_archive_sha256, expected_binding_sha256, selected["training_close_sha256"]) is True
             and current() == selected, "archive owner refused or selected fixed-stage evidence changed")
    _require(verify_final_owner(expected_plan_sha256, expected_reservation_sha256,
                                expected_paid_comparison_sha256, expected_readback_sha256) is True
             and current() == selected, "FINAL owner refused or selected fixed-stage evidence changed")
    return selected


FIXED_STAGE_FINAL_RESOURCE_RESULT_SCHEMA = "verified-fixed-stage-archive-final-resources/v1"


def _fixed_stage_final_resource_reports(plan, frozen, readback, candidate, parent, review, reference):
    _require((review is None or candidate is not None) and (parent is None) == (reference is None)
             and (parent is None or candidate is not None),
             "FINAL findings require their exact scored bodies and independently selected review")
    if candidate is None:
        return None
    arm, step = frozen["arm"], frozen["optimizer_steps"]
    common = {"status": "scored", "frozen_checkpoint_sha256": plan.candidate_freeze_sha256,
        "final_panel_sha256": plan.final_panel_sha256, "final_reservation_sha256": frozen["final_reservation_sha256"],
        "postimage_readback_sha256": frozen["postimage_readback_sha256"], "decision_scope": frozen["decision_scope"]}
    _require(type(candidate) is dict and candidate.get("schema") == "compact-boundary-fixed-stage-final-scored/v1"
             and all(candidate.get(key) == value for key, value in common.items())
             and type(candidate.get("optimizer_steps")) is int and candidate["optimizer_steps"] == step
             and (candidate.get("arm"), candidate.get("postimage_sha256")) == (arm, frozen["candidate_sha256"])
             and all(_pin(candidate.get(key)) for key in ("final_scoring_sha256", "final_admission_sha256"))
             and all(candidate.get(key) is False for key in (
                 "independent_legal_fidelity_measured", "formal_validity_measured", "convergence_measured"))
             and all(type(candidate.get(key)) is dict and set(candidate[key]) == {arm}
                     and type(candidate[key][arm]) is dict for key in ("scores", "generation", "closed_arms"))
             and set(candidate["scores"][arm]) == set(candidate["generation"][arm])
             and len(candidate["generation"][arm]) == frozen["reserved_final_count"]
             and candidate["closed_arms"][arm] == {"postimage_sha256": frozen["candidate_sha256"],
                 "restored_sha256": readback["preimage_sha256"],
                 "generation_sha256": commitment(candidate["generation"][arm])},
             "exact restored fixed-stage candidate and complete FINAL rows required")
    scoring_wire = {"schema": "compact-boundary-fixed-stage-final-scoring-plan/v1",
        "frozen_checkpoint_sha256": plan.candidate_freeze_sha256, "final_panel_sha256": plan.final_panel_sha256,
        "final_admission_sha256": candidate["final_admission_sha256"]}
    _require(commitment(scoring_wire) == candidate["final_scoring_sha256"],
             "FINAL paid work must bind the original scoring admission")
    if review is not None:
        _require(type(review) is dict and review.get("schema") == "compact-boundary-fixed-stage-final-independent-gates/v1"
                 and review.get("status") in ("all_gates_passed", "did_not_clear", "evidence_incomplete")
                 and type(review.get("optimizer_steps")) is int and review["optimizer_steps"] == step
                 and review.get("numerical_report_sha256") == commitment(candidate)
                 and review.get("final_policy_sha256") == plan.final_policy_sha256
                 and all(_pin(review.get(key)) for key in (
                     "plan_sha256", "review_policy_sha256", "observation_manifest_sha256", "translation_handoffs_sha256"))
                 and all(review.get(key) == candidate[key] for key in (
                     "frozen_checkpoint_sha256", "final_panel_sha256", "final_reservation_sha256", "decision_scope",
                     "final_scoring_sha256", "final_admission_sha256", "arm", "postimage_sha256"))
                 and type(review.get("rows")) is dict and set(review["rows"]) == set(candidate["generation"][arm]),
                 "exact selected FINAL candidate review and unchanged numerical result required")
    if parent is None:
        _require(review is None or "retention_reference_sha256" in review and review["retention_reference_sha256"] is None,
                 "candidate FINAL review cannot borrow an unobserved parent result")
        return None
    baseline = "original_parent"
    _require(type(parent) is dict and parent.get("schema") == "compact-boundary-fixed-stage-final-original-parent-scored/v1"
             and all(parent.get(key) == value for key, value in common.items())
             and type(parent.get("optimizer_steps")) is int and parent["optimizer_steps"] == 0
             and parent.get("arm") == baseline and parent.get("original_parent_sha256") == readback["parent_sha256"]
             and parent.get("postimage_sha256") == readback["preimage_sha256"]
             and _pin(parent.get("final_review_sha256"))
             and (review is None or parent["final_review_sha256"] == review["plan_sha256"])
             and parent.get("candidate_numerical_report_sha256") == commitment(candidate)
             and all(parent.get(key) is False for key in (
                 "independent_legal_fidelity_measured", "formal_validity_measured", "convergence_measured"))
             and all(parent.get(key) == candidate[key] for key in ("final_scoring_sha256", "final_admission_sha256"))
             and all(_pin(parent.get(key)) for key in ("parent_plan_sha256", "parent_selection_receipt_sha256"))
             and all(type(parent.get(key)) is dict and set(parent[key]) == {baseline}
                     and type(parent[key][baseline]) is dict for key in ("scores", "generation", "closed_arms"))
             and set(parent["scores"][baseline]) == set(parent["generation"][baseline]) == set(candidate["generation"][arm])
             and parent["closed_arms"][baseline] == {"postimage_sha256": readback["preimage_sha256"],
                 "restored_sha256": readback["preimage_sha256"],
                 "generation_sha256": commitment(parent["generation"][baseline])},
             "baseline paid work requires the exact separately restored original parent on the same FINAL rows")
    parent_wire = {"schema": "compact-boundary-fixed-stage-final-original-parent-plan/v1",
        "final_scoring_sha256": parent["final_scoring_sha256"], "final_review_sha256": parent["final_review_sha256"],
        "selection_receipt_sha256": parent["parent_selection_receipt_sha256"]}
    _require(commitment(parent_wire) == parent["parent_plan_sha256"]
             and type(reference) is dict and set(reference) == {"schema", "parent_sha256", "postimage_sha256", "panel_sha256",
                 "policy_sha256", "assessment_receipt_sha256", "row_fidelity", "original_parent_evidence"}
             and reference["schema"] == "compact-boundary-scheduled-original-parent-retention/v2"
             and (reference["parent_sha256"], reference["postimage_sha256"], reference["panel_sha256"])
                 == (readback["parent_sha256"], readback["preimage_sha256"], plan.final_panel_sha256)
             and _pin(reference["policy_sha256"])
             and (review is None or reference["policy_sha256"] == review["review_policy_sha256"])
             and _pin(reference["assessment_receipt_sha256"]) and type(reference["original_parent_evidence"]) is dict
             and set(reference["original_parent_evidence"]) == {"review_plan_sha256", "evaluation_plan_sha256",
                 "parent_plan_sha256", "numerical_report_sha256", "observation_manifest_sha256",
                 "translation_handoffs_sha256"}
             and type(reference["row_fidelity"]) in (list, tuple)
             and all(type(row) in (list, tuple) and len(row) == 2 and _name(row[0])
                     and (row[1] is None or type(row[1]) is bool) for row in reference["row_fidelity"])
             and all(reference["original_parent_evidence"].get(key) == value for key, value in {
                 "review_plan_sha256": parent["final_review_sha256"], "evaluation_plan_sha256": parent["final_scoring_sha256"],
                 "parent_plan_sha256": parent["parent_plan_sha256"], "numerical_report_sha256": commitment(parent)}.items())
             and all(_pin(reference["original_parent_evidence"].get(key)) for key in (
                 "observation_manifest_sha256", "translation_handoffs_sha256")),
             "completed baseline costs require the exact same-panel independent parent retention receipt")
    rows = tuple(row[0] for row in reference["row_fidelity"])
    _require(len(set(rows)) == len(rows) and set(rows) <= set(candidate["generation"][arm])
             and (review is None or type(review.get("gate_rows")) is dict
                  and type(review["gate_rows"].get("source_fidelity")) in (list, tuple)
                  and tuple(review["gate_rows"]["source_fidelity"]) == rows),
             "original-parent retention must retain its original ordered eligible FINAL roster")
    reference_pin = commitment(reference)
    _require(review is None or review.get("retention_reference_sha256") == reference_pin,
             "candidate FINAL review selected a different independent parent result")
    return reference_pin


def _fixed_stage_paid_scope_pins(row):
    pins = set()
    meter, interval = row.get("meter"), row.get("interval")
    if type(meter) is dict:
        pins.update(meter.get(key) for key in ("record_sha256", "interval_manifest_sha256", "charge_manifest_sha256"))
        clock_receipts = meter.get("clock_receipts")
        if type(clock_receipts) in (list, tuple):
            pins.update(clock_receipts)
    if type(interval) is dict:
        pins.update(interval.get(key) for key in ("scope_receipt_sha256", "subject_sha256"))
        wall = interval.get("wall")
        if type(wall) is dict:
            pins.add(wall.get("receipt_sha256"))
    return {value for value in pins if _pin(value)}


def _fixed_stage_prior_paid_identities(development, selected):
    physical = development.get("physical_paid_events")
    sustained = development.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA
    decisions = development.get("attempt_decisions")
    attempts = decisions if sustained else development.get("arms")
    _require(type(physical) in (list, tuple) and bool(physical)
             and all(type(row) is dict and set(row) == set(PaidEvent.__dataclass_fields__) for row in physical)
             and all(type(rows) in (list, tuple) and all(type(row) is dict for row in rows)
                     for rows in (attempts, decisions)),
             "complete original fixed-stage development attempts, measured events and closures required")
    prior = _event_roster(tuple(PaidEvent(**row) for row in physical))
    protected = set(prior)
    closes = {event.close_receipt_sha256 for event in prior.values()}
    _require(len(closes) == len(prior), "one development physical close cannot be counted twice")
    protected.update(closes)
    for body in (*selected, *attempts):
        if type(body) is dict:
            protected.update(value for value in body.values() if _pin(value))
    for terminal in attempts:
        scope = {"meter": terminal.get("closing_meter"), "interval": terminal.get("closing_interval")} if sustained else terminal
        protected.update(_fixed_stage_paid_scope_pins(scope))
    for row in decisions:
        evidence = row.get("look_evidence")
        if sustained:
            _require(type(evidence) in (list, tuple), "sustained cost scope must retain all original paid looks")
        else:
            evidence = () if evidence is None else (evidence,)
        for look in evidence:
            _require(type(look) is dict and type(look.get("training_and_evaluation_closes")) in (list, tuple)
                     and all(_pin(pin) for pin in look["training_and_evaluation_closes"]),
                     "original fixed-stage paid look must retain distinct training and evaluation evidence")
            protected.update(look["training_and_evaluation_closes"])
            protected.update(value for value in look.values() if _pin(value))
            protected.update(_fixed_stage_paid_scope_pins(look))
    return prior, protected


def _verify_sustained_final_freeze_readback(validator, study, comparison, frozen, binding, readback):
    """Recheck the authentic DEVELOPMENT confirmation in an archived FINAL freeze."""
    stage_plan = FinalCheckpointPlan(binding["study_sha256"], comparison["development_design_sha256"],
                                    binding["arm"], binding["seed"], frozen.get("clock"), frozen["final_policy_sha256"])
    _, horizons, caps = _study(validator, study, binding["study_sha256"])
    _require(final_checkpoint_plan_commitment(stage_plan) == frozen.get("plan_sha256")
             and horizons.get(stage_plan.clock) is not None,
             "sustained FINAL resource evidence requires the original freeze plan and measured horizon")
    confirmed = _fixed_stage_final_look(validator, study=study, plan=stage_plan, comparison=comparison,
        binding=binding, look_label=f"step-{readback['stage']}", horizon=horizons[stage_plan.clock], budget_caps=caps)
    _require((_JOINT_STAGE_PIN in frozen) == (_JOINT_STAGE_PIN in readback)
             and frozen.get(_JOINT_STAGE_PIN) == readback.get(_JOINT_STAGE_PIN),
             "sustained FINAL freeze must retain the exact original joint archive marker")
    projections = {**confirmed, "development_design_sha256": comparison["development_design_sha256"],
        "optimizer_step_grid_sha256": comparison["step_grid_sha256"],
        "gate_report_sha256": binding["gate_report_sha256"],
        "optimizer_capture_sha256": binding["optimizer_capture_sha256"],
        "training_close_sha256": readback["training_close_sha256"],
        "activation_guidance_sha256": readback["activation_guidance_sha256"]}
    _require(all(key in frozen and commitment(frozen[key]) == commitment(value) for key, value in projections.items()),
             "sustained FINAL resource freeze differs from the original confirming scope, stage or paid meter")


def _independent_sustained_final_closes(closes, protected):
    _require(all(_pin(pin) for pin in closes) and len(set(closes)) == len(closes)
             and protected.isdisjoint(closes),
             "sustained archive and FINAL reservation require independent closes outside all DEVELOPMENT work")


def verify_fixed_stage_archive_final_resource_evidence(validator, *, study, plan, expected_plan_sha256,
        frozen_checkpoint, development_comparison, readback, retention_selection, candidate_scored,
        parent_scored, candidate_review, retention_reference, evidence, expected_evidence_sha256,
        verify_final_resource_owner):
    """Account for selected FINAL activities against the exact frozen Stage F reports.

    The existing resource owner independently authenticates physical process
    identities, every declared terminal and component close, event coverage,
    allocations, clock endpoints and the selected report roster. The verifier
    consumes their exact receipts. It preserves failed activity costs and the
    observed clocks for each activity.
    """
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and callable(verify_final_resource_owner)
             and _pin(expected_plan_sha256) and _pin(expected_evidence_sha256)
             and final_resource_plan_commitment(plan) == expected_plan_sha256
             and type(frozen_checkpoint) is dict and frozen_checkpoint.get("schema") == FIXED_STAGE_FROZEN_FINAL_SCHEMA
             and commitment(frozen_checkpoint) == plan.candidate_freeze_sha256
             and (frozen_checkpoint.get("study_sha256"), frozen_checkpoint.get("paid_comparison_sha256"),
                  frozen_checkpoint.get("final_policy_sha256"))
                 == (plan.study_sha256, plan.development_comparison_sha256, plan.final_policy_sha256)
             and _pin(frozen_checkpoint.get("final_reservation_sha256")),
             "exact frozen fixed-stage model selection and independent final resource owner required")
    binding = _selected_fixed_stage_paid_postimage(study=study, expected_study_sha256=plan.study_sha256,
        paid_comparison=development_comparison, expected_paid_comparison_sha256=plan.development_comparison_sha256,
        readback=readback, expected_readback_sha256=frozen_checkpoint["postimage_readback_sha256"],
        seed=frozen_checkpoint.get("seed"), arm=frozen_checkpoint.get("arm"))
    _require(type(frozen_checkpoint.get("optimizer_steps")) is int
             and frozen_checkpoint["optimizer_steps"] == readback["stage"]
             and type(frozen_checkpoint.get("reserved_final_count")) is int and frozen_checkpoint["reserved_final_count"] > 0
             and commitment(binding) == frozen_checkpoint.get("paid_postimage_binding_sha256")
             and binding["postimage_sha256"] == frozen_checkpoint.get("candidate_sha256")
             and binding["attempt_sha256"] == frozen_checkpoint.get("attempt_sha256")
             and plan.cost_policy_sha256 == study.cost_policy_sha256
             and study.cost_basis == "first_use"
             and type(retention_selection) is dict and retention_selection == {
                 "frozen_checkpoint_sha256": plan.candidate_freeze_sha256, "final_panel_sha256": plan.final_panel_sha256,
                 "final_policy_sha256": plan.final_policy_sha256, "baseline_checkpoint_sha256": readback["preimage_sha256"]}
             and commitment(("reviewed-final-baseline-selection/v1", retention_selection)) == plan.final_retention_selection_sha256,
             "FINAL resource plan differs from the original paid postimage or unedited parent selection")
    sustained = development_comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA
    if sustained:
        _verify_sustained_final_freeze_readback(validator, study, development_comparison, frozen_checkpoint, binding, readback)
    reference_pin = _fixed_stage_final_resource_reports(plan, frozen_checkpoint, readback,
        candidate_scored, parent_scored, candidate_review, retention_reference)
    _require(type(evidence) is FinalResourceEvidence and evidence.plan_sha256 == expected_plan_sha256
             and type(evidence.closes) is tuple and len(evidence.closes) == len(plan.activities)
             and all(type(row) is tuple and len(row) == 4 for row in evidence.closes)
             and commitment(evidence) == expected_evidence_sha256,
             "exact ordered FINAL activity resource evidence required")
    selection = (study, frozen_checkpoint, development_comparison, readback, retention_selection,
                 candidate_scored, parent_scored, candidate_review, retention_reference)
    selection_pins = tuple(commitment(value) for value in selection)
    if sustained:
        prior, protected = _fixed_stage_prior_paid_identities(development_comparison,
                                                            (development_comparison, readback, binding))
        _independent_sustained_final_closes((frozen_checkpoint.get("archive_owner_close_sha256"),
                                            frozen_checkpoint.get("reservation_owner_close_sha256")), protected)
        for body in selection:
            if type(body) is dict:
                protected.update(value for value in body.values() if _pin(value))
    else:
        prior, protected = _fixed_stage_prior_paid_identities(development_comparison, selection)
    protected.update((*selection_pins, expected_plan_sha256, expected_evidence_sha256))
    if retention_reference is not None:
        protected.add(reference_pin)
    attempted = {activity.evaluation_sha256 for activity in plan.activities}
    events = _event_roster(evidence.events)
    close_to_event = {event.close_receipt_sha256: event for event in events.values()}
    _require(attempted.isdisjoint(protected) and protected.isdisjoint(events) and protected.isdisjoint(close_to_event)
             and attempted.isdisjoint(events) and attempted.isdisjoint(close_to_event)
             and set(events).isdisjoint(close_to_event) and len(close_to_event) == len(events)
             and all(event.kind != ACTIVATION_EVENT_KIND for event in events.values()),
             "FINAL evidence cannot reuse a development, reservation or score identity or double-charge a physical close")

    allocations = {event_id: [] for event_id in events}
    meter_exclusions = protected | attempted | set(events) | set(close_to_event)
    activities, completed, recorded_closes, meter_receipts = [], set(), set(), {}
    checkpoints = {"candidate": binding["postimage_sha256"], "baseline": readback["preimage_sha256"]}
    for activity, (terminal, meter, interval, charges) in zip(plan.activities, evidence.closes, strict=True):
        _check_final_terminal_header(activity, terminal)
        _require((activity.frozen_checkpoint_sha256, activity.checkpoint_sha256)
                     == (plan.candidate_freeze_sha256, checkpoints[activity.role]),
                 "physical FINAL activity differs from the selected checkpoint or original parent")
        report_pin = None
        if terminal.status != "complete":
            _require(terminal.report is None and terminal.baseline_receipt_sha256 is None,
                     "unsuccessful FINAL work cannot issue findings or a parent reference")
        else:
            _require(activity.role not in completed and bool(terminal.component_owner_close_sha256s),
                     "each FINAL role needs one distinct completed report and its component work")
            completed.add(activity.role)
            if activity.role == "candidate":
                _require(candidate_review is not None and type(terminal.report) is dict
                         and commitment(terminal.report) == commitment(candidate_review)
                         and terminal.baseline_receipt_sha256 is None,
                         "completed candidate terminal must bind its exact selected FINAL review")
                report_pin = commitment(candidate_review)
            else:
                _require(parent_scored is not None and terminal.report is None
                         and terminal.baseline_receipt_sha256 == retention_reference["assessment_receipt_sha256"],
                         "completed parent terminal must bind its exact independently derived retention receipt")
        new_closes = (terminal.terminal_close_sha256, *terminal.component_owner_close_sha256s)
        _require(len(set(new_closes)) == len(new_closes) and protected.isdisjoint(new_closes)
                 and attempted.isdisjoint(new_closes) and recorded_closes.isdisjoint(new_closes),
                 "FINAL terminal and component close identities must be independent across attempts and prior work")
        recorded_closes.update(new_closes)
        shares, activity_receipt = _measure_final_activity(validator, plan, expected_plan_sha256, activity, terminal,
            meter, interval, charges, events, report_pin, require_paid_terminal=True)
        _fixed_stage_meter_receipts(meter_receipts, meter_exclusions, meter, interval)
        for close in terminal.component_owner_close_sha256s:
            event = close_to_event.get(close)
            _require(event is not None and shares.get(event.event_sha256) == 1
                     and (terminal.status != "complete" or event.disposition == "complete"),
                     "each declared FINAL component needs its own fully charged physical close")
        for event_id, share in shares.items():
            allocations[event_id].append(share)
        if sustained:
            activity_receipt["interval"] = _wire(interval)
        activities.append(activity_receipt)
    expected_complete = {role for role, body in (("candidate", candidate_review), ("baseline", parent_scored)) if body is not None}
    _require(completed == expected_complete, "every supplied FINAL report needs its own completed physical activity")
    _require_conserved_allocations(allocations, plan.shared_event_consumers)
    shared = tuple(key for key, shares in allocations.items() if len(shares) > 1)
    _require(all(events[key].kind == "startup" and events[key].disposition == "complete" for key in shared),
             "only completed shared startup may be allocated across FINAL activities")
    result = {"schema": FIXED_STAGE_FINAL_RESOURCE_RESULT_SCHEMA, "final_resource_plan_sha256": expected_plan_sha256,
        "final_resource_evidence_sha256": expected_evidence_sha256, "decision_scope": frozen_checkpoint["decision_scope"],
        "development_comparison_sha256": plan.development_comparison_sha256,
        "retention_reference_sha256": reference_pin, "activities": tuple(activities),
        "physical_paid_events": tuple(_wire(event) for event in evidence.events),
        "physical_work_ns": _physical_work_ns(events), "combined_physical_work_ns": _physical_work_ns(prior | events),
        "shared_startup_event_sha256s": shared}
    _require(verify_final_resource_owner(expected_plan_sha256, expected_evidence_sha256, selection_pins) is True
             and final_resource_plan_commitment(plan) == expected_plan_sha256
             and commitment(evidence) == expected_evidence_sha256
             and tuple(commitment(value) for value in selection) == selection_pins,
             "FINAL resource owner refused or the selected fixed-stage evidence changed")
    return result


def _fixed_stage_meter_receipts(used, assessments, meter, interval):
    subject = interval.subject_sha256
    wall_receipts = () if interval.wall is None else (interval.wall.receipt_sha256,)
    receipts = (meter.record_sha256, interval.scope_receipt_sha256, *wall_receipts, *meter.clock_receipts)
    # One scope may carry more than one clock. A different selected
    # attempt/look needs its own authenticated scope and clock identifiers.
    _require(all(receipt not in assessments and used.setdefault(receipt, subject) == subject
                 for receipt in receipts if receipt is not None),
             "one resource receipt cannot attest a different look, terminal, or assessment subject")



FIXED_STAGE_FINAL_PAIR_SCHEMA = "reviewed-fixed-stage-paired-final-panel/v1"


@dataclass(frozen=True)
class FixedStageFinalPairPlan:
    study_sha256: str
    contrast_plan_sha256: str
    development_comparison_sha256: str
    final_reservation_sha256: str
    final_panel_sha256: str
    final_policy_sha256: str
    review_policy_sha256: str
    source_crosswalk_sha256: str
    evidence_scope: str
    clock: str
    panel: tuple[tuple[str, str, str], ...]
    fidelity_eligible: tuple[str, ...]
    formal_required: tuple[str, ...]
    cutoffs: tuple[tuple[str, Fraction], ...]
    sampling: PairedFinalSampling | None = None


@dataclass(frozen=True)
class FixedStageFinalPairCell:
    seed: str
    arm: str
    frozen_checkpoint: dict | None = None
    final_resources: dict | None = None
    final_review: dict | None = None
    retention_reference: dict | None = None


def fixed_stage_final_pair_plan_commitment(validator, plan):
    _require(type(plan) is FixedStageFinalPairPlan
             and all(_pin(value) for value in (
                 plan.study_sha256, plan.contrast_plan_sha256, plan.development_comparison_sha256,
                 plan.final_reservation_sha256, plan.final_panel_sha256, plan.final_policy_sha256,
                 plan.review_policy_sha256, plan.source_crosswalk_sha256))
             and _name(plan.evidence_scope) and type(plan.clock) is str and plan.clock in COVERED_CLOCKS
             and _final_panel_cutoffs(validator, plan.panel, plan.cutoffs)
             and bool(plan.fidelity_eligible)
             and all(type(rows) is tuple and all(_name(row) for row in rows)
                     and tuple(row for row, _, _ in plan.panel if row in rows) == rows
                     for rows in (plan.fidelity_eligible, plan.formal_required))
             and (plan.sampling is None or (plan.evidence_scope == "native_reviewed"
                  and type(plan.sampling) is PairedFinalSampling
                  and _pin(plan.sampling.independently_sampled_seed_and_group_frame_sha256)
                  and type(plan.sampling.alpha) is Fraction and 0 < plan.sampling.alpha < 1)),
             "preselected original contrasts, FINAL policy, crosswalk and exact review populations required")
    return commitment((FIXED_STAGE_FINAL_PAIR_SCHEMA, "plan", plan))


def fixed_stage_final_pair_evidence_commitment(plan_sha256, cells):
    _require(_pin(plan_sha256) and type(cells) is tuple
             and all(type(cell) is FixedStageFinalPairCell and _name(cell.seed) and _name(cell.arm)
                 and all(value is None or type(value) is dict for value in (
                     cell.frozen_checkpoint, cell.final_resources, cell.final_review, cell.retention_reference))
                 for cell in cells), "ordered original fixed-stage FINAL slots and exact issued bodies required")
    return commitment((FIXED_STAGE_FINAL_PAIR_SCHEMA, "evidence", plan_sha256, cells))


@dataclass(frozen=True)
class FixedStageFinalPairReadback:
    seed: str
    arm: str
    readback_sha256: str
    readback: dict


def fixed_stage_final_pair_readbacks_commitment(plan_sha256, evidence_sha256, scheduled_readbacks):
    """Select the exact scheduled readbacks accompanying the frozen FINAL cells."""
    _require(_pin(plan_sha256) and _pin(evidence_sha256) and type(scheduled_readbacks) is tuple
             and all(type(row) is FixedStageFinalPairReadback and _name(row.seed) and _name(row.arm)
                     and _pin(row.readback_sha256) and type(row.readback) is dict
                     and commitment(row.readback) == row.readback_sha256 for row in scheduled_readbacks)
             and len({(row.seed, row.arm) for row in scheduled_readbacks}) == len(scheduled_readbacks)
             and len({row.readback_sha256 for row in scheduled_readbacks}) == len(scheduled_readbacks),
             "ordered unique paired FINAL scheduled readbacks must retain their exact archived bytes")
    return commitment((FIXED_STAGE_FINAL_PAIR_SCHEMA, "scheduled-readbacks", plan_sha256,
                       evidence_sha256, scheduled_readbacks))


def _fixed_stage_sustained_pair_outcome(row):
    """Adapt the paid decision wire to the existing horizon resolver."""
    from types import SimpleNamespace

    status, raw = row.get("status"), row.get("decision")
    _require(_name(status) and "decision" in row and "confirmation_budget_block" in row,
             "sustained paired slot requires its original disposition and decision")
    if raw is None or status in ("assessment_unavailable", "measurement_unavailable"):
        return None, status
    _require(type(raw) is dict and raw.get("status") == status
             and status in ("reached", "right_censored", "closed_without_reach"),
             "sustained paired slot decision and observed disposition differ")
    costs = {}
    for key in ("confirming_costs", "closing_costs"):
        observed = raw.get(key)
        if key == "confirming_costs" and status != "reached":
            _require(observed is None, "unconfirmed paid decision cannot carry a confirming meter")
            costs[key] = None
            continue
        _require(type(observed) is dict and set(observed) == set(COVERED_CLOCKS)
                 and all(value is None or (type(value) is float and isfinite(value) and value >= 0)
                         for value in observed.values()),
                 "sustained paired slot requires the actual observed decision clocks")
        costs[key] = SimpleNamespace(**observed)
    block = row["confirmation_budget_block"]
    _require(block is None or (status == "reached" and type(block) in (tuple, list) and len(block) == 3
             and type(block[0]) is str and block[0] in COVERED_CLOCKS
             and type(block[1]) is float and isfinite(block[1]) and block[1] > 0 and _name(block[2])),
             "sustained paired slot requires the original confirmation budget disposition")
    return SimpleNamespace(status=status, **costs), block


def _verify_fixed_stage_sustained_pair_outcomes(pairs, slots):
    outcomes = {slot: _fixed_stage_sustained_pair_outcome(decision) for slot, (_, decision) in slots.items()}
    for row in pairs:
        observed = []
        for role in ("baseline", "candidate"):
            decision, block = outcomes[row["seed"], row[role]]
            selected = _fixed_stage_horizon(decision, block, row["clock"], row["horizon"])
            fields = (role + "_attained", role + "_reason", "observed_" + role + "_confirmation")
            _require(all(field in row for field in fields)
                     and commitment(tuple(row[field] for field in fields)) == commitment(selected),
                     "sustained paired clock eligibility differs from the original paid decision")
            observed.append(selected[2])
        baseline, candidate = observed
        delta = None if baseline is None or candidate is None else candidate - baseline
        key = "candidate_minus_baseline_seconds_if_both_observed"
        _require(key in row and commitment(row[key]) == commitment(delta),
                 "sustained paired elapsed comparison differs from the original paid decision clocks")


def _fixed_stage_final_pair_slots(study, plan, contrasts, comparison, horizons):
    seeds = tuple(seed.identifier for seed in study.seeds)
    sustained = comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA
    if sustained:
        schedule = comparison.get("schedule")
        schedule_matches = (type(schedule) in (tuple, list) and tuple(schedule) == study.schedule
            and type(study.required_streak) is int and 2 <= study.required_streak <= len(study.schedule)
            and comparison.get("required_streak") == study.required_streak
            and _pin(comparison.get("development_design_sha256")) and _pin(comparison.get("step_grid_sha256")))
    else:
        stage = comparison.get("stage")
        schedule_matches = (type(stage) is int and 1 <= stage <= 16 and study.schedule == (f"step-{stage}",)
                            and study.required_streak == 1)
    _require(len(seeds) >= 2 and tuple(name for name, _ in study.arms) == FIXED_STAGE_ARMS
             and {("adam", "programmed"), ("random", "programmed")} <= {
                 (row["baseline"], row["candidate"]) for row in contrasts if row["role"] == "primary"}
             and study.cost_basis == comparison.get("cost_basis") == "first_use" and study.reuse_count is None
             and schedule_matches and study.stop_after_confirmation is False and horizons[plan.clock] is not None,
             "fixed-stage FINAL requires the original two primary controls, seeds, schedule and measured horizon")
    full = tuple((seed, arm) for seed in seeds for arm, _ in study.arms)
    for key in (("attempt_decisions",) if sustained else ("arms", "attempt_decisions")):
        values = comparison.get(key)
        _require(type(values) in (tuple, list) and all(type(row) is dict for row in values)
                 and tuple((row.get("seed"), row.get("arm")) for row in values) == full,
                 "paid comparison must retain every original seed and arm in order")
    decisions = comparison["attempt_decisions"]
    terminals = decisions if sustained else comparison["arms"]
    slots = dict(zip(full, zip(terminals, decisions, strict=True), strict=True))
    attempts = {slot: terminal.get("attempt_sha256") for slot, (terminal, _) in slots.items()}
    _require(all(_pin(pin) for pin in attempts.values()) and len(set(attempts.values())) == len(full)
             and all(decision.get("attempt_sha256") == attempts[slot] for slot, (_, decision) in slots.items()),
             "each original seed and arm must keep its distinct paid attempt and decision")
    pairs = comparison.get("pairs")
    fields = ("contrast_id", "role", "baseline", "candidate", "clock", "horizon", "seed")
    if not sustained:
        fields += ("baseline_attempt_sha256", "candidate_attempt_sha256")
    expected = tuple((row["identifier"], row["role"], row["baseline"], row["candidate"], clock, horizon, seed)
                     + (() if sustained else (attempts[seed, row["baseline"]], attempts[seed, row["candidate"]]))
                     for row in contrasts for clock, horizon in horizons.items() if horizon is not None for seed in seeds)
    _require(type(pairs) in (tuple, list) and all(type(row) is dict for row in pairs)
             and commitment(tuple(tuple(row.get(field) for field in fields) for row in pairs)) == commitment(expected),
             "paid DEVELOPMENT pairs must preserve their original directed contrasts, clocks and attempts")
    if sustained:
        _verify_fixed_stage_sustained_pair_outcomes(pairs, slots)
    selected_clock = {}
    for row in pairs:
        if row["clock"] != plan.clock:
            continue
        for role in ("baseline", "candidate"):
            value, reason = row.get(role + "_attained"), row.get(role + "_reason")
            slot = (row["seed"], row[role])
            status = slots[slot][1].get("status")
            _require((value is None or (type(value) is int and value in (0, 1))) and _name(reason)
                     and (value != 1 or (reason == "confirmed_within_horizon" and status == "reached"))
                     and selected_clock.setdefault(slot, (value, reason)) == (value, reason),
                     "every contrast must retain its original selected-clock attainment and reason for each arm")
    return {slot: value for slot, value in slots.items() if slot in selected_clock}, selected_clock


def _fixed_stage_final_pair_freeze(validator, plan, study, comparison, cell, terminal, horizon, caps, *, scheduled_readback=None):
    frozen = cell.frozen_checkpoint
    if scheduled_readback is None:
        stage = comparison["stage"]
        binding = None
    else:
        binding = _selected_fixed_stage_paid_postimage(study=study, expected_study_sha256=plan.study_sha256,
            paid_comparison=comparison, expected_paid_comparison_sha256=plan.development_comparison_sha256,
            readback=scheduled_readback.readback, expected_readback_sha256=scheduled_readback.readback_sha256,
            seed=cell.seed, arm=cell.arm)
        stage = scheduled_readback.readback["stage"]
    common_pins = ("development_design_sha256", "optimizer_step_grid_sha256", "original_global_split_sha256",
                   "population_sha256", "opaque_final_sha256", "reservation_owner_close_sha256",
                   "final_access_policy_sha256")
    _require(type(frozen) is dict and frozen.get("schema") == FIXED_STAGE_FROZEN_FINAL_SCHEMA
             and all(_pin(frozen.get(key)) for key in (*common_pins, "candidate_sha256", "archive_owner_close_sha256",
                 "optimizer_capture_sha256", "train_cohort_sha256", "postimage_readback_sha256"))
             and (frozen.get("seed"), frozen.get("arm"), frozen.get("recipe_sha256"), frozen.get("decision_scope"))
                 == (cell.seed, cell.arm, dict(study.arms)[cell.arm], plan.evidence_scope)
             and (frozen.get("study_sha256"), frozen.get("paid_comparison_sha256"),
                  frozen.get("final_reservation_sha256"), frozen.get("final_policy_sha256"))
                 == (plan.study_sha256, plan.development_comparison_sha256, plan.final_reservation_sha256,
                     plan.final_policy_sha256)
             and type(frozen.get("optimizer_steps")) is int and frozen["optimizer_steps"] == stage
             and type(frozen.get("reserved_final_count")) is int and frozen["reserved_final_count"] == len(plan.panel)
             and _pin(terminal.get("attempt_sha256")) and terminal["attempt_sha256"] == frozen.get("attempt_sha256"),
             "FINAL freeze differs from the exact original seed, paid postimage, stage or reserved scope")
    stage_plan = FinalCheckpointPlan(plan.study_sha256, frozen["development_design_sha256"],
                                     cell.arm, cell.seed, plan.clock, plan.final_policy_sha256)
    _require(frozen.get("plan_sha256") == final_checkpoint_plan_commitment(stage_plan),
             "FINAL freeze must retain the registered stage plan and original clock")
    if binding is None:
        availability = terminal.get("availability")
        _require(all(_pin(terminal.get(key)) and terminal[key] == frozen.get(key)
                     for key in ("gate_report_sha256", "training_close_sha256"))
                 and type(availability) is dict and availability.get("assessment_status") == "assessed"
                 and availability.get("status") == "reached"
                 and availability.get("selected_postimage_sha256") == frozen["candidate_sha256"],
                 "FINAL freeze differs from the original paid stage or availability")
        guidance_pin = next(pin for seed, pin, _ in comparison["activation_guidance_roster"] if seed == cell.seed)
        _require(guidance_pin == frozen.get("activation_guidance_sha256"),
                 "FINAL freeze must retain the exact selected per-seed activation guidance")
    else:
        _require((frozen.get("clock"), frozen["postimage_readback_sha256"], frozen["candidate_sha256"])
                 == (plan.clock, scheduled_readback.readback_sha256, binding["postimage_sha256"]),
                 "sustained paired FINAL needs the registered clock and exact confirming readback")
        _verify_sustained_final_freeze_readback(validator, study, comparison, frozen, binding, scheduled_readback.readback)
    reservation = FixedStageFinalReservation(frozen["development_design_sha256"], frozen["original_global_split_sha256"],
        frozen["population_sha256"], plan.final_policy_sha256, frozen["reserved_final_count"],
        frozen["opaque_final_sha256"], frozen["final_access_policy_sha256"], frozen["reservation_owner_close_sha256"])
    _require(fixed_stage_final_reservation_commitment(reservation) == plan.final_reservation_sha256,
             "freeze must retain the original opaque FINAL reservation commitment")
    if scheduled_readback is not None:
        reserved_from = scheduled_readback.readback
        _require(reservation.opaque_final_sha256 not in (reservation.global_split_sha256,
                 reserved_from["edit_split_sha256"], reserved_from["confirmation_split_sha256"], reserved_from["panel_sha256"]),
                 "sustained paired freeze must retain a separate untouched opaque FINAL reserve")
    if binding is None:
        binding = {"schema": "reviewed-compact-fixed-stage-paid-postimage-binding/v1", "study_sha256": plan.study_sha256,
            "seed": cell.seed, "arm": cell.arm, "attempt_sha256": frozen["attempt_sha256"],
            "gate_report_sha256": frozen["gate_report_sha256"], "paid_comparison_sha256": plan.development_comparison_sha256,
            "postimage_readback_sha256": frozen["postimage_readback_sha256"], "postimage_sha256": frozen["candidate_sha256"],
            "optimizer_capture_sha256": frozen["optimizer_capture_sha256"]}
        original = _fixed_stage_final_look(validator, study=study, plan=stage_plan, comparison=comparison,
            binding=binding, look_label=study.schedule[0], horizon=horizon, budget_caps=caps)
        _require(all(commitment(frozen.get(key)) == commitment(value) for key, value in original.items()),
                 "FINAL freeze must retain the exact original confirmed look and paid closes")
    binding_pin = commitment(binding)
    archive = FixedStageFinalArchive(binding_pin, frozen["training_close_sha256"], frozen.get("archive_manifest_sha256"),
                                     frozen["archive_owner_close_sha256"])
    _require(binding_pin == frozen.get("paid_postimage_binding_sha256")
             and fixed_stage_final_archive_commitment(archive) == frozen.get("archive_sha256"),
             "freeze must retain the original paid postimage binding and archive commitment")
    return tuple(frozen[key] for key in common_pins)


def _fixed_stage_final_pair_work(plan, study, frozen, resources, prior, seen):
    _require(resources.get("schema") == FIXED_STAGE_FINAL_RESOURCE_RESULT_SCHEMA
             and resources.get("decision_scope") == plan.evidence_scope
             and resources.get("development_comparison_sha256") == plan.development_comparison_sha256
             and all(_pin(resources.get(key)) for key in ("final_resource_plan_sha256", "final_resource_evidence_sha256")),
             "exact issued fixed-stage FINAL paid resource result required")
    events = _compact_paid_event_roster(resources)
    _require(commitment(resources.get("combined_physical_work_ns")) == commitment(_physical_work_ns(prior | events)),
             "each paid FINAL result must reconcile with its original measured DEVELOPMENT work")
    activities = resources.get("activities")
    _require(type(activities) in (tuple, list) and activities and all(type(row) is dict for row in activities),
             "each paid FINAL slot must retain its original activity roster")
    claimed = {resources["final_resource_plan_sha256"], resources["final_resource_evidence_sha256"]}
    _require(len(claimed) == 2, "FINAL plan and evidence identities must be distinct")
    event_closes = {event.close_receipt_sha256: event for event in events.values()}
    allocations = {key: [] for key in events}
    completed, parent, allocated_close_claims = {}, None, set()
    freeze_pin = commitment(frozen)
    for row in activities:
        activity, shares, close_claims, _ = _compact_final_paid_activity(row, events)
        role, checkpoint = activity["role"], activity["checkpoint_sha256"]
        _require(activity["frozen_checkpoint_sha256"] == freeze_pin
                 and row["meter"]["cost_policy_sha256"] == study.cost_policy_sha256,
                 "FINAL activity or meter comes from a different freeze or cost policy")
        if role == "candidate":
            _require(checkpoint == frozen["candidate_sha256"], "FINAL work must evaluate the original paid postimage")
        else:
            _require(parent is None or parent == checkpoint, "same original parent is required through every retry")
            parent = checkpoint
        if row["status"] == "complete":
            _require(role not in completed and bool(row["component_owner_close_sha256s"]),
                     "each FINAL role may issue one completed result with independent components")
            completed[role] = row
        else:
            _require(row.get("report_sha256") is None and row.get("baseline_receipt_sha256") is None,
                     "unsuccessful FINAL work cannot issue report findings or a retention reference")
        local = {activity["evaluation_sha256"], *(pin for pin, _ in close_claims)}
        meter_pins = _fixed_stage_paid_scope_pins(row)
        wall = row.get("wall")
        if wall is not None:
            _require(type(wall) is dict and _pin(wall.get("receipt_sha256")), "exact observed wall receipt required")
            meter_pins.add(wall["receipt_sha256"])
        _require(len(local) == len(close_claims) + 1 and local.isdisjoint(meter_pins)
                 and claimed.isdisjoint(local | meter_pins),
                 "FINAL attempts and measured scopes must have independent identities")
        for close in row["component_owner_close_sha256s"]:
            event = event_closes.get(close)
            _require(event is not None and shares.get(event.event_sha256) == 1
                     and (row["status"] != "complete" or event.disposition == "complete"),
                     "every FINAL component requires its own fully allocated event")
        claimed.update(local | meter_pins)
        allocated_close_claims.update(pin for pin, claim in close_claims if claim in ("terminal", "component"))
        for key, share in shares.items():
            allocations[key].append(share)
    shared = tuple(key for key, shares in allocations.items() if len(shares) > 1)
    _require(type(resources.get("shared_startup_event_sha256s")) in (list, tuple)
             and tuple(resources["shared_startup_event_sha256s"]) == shared
             and all(events[key].kind == "startup" and events[key].disposition == "complete" for key in shared)
             and len({len(allocations[key]) for key in shared}) <= 1,
             "only originally selected completed startup may be shared within one FINAL result")
    _require_conserved_allocations(allocations, len(allocations[shared[0]]) if shared else None)
    _require(set(events).isdisjoint(claimed | set(event_closes))
             and claimed.intersection(event_closes) == allocated_close_claims,
             "FINAL event identity or physical close aliases an unrelated evidence role")
    claimed.update(set(events) | set(event_closes))
    _require(seen.isdisjoint(claimed), "FINAL work cannot reuse another scope's event, close or meter")
    seen.update(claimed)
    return events, completed, parent


def _fixed_stage_final_pair_findings(validator, plan, cell, completed, parent, common_panel):
    review, reference = cell.final_review, cell.retention_reference
    frozen, resources = cell.frozen_checkpoint, cell.final_resources
    candidate, baseline = completed.get("candidate"), completed.get("baseline")
    _require((review is None) == (candidate is None) and (reference is None) == (baseline is None)
             and resources.get("retention_reference_sha256") == (None if reference is None else commitment(reference)),
             "FINAL findings and retention require their exact completed activity and vice versa")
    retained, reference_known, parent_evidence = (), False, None
    if reference is not None:
        fidelity = reference.get("row_fidelity")
        original = reference.get("original_parent_evidence")
        _require(reference.get("schema") == "compact-boundary-scheduled-original-parent-retention/v2"
                 and type(original) is dict and set(original) == {"review_plan_sha256", "evaluation_plan_sha256",
                     "parent_plan_sha256", "numerical_report_sha256", "observation_manifest_sha256",
                     "translation_handoffs_sha256"} and all(_pin(pin) for pin in original.values())
                 and (review is None or (original["review_plan_sha256"], original["evaluation_plan_sha256"])
                     == (review.get("plan_sha256"), review.get("final_scoring_sha256")))
                 and _pin(reference.get("parent_sha256")) and reference.get("postimage_sha256") == parent
                 and (reference.get("panel_sha256"), reference.get("policy_sha256"))
                     == (plan.final_panel_sha256, plan.review_policy_sha256)
                 and _pin(reference.get("assessment_receipt_sha256"))
                 and baseline.get("baseline_receipt_sha256") == reference["assessment_receipt_sha256"]
                 and baseline.get("report_sha256") is None and type(fidelity) in (tuple, list)
                 and all(type(row) in (tuple, list) and len(row) == 2
                         and (row[1] is None or type(row[1]) is bool) for row in fidelity)
                 and tuple(key for key, _ in fidelity) == plan.fidelity_eligible,
                 "exact paid original-parent reference, common eligible rows and review policy required")
        retained = tuple(key for key, value in fidelity if value is True)
        reference_known = all(value is not None for _, value in fidelity)
        parent_evidence = (reference["parent_sha256"], tuple(value for _, value in fidelity))
    if review is None:
        return (None,) * len(plan.fidelity_eligible), parent_evidence
    rows = review.get("rows")
    _require(candidate.get("report_sha256") == commitment(review) and candidate.get("baseline_receipt_sha256") is None
             and review.get("schema") == "compact-boundary-fixed-stage-final-independent-gates/v1"
             and review.get("status") in ("all_gates_passed", "did_not_clear", "evidence_incomplete")
             and all(_pin(review.get(key)) for key in ("plan_sha256", "numerical_report_sha256", "final_admission_sha256",
                                                      "observation_manifest_sha256", "translation_handoffs_sha256"))
             and (review.get("frozen_checkpoint_sha256"), review.get("final_panel_sha256"),
                  review.get("final_reservation_sha256"), review.get("final_policy_sha256"),
                  review.get("review_policy_sha256"), review.get("arm"), review.get("postimage_sha256"),
                  review.get("decision_scope"))
                 == (commitment(frozen), plan.final_panel_sha256, plan.final_reservation_sha256,
                     plan.final_policy_sha256, plan.review_policy_sha256, cell.arm, frozen["candidate_sha256"],
                     plan.evidence_scope)
             and type(review.get("optimizer_steps")) is int and review["optimizer_steps"] == frozen["optimizer_steps"]
             and review.get("retention_reference_sha256") == resources.get("retention_reference_sha256")
             and type(rows) is dict and set(rows) == set(common_panel) and all(type(row) is dict for row in rows.values())
             and type(review.get("gate_counts")) is dict and set(review["gate_counts"]) == set(validator.GATES)
             and review.get("final_scoring_sha256") == commitment({
                 "schema": "compact-boundary-fixed-stage-final-scoring-plan/v1",
                 "frozen_checkpoint_sha256": commitment(frozen), "final_panel_sha256": plan.final_panel_sha256,
                 "final_admission_sha256": review["final_admission_sha256"]}),
             "complete FINAL candidate result must match its exact paid independent review and reserved scoped rows")
    rosters, complete = _fixed_stage_count_rosters(validator, review, common_panel)
    _require(rosters["source_fidelity"] == plan.fidelity_eligible and rosters["formal_validity"] == plan.formal_required
             and rosters["retention"] == retained and complete is reference_known,
             "independent FINAL eligibility, proof and retention populations must agree with the selected panel")
    normalized = {**review, "rows": {key: rows[key] for key in common_panel}}
    denominator_view = Seed(cell.seed, resources.get("retention_reference_sha256"),
                            tuple(len(rosters[gate]) for gate in validator.GATES))
    _fixed_stage_counts(validator, normalized, denominator_view, dict(plan.cutoffs), rosters, complete)
    return tuple(rows[key]["source_success"] for key in plan.fidelity_eligible), parent_evidence


def _sustained_discovery_scope(comparison, clock):
    cost = comparison.get("activation_discovery_cost_scope")
    wall = comparison.get("activation_discovery_wall_scope")
    if cost is wall is None:
        # The sustained v1 owner can issue a paid readback pin only after
        # checking the archived activation guidance at that exact look.
        decisions = comparison.get("attempt_decisions")
        paid_guided = (comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA
                       and type(decisions) in (tuple, list)
                       and any(type(row) is dict and type(row.get("look_evidence")) in (tuple, list)
                               and any(type(look) is dict and _pin(look.get("readback_sha256"))
                                       for look in row["look_evidence"]) for row in decisions))
        if not paid_guided:
            return {}
        cost, wall = "incomplete_discovery_cost", "discovery_inclusive_wall_not_established"
    bound = cost == "original_paid_discovery_through_first_programmed_look"
    _require((bound or cost == "incomplete_discovery_cost")
             and wall == "discovery_inclusive_wall_not_established"
             and (not bound or (_pin(comparison.get("activation_discovery_cost_binding_sha256"))
                                and _pin(comparison.get("activation_diagnostic_charges_sha256")))),
             "sustained discovery scope must retain its original paid binding and wall qualification")
    horizon = ("original_observed_horizon_discovery_cost_bound" if bound and clock != "wall_seconds"
               else "original_observed_horizon_discovery_coverage_unestablished")
    return {"activation_discovery_cost_scope": cost, "activation_discovery_wall_scope": wall,
            "development_horizon_scope": horizon}


def assemble_fixed_stage_paired_final_panel(validator, *, plan, expected_plan_sha256, study, contrast_plan,
        development_comparison, cells, expected_evidence_sha256, verify_paired_final_owner,
        scheduled_readbacks=None, expected_scheduled_readbacks_sha256=None):
    """Join existing Stage F closes without reopening FINAL or running a model.

    The paired owner authenticates prospective registration, exact issued
    closes and absent slots, source/version/dependency crosswalk and disjoint
    splits, original parent/reference evidence, and physical independence
    across plans. A selected sampling frame also needs independent prospective
    seed/group draws and an owner-approved family error allocation. For a
    sustained comparison, the owner also authenticates the selected readback
    roster for every frozen cell in its original order.
    """
    sustained = (type(development_comparison) is dict
                 and development_comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA)

    def current():
        _require(fixed_stage_final_pair_plan_commitment(validator, plan) == expected_plan_sha256
                 and commitment(study) == plan.study_sha256 and commitment(contrast_plan) == plan.contrast_plan_sha256
                 and type(development_comparison) is dict
                 and development_comparison.get("schema") in (FIXED_STAGE_COMPARISON_SCHEMA, FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA)
                 and commitment(development_comparison) == plan.development_comparison_sha256
                 and (development_comparison.get("study_sha256"), development_comparison.get("contrast_plan_sha256"))
                     == (plan.study_sha256, plan.contrast_plan_sha256)
                 and fixed_stage_final_pair_evidence_commitment(expected_plan_sha256, cells) == expected_evidence_sha256,
                 "independently pinned paired FINAL plan, original paid comparison and closed evidence required")
        if sustained:
            _require(_pin(expected_scheduled_readbacks_sha256)
                     and fixed_stage_final_pair_readbacks_commitment(expected_plan_sha256, expected_evidence_sha256,
                         scheduled_readbacks) == expected_scheduled_readbacks_sha256
                     and tuple((row.seed, row.arm) for row in scheduled_readbacks)
                         == tuple((cell.seed, cell.arm) for cell in cells if cell.frozen_checkpoint is not None),
                     "exact ordered confirming readback roster required for the original frozen cells")
        else:
            _require(scheduled_readbacks is expected_scheduled_readbacks_sha256 is None,
                     "single-stage FINAL uses its original closed evidence ABI")

    _require(callable(verify_paired_final_owner), "independent paired fixed-stage FINAL owner required")
    current()
    discovery_scope = _sustained_discovery_scope(development_comparison, plan.clock) if sustained else {}
    _, horizons, caps = _study(validator, study, plan.study_sha256)
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS, "fixed-stage FINAL needs the original physical clock order")
    contrasts = _selected_contrasts(study, plan.study_sha256, contrast_plan, plan.contrast_plan_sha256)
    if not sustained:
        _require(commitment(contrasts) == commitment(development_comparison.get("contrasts")),
                 "FINAL uses the same preregistered development contrasts")
    panel = tuple(row for row, _, _ in plan.panel)
    _require({group for _, group, _ in plan.panel}.isdisjoint(group for _, group, _ in study.panel),
             "FINAL must retain a distinct held-out dependency cohort")
    slots, selected_clock = _fixed_stage_final_pair_slots(study, plan, contrasts, development_comparison, horizons)
    _require(tuple((cell.seed, cell.arm) for cell in cells) == tuple(slots),
             "both original arms of every contrast and every seed require explicit FINAL slots in study order")
    prior = _compact_paid_event_roster(development_comparison)
    _, seen = _fixed_stage_prior_paid_identities(development_comparison, (plan, development_comparison))
    seeds = tuple(seed.identifier for seed in study.seeds)
    if not sustained:
        guidance = development_comparison.get("activation_guidance_roster")
        _require(type(guidance) in (tuple, list)
                 and all(type(row) in (tuple, list) and len(row) == 3 and _pin(row[1])
                         and type(row[2]) is dict and commitment(row[2]) == row[1] for row in guidance)
                 and tuple(row[0] for row in guidance) == seeds
                 and fixed_stage_activation_guidance_roster_commitment(tuple((seed, pin) for seed, pin, _ in guidance),
                      study_sha256=plan.study_sha256) == development_comparison.get("activation_guidance_roster_sha256"),
                 "paired FINAL must retain the exact original per-seed guidance roster")
    readbacks = {(row.seed, row.arm): row for row in scheduled_readbacks} if sustained else {}
    if sustained:
        seen.update(value for row in scheduled_readbacks for value in row.readback.values() if _pin(value))
        seen.add(expected_scheduled_readbacks_sha256)
    prior_protected = frozenset(seen)
    seen.update(getattr(plan, key) for key in ("study_sha256", "contrast_plan_sha256", "development_comparison_sha256",
        "final_reservation_sha256", "final_panel_sha256", "final_policy_sha256", "review_policy_sha256", "source_crosswalk_sha256"))
    observations, reports, final_events, shared_scope, seed_parents = {}, [], {}, None, {}
    seed_cohorts = {}
    for cell, (terminal, _) in zip(cells, slots.values(), strict=True):
        frozen = cell.frozen_checkpoint
        if frozen is None:
            continue
        _require(selected_clock[cell.seed, cell.arm] == (1, "confirmed_within_horizon"),
                 "a frozen FINAL slot needs proven DEVELOPMENT eligibility at its selected clock")
        scope = _fixed_stage_final_pair_freeze(validator, plan, study, development_comparison,
            cell, terminal, horizons[plan.clock], caps, scheduled_readback=readbacks.get((cell.seed, cell.arm)))
        if sustained:
            _independent_sustained_final_closes((frozen["archive_owner_close_sha256"],
                                                 frozen["reservation_owner_close_sha256"]), prior_protected)
        _require(shared_scope is None or shared_scope == scope,
                 "every FINAL arm must use the original common split, grid and opaque reservation")
        shared_scope = scope
        seen.update(scope)
        freeze_pin, archive_close = commitment(frozen), frozen["archive_owner_close_sha256"]
        _require(freeze_pin != archive_close and seen.isdisjoint((freeze_pin, archive_close))
                 and seed_cohorts.setdefault(cell.seed, frozen["train_cohort_sha256"]) == frozen["train_cohort_sha256"],
                 "each freeze needs independent archive custody and a common original training cohort within seed")
        seen.update((freeze_pin, archive_close))
    for cell, (terminal, decision) in zip(cells, slots.values(), strict=True):
        findings = (None,) * len(plan.fidelity_eligible)
        attained, eligibility_reason = selected_clock[cell.seed, cell.arm]
        status = {None: "final_eligibility_unestablished", 0: "final_ineligible", 1: "final_not_observed"}[attained]
        resources = cell.final_resources
        parent_evidence = None
        if resources is None:
            _require(cell.final_review is None and cell.retention_reference is None,
                     "unobserved FINAL slots cannot supply findings or retention")
        else:
            _require(cell.frozen_checkpoint is not None, "paid FINAL results require their original eligible freeze")
            events, completed, parent = _fixed_stage_final_pair_work(plan, study, cell.frozen_checkpoint, resources, prior, seen)
            findings, parent_evidence = _fixed_stage_final_pair_findings(validator, plan, cell, completed, parent, panel)
            if sustained:
                readback = readbacks[cell.seed, cell.arm].readback
                _require((parent is None or parent == readback["preimage_sha256"])
                         and (parent_evidence is None or parent_evidence[0] == readback["parent_sha256"]),
                         "paused or completed FINAL work must retain the exact original unedited parent")
            old_parent, old_evidence = seed_parents.get(cell.seed, (None, None))
            _require(old_parent is None or parent is None or old_parent == parent,
                     "matched arms must agree on their original unedited parent checkpoint")
            if old_evidence is not None and parent_evidence is not None:
                original, earlier = old_evidence
                assessed, later = parent_evidence
                _require(original == assessed and all(a is None or b is None or a is b
                         for a, b in zip(earlier, later, strict=True)),
                         "matched parent reviews must agree wherever both independently observed fidelity")
                old_evidence = (original, tuple(a if a is not None else b for a, b in zip(earlier, later, strict=True)))
            seed_parents[cell.seed] = (parent or old_parent, old_evidence or parent_evidence)
            final_events.update(events)
            status = "final_work_without_candidate_findings" if cell.final_review is None else cell.final_review["status"]
        observations[cell.seed, cell.arm] = findings
        reports.append({"seed": cell.seed, "arm": cell.arm, "attempt_sha256": terminal["attempt_sha256"],
            "development_status": decision["status"], "status": status,
            "development_attained_at_selected_clock": attained, "development_attainment_reason": eligibility_reason,
            "frozen_checkpoint_sha256": None if cell.frozen_checkpoint is None else commitment(cell.frozen_checkpoint),
            "final_resources_sha256": None if resources is None else commitment(resources),
            "final_review_sha256": None if cell.final_review is None else commitment(cell.final_review),
            "retention_reference_sha256": None if cell.retention_reference is None else commitment(cell.retention_reference),
            "retention_reference_fully_observed": parent_evidence is not None and all(value is not None for value in parent_evidence[1]),
            "gate_counts": None if cell.final_review is None else _wire(cell.final_review["gate_counts"]),
            "gates": None if cell.final_review is None else _wire(cell.final_review["gates"]),
            "activities": None if resources is None else _wire(resources["activities"])})
    analysis = plan
    if plan.sampling is not None:
        analysis = replace(plan, sampling=replace(plan.sampling, alpha=plan.sampling.alpha / len(contrasts)))
    results = tuple({**contrast, "fidelity": _paired_group_bounds(analysis, seeds, tuple(
                     observations[seed, contrast[role]] for seed in seeds for role in ("baseline", "candidate"))),
                     "original_development_pairs": tuple(_wire(row) for row in development_comparison["pairs"]
                         if row["contrast_id"] == contrast["identifier"])} for contrast in contrasts)
    readback_pins = (expected_scheduled_readbacks_sha256,) if sustained else ()
    _require(verify_paired_final_owner(expected_plan_sha256, expected_evidence_sha256, *readback_pins) is True,
             "independent owner refused the exact paired fixed-stage FINAL evidence")
    current()
    scheduled = {"scheduled_readbacks_sha256": expected_scheduled_readbacks_sha256,
                 "development_schedule": study.schedule} if sustained else {}
    physical_scope = ("original_observed_development_and_selected_final_events_discovery_cost_incomplete"
                      if discovery_scope.get("activation_discovery_cost_scope") == "incomplete_discovery_cost"
                      else "whole_original_development_and_observed_selected_final_slots")
    return {"schema": FIXED_STAGE_FINAL_PAIR_SCHEMA, "plan_sha256": expected_plan_sha256,
            **scheduled, **discovery_scope,
            "evidence_sha256": expected_evidence_sha256, "evidence_scope": plan.evidence_scope,
            "development_clock": plan.clock, "development_horizon": horizons[plan.clock],
            "cells": tuple(reports), "contrasts": results,
            "all_selected_slots_have_paid_final_evidence": all(cell.final_resources is not None for cell in cells),
            "observed_final_physical_work_ns": _physical_work_ns(final_events),
            "observed_combined_physical_work_ns": _physical_work_ns(prior | final_events),
            "physical_work_scope": physical_scope,
            "confidence_family_alpha": None if plan.sampling is None else _wire(plan.sampling.alpha),
            "confidence_family_scope": None if plan.sampling is None else "source_fidelity_registered_contrasts_only",
            "elapsed_wall_scope": "original_per_activity_observations_only",
            "fidelity_scope": "fixed_checkpoint_observations_and_bounds_over_unobserved_registered_slots"}

OBJECTIVE_PORTABILITY_PLAN_SCHEMA = "reviewed-decoder-objective-portability-plan/v1"
OBJECTIVE_PORTABILITY_SCHEMA = "reviewed-decoder-objective-portability-comparison/v1"


@dataclass(frozen=True)
class VariantObjectiveContrast:
    reference_variant: str
    comparison_variant: str
    teacher: str
    clock: str


@dataclass(frozen=True)
class ObjectivePortabilityPlan:
    matrix_sha256: str
    contrasts: tuple[VariantObjectiveContrast, ...]


def objective_portability_plan_commitment(plan):
    _require(type(plan) is ObjectivePortabilityPlan and _pin(plan.matrix_sha256)
             and type(plan.contrasts) is tuple and bool(plan.contrasts)
             and all(type(item) is VariantObjectiveContrast
                     and _name(item.reference_variant) and _name(item.comparison_variant)
                     and item.reference_variant != item.comparison_variant
                     and _name(item.teacher) and item.teacher in dict(MATRIX_TEACHERS) and item.clock in COVERED_CLOCKS
                     for item in plan.contrasts)
             and len(set(plan.contrasts)) == len(plan.contrasts),
             "exact preregistered, directed variant and teacher comparisons required")
    return commitment((OBJECTIVE_PORTABILITY_PLAN_SCHEMA, plan))


def _objective_portability_rows(projected, cell, clock, horizon, seeds):
    selected = _one_final_row(projected["contrasts"],
        lambda row: _wire(row.get("cell")) == (*cell, "relational_objective"),
        "each variant requires its original teacher-specific tap-to-relational contrast")
    rows = tuple(row for row in selected["pairs"] if row["clock"] == clock)
    _require(tuple(row["seed"] for row in rows) == seeds
             and all(row["contrast_id"] == selected["contrast_id"] and row["horizon"] == horizon for row in rows),
             "the original objective contrast must retain every seed at the common selected horizon")
    return rows


def _objective_portability_quartet(reference, comparison, horizon):
    indicators = tuple(row[role + "_attained"]
                       for row in (reference, comparison) for role in ("baseline", "candidate"))
    times = tuple(row["observed_" + role + "_confirmation"]
                  for row in (reference, comparison) for role in ("baseline", "candidate"))
    attempts = tuple(row[role + "_attempt_sha256"]
                     for row in (reference, comparison) for role in ("baseline", "candidate"))
    _require(all(_pin(pin) for pin in attempts) and len(set(attempts)) == len(attempts)
             and all(value is None or type(value) is int and value in (0, 1) for value in indicators)
             and all(value is None or type(value) is float and isfinite(value) and value >= 0 for value in times)
             and all((value == 1 and time is not None and time <= horizon)
                     or (value != 1 and (time is None or value == 0 and time > horizon))
                     for value, time in zip(indicators, times, strict=True)),
             "exact independent attempt facts and consistent confirmation clocks required")
    return indicators, times, attempts


def _objective_portability_pair(reference, comparison, horizon):
    # Order before/after within each architecture gives +ref.tap-ref.rel-comp.tap+comp.rel.
    signs = (1, -1, -1, 1)
    indicators, times, _ = _objective_portability_quartet(reference, comparison, horizon)
    known = sum(sign * value for sign, value in zip(signs, indicators, strict=True) if value is not None)
    lower = known + sum(min(sign, 0) for sign, value in zip(signs, indicators, strict=True) if value is None)
    upper = known + sum(max(sign, 0) for sign, value in zip(signs, indicators, strict=True) if value is None)
    delta = None
    if all(value == 1 for value in indicators):
        delta = (times[3] - times[2]) - (times[1] - times[0])
        _require(isfinite(delta), "four-arm confirmation time difference must be finite")
    return lower, upper, delta, None not in indicators


def _objective_portability_result(item, *, variants, teachers, projected, seeds, horizon):
    _require(item.reference_variant in variants and item.comparison_variant in variants and item.teacher in teachers,
             "variant or teacher is outside the selected paid matrix")
    ref, other = (variants[label] for label in (item.reference_variant, item.comparison_variant))
    reference = _objective_portability_rows(projected, (ref["label"], item.teacher), item.clock, horizon, seeds)
    comparison = _objective_portability_rows(projected, (other["label"], item.teacher), item.clock, horizon, seeds)
    axis = "within_profile_configuration"
    if ref["student_profile"] != other["student_profile"]:
        axis = "cross_profile"
    elif ref["native_size"] != other["native_size"]:
        axis = "within_profile_hidden_size_change"
    pairs, lo, hi, known, observed = [], 0, 0, 0, 0
    for seed, left, right in zip(seeds, reference, comparison, strict=True):
        lower, upper, delta, complete = _objective_portability_pair(left, right, horizon)
        lo += lower
        hi += upper
        known += int(complete)
        observed += int(delta is not None)
        pairs.append({"seed": seed, "reference_pair": left, "comparison_pair": right,
                      "attainment_interaction_bounds": _wire((Fraction(lower), Fraction(upper))),
                      "confirmation_time_interaction_seconds": delta})
    width, profile = teachers[item.teacher]
    return {"reference_variant": _wire(ref), "comparison_variant": _wire(other), "comparison_axis": axis,
            "teacher": {"name": item.teacher, "native_width": width, "profile_sha256": profile},
            "clock": item.clock, "horizon": horizon, "seed_count": len(seeds), "pairs": tuple(pairs),
            "attainment_interaction_bounds": _wire((Fraction(lo, len(seeds)), Fraction(hi, len(seeds)))),
            "complete_attainment_quartets": known, "observed_confirmation_quartets": observed}


def _objective_portability_variants(matrix):
    """Join variant descriptors to the registered configuration of every original job."""
    variant_rows, attempts = matrix.get("variants"), matrix.get("attempts")
    _require(type(variant_rows) in (tuple, list) and len(variant_rows) >= 2
             and all(type(row) is dict and _name(row.get("label")) and _pin(row.get("configuration_sha256"))
                     and type(row.get("student_profile")) is str and row["student_profile"] in MATRIX_SIZE_FIELDS
                     and row.get("native_size_field") == MATRIX_SIZE_FIELDS[row["student_profile"]]
                     and type(row.get("native_size")) is int and row["native_size"] > 0 for row in variant_rows)
             and len({row["label"] for row in variant_rows}) == len(variant_rows),
             "exact selected profiles, widths and variant descriptors required")
    variants = {row["label"]: row for row in variant_rows}
    _require(type(attempts) in (tuple, list) and all(type(row) is dict and _name(row.get("variant"))
             and row["variant"] in variants
             and row.get("configuration_sha256") == variants[row["variant"]]["configuration_sha256"] for row in attempts)
             and {row["variant"] for row in attempts} == set(variants),
             "original matrix variant configurations must bind every registered attempt")
    return variants


def project_objective_portability(validator, *, plan, expected_plan_sha256, matrix, study, contrasts,
        comparison, expected_comparison_sha256, development_receipts, verify_projection_owner,
        verify_portability_owner, expected_teacher_request_roster_sha256=None):
    """Compare the objective effect across preselected configurations on the same paid study.

    Inputs keep their original source-fidelity threshold, retention proof,
    policies, clocks, horizon, seed labels and paid attempts. The owner verifies
    that the directed comparison plan predates access to the outcomes.
    """
    _require(callable(verify_portability_owner) and _pin(expected_plan_sha256) and type(matrix) is dict
             and objective_portability_plan_commitment(plan) == expected_plan_sha256,
             "independently selected objective portability plan required")
    variants = _objective_portability_variants(matrix)
    projected = project_verified_matrix_comparison(validator, matrix=matrix,
        expected_matrix_sha256=plan.matrix_sha256, study=study, contrasts=contrasts,
        comparison=comparison, expected_comparison_sha256=expected_comparison_sha256,
        development_receipts=development_receipts, verify_projection_owner=verify_projection_owner,
        expected_teacher_request_roster_sha256=expected_teacher_request_roster_sha256)
    projected_sha = commitment(projected)
    _, horizons, _ = _study(validator, study, matrix["study_sha256"])
    seeds = tuple(seed.identifier for seed in study.seeds)
    teacher_rows = tuple(tuple(row) for row in matrix["teachers"])
    _require(len(seeds) >= 2 and tuple(row[:2] for row in teacher_rows) == MATRIX_TEACHERS
             and all(len(row) == 3 and _pin(row[2]) for row in teacher_rows)
             and all(horizons[item.clock] is not None for item in plan.contrasts),
             "exact selected teachers, seed replication and study horizons required")
    teachers = {name: (width, profile) for name, width, profile in teacher_rows}
    rows = tuple(_objective_portability_result(item, variants=variants, teachers=teachers, projected=projected,
                 seeds=seeds, horizon=horizons[item.clock]) for item in plan.contrasts)
    _require(verify_portability_owner(expected_plan_sha256, plan.matrix_sha256, projected_sha) is True
             and objective_portability_plan_commitment(plan) == expected_plan_sha256
             and commitment(matrix) == plan.matrix_sha256 and commitment(study) == matrix["study_sha256"]
             and commitment(contrasts) == matrix["contrast_plan_sha256"]
             and commitment(comparison) == expected_comparison_sha256
             and development_receipts_commitment(development_receipts, design_sha256=matrix["development_design_sha256"],
                   attempts_sha256=comparison["attempts_sha256"]) == comparison["development_receipts_sha256"],
             "portability owner refused or verified paid evidence changed")
    output = {"schema": OBJECTIVE_PORTABILITY_SCHEMA, "plan_sha256": expected_plan_sha256,
            "matrix_sha256": plan.matrix_sha256, "study_sha256": matrix["study_sha256"],
            "development_projection_sha256": projected_sha, "development_panel_sha256": commitment(study.panel),
            "paid_development_comparison_sha256": expected_comparison_sha256,
            "cost_evidence_sha256": projected["cost_evidence_sha256"], "cost_basis": projected["cost_basis"],
            "evidence_kind": projected["evidence_kind"], "comparisons": rows,
            "estimand": "(comparison_relational - comparison_tap) - (reference_relational - reference_tap)",
            "bounds_scope": "finite_selected_seed_panel_attainment_with_unknown_outcomes",
            "time_scope": "conditional_on_all_four_original_confirmations_within_the_common_horizon"}
    if "teacher_request_roster_sha256" in projected:
        output["teacher_request_roster_sha256"] = projected["teacher_request_roster_sha256"]
    return output


OBJECTIVE_RESTRICTED_CONFIRMATION_SCHEMA = "reviewed-objective-portability-restricted-confirmation/v1"


def _restricted_objective_confirmation_pair(reference, comparison, horizon):
    indicators, times, attempts = _objective_portability_quartet(reference, comparison, horizon)
    ceiling = Fraction.from_float(horizon)
    lower, upper = Fraction(0), Fraction(0)
    for sign, attained, observed in zip((1, -1, -1, 1), indicators, times, strict=True):
        if attained is None:
            if sign == 1:
                upper += ceiling
            else:
                lower -= ceiling
        else:
            restricted = Fraction.from_float(observed) if attained == 1 else ceiling
            lower += sign * restricted
            upper += sign * restricted
    return attempts, lower, upper


def _restricted_objective_confirmation_comparison(comparison):
    horizon, clock, pairs = (comparison.get(key) for key in ("horizon", "clock", "pairs"))
    variants = tuple(comparison.get(key) for key in ("reference_variant", "comparison_variant"))
    teacher = comparison.get("teacher")
    _require(type(horizon) is float and isfinite(horizon) and horizon > 0 and type(clock) is str and clock in COVERED_CLOCKS
             and type(pairs) in (tuple, list) and len(pairs) >= 2
             and type(comparison.get("seed_count")) is int and comparison["seed_count"] == len(pairs)
             and all(type(variant) is dict and _name(variant.get("label")) and _pin(variant.get("configuration_sha256"))
                     for variant in variants)
             and variants[0]["label"] != variants[1]["label"]
             and type(teacher) is dict and type(teacher.get("name")) is str
             and type(teacher.get("native_width")) is int
             and dict(MATRIX_TEACHERS).get(teacher["name"]) == teacher.get("native_width")
             and _pin(teacher.get("profile_sha256")),
             "exact variant, teacher, clock, horizon and original seed denominator required")
    labels = tuple(variant["label"] for variant in variants)
    rows, seeds = [], []
    lower_total, upper_total = Fraction(0), Fraction(0)
    required = set(role + suffix for role in ("baseline", "candidate")
                   for suffix in ("_attained", "_attempt_sha256")) | {
                       "observed_baseline_confirmation", "observed_candidate_confirmation"}
    for pair in pairs:
        _require(type(pair) is dict and _name(pair.get("seed")), "one original ordered seed per quartet required")
        seed = pair["seed"]
        original = tuple(pair.get(key) for key in ("reference_pair", "comparison_pair"))
        _require(all(type(row) is dict and required <= row.keys()
                     and (row.get("seed"), row.get("clock"), row.get("horizon")) == (seed, clock, horizon)
                     for row in original), "quartet must retain its two original paired rows at this seed and horizon")
        attempts, lower, upper = _restricted_objective_confirmation_pair(*original, horizon)
        seeds.append(seed)
        rows.append({"seed": seed, "reference_baseline_attempt_sha256": attempts[0],
                     "reference_candidate_attempt_sha256": attempts[1], "comparison_baseline_attempt_sha256": attempts[2],
                     "comparison_candidate_attempt_sha256": attempts[3], "bounds_seconds": _wire((lower, upper))})
        lower_total += lower
        upper_total += upper
    _require(len(set(seeds)) == len(seeds), "complete distinct portability seeds required")
    return (*labels, teacher["name"], clock), tuple(seeds), {
        "reference_variant": labels[0], "comparison_variant": labels[1],
        "configuration_sha256s": tuple(row["configuration_sha256"] for row in variants),
        "teacher": teacher["name"], "teacher_profile_sha256": teacher["profile_sha256"],
        "clock": clock, "horizon_seconds": horizon, "seed_count": len(seeds), "seed_intervals": tuple(rows),
        "mean_interaction_bounds_seconds": _wire((lower_total / len(seeds), upper_total / len(seeds))),
    }


def _restricted_confirmation_validate_shared_subjects(comparisons, original_comparisons):
    subjects, attempts, horizons, configurations, profiles = {}, {}, {}, {}, {}
    clock_facts = {}
    for row, original in zip(comparisons, original_comparisons, strict=True):
        teacher, profile = row["teacher"], row["teacher_profile_sha256"]
        clock, horizon = row["clock"], row["horizon_seconds"]
        _require(horizons.setdefault(clock, horizon) == horizon and profiles.setdefault(teacher, profile) == profile,
                 "original comparisons must share one horizon per clock and one profile per teacher")
        for side, configuration in zip(("reference", "comparison"), row["configuration_sha256s"], strict=True):
            variant = row[f"{side}_variant"]
            _require(configurations.setdefault(variant, configuration) == configuration,
                     "one originally registered configuration per variant required")
            for seed, original_pair in zip(row["seed_intervals"], original["pairs"], strict=True):
                offered = original_pair[f"{side}_pair"]
                for arm in ("baseline", "candidate"):
                    subject = variant, teacher, seed["seed"], arm
                    attempt = seed[f"{side}_{arm}_attempt_sha256"]
                    _require(subjects.setdefault(subject, attempt) == attempt and attempts.setdefault(attempt, subject) == subject,
                             "one original attempt per registered variant, teacher, seed and arm required")
                    facts = (offered[f"{arm}_attained"], offered[f"observed_{arm}_confirmation"])
                    _require(clock_facts.setdefault((attempt, clock), facts) == facts,
                             "one original attainment and confirmation reading per attempt and clock required")


def _portability_confirmation_pair_key(row):
    values = tuple(row.get(key) for key in ("contrast_id", "seed", "clock", "horizon",
                                            "baseline_attempt_sha256", "candidate_attempt_sha256"))
    contrast, seed, clock, horizon, baseline, candidate = values
    _require(_name(contrast) and _name(seed) and type(clock) is str and clock in COVERED_CLOCKS
             and type(horizon) is float and isfinite(horizon) and horizon > 0
             and _pin(baseline) and _pin(candidate) and baseline != candidate,
             "exact original contrast, seed, horizon, clock and attempt identities required")
    return values


def _portability_paid_confirmation_pairs(development, paid_comparison):
    selected = development["paid_development_comparison_sha256"]
    fields = ("study_sha256", "cost_evidence_sha256", "cost_basis")
    _require(type(paid_comparison) is dict and paid_comparison.get("schema") == VERIFIED_DEVELOPMENT_SCHEMA
             and all(paid_comparison.get(field) == development[field] for field in fields)
             and commitment(paid_comparison) == selected
             and type(paid_comparison.get("confirmation_cost_bounds")) is dict
             and type(paid_comparison.get("pairs")) in (tuple, list)
             and all(type(row) is dict for row in paid_comparison["pairs"]),
             "exact paid DEVELOPMENT comparison with authenticated confirmation meters required")
    declared = paid_comparison["confirmation_cost_bounds"]
    recomputed = _verified_confirmation_cost_bounds(paid_comparison)
    _require(commitment(declared) == commitment(recomputed),
             "paid confirmation bounds must reproduce from the original attempt meters")
    paired = {}
    for original, bounded in zip(paid_comparison["pairs"], recomputed["pairs"], strict=True):
        key = _portability_confirmation_pair_key(original)
        _require(key == _portability_confirmation_pair_key(bounded) and key not in paired,
                 "unique original paid comparison pairs required")
        paired[key] = (commitment(original), bounded)
    return paired, commitment(declared)


def _portability_meter_interactions(comparison, original, paid_pairs):
    rows = []
    for pair, legacy in zip(original["pairs"], comparison["seed_intervals"], strict=True):
        sides = []
        for side in ("reference_pair", "comparison_pair"):
            offered = pair[side]
            key = _portability_confirmation_pair_key(offered)
            entry = paid_pairs.get(key)
            _require(entry is not None and entry[0] == commitment(offered),
                     "each Stage G quartet must retain both exact original paid pairs")
            sides.append(entry[1])
        reference, alternative = sides
        clock = "restricted_candidate_minus_baseline_seconds_bounds"
        left, right = (tuple(Fraction(*value) for value in row[clock]) for row in sides)
        interval = (right[0] - left[1], right[1] - left[0])
        key = "candidate_minus_baseline_attainment_bounds"
        ref_attain, other_attain = reference[key], alternative[key]
        attainment = (other_attain[0] - ref_attain[1], other_attain[1] - ref_attain[0])
        rows.append(({**legacy, "reference_pair": reference, "comparison_pair": alternative,
                      "bounds_seconds": _wire(interval), "attainment_interaction_bounds": attainment},
                     interval, attainment))
    count = len(rows)
    intervals, times, attainment = zip(*rows, strict=True)
    return {**comparison, "seed_intervals": intervals,
            "mean_interaction_bounds_seconds": _wire(tuple(sum(values) / count for values in zip(*times, strict=True))),
            "mean_attainment_interaction_bounds": _wire(tuple(Fraction(sum(values), count)
                                                            for values in zip(*attainment, strict=True)))}


def summarize_objective_portability_restricted_confirmation(development, *, expected_development_sha256,
                                                            verify_original_development_owner, paid_comparison=None):
    """Read per-clock finite-panel confirmation bounds from an original paid Stage G report.

    Each arm contributes the scheduled confirmation clock clipped at the existing
    horizon. A known absence uses the horizon. An unknown contributes its full
    interval. The average gives equal weight to every selected seed and does not
    infer a failed run's resource use or make a population-level claim.

    Optional paid comparison evidence adds independently authenticated
    meter bounds without altering the original restricted result.
    """
    _require(type(development) is dict and development.get("schema") == OBJECTIVE_PORTABILITY_SCHEMA
             and _pin(expected_development_sha256) and callable(verify_original_development_owner)
             and all(_pin(development.get(key)) for key in ("plan_sha256", "matrix_sha256", "study_sha256",
                 "development_projection_sha256", "paid_development_comparison_sha256", "cost_evidence_sha256"))
             and development.get("evidence_kind") in ("fictional_fixture", "native_reviewed")
             and development.get("cost_basis") in ("first_use", "amortized")
             and type(development.get("comparisons")) in (tuple, list) and bool(development["comparisons"])
             and all(type(row) is dict for row in development["comparisons"])
             and commitment(development) == expected_development_sha256,
             "original paid objective portability result and its independent evidence owner required")
    rows = tuple(_restricted_objective_confirmation_comparison(row) for row in development["comparisons"])
    seeds = rows[0][1]
    _require(len({key for key, _, _ in rows}) == len(rows) and all(row_seeds == seeds for _, row_seeds, _ in rows),
             "all declared comparisons must preserve the same original ordered seed roster")
    comparisons = tuple(row for _, _, row in rows)
    _restricted_confirmation_validate_shared_subjects(comparisons, development["comparisons"])
    meter_readback = {}
    if paid_comparison is not None:
        paid_pairs, meter_pin = _portability_paid_confirmation_pairs(development, paid_comparison)
        meter_readback = {"paid_confirmation_bounds_sha256": meter_pin,
            "meter_bounded_comparisons": tuple(_portability_meter_interactions(row, original, paid_pairs)
                for row, original in zip(comparisons, development["comparisons"], strict=True))}
    _require(verify_original_development_owner(expected_development_sha256, development["plan_sha256"],
                    development["paid_development_comparison_sha256"]) is True
             and commitment(development) == expected_development_sha256
             and (paid_comparison is None or
                  commitment(paid_comparison) == development["paid_development_comparison_sha256"]),
             "original paid development owner refused or restricted-time inputs changed")
    return {"schema": OBJECTIVE_RESTRICTED_CONFIRMATION_SCHEMA,
            "original_development_sha256": expected_development_sha256,
            "original_paid_comparison_sha256": development["paid_development_comparison_sha256"],
            "cost_basis": development["cost_basis"], "evidence_kind": development["evidence_kind"],
            "selected_seeds": seeds, "comparisons": comparisons,
            "estimand": "(comparison_relational - comparison_tap) - (reference_relational - reference_tap)",
            "scope": "finite_selected_seed_scheduled_confirmation_clipped_at_each_original_clock_horizon",
            "changes_paid_or_final_evidence": False, **meter_readback}


FINAL_OBJECTIVE_PORTABILITY_ROSTER_SCHEMA = "reviewed-final-objective-portability-roster/v1"
FINAL_OBJECTIVE_PORTABILITY_SCHEMA = "reviewed-final-objective-portability-comparison/v1"


@dataclass(frozen=True)
class ObjectiveFinalPortabilityInput:
    paired_plan: PairedFinalPlan
    cells: tuple[PairedFinalCell, ...]
    expected_evidence_sha256: str


def final_objective_portability_roster_commitment(validator, expected_plan_sha256, paired_plans):
    """Bind the existing final-panel plans to the directed development plan before outcomes."""
    _require(_pin(expected_plan_sha256) and type(paired_plans) is tuple and bool(paired_plans)
             and all(type(paired) is PairedFinalPlan for paired in paired_plans),
             "ordered original paired final plans required")
    selections = tuple((paired.contrast_id, paired.clock, paired_final_plan_commitment(validator, paired))
                       for paired in paired_plans)
    _require(len({row[:2] for row in selections}) == len(selections),
             "each original objective contrast and clock must be selected once")
    return commitment((FINAL_OBJECTIVE_PORTABILITY_ROSTER_SCHEMA, expected_plan_sha256, selections))


def _final_objective_portability_inputs(validator, final_inputs, expected_plan_sha256, projection_sha256):
    _require(type(final_inputs) is tuple and all(type(item) is ObjectiveFinalPortabilityInput
                                                for item in final_inputs),
             "original paired final plans and exact ordered cells required")
    plans = tuple(item.paired_plan for item in final_inputs)
    roster_sha = final_objective_portability_roster_commitment(validator, expected_plan_sha256, plans)
    bindings = tuple((paired_final_plan_commitment(validator, item.paired_plan), item.expected_evidence_sha256)
                     for item in final_inputs)
    _require(all(paired_final_evidence_commitment(plan_sha, projection_sha256, item.cells) == evidence
                 for item, (plan_sha, evidence) in zip(final_inputs, bindings, strict=True)),
             "final cells differ from one of the original paired commitments")
    return roster_sha, bindings


def _final_objective_portability_scope(reference, comparison):
    _require((reference.panel, reference.case_aliases, reference.fidelity_eligible,
              reference.cutoffs, reference.final_policy_sha256)
             == (comparison.panel, comparison.case_aliases, comparison.fidelity_eligible,
                 comparison.cutoffs, comparison.final_policy_sha256),
             "variant comparison needs the same untouched final rows, aliases, eligibility, policy and cutoffs")


def _final_portability_group_interaction(plan, seeds, reference, comparison, known, estimand):
    groups = {}
    eligible = set(plan.fidelity_eligible)
    for row_id, dependency, _ in plan.panel:
        if row_id in eligible:
            groups.setdefault(dependency, set()).add(row_id)

    expected = tuple((seed, dependency, len(rows)) for seed in seeds for dependency, rows in groups.items())
    reference_rows, comparison_rows = (fidelity["by_seed_and_group"] for fidelity in (reference, comparison))
    _require(all(tuple((row["seed"], row["dependency_group_sha256"], row["eligible_rows"]) for row in roster) == expected
                 for roster in (reference_rows, comparison_rows)),
             "original final reports must exhaust the same ordered seed by dependency-group grid")
    intervals = []
    for left, right in zip(reference_rows, comparison_rows, strict=True):
        seed, dependency = left["seed"], left["dependency_group_sha256"]
        a0, a1 = (Fraction(*bound) for bound in left["fidelity_delta_bounds"])
        b0, b1 = (Fraction(*bound) for bound in right["fidelity_delta_bounds"])
        intervals.append({"seed": seed, "dependency_group_sha256": dependency,
                          "eligible_rows": len(groups[dependency]),
                          "complete_row_quartets": len(known[seed] & groups[dependency]),
                          "interaction_bounds": (b0 - a1, b1 - a0)})
    lower, upper = (sum(row["interaction_bounds"][i] for row in intervals) / len(intervals) for i in (0, 1))
    return {"estimand": estimand,
            "scope": "finite_selected_final_panel_and_seed_partial_identification",
            "seed_count": len(seeds), "dependency_groups": len(groups), "eligible_rows_per_seed": len(eligible),
            "complete_row_quartets": sum(row["complete_row_quartets"] for row in intervals),
            "interaction_bounds": _wire((lower, upper)), "by_seed_and_group": _wire(intervals), "confidence": None}


def _final_objective_portability_group_bounds(plan, seeds, reference, comparison, reference_cells, comparison_cells):
    def reviewed_rows(cell):
        if cell.final_report is None:
            return set()
        return {row["row_id"] for row in cell.final_report["rows"]
                if row["review_eligible"] and row["source_fidelity"] is not None}

    known = {seed: set.intersection(*(reviewed_rows(cells[i]) for cells in (reference_cells, comparison_cells)
                                   for i in (2*j, 2*j + 1))) for j, seed in enumerate(seeds)}
    return _final_portability_group_interaction(plan, seeds, reference["fidelity"], comparison["fidelity"], known,
        "(comparison_relational - comparison_tap) - (reference_relational - reference_tap)")


def _check_final_objective_portability_closes(artifacts):
    activity_to_origin = {}
    closes_by_origin = {}
    for source, report in artifacts:
        for cell, row in zip(source.cells, report["cells"], strict=True):
            if cell.final_decision is None:
                continue
            evaluation = cell.final_decision["final_evaluation_sha256"]
            origin = row["attempt_sha256"], evaluation
            closes = (row["terminal_close_sha256"], *row["component_owner_close_sha256s"])
            identifiers = (evaluation, *closes)
            _require(len(set(identifiers)) == len(identifiers)
                     and all(activity_to_origin.setdefault(pin, origin) == origin
                             for pin in identifiers)
                     and closes_by_origin.setdefault(origin, closes) == closes,
                     "physical final evaluations require one original attempt and exact ordered owner closes")


def assemble_final_objective_portability(validator, *, plan, expected_plan_sha256,
        development, expected_development_sha256, matrix, study, design, comparison,
        projected, expected_projection_sha256, final_inputs, expected_roster_sha256,
        verify_checkpoint_owner, verify_paired_final_owner, verify_final_portability_owner):
    """Compare final source-fidelity effects on the same reserved panel.

    Existing final owners revalidate each original plan and its paid slots.
    The portability owner authenticates the exact prior development result
    and verifies that the final roster and its crosswalk were selected before
    access to the final outcomes. Paid final work remains per original scope.
    """
    _require(callable(verify_final_portability_owner) and _pin(expected_roster_sha256)
             and objective_portability_plan_commitment(plan) == expected_plan_sha256
             and type(development) is dict and development.get("schema") == OBJECTIVE_PORTABILITY_SCHEMA
             and commitment(development) == expected_development_sha256
             and development.get("plan_sha256") == expected_plan_sha256
             and type(matrix) is dict and matrix.get("schema") == MATCHED_MATRIX_SCHEMA
             and commitment(matrix) == development.get("matrix_sha256") == plan.matrix_sha256
             and type(comparison) is dict and comparison.get("schema") == VERIFIED_DEVELOPMENT_SCHEMA
             and commitment(comparison) == development.get("paid_development_comparison_sha256")
             and type(projected) is dict and projected.get("schema") == MATCHED_MATRIX_COMPARISON_SCHEMA
             and commitment(projected) == expected_projection_sha256 == development.get("development_projection_sha256")
             and projected.get("development_comparison_sha256") == commitment(comparison)
             and projected.get("evidence_kind") == matrix.get("evidence_kind") == development.get("evidence_kind"),
             "exact preselected development portability result, paid projection and final roster required")
    roster_sha, bindings = _final_objective_portability_inputs(
        validator, final_inputs, expected_plan_sha256, expected_projection_sha256)
    _require(roster_sha == expected_roster_sha256, "paired final roster differs from its preselected commitment")
    _require(development.get("study_sha256") == matrix["study_sha256"]
             and development_design_commitment(design) == matrix["development_design_sha256"],
             "final portability must use the original study and reserved split design")
    _, horizons, _ = _study(validator, study, matrix["study_sha256"])
    seeds = tuple(seed.identifier for seed in study.seeds)
    variants = _objective_portability_variants(matrix)
    teachers = {name: (width, digest) for name, width, digest in matrix["teachers"]}
    rows = tuple(_objective_portability_result(item, variants=variants, teachers=teachers, projected=projected,
                 seeds=seeds, horizon=horizons[item.clock]) for item in plan.contrasts)
    _require(commitment(rows) == commitment(development.get("comparisons")),
             "development comparison rows differ from the original paid variant, teacher or attempt slots")
    directions = tuple(tuple((row["pairs"][0][side]["contrast_id"], row["clock"])
                             for side in ("reference_pair", "comparison_pair")) for row in rows)
    roster = tuple(dict.fromkeys(key for pair in directions for key in pair))
    selected = deepcopy(final_inputs)
    _require(tuple((item.paired_plan.contrast_id, item.paired_plan.clock) for item in selected) == roster,
             "original final plans must exhaust the directed portability selection in order")
    indexed = dict(zip(roster, selected, strict=True))
    for reference, comparison_side in directions:
        _final_objective_portability_scope(indexed[reference].paired_plan, indexed[comparison_side].paired_plan)

    results = tuple(assemble_paired_final_panel(validator, plan=item.paired_plan, expected_plan_sha256=plan_sha,
                    matrix=matrix, study=study, design=design, comparison=comparison, projected=projected,
                    expected_projection_sha256=expected_projection_sha256, cells=item.cells,
                    expected_evidence_sha256=evidence_sha, verify_checkpoint_owner=verify_checkpoint_owner,
                    verify_paired_final_owner=verify_paired_final_owner)
                    for item, (plan_sha, evidence_sha) in zip(selected, bindings, strict=True))
    _check_final_objective_portability_closes(tuple(zip(selected, results, strict=True)))
    by_key = dict(zip(roster, results, strict=True))
    transfers = []
    for row, (reference, comparison_side) in zip(rows, directions, strict=True):
        left, right = by_key[reference], by_key[comparison_side]
        ref_input, other_input = indexed[reference], indexed[comparison_side]
        final_plan = ref_input.paired_plan
        transfers.append({key: row[key] for key in ("reference_variant", "comparison_variant", "comparison_axis",
                                                   "teacher", "clock", "horizon")})
        transfers[-1].update(final_panel_sha256=left["final_panel_sha256"],
            final_policy_sha256=left["final_policy_sha256"], final_case_aliases_sha256=commitment(final_plan.case_aliases),
            reference_paired_report_sha256=commitment(left), comparison_paired_report_sha256=commitment(right),
            reference_retention_roster_sha256=commitment(final_plan.retention_references),
            comparison_retention_roster_sha256=commitment(other_input.paired_plan.retention_references),
            fidelity=_final_objective_portability_group_bounds(final_plan, seeds, left, right,
                                                               ref_input.cells, other_input.cells))
    joined = tuple((*binding, commitment(report)) for binding, report in zip(bindings, results, strict=True))
    _require(verify_final_portability_owner(expected_roster_sha256, expected_development_sha256, joined) is True
             and objective_portability_plan_commitment(plan) == expected_plan_sha256
             and commitment(matrix) == plan.matrix_sha256 and commitment(study) == matrix["study_sha256"]
             and development_design_commitment(design) == matrix["development_design_sha256"]
             and commitment(development) == expected_development_sha256
             and commitment(comparison) == development["paid_development_comparison_sha256"]
             and commitment(projected) == expected_projection_sha256
             and _final_objective_portability_inputs(validator, final_inputs, expected_plan_sha256,
                    expected_projection_sha256) == (roster_sha, bindings),
             "final portability owner refused or exact selected evidence changed")
    return {"schema": FINAL_OBJECTIVE_PORTABILITY_SCHEMA, "matrix_sha256": plan.matrix_sha256,
            "development_objective_portability_sha256": expected_development_sha256,
            "final_plan_roster_sha256": expected_roster_sha256, "original_paired_owner_evidence": joined,
            "evidence_kind": development["evidence_kind"], "comparisons": tuple(transfers), "paired_panels": results,
            "cost_scope": "retain_original_paid_scopes_without_cross_portability_summation"}


FIXED_STAGE_PORTABILITY_SCHEMA = "reviewed-fixed-stage-weight-edit-portability/v1"


@dataclass(frozen=True)
class FixedStagePortabilityVariant:
    label: str
    configuration_sha256: str
    architecture_sha256: str
    paired_plan_sha256: str


@dataclass(frozen=True)
class FixedStagePortabilityContrast:
    reference_variant: str
    comparison_variant: str
    contrast_id: str


@dataclass(frozen=True)
class FixedStagePortabilityPlan:
    semantic_design_sha256: str
    variants: tuple[FixedStagePortabilityVariant, ...]
    contrasts: tuple[FixedStagePortabilityContrast, ...]
    teacher_condition: tuple[str, int, str] | None = None


@dataclass(frozen=True)
class FixedStagePortabilityInput:
    variant: str
    configuration: dict
    development_design: DevelopmentDesign
    reservation: FixedStageFinalReservation
    study: Study
    contrast_plan: ContrastPlan
    development_comparison: dict
    paired_plan: FixedStageFinalPairPlan
    cells: tuple[FixedStageFinalPairCell, ...]
    expected_evidence_sha256: str
    scheduled_readbacks: tuple[FixedStageFinalPairReadback, ...]
    expected_scheduled_readbacks_sha256: str


def fixed_stage_portability_plan_commitment(plan):
    _require(type(plan) is FixedStagePortabilityPlan and _pin(plan.semantic_design_sha256)
             and type(plan.variants) is tuple and 2 <= len(plan.variants) <= 8
             and all(type(row) is FixedStagePortabilityVariant and _name(row.label)
                     and all(_pin(pin) for pin in (row.configuration_sha256, row.architecture_sha256, row.paired_plan_sha256))
                     for row in plan.variants)
             and all(len({getattr(row, key) for row in plan.variants}) == len(plan.variants)
                     for key in ("label", "configuration_sha256", "paired_plan_sha256")),
             "exact distinct registered decoder configurations and original paired plans required")
    labels = {row.label for row in plan.variants}
    teacher = plan.teacher_condition
    _require((teacher is None or (type(teacher) is tuple and len(teacher) == 3 and type(teacher[1]) is int
                                  and teacher[:2] in MATRIX_TEACHERS and _pin(teacher[2])))
             and type(plan.contrasts) is tuple and bool(plan.contrasts)
             and all(type(row) is FixedStagePortabilityContrast and row.reference_variant in labels
                     and row.comparison_variant in labels and row.reference_variant != row.comparison_variant
                     and _name(row.contrast_id) for row in plan.contrasts)
             and len(set(plan.contrasts)) == len(plan.contrasts)
             and labels == {label for row in plan.contrasts for label in (row.reference_variant, row.comparison_variant)},
             "exact directed variant comparisons and one optional selected teacher condition required")
    return commitment((FIXED_STAGE_PORTABILITY_SCHEMA, "plan", plan))


def fixed_stage_portability_inputs_commitment(expected_plan_sha256, inputs):
    _require(_pin(expected_plan_sha256) and type(inputs) is tuple and bool(inputs)
             and all(type(row) is FixedStagePortabilityInput and _name(row.variant)
                     and type(row.configuration) is dict and type(row.development_comparison) is dict
                     and _pin(row.expected_evidence_sha256) and _pin(row.expected_scheduled_readbacks_sha256)
                     for row in inputs)
             and len({row.variant for row in inputs}) == len(inputs),
             "ordered original fixed-stage variant inputs, paid evidence and scheduled archive readbacks required")
    return commitment((FIXED_STAGE_PORTABILITY_SCHEMA, "leased-paired-evidence", expected_plan_sha256, inputs))


def _require_original_fixed_stage_operation(configuration, architecture_sha256, readbacks):
    """Resolve the operation and topology committed by the original readback."""
    _require(bool(readbacks), "unsupported_required_capability: native fixed-stage portability needs an original edit readback")
    # This existing readback is issued by the compact boundary owner. Its
    # architecture pin comes from boundary_edit.parent_architecture_sha256,
    # not from the generic student arming profile or a selected width.
    _require(all(row.readback.get("schema") == "compact-boundary-scheduled-postimage-readback/v1" for row in readbacks),
             "unsupported_required_capability: native fixed-stage readback has no supported operation owner")
    _require(configuration.get("architecture") == "factorized-768-to-384-inherited-gru/v1",
             "unsupported_required_capability: original compact affine edit does not support the registered decoder topology")
    fields = ("architecture", "domain_id", "config", "codec_sha256", "input_transform_sha256", "implementation")
    _require(all(key in configuration for key in fields)
             and commitment({key: configuration[key] for key in fields}) == architecture_sha256
             and all((row.readback.get("architecture_sha256"), row.readback.get("codec_sha256"))
                     == (architecture_sha256, configuration["codec_sha256"]) for row in readbacks),
             "unsupported_required_capability: original compact edit topology, configuration or codec was not resolved")


def _fixed_stage_portability_scope(validator, arming, selected, offer):
    study, design, paired, reserve = offer.study, offer.development_design, offer.paired_plan, offer.reservation
    configuration = offer.configuration
    native = paired.evidence_scope == "native_reviewed"
    if not native:
        variant = _matrix_variant(arming, (selected.label, selected.configuration_sha256), configuration)
    comparison = offer.development_comparison
    design_sha = development_design_commitment(design)
    _require(paired.evidence_scope in ("native_reviewed", "synthetic_reference_only")
             and fixed_stage_final_pair_plan_commitment(validator, paired) == selected.paired_plan_sha256
             and type(comparison) is dict and comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA
             and comparison.get("development_design_sha256") == design_sha
             and comparison.get("study_sha256") == design.study_sha256 == paired.study_sha256
             and commitment(comparison) == paired.development_comparison_sha256
             and fixed_stage_final_reservation_commitment(reserve) == paired.final_reservation_sha256
             and (reserve.development_design_sha256, reserve.global_split_sha256, reserve.population_sha256,
                  reserve.reserved_final_count, reserve.final_policy_sha256)
                 == (design_sha, design.global_split_sha256, design.population_sha256,
                     design.reserved_final_count, paired.final_policy_sha256)
             and reserve.reserved_final_count == len(paired.panel) and reserve.opaque_final_sha256 != reserve.global_split_sha256,
             "registered variant must retain its original sustained study, paired plan and untouched reserve")
    _, horizons, _ = _study(validator, study, paired.study_sha256)
    seeds = tuple(seed.identifier for seed in study.seeds)
    _require(len(seeds) >= 2 and seeds == tuple(row[0] for row in design.seed_cohorts)
             and fixed_stage_final_pair_readbacks_commitment(selected.paired_plan_sha256,
                    offer.expected_evidence_sha256, offer.scheduled_readbacks) == offer.expected_scheduled_readbacks_sha256
             and all(row.readback.get("architecture_sha256") == selected.architecture_sha256
                     for row in offer.scheduled_readbacks),
             "original seed roster and scheduled readbacks must match the independently registered architecture")
    if native:
        _require(commitment(configuration) == selected.configuration_sha256,
                 "compact configuration differs from its exact selected bytes")
        _require_original_fixed_stage_operation(configuration, selected.architecture_sha256, offer.scheduled_readbacks)
        parameters = configuration["config"]
        width = parameters.get("hidden_size") if type(parameters) is dict else None
        _require(type(width) is int and width > 0, "original operation requires a positive compact decoder hidden_size")
        variant = {"label": selected.label, "configuration_sha256": selected.configuration_sha256,
                   "student_profile": configuration["architecture"],
                   "native_size_field": "config.hidden_size", "native_size": width}
    # Check cohort and review semantics across variants. Retention checkpoint
    # identities remain variant-specific and are verified by the paired owner.
    scope = (
        (design.global_split_sha256, design.population_sha256, design.case_aliases_sha256, design.seed_cohorts),
        (study.panel, tuple((seed.identifier, seed.gate_denominators) for seed in study.seeds),
         study.evaluation_policy_sha256, study.cost_policy_sha256, study.schedule, study.gates, study.required_streak,
         study.horizons, study.budget_caps, study.cost_basis, study.reuse_count, study.stop_after_confirmation),
        (paired.clock, paired.evidence_scope, paired.panel, paired.final_policy_sha256,
         paired.review_policy_sha256, paired.source_crosswalk_sha256, paired.fidelity_eligible, paired.formal_required,
         paired.cutoffs, reserve.opaque_final_sha256, reserve.access_policy_sha256),
    )
    return {**variant, "architecture_sha256": selected.architecture_sha256,
             "final_transport_panel_sha256": paired.final_panel_sha256}, scope, seeds, horizons[paired.clock]


def _fixed_stage_portability_attempts_and_costs(offer, report):
    comparison = offer.development_comparison
    attempts = {row["attempt_sha256"] for row in comparison["attempt_decisions"]}
    events = _compact_paid_event_roster(comparison)
    owned = set()
    # Policies, semantic artifacts and checkpoints may be shared. The
    # original observation and measurement identities belong to each lane.
    for row in comparison["attempt_decisions"]:
        owned.add(row["closeout_receipt_sha256"])
        owned.update(_fixed_stage_paid_scope_pins({"meter": row["closing_meter"], "interval": row["closing_interval"]}))
        for look in row["look_evidence"]:
            owned.update(look[key] for key in ("evaluation_receipt_sha256", "gate_report_sha256", "readback_sha256"))
            owned.update(look["training_and_evaluation_closes"])
            owned.update(_fixed_stage_paid_scope_pins(look))
    for cell in offer.cells:
        if cell.final_resources is None:
            continue
        new = _compact_paid_event_roster(cell.final_resources)
        _require(set(new).isdisjoint(events), "paired FINAL event already belongs to this DEVELOPMENT cost record")
        events.update(new)
        for activity in cell.final_resources["activities"]:
            evaluation = activity["activity"]["evaluation_sha256"]
            interval = activity.get("interval")
            _require(type(interval) is dict and set(interval) == set(MeterInterval.__dataclass_fields__)
                     and (interval["attempt_sha256"], interval["stage"]) == (evaluation, "close")
                     and _pin(interval["scope_receipt_sha256"]) and _pin(interval["subject_sha256"])
                     and commitment(interval) == activity["meter"]["interval_manifest_sha256"],
                     "variant FINAL costs require the original authenticated activity interval and scope receipt")
            owned.update((evaluation, activity["terminal_close_sha256"], *activity["component_owner_close_sha256s"]))
            owned.update(_fixed_stage_paid_scope_pins(activity))
            if activity.get("wall") is not None:
                owned.add(activity["wall"]["receipt_sha256"])
            if activity.get("baseline_receipt_sha256") is not None:
                owned.add(activity["baseline_receipt_sha256"])
    physical = _physical_work_ns(events)
    _require(commitment(physical) == commitment(report["observed_combined_physical_work_ns"]),
             "variant cost must preserve the entire original DEVELOPMENT and observed FINAL event union")
    event_ids, closes = set(events), {event.close_receipt_sha256 for event in events.values()}
    _require(len(closes) == len(events) and event_ids.isdisjoint(closes) and attempts.isdisjoint(event_ids | closes),
             "fixed-stage attempts, event identities and physical closes must remain distinct")
    return owned | attempts | event_ids | closes, events


def _fixed_stage_portability_comparison(item, left, right, variants, seeds, horizon):
    left_input, left_report = left
    right_input, right_report = right
    original = tuple(_one_final_row(report["contrasts"], lambda row: row.get("identifier") == item.contrast_id,
                     "each original paired variant must supply the registered directed contrast") for _, report in (left, right))
    baseline, candidate = original[0]["baseline"], original[0]["candidate"]
    _require((baseline, candidate) in (("adam", "programmed"), ("random", "programmed"))
             and all((row["baseline"], row["candidate"], row["role"]) == (baseline, candidate, "primary") for row in original),
             "fixed-stage portability must preserve the selected Adam or random control direction")
    clock = left_input.paired_plan.clock
    pairs, known, cell_tables = [], {}, []
    for offer, row in zip((left_input, right_input), original, strict=True):
        selected = tuple(pair for pair in row["original_development_pairs"] if pair["clock"] == clock)
        attempts = {(part["seed"], part["arm"]): part["attempt_sha256"]
                    for part in offer.development_comparison["attempt_decisions"]}
        _require(tuple(pair["seed"] for pair in selected) == seeds and all(pair["horizon"] == horizon for pair in selected),
                 "directed portability must retain every original seed at the common horizon")
        pairs.append(tuple({**pair, "baseline_attempt_sha256": attempts[pair["seed"], baseline],
                            "candidate_attempt_sha256": attempts[pair["seed"], candidate]} for pair in selected))
        cell_tables.append({(cell.seed, cell.arm): cell for cell in offer.cells})
    selected_panel = left_input.paired_plan
    for seed in seeds:
        observed = set(selected_panel.fidelity_eligible)
        for cells in cell_tables:
            for arm in (baseline, candidate):
                review = cells[seed, arm].final_review
                observed.intersection_update(() if review is None else (
                    row for row in selected_panel.fidelity_eligible if review["rows"][row]["source_success"] is not None))
        known[seed] = observed
    development_rows = []
    lo, hi = 0, 0
    for seed, reference, comparison in zip(seeds, *pairs, strict=True):
        lower, upper, timing, complete = _objective_portability_pair(reference, comparison, horizon)
        lo += lower
        hi += upper
        development_rows.append({"seed": seed, "reference_pair": reference, "comparison_pair": comparison,
            "attainment_interaction_bounds": _wire((Fraction(lower), Fraction(upper))),
            "complete_attainment_quartet": complete, "confirmation_time_interaction_seconds": timing})
    ref, other = (variants[label] for label in (item.reference_variant, item.comparison_variant))
    if ref["student_profile"] != other["student_profile"]:
        axis = "cross_profile"
    elif ref["native_size"] != other["native_size"]:
        axis = "within_profile_native_size_change"
    else:
        axis = "within_profile_configuration"
    estimand = f"(comparison_programmed - comparison_{baseline}) - (reference_programmed - reference_{baseline})"
    return {"reference_variant": ref, "comparison_variant": other, "comparison_axis": axis,
        "contrast_id": item.contrast_id, "control": baseline, "candidate": candidate, "clock": clock, "horizon": horizon,
        "development": {"pairs": tuple(development_rows),
                        "attainment_interaction_bounds": _wire((Fraction(lo, len(seeds)), Fraction(hi, len(seeds))))},
        "fidelity": _final_portability_group_interaction(selected_panel, seeds, original[0]["fidelity"], original[1]["fidelity"],
                                                        known, estimand)}


def assemble_fixed_stage_portability(validator, *, arming, plan, expected_plan_sha256, inputs,
        expected_inputs_sha256, verify_portability_owner, verify_paired_final_owner):
    """Replay the existing paired FINAL owners before comparing registered decoders.

    The independent portability owner authenticates the preregistered semantic
    crosswalk, exact per-variant architecture and runtime, native training
    cohorts and any declared teacher condition. Each paired owner verifies its
    original gates and paid work. This reducer opens no model or FINAL data.
    """
    _require(callable(verify_portability_owner) and callable(verify_paired_final_owner)
             and _pin(expected_plan_sha256) and _pin(expected_inputs_sha256),
             "independent portability and original paired FINAL owners required")

    def current():
        _require(fixed_stage_portability_plan_commitment(plan) == expected_plan_sha256
                 and fixed_stage_portability_inputs_commitment(expected_plan_sha256, inputs) == expected_inputs_sha256
                 and tuple(offer.variant for offer in inputs) == tuple(row.label for row in plan.variants),
                 "original fixed-stage portability plan, variant order or selected inputs changed")

    current()
    scopes = tuple(_fixed_stage_portability_scope(validator, arming, selection, offer)
                   for selection, offer in zip(plan.variants, inputs, strict=True))
    _, common_scope, seeds, horizon = scopes[0]
    _require(horizon is not None and all(scope == common_scope and labels == seeds and limit == horizon
                                       for _, scope, labels, limit in scopes),
             "decoder variants require the same TRAIN, DEVELOPMENT and FINAL review scope, seed frame and cost horizon")
    current()
    _require(verify_portability_owner(expected_plan_sha256, plan.semantic_design_sha256, expected_inputs_sha256) is True,
             "portability owner refused the registered variants, semantic design or exact evidence")
    current()
    owned, events, results = set(), {}, {}
    for selection, offer in zip(plan.variants, inputs, strict=True):
        report = assemble_fixed_stage_paired_final_panel(validator, plan=offer.paired_plan,
            expected_plan_sha256=selection.paired_plan_sha256, study=offer.study, contrast_plan=offer.contrast_plan,
            development_comparison=offer.development_comparison, cells=offer.cells,
            expected_evidence_sha256=offer.expected_evidence_sha256, scheduled_readbacks=offer.scheduled_readbacks,
            expected_scheduled_readbacks_sha256=offer.expected_scheduled_readbacks_sha256,
            verify_paired_final_owner=lambda *pins: verify_paired_final_owner(selection.label, *pins))
        current()
        identities, local_events = _fixed_stage_portability_attempts_and_costs(offer, report)
        _require(owned.isdisjoint(identities),
                 "one attempt, paid event, physical close or measured observation cannot qualify two decoder variants")
        owned.update(identities)
        events.update(local_events)
        results[selection.label] = (offer, report)
    variants = {variant["label"]: variant for variant, _, _, _ in scopes}
    comparisons = tuple(_fixed_stage_portability_comparison(row, results[row.reference_variant],
                        results[row.comparison_variant], variants, seeds, horizon) for row in plan.contrasts)
    current()
    discovery_scopes = tuple({"variant": label, **_sustained_discovery_scope(offer.development_comparison, offer.paired_plan.clock)}
                             for label, (offer, _) in results.items())
    discovery = {}
    cost_scope = "original_first_use_development_and_observed_final_events_once_per_variant"
    time_scope = "conditional_on_all_four_original_confirmations_within_the_common_horizon"
    if any("activation_discovery_cost_scope" in item for item in discovery_scopes):
        discovery["activation_discovery_scope_by_variant"] = discovery_scopes
        if any(item.get("activation_discovery_cost_scope") != "original_paid_discovery_through_first_programmed_look"
               for item in discovery_scopes):
            cost_scope = "original_observed_events_discovery_cost_coverage_incomplete"
        if any(item.get("development_horizon_scope") != "original_observed_horizon_discovery_cost_bound"
               for item in discovery_scopes):
            time_scope = "original_observed_confirmations_at_common_horizon_discovery_coverage_unestablished"
    return {"schema": FIXED_STAGE_PORTABILITY_SCHEMA, "plan_sha256": expected_plan_sha256, **discovery,
        "inputs_sha256": expected_inputs_sha256, "semantic_design_sha256": plan.semantic_design_sha256,
        "evidence_scope": inputs[0].paired_plan.evidence_scope, "selected_teacher_condition": plan.teacher_condition,
        "teacher_evidence_scope": None if plan.teacher_condition is None else "registration_and_independent_owner_attestation",
        "comparisons": comparisons, "paired_panels": tuple({"variant": label, "report_sha256": commitment(report),
                                                               "report": report} for label, (_, report) in results.items()),
        "physical_work_by_variant_ns": tuple((label, report["observed_combined_physical_work_ns"])
                                              for label, (_, report) in results.items()),
        "observed_combined_physical_work_ns": _physical_work_ns(events),
        "cost_scope": cost_scope, "time_scope": time_scope}


TEACHER_PILOT_PLAN_SCHEMA = "reviewed-one-seed-teacher-pilot-plan/v1"
TEACHER_PILOT_PREPARATION_SCHEMA = "reviewed-one-seed-teacher-pilot-preparation/v1"


@dataclass(frozen=True)
class TeacherPilotPlan:
    study_sha256: str
    contrast_plan_sha256: str
    arming_panel_sha256: str
    development_design_sha256: str
    step_grid_sha256: str
    packet_sha256s: tuple[str, ...]  # Native teacher order.
    shared_supervised_teacher: str


def teacher_pilot_plan_commitment(plan):
    _require(type(plan) is TeacherPilotPlan and all(_pin(value) for value in (
        plan.study_sha256, plan.contrast_plan_sha256, plan.arming_panel_sha256,
        plan.development_design_sha256, plan.step_grid_sha256))
        and type(plan.packet_sha256s) is tuple and len(plan.packet_sha256s) == len(MATRIX_TEACHERS)
        and all(_pin(pin) for pin in plan.packet_sha256s)
        and len(set(plan.packet_sha256s)) == len(plan.packet_sha256s)
        and type(plan.shared_supervised_teacher) is str
        and plan.shared_supervised_teacher in dict(MATRIX_TEACHERS),
        "exact selected one-seed pilot plan, original packets and supervised choice required")
    return commitment((TEACHER_PILOT_PLAN_SCHEMA, plan))


def _pilot_job_scope(arming, arm, raw):
    job = arming.trial._evidence_json(raw, 1024**2)
    for name in ("job_id", "run_id", "output_directory"):
        _require(job.pop(name, None) == getattr(arm, name),
                 "job bytes do not name the original prepared job, run and output")
    return job


def _pilot_development_aliases(study, design, aliases, population):
    _require(type(aliases) is tuple and len(aliases) == len(study.panel)
             and all(type(pair) is tuple and len(pair) == 2 and all(_name(key) for key in pair) for pair in aliases)
             and tuple(row for row, _ in aliases) == tuple(row[0] for row in study.panel)
             and len({sample for _, sample in aliases}) == len(aliases)
             and commitment(aliases) == design.case_aliases_sha256,
             "exact registered development aliases are required")
    _pilot_partition_groups(study.panel, aliases, population, "development")


def _pilot_partition_groups(panel, aliases, population, partition):
    members = {row.row_id: row for row in population}
    _require(all(sample in members and members[sample].partition == partition for _, sample in aliases),
             f"{partition} aliases must select frozen {partition} cases")
    frozen = {}
    for member in population:
        frozen.setdefault(member.dependency_group, set()).add(member.row_id)
    grouped = {}
    for (_, group, _), (_, sample) in zip(panel, aliases, strict=True):
        grouped.setdefault(group, set()).add(sample)
    _require(all(samples == frozen[members[next(iter(samples))].dependency_group] for samples in grouped.values()),
             f"{partition} aliases must preserve complete frozen dependency groups")


def _pilot_panel(arming, panel, plan, study, design, development_aliases):
    from .relational_sources import training_cohort_commitment

    _require(type(panel) is arming.StudentPanel
             and arming.panel_commitment(panel.selections) == plan.arming_panel_sha256,
             "exact selected teacher input panel required")
    choice, teacher = panel.selections[0]
    origin = panel.origin_proof
    _, native_seed, cohort = design.seed_cohorts[0]
    _require(type(origin) is dict and type(panel.parent_raw) is bytes
             and len(panel.parent_raw) <= 2 * 1024**2
             and sha256(panel.parent_raw).hexdigest() == choice.parent_sha256
             and commitment(origin) == choice.origin_proof_sha256
             and (origin.get("study_sha256"), origin.get("parent_sha256"), origin.get("job_seed"))
                 == (plan.study_sha256, choice.parent_sha256, native_seed)
             and commitment(panel.configuration) == choice.configuration_sha256
             and commitment(panel.job_inputs) == choice.job_inputs_sha256,
             "pilot inputs differ from the selected student, pristine origin or job controls")
    parent = arming.trial._evidence_json(panel.parent_raw, 2 * 1024**2)
    _require(type(parent.get("seed")) is int and parent["seed"] == native_seed,
             "pilot parent does not bind the selected native seed")
    prepared_sha = origin.get("prepared_inputs_sha256")
    _require(training_cohort_commitment(panel.prepared, origin, teacher.population,
                 expected_prepared_sha256=prepared_sha,
                 expected_origin_proof_sha256=choice.origin_proof_sha256) == cohort,
             "pilot design must identify the actual prepared TRAIN cohort")
    receipt = panel.prepared["receipt"]
    _require(receipt.get("split_manifest_sha256") == design.global_split_sha256
             and arming.population_commit(teacher.population, maximum_rows=4096) == design.population_sha256
             and sum(row.partition == "final" for row in teacher.population) == design.reserved_final_count,
             "pilot design must retain the exact split, population and final reservation")
    _pilot_development_aliases(study, design, development_aliases, teacher.population)
    profile = arming._student_profile(panel.configuration)
    evidence_kind = "fictional_fixture" if receipt["fixture_only"] else "native_reviewed"
    return parent, profile, prepared_sha, evidence_kind


def _pilot_selected_rows(arming, *, plan, study, design, step_grid, panel, inputs, packets):
    names = tuple(name for name, _ in study.arms)
    baseline, *instrumented = names
    recipes = dict(study.arms)
    seed, native_seed, cohort = design.seed_cohorts[0]
    parent, student_profile, prepared_sha, evidence_kind = inputs
    selected = {}
    unselected = []
    teacher_records = []
    all_attempts = set()
    baseline_scope = None
    for index, ((choice, teacher), packet) in enumerate(zip(panel.selections, packets, strict=True)):
        packet_pin = plan.packet_sha256s[index]
        _require(arming.packet_commitment(packet) == packet_pin
                 and packet.arming_sha256 == arming.arming_commitment(choice)
                 and packet.arms == choice.arms,
                 "teacher pilot must retain its exact original prepared packet")
        job_scope = _pilot_job_scope(arming, packet.arms[0], packet.specs[0])
        native_scope = asdict(packet.trials[0])
        native_scope.pop("attempt_sha256")
        native_scope.pop("job_sha256")
        supervised_scope = commitment((native_scope, job_scope))
        _require(baseline_scope is None or supervised_scope == baseline_scope,
                 "shared supervised execution requires identical supervised computation across packets")
        baseline_scope = supervised_scope
        _require(commitment({name: job_scope.get(name) for name in arming.JOB_INPUTS})
                     == choice.job_inputs_sha256,
                 "prepared job inputs differ from the selected panel controls")
        batches = arming._prepared_batches(parent, panel.origin_proof, panel.prepared,
                                           panel.configuration, teacher, student_profile)
        budgets = parent["token_budgets"]
        numerical_controls = {"seed": native_seed, "batch_size": parent["batch_size"],
                              "max_source_tokens": budgets["max_source_tokens"],
                              "max_target_tokens": budgets["max_target_tokens"]}
        _require(commitment({name: job_scope.get(name) for name in numerical_controls})
                     == commitment(numerical_controls)
                 and type(job_scope.get("max_steps")) is int
                 and step_grid.steps[-1][1] <= len(batches) == job_scope["max_steps"]
                 and job_scope.get("allow_fictional_fixture") is (evidence_kind == "fictional_fixture"),
                 "pilot checkpoint grid and evidence class must match the actual prepared training budget")
        _require(packet.trials[1].batches == batches,
                 "instrumented trials must retain the exact named teacher vectors and source pairs")
        teacher_record = {"teacher": teacher.name, "width": dict(MATRIX_TEACHERS)[teacher.name],
            "packet_sha256": packet_pin,
            "teacher_evidence": {"profile_sha256": teacher.profile_sha256,
                "teacher_sha256": choice.teacher_sha256, "owner_close_sha256": teacher.vector_owner_close_sha256}}
        teacher_records.append(teacher_record)
        for alias, native, arm, entry, raw in zip((baseline, *instrumented[index*2:index*2+2]),
                MATRIX_ARMS, packet.arms, packet.trials, packet.specs, strict=True):
            _require((entry.study_sha256, entry.seed, entry.arm, entry.arm_recipe_sha256)
                         == (plan.study_sha256, native_seed, native, recipes[alias])
                     and (entry.parent_manifest_sha256, entry.prepared_inputs_sha256,
                          entry.configuration_sha256, entry.owner_supplement_sha256)
                         == (choice.parent_sha256, prepared_sha, choice.configuration_sha256,
                             choice.owner_supplement_sha256)
                     and (entry.base_model_sha256, entry.base_optimizer_sha256)
                         == (parent["model_state"]["sha256"], parent["optimizer_state"]["sha256"])
                     and commitment(_pilot_job_scope(arming, arm, raw)) == commitment(job_scope)
                     and entry.attempt_sha256 not in all_attempts,
                     "pilot attempt, study seed and recipe must come from the exact native trial")
            all_attempts.add(entry.attempt_sha256)
            record = {"packet_sha256": packet_pin, "seed": seed, "native_seed": native_seed, "native_arm": native,
                "recipe_sha256": entry.arm_recipe_sha256, "job_sha256": entry.job_sha256,
                "attempt_sha256": entry.attempt_sha256, "trial_sha256": arming.trial.commitment(entry),
                "prepared_inputs_sha256": entry.prepared_inputs_sha256,
                "configuration_sha256": entry.configuration_sha256,
                "parent_manifest_sha256": entry.parent_manifest_sha256}
            if native == "supervised":
                record["source_packet_teacher"] = teacher.name
                if teacher.name != plan.shared_supervised_teacher:
                    unselected.append(record)
                    continue
            else:
                record.update(teacher_record)
            selected[alias] = {**record, "arm": alias}
    _require(set(selected) == set(names) and len(unselected) == 3,
             "one exact supervised and eight teacher-specific attempts required")
    return {"selected_attempts": tuple(selected[name] for name in names),
            "unselected_supervised_trials": tuple(unselected), "teachers": tuple(teacher_records),
            "native_seed": native_seed, "seed_label": seed, "training_cohort_sha256": cohort,
            "student_profile": student_profile, "evidence_kind": evidence_kind}


def prepare_teacher_pilot(validator, arming, *, plan, expected_plan_sha256, study, design, step_grid,
                          contrasts, panel, packets, development_aliases, verify_preparation_owner):
    """Select an original nine-attempt roster from four already prepared packets.

    The independent owner verifies the packet authority, original TRAIN and review
    design, and prospective selection before any omitted control is dispatched.
    This route records identities and confers no launch or resource authority.
    """
    _require(callable(verify_preparation_owner) and _pin(expected_plan_sha256)
             and teacher_pilot_plan_commitment(plan) == expected_plan_sha256
             and tuple(arming.TEACHER_WIDTHS.items()) == MATRIX_TEACHERS
             and tuple(arming.trial.ARMS) == MATRIX_ARMS
             and type(packets) is tuple and len(packets) == len(MATRIX_TEACHERS),
             "explicit teacher pilot selection and original arming owners required")
    _study(validator, study, plan.study_sha256)
    _require(len(study.seeds) == 1 and len(study.arms) == 1 + 2*len(MATRIX_TEACHERS)
             and study.stop_after_confirmation is False
             and development_design_commitment(design) == plan.development_design_sha256
             and design.study_sha256 == plan.study_sha256
             and len(design.seed_cohorts) == 1 and design.seed_cohorts[0][0] == study.seeds[0].identifier,
             "one seed, common development design and exact shared-baseline arm order required")
    _selected_development_grid(study, plan.study_sha256, plan.development_design_sha256, step_grid,
                               plan.step_grid_sha256)
    baseline, *others = (name for name, _ in study.arms)
    teacher_pairs = set(zip(others[::2], others[1::2], strict=True))
    allowed = teacher_pairs | {(baseline, tap) for tap in others[::2]}
    selected = _selected_contrasts(study, plan.study_sha256, contrasts, plan.contrast_plan_sha256)
    directions = {(row["baseline"], row["candidate"]): row["role"] for row in selected}
    _require(teacher_pairs <= directions.keys() <= allowed
             and all(role == ("primary" if pair in teacher_pairs else "exploratory")
                     for pair, role in directions.items()),
             "each teacher must compare its own tap to relational arm with optional supervised overhead")

    def verify_packet_scope():
        _require(teacher_pilot_plan_commitment(plan) == expected_plan_sha256
                 and commitment(study) == plan.study_sha256 and commitment(contrasts) == plan.contrast_plan_sha256
                 and development_design_commitment(design) == plan.development_design_sha256
                 and development_step_grid_commitment(step_grid) == plan.step_grid_sha256
                 and tuple(arming.packet_commitment(packet) for packet in packets) == plan.packet_sha256s,
                 "selected teacher pilot scope changed or differs from its original packet commitments")
        return _pilot_panel(arming, panel, plan, study, design, development_aliases)

    inputs = verify_packet_scope()
    computed = _pilot_selected_rows(arming, plan=plan, study=study, design=design, step_grid=step_grid,
                                    panel=panel, inputs=inputs, packets=packets)
    report = {"schema": TEACHER_PILOT_PREPARATION_SCHEMA, "plan_sha256": expected_plan_sha256,
        "study_sha256": plan.study_sha256, "contrast_plan_sha256": plan.contrast_plan_sha256,
        "development_design_sha256": plan.development_design_sha256, "step_grid_sha256": plan.step_grid_sha256,
        "arming_panel_sha256": plan.arming_panel_sha256, "shared_supervised_teacher": plan.shared_supervised_teacher,
        "dispatch_authority": False, **computed}
    _require(verify_preparation_owner(expected_plan_sha256, commitment(report)) is True,
             "independent owner refused the prospective original teacher pilot selection")
    verify_packet_scope()
    return report


def _pilot_capture_scope(preparation, roster, study, design, attempts):
    """Bind the approved pilot to its exact existing packet capture policies."""
    packets = selected_teacher_pilot_packets(preparation)
    teachers = preparation["teachers"]
    rows = preparation.get("selected_attempts")
    reserved = preparation.get("unselected_supervised_trials")
    source_teacher = preparation.get("shared_supervised_teacher")
    _require(preparation.get("dispatch_authority") is False and _pin(preparation.get("plan_sha256"))
             and _pin(preparation.get("arming_panel_sha256"))
             and preparation.get("evidence_kind") in ("fictional_fixture", "native_reviewed")
             and preparation.get("step_grid_sha256") == roster.step_grid_sha256
             and type(preparation.get("native_seed")) is int
             and design.seed_cohorts == ((preparation.get("seed_label"), preparation["native_seed"],
                                          preparation.get("training_cohort_sha256")),)
             and len(study.seeds) == 1 and len(attempts) == len(study.arms) == 9
             and type(source_teacher) is str and source_teacher in dict(MATRIX_TEACHERS)
             and type(rows) in (list, tuple) and len(rows) == len(attempts)
             and type(reserved) in (list, tuple) and len(reserved) == 3
             and all(type(row) is dict for row in (*rows, *reserved)),
             "exact prospective nine-attempt teacher pilot, seed, grid and reserved controls required")
    policies = {packet: (capture, resource) for packet, capture, resource in roster.packets}
    by_teacher = {row["teacher"]: row for row in teachers}
    _require(set(policies) == set(packets) and len({capture for capture, _ in policies.values()}) == len(packets),
             "pilot capture roster must bind one exact plan per original teacher packet")

    all_rows = (*rows, *reserved)
    for key in ("attempt_sha256", "trial_sha256", "job_sha256"):
        _require(all(_pin(row.get(key)) for row in all_rows)
                 and len({row[key] for row in all_rows}) == len(all_rows),
                 "pilot must retain twelve distinct original jobs including its three reserved controls")
    for key in ("configuration_sha256", "prepared_inputs_sha256", "parent_manifest_sha256"):
        _require(_pin(rows[0].get(key)) and all(row.get(key) == rows[0][key] for row in all_rows),
                 "selected and reserved pilot jobs must retain the original common preparation")
    roster_scope = preparation["seed_label"], preparation["native_seed"]
    _require(all(type(row.get("native_seed")) is int
                 and (row.get("seed"), row["native_seed"]) == roster_scope for row in all_rows),
             "all pilot jobs must retain the exact analytical and native seed")

    baseline = rows[0]
    alternatives = tuple(name for name, _ in MATRIX_TEACHERS if name != source_teacher)
    for row, teacher in zip((baseline, *reserved), (source_teacher, *alternatives), strict=True):
        _require(row.get("native_arm") == "supervised" and row.get("source_packet_teacher") == teacher
                 and row.get("packet_sha256") == by_teacher[teacher]["packet_sha256"]
                 and row.get("recipe_sha256") == study.arms[0][1]
                 and "teacher_evidence" not in row and "teacher" not in row,
                 "shared and reserved supervised controls cannot claim a teacher producer")
    for row, (record, native) in zip(rows[1:], ((record, native) for record in teachers
                                                 for native in MATRIX_ARMS[1:]), strict=True):
        _require(row.get("native_arm") == native
                 and all(row.get(key) == record[key] for key in ("teacher", "width", "packet_sha256", "teacher_evidence")),
                 "each pilot teacher must retain its original tap-only and relational consumers")

    scope = {}
    for attempt, row in zip(attempts, rows, strict=True):
        _require(tuple(row.get(key) for key in ("arm", "seed", "recipe_sha256", "attempt_sha256"))
                     == (attempt.arm, attempt.seed, attempt.recipe_sha256, attempt.attempt_sha256),
                 "paid pilot attempt differs from the selected original job")
        scope[attempt.attempt_sha256] = row, policies[row["packet_sha256"]]
    _require(all(_pin(attempt.closeout_receipt_sha256) for attempt in attempts)
             and len({attempt.closeout_receipt_sha256 for attempt in attempts}) == len(attempts),
             "each selected pilot attempt needs its own terminal evidence, including zero-look failures")
    return scope


TEACHER_PILOT_FINAL_PLAN_SCHEMA = "reviewed-teacher-pilot-final-plans/v1"
TEACHER_PILOT_FINAL_EVIDENCE_SCHEMA = "reviewed-teacher-pilot-final-evidence/v1"
TEACHER_PILOT_FINAL_SCHEMA = "reviewed-teacher-pilot-final-panel/v1"


def teacher_pilot_final_plan_commitment(validator, plans):
    _require(type(plans) is tuple and len(plans) == len(MATRIX_TEACHERS)
             and all(type(plan) is PairedFinalPlan and plan.sampling is None for plan in plans),
             "four prospective finite-panel pilot contrasts required")
    pins = tuple(paired_final_plan_commitment(validator, plan) for plan in plans)
    scopes = tuple({key: value for key, value in asdict(plan).items() if key != "contrast_id"} for plan in plans)
    _require(all(scope == scopes[0] for scope in scopes) and len({plan.contrast_id for plan in plans}) == len(plans),
             "pilot final plans must share one reserved panel, clock, policy and retention reference")
    return commitment((TEACHER_PILOT_FINAL_PLAN_SCHEMA, pins))


def teacher_pilot_final_evidence_commitment(plan_sha256, comparison_sha256, cells):
    _require(_pin(plan_sha256) and _pin(comparison_sha256) and type(cells) is tuple
             and len(cells) == 2 * len(MATRIX_TEACHERS)
             and all(type(cell) is PairedFinalCell and _name(cell.seed) and _name(cell.arm) for cell in cells)
             and len({(cell.seed, cell.arm) for cell in cells}) == len(cells),
             "exact eight final pilot evidence slots required")
    return commitment((TEACHER_PILOT_FINAL_EVIDENCE_SCHEMA, plan_sha256, comparison_sha256, cells))


def _pilot_final_slots(validator, arming, plans, preparation, study, design, population, comparison):
    plan = plans[0]
    study_sha = commitment(study)
    _, horizons, _ = _study(validator, study, study_sha)
    _require(len(study.seeds) == 1 and len(study.arms) == 1 + 2 * len(plans)
             and plan.clock != "wall_seconds" and horizons[plan.clock] is not None
             and development_design_commitment(design) == preparation.get("development_design_sha256")
             and design.study_sha256 == study_sha and preparation.get("study_sha256") == study_sha
             and tuple(seed for seed, _, _ in plan.retention_references) == (study.seeds[0].identifier,)
             and preparation.get("dispatch_authority") is False
             and preparation.get("evidence_kind") in ("fictional_fixture", "native_reviewed"),
             "exact one-seed pilot and selected additive development clock required")
    _require(arming.population_commit(population, maximum_rows=4096) == design.population_sha256
             and len(plan.panel) == design.reserved_final_count
             and {sample for _, sample in plan.case_aliases}
                 == {row.row_id for row in population if row.partition == "final"},
             "pilot final aliases must exhaust the original reserved holdout population")
    _pilot_partition_groups(plan.panel, plan.case_aliases, population, "final")
    approval = _capture_approval_metadata(comparison)
    _require(approval.get("capture_matrix_sha256") == plan.matrix_sha256
             and _pin(approval.get("teacher_cost_roster_sha256"))
             and all(comparison.get(key) == preparation.get(key) for key in (
                 "study_sha256", "development_design_sha256", "contrast_plan_sha256", "evidence_kind"))
             and comparison.get("teacher_pilot_preparation_sha256") == plan.matrix_sha256
             and comparison.get("optimizer_step_grid_sha256") == preparation.get("step_grid_sha256")
             and comparison.get("cost_basis") == study.cost_basis == "amortized"
             and comparison.get("reuse_count") == study.reuse_count == 2,
             "paid development must retain the exact pilot preparation, capture and teacher cost roster")
    original, measured = (preparation.get("selected_attempts"), comparison.get("attempts"))
    fields = ("arm", "seed", "attempt_sha256")
    _require(all(type(rows) in (list, tuple) and len(rows) == len(study.arms)
                 and all(type(row) is dict and _pin(row.get("attempt_sha256")) for row in rows)
                 for rows in (original, measured))
             and len({row["attempt_sha256"] for row in original}) == len(original)
             and tuple(tuple(row.get(key) for key in fields) for row in original)
                 == tuple(tuple(row.get(key) for key in fields) for row in measured)
             and tuple(row["arm"] for row in original) == tuple(arm for arm, _ in study.arms),
             "final pilot must retain all nine original paid development attempts")

    slots = []
    seed = study.seeds[0].identifier
    source_pairs = zip(original[1::2], original[2::2], strict=True)
    for selected, (before, after), (teacher, width) in zip(plans, source_pairs, MATRIX_TEACHERS, strict=True):
        _require(all(row.get("teacher") == teacher and row.get("width") == width and row.get("seed") == seed
                     and row.get("native_seed") == preparation.get("native_seed") for row in (before, after))
                 and before.get("native_arm") == "tap_only" and after.get("native_arm") == "relational"
                 and before.get("packet_sha256") == after.get("packet_sha256"),
                 "each final pilot contrast must use its own original teacher and ordered native arms")
        registered = _one_final_row(comparison.get("contrasts"),
            lambda row: row.get("identifier") == selected.contrast_id,
            "one original preregistered contrast required per pilot pair")
        pair = _one_final_row(comparison.get("pairs"),
            lambda row: (row.get("contrast_id"), row.get("clock")) == (selected.contrast_id, selected.clock),
            "one original paid development observation required at the selected clock")
        _require((registered.get("baseline"), registered.get("candidate"), registered.get("role"))
                     == (before["arm"], after["arm"], "primary")
                 and (pair.get("baseline"), pair.get("candidate"), pair.get("role"), pair.get("seed"), pair.get("horizon"))
                     == (before["arm"], after["arm"], "primary", seed, horizons[selected.clock]),
                 "final pilot must use the original primary contrast and paid horizon")
        for role, row in (("baseline", before), ("candidate", after)):
            state, reason = pair.get(role + "_attained"), pair.get(role + "_reason")
            _require(row["attempt_sha256"] == pair.get(role + "_attempt_sha256")
                     and (state is None or type(state) is int and state in (0, 1)) and _name(reason),
                     "pilot final eligibility must retain the original paid development disposition")
            slots.append((seed, row["arm"], row, state, reason))
    return tuple(slots)


def _pilot_paid_final_union(cells, comparison, baseline):
    """Count each validated physical final event once across the pilot."""
    baseline_checkpoint, baseline_reference = baseline[1:]
    prior = {row[key] for row in comparison["physical_paid_events"] for key in ("event_sha256", "close_receipt_sha256")}
    prior.update(row[key] for row in comparison["attempts"] for key in ("attempt_sha256", "closeout_receipt_sha256"))
    for row in comparison["development_looks"]:
        prior.update(row[key] for key in ("owner_close_sha256", "trial_terminal_close_sha256"))
        checkpoint = _scheduled_checkpoint_metadata(row)
        if checkpoint is not None:
            prior.update(checkpoint[key] for key in ("checkpoint_close_sha256", "owner_stage_record_sha256"))

    identifiers, events, recorded_activities = {}, {}, {}
    shared_baseline = None
    for cell in cells:
        resources = cell.final_resources
        if resources is None:
            continue
        original_events = resources.get("physical_paid_events")
        _require(type(original_events) in (tuple, list) and all(type(row) is dict
                     and set(row) == set(PaidEvent.__dataclass_fields__) for row in original_events),
                 "exact original paid final event roster required")
        local_events = _event_roster(tuple(PaidEvent(**row) for row in original_events))
        unassigned = set(local_events)
        activities = resources["activities"]
        _require(1 <= len(activities) <= 2 and all(type(row.get("activity")) is dict
                     and row["activity"].get("role") in ("candidate", "baseline") for row in activities)
                 and len({row["activity"]["role"] for row in activities}) == len(activities)
                 and resources.get("retention_reference_sha256") in (None, baseline_reference),
                 "each final resource scope needs only its own candidate and selected retention baseline")
        for row in activities:
            activity = row["activity"]
            evaluation = activity.get("evaluation_sha256")
            charges = row.get("charged_events")
            entries = charges.get("entries") if type(charges) is dict else None
            _require(_pin(evaluation) and type(entries) in (tuple, list) and bool(entries)
                     and all(type(item) in (tuple, list) and len(item) == 2 and _pin(item[0])
                         and item[0] in unassigned and commitment(item[1]) == commitment((1, 1)) for item in entries),
                     "pilot final activities must own their original exclusive physical events")
            event_ids = tuple(event_id for event_id, _ in entries)
            _require(len(set(event_ids)) == len(event_ids), "one charge per original final event required")
            unassigned.difference_update(event_ids)
            component_closes = row.get("component_owner_close_sha256s")
            meter = row.get("meter")
            _require(type(component_closes) in (tuple, list) and all(_pin(pin) for pin in component_closes)
                     and _pin(row.get("terminal_close_sha256")) and type(meter) is dict
                     and charges.get("attempt_sha256") == evaluation and charges.get("stage") == "close",
                     "original final component closures and activity meter required")
            closes = (row.get("terminal_close_sha256"), *component_closes)
            scope_ids = {evaluation, *closes, *event_ids,
                         *(local_events[event].close_receipt_sha256 for event in event_ids)}
            _require(len(set(closes)) == len(closes) and not scope_ids.intersection(prior)
                     and len({local_events[event].close_receipt_sha256 for event in event_ids}) == len(event_ids)
                     and all(identifiers.setdefault(pin, evaluation) == evaluation for pin in scope_ids),
                     "each final paid event and close must retain one original activity and stay separate from development")
            signature = commitment((activity, row.get("status"), closes, row.get("baseline_receipt_sha256"),
                                    row.get("wall"), meter.get("costs"), meter.get("clock_receipts"),
                                    tuple(local_events[event] for event in event_ids)))
            if activity["role"] == "baseline":
                _require(_pin(baseline_checkpoint) and activity.get("checkpoint_sha256") == baseline_checkpoint
                         and (shared_baseline is None or shared_baseline == (evaluation, signature)),
                         "only one exact preselected physical retention baseline may be shared across pilot slots")
                shared_baseline = evaluation, signature
            else:
                _require(evaluation == cell.final_decision["final_evaluation_sha256"]
                         and evaluation not in recorded_activities,
                         "one candidate evaluation cannot fill two final pilot slots")
            _require(recorded_activities.setdefault(evaluation, signature) == signature
                     and all(events.setdefault(key, local_events[key]) == local_events[key] for key in event_ids),
                     "a repeated baseline must retain the same original activity and paid-event evidence")
        _require(not unassigned, "paid final result must account for every original physical event")
    return {"physical_paid_events": tuple(_wire(events[key]) for key in sorted(events)),
            "physical_work_ns": _physical_work_ns(events), "observed_final_activities": len(recorded_activities),
            "shared_retention_baseline_evaluation_sha256": None if shared_baseline is None else shared_baseline[0]}


def assemble_teacher_pilot_final(validator, arming, *, plans, expected_plan_sha256, preparation, study, design,
                                 population, comparison, expected_comparison_sha256, cells, expected_evidence_sha256,
                                 verify_checkpoint_owner, verify_pilot_final_owner):
    """Report all four original pilot contrasts on the one reserved final panel.

    The final owner authenticates prospective plan selection, all existing
    checkpoint, scoring and resource closes, the complete paid-event scope
    and cross-slot reuse of the same physical retention baseline. It resolves
    physical process identities and exclusive counters across scopes, even
    when distinct receipts could refer to the same process.
    """
    def check_inputs():
        _require(callable(verify_checkpoint_owner) and callable(verify_pilot_final_owner)
                 and teacher_pilot_final_plan_commitment(validator, plans) == expected_plan_sha256
                 and type(preparation) is dict and preparation.get("schema") == TEACHER_PILOT_PREPARATION_SCHEMA
                 and commitment(preparation) == plans[0].matrix_sha256
                 and type(comparison) is dict and comparison.get("schema") == VERIFIED_DEVELOPMENT_SCHEMA
                 and commitment(comparison) == expected_comparison_sha256
                 and teacher_pilot_final_evidence_commitment(
                     expected_plan_sha256, expected_comparison_sha256, cells) == expected_evidence_sha256,
                 "exact original paid pilot, prospective final plan and eight evidence slots required")
        return _pilot_final_slots(validator, arming, plans, preparation, study, design, population, comparison)

    slots = check_inputs()
    selected_slots, selected_cells, selected_comparison, selected_plans, selected_study, selected_design = deepcopy(
        (slots, cells, comparison, plans, study, design))
    common = selected_plans[0]
    evidence_kind = preparation["evidence_kind"]
    baseline = common.retention_references[0]
    reports = []
    for index, (plan, (teacher, width)) in enumerate(zip(selected_plans, MATRIX_TEACHERS, strict=True)):
        results, findings = [], []
        start = 2 * index
        for cell, slot in zip(selected_cells[start:start + 2], selected_slots[start:start + 2], strict=True):
            result, observed = _paired_cell(validator, plan, cell, slot, study=selected_study, design=selected_design,
                comparison=selected_comparison, comparison_sha=expected_comparison_sha256,
                verify_checkpoint_owner=verify_checkpoint_owner, evidence_kind=evidence_kind,
                expected_baseline=baseline[1], expected_retention_reference=baseline[2])
            results.append(result)
            findings.append(observed)
        reports.append({"teacher": teacher, "width": width, "contrast_id": plan.contrast_id,
                        "cells": tuple(results), "fidelity": _paired_group_bounds(plan, (baseline[0],), findings)})
    paid = _pilot_paid_final_union(selected_cells, selected_comparison, baseline)
    _require(verify_pilot_final_owner(expected_plan_sha256, expected_evidence_sha256, expected_comparison_sha256) is True,
             "independent owner refused the complete pilot final selection and resource scope")
    check_inputs()
    return {"schema": TEACHER_PILOT_FINAL_SCHEMA, "evidence_kind": evidence_kind,
            "teacher_pilot_preparation_sha256": common.matrix_sha256,
            "development_comparison_sha256": expected_comparison_sha256,
            "teacher_pilot_final_plan_sha256": expected_plan_sha256,
            "teacher_pilot_final_evidence_sha256": expected_evidence_sha256,
            "eligible_clock": common.clock, "final_policy_sha256": common.final_policy_sha256,
            "final_panel_sha256": commitment(common.panel), "final_case_aliases_sha256": commitment(common.case_aliases),
            "contrasts": tuple(reports), "seed_count": 1,
            "final_cost_scope": "observed_distinct_physical_final_events_only", **paid}


JOINT_CREDIT_EDIT_PLAN_SCHEMA = "reviewed-joint-credit-edit-lineage-plan/v1"
JOINT_CREDIT_EDIT_EVIDENCE_SCHEMA = "reviewed-joint-credit-edit-lineage-evidence/v1"
JOINT_CREDIT_EDIT_RESULT_SCHEMA = "reviewed-joint-credit-edit-lineage/v1"
_JOINT_CREDIT_BRANCHES = ("broadcast", "structured")


@dataclass(frozen=True)
class JointCreditSeed:
    seed: str
    start_checkpoint_sha256: str
    behavior_tape_sha256: str


@dataclass(frozen=True)
class JointCreditEditPlan:
    seeds: tuple[JointCreditSeed, ...]
    architecture_sha256: str
    codec_sha256: str
    reward_sha256: str
    credit_profiles: tuple[str, str]
    guide_rule_sha256: str
    final_reservation_sha256: str
    source_crosswalk_sha256: str


@dataclass(frozen=True)
class JointCreditCheckpoint:
    checkpoint_sha256: str
    compact_preimage_sha256: str


@dataclass(frozen=True)
class JointCreditClose:
    start_checkpoint_sha256: str
    behavior_tape_sha256: str
    reward_sha256: str
    credit_profile_sha256: str
    original_attempt_sha256: str
    original_close_sha256: str
    checkpoint: JointCreditCheckpoint | None


@dataclass(frozen=True)
class JointEditArchive:
    readback: dict
    gate_report: dict
    numerical_report: dict
    guide_execution_sha256: str


@dataclass(frozen=True)
class JointCreditEditBranch:
    seed: str
    credit: str
    train: JointCreditClose | None
    edit: JointEditArchive | None = None


def joint_credit_edit_plan_commitment(plan):
    _require(type(plan) is JointCreditEditPlan
             and type(plan.seeds) is tuple and len(plan.seeds) >= 2
             and all(type(row) is JointCreditSeed and _name(row.seed)
                     and _pin(row.start_checkpoint_sha256) and _pin(row.behavior_tape_sha256) for row in plan.seeds)
             and len({row.seed for row in plan.seeds}) == len(plan.seeds)
             and type(plan.credit_profiles) is tuple and len(plan.credit_profiles) == 2
             and all(_pin(pin) for pin in (*plan.credit_profiles, plan.architecture_sha256, plan.codec_sha256,
                 plan.reward_sha256, plan.guide_rule_sha256, plan.final_reservation_sha256, plan.source_crosswalk_sha256))
             and plan.credit_profiles[0] != plan.credit_profiles[1],
             "preselected common replay, distinct credit policies and opaque FINAL scope required")
    return commitment((JOINT_CREDIT_EDIT_PLAN_SCHEMA, plan))


def joint_credit_edit_evidence_commitment(plan_sha256, branches):
    _require(_pin(plan_sha256) and type(branches) is tuple
             and all(type(row) is JointCreditEditBranch and _name(row.seed) and row.credit in _JOINT_CREDIT_BRANCHES
                     and (row.train is None or type(row.train) is JointCreditClose)
                     and (row.edit is None or type(row.edit) is JointEditArchive) for row in branches),
             "original ordered credit closes and edit archive slots required")
    return commitment((JOINT_CREDIT_EDIT_EVIDENCE_SCHEMA, plan_sha256, branches))


def _joint_credit_edit_branch_bindings(plan, seeds, branches):
    expected = tuple((seed.seed, credit) for seed in seeds for credit in _JOINT_CREDIT_BRANCHES)
    _require(tuple((row.seed, row.credit) for row in branches) == expected,
             "every seed requires its ordered broadcast and structured branches")
    original_ids = set()
    archive_ids = set()
    checkpoint_ids = set()
    checks = []
    slots = []
    by_seed = {row.seed: row for row in seeds}
    profiles = dict(zip(_JOINT_CREDIT_BRANCHES, plan.credit_profiles, strict=True))
    for row in branches:
        start = by_seed[row.seed]
        train = row.train
        archive = row.edit
        base = None if train is None else train.checkpoint
        f0, f1 = None, None
        status = "credit_unobserved" if train is None else "credit_without_checkpoint"
        if train is not None:
            ids = (train.original_attempt_sha256, train.original_close_sha256)
            _require((train.start_checkpoint_sha256, train.behavior_tape_sha256, train.reward_sha256,
                      train.credit_profile_sha256) == (start.start_checkpoint_sha256, start.behavior_tape_sha256,
                      plan.reward_sha256, profiles[row.credit])
                     and all(_pin(pin) for pin in ids) and ids[0] != ids[1]
                     and original_ids.isdisjoint(ids)
                     and (base is None or type(base) is JointCreditCheckpoint
                          and _pin(base.checkpoint_sha256) and _pin(base.compact_preimage_sha256)),
                     "each credit branch needs its own original close and the same selected start, tape and reward")
            original_ids.update(ids)
            if base is not None:
                f0 = base.checkpoint_sha256
                _require(f0 not in checkpoint_ids,
                         "each credit branch requires its own lineage-bound checkpoint manifest")
                checkpoint_ids.add(f0)
                status = "edit_unobserved"
        edit_pins = None
        if archive is not None:
            readback, gate, numerical = archive.readback, archive.gate_report, archive.numerical_report
            _require(base is not None and all(type(item) is dict for item in (readback, gate, numerical))
                     and (readback.get("parent_sha256"), readback.get("preimage_sha256")) ==
                         (base.checkpoint_sha256, base.compact_preimage_sha256)
                     and (readback.get("architecture_sha256"), readback.get("codec_sha256")) ==
                         (plan.architecture_sha256, plan.codec_sha256)
                     and readback.get("arm") == "programmed",
                     "guided edit must descend from its own authenticated post-credit checkpoint and preimage")
            edit_pins = (*map(commitment, (readback, gate, numerical)), readback.get("joint_affine_readback_sha256"),
                         archive.guide_execution_sha256)
            identities = (*edit_pins, readback.get("training_close_sha256"))
            _require(all(_pin(pin) for pin in identities)
                     and len(set(identities)) == len(identities) and archive_ids.isdisjoint(identities),
                     "each guided branch needs independent archive and guide execution identities")
            archive_ids.update(identities)
            f1 = readback.get("postimage_sha256")
            _require(_pin(f1), "guided branch needs its exact edit postimage")
            status = "identity_edit" if f1 == base.compact_preimage_sha256 else "distinct_edit"
        checks.append((row, edit_pins))
        slots.append(dict(seed=row.seed, credit=row.credit, status=status,
            F0_parent_checkpoint_sha256=f0, F1_compact_postimage_sha256=f1,
            original_credit_close_sha256=None if train is None else train.original_close_sha256,
            archive_readback_sha256=None if edit_pins is None else edit_pins[0]))
    _require(original_ids.isdisjoint(archive_ids) and checkpoint_ids.isdisjoint(original_ids | archive_ids),
             "credit attempts, closes, checkpoint manifests and edit archive identities must be distinct")
    return tuple(checks), tuple(slots)


def verify_joint_credit_edit_lineage(*, plan, expected_plan_sha256, branches, expected_evidence_sha256,
        verify_credit_owner, verify_archive_owner, verify_joint_owner):
    """Bind original credit closes to guided descendants before FINAL access.

    The credit owner authenticates each actual attempt and, when present, the
    mapping from its exact model/optimizer checkpoint to the selected compact
    preimage. The archive owner authenticates existing F archive evidence.
    The joint owner authenticates prospective registration, the common replay
    and outcome-independent guide rule, each guide execution, and explicit
    unobserved slots. FINAL review and paid clocks have their own owners.
    """
    _require(all(callable(callback) for callback in (verify_credit_owner, verify_archive_owner, verify_joint_owner)),
             "existing credit, archive and joint selection verification required")

    selected = None

    def current():
        _require(joint_credit_edit_plan_commitment(plan) == expected_plan_sha256
                 and joint_credit_edit_evidence_commitment(expected_plan_sha256, branches) == expected_evidence_sha256
                 and (selected is None
                      or joint_credit_edit_evidence_commitment(expected_plan_sha256, selected) == expected_evidence_sha256),
                 "selected joint study plan or original branch evidence changed")

    current()
    selected = deepcopy(branches)
    checks, slots = _joint_credit_edit_branch_bindings(plan, plan.seeds, selected)
    for row, edit_pins in checks:
        if row.train is not None:
            # Pass the immutable selected close, not a differently serialized summary.
            _require(verify_credit_owner(expected_plan_sha256, row.seed, row.credit, row.train) is True,
                     "original credit owner refused its selected close or compact projection")
            current()
        if row.edit is not None:
            archive, base = row.edit, row.train.checkpoint
            archive_pin, gate_pin, score_pin, capture_pin, _ = edit_pins
            verify_joint_affine_scheduled_readback(readback=archive.readback, expected_readback_sha256=archive_pin,
                gate_report=archive.gate_report, expected_gate_report_sha256=gate_pin,
                numerical_report=archive.numerical_report, expected_numerical_report_sha256=score_pin,
                expected_joint_affine_readback_sha256=capture_pin, expected_parent_sha256=base.checkpoint_sha256,
                expected_preimage_sha256=base.compact_preimage_sha256, arm="programmed",
                verify_archive_owner=verify_archive_owner)
            current()
    _require(verify_joint_owner(expected_plan_sha256, expected_evidence_sha256) is True,
             "joint selection owner refused the prospective scope or original guide executions")
    current()
    return dict(schema=JOINT_CREDIT_EDIT_RESULT_SCHEMA, plan_sha256=expected_plan_sha256,
                evidence_sha256=expected_evidence_sha256, slots=slots,
                final_reservation_sha256=plan.final_reservation_sha256, source_crosswalk_sha256=plan.source_crosswalk_sha256,
                original_paid_scopes="retained_by_original_owners", final_assessment_performed=False)


JOINT_CREDIT_EDIT_FINAL_SCHEMA = "reviewed-joint-credit-edit-paired-final/v1"


@dataclass(frozen=True)
class JointCreditEditFinalPlan:
    lineage_plan_sha256: str
    lineage_reservation_sha256: str
    common_opaque_final_sha256: str
    paired_plans_sha256: tuple[str, str]  # Broadcast, structured.


@dataclass(frozen=True)
class JointCreditEditFinalInput:
    credit: str
    study: Study
    contrast_plan: ContrastPlan
    development_design: DevelopmentDesign
    reservation: FixedStageFinalReservation
    paired_plan: FixedStageFinalPairPlan
    development_comparison: dict
    cells: tuple[FixedStageFinalPairCell, ...]
    scheduled_readbacks: tuple[FixedStageFinalPairReadback, ...]
    expected_evidence_sha256: str
    expected_scheduled_readbacks_sha256: str


def joint_credit_edit_final_plan_commitment(plan):
    _require(type(plan) is JointCreditEditFinalPlan
             and type(plan.paired_plans_sha256) is tuple and len(plan.paired_plans_sha256) == 2
             and all(_pin(pin) for pin in (plan.lineage_plan_sha256, plan.lineage_reservation_sha256,
                                          plan.common_opaque_final_sha256, *plan.paired_plans_sha256))
             and len(set(plan.paired_plans_sha256)) == 2,
             "exact lineage selection, opaque FINAL scope and two original paired plans required")
    return commitment((JOINT_CREDIT_EDIT_FINAL_SCHEMA, "plan", plan))


def joint_credit_edit_final_evidence_commitment(plan_sha256, lineage_sha256, inputs):
    _require(_pin(plan_sha256) and _pin(lineage_sha256) and type(inputs) is tuple
             and all(type(row) is JointCreditEditFinalInput and type(row.study) is Study
                     and type(row.development_comparison) is dict
                     and all(_pin(pin) for pin in (row.expected_evidence_sha256, row.expected_scheduled_readbacks_sha256))
                     for row in inputs)
             and tuple(row.credit for row in inputs) == _JOINT_CREDIT_BRANCHES,
             "ordered broadcast and structured original paired inputs required")
    return commitment((JOINT_CREDIT_EDIT_FINAL_SCHEMA, "evidence", plan_sha256, lineage_sha256, inputs))


def _joint_credit_edit_final_scope(validator, selected, offered, shared_opaque):
    paired, reserve = offered.paired_plan, offered.reservation
    comparison, design = offered.development_comparison, offered.development_design
    design_pin = development_design_commitment(design)
    seeds = tuple(seed.identifier for seed in offered.study.seeds)
    _require(fixed_stage_final_pair_plan_commitment(validator, paired) == selected
             and fixed_stage_final_reservation_commitment(reserve) == paired.final_reservation_sha256
             and reserve.opaque_final_sha256 == shared_opaque != reserve.global_split_sha256
             and (reserve.global_split_sha256, reserve.population_sha256, reserve.reserved_final_count)
                 == (design.global_split_sha256, design.population_sha256, design.reserved_final_count)
             and reserve.reserved_final_count == len(paired.panel)
             and reserve.final_policy_sha256 == paired.final_policy_sha256
             and comparison.get("schema") == FIXED_STAGE_SUSTAINED_COMPARISON_SCHEMA
             and comparison.get("development_design_sha256") == reserve.development_design_sha256 == design_pin
             and design.study_sha256 == paired.study_sha256
             and tuple(row[0] for row in design.seed_cohorts) == seeds,
             "each branch must supply its original paired plan, reservation and sustained DEVELOPMENT evidence")
    return (seeds, design.seed_cohorts, design.case_aliases_sha256,
            reserve.global_split_sha256, reserve.population_sha256, reserve.access_policy_sha256,
            paired.panel, paired.final_panel_sha256, paired.final_policy_sha256, paired.review_policy_sha256,
            paired.source_crosswalk_sha256, paired.fidelity_eligible, paired.formal_required, paired.cutoffs,
            paired.evidence_scope, paired.clock, offered.study.panel, offered.study.evaluation_policy_sha256,
            offered.study.cost_policy_sha256, offered.study.schedule, offered.study.required_streak,
            offered.study.gates, offered.study.horizons, offered.study.budget_caps, offered.study.cost_basis,
            tuple(seed.gate_denominators for seed in offered.study.seeds))


def _joint_credit_edit_final_rows(offer, verified, seeds, lineage):
    paired = offer.paired_plan
    cells = {(row.seed, row.arm): row for row in offer.cells}
    reports = {(row["seed"], row["arm"]): row for row in verified["cells"]}
    readbacks = {(row.seed, row.arm): row for row in offer.scheduled_readbacks}
    unknown = (None,) * len(paired.fidelity_eligible)
    cohorts = {seed: cohort for seed, _, cohort in offer.development_design.seed_cohorts}
    values, scopes, paired_known = [], [], {}
    for seed in seeds:
        key = (seed, "programmed")
        cell, report = cells[key], reports[key]
        frozen = cell.frozen_checkpoint
        pre, post = unknown, unknown
        slot = lineage[seed, offer.credit]
        if frozen is not None:
            archived = readbacks[key]
            readback = archived.readback
            _require(readback["schema"] == "compact-boundary-scheduled-joint-affine-postimage-readback/v1"
                     and archived.readback_sha256 == slot["archive_readback_sha256"]
                     == frozen["postimage_readback_sha256"]
                     and readback["parent_sha256"] == slot["F0_parent_checkpoint_sha256"]
                     and frozen["candidate_sha256"] == readback["postimage_sha256"] == slot["F1_compact_postimage_sha256"]
                     and frozen["train_cohort_sha256"] == cohorts[seed]
                     and frozen["opaque_final_sha256"] == offer.reservation.opaque_final_sha256
                     and frozen["reservation_owner_close_sha256"] == offer.reservation.owner_close_sha256,
                     "programmed FINAL freeze must be the exact joint edit descended from its own credit checkpoint")
            if cell.retention_reference is not None:
                ref = cell.retention_reference
                _require((ref["parent_sha256"], ref["postimage_sha256"])
                         == (readback["parent_sha256"], readback["preimage_sha256"]),
                         "paid original-parent review must describe this branch's full parent and compact preimage")
                pre = tuple(value for _, value in ref["row_fidelity"])
            if cell.final_review is not None:
                post = tuple(cell.final_review["rows"][row]["source_success"] for row in paired.fidelity_eligible)
        values.extend((pre, post))
        paired_known[seed] = {row for row, a, b in zip(paired.fidelity_eligible, pre, post, strict=True)
                              if a is not None and b is not None}
        scopes.append(dict(seed=seed, credit=offer.credit, lineage_status=slot["status"],
                           F0_source_fidelity_observations=sum(x is not None for x in pre),
                           F1_source_fidelity_observations=sum(x is not None for x in post),
                           F0_original_parent_review_sha256=report["retention_reference_sha256"],
                           F1_candidate_review_sha256=report["final_review_sha256"],
                           F1_gate_counts=report["gate_counts"], F1_gates=report["gates"],
                           original_FINAL_resource_sha256=report["final_resources_sha256"]))
    finite = replace(paired, sampling=None)
    return _paired_group_bounds(finite, seeds, tuple(values)), tuple(scopes), paired_known


def _joint_credit_edit_final_ids(offer, report):
    # Reuse the original checks for attempt, event, interval and owner-close
    # ownership. Keep the original DEVELOPMENT and FINAL ownership scopes.
    owned, _ = _fixed_stage_portability_attempts_and_costs(offer, report)
    prior = _compact_paid_event_roster(offer.development_comparison)
    prior_ids, _ = _fixed_stage_portability_attempts_and_costs(replace(offer, cells=()),
        {"observed_combined_physical_work_ns": _physical_work_ns(prior)})
    supplemental = set()
    for cell in offer.cells:
        if cell.frozen_checkpoint is not None:
            supplemental.update((commitment(cell.frozen_checkpoint),
                                 cell.frozen_checkpoint["archive_owner_close_sha256"]))
        if cell.final_resources is not None:
            supplemental.update((cell.final_resources["final_resource_plan_sha256"],
                                 cell.final_resources["final_resource_evidence_sha256"],
                                 commitment(cell.final_resources)))
        if cell.final_review is not None:
            supplemental.add(commitment(cell.final_review))
            supplemental.update(cell.final_review[key] for key in (
                "plan_sha256", "numerical_report_sha256", "observation_manifest_sha256", "translation_handoffs_sha256"))
        if cell.retention_reference is not None:
            ref = cell.retention_reference
            supplemental.add(commitment(ref))
            supplemental.update(ref["original_parent_evidence"][key] for key in (
                "parent_plan_sha256", "numerical_report_sha256", "observation_manifest_sha256",
                "translation_handoffs_sha256"))
    _require(supplemental.isdisjoint(prior_ids),
             "FINAL review, archive and resource evidence identities must remain outside DEVELOPMENT")
    return prior_ids, (owned - prior_ids) | supplemental


def assemble_joint_credit_edit_final(validator, *, plan, expected_plan_sha256, lineage, expected_lineage_sha256,
        inputs, expected_evidence_sha256, verify_lineage_owner, verify_joint_final_owner, verify_paired_final_owner):
    """Read back independent paid F1 and original-parent reports on the common FINAL rows.

    The lineage owner resolves the original verified credit/guide closures
    and the joint owner authenticates the prospective shared opaque scope
    and its separately issued branch reservations. Only source-fidelity
    observations enter the interaction. The original gate and cost owners
    keep their separate receipts and scopes.
    """
    _require(all(callable(owner) for owner in (verify_lineage_owner, verify_joint_final_owner, verify_paired_final_owner)),
             "original lineage, joint selection and paired FINAL owners required")

    def current():
        _require(joint_credit_edit_final_plan_commitment(plan) == expected_plan_sha256
                 and type(lineage) is dict and lineage.get("schema") == JOINT_CREDIT_EDIT_RESULT_SCHEMA
                 and _pin(lineage.get("evidence_sha256")) and _pin(lineage.get("source_crosswalk_sha256"))
                 and lineage.get("final_assessment_performed") is False
                 and commitment(lineage) == expected_lineage_sha256
                 and lineage.get("plan_sha256") == plan.lineage_plan_sha256
                 and lineage.get("final_reservation_sha256") == plan.lineage_reservation_sha256
                 and joint_credit_edit_final_evidence_commitment(expected_plan_sha256, expected_lineage_sha256, inputs)
                     == expected_evidence_sha256,
                 "original lineage, frozen joint plan or exact paired inputs changed")

    current()
    selected = deepcopy(inputs)
    left, right = (_joint_credit_edit_final_scope(validator, pin, offer, plan.common_opaque_final_sha256)
                   for pin, offer in zip(plan.paired_plans_sha256, selected, strict=True))
    common = selected[0].paired_plan
    _require(left == right and common.source_crosswalk_sha256 == lineage["source_crosswalk_sha256"],
             "joint comparison requires the same ordered FINAL panel, source crosswalk, TRAIN cohorts and DEVELOPMENT policy")
    seeds = left[0]
    slots = lineage.get("slots")
    _require(type(slots) in (tuple, list) and all(type(row) is dict for row in slots)
             and tuple((row.get("seed"), row.get("credit")) for row in slots)
                 == tuple((seed, credit) for seed in seeds for credit in _JOINT_CREDIT_BRANCHES),
             "lineage must retain all registered seed and credit slots in order")
    credit_closes = tuple(row.get("original_credit_close_sha256") for row in slots
                          if row.get("original_credit_close_sha256") is not None)
    _require(all(_pin(pin) for pin in credit_closes) and len(set(credit_closes)) == len(credit_closes),
             "joint lineage must retain independent original credit closes")
    by_slot = {(row["seed"], row["credit"]): dict(row) for row in slots}
    _require(verify_lineage_owner(plan.lineage_plan_sha256, lineage["evidence_sha256"], expected_lineage_sha256) is True,
             "original lineage owner refused the exact credit and joint edit ancestry")
    current()
    _require(verify_joint_final_owner(expected_plan_sha256, expected_lineage_sha256, expected_evidence_sha256) is True,
             "joint owner refused the common opaque selection or original paired scopes")
    current()
    originals, scopes, known, results, identities = [], [], [], [], []
    for pin, offer in zip(plan.paired_plans_sha256, selected, strict=True):
        report = assemble_fixed_stage_paired_final_panel(validator, plan=offer.paired_plan, expected_plan_sha256=pin,
            study=offer.study, contrast_plan=offer.contrast_plan, development_comparison=offer.development_comparison,
            cells=offer.cells, expected_evidence_sha256=offer.expected_evidence_sha256,
            verify_paired_final_owner=lambda *pins: verify_paired_final_owner(offer.credit, *pins),
            scheduled_readbacks=offer.scheduled_readbacks,
            expected_scheduled_readbacks_sha256=offer.expected_scheduled_readbacks_sha256)
        current()
        fidelity, records, complete = _joint_credit_edit_final_rows(offer, report, seeds, by_slot)
        results.append(dict(credit=offer.credit, source_fidelity=fidelity))
        scopes.extend(records)
        known.append(complete)
        identities.append(_joint_credit_edit_final_ids(offer, report))
        originals.append(dict(credit=offer.credit, paired_report_sha256=commitment(report),
            paired_evidence_sha256=offer.expected_evidence_sha256, paired_plan_sha256=pin,
            final_reservation_sha256=offer.paired_plan.final_reservation_sha256,
            development_comparison_sha256=offer.paired_plan.development_comparison_sha256,
            physical_work_scope=report["physical_work_scope"], elapsed_wall_scope=report["elapsed_wall_scope"],
            **{key: report[key] for key in ("activation_discovery_cost_scope",
                "activation_discovery_wall_scope", "development_horizon_scope") if key in report}))
    (left_prior, left_final), (right_prior, right_final) = identities
    reserve_closes = tuple(offer.reservation.owner_close_sha256 for offer in selected)
    _require(left_prior.isdisjoint(right_prior)
             and left_final.isdisjoint(right_prior | right_final) and right_final.isdisjoint(left_prior)
             and (left_final | right_final | set(reserve_closes)).isdisjoint(credit_closes)
             and (left_prior | right_prior | left_final | right_final).isdisjoint(reserve_closes),
             "paid DEVELOPMENT or FINAL activity, review, archive or meter identity cannot prove two branches or reserve custody")
    complete = {seed: known[0][seed] & known[1][seed] for seed in seeds}
    effect = _final_portability_group_interaction(common, seeds, results[0]["source_fidelity"],
        results[1]["source_fidelity"], complete, "(D1F1-D1F0)-(D0F1-D0F0)")
    current()
    return dict(schema=JOINT_CREDIT_EDIT_FINAL_SCHEMA, plan_sha256=expected_plan_sha256,
        lineage_sha256=expected_lineage_sha256, evidence_sha256=expected_evidence_sha256,
        evidence_scope=common.evidence_scope, final_panel_sha256=common.final_panel_sha256,
        source_crosswalk_sha256=common.source_crosswalk_sha256, original_paid_branches=tuple(originals),
        per_seed_credit_scopes=tuple(scopes), within_credit_fidelity=tuple(results), fidelity_interaction=effect,
        combined_physical_work_ns=None, combined_time_to_threshold_seconds=None,
        cost_scope="retain_original_paid_branch_and_arm_scopes")


JOINT_CREDIT_EDIT_PHYSICAL_COST_SCHEMA = "reviewed-joint-credit-edit-original-paid-work/v1"


@dataclass(frozen=True)
class JointCreditPhysicalWork:
    seed: str
    credit: str
    original_attempt_sha256: str
    original_operation_close_sha256: str
    original_cost_receipt_sha256: str
    events: tuple[PaidEvent, ...]


@dataclass(frozen=True)
class JointSharedCreditEvent:
    event_sha256: str
    original_cost_receipts_sha256: tuple[str, ...]


def joint_credit_edit_physical_cost_commitment(final_sha256, lineage_sha256, credit_work, shared_credit_events):
    _require(_pin(final_sha256) and _pin(lineage_sha256)
             and type(credit_work) is tuple and credit_work
             and all(row is None or type(row) is JointCreditPhysicalWork for row in credit_work)
             and type(shared_credit_events) is tuple and all(type(row) is JointSharedCreditEvent
                 and _pin(row.event_sha256) and type(row.original_cost_receipts_sha256) is tuple
                 and len(row.original_cost_receipts_sha256) >= 2
                 and all(_pin(pin) for pin in row.original_cost_receipts_sha256)
                 and len(set(row.original_cost_receipts_sha256)) == len(row.original_cost_receipts_sha256)
                 for row in shared_credit_events)
             and tuple(row.event_sha256 for row in shared_credit_events)
                 == tuple(sorted({row.event_sha256 for row in shared_credit_events})),
             "exact ordered original credit work and explicitly selected shared events required")
    return commitment((JOINT_CREDIT_EDIT_PHYSICAL_COST_SCHEMA, final_sha256, lineage_sha256,
                       credit_work, shared_credit_events))


def _joint_original_credit_work(branches, work, shared):
    _require(len(branches) == len(work), "original paid credit roster must keep all lineage slots")
    by_slot, events, consumers, receipts = {}, {}, {}, set()
    for branch, offered in zip(branches, work, strict=True):
        key = (branch.seed, branch.credit)
        if offered is None:
            by_slot[key] = {}
            continue
        train = branch.train
        paid = offered.original_cost_receipt_sha256
        _require(train is not None and (offered.seed, offered.credit) == key
                 and (offered.original_attempt_sha256, offered.original_operation_close_sha256)
                     == (train.original_attempt_sha256, train.original_close_sha256)
                 and all(_pin(pin) for pin in (paid, offered.original_attempt_sha256,
                                              offered.original_operation_close_sha256))
                 and paid not in receipts and bool(offered.events),
                 "credit work must bind the exact original attempt, operation close and independent cost receipt")
        receipts.add(paid)
        local = _event_roster(offered.events)
        for event_id, event in local.items():
            _require(events.setdefault(event_id, event) == event,
                     "shared credit event cannot change its original counters, disposition or physical close")
            consumers.setdefault(event_id, []).append(paid)
        by_slot[key] = local
    _require(tuple((row.event_sha256, row.original_cost_receipts_sha256) for row in shared)
             == tuple((event_id, tuple(scopes)) for event_id, scopes in sorted(consumers.items()) if len(scopes) > 1),
             "every reused credit event needs its exact registered consumer receipt roster")
    return by_slot, events


def _joint_original_f_work(final_result, inputs, paired_reports, seeds):
    originals = final_result.get("original_paid_branches")
    _require(type(originals) in (list, tuple) and len(originals) == len(inputs) == len(paired_reports) == 2,
             "exact issued paid FINAL reports for both credit branches required")
    by_arm, events, prior_ownership, all_ownership = {}, {}, set(), set()
    for offer, report, receipt in zip(inputs, paired_reports, originals, strict=True):
        _require(type(report) is dict and report.get("schema") == FIXED_STAGE_FINAL_PAIR_SCHEMA
                 and report.get("evidence_scope") == final_result.get("evidence_scope")
                 and type(receipt) is dict
                 and (receipt.get("credit"), receipt.get("paired_report_sha256"), receipt.get("paired_evidence_sha256"),
                      receipt.get("development_comparison_sha256"))
                     == (offer.credit, commitment(report), offer.expected_evidence_sha256,
                         offer.paired_plan.development_comparison_sha256)
                 and commitment(offer.development_comparison) == offer.paired_plan.development_comparison_sha256
                 and report.get("evidence_sha256") == offer.expected_evidence_sha256,
                 "original paired FINAL receipt and DEVELOPMENT cost scope differ")
        original, branch = _fixed_stage_portability_attempts_and_costs(offer, report)
        prior_ids, final_ids = _joint_credit_edit_final_ids(offer, report)
        _require(set(events).isdisjoint(branch) and all_ownership.isdisjoint(prior_ids | final_ids),
                 "one original F paid event or receipt cannot belong to two credit branches")
        events.update(branch)
        prior_ownership.update(prior_ids)
        all_ownership.update(original | final_ids)
        cells = {(cell.seed, cell.arm): cell for cell in offer.cells}
        attempts = {(row["seed"], row["arm"]): row for row in offer.development_comparison["attempt_decisions"]}
        _require(set(seeds) == {seed for seed, arm in cells if arm == "programmed"}
                 and set(seeds) == {seed for seed, arm in attempts if arm == "programmed"},
                 "selected F study must preserve every seed's programmed attempt and FINAL cell")
        for seed in seeds:
            key = (seed, "programmed")
            terminal = attempts[key]
            development_events = _joint_original_charge_ids(terminal["closing_charges"], branch)
            resources = cells[key].final_resources
            activities = () if resources is None else resources["activities"]
            for edit_arm, role in (("F0", "baseline"), ("F1", "candidate")):
                relevant = tuple(row for row in activities if row["activity"]["role"] == role)
                final_events = set().union(*(_joint_original_charge_ids(row["charged_events"], branch) for row in relevant))
                by_arm[seed, offer.credit, edit_arm] = dict(
                    programmed_terminal_cost_scope_sha256=(terminal["closeout_receipt_sha256"] if edit_arm == "F1" else None),
                    programmed_development_event_sha256s=tuple(sorted(development_events)) if edit_arm == "F1" else (),
                    programmed_development_allocation=(
                        tuple(terminal["closing_charges"]["entries"]) if edit_arm == "F1" else ()),
                    original_FINAL_event_sha256s=tuple(sorted(final_events)),
                    original_FINAL_activity_allocations=tuple(tuple(row["charged_events"]["entries"]) for row in relevant),
                    original_FINAL_activity_sha256s=tuple(row["activity"]["evaluation_sha256"] for row in relevant),
                    original_FINAL_dispositions=tuple(row["status"] for row in relevant))
    return by_arm, events, prior_ownership, all_ownership


def _joint_original_charge_ids(charges, events):
    entries = charges.get("entries") if type(charges) is dict else None
    _require(type(entries) in (tuple, list) and bool(entries)
             and all(type(row) in (tuple, list) and len(row) == 2 and _pin(row[0]) and row[0] in events for row in entries),
             "original charged events must belong to the exact verified branch roster")
    ids = tuple(row[0] for row in entries)
    _require(ids == tuple(sorted(set(ids))), "original charge manifest must retain unique ordered event identities")
    return set(ids)


def readback_joint_credit_edit_physical_cost(*, final_result, expected_final_sha256, lineage_result,
        expected_lineage_sha256, lineage_plan, lineage_branches, inputs, paired_reports, credit_work,
        shared_credit_events, expected_cost_evidence_sha256, verify_final_owner, verify_credit_cost_owner,
        verify_joint_cost_owner):
    """Join original exclusive event counters; keep measured arm and study scopes distinct.

    The cost owner authenticates the original request-to-physical-close and event
    mapping for each credit scope, including failed predecessors and any shared
    event's exact consumers. The final owner authenticates the issued joint and
    per-branch reports. Component scopes preserve failures and physical incidence;
    they provide neither a whole-arm meter nor a full-gate certificate.
    """
    _require(all(callable(owner) for owner in (verify_final_owner, verify_credit_cost_owner, verify_joint_cost_owner))
             and type(lineage_result) is dict and type(final_result) is dict and type(paired_reports) is tuple,
             "original FINAL, credit work and joint resource owners required")
    case = (final_result, lineage_result, lineage_plan, lineage_branches, inputs, paired_reports,
            credit_work, shared_credit_events)

    def current():
        _require(final_result.get("schema") == JOINT_CREDIT_EDIT_FINAL_SCHEMA
                 and final_result.get("evidence_scope") in ("native_reviewed", "synthetic_reference_only")
                 and lineage_result.get("schema") == JOINT_CREDIT_EDIT_RESULT_SCHEMA
                 and commitment(final_result) == expected_final_sha256
                 and commitment(lineage_result) == expected_lineage_sha256 == final_result.get("lineage_sha256")
                 and joint_credit_edit_plan_commitment(lineage_plan) == lineage_result.get("plan_sha256")
                 and joint_credit_edit_evidence_commitment(lineage_result["plan_sha256"], lineage_branches)
                     == lineage_result.get("evidence_sha256")
                 and joint_credit_edit_final_evidence_commitment(final_result.get("plan_sha256"),
                         expected_lineage_sha256, inputs) == final_result.get("evidence_sha256")
                 and joint_credit_edit_physical_cost_commitment(expected_final_sha256, expected_lineage_sha256,
                         credit_work, shared_credit_events) == expected_cost_evidence_sha256,
                 "selected original lineage, FINAL results, reports or paid evidence changed")

    current()
    final, _, registration, branches, scopes, reports, credit, shared = deepcopy(case)
    seeds = tuple(row.seed for row in registration.seeds)
    _require(tuple((row.seed, row.credit) for row in branches)
                 == tuple((seed, role) for seed in seeds for role in _JOINT_CREDIT_BRANCHES),
             "original paid study must retain every registered seed and branch")
    credit_by_slot, d_events = _joint_original_credit_work(branches, credit, shared)
    f_arms, f_events, f_prior, f_ownership = _joint_original_f_work(final, scopes, reports, seeds)
    d_ids = set(d_events)
    d_closes = {event.close_receipt_sha256 for event in d_events.values()}
    operations = {value for row in branches if row.train is not None
                  for value in (row.train.original_attempt_sha256, row.train.original_close_sha256)}
    original_cost_scopes = {row.original_cost_receipt_sha256 for row in credit if row is not None}
    f_protected = {offer.reservation.owner_close_sha256 for offer in scopes}
    for row in branches:
        if row.edit is not None:
            archive = row.edit
            f_protected.update((*map(commitment, (archive.readback, archive.gate_report, archive.numerical_report)),
                                archive.guide_execution_sha256, archive.readback["joint_affine_readback_sha256"]))
    for row in credit:
        if row is not None:
            _require({event.close_receipt_sha256 for event in row.events}.intersection(operations)
                         <= {row.original_operation_close_sha256},
                     "direct physical credit close belongs to a different original operation")
    _require(len(d_closes) == len(d_ids) and d_ids.isdisjoint(d_closes)
             and (d_ids | d_closes | original_cost_scopes).isdisjoint(f_ownership | f_protected)
             and (d_ids | original_cost_scopes).isdisjoint(operations)
             and d_ids.isdisjoint(original_cost_scopes) and d_closes.isdisjoint(original_cost_scopes)
             and operations.isdisjoint(f_ownership - f_prior),
             "physical credit events, outer operations, F scopes and cost receipts must keep distinct identities")
    physical = d_events | f_events
    roster = tuple(physical[key] for key in sorted(physical))
    _require(len({event.close_receipt_sha256 for event in roster}) == len(roster),
             "one physical close cannot fund two event identities in the joint study")
    _require(verify_final_owner(expected_final_sha256, expected_lineage_sha256, final["evidence_sha256"],
                                tuple(map(commitment, reports))) is True,
             "original FINAL owner refused the exact issued joint or per-branch paid results")
    current()
    for row in credit:
        if row is not None:
            _require(verify_credit_cost_owner(expected_lineage_sha256, row.seed, row.credit,
                    row.original_attempt_sha256, row.original_operation_close_sha256,
                    row.original_cost_receipt_sha256, commitment(row.events)) is True,
                    "original credit resource owner refused request, operation and event linkage")
            current()
    physical_roster_sha256 = commitment(roster)
    _require(verify_joint_cost_owner(expected_cost_evidence_sha256, expected_final_sha256,
                                     expected_lineage_sha256, physical_roster_sha256) is True,
             "joint resource owner refused exact exclusive paid events or shared consumer scopes")
    current()
    components = []
    credit_receipts = {(row.seed, row.credit): row.original_cost_receipt_sha256 for row in credit if row is not None}
    for (seed, role, arm), original in f_arms.items():
        d_component = credit_by_slot[seed, role]
        event_ids = set(d_component).union(original["programmed_development_event_sha256s"],
                                            original["original_FINAL_event_sha256s"])
        ids = tuple(sorted(event_ids))
        components.append(dict(seed=seed, credit=role, arm=arm, credit_event_sha256s=tuple(d_component),
            original_credit_cost_receipt_sha256=credit_receipts.get((seed, role)), **original,
            observed_component_events=ids, observed_incident_physical_work_ns=_physical_work_ns(
                {event: physical[event] for event in ids}), whole_arm_first_use_wall_ns=None,
            time_to_threshold_seconds=None))
    return dict(schema=JOINT_CREDIT_EDIT_PHYSICAL_COST_SCHEMA, joint_final_sha256=expected_final_sha256,
                lineage_sha256=expected_lineage_sha256, cost_evidence_sha256=expected_cost_evidence_sha256,
                evidence_scope=final["evidence_scope"], physical_roster_sha256=physical_roster_sha256, physical_event_count=len(roster),
                event_dispositions=dict(Counter(event.disposition for event in roster)),
                observed_selected_physical_work_ns=_physical_work_ns(physical),
                all_original_credit_slots_have_paid_receipts=all(row is not None for row in credit),
                scope="verified_original_credit_and_f_study_event_union",
                arm_component_scope="full_incident_event_counters_and_separate_original_activity_allocations",
                observed_arm_components=tuple(components))


JOINT_FIRST_USE_SCHEMA = "reviewed-joint-credit-edit-original-first-use/v1"
JOINT_FIRST_USE_ARMS = ("D0F0", "D0F1", "D1F0", "D1F1")


@dataclass(frozen=True)
class JointFirstUseArm:
    seed: str
    credit: str
    arm: str
    attempt_sha256: str
    origin_receipt_sha256: str
    terminal_receipt_sha256: str
    terminal_disposition: str
    meter: Meter
    evidence: CostEvidence


def joint_first_use_subject(study_sha256, physical_sha256, seed, credit, arm, attempt_sha256,
                            origin_receipt_sha256, terminal_receipt_sha256, terminal_disposition):
    """Bind the original terminal meter to its preregistered arm and full work scope."""
    return commitment((JOINT_FIRST_USE_SCHEMA, study_sha256, physical_sha256, seed, credit, arm,
                       attempt_sha256, origin_receipt_sha256, terminal_receipt_sha256, terminal_disposition))


def joint_first_use_commitment(study_sha256, physical_sha256, arms):
    _require(_pin(study_sha256) and _pin(physical_sha256) and type(arms) is tuple
             and all(row is None or type(row) is JointFirstUseArm for row in arms),
             "exact original physical work and ordered first-use meter slots required")
    return commitment((JOINT_FIRST_USE_SCHEMA, "evidence", study_sha256, physical_sha256, arms))


def _joint_first_use_terminal(validator, study, study_pin, physical_pin, row, component, original_events):
    pins = (row.attempt_sha256, row.origin_receipt_sha256, row.terminal_receipt_sha256)
    _require(all(_pin(pin) for pin in pins) and type(row.terminal_disposition) is str
             and row.terminal_disposition in CLOSED_EVENT_OUTCOMES,
             "whole-arm first-use observation requires original opening and terminal receipts")
    subject = joint_first_use_subject(study_pin, physical_pin, row.seed, row.credit, row.arm, *pins,
                                     row.terminal_disposition)
    evidence = row.evidence
    _require(type(evidence) is CostEvidence and evidence.schema == COST_EVIDENCE_SCHEMA
             and (evidence.study_sha256, evidence.attempts_sha256) == (study_pin, subject)
             and type(evidence.observations) is tuple and len(evidence.observations) == 1
             and type(evidence.observations[0]) is tuple and len(evidence.observations[0]) == 2,
             "one original whole-arm closing cost observation must bind the exact registered scope")
    interval, charges = evidence.observations[0]
    meter = row.meter
    costs = _meter_costs(validator, meter, attempt_sha256=row.attempt_sha256,
                         cost_policy_sha256=study.cost_policy_sha256, stage="close", scope=CUMULATIVE_ARM)
    _require(type(interval) is MeterInterval and type(charges) is ChargeManifest
             and (interval.attempt_sha256, interval.stage) == (charges.attempt_sha256, charges.stage)
                 == (row.attempt_sha256, "close")
             and interval.subject_sha256 == subject and _pin(interval.scope_receipt_sha256)
             and (commitment(interval), commitment(charges))
                 == (meter.interval_manifest_sha256, meter.charge_manifest_sha256),
             "original interval and paid allocation must belong to the exact whole-arm meter")
    events = _event_roster(evidence.events)
    shares = _event_shares(charges, events, {})
    _require(all(share == 1 for share in shares.values()),
             "each standalone first-use arm requires full physical work charges")
    required = set(component["observed_component_events"])
    _require(bool(events) and set(shares) == set(events) and required == set(events).intersection(original_events)
             and all(events[key] == original_events[key] for key in required),
             "whole-arm allocation must cover this arm's exact original paid events, including unsuccessful work")
    for seconds, nanoseconds in (("cpu_seconds", "cpu_ns"), ("gpu_seconds", "gpu_ns")):
        value = getattr(costs, seconds)
        _require(value is None or value == _charged_seconds(events, shares, nanoseconds),
                 "whole-arm additive meter differs from its original allocations")
    _wall_evidence(meter, interval.wall, None, study.cost_basis)
    scope_receipts = (row.attempt_sha256, row.terminal_receipt_sha256,
                      meter.record_sha256, interval.scope_receipt_sha256,
                      meter.interval_manifest_sha256, meter.charge_manifest_sha256,
                      *(pin for pin in meter.clock_receipts if pin is not None))
    _require(len(set(scope_receipts)) == len(scope_receipts),
             "an original first-use opening, closing, meter or clock receipt reuses another role")
    opening = None if interval.wall is None else (interval.wall.clock_domain_sha256, interval.wall.start_ns)
    return subject, events, scope_receipts, opening


def readback_joint_credit_edit_first_use(validator, *, study, expected_study_sha256, physical_result,
        expected_physical_sha256, original_events, arms, expected_evidence_sha256,
        verify_selection_owner, replay_arm_scope, replay_arm_cost):
    """Verify original terminal first-use meters; certification needs separate gate evidence.

    The selection owner authenticates the issued physical comparison and the
    preregistered arm study. The arm owner verifies the original opening and
    terminal dispositions, the complete original Meter and clock receipts,
    whole-scope coverage (including earlier failed work), birth/clock linkage,
    and the exact cutoff. The arm replayer returns the entire issued record.
    A proven shared opening may cover more than one arm at the same origin.
    The cost callback
    replays the typed cost evidence and every charged close with the existing
    first-use cost owner. Arm views may reference the same original event;
    their incidences and wall clocks are never summed.
    """
    _require(all(callable(owner) for owner in (verify_selection_owner, replay_arm_scope, replay_arm_cost)),
             "independent physical selection, arm scope and cost replay required")
    _study(validator, study, expected_study_sha256)
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and study.cost_basis == "first_use"
             and study.reuse_count is None and tuple(arm for arm, _ in study.arms) == JOINT_FIRST_USE_ARMS,
             "a preregistered four-arm first-use study is required")

    def current():
        _require(_pin(expected_physical_sha256) and type(physical_result) is dict
                 and physical_result.get("schema") == JOINT_CREDIT_EDIT_PHYSICAL_COST_SCHEMA
                 and physical_result.get("evidence_scope") in ("native_reviewed", "synthetic_reference_only")
                 and commitment(physical_result) == expected_physical_sha256
                 and commitment(original_events) == physical_result.get("physical_roster_sha256")
                 and commitment(study) == expected_study_sha256
                 and joint_first_use_commitment(expected_study_sha256, expected_physical_sha256, arms)
                     == expected_evidence_sha256,
                 "selected first-use study, original physical work or offered meter evidence changed")

    current()
    known = _event_roster(original_events)
    rows = physical_result.get("observed_arm_components")
    _require(type(rows) in (tuple, list) and all(type(row) is dict and
             all(_name(row.get(field)) for field in ("seed", "credit", "arm")) and
             type(row.get("observed_component_events")) in (tuple, list) and
             all(_pin(pin) and pin in known for pin in row["observed_component_events"]) for row in rows),
             "issued physical work must retain ordered arm records and their original event identities")
    slots = tuple((row["seed"], row["credit"], row["arm"]) for row in rows)
    expected_slots = {(seed.identifier, credit, arm) for seed in study.seeds
                      for credit in _JOINT_CREDIT_BRANCHES for arm in ("F0", "F1")}
    _require(len(slots) == len(expected_slots) == len(arms) and set(slots) == expected_slots,
             "first-use evidence must keep all matched seed, credit and edit slots")
    scoped, all_events = [], dict(known)
    scope_ids, openings = set(), {}
    for slot, component, row in zip(slots, rows, arms, strict=True):
        if row is None:
            scoped.append(None)
            continue
        _require((row.seed, row.credit, row.arm) == slot
                 and _pin(component["original_credit_cost_receipt_sha256"]),
                 "first-use observation needs the exact arm and its original credit work")
        subject, events, pins, opening = _joint_first_use_terminal(validator, study, expected_study_sha256,
                                  expected_physical_sha256, row, component, known)
        origin = row.origin_receipt_sha256
        if opening is not None:
            _require(openings.get(origin) in (None, opening),
                     "shared original first-use opening must retain its clock domain and start")
            openings[origin] = opening
        else:
            openings.setdefault(origin, None)
        _require(scope_ids.isdisjoint(pins), "one original scope receipt cannot attest multiple arm clocks")
        scope_ids.update(pins)
        for event_id, event in events.items():
            _require(all_events.setdefault(event_id, event) == event,
                     "a shared physical event cannot change its original evidence")
        scoped.append((subject, commitment(row), commitment(row.evidence)))
    close_ids = {event.close_receipt_sha256 for event in all_events.values()}
    _require(len(close_ids) == len(all_events) and close_ids.isdisjoint(all_events)
             and scope_ids.isdisjoint(openings)
             and (scope_ids | set(openings)).isdisjoint(close_ids | set(all_events)),
             "distinct physical leaves, openings, scope receipts and event identities are required")
    _require(verify_selection_owner(expected_study_sha256, expected_physical_sha256,
                 physical_result["physical_roster_sha256"], expected_evidence_sha256) is True,
             "joint owner refused the original physical result or first-use selection")
    current()
    observations = []
    for slot, row, scope in zip(slots, arms, scoped, strict=True):
        observed = dict(seed=slot[0], credit=slot[1], arm=slot[2], status="original_meter_unavailable",
                        terminal_disposition=None, terminal_receipt_sha256=None,
                        origin_receipt_sha256=None, closing_wall=None, closing_costs=None,
                        original_meter_sha256=None, charge_manifest_sha256=None,
                        time_to_threshold_seconds=None)
        if scope is not None:
            subject, row_pin, cost_pin = scope
            issued = replay_arm_scope(expected_study_sha256, expected_physical_sha256, subject, row_pin)
            _require(type(issued) is JointFirstUseArm and commitment(issued) == row_pin,
                     "original arm owner did not replay the opening, complete meter and terminal scope")
            current()
            _require(replay_arm_cost(study, row.evidence, cost_pin) is True,
                     "resource owner refused the original first-use meter and charged event endpoints")
            current()
            interval, _ = row.evidence.observations[0]
            observed.update(status="original_close_replayed", terminal_disposition=row.terminal_disposition,
                terminal_receipt_sha256=row.terminal_receipt_sha256, origin_receipt_sha256=row.origin_receipt_sha256,
                closing_wall=_wire(interval.wall), closing_costs=_wire(row.meter.costs),
                original_meter_sha256=row.meter.record_sha256, charge_manifest_sha256=row.meter.charge_manifest_sha256)
        observations.append(observed)
    return dict(schema=JOINT_FIRST_USE_SCHEMA, study_sha256=expected_study_sha256,
        original_physical_sha256=expected_physical_sha256, evidence_sha256=expected_evidence_sha256,
        evidence_scope=physical_result["evidence_scope"], observations=tuple(observations),
        combined_first_use_wall_seconds=None, time_to_threshold_seconds=None)


JOINT_NO_EDIT_FROZEN_FINAL_SCHEMA = "reviewed-frozen-joint-no-edit-final/v1"


@dataclass(frozen=True)
class NoEditPaidDevelopment:
    origin_receipt_sha256: str
    development_panel_sha256: str
    development_split_sha256: str
    credit: JointCreditPhysicalWork
    look_closes: tuple[tuple[str, tuple[str, ...]], ...]
    first_charge_stages: tuple[tuple[str, str], ...]


@dataclass(frozen=True)
class NoEditFinalArchive:
    checkpoint_sha256: str
    compact_preimage_sha256: str
    original_credit_close_sha256: str
    archive_manifest_sha256: str
    owner_close_sha256: str


def no_edit_final_archive_commitment(archive):
    _require(type(archive) is NoEditFinalArchive and all(_pin(pin) for pin in asdict(archive).values())
             and len(set(asdict(archive).values())) == 5,
             "exact original post-credit checkpoint, compact preimage and independent archive close required")
    return commitment((JOINT_NO_EDIT_FROZEN_FINAL_SCHEMA, "archive", archive))


def no_edit_paid_development_commitment(work):
    _require(type(work) is NoEditPaidDevelopment
             and all(_pin(pin) for pin in (work.origin_receipt_sha256, work.development_panel_sha256,
                                           work.development_split_sha256))
             and type(work.credit) is JointCreditPhysicalWork and type(work.look_closes) is tuple
             and type(work.first_charge_stages) is tuple
             and all(type(row) is tuple and len(row) == 2 and _pin(row[0]) and _name(row[1])
                     for row in work.first_charge_stages)
             and tuple(row[0] for row in work.first_charge_stages)
                 == tuple(sorted({row[0] for row in work.first_charge_stages}))
             and all(type(row) is tuple and len(row) == 2 and _name(row[0]) and type(row[1]) is tuple
                     and bool(row[1]) and all(_pin(pin) for pin in row[1])
                     for row in work.look_closes),
             "exact original opening, development panel, credit work and independently staged charges required")
    identities = tuple(pin for _, closes in work.look_closes for pin in closes)
    _require(len(set(identities)) == len(identities),
             "one original evaluation close cannot observe two scheduled assessments")
    return commitment((JOINT_NO_EDIT_FROZEN_FINAL_SCHEMA, "paid-development", work))


def _no_edit_cut_roster(validator, study, attempt, evidence, work, train, credit):
    _require(type(evidence) is CostEvidence and evidence.schema == COST_EVIDENCE_SCHEMA
             and (evidence.study_sha256, evidence.attempts_sha256) == (attempt.study_sha256, commitment((attempt,)))
             and type(evidence.observations) is tuple and len(evidence.observations) == len(attempt.assessments) + 1
             and tuple(look for look, _ in work.look_closes) == tuple(row.look for row in attempt.assessments),
             "original costs and evaluation leaves must cover each observed look and the DEVELOPMENT close")
    events = _event_roster(evidence.events)
    by_close = {event.close_receipt_sha256: event for event in events.values()}
    earlier = work.credit
    credit_events = _event_roster(earlier.events)
    _require(bool(credit_events) and (earlier.seed, earlier.credit, earlier.original_attempt_sha256,
                 earlier.original_operation_close_sha256) == (attempt.seed, credit, train.original_attempt_sha256,
                                                               train.original_close_sha256)
             and _pin(earlier.original_cost_receipt_sha256)
             and all(events.get(pin) == event for pin, event in credit_events.items()),
             "first-use look must retain the original paid credit prerequisites, including failed work")
    scopes = (work.origin_receipt_sha256, attempt.attempt_sha256, attempt.closeout_receipt_sha256,
              train.original_attempt_sha256, earlier.original_cost_receipt_sha256)
    _require(len(by_close) == len(events) and set(by_close).isdisjoint(events)
             and len(set(scopes)) == len(scopes) and set(scopes).isdisjoint(events.keys() | by_close.keys())
             and train.original_close_sha256 not in scopes + tuple(events)
             and (train.original_close_sha256 not in by_close
                  or by_close[train.original_close_sha256].event_sha256 in credit_events),
             "physical leaves, original opening and enclosing scope receipts must remain distinct")
    required = tuple(frozenset(closes) for _, closes in work.look_closes)
    evaluation_closes = frozenset().union(*required)
    _require(evaluation_closes.isdisjoint(event.close_receipt_sha256 for event in credit_events.values())
             and all(pin in by_close and by_close[pin].disposition == "complete" for pin in evaluation_closes),
             "each look must use its own completed paid assessment leaves")

    eval_receipts = {row.evaluation_receipt_sha256 for row in attempt.assessments}
    protected = {*scopes, train.original_close_sha256, *events, *by_close}
    if attempt.cap_receipt_sha256 is not None:
        _require(attempt.cap_receipt_sha256 not in protected, "original cap evidence cannot reuse a paid receipt")
        protected.add(attempt.cap_receipt_sha256)
    _require(len(eval_receipts) == len(attempt.assessments) and protected.isdisjoint(eval_receipts),
             "each issued gate assessment needs a separate exact receipt")
    used, previous, last_wall, measured, paid_assessments, first_charged = {}, {}, None, {}, set(), {}
    for index, (look, raw) in enumerate(zip((*attempt.assessments, None), evidence.observations, strict=True)):
        stage = "close" if look is None else look.look
        meter = attempt.closing_meter if look is None else look.meter
        interval, charges, shares = _cost_observation(validator, study, attempt, look, raw, events, previous)
        _require(credit_events.keys() <= shares.keys() and all(value == 1 for value in shares.values()),
                 "each first-use look needs full original prerequisites and full physical work charges")
        if look is not None:
            paid_assessments.update(required[index])
        _require({events[pin].close_receipt_sha256 for pin in shares} & evaluation_closes == paid_assessments,
                 "paid assessment leaves must first occur at their original scheduled look")
        first_charged.update((pin, stage) for pin in shares.keys() - previous.keys())
        _fixed_stage_meter_receipts(used, eval_receipts, meter, interval)
        last_wall = _wall_evidence(meter, interval.wall, last_wall, study.cost_basis)
        for name, counter in (("cpu_seconds", "cpu_ns"), ("gpu_seconds", "gpu_ns")):
            value = getattr(meter.costs, name)
            _require(value is None or value == _charged_seconds(events, shares, counter),
                     "additive confirming meter differs from the original paid events")
        measured[stage] = (meter, interval, charges)
        previous = shares
    _require(tuple(sorted(first_charged.items())) == work.first_charge_stages,
             "each actual event must first enter the original owner-authenticated charge stage")
    _require(set(previous) == set(events) and protected.isdisjoint(used),
             "DEVELOPMENT closing scope must retain every paid event and independent meter receipt")
    return measured, protected | eval_receipts | set(used) | {
        pin for meter, interval, _ in measured.values()
        for pin in (interval.subject_sha256, meter.interval_manifest_sha256, meter.charge_manifest_sha256)}


def freeze_no_edit_final_checkpoint(edit, validator, review, assessment, *, study, development_design, plan,
        expected_plan_sha256, joint_plan, expected_joint_plan_sha256, lineage_plan, lineage_branches, lineage,
        schedule, expected_schedule_sha256, looks, expected_look_sha256s, attempt, expected_attempt_sha256,
        cost_evidence, expected_cost_sha256, paid, expected_paid_sha256, archive, expected_archive_sha256,
        reservation, expected_reservation_sha256, verify_look_owner, replay_paid_owner, replay_cost_owner,
        verify_checkpoint_owner, verify_final_owner):
    """Freeze a credit-only candidate from independently replayed DEVELOPMENT.

    Use the first scheduled qualifying look and its original cost cut. The
    enclosing attempt still pays later work. The paid owner replays the
    actual DEVELOPMENT panel and split, opening, full original meter records,
    and first charge stage of each event even when wall time is unavailable.
    The reservation owner verifies chronology and split disjointness from protected FINAL, and the
    checkpoint owner resolves the exact post-credit manifest and compact
    preimage. The output contains commitments and no FINAL rows or grant.
    """
    _require(all(callable(owner) for owner in (verify_look_owner, replay_paid_owner, replay_cost_owner,
                                               verify_checkpoint_owner, verify_final_owner)),
             "independent DEVELOPMENT, physical cost, checkpoint and FINAL owners required")

    def current():
        _require(final_checkpoint_plan_commitment(plan) == expected_plan_sha256
                 and joint_credit_edit_final_plan_commitment(joint_plan) == expected_joint_plan_sha256
                 and commitment(study) == plan.study_sha256
                 and development_design_commitment(development_design) == plan.development_design_sha256
                 and review.no_edit_development_schedule_commitment(edit, schedule) == expected_schedule_sha256
                 and type(lineage) is dict and commitment(lineage) == schedule.lineage_sha256
                 and joint_credit_edit_plan_commitment(lineage_plan) == lineage["plan_sha256"]
                 and joint_credit_edit_evidence_commitment(lineage["plan_sha256"], lineage_branches)
                     == lineage["evidence_sha256"]
                 and type(looks) is tuple and type(expected_look_sha256s) is tuple
                 and len(looks) == len(expected_look_sha256s)
                 and all(type(pair) is tuple and len(pair) == 2 and type(pair[0]) is assessment.PreparedGateLook
                         and type(pair[1]) is dict and assessment.prepared_look_commitment(pair[0]) == pin
                         and pair[0].evaluation_receipt_sha256 == edit._digest(pair[1])
                         for pair, pin in zip(looks, expected_look_sha256s, strict=True))
                 and type(attempt) is Attempt and commitment(attempt) == expected_attempt_sha256
                 and commitment(cost_evidence) == expected_cost_sha256
                 and no_edit_paid_development_commitment(paid) == expected_paid_sha256
                 and no_edit_final_archive_commitment(archive) == expected_archive_sha256
                 and fixed_stage_final_reservation_commitment(reservation) == expected_reservation_sha256,
                 "selected original look, paid DEVELOPMENT, checkpoint or opaque reservation evidence changed")

    current()
    thresholds, horizons, caps = _study(validator, study, plan.study_sha256)
    horizon = horizons[plan.clock]
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and study.cost_basis == "first_use"
             and study.stop_after_confirmation is False and horizon is not None
             and "final" not in study.schedule and 2 <= study.required_streak <= len(study.schedule)
             and tuple(row.look for row in schedule.looks) == study.schedule
             and (plan.study_sha256, plan.seed, plan.arm) == (schedule.study_sha256, schedule.seed, schedule.arm)
             and schedule.arm in ("D0F0", "D1F0") and schedule.arm in dict(study.arms)
             and development_design.study_sha256 == plan.study_sha256
             and tuple(row[0] for row in development_design.seed_cohorts) == tuple(seed.identifier for seed in study.seeds)
             and attempt.attempt_sha256 == schedule.attempt_sha256
             and attempt.closeout_status in ("complete", "budget_limit"),
             "freeze needs the original closed no-edit arm, sustained DEVELOPMENT rule and measured horizon")
    _require((reservation.development_design_sha256, reservation.global_split_sha256,
              reservation.population_sha256, reservation.reserved_final_count, reservation.final_policy_sha256)
             == (plan.development_design_sha256, development_design.global_split_sha256,
                 development_design.population_sha256, development_design.reserved_final_count, plan.final_policy_sha256)
             and (joint_plan.lineage_plan_sha256, joint_plan.lineage_reservation_sha256,
                  joint_plan.common_opaque_final_sha256) == (lineage["plan_sha256"],
                     lineage_plan.final_reservation_sha256, reservation.opaque_final_sha256)
             and lineage.get("final_reservation_sha256") == lineage_plan.final_reservation_sha256
             and lineage.get("final_assessment_performed") is False
             and reservation.opaque_final_sha256 not in (reservation.global_split_sha256, commitment(study.panel),
                                                  paid.development_panel_sha256, paid.development_split_sha256)
             and paid.development_split_sha256 != reservation.global_split_sha256,
             "no-edit freeze must keep the joint study's exact untouched opaque FINAL reservation and protected split")

    seed_selection = tuple(item for item in study.seeds if item.identifier == schedule.seed)
    credit = {"D0F0": "broadcast", "D1F0": "structured"}[schedule.arm]
    selected = tuple(row for row in lineage_branches if (row.seed, row.credit) == (schedule.seed, credit))
    _require(len(seed_selection) == len(selected) == 1 and type(selected[0].train) is JointCreditClose
             and type(selected[0].train.checkpoint) is JointCreditCheckpoint,
             "original no-edit cohort requires the seed's own trained credit branch")
    seed, train = seed_selection[0], selected[0].train
    slot = _one_final_row(lineage.get("slots"),
        lambda row: (row.get("seed"), row.get("credit")) == (schedule.seed, credit),
        "issued lineage must retain the exact unchanged post-credit branch")
    _require(lineage.get("schema") == JOINT_CREDIT_EDIT_RESULT_SCHEMA
             and (slot.get("F0_parent_checkpoint_sha256"), slot.get("original_credit_close_sha256"))
                 == (train.checkpoint.checkpoint_sha256, train.original_close_sha256),
             "issued F0 lineage differs from the selected post-credit checkpoint")
    _require((archive.checkpoint_sha256, archive.compact_preimage_sha256, archive.original_credit_close_sha256)
             == (train.checkpoint.checkpoint_sha256, train.checkpoint.compact_preimage_sha256, train.original_close_sha256)
             and schedule.retention_reference_sha256 == seed.retention_reference_sha256,
             "archive and retention must describe the exact unchanged F0 branch")
    offered = tuple(pair[0] for pair in looks)
    _require(type(attempt.assessments) is tuple and len(attempt.assessments) == len(offered)
             and all(type(row) is Assessment for row in attempt.assessments),
             "paid DEVELOPMENT attempt must include its complete issued assessment prefix")
    _require(all(prepared.checkpoint_sha256 == archive.checkpoint_sha256
                 and report["active_restored_preimage_sha256"] == archive.compact_preimage_sha256
                 and (prepared.look, prepared.checkpoint_sha256, prepared.evaluation_receipt_sha256,
                      prepared.panel_sha256, prepared.evaluation_policy_sha256, prepared.retention_reference_sha256,
                      commitment(prepared.gates))
                     == (original.look, original.checkpoint_sha256, original.evaluation_receipt_sha256,
                         original.panel_sha256, original.evaluation_policy_sha256, original.retention_reference_sha256,
                         commitment(original.gates))
                 for (prepared, report), original in zip(looks, attempt.assessments, strict=True)),
             "paid gate measures must bind the original unchanged post-credit look and exact meter")
    arm = (plan.arm, dict(study.arms)[plan.arm])
    verdict = _evaluate(validator, study, plan.study_sha256, attempt, arm, seed, thresholds, caps, commitment(study.panel))
    blocked = _confirmation_block(verdict, attempt, caps, require_complete_cap_observation=True)
    _require(verdict.status == "reached" and blocked is None
             and (elapsed := getattr(verdict.confirming_costs, plan.clock)) is not None and elapsed <= horizon,
             "freeze requires a measured first qualifying streak within its horizon and every actual cap")
    position = tuple(row.look for row in attempt.assessments).index(verdict.confirming_checkpoint)
    original_look = attempt.assessments[position]
    _require(looks[position][1].get("status") == "all_gates_passed"
             and all(looks[index][1].get("status") == "all_gates_passed"
                     for index in range(position + 1 - study.required_streak, position + 1)),
             "earliest qualifying streak requires complete independently reviewed looks")
    measured, protected = _no_edit_cut_roster(validator, study, attempt, cost_evidence, paid, train, credit)
    meter, interval, charges = measured[original_look.look]
    for _, report in looks:
        protected.update(report[key] for key in ("parent_plan_sha256", "numerical_report_sha256",
            "numerical_selection_receipt_sha256", "observation_manifest_sha256", "translation_handoffs_sha256"))
        protected.update(pin for _, roles in report["observation_receipts"] for pin in roles.values() if pin is not None)
        protected.update(pin for _, pin in report["translation_owner_closes"])
    protected.update(expected_look_sha256s)
    protected.update((expected_plan_sha256, expected_joint_plan_sha256, expected_schedule_sha256,
        plan.study_sha256, plan.development_design_sha256, commitment(study.panel),
        schedule.lineage_sha256, lineage["plan_sha256"], lineage["evidence_sha256"], lineage_plan.final_reservation_sha256,
        expected_attempt_sha256, expected_cost_sha256, expected_paid_sha256, seed.retention_reference_sha256,
        archive.checkpoint_sha256, archive.compact_preimage_sha256, paid.development_panel_sha256,
        paid.development_split_sha256, reservation.global_split_sha256, reservation.population_sha256))
    protected.update(pin for row in schedule.looks for pin in (row.review_plan_sha256, row.evaluation_plan_sha256,
                        row.parent_plan_sha256, row.numerical_selection_receipt_sha256))
    protected.update(pin for row in lineage_branches if row.edit is not None for pin in (
        commitment(row.edit.readback), commitment(row.edit.gate_report), commitment(row.edit.numerical_report),
        row.edit.guide_execution_sha256, *(row.edit.readback.get(key) for key in
            ("edit_split_sha256", "confirmation_split_sha256", "panel_sha256", "postimage_sha256"))))
    _independent_sustained_final_closes((archive.archive_manifest_sha256, archive.owner_close_sha256,
                                        reservation.owner_close_sha256, reservation.opaque_final_sha256), protected)

    def verify_selected_look(*pins):
        accepted = verify_look_owner(*pins)
        current()
        return accepted

    _require(review.verify_no_edit_development_look_prefix(edit, assessment, schedule=schedule,
                 expected_schedule_sha256=expected_schedule_sha256, looks=looks, expected_look_sha256s=expected_look_sha256s,
                 verify_look_owner=verify_selected_look) == offered,
             "original no-edit review owner did not replay the issued look prefix")
    current()
    issued = replay_paid_owner(plan.study_sha256, expected_attempt_sha256, expected_paid_sha256, expected_cost_sha256)
    _require(type(issued) is tuple and len(issued) == 2 and type(issued[0]) is Attempt
             and type(issued[1]) is NoEditPaidDevelopment
             and (commitment(issued[0]), no_edit_paid_development_commitment(issued[1]))
                 == (expected_attempt_sha256, expected_paid_sha256),
             "DEVELOPMENT owner did not replay the original opening, meters and terminal scope")
    current()
    _require(replay_cost_owner(study, cost_evidence, expected_cost_sha256) is True,
             "physical resource owner refused original chronological paid scopes")
    current()
    _require(verify_checkpoint_owner(expected_archive_sha256, schedule.lineage_sha256,
                 train.original_close_sha256, archive.checkpoint_sha256, archive.compact_preimage_sha256) is True,
             "checkpoint owner refused original post-credit checkpoint custody")
    current()
    _require(verify_final_owner(expected_plan_sha256, expected_joint_plan_sha256, expected_reservation_sha256,
                 expected_schedule_sha256, expected_attempt_sha256, expected_paid_sha256, expected_archive_sha256) is True,
             "FINAL owner refused exact preregistration, split disjointness or opaque reserve")
    current()
    return {"schema": JOINT_NO_EDIT_FROZEN_FINAL_SCHEMA, "plan_sha256": expected_plan_sha256,
        "joint_plan_sha256": expected_joint_plan_sha256, "study_sha256": plan.study_sha256,
        "development_design_sha256": plan.development_design_sha256,
        "global_split_sha256": reservation.global_split_sha256, "population_sha256": reservation.population_sha256,
        "train_cohort_sha256": next(cohort for label, _, cohort in development_design.seed_cohorts if label == plan.seed),
        "source_crosswalk_sha256": lineage_plan.source_crosswalk_sha256,
        "final_policy_sha256": plan.final_policy_sha256, "final_access_policy_sha256": reservation.access_policy_sha256,
        "final_reservation_sha256": expected_reservation_sha256, "opaque_final_sha256": reservation.opaque_final_sha256,
        "reserved_final_count": reservation.reserved_final_count, "reservation_owner_close_sha256": reservation.owner_close_sha256,
        "seed": plan.seed, "arm": plan.arm, "lineage_sha256": schedule.lineage_sha256, "schedule_sha256": expected_schedule_sha256,
        "attempt_sha256": attempt.attempt_sha256, "candidate_sha256": archive.checkpoint_sha256,
        "compact_preimage_sha256": archive.compact_preimage_sha256, "original_credit_close_sha256": archive.original_credit_close_sha256,
        "archive_sha256": expected_archive_sha256, "archive_manifest_sha256": archive.archive_manifest_sha256,
        "archive_owner_close_sha256": archive.owner_close_sha256, "retention_reference_sha256": seed.retention_reference_sha256,
        "confirming_look": original_look.look, "streak_start": verdict.streak_start,
        "development_evaluation_sha256": original_look.evaluation_receipt_sha256, "development_meter_sha256": meter.record_sha256,
        "development_interval_sha256": commitment(interval), "development_charge_manifest_sha256": commitment(charges),
        "development_cost_evidence_sha256": expected_cost_sha256, "development_paid_scope_sha256": expected_paid_sha256,
        "development_panel_sha256": paid.development_panel_sha256, "development_split_sha256": paid.development_split_sha256,
        "development_clock_receipt_sha256": meter.clock_receipts[COVERED_CLOCKS.index(plan.clock)],
        "development_clock": plan.clock, "development_elapsed": elapsed, "development_horizon": horizon,
        "development_closeout_sha256": attempt.closeout_receipt_sha256, "development_closeout_status": attempt.closeout_status,
        "final_assessment_performed": False, "dispatch_authority": False}


JOINT_NO_EDIT_FINAL_PAID_SCHEMA = "verified-joint-no-edit-final-resources/v1"


def _no_edit_original_development_identities(plan, frozen, attempt, paid, evidence):
    _require(type(attempt) is Attempt and type(evidence) is CostEvidence
             and evidence.schema == COST_EVIDENCE_SCHEMA
             and commitment(evidence) == plan.development_comparison_sha256 == frozen.get("development_cost_evidence_sha256")
             and (evidence.study_sha256, evidence.attempts_sha256) == (plan.study_sha256, commitment((attempt,)))
             and (attempt.study_sha256, attempt.attempt_sha256, attempt.closeout_receipt_sha256,
                  attempt.closeout_status, attempt.arm, attempt.seed) ==
                 (plan.study_sha256, frozen.get("attempt_sha256"), frozen.get("development_closeout_sha256"),
                  frozen.get("development_closeout_status"), frozen.get("arm"), frozen.get("seed"))
             and no_edit_paid_development_commitment(paid) == frozen.get("development_paid_scope_sha256")
             and (paid.development_panel_sha256, paid.development_split_sha256, paid.credit.original_operation_close_sha256)
                 == (frozen.get("development_panel_sha256"), frozen.get("development_split_sha256"),
                     frozen.get("original_credit_close_sha256")),
             "FINAL must retain the exact original no-edit DEVELOPMENT attempt, scope and costs")
    events = _event_roster(evidence.events)
    credit = _event_roster(paid.credit.events)
    _require(all(events.get(pin) == event for pin, event in credit.items()),
             "original credit work must already be in the DEVELOPMENT ledger")
    identities = {*events, *(event.close_receipt_sha256 for event in events.values()),
                  paid.origin_receipt_sha256, paid.credit.original_attempt_sha256,
                  paid.credit.original_cost_receipt_sha256, attempt.attempt_sha256,
                  attempt.closeout_receipt_sha256, attempt.cap_receipt_sha256}
    for meter in (*(look.meter for look in attempt.assessments), attempt.closing_meter):
        identities.update((meter.record_sha256, meter.interval_manifest_sha256,
                           meter.charge_manifest_sha256, *meter.clock_receipts))
    for interval, _ in evidence.observations:
        identities.update((interval.subject_sha256, interval.scope_receipt_sha256))
        if interval.wall is not None:
            identities.add(interval.wall.receipt_sha256)
    identities.update(look.evaluation_receipt_sha256 for look in attempt.assessments)
    identities.update(pin for pin in frozen.values() if _pin(pin))
    identities.discard(None)
    return events, identities


def verify_no_edit_final_resources(validator, edit, review, *, study, scope, plan, expected_plan_sha256,
        development_attempt, development_paid, development_evidence, policy, panel, numerical_report,
        candidate_review, retention_selection, retention_reference, evidence, expected_evidence_sha256,
        verify_selection_owner, replay_development_cost_owner, verify_final_resource_owner,
        numerical_component_close_sha256=None):
    """Join original paid F0 FINAL work to its distinct score and review evidence.

    In this scope the transport's development_comparison_sha256 carries the
    exact DEVELOPMENT cost-evidence pin. Score-only and failed FINAL work stay
    in the paid ledger. A verified resource report grants no dispatch authority.
    """
    _require(type(scope) is review.NoEditFinalReviewScope
             and all(callable(owner) for owner in (
                 verify_selection_owner, replay_development_cost_owner, verify_final_resource_owner))
             and type(plan) is FinalResourcePlan and _pin(expected_plan_sha256)
             and tuple(validator.CLOCKS) == COVERED_CLOCKS and _pin(expected_evidence_sha256),
             "exact no-edit review scope and independent selection and resource owners required")
    _study(validator, study, plan.study_sha256)
    frozen, chosen, scoring = scope.frozen_checkpoint, scope.plan, scope.scoring_plan
    scope_identity = (scope.expected_plan_sha256, scope.study_owner, scope.scoring_owner)
    _require(final_resource_plan_commitment(plan) == expected_plan_sha256
             and type(frozen) is dict and frozen.get("schema") == JOINT_NO_EDIT_FROZEN_FINAL_SCHEMA
             and commitment(frozen) == plan.candidate_freeze_sha256
             and (frozen.get("study_sha256"), frozen.get("final_policy_sha256")) ==
                 (plan.study_sha256, plan.final_policy_sha256)
             and all(frozen.get(key) is False for key in ("dispatch_authority", "final_assessment_performed"))
             and frozen.get("arm") in ("D0F0", "D1F0")
             and plan.cost_policy_sha256 == study.cost_policy_sha256 and study.cost_basis == "first_use"
             and review.no_edit_final_review_commitment(edit, chosen) == scope.expected_plan_sha256
             and scope.study_owner.commitment is commitment
             and scope.scoring_owner.no_edit_final_scoring_commitment(edit, scoring) == chosen.final_scoring_sha256
             and (chosen.frozen_checkpoint_sha256, chosen.panel_sha256, chosen.final_policy_sha256,
                  chosen.retention_selection_sha256) == (plan.candidate_freeze_sha256, plan.final_panel_sha256,
                  plan.final_policy_sha256, plan.final_retention_selection_sha256)
             and (scoring.frozen_checkpoint_sha256, scoring.final_panel_sha256) ==
                 (plan.candidate_freeze_sha256, plan.final_panel_sha256)
             and all(_pin(frozen.get(key)) for key in ("candidate_sha256", "compact_preimage_sha256",
                 "final_reservation_sha256", "development_split_sha256", "global_split_sha256"))
             and scoring.final_split_sha256 not in (frozen["development_split_sha256"], frozen["global_split_sha256"])
             and scoring.final_panel_sha256 != frozen.get("development_panel_sha256"),
             "paid FINAL scope must match the unchanged checkpoint and original protected review selection")
    _require(type(evidence) is FinalResourceEvidence and evidence.plan_sha256 == expected_plan_sha256
             and type(evidence.closes) is tuple and len(evidence.closes) == len(plan.activities)
             and all(type(row) is tuple and len(row) == 4 for row in evidence.closes)
             and commitment(evidence) == expected_evidence_sha256,
             "exact ordered FINAL activity resource evidence required")
    prior, protected = _no_edit_original_development_identities(
        plan, frozen, development_attempt, development_paid, development_evidence)
    _require(all(body is None or type(body) is dict for body in (numerical_report, candidate_review))
             and (retention_reference is None or type(retention_reference) is review.ScheduledRetentionReference),
             "provide exact issued numerical, reviewed or independent retention bodies")
    _require(numerical_component_close_sha256 is None
             or (_pin(numerical_component_close_sha256) and numerical_report is not None and candidate_review is None),
             "retained numerical component requires an exact score and close without issued gate review")
    scoring_pin, policy_pin, panel_pin = chosen.final_scoring_sha256, chosen.policy_sha256, chosen.panel_sha256
    numerical_pin = None if numerical_report is None else edit._digest(numerical_report)
    reference_pin = None if retention_reference is None else retention_reference.digest(edit)
    review_pin = None if candidate_review is None else edit._digest(candidate_review)
    if numerical_report is not None:
        review._no_edit_final_review_result(edit, scope=scope, policy=policy, panel=panel,
                                            report=numerical_report, expected_report_sha256=numerical_pin)
        protected.update(review._no_edit_final_protected_pins(edit, scope, numerical_report, numerical_pin))
    if retention_reference is not None and numerical_report is None:
        _require(type(panel) is scope.scoring_owner.Panel and panel.split_sha256 == scoring.final_split_sha256,
                 "independent comparator must use the original protected FINAL panel")
        review._check_policy(edit, policy, chosen.policy_sha256, panel, chosen.panel_sha256)
    protected.update(pin for contract in (chosen, scoring) for pin in asdict(contract).values() if _pin(pin))
    protected.add(scope.expected_plan_sha256)
    if candidate_review is not None:
        protected.add(review_pin)
        protected.update(pin for role, pin in candidate_review.items()
                         if role != "retention_reference_sha256" and _pin(pin))
    eligible = () if numerical_report is None and retention_reference is None else tuple(
        case.row_id for case in policy.cases if case.review_eligible)
    _, reference_known = review._no_edit_final_independent_retention(
        edit, scope, retention_selection, retention_reference, reference_pin, eligible, protected)
    if candidate_review is not None:
        _require(numerical_pin is not None and type(candidate_review) is dict and
                 candidate_review.get("schema") == review.JOINT_NO_EDIT_FINAL_REVIEW_SCHEMA
                 and (candidate_review.get("plan_sha256"), candidate_review.get("numerical_report_sha256"),
                      candidate_review.get("review_policy_sha256"), candidate_review.get("retention_selection_sha256"),
                      candidate_review.get("retention_reference_sha256")) ==
                     (scope.expected_plan_sha256, numerical_pin, policy_pin, chosen.retention_selection_sha256, reference_pin)
                 and candidate_review.get("retention_roster_complete") is reference_known
                 and all(candidate_review.get(key) == numerical_report[key] for key in (
                     "frozen_checkpoint_sha256", "final_scoring_sha256", "final_panel_sha256", "final_split_sha256",
                     "final_reservation_sha256", "final_policy_sha256", "final_admission_sha256",
                     "source_crosswalk_sha256", "candidate_sha256", "postimage_sha256", "seed", "arm"))
                 and candidate_review.get("status") in ("all_gates_passed", "did_not_clear", "evidence_incomplete")
                 and type(candidate_review.get("rows")) is dict
                 and tuple(candidate_review["rows"]) == tuple(case.row_id for case in policy.cases),
                 "candidate findings must be the independently issued review of the exact numerical result and retention")
    protected.update(asdict(retention_selection).values())
    if retention_reference is not None:
        protected.update(asdict(retention_reference.original_parent_evidence).values())
        protected.add(retention_reference.assessment_receipt_sha256)
    selection = (plan.study_sha256, plan.candidate_freeze_sha256, plan.development_comparison_sha256,
                 scope.expected_plan_sha256, plan.final_retention_selection_sha256,
                 commitment((numerical_report, numerical_component_close_sha256)),
                 commitment(candidate_review), reference_pin or commitment(None),
                 commitment((development_attempt, development_paid)))

    def current():
        review._check_no_edit_final_scope_pins(edit, scope, scope_identity)
        _require(final_resource_plan_commitment(plan) == expected_plan_sha256
                 and commitment(evidence) == expected_evidence_sha256
                 and commitment(study) == selection[0]
                 and commitment(scope.frozen_checkpoint) == selection[1]
                 and commitment(development_evidence) == selection[2]
                 and review.no_edit_final_review_commitment(edit, scope.plan) == selection[3]
                 and scope.scoring_owner.no_edit_final_scoring_commitment(edit, scope.scoring_plan)
                     == scoring_pin
                 and review.no_edit_final_retention_selection_commitment(edit, retention_selection) == selection[4]
                 and commitment((numerical_report, numerical_component_close_sha256)) == selection[5]
                 and commitment(candidate_review) == selection[6]
                 and (retention_reference.digest(edit) if retention_reference is not None else commitment(None)) == selection[7]
                 and commitment((development_attempt, development_paid)) == selection[8],
                 "selected no-edit review, original costs or FINAL physical closures changed")
        if numerical_report is not None or retention_reference is not None:
            review._check_policy(edit, policy, policy_pin, panel, panel_pin)

    protected.update((*selection, expected_plan_sha256, expected_evidence_sha256))
    events = _event_roster(evidence.events)
    attempted = {activity.evaluation_sha256 for activity in plan.activities}
    by_close = {event.close_receipt_sha256: event for event in events.values()}
    _require(attempted.isdisjoint(protected) and set(events).isdisjoint(protected | attempted)
             and set(by_close).isdisjoint(protected | attempted | set(events)) and len(by_close) == len(events)
             and all(event.kind != ACTIVATION_EVENT_KIND for event in events.values()),
             "FINAL cannot reuse DEVELOPMENT, score or reservation identities or double-charge original work")
    allocations = {pin: [] for pin in events}
    closes, meter_receipts, results = set(), {}, []
    meter_exclusions = protected | attempted | set(events) | set(by_close)
    completed = set()
    retained_numerical_component = False
    checkpoints = {"candidate": frozen["candidate_sha256"], "baseline": retention_selection.baseline_checkpoint_sha256}
    selected_report = candidate_review if candidate_review is not None else numerical_report
    if numerical_component_close_sha256 is not None:
        selected_report = None
    for activity, (terminal, meter, interval, charges) in zip(plan.activities, evidence.closes, strict=True):
        _check_final_terminal_header(activity, terminal)
        _require((activity.frozen_checkpoint_sha256, activity.checkpoint_sha256) ==
                 (plan.candidate_freeze_sha256, checkpoints[activity.role]),
                 "physical FINAL activity must bind its exact checkpoint manifest and frozen selection")
        report_pin = None
        if terminal.status == "complete":
            _require(activity.role not in completed and bool(terminal.component_owner_close_sha256s),
                     "each completed FINAL role needs distinct original paid components")
            completed.add(activity.role)
            if activity.role == "candidate":
                _require(selected_report is not None and type(terminal.report) is dict
                         and commitment(terminal.report) == commitment(selected_report)
                         and terminal.baseline_receipt_sha256 is None,
                         "completed candidate must bind the exact issued review or score-only result")
                report_pin = review_pin if candidate_review is not None else numerical_pin
            else:
                _require(retention_reference is not None and terminal.report is None
                         and terminal.baseline_receipt_sha256 == retention_reference.assessment_receipt_sha256,
                         "completed comparator must bind its exact independent retention receipt")
        else:
            _require(terminal.report is None and terminal.baseline_receipt_sha256 is None,
                     "failed or refused FINAL work cannot issue a completed result")
        new_closes = {terminal.terminal_close_sha256, *terminal.component_owner_close_sha256s}
        _require(len(new_closes) == 1 + len(terminal.component_owner_close_sha256s)
                 and new_closes.isdisjoint(protected | attempted | set(events) | closes),
                 "FINAL terminal and components must use distinct original physical close identities")
        closes.update(new_closes)
        shares, result = _measure_final_activity(validator, plan, expected_plan_sha256, activity, terminal,
            meter, interval, charges, events, report_pin, require_paid_terminal=True)
        _fixed_stage_meter_receipts(meter_receipts, meter_exclusions, meter, interval)
        _require(all(close in by_close and shares.get(by_close[close].event_sha256) == 1
                     and (terminal.status != "complete" or by_close[close].disposition == "complete")
                     for close in terminal.component_owner_close_sha256s),
                 "each recorded FINAL component must have its original exclusive paid close")
        if numerical_component_close_sha256 in terminal.component_owner_close_sha256s:
            _require(activity.role == "candidate" and terminal.status != "complete"
                     and by_close[numerical_component_close_sha256].disposition == "complete",
                     "retained score must bind the original completed numerical component of an unsuccessful candidate")
            retained_numerical_component = True
        for event_pin, share in shares.items():
            allocations[event_pin].append(share)
        result["interval"] = _wire(interval)
        results.append(result)

    _require(completed == {role for role, body in (("candidate", selected_report), ("baseline", retention_reference))
                           if body is not None},
             "each supplied FINAL result needs its own completed physical activity")
    _require(numerical_component_close_sha256 is None or retained_numerical_component,
             "retained score is missing its original completed numerical component")
    _require_conserved_allocations(allocations, plan.shared_event_consumers)
    shared = tuple(pin for pin, shares in allocations.items() if len(shares) > 1)
    _require(all(events[pin].kind == "startup" and events[pin].disposition == "complete" for pin in shared),
             "only originally completed startup can be shared across FINAL activities")
    current()
    for owner, arguments in (
        (verify_selection_owner, (expected_plan_sha256, expected_evidence_sha256, selection)),
        (replay_development_cost_owner, (study, development_evidence, selection[2])),
        (verify_final_resource_owner, (expected_plan_sha256, expected_evidence_sha256, selection)),
    ):
        _require(owner(*arguments) is True, "original no-edit FINAL selection or resource owner refused the exact evidence")
        current()
    return {"schema": JOINT_NO_EDIT_FINAL_PAID_SCHEMA, "study_sha256": plan.study_sha256,
            "frozen_checkpoint_sha256": plan.candidate_freeze_sha256,
            "development_cost_evidence_sha256": selection[2], "review_plan_sha256": selection[3],
            "final_resource_plan_sha256": expected_plan_sha256, "final_resource_evidence_sha256": expected_evidence_sha256,
            "numerical_report_sha256": numerical_pin, "numerical_component_close_sha256": numerical_component_close_sha256,
            "review_report_sha256": review_pin,
            "retention_reference_sha256": reference_pin,
            "candidate_review_status": None if candidate_review is None else candidate_review["status"],
            "retention_roster_complete": reference_known, "activities": tuple(results),
            "physical_paid_events": tuple(_wire(event) for event in evidence.events),
            "physical_work_ns": _physical_work_ns(events), "development_physical_work_ns": _physical_work_ns(prior),
            "shared_startup_event_sha256s": shared, "wall_time_to_threshold_seconds": None, "dispatch_authority": False}


FIRST_USE_SHARED_WORK_EVENT_KINDS = frozenset({"teacher_production", "behavior_rollout"})


FIRST_USE_SHARED_WORK_SCHEMA = "reviewed-matched-first-use-shared-work/v1"


FIRST_USE_INTERRUPTED_PREPARATION_SCHEMA = "reviewed-matched-first-use-shared-work/v2"


def first_use_shared_work_commitment(shared_work, *, interrupted_preparation_events=()):
    """Bind shared events and any specifically selected interrupted preparation."""
    _require(type(shared_work) is dict and bool(shared_work)
             and all(_pin(event) and type(pair) is tuple and len(pair) == 2
                     and all(_pin(attempt) for attempt in pair) and pair[0] != pair[1]
                     for event, pair in shared_work.items()),
             "exact independently selected first-use shared event and ordered pair roster required")
    _require(type(interrupted_preparation_events) is tuple
             and all(_pin(event) and event in shared_work for event in interrupted_preparation_events)
             and interrupted_preparation_events == tuple(sorted(set(interrupted_preparation_events))),
             "exact ordered distinct interrupted teacher preparation subset required")
    roster = tuple(sorted(shared_work.items()))
    if interrupted_preparation_events:
        return commitment((FIRST_USE_INTERRUPTED_PREPARATION_SCHEMA, roster, interrupted_preparation_events))
    return commitment((FIRST_USE_SHARED_WORK_SCHEMA, roster))


def _closed_final_candidate_report(activity, terminal):
    _require(type(terminal) is FinalTerminal and terminal.evaluation_sha256 == activity.evaluation_sha256
             and _pin(terminal.terminal_close_sha256)
             and type(terminal.status) is str and terminal.status in CLOSED_EVENT_OUTCOMES
             and type(terminal.component_owner_close_sha256s) is tuple
             and all(_pin(value) for value in terminal.component_owner_close_sha256s)
             and len(set(terminal.component_owner_close_sha256s)) == len(terminal.component_owner_close_sha256s),
             "exact physical terminal close and recorded final component closures required")
    report = terminal.report
    if terminal.status != "complete":
        _require(report is None and terminal.baseline_receipt_sha256 is None,
                 "unsuccessful final closure cannot supply a completed panel report or baseline result")
        return None
    if activity.role == "baseline":
        _require(report is None and _pin(terminal.baseline_receipt_sha256)
                 and bool(terminal.component_owner_close_sha256s),
                 "complete baseline close requires its independent baseline receipt and component closures")
        return None
    _require(type(report) is dict and terminal.baseline_receipt_sha256 is None,
             "complete candidate close must bind its exact panel report and cannot supply a baseline receipt")
    return report


def _t5_fusion_final_paid_slot(assessor, scoring, assessment, frozen, freeze_plan, comparison, plan):
    subject = assessor.t5_fusion_span_final_review_subject(scoring, assessment)
    _require(type(frozen) is dict and frozen.get("schema") == assessor.T5_FUSION_SPAN_FINAL_FREEZE_SCHEMA
             and frozen.get("final_scoring_selected") is False
             and commitment(frozen) == scoring.frozen_roster_sha256
             and assessor.t5_fusion_span_final_freeze_plan_commitment(freeze_plan) == frozen.get("plan_sha256")
             and (assessment.study_sha256, frozen.get("study_sha256"), freeze_plan.study_sha256) == (plan.study_sha256,) * 3
             and (subject, assessment.panel_sha256, assessment.evaluation_policy_sha256,
                  assessment.retention_reference_sha256) == (plan.candidate_freeze_sha256, plan.final_panel_sha256,
                  plan.final_policy_sha256, plan.final_retention_selection_sha256)
             and (frozen.get("global_split_sha256"), frozen.get("final_reservation_sha256"),
                  frozen.get("reserved_final_count"), frozen.get("clock"), frozen.get("final_policy_sha256"))
                 == (freeze_plan.global_split_sha256, freeze_plan.final_reservation_sha256, freeze_plan.reserved_final_count,
                     freeze_plan.clock, freeze_plan.final_policy_sha256)
             and freeze_plan.final_policy_sha256 == plan.final_policy_sha256,
             "policy FINAL resource plan must retain the independently frozen slot, panel and retention selection")
    _require(type(comparison) is dict and comparison.get("schema") in (assessor.T5_FUSION_PAID_VALIDATION_SCHEMA,
                assessor.T5_FUSION_STARTED_DEVELOPMENT_PAID_VALIDATION_SCHEMA,
                assessor.T5_FUSION_INTERRUPTED_PREPARATION_PAID_VALIDATION_SCHEMA)
             and comparison["schema"] == frozen.get("t5_fusion_paid_comparison_schema")
             and comparison.get("cost_evidence_sha256") == frozen.get("t5_fusion_development_cost_evidence_sha256")
                 == freeze_plan.development_cost_evidence_sha256
             and comparison.get("t5_fusion_upstream_costs_sha256") == frozen.get("t5_fusion_upstream_costs_sha256")
                 == freeze_plan.development_upstream_costs_sha256
             and frozen.get("confirming_clock_basis") == ("observed_elapsed" if freeze_plan.clock == "wall_seconds" else "allocated_work")
             and comparison.get("cost_basis") == "first_use" and comparison.get("reuse_count") is None
             and comparison.get("study_sha256") == plan.study_sha256
             and _pin(comparison.get("t5_fusion_span_paid_looks_sha256"))
             and comparison["t5_fusion_span_paid_looks_sha256"] == frozen.get("t5_fusion_span_paid_looks_sha256")
             and comparison.get("contrast_plan_sha256") == freeze_plan.contrast_plan_sha256
             and commitment(comparison) == plan.development_comparison_sha256 == frozen.get("development_comparison_sha256"),
             "policy FINAL costs must retain the original verified first-use VALIDATION comparison")
    scope = comparison.get("t5_fusion_span_validation")
    _require(type(scope) is dict and scope.get("role") == "development"
             and type(scope.get("reserved_final_count")) is int and type(scope.get("optimizer_steps")) is int
             and scope["optimizer_steps"] > 0
             and (scope.get("split_selection_sha256"), scope.get("global_split_sha256"), scope.get("optimizer_step_grid_sha256"),
                  scope["reserved_final_count"]) == (freeze_plan.validation_split_sha256, freeze_plan.global_split_sha256,
                  freeze_plan.optimizer_step_grid_sha256, freeze_plan.reserved_final_count),
             "policy FINAL costs do not bind the selected VALIDATION split, grid and untouched reserve")
    bindings = comparison.get("t5_fusion_span_seed_bindings")
    _require(type(bindings) in (tuple, list) and all(type(row) in (tuple, list) and len(row) == 2
             and _name(row[0]) and type(row[1]) is int for row in bindings)
             and len({row[0] for row in bindings}) == len(bindings) == len({row[1] for row in bindings})
             and dict(bindings).get(scoring.study_seed) == assessment.seed,
             "policy FINAL resource selection changed the named or native seed")
    slots, attempts = frozen.get("slots"), comparison.get("attempts")
    fields = ("seed", "arm", "attempt_sha256", "closeout_receipt_sha256")
    _require(all(type(rows) in (tuple, list) and bool(rows) and all(type(row) is dict and _name(row.get("seed"))
                 and _name(row.get("arm")) and _pin(row.get("attempt_sha256")) and _pin(row.get("closeout_receipt_sha256"))
                 for row in rows) for rows in (slots, attempts))
             and tuple(tuple(row[key] for key in fields) for row in slots) ==
                 tuple(tuple(row[key] for key in fields) for row in attempts),
             "policy FINAL costs must retain all original paid attempts, including unavailable arms")
    def selected(row):
        return (row.get("seed"), row.get("arm"), row.get("attempt_sha256")) == (
            scoring.study_seed, assessment.arm, assessment.attempt_sha256)
    slot = _one_final_row(slots, selected, "one original policy FINAL cost slot required")
    attempt = _one_final_row(attempts, selected, "one original paid VALIDATION attempt required")
    checkpoint = slot.get("checkpoint")
    _require(slot.get("status") == "frozen" and type(slot.get("attained")) is int and slot["attained"] == 1
             and slot.get("reason") == "confirmed_within_horizon" and type(checkpoint) is dict
             and type(checkpoint.get("optimizer_steps")) is int and checkpoint["optimizer_steps"] == assessment.optimizer_steps == scope["optimizer_steps"]
             and type(checkpoint.get("candidate")) is dict
             and checkpoint["candidate"].get("sha256") == assessment.candidate_sha256
             and checkpoint.get("trial_terminal_close_sha256") == assessment.trial_terminal_close_sha256
             and checkpoint.get("policy_attempt_sha256") == assessment.policy_attempt_sha256,
             "unavailable or changed policy FINAL checkpoint cannot carry this paid activity")
    look = _one_final_row(attempt.get("look_evidence"), lambda row: row.get("look") == checkpoint.get("confirming_look"),
                          "one original paid confirming look required for policy FINAL")
    confirmation = (look.get("checkpoint_sha256"), look.get("evaluation_receipt_sha256"), look.get("meter_record_sha256"))
    _require(all(_pin(pin) for pin in confirmation) and confirmation == (assessment.candidate_sha256,
                 checkpoint.get("development_evaluation_sha256"), checkpoint.get("development_meter_sha256")),
             "policy FINAL checkpoint does not retain the original confirming VALIDATION evidence")
    arms = assessor.DECISION_SPAN_POLICY_ARMS
    contrast = _one_final_row(comparison.get("contrasts"),
        lambda row: (row.get("baseline"), row.get("candidate"), row.get("role")) == (*arms, "primary"),
        "one original policy VALIDATION contrast required for FINAL costs")
    pair = _one_final_row(comparison.get("pairs"), lambda row: (
        row.get("seed"), row.get("clock"), row.get("contrast_id"), row.get("baseline"), row.get("candidate"), row.get("role"))
        == (scoring.study_seed, freeze_plan.clock, contrast.get("identifier"), *arms, "primary"),
        "one original selected-clock policy VALIDATION pair required for FINAL costs")
    side = "baseline" if assessment.arm == arms[0] else "candidate"
    elapsed, horizon = pair.get("observed_" + side + "_confirmation"), pair.get("horizon")
    decision = attempt.get("decision")
    confirming_costs = decision.get("confirming_costs") if type(decision) is dict else None
    _require(type(elapsed) is float and isfinite(elapsed) and type(horizon) is float and isfinite(horizon)
             and 0 <= elapsed <= horizon and type(checkpoint.get("elapsed")) is float and checkpoint["elapsed"] == elapsed
             and type(pair.get(side + "_attained")) is int and pair[side + "_attained"] == 1
             and pair.get(side + "_reason") == slot["reason"] and pair.get(side + "_attempt_sha256") == assessment.attempt_sha256
             and "confirmation_budget_block" in attempt and attempt["confirmation_budget_block"] is None
             and type(decision) is dict and decision.get("status") == "reached"
             and decision.get("confirming_checkpoint") == checkpoint["confirming_look"]
             and type(confirming_costs) is dict and type(confirming_costs.get(freeze_plan.clock)) is float
             and confirming_costs[freeze_plan.clock] == elapsed,
             "policy FINAL paid slot disagrees with its original VALIDATION attainment or selected clock")
    return subject, checkpoint


_T5_FUSION_FINAL_ESTIMATOR_PROVENANCE = "t5_fusion_estimator_profile_provenance"


_T5_FUSION_FINAL_ESTIMATOR_PINS = ("estimator_freeze_selection_sha256", "profiled_paid_comparison_sha256",
                                   "estimator_profile_selection_sha256", "original_frozen_roster_sha256")


def _t5_fusion_final_estimator_ids(provenance):
    _require(type(provenance) is dict and set(provenance) == {*_T5_FUSION_FINAL_ESTIMATOR_PINS,
                 "schema", "estimator_profile"}
             and provenance["schema"] == "reviewed-t5-fusion-estimator-profile-freeze-provenance/v1"
             and type(provenance["estimator_profile"]) is str and bool(provenance["estimator_profile"])
             and all(_pin(provenance.get(field)) for field in _T5_FUSION_FINAL_ESTIMATOR_PINS),
             "exact frozen estimator provenance identities required for FINAL cost isolation")
    return {commitment(provenance), *(provenance[field] for field in _T5_FUSION_FINAL_ESTIMATOR_PINS)}


def _t5_fusion_final_estimator_profile(assessor, frozen, *, expected_frozen_roster_sha256,
        estimator_profile_selection, expected_estimator_profile_selection_sha256,
        expected_estimator_freeze_selection_sha256):
    _require(type(frozen) is dict, "exact frozen roster required for FINAL estimator readback")
    if _T5_FUSION_FINAL_ESTIMATOR_PROVENANCE not in frozen:
        _require(estimator_profile_selection is None and expected_estimator_profile_selection_sha256 is None
                 and expected_estimator_freeze_selection_sha256 is None,
                 "FINAL estimator selection requires a profile-bearing frozen roster")
        return None
    _require(callable(getattr(assessor, "read_t5_fusion_frozen_estimator_profile", None))
             and estimator_profile_selection is not None and _pin(expected_estimator_profile_selection_sha256)
             and _pin(expected_estimator_freeze_selection_sha256),
             "profile-bearing FINAL requires its independently selected profile and freeze")
    profile = assessor.read_t5_fusion_frozen_estimator_profile(frozen,
        expected_frozen_roster_sha256=expected_frozen_roster_sha256,
        expected_estimator_freeze_selection_sha256=expected_estimator_freeze_selection_sha256,
        estimator_profile_selection=estimator_profile_selection,
        expected_estimator_profile_selection_sha256=expected_estimator_profile_selection_sha256)
    _t5_fusion_final_estimator_ids(profile)
    _require(profile == frozen[_T5_FUSION_FINAL_ESTIMATOR_PROVENANCE]
             and (profile["estimator_profile_selection_sha256"], profile["estimator_freeze_selection_sha256"])
                 == (expected_estimator_profile_selection_sha256, expected_estimator_freeze_selection_sha256),
             "FINAL estimator reader must return the exact selected frozen provenance")
    return dict(profile)


def _t5_fusion_final_matches_estimator(envelope, profile):
    key = _T5_FUSION_FINAL_ESTIMATOR_PROVENANCE
    return type(envelope) is dict and (key not in envelope if profile is None else envelope.get(key) == profile)


def _t5_fusion_final_check_settlement_estimators(cells, profile):
    _require(all(cell.verified_resources is None or _t5_fusion_final_matches_estimator(cell.verified_resources, profile)
                 for cell in cells),
             "started paired FINAL cell must retain its selected estimator settlement provenance")


def _t5_fusion_final_prior_ids(frozen, comparison):
    excluded = {frozen["final_reservation_sha256"]}
    if _T5_FUSION_FINAL_ESTIMATOR_PROVENANCE in frozen:
        excluded.update(_t5_fusion_final_estimator_ids(frozen[_T5_FUSION_FINAL_ESTIMATOR_PROVENANCE]))
    for attempt in comparison["attempts"]:
        excluded.update((attempt["attempt_sha256"], attempt["closeout_receipt_sha256"]))
        looks = attempt.get("look_evidence")
        _require(type(looks) in (tuple, list) and all(type(row) is dict and _pin(row.get("evaluation_receipt_sha256"))
                 for row in looks), "exact paid VALIDATION look identities required")
        excluded.update(row["evaluation_receipt_sha256"] for row in looks)
        paid = attempt.get("cost_evidence")
        _require(type(paid) is dict and type(paid.get("looks")) in (tuple, list)
                 and all(type(row) is dict for row in paid["looks"]),
                 "exact prior fused DEVELOPMENT paid meter roster required")
        for meter in (paid.get("closing_meter"), *(row.get("meter") for row in paid["looks"])):
            _require(type(meter) is dict and _pin(meter.get("record_sha256"))
                     and type(meter.get("clock_receipts")) in (tuple, list)
                     and len(meter["clock_receipts"]) == len(COVERED_CLOCKS)
                     and all(value is None or _pin(value) for value in meter["clock_receipts"]),
                     "exact prior fused DEVELOPMENT meter and clock receipts required")
            excluded.add(meter["record_sha256"])
            excluded.update(value for value in meter["clock_receipts"] if value is not None)
    for slot in frozen["slots"]:
        checkpoint = slot.get("checkpoint")
        _require("checkpoint" in slot and (checkpoint is None or type(checkpoint) is dict
                 and _pin(checkpoint.get("trial_terminal_close_sha256"))),
                 "exact original policy training terminals required")
        if checkpoint is not None:
            excluded.add(checkpoint["trial_terminal_close_sha256"])
    for field in ("physical_paid_events", "t5_fusion_span_unobserved_arms"):
        rows = comparison.get(field) if field == "physical_paid_events" else comparison.get(field, ())
        keys = ("event_sha256", "close_receipt_sha256") if field == "physical_paid_events" else ("owner_close_sha256",)
        _require(type(rows) in (tuple, list) and all(type(row) is dict and all(_pin(row.get(key)) for key in keys)
                 for row in rows), "exact prior physical event and close identities required")
        excluded.update(row[key] for row in rows for key in keys)
    for rows in (comparison.get("t5_fusion_span_started_development", ()),
                 comparison.get("t5_fusion_span_interrupted_preparation", ())):
        _require(type(rows) in (tuple, list) and all(type(row) is dict and _pin(row.get("owner_receipt_sha256"))
                 and _pin(row.get("training_close_sha256")) for row in rows),
                 "exact prior fused DEVELOPMENT phase receipts required")
        excluded.update(row[key] for row in rows for key in ("owner_receipt_sha256", "training_close_sha256"))
    for field, required_span in (("observed_elapsed_wall", False), ("t5_fusion_upstream_costs", True),
                                 ("t5_fusion_span_interrupted_preparation_costs", True)):
        rows = comparison.get(field, ())
        key = "interval" if required_span else "wall"
        _require(type(rows) in (tuple, list) and all(type(row) is dict for row in rows),
                 "exact prior fused DEVELOPMENT observed intervals required")
        for row in rows:
            span = row.get(key)
            _require((not required_span and span is None) or (type(span) is dict and _pin(span.get("receipt_sha256"))),
                     "original fused DEVELOPMENT clock receipt required")
            if span is not None:
                excluded.add(span["receipt_sha256"])
    return excluded


def _t5_fusion_final_report_pin(validator, assessor, plan, activity, terminal, report, scoring, assessment, freeze_plan,
                                checkpoint, reference_pin, baseline_checkpoint, retention_reference):
    _require(type(report) is dict and report.get("schema") == assessor.T5_FUSION_FINAL_REPORT_SCHEMA
             and (report.get("study_sha256"), report.get("final_panel_sha256"), report.get("final_policy_sha256"),
                  report.get("retention_selection_sha256")) == (plan.study_sha256, plan.final_panel_sha256,
                  plan.final_policy_sha256, plan.final_retention_selection_sha256)
             and (report.get("frozen_checkpoint_sha256"), report.get("frozen_roster_sha256"), report.get("study_seed"),
                  report.get("arm"), report.get("trained_attempt_sha256"), report.get("checkpoint_sha256"))
                 == (plan.candidate_freeze_sha256, scoring.frozen_roster_sha256, scoring.study_seed, assessment.arm,
                     assessment.attempt_sha256, activity.checkpoint_sha256)
             and (report.get("final_evaluation_sha256"), report.get("final_terminal_close_sha256"))
                 == (activity.evaluation_sha256, terminal.terminal_close_sha256)
             and report.get("final_reservation_sha256") == freeze_plan.final_reservation_sha256
             and type(report.get("optimizer_steps")) is int and report["optimizer_steps"] == checkpoint["optimizer_steps"]
             and report.get("optimizer_step_grid_sha256") == freeze_plan.optimizer_step_grid_sha256
             and all(_pin(report.get(key)) for key in ("review_sha256", "matched_pair_sha256", "scoring_roster_sha256"))
             and "retention_reference_sha256" in report and report["retention_reference_sha256"] == reference_pin
             and "baseline_checkpoint_sha256" in report and report["baseline_checkpoint_sha256"] == baseline_checkpoint,
             "paid policy FINAL report differs from its approved arm, checkpoint, step or retention")
    rows = report.get("rows")
    closes = report.get("component_closes")
    scoring_pins = report.get("component_scoring_sha256s")
    _require(type(rows) in (tuple, list) and len(rows) == freeze_plan.reserved_final_count
             and _final_gate_row_shape(rows)
             and all(_name(row.get("row_id")) and type(row.get("producer_outcome")) is str
                     and row["producer_outcome"] in assessor.MODEL_OUTCOMES and _pin(row.get("generation_sha256"))
                     and "candidate_sha256" in row
                     and (_pin(row["candidate_sha256"]) if row["producer_outcome"] == "complete" else
                          row["candidate_sha256"] is None) for row in rows)
             and len({row["row_id"] for row in rows}) == len(rows)
             and type(closes) in (tuple, list) and bool(closes)
             and all(type(close) is dict and all(_pin(close.get(key)) for key in (
                 "observation_sha256", "artifact_sha256", "owner_close_sha256")) for close in closes)
             and tuple(close["owner_close_sha256"] for close in closes) == terminal.component_owner_close_sha256s
             and type(scoring_pins) in (tuple, list) and len(scoring_pins) == len(closes)
             and all(_pin(pin) for pin in scoring_pins) and len(set(scoring_pins)) == len(scoring_pins)
             and report["scoring_roster_sha256"] ==
                 commitment((assessor.T5_FUSION_FINAL_REPORT_SCHEMA, "scoring-roster", tuple(scoring_pins))),
             "paid policy FINAL report must retain every reserved row and exact ordered component close")
    _final_counts_from_rows(validator, rows, report.get("counts"), retention_reference)
    bindings = report.get("component_teacher_bindings")
    fields = {"dependency_group_sha256", "final_batch_sha256", "t5_fusion_assessment_binding_sha256",
              "matched_teacher_inputs_sha256", "component_owner_close_sha256"}
    _require(type(bindings) in (tuple, list) and len(bindings) == len(closes)
             and all(type(row) is dict and set(row) == fields and all(_pin(value) for value in row.values())
                     for row in bindings)
             and tuple(row["component_owner_close_sha256"] for row in bindings) == terminal.component_owner_close_sha256s
             and len({row["dependency_group_sha256"] for row in bindings}) == len(bindings)
             and len({row["final_batch_sha256"] for row in bindings}) == len(bindings),
             "paid fused FINAL report requires exact ordered unique teacher component roles")
    selected_pin = assessor.t5_fusion_span_final_scoring_commitment(scoring, assessment)
    selected = dict(zip(scoring_pins, bindings, strict=True)).get(selected_pin)
    _require(selected is not None
             and (selected["dependency_group_sha256"], selected["t5_fusion_assessment_binding_sha256"],
                  selected["matched_teacher_inputs_sha256"]) ==
                 (assessment.dependency_group_sha256, assessment.t5_fusion_assessment_binding_sha256,
                  assessment.matched_teacher_inputs_sha256),
             "paid fused FINAL scoring selection must match its exact teacher component")
    return commitment(report), {row["dependency_group_sha256"]: row["final_batch_sha256"] for row in bindings}


T5_FUSION_FINAL_RESOURCE_RESULT_SCHEMA = "verified-t5-fusion-span-final-evaluation-resources/v1"


T5_FUSION_FINAL_TEACHER_COSTS_SCHEMA = "reviewed-t5-fusion-final-teacher-costs/v1"


@dataclass(frozen=True)
class T5FusionFinalTeacherCost:
    """Physical source-only FINAL preparation in one original activity."""

    evaluation_sha256: str
    dependency_group_sha256: str
    final_batch_sha256: str | None
    event_sha256: str
    owner_close_sha256: str
    interval: WallSpan


def t5_fusion_final_teacher_costs_commitment(costs, *, plan_sha256, evidence_sha256):
    """Select an exact teacher work roster independently of the grade."""
    _require(_pin(plan_sha256) and _pin(evidence_sha256) and type(costs) is tuple
             and all(type(row) is T5FusionFinalTeacherCost and all(_pin(value) for value in (
                    row.evaluation_sha256, row.dependency_group_sha256, row.event_sha256, row.owner_close_sha256))
                    and (row.final_batch_sha256 is None or _pin(row.final_batch_sha256))
                    and type(row.interval) is WallSpan
                    and _pin(row.interval.clock_domain_sha256) and _pin(row.interval.receipt_sha256)
                    and type(row.interval.start_ns) is type(row.interval.end_ns) is int
                    and 0 <= row.interval.start_ns <= row.interval.end_ns for row in costs)
             and len({row.event_sha256 for row in costs}) == len(costs),
             "exact unique closed fused FINAL teacher work roster required")
    return commitment((T5_FUSION_FINAL_TEACHER_COSTS_SCHEMA, plan_sha256, evidence_sha256, costs))


def _bind_t5_fusion_final_teacher_work(teacher_costs, events, activities, reserved):
    roster = {event_id for event_id, event in events.items() if event.kind == "teacher_production"}
    _require(roster == {row.event_sha256 for row in teacher_costs},
             "every physical FINAL teacher event requires its own selected preparation record")
    candidate_evaluations = {activity.evaluation_sha256 for activity in activities if activity.role == "candidate"}
    forbidden_intervals = reserved | {event.close_receipt_sha256 for event in events.values()}
    seen_intervals, by_evaluation = set(), {}
    for row in teacher_costs:
        event = events[row.event_sha256]
        receipt = row.interval.receipt_sha256
        _require(row.evaluation_sha256 in candidate_evaluations
                 and event.close_receipt_sha256 == row.owner_close_sha256
                 and (row.final_batch_sha256 is None or event.disposition == "complete")
                 and receipt not in forbidden_intervals and receipt not in seen_intervals,
                 "FINAL teacher preparation must retain its distinct original candidate close and clock")
        seen_intervals.add(receipt)
        by_evaluation.setdefault(row.evaluation_sha256, []).append(row)
    return roster, by_evaluation


def _require_t5_fusion_final_teacher_activity(rows, final_batches, events, teacher_events, shares, wall):
    by_event = {row.event_sha256: row for row in rows}
    _require({event_id for event_id in shares if event_id in teacher_events} == by_event.keys(),
             "FINAL activity must exclusively charge its own exact teacher preparation")
    if final_batches is not None:
        completed = {}
        for row in rows:
            group, batch = row.dependency_group_sha256, row.final_batch_sha256
            _require(group in final_batches and (batch == final_batches[group]
                     or batch is None and events[row.event_sha256].disposition != "complete"),
                     "FINAL teacher preparation must match its reviewed component batch")
            if batch is not None:
                completed[group] = batch
        _require(completed == final_batches,
                 "every reviewed fused FINAL component requires completed paid teacher preparation")
    for event_id, row in by_event.items():
        span = row.interval
        _require(shares[event_id] == 1 and type(wall) is WallSpan
                 and wall.clock_domain_sha256 == span.clock_domain_sha256
                 and wall.start_ns <= span.start_ns <= span.end_ns <= wall.end_ns,
                 "FINAL whole-activity elapsed interval must enclose its own teacher preparation on one clock")


def verify_paid_t5_fusion_span_final(validator, assessor, *, plan, expected_plan_sha256, scoring, assessment_plan,
        frozen, freeze_plan, development_comparison, retention_selection, retention_reference, evidence,
        expected_evidence_sha256, component_coverage, expected_coverage_sha256, expected_final_report_sha256,
        verify_final_resource_owner, verify_final_report_owner=None, teacher_costs, expected_teacher_costs_sha256,
        estimator_profile_selection=None, expected_estimator_profile_selection_sha256=None,
        expected_estimator_freeze_selection_sha256=None):
    """Verify first-use fused FINAL physical work, including failed preparation.

    Both owners authenticate only already-selected evidence. The resource owner
    authenticates all physical work, including source, component and activity
    scope for partial preparation without a reviewed report. Measured wall is
    elapsed once, and additive work is conserved across exclusive activities.
    The optional profile selection must already have been independently approved
    for this exact frozen roster. Its provenance does not represent physical work.
    """
    _require(tuple(validator.CLOCKS) == COVERED_CLOCKS and callable(verify_final_resource_owner)
             and all(_pin(value) for value in (expected_plan_sha256, expected_evidence_sha256,
                                               expected_coverage_sha256, expected_teacher_costs_sha256))
             and final_resource_plan_commitment(plan) == expected_plan_sha256
             and plan.shared_event_consumers is None,
             "exact first-use fused FINAL cost plan with an original candidate activity required")
    subject, checkpoint = _t5_fusion_final_paid_slot(assessor, scoring, assessment_plan, frozen, freeze_plan,
                                                     development_comparison, plan)

    def current_estimator_profile():
        return _t5_fusion_final_estimator_profile(assessor, frozen,
            expected_frozen_roster_sha256=scoring.frozen_roster_sha256,
            expected_estimator_freeze_selection_sha256=expected_estimator_freeze_selection_sha256,
            estimator_profile_selection=estimator_profile_selection,
            expected_estimator_profile_selection_sha256=expected_estimator_profile_selection_sha256)

    estimator_profile = current_estimator_profile()
    _require(type(retention_selection) is dict and set(retention_selection) == {
                 "frozen_checkpoint_sha256", "final_panel_sha256", "final_policy_sha256", "baseline_checkpoint_sha256"}
             and commitment(("reviewed-final-baseline-selection/v1", retention_selection)) == plan.final_retention_selection_sha256
             and (retention_selection["frozen_checkpoint_sha256"], retention_selection["final_panel_sha256"],
                  retention_selection["final_policy_sha256"]) == (subject, plan.final_panel_sha256, plan.final_policy_sha256)
             and (retention_selection["baseline_checkpoint_sha256"] is None
                  or _pin(retention_selection["baseline_checkpoint_sha256"])
                  and retention_selection["baseline_checkpoint_sha256"] != assessment_plan.candidate_sha256),
             "fused FINAL costs require the selected separately bound retention baseline")
    baseline_checkpoint = retention_selection["baseline_checkpoint_sha256"]
    reference_pin = None
    if retention_reference is not None:
        _require(type(retention_reference) is dict and set(retention_reference) == {
                     "seed", "panel_sha256", "evaluation_policy_sha256", "baseline_checkpoint_sha256",
                     "baseline_receipt_sha256", "row_fidelity"}
                 and (retention_reference["seed"], retention_reference["panel_sha256"],
                      retention_reference["evaluation_policy_sha256"], retention_reference["baseline_checkpoint_sha256"])
                      == (scoring.study_seed, plan.final_panel_sha256, plan.final_policy_sha256, baseline_checkpoint)
                 and all(_pin(retention_reference[key]) for key in ("baseline_checkpoint_sha256", "baseline_receipt_sha256")),
                 "fused FINAL retention reference differs from its original seed, panel, policy or baseline")
        reference_pin = commitment(("reviewed-relational-heldout-threshold-look/v1", "baseline-retention", retention_reference))
    _require(type(evidence) is FinalResourceEvidence and evidence.plan_sha256 == expected_plan_sha256
             and type(evidence.closes) is tuple and len(evidence.closes) == len(plan.activities)
             and all(type(close) is tuple and len(close) == 4 for close in evidence.closes)
             and commitment(evidence) == expected_evidence_sha256
             and type(component_coverage) is tuple and len(component_coverage) == len(plan.activities)
             and commitment(component_coverage) == expected_coverage_sha256,
             "exact ordered fused FINAL evidence and authenticated component coverage required")

    def current_teacher_costs():
        return t5_fusion_final_teacher_costs_commitment(
            teacher_costs, plan_sha256=expected_plan_sha256, evidence_sha256=expected_evidence_sha256)

    _require(current_teacher_costs() == expected_teacher_costs_sha256,
             "independently selected fused FINAL teacher cost roster required")
    prior = _t5_fusion_final_prior_ids(frozen, development_comparison)
    prior.update((subject, scoring.frozen_roster_sha256, plan.development_comparison_sha256))
    evaluation_ids = {activity.evaluation_sha256 for activity in plan.activities}
    events = _event_roster(evidence.events)
    by_close = {event.close_receipt_sha256: event_id for event_id, event in events.items()}
    occupied = prior | evaluation_ids | set(events)
    _require(len(by_close) == len(events) and set(by_close).isdisjoint(events)
             and prior.isdisjoint({*evaluation_ids, *events, *by_close}) and evaluation_ids.isdisjoint({*events, *by_close})
             and all(event.kind != ACTIVATION_EVENT_KIND for event in events.values()),
             "fused FINAL cannot reuse prior work, the reservation or another physical event close")
    reserved = set(occupied)
    reports, activity_receipts = [], set()
    for activity, (terminal, meter, interval, charges) in zip(plan.activities, evidence.closes, strict=True):
        _require(activity.frozen_checkpoint_sha256 == subject
                 and activity.checkpoint_sha256 == (assessment_plan.candidate_sha256 if activity.role == "candidate" else baseline_checkpoint),
                 "physical fused FINAL activity differs from the selected frozen candidate or baseline")
        reports.append(_closed_final_candidate_report(activity, terminal))
        _require(type(interval) is MeterInterval and type(meter) is Meter
                 and (interval.wall is None or type(interval.wall) is WallSpan)
                 and type(meter.clock_receipts) is tuple,
                 "fused FINAL requires exact typed activity meter and interval")
        receipts = {interval.scope_receipt_sha256, meter.record_sha256}
        receipts.update(value for value in meter.clock_receipts if value is not None)
        if interval.wall is not None:
            receipts.add(interval.wall.receipt_sha256)
        _require(all(_pin(value) for value in receipts) and receipts.isdisjoint(prior | activity_receipts),
                 "fused FINAL meter, scope and clock receipt cannot reuse DEVELOPMENT or another activity")
        activity_receipts.update(receipts)
        reserved.update(receipts)
    teacher_events, by_evaluation = _bind_t5_fusion_final_teacher_work(teacher_costs, events, plan.activities, reserved)
    teacher_close_ids = {row.owner_close_sha256 for row in teacher_costs}
    teacher_interval_ids = {row.interval.receipt_sha256 for row in teacher_costs}
    _require(teacher_close_ids.isdisjoint(reserved),
             "fused FINAL teacher close cannot substitute for an activity meter or scope receipt")
    allocations = {event_id: [] for event_id in events}
    used_closes = occupied | teacher_close_ids | teacher_interval_ids
    baselines, activities = set(), []
    candidate_report = None
    for activity, (terminal, meter, interval, charges), coverage, report in zip(
            plan.activities, evidence.closes, component_coverage, reports, strict=True):
        new_closes = (terminal.terminal_close_sha256, *terminal.component_owner_close_sha256s)
        if terminal.baseline_receipt_sha256 is not None:
            new_closes += (terminal.baseline_receipt_sha256,)
            _require(not baselines and terminal.baseline_receipt_sha256 not in by_close,
                     "only one independently selected complete fused FINAL baseline may supply a retention receipt")
            baselines.add(terminal.baseline_receipt_sha256)
        _require(len(set(new_closes)) == len(new_closes) and used_closes.isdisjoint(new_closes),
                 "fused FINAL terminal and component closes must be distinct from prior work and teacher preparation")
        used_closes.update(new_closes)
        report_pin, final_batches = None, None
        if report is not None:
            _require(candidate_report is None, "only one preselected fused FINAL candidate completion may supply findings")
            report_pin, final_batches = _t5_fusion_final_report_pin(validator, assessor, plan, activity, terminal, report,
                scoring, assessment_plan, freeze_plan, checkpoint, reference_pin, baseline_checkpoint, retention_reference)
            candidate_report = (report_pin, report["review_sha256"], subject)
        shares, activity_result = _measure_final_activity(validator, plan, expected_plan_sha256, activity, terminal,
            meter, interval, charges, events, report_pin, require_paid_terminal=True)
        terminal_event_id = by_close[terminal.terminal_close_sha256]
        _require(events[terminal_event_id].kind == "closeout",
                 "every fused FINAL terminal requires its own paid closeout event")
        preparation = by_evaluation.get(activity.evaluation_sha256, ())
        _require_t5_fusion_final_teacher_activity(preparation, final_batches, events, teacher_events, shares, interval.wall)
        _require(type(coverage) is tuple and all(type(pair) is tuple and len(pair) == 2 and _pin(pair[0]) and _pin(pair[1])
                 for pair in coverage) and tuple(close for close, _ in coverage) == terminal.component_owner_close_sha256s
                 and len({event_id for _, event_id in coverage}) == len(coverage)
                 and all(event_id not in teacher_events and event_id != terminal_event_id
                         and shares.get(event_id) == 1 and by_close.get(close) == event_id
                         and events[event_id].kind == "evaluation"
                         and (terminal.status != "complete" or events[event_id].disposition == "complete")
                         for close, event_id in coverage),
                 "every ordered fused FINAL component requires its own paid execution, distinct from teacher production")
        for event_id, share in shares.items():
            allocations[event_id].append(share)
        activities.append({**activity_result, "component_event_coverage": coverage})

    _require(retention_reference is None or retention_reference["baseline_receipt_sha256"] in baselines,
             "fused FINAL baseline reference requires its own selected complete paid close")
    _require_conserved_allocations(allocations, None)
    _require((candidate_report is None and expected_final_report_sha256 is None)
             or (candidate_report is not None and _pin(expected_final_report_sha256)
                 and candidate_report[0] == expected_final_report_sha256 and callable(verify_final_report_owner)),
             "completed fused FINAL requires its independently selected reviewed report")

    def current():
        selections = (frozen, freeze_plan, development_comparison, scoring, assessment_plan,
                      retention_selection, retention_reference, component_coverage, expected_final_report_sha256)
        return (*tuple(commitment(value) for value in selections), current_teacher_costs())

    selection_pins = current()
    result = {"schema": T5_FUSION_FINAL_RESOURCE_RESULT_SCHEMA, "final_resource_plan_sha256": expected_plan_sha256,
              "final_resource_evidence_sha256": expected_evidence_sha256, "component_coverage_sha256": expected_coverage_sha256,
              "development_comparison_sha256": plan.development_comparison_sha256, "frozen_roster_sha256": scoring.frozen_roster_sha256,
              "frozen_checkpoint_sha256": subject, "study_seed": scoring.study_seed, "arm": assessment_plan.arm,
              "trained_attempt_sha256": assessment_plan.attempt_sha256, "checkpoint_sha256": assessment_plan.candidate_sha256,
              "optimizer_steps": checkpoint["optimizer_steps"], "final_report_sha256": expected_final_report_sha256,
              "retention_reference_sha256": reference_pin, "activities": tuple(activities),
              "t5_fusion_final_teacher_costs_sha256": expected_teacher_costs_sha256,
              "t5_fusion_final_teacher_costs": tuple(_wire(row) for row in teacher_costs),
              "physical_paid_events": tuple(_wire(event) for event in evidence.events), "physical_work_ns": _physical_work_ns(events)}
    if estimator_profile is not None:
        result[_T5_FUSION_FINAL_ESTIMATOR_PROVENANCE] = estimator_profile

    def unchanged():
        return (current() == selection_pins and final_resource_plan_commitment(plan) == expected_plan_sha256
                and commitment(evidence) == expected_evidence_sha256
                and current_estimator_profile() == estimator_profile)

    if candidate_report is not None:
        _require(verify_final_report_owner(*candidate_report) is True and unchanged(),
                 "independent fused FINAL report owner refused or selected evidence changed")
    _require(verify_final_resource_owner(expected_plan_sha256, expected_evidence_sha256, selection_pins) is True and unchanged(),
             "fused FINAL resource owner refused or selected cost evidence changed")
    return result


def _final_gate_row_shape(rows):
    names = ("source_fidelity", "formal_validity", "coverage", "abstention")
    return type(rows) in (tuple, list) and all(
        type(row) is dict and all(type(row.get(flag)) is bool for flag in ("review_eligible", "formal_required"))
        and all(key in row and (row[key] is None or type(row[key]) is bool) for key in names) for row in rows)


def _final_counts_from_rows(validator, rows, raw_counts, retention_reference):
    eligible = tuple(row for row in rows if row["review_eligible"])
    required = tuple(row for row in rows if row["formal_required"])
    baseline_known = retention_reference is not None
    retained = ()
    if baseline_known:
        fidelity = retention_reference.get("row_fidelity")
        _require(type(fidelity) in (tuple, list)
                 and all(type(pair) in (tuple, list) and len(pair) == 2
                         and (pair[1] is None or type(pair[1]) is bool) for pair in fidelity)
                 and tuple(pair[0] for pair in fidelity) == tuple(row["row_id"] for row in eligible),
                 "retention reference must cover exactly the original eligible roster in order")
        baseline_known = all(passed is not None for _, passed in fidelity)
        retained = tuple(row for row, (_, passed) in zip(eligible, fidelity, strict=True) if passed is True)
    rosters = {"source_fidelity": ("source_fidelity", eligible), "formal_validity": ("formal_validity", required),
               "retention": ("source_fidelity", retained), "coverage": ("coverage", rows), "abstention": ("abstention", rows)}
    counts = {}
    for gate, (key, roster) in rosters.items():
        values = tuple(row[key] for row in roster)
        known = all(value is not None for value in values) and (gate != "retention" or baseline_known)
        counts[gate] = validator.Counts(sum(value is True for value in values), len(values), known)
    _require(type(raw_counts) is dict and commitment(raw_counts) == commitment(counts),
             "final gate counts must reconcile with the authenticated rows and independent baseline")
    return counts


def _evaluate_final_cutoffs(validator, cutoffs, counts):
    unmeasured = validator.Costs(None, None, None)
    evaluated = validator.evaluate_threshold(schedule=("final",), thresholds=dict(cutoffs), required_streak=1,
        observed=(validator.Look("final", counts, unmeasured),), closeout=validator.Closeout("complete", unmeasured))
    looks = getattr(evaluated, "looks", None)
    _require(type(looks) is tuple and len(looks) == 1 and type(looks[0]) is tuple and len(looks[0]) == 2
             and looks[0][0] == "final" and type(looks[0][1]) is tuple,
             "threshold reducer must return one final observation")
    _, gates = looks[0]
    _require(all(type(gate) is validator.GateDecision and type(gate.status) is str
                 and gate.status in ("pass", "fail", "unavailable") for gate in gates)
             and tuple(gate.name for gate in gates) == FINAL_GATE_NAMES,
             "threshold reducer must return every final gate with a recognized disposition")
    gate_decisions = _wire(gates)
    dispositions = {gate.status for gate in gates}
    status = ("cutoffs_passed" if dispositions == {"pass"} else "cutoffs_failed"
              if "fail" in dispositions else "cutoffs_unavailable")
    return status, gate_decisions


T5_FUSION_FINAL_DECISION_SCHEMA = "reviewed-t5-fusion-span-policy-final-panel-decision/v1"


def evaluate_paid_t5_fusion_span_final_decision(validator, assessor, *, plan, expected_plan_sha256,
        resource_plan, scoring, assessment_plan, frozen, freeze_plan, development_comparison,
        verified_resources, expected_resources_sha256, final_report, retention_reference,
        verify_final_decision_owner):
    """Reduce preselected cutoffs on one independently reviewed and paid fused FINAL cell.

    The decision owner verifies that the plan predates FINAL access and checks
    the scope and kind of the independently issued receipts. The original
    DEVELOPMENT confirmation and the later FINAL work retain separate clocks.
    """
    _require(callable(verify_final_decision_owner) and _pin(expected_plan_sha256) and _pin(expected_resources_sha256)
             and final_decision_plan_commitment(validator, plan) == expected_plan_sha256
             and final_resource_plan_commitment(resource_plan) == plan.final_resource_plan_sha256
             and resource_plan.shared_event_consumers is None
             and commitment(plan.panel) == resource_plan.final_panel_sha256,
             "exact fused FINAL decision, preregistered panel and resource plan required")
    subject, checkpoint = _t5_fusion_final_paid_slot(assessor, scoring, assessment_plan, frozen, freeze_plan,
                                                     development_comparison, resource_plan)
    _require(len(plan.panel) == freeze_plan.reserved_final_count,
             "fused FINAL decision requires every row from the frozen reservation")
    identities = ("final_resource_plan_sha256", "frozen_checkpoint_sha256", "frozen_roster_sha256", "study_seed",
                  "arm", "trained_attempt_sha256", "checkpoint_sha256", "optimizer_steps", "development_comparison_sha256")
    _require(type(verified_resources) is dict and verified_resources.get("schema") == T5_FUSION_FINAL_RESOURCE_RESULT_SCHEMA
             and commitment(verified_resources) == expected_resources_sha256
             and tuple(verified_resources.get(field) for field in identities) == (plan.final_resource_plan_sha256,
                 subject, scoring.frozen_roster_sha256, scoring.study_seed, assessment_plan.arm,
                 assessment_plan.attempt_sha256, assessment_plan.candidate_sha256, assessment_plan.optimizer_steps,
                 resource_plan.development_comparison_sha256)
             and type(verified_resources.get("optimizer_steps")) is int
             and all(_pin(verified_resources.get(field)) for field in ("final_resource_evidence_sha256",
                 "component_coverage_sha256", "t5_fusion_final_teacher_costs_sha256")),
             "exact independently verified fused FINAL costs for the selected checkpoint and teacher inputs required")
    scope = verified_resources.get("activities")
    _require(type(scope) in (tuple, list) and len(scope) == len(resource_plan.activities)
             and all(type(row) is dict and row.get("activity") == _wire(activity)
                     and _pin(row.get("terminal_close_sha256")) and type(row.get("status")) is str
                     and row["status"] in CLOSED_EVENT_OUTCOMES
                     for row, activity in zip(scope, resource_plan.activities, strict=True)),
             "exact paid fused FINAL activity closure roster required")
    selected = _one_final_row(scope, lambda row: (row["activity"]["evaluation_sha256"], row["activity"]["role"])
        == (plan.final_evaluation_sha256, "candidate"), "one original fused FINAL candidate evaluation is required")
    activity = next(item for item in resource_plan.activities if item.evaluation_sha256 == plan.final_evaluation_sha256)
    _require((activity.frozen_checkpoint_sha256, activity.checkpoint_sha256) == (subject, assessment_plan.candidate_sha256),
             "fused FINAL decision activity differs from its selected freeze")
    reference_pin = verified_resources.get("retention_reference_sha256")
    if retention_reference is None:
        _require(reference_pin is None, "selected fused FINAL paid retention reference is missing")
    else:
        fields = {"seed", "panel_sha256", "evaluation_policy_sha256", "baseline_checkpoint_sha256",
                  "baseline_receipt_sha256", "row_fidelity"}
        _require(type(retention_reference) is dict and set(retention_reference) == fields
                 and _pin(reference_pin) and reference_pin == commitment((
                     "reviewed-relational-heldout-threshold-look/v1", "baseline-retention", retention_reference))
                 and (retention_reference["seed"], retention_reference["panel_sha256"],
                      retention_reference["evaluation_policy_sha256"])
                     == (scoring.study_seed, resource_plan.final_panel_sha256, resource_plan.final_policy_sha256)
                 and _pin(retention_reference["baseline_receipt_sha256"])
                 and _pin(retention_reference["baseline_checkpoint_sha256"])
                 and retention_reference["baseline_checkpoint_sha256"] != activity.checkpoint_sha256
                 and sum(row["activity"]["role"] == "baseline" and row["status"] == "complete"
                         and row["activity"]["checkpoint_sha256"] == retention_reference["baseline_checkpoint_sha256"]
                         and row.get("baseline_receipt_sha256") == retention_reference["baseline_receipt_sha256"]
                         for row in scope) == 1,
                 "fused FINAL retention requires its independently selected complete paid baseline")
    status, counts, gate_decisions, report_pin = "final_evaluation_incomplete", None, None, None
    if selected["status"] == "complete":
        _require(type(final_report) is dict and commitment(final_report) == selected.get("report_sha256")
                 == verified_resources.get("final_report_sha256"), "complete fused FINAL requires its exact paid review")
        component_ids = selected.get("component_owner_close_sha256s")
        _require(type(component_ids) in (tuple, list), "complete fused FINAL requires exact component closes")
        terminal = FinalTerminal(activity.evaluation_sha256, selected["terminal_close_sha256"],
                                 selected["status"], tuple(component_ids), final_report)
        baseline = final_report.get("baseline_checkpoint_sha256")
        selection = {"frozen_checkpoint_sha256": subject, "final_panel_sha256": resource_plan.final_panel_sha256,
                     "final_policy_sha256": resource_plan.final_policy_sha256, "baseline_checkpoint_sha256": baseline}
        _require(commitment(("reviewed-final-baseline-selection/v1", selection)) == resource_plan.final_retention_selection_sha256
                 and (retention_reference is None or baseline == retention_reference["baseline_checkpoint_sha256"]),
                 "fused FINAL report must retain the original retention selection")
        report_pin, _ = _t5_fusion_final_report_pin(validator, assessor, resource_plan, activity, terminal, final_report,
            scoring, assessment_plan, freeze_plan, checkpoint, reference_pin, baseline, retention_reference)
        counts = _final_gate_observations(validator, plan, final_report, retention_reference)
        status, gate_decisions = _evaluate_final_cutoffs(validator, plan.cutoffs, counts)
    else:
        _require(final_report is None and selected.get("report_sha256") is None
                 and verified_resources.get("final_report_sha256") is None,
                 "incomplete fused FINAL work cannot supply panel findings")

    work = verified_resources.get("physical_work_ns")
    _require(type(work) is dict and set(work) == {"cpu_ns", "gpu_ns"}
             and all(value is None or type(value) is int and value >= 0 for value in work.values()),
             "fused FINAL physical work must preserve the original measured or unavailable totals")
    evidence = (scoring, assessment_plan, frozen, freeze_plan, development_comparison,
                verified_resources, final_report, retention_reference)
    pins = tuple(commitment(item) for item in evidence)
    # Snapshot detached output before the verifier can replace input records.
    decision = {"schema": T5_FUSION_FINAL_DECISION_SCHEMA, "final_decision_plan_sha256": expected_plan_sha256,
            "evidence_kind": plan.evidence_kind, "study_sha256": resource_plan.study_sha256,
            "study_seed": scoring.study_seed, "arm": assessment_plan.arm, "trained_attempt_sha256": assessment_plan.attempt_sha256,
            "checkpoint_sha256": activity.checkpoint_sha256, "optimizer_steps": assessment_plan.optimizer_steps,
            "frozen_checkpoint_sha256": subject, "frozen_roster_sha256": scoring.frozen_roster_sha256,
            "development_comparison_sha256": resource_plan.development_comparison_sha256,
            "development_confirmation": {"look": checkpoint["confirming_look"], "clock": freeze_plan.clock,
                "basis": frozen["confirming_clock_basis"], "elapsed": checkpoint["elapsed"]},
            "final_panel_sha256": resource_plan.final_panel_sha256, "final_policy_sha256": resource_plan.final_policy_sha256,
            "final_panel_binding_sha256": scoring.final_panel_binding_sha256,
            "final_reservation_sha256": freeze_plan.final_reservation_sha256, "reserved_final_count": freeze_plan.reserved_final_count,
            "final_resource_plan_sha256": plan.final_resource_plan_sha256, "final_resources_sha256": expected_resources_sha256,
            "final_evaluation_sha256": activity.evaluation_sha256, "final_terminal_close_sha256": selected["terminal_close_sha256"],
            "final_report_sha256": report_pin, "retention_reference_sha256": reference_pin if report_pin is not None else None,
            "paid_retention_reference_sha256": reference_pin, "final_physical_work_ns": dict(work),
            "t5_fusion_final_teacher_costs_sha256": verified_resources["t5_fusion_final_teacher_costs_sha256"],
            "cutoffs": _wire(plan.cutoffs), "final_status": selected["status"], "decision": status,
            "gate_counts": _wire(counts), "gates": gate_decisions}
    _require(verify_final_decision_owner(expected_plan_sha256, pins) is True
             and final_decision_plan_commitment(validator, plan) == expected_plan_sha256
             and final_resource_plan_commitment(resource_plan) == plan.final_resource_plan_sha256
             and tuple(commitment(item) for item in evidence) == pins,
             "fused FINAL decision owner refused or exact selected evidence changed")
    return decision


T5_FUSION_PAIRED_FINAL_PLAN_SCHEMA = "reviewed-t5-fusion-span-policy-paired-final-plan/v1"


T5_FUSION_PAIRED_FINAL_EVIDENCE_SCHEMA = "reviewed-t5-fusion-span-policy-paired-final-evidence/v1"


T5_FUSION_PAIRED_FINAL_SCHEMA = "reviewed-t5-fusion-span-policy-paired-final-panel/v1"


@dataclass(frozen=True)
class T5FusionPairedFinalPlan:
    study_sha256: str
    frozen_roster_sha256: str
    development_comparison_sha256: str
    contrast_id: str
    clock: str
    evidence_kind: str
    final_policy_sha256: str
    final_panel_binding_sha256: str
    panel: tuple[tuple[str, str, str], ...]
    fidelity_eligible: tuple[str, ...]
    cutoffs: tuple[tuple[str, Fraction], ...]
    retention_references: tuple[tuple[str, str | None, str | None], ...]
    matched_teacher_inputs: tuple[tuple[str, str, str | None], ...]
    sampling: PairedFinalSampling | None = None


@dataclass(frozen=True)
class T5FusionPairedFinalCell:
    seed: str
    arm: str
    resource_plan: FinalResourcePlan | None = None
    scoring: object | None = None
    assessment_plan: object | None = None
    resource_evidence: FinalResourceEvidence | None = None
    verified_resources: dict | None = None
    final_decision: dict | None = None
    final_report: dict | None = None
    retention_reference: dict | None = None


def t5_fusion_paired_final_plan_commitment(validator, plan):
    _require(type(plan) is T5FusionPairedFinalPlan and all(_pin(pin) for pin in (plan.study_sha256,
                 plan.frozen_roster_sha256, plan.development_comparison_sha256, plan.final_policy_sha256,
                 plan.final_panel_binding_sha256)) and _name(plan.contrast_id) and plan.clock in COVERED_CLOCKS
             and type(plan.evidence_kind) is str and plan.evidence_kind in ("fictional_fixture", "native_reviewed")
             and _final_panel_cutoffs(validator, plan.panel, plan.cutoffs)
             and type(plan.fidelity_eligible) is tuple and bool(plan.fidelity_eligible)
             and tuple(row[0] for row in plan.panel if row[0] in plan.fidelity_eligible) == plan.fidelity_eligible
             and type(plan.retention_references) is tuple and bool(plan.retention_references)
             and all(type(item) is tuple and len(item) == 3 and _name(item[0])
                     and (item[1] is None or _pin(item[1]))
                     and (item[2] is None or _pin(item[1]) and _pin(item[2])) for item in plan.retention_references)
             and len({seed for seed, _, _ in plan.retention_references}) == len(plan.retention_references),
             "preselected fused paired FINAL contrast, panel, gates and retention are required")
    groups = tuple(dict.fromkeys(row[1] for row in plan.panel))
    _require(type(plan.matched_teacher_inputs) is tuple
             and all(type(row) is tuple and len(row) == 3 and (row[2] is None or _pin(row[2]))
                     for row in plan.matched_teacher_inputs)
             and tuple(row[:2] for row in plan.matched_teacher_inputs)
                 == tuple((seed, group) for seed, _, _ in plan.retention_references for group in groups),
             "preselected fused FINAL teacher inputs must cover each original seed and dependency group in order")
    sampling = plan.sampling
    _require(sampling is None or type(sampling) is PairedFinalSampling
             and _pin(sampling.independently_sampled_seed_and_group_frame_sha256)
             and type(sampling.alpha) is Fraction and 0 < sampling.alpha < 1,
             "fused FINAL sampling requires the independently selected frame and error rate")
    return commitment((T5_FUSION_PAIRED_FINAL_PLAN_SCHEMA, plan))


def t5_fusion_paired_final_evidence_commitment(plan_sha256, cells):
    _require(_pin(plan_sha256) and type(cells) is tuple and bool(cells)
             and all(type(cell) is T5FusionPairedFinalCell and _name(cell.seed) and _name(cell.arm) for cell in cells),
             "exact ordered fused paired FINAL evidence slots required")
    return commitment((T5_FUSION_PAIRED_FINAL_EVIDENCE_SCHEMA, plan_sha256, cells))


def _t5_fusion_paired_final_slots(assessor, plan, frozen, freeze_plan, comparison):
    _require(type(frozen) is dict and frozen.get("schema") == assessor.T5_FUSION_SPAN_FINAL_FREEZE_SCHEMA
             and frozen.get("final_scoring_selected") is False and commitment(frozen) == plan.frozen_roster_sha256
             and assessor.t5_fusion_span_final_freeze_plan_commitment(freeze_plan) == frozen.get("plan_sha256")
             and (frozen.get("study_sha256"), frozen.get("final_policy_sha256"), frozen.get("clock"),
                  frozen.get("final_reservation_sha256"), frozen.get("global_split_sha256"), frozen.get("reserved_final_count"))
                 == (plan.study_sha256, plan.final_policy_sha256, plan.clock, freeze_plan.final_reservation_sha256,
                     freeze_plan.global_split_sha256, len(plan.panel))
             and (freeze_plan.study_sha256, freeze_plan.final_policy_sha256, freeze_plan.clock, freeze_plan.reserved_final_count)
                 == (plan.study_sha256, plan.final_policy_sha256, plan.clock, len(plan.panel))
             and frozen.get("confirming_clock_basis") == ("observed_elapsed" if plan.clock == "wall_seconds" else "allocated_work"),
             "exact original fused FINAL roster and untouched reserved population required")
    _require(type(comparison) is dict and comparison.get("schema") in (assessor.T5_FUSION_PAID_VALIDATION_SCHEMA,
                 assessor.T5_FUSION_STARTED_DEVELOPMENT_PAID_VALIDATION_SCHEMA,
                 assessor.T5_FUSION_INTERRUPTED_PREPARATION_PAID_VALIDATION_SCHEMA)
             and comparison["schema"] == frozen.get("t5_fusion_paid_comparison_schema")
             and commitment(comparison) == plan.development_comparison_sha256 == frozen.get("development_comparison_sha256")
             and comparison.get("study_sha256") == plan.study_sha256 and comparison.get("cost_basis") == "first_use"
             and comparison.get("reuse_count") is None and comparison.get("contrast_plan_sha256") == freeze_plan.contrast_plan_sha256
             and _pin(comparison.get("t5_fusion_span_paid_looks_sha256"))
             and comparison["t5_fusion_span_paid_looks_sha256"] == frozen.get("t5_fusion_span_paid_looks_sha256")
             and comparison.get("cost_evidence_sha256") == frozen.get("t5_fusion_development_cost_evidence_sha256")
                 == freeze_plan.development_cost_evidence_sha256
             and comparison.get("t5_fusion_upstream_costs_sha256") == frozen.get("t5_fusion_upstream_costs_sha256")
                 == freeze_plan.development_upstream_costs_sha256,
             "paired fused FINAL must retain the original verified first-use DEVELOPMENT comparison")
    scope = comparison.get("t5_fusion_span_validation")
    bindings = comparison.get("t5_fusion_span_seed_bindings")
    _require(type(scope) is dict and scope.get("role") == "development"
             and type(scope.get("optimizer_steps")) is int and scope["optimizer_steps"] > 0
             and type(scope.get("reserved_final_count")) is int
             and (scope.get("global_split_sha256"), scope.get("split_selection_sha256"),
                  scope.get("optimizer_step_grid_sha256"), scope["reserved_final_count"])
                 == (freeze_plan.global_split_sha256, freeze_plan.validation_split_sha256,
                     freeze_plan.optimizer_step_grid_sha256, len(plan.panel))
             and type(bindings) in (tuple, list) and bool(bindings)
             and all(type(row) in (tuple, list) and len(row) == 2 and _name(row[0]) and type(row[1]) is int for row in bindings)
             and len({row[0] for row in bindings}) == len(bindings) == len({row[1] for row in bindings})
             and type(comparison.get("seed_count")) is int and comparison["seed_count"] == len(bindings),
             "original fused FINAL split, optimizer grid, and named and numeric seed roster required")
    seeds = tuple(seed for seed, _ in bindings)
    _require(tuple(seed for seed, _, _ in plan.retention_references) == seeds,
             "paired fused FINAL retention roster differs from the original seed order")
    arms = assessor.DECISION_SPAN_POLICY_ARMS
    contrast = _one_final_row(comparison.get("contrasts"), lambda row: row.get("identifier") == plan.contrast_id,
                              "original registered fused policy contrast required")
    pairs = comparison.get("pairs")
    _require(type(pairs) in (tuple, list) and all(type(row) is dict for row in pairs)
             and (contrast.get("baseline"), contrast.get("candidate"), contrast.get("role")) == (*arms, "primary"),
             "paired fused FINAL must preserve its original primary comparison direction")
    records = tuple(row for row in pairs if (row.get("contrast_id"), row.get("clock")) == (plan.contrast_id, plan.clock))
    _require(tuple(row.get("seed") for row in records) == seeds, "paired fused FINAL must keep every selected-clock DEVELOPMENT pair")
    horizon = records[0].get("horizon")
    _require(type(horizon) is float and isfinite(horizon) and horizon > 0
             and all((row.get("baseline"), row.get("candidate"), row.get("role"), row.get("horizon"))
                     == (*arms, "primary", horizon) for row in records),
             "paired fused FINAL must use the original finite DEVELOPMENT horizon")
    attempts, slots = comparison.get("attempts"), frozen.get("slots")
    order = tuple((seed, arm) for seed in seeds for arm in arms)
    _require(all(type(rows) in (tuple, list) and all(type(row) is dict for row in rows)
                 and tuple((row.get("seed"), row.get("arm")) for row in rows) == order for rows in (attempts, slots))
             and all(_pin(row.get("attempt_sha256")) and _pin(row.get("closeout_receipt_sha256")) for row in attempts)
             and len({row["attempt_sha256"] for row in attempts}) == len({row["closeout_receipt_sha256"] for row in attempts})
                 == len(order), "paired fused FINAL must preserve the original paid arm order and distinct closes")
    for index, (saved, attempt) in enumerate(zip(slots, attempts, strict=True)):
        pair, side = records[index // 2], ("baseline", "candidate")[index % 2]
        attained, reason = pair.get(side + "_attained"), pair.get(side + "_reason")
        checkpoint = saved.get("checkpoint")
        _require((attained is None or type(attained) is int and attained in (0, 1)) and _name(reason)
                 and type(saved.get("attained")) is type(attained)
                 and (saved.get("attained"), saved.get("reason"), saved.get("attempt_sha256"), saved.get("closeout_receipt_sha256"))
                     == (attained, reason, attempt["attempt_sha256"], attempt["closeout_receipt_sha256"])
                 and pair.get(side + "_attempt_sha256") == attempt["attempt_sha256"] and "checkpoint" in saved,
                 "fused FINAL slot differs from the original paid DEVELOPMENT disposition")
        if attained != 1:
            _require(saved.get("status") == "unavailable" and checkpoint is None,
                     "unavailable fused FINAL slot cannot carry a checkpoint")
            continue
        decision = attempt.get("decision")
        costs = decision.get("confirming_costs") if type(decision) is dict else None
        elapsed = pair.get("observed_" + side + "_confirmation")
        _require(saved.get("status") == "frozen" and reason == "confirmed_within_horizon"
                 and type(elapsed) is float and isfinite(elapsed) and 0 <= elapsed <= horizon
                 and type(checkpoint) is dict and type(checkpoint.get("elapsed")) is float and checkpoint["elapsed"] == elapsed
                 and type(checkpoint.get("optimizer_steps")) is int and checkpoint["optimizer_steps"] == scope["optimizer_steps"]
                 and type(checkpoint.get("candidate")) is dict and _pin(checkpoint["candidate"].get("sha256"))
                 and type(decision) is dict and decision.get("status") == "reached"
                 and decision.get("confirming_checkpoint") == checkpoint.get("confirming_look")
                 and type(costs) is dict and type(costs.get(plan.clock)) is float and costs[plan.clock] == elapsed
                 and "confirmation_budget_block" in attempt and attempt["confirmation_budget_block"] is None,
                 "eligible fused FINAL slot must retain its original confirmed clock and selected checkpoint")
        look = _one_final_row(attempt.get("look_evidence"), lambda row: row.get("look") == checkpoint["confirming_look"],
                              "eligible fused FINAL slot requires its original paid confirming look")
        pins = (look.get("checkpoint_sha256"), look.get("evaluation_receipt_sha256"), look.get("meter_record_sha256"))
        _require(all(_pin(pin) for pin in pins) and pins == (checkpoint["candidate"]["sha256"],
                     checkpoint.get("development_evaluation_sha256"), checkpoint.get("development_meter_sha256")),
                 "eligible fused FINAL slot changed its original confirming look or meter")
    return seeds, records, slots


def _t5_fusion_paired_final_cell(validator, assessor, plan, cell, slot, *, frozen, freeze_plan, comparison,
                                final_policy, baseline, teacher_inputs, verify_final_decision_owner):
    _require((cell.seed, cell.arm) == (slot["seed"], slot["arm"]),
             "fused paired FINAL cells must preserve the exact original seed and arm order")
    eligible = slot["attained"] == 1
    checkpoint = slot["checkpoint"]
    header = {"seed": cell.seed, "arm": cell.arm, "trained_attempt_sha256": slot["attempt_sha256"],
              "development_attainment": slot["attained"], "development_disposition": slot["reason"],
              "development_closeout_receipt_sha256": slot["closeout_receipt_sha256"],
              "checkpoint_sha256": checkpoint["candidate"]["sha256"] if eligible else None,
              "final_resources_sha256": None, "final_report_sha256": None, "final_decision_sha256": None,
              "gate_counts": None, "gates": None, "matched_teacher_inputs_verified": None}
    unknown = (None,) * len(plan.fidelity_eligible)
    if cell.verified_resources is None:
        _require(all(value is None for value in (cell.resource_plan, cell.scoring, cell.assessment_plan,
                         cell.resource_evidence, cell.final_decision, cell.final_report, cell.retention_reference)),
                 "unstarted or unavailable fused FINAL slots cannot carry issued findings or costs")
        return {**header, "status": "unstarted" if eligible else "development_unavailable"}, unknown
    resources, decision, evidence = cell.verified_resources, cell.final_decision, cell.resource_evidence
    _require(eligible and type(resources) is dict and type(decision) is dict
             and decision.get("schema") == T5_FUSION_FINAL_DECISION_SCHEMA
             and type(evidence) is FinalResourceEvidence
             and commitment(evidence) == resources.get("final_resource_evidence_sha256")
             and type(cell.scoring) is assessor.T5FusionSpanFinalScoring
             and type(cell.assessment_plan) is assessor.T5FusionSpanFinalAssessment
             and (cell.scoring.study_seed, cell.assessment_plan.arm, cell.assessment_plan.attempt_sha256)
                 == (cell.seed, cell.arm, slot["attempt_sha256"])
             and cell.scoring.final_panel_binding_sha256 == plan.final_panel_binding_sha256
             and type(cell.resource_plan) is FinalResourcePlan and cell.resource_plan.final_policy_sha256 == plan.final_policy_sha256,
             "paid fused FINAL cell changed its original eligible slot, panel, or evidence")
    baseline_checkpoint, baseline_reference = baseline
    retention_selection = {"frozen_checkpoint_sha256": cell.resource_plan.candidate_freeze_sha256,
                           "final_panel_sha256": cell.resource_plan.final_panel_sha256,
                           "final_policy_sha256": plan.final_policy_sha256,
                           "baseline_checkpoint_sha256": baseline_checkpoint}
    _require(commitment(("reviewed-final-baseline-selection/v1", retention_selection))
                 == cell.resource_plan.final_retention_selection_sha256
             and all(activity.checkpoint_sha256 == baseline_checkpoint for activity in cell.resource_plan.activities
                     if activity.role == "baseline"), "paid fused FINAL cell changed the selected per-seed baseline")
    if cell.retention_reference is not None:
        _require(_pin(baseline_reference) and resources.get("retention_reference_sha256") == baseline_reference,
                 "paired fused FINAL cannot substitute a different per-seed retention reference")
    cutoffs = FinalDecisionPlan(final_resource_plan_commitment(cell.resource_plan), decision.get("final_evaluation_sha256"),
                                plan.evidence_kind, plan.panel, plan.cutoffs)
    decision_pin = final_decision_plan_commitment(validator, cutoffs)
    replayed = evaluate_paid_t5_fusion_span_final_decision(validator, assessor, plan=cutoffs,
        expected_plan_sha256=decision_pin, resource_plan=cell.resource_plan, scoring=cell.scoring,
        assessment_plan=cell.assessment_plan, frozen=frozen, freeze_plan=freeze_plan,
        development_comparison=comparison, verified_resources=resources, expected_resources_sha256=commitment(resources),
        final_report=cell.final_report, retention_reference=cell.retention_reference,
        verify_final_decision_owner=verify_final_decision_owner)
    _require(commitment(replayed) == commitment(decision),
             "paired fused FINAL must replay the original issued cutoff decision exactly")
    header.update(final_resources_sha256=commitment(resources), final_decision_sha256=commitment(decision),
                  final_report_sha256=replayed["final_report_sha256"],
                  final_evaluation_sha256=replayed["final_evaluation_sha256"],
                  final_terminal_close_sha256=replayed["final_terminal_close_sha256"],
                  gate_counts=replayed["gate_counts"], gates=replayed["gates"])
    if cell.final_report is None:
        _require(replayed["decision"] == "final_evaluation_incomplete", "ungraded paid FINAL may not supply cutoff findings")
        return {**header, "status": "paid_without_completed_review"}, unknown
    report = cell.final_report
    _require(report.get("baseline_checkpoint_sha256") == baseline_checkpoint
             and all((row["review_eligible"], row["formal_required"]) == (case.review_eligible, case.formal_required)
                     for row, case in zip(report["rows"], final_policy.cases, strict=True)),
             "fused paired FINAL cannot change common retained baseline or preselected row eligibility")
    bindings = report["component_teacher_bindings"]
    _require(tuple((row["dependency_group_sha256"], row["matched_teacher_inputs_sha256"]) for row in bindings) == teacher_inputs,
             "paired fused FINAL arms must preserve independently matched teacher inputs for every dependency group")
    return {**header, "status": replayed["decision"], "matched_teacher_inputs_verified": True}, tuple(
        row["source_fidelity"] for row in report["rows"] if row["review_eligible"])


def assemble_t5_fusion_span_paired_final_panel(validator, assessor, *, plan, expected_plan_sha256, frozen, freeze_plan,
        development_comparison, final_policy, case_aliases, cells, expected_evidence_sha256,
        verify_final_decision_owner, verify_paired_final_owner, estimator_profile_selection=None,
        expected_estimator_profile_selection_sha256=None, expected_estimator_freeze_selection_sha256=None):
    """Compare the original fused policy arms on the independent reserved panel.

    Each owner reauthenticates the already issued decisions and physical scopes.
    Keep the original DEVELOPMENT clocks and FINAL work separate and retain
    unavailable outcomes in the selected seed and dependency-group frame.
    A profile-bearing roster requires its independently selected profile and
    matching settlement provenance on every started cell.
    """
    _require(callable(verify_final_decision_owner) and callable(verify_paired_final_owner)
             and _pin(expected_plan_sha256) and _pin(expected_evidence_sha256)
             and t5_fusion_paired_final_plan_commitment(validator, plan) == expected_plan_sha256
             and t5_fusion_paired_final_evidence_commitment(expected_plan_sha256, cells) == expected_evidence_sha256
             and assessor.t5_fusion_span_final_panel_binding(final_policy, case_aliases) == plan.final_panel_binding_sha256
             and assessor.gate_policy_commitment(final_policy) == plan.final_policy_sha256
             and tuple((case.row_id, case.dependency_group_sha256, case.language) for case in final_policy.cases) == plan.panel
             and tuple(case.row_id for case in final_policy.cases if case.review_eligible) == plan.fidelity_eligible,
             "exact common fused FINAL panel, eligibility and paired selection required")
    original = (plan, cells, frozen, freeze_plan, development_comparison, final_policy, case_aliases)
    selection_pins = tuple(commitment(value) for value in original[2:])
    # Independent owners can retain references to caller input but cannot mutate the replay.
    chosen, selected_cells, frozen, freeze_plan, comparison, policy, _ = deepcopy(original)
    seeds, records, slots = _t5_fusion_paired_final_slots(assessor, chosen, frozen, freeze_plan, comparison)
    _require(len(selected_cells) == len(slots), "one explicit fused paired FINAL cell required for every original seed and arm")
    provenance_key = _T5_FUSION_FINAL_ESTIMATOR_PROVENANCE

    def current_estimator_profile():
        return _t5_fusion_final_estimator_profile(assessor, original[2],
            expected_frozen_roster_sha256=chosen.frozen_roster_sha256,
            expected_estimator_freeze_selection_sha256=expected_estimator_freeze_selection_sha256,
            estimator_profile_selection=estimator_profile_selection,
            expected_estimator_profile_selection_sha256=expected_estimator_profile_selection_sha256)

    estimator_profile = current_estimator_profile()
    _t5_fusion_final_check_settlement_estimators(selected_cells, estimator_profile)
    baselines = {seed: (checkpoint, reference) for seed, checkpoint, reference in chosen.retention_references}
    teacher_inputs = {seed: tuple((group, pin) for label, group, pin in chosen.matched_teacher_inputs if label == seed)
                      for seed in seeds}
    results, findings, paid, review_batches = [], [], [], {}
    for cell, slot in zip(selected_cells, slots, strict=True):
        result, observed = _t5_fusion_paired_final_cell(validator, assessor, chosen, cell, slot, frozen=frozen,
            freeze_plan=freeze_plan, comparison=comparison, final_policy=policy, baseline=baselines[slot["seed"]],
            teacher_inputs=teacher_inputs[slot["seed"]], verify_final_decision_owner=verify_final_decision_owner)
        if estimator_profile is not None and cell.verified_resources is not None:
            _require(current_estimator_profile() == estimator_profile,
                     "selected estimator profile changed during paired FINAL replay")
        results.append(result)
        findings.append(observed)
        if cell.verified_resources is not None:
            paid.append((cell.seed, cell.arm, cell.verified_resources, cell.resource_evidence, cell.retention_reference))
        if cell.final_report is not None:
            for row in cell.final_report["component_teacher_bindings"]:
                identity = (result["checkpoint_sha256"], row["dependency_group_sha256"], row["matched_teacher_inputs_sha256"])
                _require(review_batches.setdefault(row["final_batch_sha256"], identity) == identity,
                         "paired fused FINAL component batch cannot move across checkpoints or teacher inputs")
    forbidden = _t5_fusion_final_prior_ids(frozen, comparison)
    forbidden.update((chosen.frozen_roster_sha256, chosen.development_comparison_sha256,
                      expected_plan_sha256, expected_evidence_sha256))
    for _, _, resources, _, _ in paid:
        forbidden.update(resources[key] for key in ("frozen_checkpoint_sha256", "final_resource_plan_sha256",
              "final_resource_evidence_sha256", "component_coverage_sha256", "final_report_sha256",
              "t5_fusion_final_teacher_costs_sha256") if _pin(resources.get(key)))
    costs = _t5_fusion_paired_final_cost_union(chosen, tuple(paid), forbidden)
    grouped = _paired_group_bounds(chosen, seeds, findings)
    result = {"schema": T5_FUSION_PAIRED_FINAL_SCHEMA, "paired_final_plan_sha256": expected_plan_sha256,
              "paired_final_evidence_sha256": expected_evidence_sha256, "development_comparison_sha256": chosen.development_comparison_sha256,
              "frozen_roster_sha256": chosen.frozen_roster_sha256, "final_reservation_sha256": freeze_plan.final_reservation_sha256,
              "evidence_kind": chosen.evidence_kind, "contrast_id": chosen.contrast_id, "eligible_clock": chosen.clock,
              "final_panel_sha256": commitment(chosen.panel), "final_panel_binding_sha256": chosen.final_panel_binding_sha256,
              "final_policy_sha256": chosen.final_policy_sha256, "matched_teacher_inputs_sha256": commitment(chosen.matched_teacher_inputs),
              "development_pairs": _wire(records), "cells": tuple(results), "fidelity": grouped, "final_work": costs}
    if estimator_profile is not None:
        result[provenance_key] = estimator_profile
    _require(verify_paired_final_owner(expected_plan_sha256, expected_evidence_sha256,
                 chosen.development_comparison_sha256, selection_pins) is True
             and t5_fusion_paired_final_plan_commitment(validator, original[0]) == expected_plan_sha256
             and t5_fusion_paired_final_evidence_commitment(expected_plan_sha256, original[1]) == expected_evidence_sha256
             and tuple(commitment(value) for value in original[2:]) == selection_pins
             and current_estimator_profile() == estimator_profile,
             "paired fused FINAL owner refused the issued evidence or the selected comparison changed")
    return result


def _t5_fusion_paired_activity_cost(row, raw, events, by_close, unassigned, resource_pin,
                                  teacher_events, preparation):
    activity = FinalActivity(**row["activity"])
    terminal, meter, interval, charges = raw
    report = _closed_final_candidate_report(activity, terminal)
    report_pin = None if report is None else commitment(report)
    evaluation = activity.evaluation_sha256
    _require(type(meter) is Meter and type(interval) is MeterInterval and type(charges) is ChargeManifest
             and (meter.attempt_sha256, meter.stage, meter.scope, meter.includes_failed_attempts)
                 == (evaluation, "close", FINAL_RESOURCE_SCOPE, True)
             and meter.includes_failed_attempts is True and _pin(meter.cost_policy_sha256)
             and (interval.attempt_sha256, interval.stage) == (charges.attempt_sha256, charges.stage)
                 == (evaluation, "close")
             and interval.subject_sha256 == final_resource_subject(resource_pin, activity, terminal)
             and commitment(interval) == meter.interval_manifest_sha256
             and commitment(charges) == meter.charge_manifest_sha256
             and type(meter.clock_receipts) is tuple and len(meter.clock_receipts) == len(COVERED_CLOCKS)
             and all(value is None or _pin(value) for value in meter.clock_receipts),
             "paired fused FINAL must retain its original plan-bound meter, interval and charge manifest")
    _require(commitment((row.get("meter"), row.get("wall"), row.get("charged_events"),
                         row.get("status"), row.get("terminal_close_sha256"),
                         row.get("component_owner_close_sha256s"), row.get("baseline_receipt_sha256"),
                         row.get("report_sha256"))) ==
             commitment((meter, interval.wall, charges, terminal.status, terminal.terminal_close_sha256,
                         terminal.component_owner_close_sha256s, terminal.baseline_receipt_sha256, report_pin)),
             "paired fused FINAL readback differs from the issued activity closure")

    shares = _event_shares(charges, events, {})
    _require(bool(shares) and shares.keys() <= unassigned and all(share == 1 for share in shares.values()),
             "paired fused FINAL requires original exclusive paid activity work")
    _wall_evidence(meter, interval.wall, None, "first_use")
    for clock, receipt in zip(COVERED_CLOCKS, meter.clock_receipts, strict=True):
        measured = getattr(meter.costs, clock)
        _require((measured is None and receipt is None)
                 or type(measured) is float and isfinite(measured) and measured >= 0 and _pin(receipt),
                 "paired fused FINAL must preserve measured and unavailable clock receipts")
    for clock, counter in (("cpu_seconds", "cpu_ns"), ("gpu_seconds", "gpu_ns")):
        measured = getattr(meter.costs, clock)
        _require(measured is None or measured == _charged_seconds(events, shares, counter),
                 "paired fused FINAL additive meter differs from original charged events")
    terminal_id = by_close.get(terminal.terminal_close_sha256)
    _require(terminal_id in shares and events[terminal_id].kind == "closeout"
             and events[terminal_id].disposition == terminal.status,
             "paired fused FINAL terminal requires its original charged closeout")
    coverage = row.get("component_event_coverage")
    _require(type(coverage) in (tuple, list)
             and all(type(pair) in (tuple, list) and len(pair) == 2 and all(_pin(value) for value in pair)
                     for pair in coverage)
             and tuple(close for close, _ in coverage) == terminal.component_owner_close_sha256s
             and len({event_id for _, event_id in coverage}) == len(coverage)
             and all(event_id in shares and event_id != terminal_id and event_id not in teacher_events
                     and by_close.get(close) == event_id and events[event_id].kind == "evaluation"
                     and (terminal.status != "complete" or events[event_id].disposition == "complete")
                     for close, event_id in coverage),
             "paired fused FINAL component coverage must retain its own paid evaluation")
    batches = None
    if report is not None:
        bindings = report.get("component_teacher_bindings")
        _require(type(bindings) in (tuple, list) and len(bindings) == len(coverage) and bool(bindings)
                 and all(type(binding) is dict and _pin(binding.get("dependency_group_sha256"))
                         and _pin(binding.get("final_batch_sha256")) for binding in bindings)
                 and tuple(binding.get("component_owner_close_sha256") for binding in bindings)
                     == terminal.component_owner_close_sha256s,
                 "paired fused FINAL requires the original component teacher batch roster")
        batches = {binding["dependency_group_sha256"]: binding["final_batch_sha256"] for binding in bindings}
        _require(len(batches) == len(bindings),
                 "paired fused FINAL teacher component dependencies must be unique")
    _require_t5_fusion_final_teacher_activity(preparation, batches, events, teacher_events, shares, interval.wall)

    event_records = tuple(events[event_id] for event_id in shares)
    event_closes = {event.close_receipt_sha256 for event in event_records}
    baseline = terminal.baseline_receipt_sha256
    clock_receipts = {receipt for receipt in meter.clock_receipts if receipt is not None}
    preparation_receipts = {record.interval.receipt_sha256 for record in preparation}
    physical_ids = {evaluation, *shares, *event_closes}
    _require(len(physical_ids) == 1 + 2 * len(shares)
             and (baseline is None or baseline not in physical_ids | clock_receipts | preparation_receipts)
             and physical_ids.isdisjoint(clock_receipts | preparation_receipts)
             and clock_receipts.isdisjoint(preparation_receipts),
             "paired fused FINAL physical receipts cannot alias distinct activity roles")
    physical_ids.update(clock_receipts | preparation_receipts)
    if baseline is not None:
        physical_ids.add(baseline)
    wrapper_ids = {interval.scope_receipt_sha256, meter.record_sha256, meter.interval_manifest_sha256}
    _require(len(wrapper_ids) == 3 and all(_pin(value) for value in wrapper_ids) and wrapper_ids.isdisjoint(physical_ids),
             "paired fused FINAL requires distinct original per-plan meter and interval wrapper receipts")
    unassigned.difference_update(shares)

    # For a reused retention baseline, these are the physical fields. The verified
    # interval subject and its meter/scope wrappers are specific to each paid plan.
    signature = commitment((evaluation, activity.checkpoint_sha256, terminal, coverage, event_records,
                            charges, meter.scope, meter.cost_policy_sha256, meter.costs, meter.clock_receipts,
                            meter.includes_failed_attempts, interval.wall))
    return activity, terminal, report_pin, physical_ids, wrapper_ids, event_records, signature


def _t5_fusion_paired_final_cost_union(plan, verified_cells, forbidden):
    """Join independently paid fused FINAL cells without summing elapsed wall spans."""
    retention_slots = {seed: (checkpoint, reference) for seed, checkpoint, reference in plan.retention_references}
    paid_slots, used_physical_ids, used_wrappers = set(), set(), set()
    all_events, evaluations, clocks = {}, {}, []
    for seed, arm, resources, evidence, retention in verified_cells:
        _require((seed, arm) not in paid_slots and seed in retention_slots,
                 "one original fused FINAL paid scope is required per selected cell")
        paid_slots.add((seed, arm))
        baseline_checkpoint, reference = retention_slots[seed]
        retained_receipt = None
        if retention is not None:
            _require(type(retention) is dict and _pin(reference)
                     and (retention.get("seed"), retention.get("baseline_checkpoint_sha256"))
                         == (seed, baseline_checkpoint)
                     and _pin(retention.get("baseline_receipt_sha256"))
                     and commitment(("reviewed-relational-heldout-threshold-look/v1", "baseline-retention", retention))
                         == reference,
                     "paired fused FINAL retention differs from the selected independent baseline reference")
            retained_receipt = retention["baseline_receipt_sha256"]

        _require(type(resources) is dict and resources.get("schema") == T5_FUSION_FINAL_RESOURCE_RESULT_SCHEMA
                 and (resources.get("study_seed"), resources.get("arm")) == (seed, arm)
                 and "retention_reference_sha256" in resources
                 and resources["retention_reference_sha256"] == (reference if retention is not None else None)
                 and type(evidence) is FinalResourceEvidence and _pin(evidence.plan_sha256)
                 and evidence.plan_sha256 == resources.get("final_resource_plan_sha256")
                 and commitment(evidence) == resources.get("final_resource_evidence_sha256")
                 and type(evidence.closes) is tuple and bool(evidence.closes)
                 and all(type(raw) is tuple and len(raw) == 4 for raw in evidence.closes),
                 "paired fused FINAL requires the independently issued original paid evidence")
        activities = resources.get("activities")
        _require(type(activities) in (tuple, list) and len(activities) == len(evidence.closes)
                 and all(type(row) is dict and type(row.get("activity")) is dict
                         and set(row["activity"]) == set(FinalActivity.__dataclass_fields__)
                         and all(_pin(row["activity"][key]) for key in (
                             "evaluation_sha256", "frozen_checkpoint_sha256", "checkpoint_sha256"))
                         and row["activity"]["frozen_checkpoint_sha256"] == resources.get("frozen_checkpoint_sha256")
                         and row["activity"]["role"] in ("candidate", "baseline")
                         and row["activity"]["checkpoint_sha256"] ==
                             (resources.get("checkpoint_sha256") if row["activity"]["role"] == "candidate"
                              else baseline_checkpoint) for row in activities)
                 and commitment(tuple(row.get("component_event_coverage") for row in activities))
                     == resources.get("component_coverage_sha256"),
                 "paired fused FINAL must retain every original activity and ordered component coverage")

        events = _event_roster(evidence.events)
        by_close = {event.close_receipt_sha256: event_id for event_id, event in events.items()}
        evaluation_ids = {row["activity"]["evaluation_sha256"] for row in activities}
        _require(len(evaluation_ids) == len(activities) and len(by_close) == len(events)
                 and set(by_close).isdisjoint(events) and evaluation_ids.isdisjoint({*events, *by_close})
                 and commitment(evidence.events) == commitment(resources.get("physical_paid_events"))
                 and commitment(_physical_work_ns(events)) == commitment(resources.get("physical_work_ns")),
                 "paired fused FINAL physical work differs from the original event and counter roster")
        teacher_wire = resources.get("t5_fusion_final_teacher_costs")
        _require(type(teacher_wire) in (tuple, list)
                 and all(type(row) is dict and set(row) == set(T5FusionFinalTeacherCost.__dataclass_fields__)
                         and type(row["interval"]) is dict and set(row["interval"]) == set(WallSpan.__dataclass_fields__)
                         for row in teacher_wire),
                 "paired fused FINAL requires the issued teacher work receipt roster")
        teacher_costs = tuple(T5FusionFinalTeacherCost(**(row | {"interval": WallSpan(**row["interval"])}))
                              for row in teacher_wire)
        _require(t5_fusion_final_teacher_costs_commitment(teacher_costs, plan_sha256=evidence.plan_sha256,
                     evidence_sha256=resources["final_resource_evidence_sha256"])
                 == resources.get("t5_fusion_final_teacher_costs_sha256"),
                 "paired fused FINAL teacher work must retain its original evidence commitment")
        teacher_events, by_evaluation = _bind_t5_fusion_final_teacher_work(
            teacher_costs, events, tuple(FinalActivity(**row["activity"]) for row in activities),
            {*events, *by_close, *evaluation_ids} | forbidden)

        unassigned, local_used, reports, baseline_receipts = set(events), set(), [], set()
        for row, raw in zip(activities, evidence.closes, strict=True):
            preparation = by_evaluation.get(row["activity"]["evaluation_sha256"], ())
            activity, terminal, report_pin, physical_ids, wrapper_ids, records, signature = _t5_fusion_paired_activity_cost(
                row, raw, events, by_close, unassigned, evidence.plan_sha256, teacher_events, preparation)
            evaluation = activity.evaluation_sha256
            _require(local_used.isdisjoint(physical_ids | wrapper_ids)
                     and forbidden.isdisjoint(physical_ids | wrapper_ids)
                     and used_wrappers.isdisjoint(physical_ids | wrapper_ids)
                     and used_physical_ids.isdisjoint(wrapper_ids),
                     "paired fused FINAL activity, clock, scope or meter aliases prior or peer work")
            local_used.update(physical_ids | wrapper_ids)
            used_wrappers.update(wrapper_ids)
            if report_pin is not None:
                reports.append(report_pin)
            if terminal.baseline_receipt_sha256 is not None:
                _require(not baseline_receipts, "paired fused FINAL allows one completed retention baseline per cell")
                baseline_receipts.add(terminal.baseline_receipt_sha256)

            shared = (seed, reference, signature) if (activity.role == "baseline" and terminal.status == "complete"
                and retained_receipt is not None and terminal.baseline_receipt_sha256 == retained_receipt) else None
            prior = evaluations.get(evaluation)
            if prior is not None:
                _require(shared is not None and prior["shared"] == shared and prior["ids"] == physical_ids
                         and arm not in prior["arms"] and len(prior["arms"]) == 1,
                         "only identical independently selected same-seed physical retention baseline work may recur")
                prior["arms"].append(arm)
            else:
                _require(used_physical_ids.isdisjoint(physical_ids),
                         "paired fused FINAL paid work cannot recur under a different physical activity")
                used_physical_ids.update(physical_ids)
                evaluations[evaluation] = {"shared": shared, "ids": physical_ids, "arms": [arm],
                                           "checkpoint": activity.checkpoint_sha256,
                                           "receipt": terminal.baseline_receipt_sha256, "seed": seed}
                all_events.update((event.event_sha256, event) for event in records)
            clocks.append({"seed": seed, "arm": arm, "evaluation_sha256": evaluation, "role": activity.role,
                           "status": terminal.status, "wall": row["wall"], "clock_receipts": row["meter"]["clock_receipts"]})
        expected_report = resources.get("final_report_sha256")
        _require(not unassigned and (retained_receipt is None or baseline_receipts == {retained_receipt})
                 and reports == ([] if expected_report is None else [expected_report]),
                 "paired fused FINAL must account for every paid event, reviewed report and selected baseline")

    shared_baselines = tuple({"seed": entry["seed"], "evaluation_sha256": evaluation,
                              "baseline_checkpoint_sha256": entry["checkpoint"], "baseline_receipt_sha256": entry["receipt"],
                              "retention_reference_sha256": entry["shared"][1], "arms": tuple(sorted(entry["arms"]))}
                             for evaluation, entry in sorted(evaluations.items()) if len(entry["arms"]) == 2)
    return {"physical_paid_events": tuple(_wire(all_events[key]) for key in sorted(all_events)),
            "physical_work_ns": _physical_work_ns(all_events), "paid_activity_count": len(evaluations),
            "shared_baseline_activities": shared_baselines, "activity_clocks": _wire(clocks)}


T5_FUSION_FINAL_THRESHOLD_PLAN_SCHEMA = "reviewed-t5-fusion-final-qualified-threshold-plan/v1"


T5_FUSION_FINAL_CERTIFICATION_WALLS_SCHEMA = "reviewed-t5-fusion-final-certification-walls/v1"


T5_FUSION_FINAL_THRESHOLD_SCHEMA = "reviewed-t5-fusion-final-qualified-threshold-result/v1"


@dataclass(frozen=True)
class T5FusionFinalThresholdPlan:
    paired_final_plan_sha256: str
    certification_wall_horizon_ns: int | None = None


@dataclass(frozen=True)
class T5FusionFinalCertificationWall:
    seed: str
    arm: str
    trained_attempt_sha256: str
    development_close_sha256: str
    development_wall_receipt_sha256: str
    final_decision_sha256: str
    final_terminal_close_sha256: str
    certification_event_sha256: str
    activity_wall_receipts: tuple[str, ...]
    wall: WallSpan


def t5_fusion_final_threshold_plan_commitment(plan):
    _require(type(plan) is T5FusionFinalThresholdPlan and _pin(plan.paired_final_plan_sha256)
             and (plan.certification_wall_horizon_ns is None or type(plan.certification_wall_horizon_ns) is int
                  and plan.certification_wall_horizon_ns > 0),
             "preselected paired FINAL endpoint and optional positive certification wall horizon required")
    return commitment((T5_FUSION_FINAL_THRESHOLD_PLAN_SCHEMA, plan))


def t5_fusion_final_certification_walls_commitment(plan_sha256, paired_result_sha256, walls):
    _require(_pin(plan_sha256) and _pin(paired_result_sha256) and type(walls) is tuple
             and all(type(row) is T5FusionFinalCertificationWall and _name(row.seed) and _name(row.arm)
                     and type(row.wall) is WallSpan and _pin(row.wall.receipt_sha256)
                     and all(_pin(pin) for pin in (row.trained_attempt_sha256, row.development_close_sha256,
                         row.development_wall_receipt_sha256, row.final_decision_sha256,
                         row.final_terminal_close_sha256, row.certification_event_sha256))
                     and type(row.activity_wall_receipts) is tuple and bool(row.activity_wall_receipts)
                     and all(_pin(pin) for pin in row.activity_wall_receipts) for row in walls)
             and len({(row.seed, row.arm) for row in walls}) == len(walls),
             "exact selected continuous certification wall receipts required")
    return commitment((T5_FUSION_FINAL_CERTIFICATION_WALLS_SCHEMA, plan_sha256, paired_result_sha256, walls))


def _t5_fusion_threshold_final_grade(validator, paired_plan, cell):
    status = cell.get("status")
    if status in ("development_unavailable", "unstarted", "paid_without_completed_review"):
        _require(all(key in cell and cell[key] is None for key in (
                    "gate_counts", "gates", "final_report_sha256", "matched_teacher_inputs_verified"))
                 and (status != "paid_without_completed_review" or all(_pin(cell.get(key)) for key in (
                     "final_decision_sha256", "final_resources_sha256", "final_terminal_close_sha256", "final_evaluation_sha256")))
                 and (status == "paid_without_completed_review" or all(key in cell and cell[key] is None for key in (
                     "final_decision_sha256", "final_resources_sha256"))),
                 "unreviewed fused FINAL slots cannot supply matched inputs or grades")
        return status, None
    _require(status in ("cutoffs_passed", "cutoffs_failed", "cutoffs_unavailable")
             and cell.get("matched_teacher_inputs_verified") is True
             and all(_pin(cell.get(key)) for key in ("final_decision_sha256", "final_report_sha256", "checkpoint_sha256",
                 "final_resources_sha256", "final_evaluation_sha256", "final_terminal_close_sha256")),
             "FINAL gate disposition requires the original matched, reviewed and paid cell")
    raw = cell.get("gate_counts")
    _require(type(raw) is dict and set(raw) == set(FINAL_GATE_NAMES)
             and all(type(row) is dict and set(row) == {"numerator", "denominator", "verified"}
                     and type(row["denominator"]) is int and type(row["numerator"]) is int
                     and 0 <= row["numerator"] <= row["denominator"] and type(row["verified"]) is bool
                     for row in raw.values()), "exact original FINAL gate counts required")
    counts = {gate: validator.Counts(**row) for gate, row in raw.items()}
    reduced, gates = _evaluate_final_cutoffs(validator, paired_plan.cutoffs, counts)
    _require(status == reduced and commitment(cell.get("gates")) == commitment(gates),
             "fused FINAL grade differs from the preregistered cutoff reducer")
    return status, 1 if status == "cutoffs_passed" else 0 if status == "cutoffs_failed" else None


def _t5_fusion_threshold_arm(validator, paired_plan, cell, pair, side, attempt, wall_elapsed, wall_horizon):
    attained = pair.get(side + "_attained")
    reason = pair.get(side + "_reason")
    measured = pair.get("observed_" + side + "_confirmation")
    identity = (pair["seed"], pair[side], pair.get(side + "_attempt_sha256"))
    _require(all(_pin(value) for value in (identity[2], cell.get("development_closeout_receipt_sha256")))
             and (cell.get("seed"), cell.get("arm"), cell.get("trained_attempt_sha256")) == identity
             and (attempt.get("seed"), attempt.get("arm"), attempt.get("attempt_sha256")) == identity
             and attempt.get("closeout_receipt_sha256") == cell["development_closeout_receipt_sha256"]
             and (attained is None or type(attained) is int and attained in (0, 1))
             and type(cell.get("development_attainment")) is type(attained)
             and cell.get("development_attainment") == attained and _name(reason)
             and cell.get("development_disposition") == reason
             and (measured is None or type(measured) is float and isfinite(measured) and measured >= 0),
             "fused threshold evidence must retain each original DEVELOPMENT attempt, close and disposition")
    development = attempt.get("decision")
    _require(type(development) is dict and type(development.get("closing_costs")) is dict
             and set(development["closing_costs"]) == set(COVERED_CLOCKS)
             and all(value is None or type(value) is float and isfinite(value) and value >= 0
                     for value in development["closing_costs"].values()),
             "exact original paid DEVELOPMENT closing-cost dispositions required")
    status, grade = _t5_fusion_threshold_final_grade(validator, paired_plan, cell)
    if attained == 1:
        confirmation = development.get("confirming_costs")
        _require(reason == "confirmed_within_horizon" and measured is not None and measured <= pair["horizon"]
                 and development.get("status") == "reached" and type(confirmation) is dict
                 and type(confirmation.get(paired_plan.clock)) is float and confirmation[paired_plan.clock] == measured
                 and "confirmation_budget_block" in attempt and attempt["confirmation_budget_block"] is None
                 and _pin(cell.get("checkpoint_sha256")) and status != "development_unavailable",
                 "eligible fused cutoff requires its original within-horizon confirming checkpoint and clock")
    else:
        _require(status == "development_unavailable" and "checkpoint_sha256" in cell and cell["checkpoint_sha256"] is None
                 and (measured is None or attained == 0 and measured > pair["horizon"]),
                 "no FINAL finding can be attributed to an unavailable DEVELOPMENT checkpoint")
    qualified = 0 if attained == 0 else grade if attained == 1 else None
    certified_within = None
    if wall_horizon is not None:
        certified_within = 0 if qualified == 0 else int(wall_elapsed <= wall_horizon) if wall_elapsed is not None else None
    return {"seed": identity[0], "arm": identity[1], "trained_attempt_sha256": identity[2],
            "checkpoint_sha256": cell["checkpoint_sha256"], "development_attainment": attained,
            "development_disposition": reason, "development_confirmation_seconds": measured,
            "development_closing_costs": dict(development["closing_costs"]),
            "final_status": status, "final_decision_sha256": cell["final_decision_sha256"],
            "final_report_sha256": cell["final_report_sha256"],
            "final_confirmed_development_attainment": qualified, "certification_wall_ns": wall_elapsed,
            "certification_wall_attainment": certified_within}


def _t5_fusion_threshold_attainment_bounds(rows, key):
    lower, upper = 0, 0
    for row in rows:
        before, after = (row[role][key] for role in ("baseline", "candidate"))
        lower += (0 if after is None else after) - (1 if before is None else before)
        upper += (1 if after is None else after) - (0 if before is None else before)
    return _wire((Fraction(lower, len(rows)), Fraction(upper, len(rows))))


def _t5_fusion_threshold_wall_bounds(rows, horizon):
    def restricted(arm):
        measured = arm["certification_wall_ns"]
        if measured is not None:
            capped = min(measured, horizon)
            return capped, capped
        if arm["final_confirmed_development_attainment"] == 0:
            return horizon, horizon
        return 0, horizon

    lower, upper = 0, 0
    for row in rows:
        left, right = (restricted(row[role]) for role in ("baseline", "candidate"))
        lower += right[0] - left[1]
        upper += right[1] - left[0]
    return {"horizon_ns": horizon, "attainment_delta_bounds": _t5_fusion_threshold_attainment_bounds(rows, "certification_wall_attainment"),
            "restricted_mean_wall_delta_ns_bounds": _wire((Fraction(lower, len(rows)), Fraction(upper, len(rows)))),
            "observed_time_pairs": sum(row["candidate_minus_baseline_certification_wall_ns_if_both_within_horizon"]
                                       is not None for row in rows),
            "scope": "finite_selected_seeds_and_original_single_frozen_checkpoint_rule"}


def _t5_fusion_threshold_physical_union(comparison, final_work, *, estimator_profile=None):
    parts = []
    for report in (comparison, final_work):
        events = report.get("physical_paid_events")
        _require(type(events) in (tuple, list) and all(type(row) is dict and set(row) == set(PaidEvent.__dataclass_fields__)
                 for row in events), "exact original paid physical records required for each phase")
        roster = _event_roster(tuple(PaidEvent(**row) for row in events))
        _require(report.get("physical_work_ns") == _physical_work_ns(roster),
                 "issued phase physical totals must reconcile with its original paid records")
        parts.append(roster)
    development, final = parts
    allocated_ids = [{*roster, *(event.close_receipt_sha256 for event in roster.values())} for roster in parts]
    _require(all(len(identities) == 2 * len(roster) for identities, roster in zip(allocated_ids, parts, strict=True))
             and allocated_ids[0].isdisjoint(allocated_ids[1]),
             "DEVELOPMENT and FINAL physical scopes must conserve distinct original event and close identities")
    if estimator_profile is not None:
        profile_ids = _t5_fusion_final_estimator_ids(estimator_profile)
        _require(all(profile_ids.isdisjoint(identities) for identities in allocated_ids),
                 "FINAL estimator metadata cannot name paid physical work")
    return {"development_physical_work_ns": _physical_work_ns(development), "final_physical_work_ns": _physical_work_ns(final),
            "observed_whole_study_physical_work_ns": _physical_work_ns(development | final),
            "paid_event_counts": (len(development), len(final)),
            "scope": "distinct_original_paid_events_across_all_registered_arms_not_per_arm_threshold_cost"}


def summarize_t5_fusion_paired_final_threshold(validator, *, plan, expected_plan_sha256, paired_plan, paired_final_result,
        expected_paired_final_result_sha256, development_comparison, certification_walls,
        expected_certification_walls_sha256, verify_threshold_owner, expected_estimator_provenance_sha256=None):
    """Replay a preregistered threshold endpoint over original paid decisions.

    The independent owner authenticates the issued pair, original paid DEVELOPMENT
    comparison, lawful preselection, and certification clocks if observed. A
    qualifying DEVELOPMENT time excludes later FINAL work and is descriptive
    among pairs that pass on both frozen checkpoints. Continuous certification
    wall is a distinct optional endpoint with independently attested bounds.
    A profile-bearing pair also requires the independently expected provenance
    commitment. Its evidence identifiers cannot name physical work.
    """
    _require(callable(verify_threshold_owner) and all(_pin(value) for value in (
                 expected_plan_sha256, expected_paired_final_result_sha256, expected_certification_walls_sha256))
             and t5_fusion_final_threshold_plan_commitment(plan) == expected_plan_sha256
             and t5_fusion_paired_final_plan_commitment(validator, paired_plan) == plan.paired_final_plan_sha256
             and type(paired_final_result) is dict and paired_final_result.get("schema") == T5_FUSION_PAIRED_FINAL_SCHEMA
             and commitment(paired_final_result) == expected_paired_final_result_sha256
             and (paired_final_result.get("paired_final_plan_sha256"), paired_final_result.get("development_comparison_sha256"),
                  paired_final_result.get("evidence_kind"), paired_final_result.get("contrast_id"), paired_final_result.get("eligible_clock"))
                 == (plan.paired_final_plan_sha256, paired_plan.development_comparison_sha256,
                     paired_plan.evidence_kind, paired_plan.contrast_id, paired_plan.clock)
             and (paired_final_result.get("frozen_roster_sha256"), paired_final_result.get("final_policy_sha256"),
                  paired_final_result.get("final_panel_sha256"), paired_final_result.get("final_panel_binding_sha256"),
                  paired_final_result.get("matched_teacher_inputs_sha256"))
                 == (paired_plan.frozen_roster_sha256, paired_plan.final_policy_sha256, commitment(paired_plan.panel),
                     paired_plan.final_panel_binding_sha256, commitment(paired_plan.matched_teacher_inputs))
             and _pin(paired_final_result.get("paired_final_evidence_sha256"))
             and _pin(paired_final_result.get("final_reservation_sha256"))
             and type(development_comparison) is dict and development_comparison.get("cost_basis") == "first_use"
             and development_comparison.get("reuse_count") is None
             and development_comparison.get("study_sha256") == paired_plan.study_sha256
             and commitment(development_comparison) == paired_plan.development_comparison_sha256
             and t5_fusion_final_certification_walls_commitment(expected_plan_sha256,
                 expected_paired_final_result_sha256, certification_walls) == expected_certification_walls_sha256
             and (plan.certification_wall_horizon_ns is not None or not certification_walls),
             "exact original paired cutoff decisions, first-use comparison and preregistered endpoint required")
    inputs = plan, paired_plan, paired_final_result, development_comparison, certification_walls
    selected_plan, paired_plan, result, comparison, walls = deepcopy(inputs)
    provenance_key = _T5_FUSION_FINAL_ESTIMATOR_PROVENANCE
    estimator_profile = None
    if provenance_key in result:
        estimator_profile = result[provenance_key]
        _t5_fusion_final_estimator_ids(estimator_profile)
        _require(_pin(expected_estimator_provenance_sha256)
                 and commitment(estimator_profile) == expected_estimator_provenance_sha256,
                 "threshold requires the independently expected estimator provenance")
    else:
        _require(expected_estimator_provenance_sha256 is None,
                 "threshold estimator expectation requires a profile-bearing paired result")
    records, cells = result.get("development_pairs"), result.get("cells")
    all_records, attempts = comparison.get("pairs"), comparison.get("attempts")
    seeds = tuple(row[0] for row in paired_plan.retention_references)
    _require(all(type(rows) in (tuple, list) and all(type(row) is dict for row in rows)
                 for rows in (records, cells, all_records, attempts))
             and tuple(record.get("seed") for record in records) == seeds and len(cells) == len(attempts) == 2 * len(seeds),
             "fused threshold summary must preserve every registered seed and both original arm cells")
    original = tuple(row for row in all_records if (row.get("contrast_id"), row.get("clock")) == (paired_plan.contrast_id, paired_plan.clock))
    _require(commitment(records) == commitment(original), "paired threshold summary changed the original DEVELOPMENT pairs")
    horizon = records[0].get("horizon")
    direction = (records[0].get("baseline"), records[0].get("candidate"))
    _require(type(horizon) is float and isfinite(horizon) and horizon > 0
             and all(_name(arm) for arm in direction) and direction[0] != direction[1]
             and all(type(row.get("horizon")) is float and (row.get("horizon"), row.get("baseline"), row.get("candidate"),
                     row.get("role")) == (horizon, *direction, "primary") for row in records),
             "one original primary contrast and finite common DEVELOPMENT horizon required")
    elapsed = _t5_fusion_final_certification_elapsed(result, comparison, walls)
    wall_horizon = selected_plan.certification_wall_horizon_ns
    rows = []
    for index, record in enumerate(records):
        left, right = (_t5_fusion_threshold_arm(validator, paired_plan, cells[2 * index + offset], record, role,
                    attempts[2 * index + offset], elapsed.get((record["seed"], record[role])), wall_horizon)
                    for offset, role in enumerate(("baseline", "candidate")))
        qualified_time = (right["development_confirmation_seconds"] - left["development_confirmation_seconds"]
                          if all(arm["final_confirmed_development_attainment"] == 1 for arm in (left, right)) else None)
        certified_time = (right["certification_wall_ns"] - left["certification_wall_ns"]
                          if all(arm["certification_wall_attainment"] == 1 for arm in (left, right)) else None)
        rows.append({"seed": record["seed"], "baseline": left, "candidate": right, "development_horizon": horizon,
                     "candidate_minus_baseline_development_seconds_if_both_final_confirmed": qualified_time,
                     "candidate_minus_baseline_certification_wall_ns_if_both_within_horizon": certified_time})
    final_work = result.get("final_work")
    _require(type(final_work) is dict, "preserve the original reconciled paid FINAL ledger")
    physical = _t5_fusion_threshold_physical_union(comparison, final_work, estimator_profile=estimator_profile)
    answer = {"schema": T5_FUSION_FINAL_THRESHOLD_SCHEMA, "threshold_plan_sha256": expected_plan_sha256,
              "paired_final_result_sha256": expected_paired_final_result_sha256,
              "development_comparison_sha256": paired_plan.development_comparison_sha256,
              "certification_walls_sha256": expected_certification_walls_sha256, "evidence_kind": paired_plan.evidence_kind,
              "contrast_id": paired_plan.contrast_id, "development_clock": paired_plan.clock,
              "development_horizon": horizon, "pairs": tuple(rows), "final_work": _wire(final_work), "physical_work": physical,
              "development_qualified_attainment": {"paired_seeds": len(rows),
                  "attainment_delta_bounds": _t5_fusion_threshold_attainment_bounds(rows, "final_confirmed_development_attainment"),
                  "observed_time_pairs": sum(row["candidate_minus_baseline_development_seconds_if_both_final_confirmed"]
                                             is not None for row in rows),
                  "time_scope": "descriptive_among_original_within_horizon_development_pairs_passing_independent_final_cutoffs"},
              "certification_wall": None if wall_horizon is None else _t5_fusion_threshold_wall_bounds(rows, wall_horizon)}
    if estimator_profile is not None:
        answer[provenance_key] = estimator_profile
    plan, pair_input, result_input, comparison_input, wall_inputs = inputs
    _require(verify_threshold_owner(expected_plan_sha256, expected_paired_final_result_sha256,
                 paired_plan.development_comparison_sha256, expected_certification_walls_sha256) is True
             and t5_fusion_final_threshold_plan_commitment(plan) == expected_plan_sha256
             and t5_fusion_paired_final_plan_commitment(validator, pair_input) == plan.paired_final_plan_sha256
             and commitment(result_input) == expected_paired_final_result_sha256
             and commitment(comparison_input) == paired_plan.development_comparison_sha256
             and t5_fusion_final_certification_walls_commitment(expected_plan_sha256,
                 expected_paired_final_result_sha256, wall_inputs) == expected_certification_walls_sha256,
             "fused threshold owner refused or exact original pair, threshold plan or wall evidence changed")
    return answer


def _t5_fusion_certification_span(value):
    if type(value) is dict:
        _require(set(value) == set(WallSpan.__dataclass_fields__), "original continuous wall span fields required")
        value = WallSpan(**value)
    _require(type(value) is WallSpan and _pin(value.clock_domain_sha256) and _pin(value.receipt_sha256)
             and type(value.start_ns) is type(value.end_ns) is int and 0 <= value.start_ns <= value.end_ns,
             "exact monotonic continuous wall span and receipt required")
    return value


def _t5_fusion_final_certification_elapsed(paired_result, development_comparison, walls):
    """Check original joined spans; independent ownership of the new certification is checked by the caller."""
    _require(type(walls) is tuple and all(type(row) is T5FusionFinalCertificationWall for row in walls),
             "exact optional fused FINAL certification wall roster required")
    if not walls:
        return {}
    _require(type(paired_result) is dict and paired_result.get("schema") == T5_FUSION_PAIRED_FINAL_SCHEMA
             and type(development_comparison) is dict
             and commitment(development_comparison) == paired_result.get("development_comparison_sha256"),
             "continuous wall requires the original paired FINAL and paid DEVELOPMENT comparison")
    work = paired_result["final_work"]
    cells, activity_clocks = paired_result["cells"], work["activity_clocks"]
    attempts, development_spans = development_comparison["attempts"], development_comparison["observed_elapsed_wall"]
    shared_baselines = work["shared_baseline_activities"]
    _require(all(type(roster) in (tuple, list) and all(type(row) is dict for row in roster)
                 for roster in (cells, activity_clocks, attempts, development_spans, shared_baselines)),
             "original paid DEVELOPMENT and FINAL wall rosters required")

    # This projection includes the DEVELOPMENT IDs present in the comparison and
    # the common reservation. The paired result binds the original frozen slots.
    prior_scope = {"final_reservation_sha256": paired_result["final_reservation_sha256"], "slots": ()}
    provenance_key = _T5_FUSION_FINAL_ESTIMATOR_PROVENANCE
    if provenance_key in paired_result:
        prior_scope[provenance_key] = paired_result[provenance_key]
    prior = _t5_fusion_final_prior_ids(prior_scope, development_comparison)
    prior.update(row[field] for row in work["physical_paid_events"]
                 for field in ("event_sha256", "close_receipt_sha256"))
    prior.update(row["evaluation_sha256"] for row in activity_clocks)
    prior.update(receipt for row in activity_clocks for receipt in row["clock_receipts"] if receipt is not None)
    prior.update(row["wall"]["receipt_sha256"] for row in activity_clocks if type(row.get("wall")) is dict)
    for key in ("paired_final_plan_sha256", "paired_final_evidence_sha256", "development_comparison_sha256",
                "frozen_roster_sha256"):
        prior.add(paired_result[key])
    for cell in cells:
        prior.update(cell[field] for field in ("final_resources_sha256", "final_report_sha256",
                     "final_decision_sha256", "final_evaluation_sha256", "final_terminal_close_sha256")
                     if _pin(cell.get(field)))

    used_new, used_development, used_final, elapsed = set(), set(), {}, {}
    for witness in walls:
        key = (witness.seed, witness.arm)
        ids = (witness.trained_attempt_sha256, witness.development_close_sha256, witness.development_wall_receipt_sha256,
               witness.final_decision_sha256, witness.final_terminal_close_sha256, witness.certification_event_sha256)
        _require(_name(witness.seed) and _name(witness.arm) and key not in elapsed
                 and all(_pin(value) for value in ids) and len(set(ids)) == len(ids)
                 and type(witness.activity_wall_receipts) is tuple and bool(witness.activity_wall_receipts)
                 and all(_pin(value) for value in witness.activity_wall_receipts)
                 and len(set(witness.activity_wall_receipts)) == len(witness.activity_wall_receipts)
                 and set(ids).isdisjoint(witness.activity_wall_receipts),
                 "one distinct fused FINAL certification and its original receipt roles required")
        certified = _t5_fusion_certification_span(witness.wall)
        new = {witness.certification_event_sha256, certified.receipt_sha256}
        _require(type(witness.wall) is WallSpan and len(new) == 2
                 and new.isdisjoint(prior | used_new | set(ids[:-1]) | set(witness.activity_wall_receipts)),
                 "continuous wall certification event and receipt cannot alias original or peer work")

        cell = _one_final_row(cells, lambda row: (row.get("seed"), row.get("arm")) == key,
                              "continuous wall requires one original paired FINAL cell")
        _require(type(cell.get("development_attainment")) is int and cell["development_attainment"] == 1
                 and cell.get("status") == "cutoffs_passed" and cell.get("matched_teacher_inputs_verified") is True
                 and (cell.get("trained_attempt_sha256"), cell.get("development_closeout_receipt_sha256"),
                      cell.get("final_decision_sha256"), cell.get("final_terminal_close_sha256")) ==
                     (witness.trained_attempt_sha256, witness.development_close_sha256,
                      witness.final_decision_sha256, witness.final_terminal_close_sha256),
                 "continuous wall requires the original confirmed DEVELOPMENT and passing independent FINAL cutoff decision")
        attempt = _one_final_row(attempts, lambda row: (row.get("seed"), row.get("arm")) == key,
                                 "continuous wall requires one original DEVELOPMENT attempt")
        _require((attempt.get("attempt_sha256"), attempt.get("closeout_receipt_sha256"))
                     == (witness.trained_attempt_sha256, witness.development_close_sha256),
                 "continuous wall cannot substitute the DEVELOPMENT close")
        dev_close = _one_final_row(development_spans,
            lambda row: (row.get("attempt_sha256"), row.get("stage")) == (witness.trained_attempt_sha256, "close"),
            "continuous wall requires the original paid DEVELOPMENT close span")
        dev = _t5_fusion_certification_span(dev_close.get("wall"))
        meter = attempt["cost_evidence"]["closing_meter"]
        receipts = meter.get("clock_receipts")
        costs = meter.get("costs")
        _require(dev.receipt_sha256 == witness.development_wall_receipt_sha256
                 and dev.receipt_sha256 not in used_development and dev.receipt_sha256 not in used_final
                 and type(receipts) in (tuple, list) and len(receipts) == len(COVERED_CLOCKS)
                 and receipts[0] == dev.receipt_sha256 and type(costs) is dict
                 and type(costs.get("wall_seconds")) is float
                 and costs["wall_seconds"] == (dev.end_ns - dev.start_ns) / 1_000_000_000
                 and (certified.clock_domain_sha256, certified.start_ns) == (dev.clock_domain_sha256, dev.start_ns)
                 and certified.end_ns >= dev.end_ns,
                 "continuous wall must retain the authenticated elapsed DEVELOPMENT origin and close")

        activities = tuple(row for row in activity_clocks if (row.get("seed"), row.get("arm")) == key)
        _require(_pin(cell.get("final_evaluation_sha256")), "continuous wall requires the selected original FINAL evaluation")
        selected = _one_final_row(activities, lambda row: row.get("evaluation_sha256") == cell["final_evaluation_sha256"],
                                  "continuous wall requires the selected original FINAL activity")
        _require(selected.get("role") == "candidate" and selected.get("status") == "complete",
                 "continuous wall requires the original completed FINAL evaluation")
        spans = tuple(_t5_fusion_certification_span(row.get("wall")) for row in activities)
        _require(tuple(span.receipt_sha256 for span in spans) == witness.activity_wall_receipts,
                 "continuous wall must bind every original FINAL activity span in order")
        for row, span in zip(activities, spans, strict=True):
            clocks = row.get("clock_receipts")
            receipt = span.receipt_sha256
            _require(type(clocks) in (tuple, list) and len(clocks) == len(COVERED_CLOCKS) and clocks[0] == receipt
                     and span.clock_domain_sha256 == certified.clock_domain_sha256
                     and certified.start_ns <= span.start_ns <= span.end_ns <= certified.end_ns
                     and (row["role"] == "baseline" or row["role"] == "candidate" and dev.end_ns <= span.start_ns)
                     and receipt not in used_development,
                     "continuous wall must enclose every original FINAL span in the same clock and ordered phase scope")
            previous = used_final.get(receipt)
            if previous is not None:
                _require(previous["seed"] == witness.seed and previous["arm"] != witness.arm
                         and previous["role"] == row["role"] == "baseline"
                         and previous["status"] == row["status"] == "complete"
                         and commitment({name: value for name, value in previous.items() if name != "arm"}) ==
                             commitment({name: value for name, value in row.items() if name != "arm"}),
                         "only the exact original shared retention baseline may reuse a FINAL wall")
                _one_final_row(shared_baselines, lambda saved: saved.get("seed") == witness.seed
                    and saved.get("evaluation_sha256") == row["evaluation_sha256"]
                    and type(saved.get("arms")) in (tuple, list) and len(saved["arms"]) == 2
                    and frozenset(saved["arms"]) == frozenset((previous["arm"], witness.arm)),
                    "shared retention baseline wall requires the original independently issued paid join")
            used_final[receipt] = row
        used_development.add(dev.receipt_sha256)
        used_new.update(new)
        elapsed[key] = certified.end_ns - certified.start_ns
    return elapsed


T5_FUSION_ALLOCATED_COMPUTE_PLAN_SCHEMA = "reviewed-t5-fusion-final-allocated-compute-plan/v1"


T5_FUSION_ALLOCATED_COMPUTE_SCHEMA = "reviewed-t5-fusion-final-allocated-compute-result/v1"


T5_FUSION_SHARED_RETENTION_ALLOCATION = "equal_fraction_of_original_shared_physical_baseline/v1"


@dataclass(frozen=True)
class T5FusionAllocatedComputePlan:
    threshold_plan_sha256: str
    paired_final_plan_sha256: str


def t5_fusion_allocated_compute_plan_commitment(plan):
    _require(type(plan) is T5FusionAllocatedComputePlan and _pin(plan.threshold_plan_sha256)
             and _pin(plan.paired_final_plan_sha256),
             "preselected original paired threshold and equal shared-retention allocation required")
    return commitment((T5_FUSION_ALLOCATED_COMPUTE_PLAN_SCHEMA, plan, T5_FUSION_SHARED_RETENTION_ALLOCATION))


def _t5_fusion_development_allocated_work(comparison, cost_evidence):
    _require(type(cost_evidence) is CostEvidence and cost_evidence.schema == COST_EVIDENCE_SCHEMA
             and commitment(cost_evidence) == comparison.get("cost_evidence_sha256")
             and _pin(cost_evidence.attempts_sha256)
             and (cost_evidence.study_sha256, cost_evidence.attempts_sha256)
                 == (comparison.get("study_sha256"), comparison.get("attempts_sha256"))
             and comparison.get("cost_basis") == "first_use" and comparison.get("reuse_count") is None,
             "exact originally paid first-use DEVELOPMENT cost evidence required")
    events = _event_roster(cost_evidence.events)
    _require(commitment(cost_evidence.events) == commitment(comparison.get("physical_paid_events"))
             and _physical_work_ns(events) == comparison.get("physical_work_ns"),
             "original paid DEVELOPMENT source counters do not cover its physical roster")
    observations = cost_evidence.observations
    _require(type(observations) is tuple and all(type(row) is tuple and len(row) == 2
                 and type(row[0]) is MeterInterval and type(row[1]) is ChargeManifest for row in observations),
             "exact original DEVELOPMENT interval and charge records required")
    closing = {interval.attempt_sha256: (interval, charges) for interval, charges in observations if interval.stage == "close"}
    attempts = comparison.get("attempts")
    _require(type(attempts) in (tuple, list) and bool(attempts) and all(type(row) is dict and _pin(row.get("attempt_sha256"))
                 and _name(row.get("seed")) and _name(row.get("arm")) for row in attempts)
             and len(closing) == sum(row[0].stage == "close" for row in observations) == len(attempts)
             and set(closing) == {row["attempt_sha256"] for row in attempts}
             and len({(row["seed"], row["arm"]) for row in attempts}) == len(attempts),
             "every original DEVELOPMENT arm needs one unaliased terminal allocation")
    shared = comparison.get("first_use_shared_work", {})
    interrupted = comparison.get("first_use_interrupted_preparation_events", ())
    _require(type(shared) is dict and shared.keys() <= events.keys()
             and all(type(labels) in (tuple, list) for labels in shared.values())
             and type(interrupted) in (tuple, list) and (shared or
                 ("first_use_shared_work_sha256" not in comparison and not interrupted)),
             "exact original first-use shared DEVELOPMENT assignments required")
    shared = {event: tuple(arms) for event, arms in shared.items()}
    if shared:
        _require(first_use_shared_work_commitment(shared, interrupted_preparation_events=tuple(interrupted))
                     == comparison.get("first_use_shared_work_sha256"),
                 "original independently approved first-use shared DEVELOPMENT commitment differs")
        interrupted = set(interrupted)
        _require(all(events[key].kind == "teacher_production" for key in interrupted)
                 and all(events[key].kind in FIRST_USE_SHARED_WORK_EVENT_KINDS and events[key].disposition == "complete"
                         for key in shared.keys() - interrupted),
                 "original shared DEVELOPMENT event kind or completion differs")
        attempts_by_id = {row["attempt_sha256"]: (row["seed"], row["arm"]) for row in attempts}
        roster = comparison.get("pairs")
        _require(type(roster) in (tuple, list) and all(type(row) is dict for row in roster),
                 "original shared DEVELOPMENT contrast roster required")
        directed_pairs = {(row.get("seed"), row.get("baseline"), row.get("candidate")) for row in roster}
        for left, right in shared.values():
            _require(left in attempts_by_id and right in attempts_by_id,
                     "original shared DEVELOPMENT assignment targets foreign attempt")
            (seed, baseline), (other_seed, candidate) = attempts_by_id[left], attempts_by_id[right]
            _require(seed == other_seed and baseline != candidate and (seed, baseline, candidate) in directed_pairs,
                     "original shared DEVELOPMENT requires its same-seed directed contrast")
    allocations = {event_id: {} for event_id in events}
    result = {}
    for row in attempts:
        attempt = row["attempt_sha256"]
        evidence = row.get("cost_evidence")
        _require(type(evidence) is dict and type(evidence.get("closing_meter")) is dict,
                 "original DEVELOPMENT closing meter required")
        meter = evidence["closing_meter"]
        interval, charges = closing[attempt]
        costs = meter.get("costs")
        receipts = meter.get("clock_receipts")
        decision = row.get("decision")
        _require((charges.attempt_sha256, charges.stage) == (attempt, "close")
                 and (meter.get("attempt_sha256"), meter.get("stage"), meter.get("scope")) == (attempt, "close", CUMULATIVE_ARM)
                 and _pin(interval.scope_receipt_sha256) and _pin(interval.subject_sha256)
                 and _pin(meter.get("record_sha256")) and meter["record_sha256"] == row.get("closing_meter_sha256")
                 and meter.get("interval_manifest_sha256") == commitment(interval)
                 and meter.get("charge_manifest_sha256") == commitment(charges)
                 and meter.get("includes_failed_attempts") is True
                 and type(costs) is dict and set(costs) == set(COVERED_CLOCKS)
                 and all(item is None or type(item) is float and isfinite(item) and item >= 0 for item in costs.values())
                 and type(receipts) in (tuple, list) and len(receipts) == len(COVERED_CLOCKS)
                 and all(receipt is None if costs[clock] is None else _pin(receipt)
                         for clock, receipt in zip(COVERED_CLOCKS, receipts, strict=True))
                 and type(decision) is dict and decision.get("closing_costs") == costs,
                 "original DEVELOPMENT closing allocation, meter or whole-arm scope differs")
        shares = _event_shares(charges, events, {})
        for event_id, amount in shares.items():
            allocations[event_id][attempt] = amount
        work = {}
        for clock, counter in (("cpu_seconds", "cpu_ns"), ("gpu_seconds", "gpu_ns")):
            measured = costs[clock]
            _require(measured is None or measured == _charged_seconds(events, shares, counter),
                     "original DEVELOPMENT measured clock differs from its exact paid event allocations")
            work[counter] = (None if measured is None else sum((getattr(events[event_id], counter) * share
                               for event_id, share in shares.items()), Fraction(0)))
        result[(row["seed"], row["arm"])] = work
    for event_id, shares in allocations.items():
        selected = shared.get(event_id)
        _require(bool(shares) and (len(shares) == 1 and selected is None and tuple(shares.values()) == (Fraction(1),)
                 or selected is not None and set(selected) == shares.keys()
                    and all(value == Fraction(1, 2) for value in shares.values())),
                 "DEVELOPMENT terminal allocations must conserve each original exclusive or shared event")
    return result


def _t5_fusion_paid_compute_arm(validator, pair_plan, row, original_pair, side, attempt, original_cell, development, final):
    replay = _t5_fusion_threshold_arm(validator, pair_plan, original_cell, original_pair, side, attempt, None, None)
    identity = (replay["seed"], replay["arm"])
    fields = ("seed", "arm", "trained_attempt_sha256", "checkpoint_sha256", "development_attainment",
              "development_disposition", "development_confirmation_seconds", "final_status", "final_decision_sha256",
              "final_report_sha256", "final_confirmed_development_attainment")
    _require(type(row) is dict and all(key in row and type(row[key]) is type(replay[key]) for key in fields)
             and tuple(row[key] for key in fields) == tuple(replay[key] for key in fields)
             and identity in development and identity in final,
             "allocated compute must use the exact original independently qualified threshold arm")
    before, after = development[identity], final[identity]
    counters = ("cpu_ns", "gpu_ns")
    total = {key: before[key] + after[key] if before[key] is not None and after[key] is not None else None for key in counters}
    return {"seed": identity[0], "arm": identity[1], "trained_attempt_sha256": replay["trained_attempt_sha256"],
            "final_status": replay["final_status"], "final_confirmed_development_attainment": replay["final_confirmed_development_attainment"],
            "development_allocated_ns": before, "final_allocated_ns": after, "paid_phase_total_allocated_ns": total}


def summarize_t5_fusion_final_allocated_compute(validator, *, plan, expected_plan_sha256, threshold_plan, threshold_result,
        expected_threshold_result_sha256, paired_plan, paired_final_result, expected_paired_final_result_sha256,
        frozen, development_comparison, development_cost_evidence, cells, verify_compute_owner, assessor=None,
        estimator_profile_selection=None, expected_estimator_profile_selection_sha256=None,
        expected_estimator_freeze_selection_sha256=None):
    """Attribute originally paid DEVELOPMENT and FINAL work to the original paired arms.

    The independent owner authenticates the preregistered allocation and unchanged
    earlier decisions and receipts. Shares are exact fractions of measured event
    counters. This scope ends at the original paid phase closes, with any later
    separately observed certification work outside these costs. A profiled
    allocation retains the same independently selected frozen profile on both
    issued endpoints and on each settled arm.
    """
    _require(callable(verify_compute_owner) and all(_pin(pin) for pin in (expected_plan_sha256,
                 expected_threshold_result_sha256, expected_paired_final_result_sha256))
             and t5_fusion_allocated_compute_plan_commitment(plan) == expected_plan_sha256
             and t5_fusion_final_threshold_plan_commitment(threshold_plan) == plan.threshold_plan_sha256
             and t5_fusion_paired_final_plan_commitment(validator, paired_plan) == plan.paired_final_plan_sha256
             and threshold_plan.paired_final_plan_sha256 == plan.paired_final_plan_sha256
             and type(threshold_result) is dict and threshold_result.get("schema") == T5_FUSION_FINAL_THRESHOLD_SCHEMA
             and commitment(threshold_result) == expected_threshold_result_sha256
             and (threshold_result.get("threshold_plan_sha256"), threshold_result.get("paired_final_result_sha256"),
                  threshold_result.get("development_comparison_sha256"), threshold_result.get("evidence_kind"),
                  threshold_result.get("contrast_id"), threshold_result.get("development_clock"))
                 == (plan.threshold_plan_sha256, expected_paired_final_result_sha256, paired_plan.development_comparison_sha256,
                     paired_plan.evidence_kind, paired_plan.contrast_id, paired_plan.clock)
             and type(paired_final_result) is dict and paired_final_result.get("schema") == T5_FUSION_PAIRED_FINAL_SCHEMA
             and commitment(paired_final_result) == expected_paired_final_result_sha256
             and (paired_final_result.get("paired_final_plan_sha256"), paired_final_result.get("development_comparison_sha256"),
                  paired_final_result.get("evidence_kind"), paired_final_result.get("contrast_id"), paired_final_result.get("eligible_clock"))
                 == (plan.paired_final_plan_sha256, paired_plan.development_comparison_sha256, paired_plan.evidence_kind,
                     paired_plan.contrast_id, paired_plan.clock)
             and type(development_comparison) is dict and commitment(development_comparison) == paired_plan.development_comparison_sha256
             and t5_fusion_paired_final_evidence_commitment(plan.paired_final_plan_sha256, cells)
                 == paired_final_result.get("paired_final_evidence_sha256"),
             "allocated compute requires exact independently issued paired FINAL and threshold envelopes, costs and preregistration")
    offered = (plan, threshold_plan, threshold_result, paired_plan, paired_final_result,
               frozen, development_comparison, development_cost_evidence, cells)
    original_pins = tuple(commitment(item) for item in offered)
    plan, _, qualified, paired_plan, result, frozen, comparison, cost, cells = deepcopy(offered)
    def current_estimator_profile():
        return _t5_fusion_final_estimator_profile(assessor, offered[5],
            expected_frozen_roster_sha256=paired_plan.frozen_roster_sha256,
            estimator_profile_selection=estimator_profile_selection,
            expected_estimator_profile_selection_sha256=expected_estimator_profile_selection_sha256,
            expected_estimator_freeze_selection_sha256=expected_estimator_freeze_selection_sha256)

    estimator_profile = current_estimator_profile()
    _require(_t5_fusion_final_matches_estimator(result, estimator_profile)
             and _t5_fusion_final_matches_estimator(qualified, estimator_profile),
             "allocated FINAL requires matching selected estimator provenance in paired and threshold results")
    _t5_fusion_final_check_settlement_estimators(cells, estimator_profile)
    development = _t5_fusion_development_allocated_work(comparison, cost)
    final = _t5_fusion_final_allocated_work(paired_plan, result, comparison, cells, frozen=frozen)
    rows, original, slots, attempts = (qualified.get("pairs"), result.get("development_pairs"),
                                       result.get("cells"), comparison.get("attempts"))
    _require(all(type(roster) in (tuple, list) and all(type(row) is dict for row in roster)
                 for roster in (rows, original, slots, attempts))
             and len(rows) == len(original) == len(paired_plan.retention_references)
             and len(slots) == len(attempts) == 2 * len(rows),
             "allocated compute must keep all original seed and arm decisions")
    primary = comparison.get("pairs")
    _require(type(primary) in (tuple, list) and all(type(row) is dict for row in primary)
             and commitment(original) == commitment(tuple(row for row in primary if
                 (row.get("contrast_id"), row.get("clock")) == (paired_plan.contrast_id, paired_plan.clock)))
             and tuple(row.get("seed") for row in original) == tuple(row[0] for row in paired_plan.retention_references)
             and all(type(row.get("horizon")) is float and isfinite(row["horizon"]) and row["horizon"] > 0
                     and _name(row.get("baseline")) and _name(row.get("candidate")) and row["baseline"] != row["candidate"]
                     for row in original), "allocated compute must retain the exact original primary comparison")
    pairs = []
    counters = ("cpu_ns", "gpu_ns")
    for index, (row, pair) in enumerate(zip(rows, original, strict=True)):
        _require(row.get("seed") == pair["seed"] and row.get("development_horizon") == pair["horizon"],
                 "allocated compute threshold evidence changed the original seed or horizon")
        left, right = (_t5_fusion_paid_compute_arm(validator, paired_plan, row.get(role), pair, role, attempts[2 * index + offset],
                       slots[2 * index + offset], development, final) for offset, role in enumerate(("baseline", "candidate")))
        both_qualified = left["final_confirmed_development_attainment"] == right["final_confirmed_development_attainment"] == 1
        left_total, right_total = (arm["paid_phase_total_allocated_ns"] for arm in (left, right))
        difference = {key: right_total[key] - left_total[key] if both_qualified and
                           left_total[key] is not None and right_total[key] is not None else None for key in counters}
        pairs.append({"seed": row["seed"], "baseline": left, "candidate": right,
                      "candidate_minus_baseline_allocated_ns_if_both_final_confirmed": difference})
    final_work = result.get("final_work")
    _require(type(final_work) is dict, "original paired FINAL physical costs required")
    physical = _t5_fusion_threshold_physical_union(comparison, final_work, estimator_profile=estimator_profile)
    _require(commitment(physical) == commitment(qualified.get("physical_work")) and commitment(final_work) == commitment(qualified.get("final_work")),
             "allocated per-arm compute must preserve the original disjoint study-level physical ledger")
    answer = _wire({"schema": T5_FUSION_ALLOCATED_COMPUTE_SCHEMA, "compute_plan_sha256": expected_plan_sha256,
                   "threshold_result_sha256": expected_threshold_result_sha256, "paired_final_result_sha256": expected_paired_final_result_sha256,
                   "evidence_kind": paired_plan.evidence_kind, "first_use_shared_retention_allocation": T5_FUSION_SHARED_RETENTION_ALLOCATION,
                   "pairs": tuple(pairs), "physical_work": physical,
                   "measured_final_confirmed_compute_pairs": {key: sum(
                       row["candidate_minus_baseline_allocated_ns_if_both_final_confirmed"][key] is not None for row in pairs) for key in counters},
                   "scope": "exact_allocated_compute_through_original_paid_closes_descriptive_among_both_final_confirmed"})
    if estimator_profile is not None:
        answer[_T5_FUSION_FINAL_ESTIMATOR_PROVENANCE] = estimator_profile
    _require(verify_compute_owner(expected_plan_sha256, expected_threshold_result_sha256,
                 expected_paired_final_result_sha256, original_pins) is True
             and tuple(commitment(item) for item in offered) == original_pins
             and current_estimator_profile() == estimator_profile,
             "allocated compute owner refused or original phase evidence changed")
    return answer


def _t5_fusion_final_allocated_work(paired_plan, paired_final_result, development_comparison, cells, *, frozen):
    """Replay original FINAL payment, then attribute its additive counters to the original arms."""
    _require(type(paired_plan) is T5FusionPairedFinalPlan and type(paired_final_result) is dict
             and paired_final_result.get("schema") == T5_FUSION_PAIRED_FINAL_SCHEMA
             and type(frozen) is dict
             and commitment(frozen) == paired_plan.frozen_roster_sha256 == paired_final_result.get("frozen_roster_sha256")
             and _pin(frozen.get("final_reservation_sha256"))
             and frozen["final_reservation_sha256"] == paired_final_result.get("final_reservation_sha256")
             and type(development_comparison) is dict
             and commitment(development_comparison) == paired_plan.development_comparison_sha256
                 == paired_final_result.get("development_comparison_sha256")
             and t5_fusion_paired_final_evidence_commitment(paired_final_result.get("paired_final_plan_sha256"), cells)
                 == paired_final_result.get("paired_final_evidence_sha256"),
             "allocating FINAL work requires the original paired result, frozen roster and typed paid evidence")
    selected, slots = paired_final_result.get("cells"), frozen.get("slots")
    _require(type(selected) in (tuple, list) and type(slots) in (tuple, list)
             and len(selected) == len(slots) == len(cells)
             and all(type(row) is dict for roster in (selected, slots) for row in roster),
             "allocated FINAL work must retain every original frozen paired cell")
    forbidden = _t5_fusion_final_prior_ids(frozen, development_comparison)
    forbidden.update(paired_final_result[name] for name in ("frozen_roster_sha256", "development_comparison_sha256",
                     "paired_final_plan_sha256", "paired_final_evidence_sha256"))
    paid, result = [], {}
    for cell, issued, slot in zip(cells, selected, slots, strict=True):
        key = (cell.seed, cell.arm)
        _require(key not in result and (issued.get("seed"), issued.get("arm")) == (slot.get("seed"), slot.get("arm")) == key
                 and issued.get("trained_attempt_sha256") == slot.get("attempt_sha256"),
                 "allocated FINAL work changed the original frozen seed, arm or attempt")
        result[key] = {"cpu_ns": None, "gpu_ns": None}
        resources = cell.verified_resources
        if resources is None:
            _require(issued.get("status") in ("unstarted", "development_unavailable")
                     and "final_resources_sha256" in issued and issued["final_resources_sha256"] is None
                     and cell.resource_evidence is None,
                     "unstarted or unavailable FINAL work cannot carry paid evidence")
            continue
        _require(type(resources) is dict and type(cell.resource_evidence) is FinalResourceEvidence
                 and issued.get("status") in ("paid_without_completed_review", "cutoffs_passed",
                                             "cutoffs_failed", "cutoffs_unavailable")
                 and commitment(resources) == issued.get("final_resources_sha256"),
                 "allocated FINAL work must use its exact issued resource result")
        forbidden.update(resources[name] for name in ("frozen_checkpoint_sha256", "final_resource_plan_sha256",
            "final_resource_evidence_sha256", "component_coverage_sha256", "final_report_sha256",
            "t5_fusion_final_teacher_costs_sha256") if _pin(resources.get(name)))
        paid.append((*key, resources, cell.resource_evidence, cell.retention_reference))

    reconciled = _t5_fusion_paired_final_cost_union(paired_plan, tuple(paid), forbidden)
    _require(commitment(reconciled) == commitment(paired_final_result.get("final_work")),
             "allocated FINAL work must replay the exact issued physical and charged roster")
    physical = _event_roster(tuple(PaidEvent(**row) for row in reconciled["physical_paid_events"]))
    shared = {(row["seed"], row["evaluation_sha256"]): tuple(row["arms"])
              for row in reconciled["shared_baseline_activities"]}
    allocations = {event_id: Fraction(0) for event_id in physical}
    for seed, arm, resources, evidence, _ in paid:
        totals = {"cpu_ns": Fraction(0), "gpu_ns": Fraction(0)}
        available = {"cpu_ns": True, "gpu_ns": True}
        for issued, (_, meter, _, charges) in zip(resources["activities"], evidence.closes, strict=True):
            activity = issued["activity"]
            arm_roster = shared.get((seed, activity["evaluation_sha256"]))
            if arm_roster is not None:
                _require(activity["role"] == "baseline" and len(arm_roster) == 2 and arm in arm_roster,
                         "allocated FINAL work can split only its exact complete shared retention baseline")
            proportion = Fraction(1, 2) if arm_roster is not None else Fraction(1)
            for counter, clock in (("cpu_ns", "cpu_seconds"), ("gpu_ns", "gpu_seconds")):
                available[counter] &= getattr(meter.costs, clock) is not None
            for event_id, original_share in charges.entries:
                share = original_share * proportion
                allocations[event_id] += share
                for counter in totals:
                    amount = getattr(physical[event_id], counter)
                    if amount is None:
                        available[counter] = False
                    else:
                        totals[counter] += share * amount
        result[(seed, arm)] = {counter: total if available[counter] else None for counter, total in totals.items()}
    _require(all(share == 1 for share in allocations.values()),
             "every physical FINAL event must conserve exactly one allocated unit across arms")
    return result

QWEN2_EXTERNAL_PROJECTOR_PAID_SCHEMA = "reviewed-qwen2-external-projector-paid-fixed-checkpoint-comparison/v1"
_QWEN2_PROJECTOR_REPORT_SCHEMA = "reviewed-qwen2-external-projector-development-assessment/v1"
_QWEN2_PROJECTOR_TERMINAL_SCHEMA = "reviewed-qwen2-projector-paid-attempts/v2"
_QWEN2_PROJECTOR_PHYSICAL_SCOPES = {"scripted_fixture": "archived-first-use-engineering-fixture",
                                   "native_reviewed": "matched-decoder-pilot"}


def qwen2_external_projector_evaluation_receipt(study_sha256, assessment_sha256, role):
    return _external_projector_evaluation_receipt(QWEN2_EXTERNAL_PROJECTOR_PAID_SCHEMA, study_sha256, assessment_sha256, role)


def compare_verified_qwen2_external_projector(validator, *, study, expected_study_sha256,
        attempts, expected_attempts_sha256, contrast_plan, expected_contrast_plan_sha256,
        assessment_reports, expected_assessment_report_sha256s, verify_assessment_owner,
        terminal_reports, expected_terminal_report_sha256s, arm_return_closes, expected_evidence_kind,
        verify_terminal_owner, evaluation_event_sha256s, cost_evidence, expected_cost_evidence_sha256, verify_cost_owner,
        expected_request_selection_sha256s=None, require_prelaunch_bound_releases=False):
    """Check Qwen2 review and paid evaluations against original direct releases."""
    _study(validator, study, expected_study_sha256)
    _require(type(expected_evidence_kind) is str and expected_evidence_kind in _QWEN2_PROJECTOR_PHYSICAL_SCOPES
             and callable(verify_terminal_owner) and callable(verify_assessment_owner)
             and type(attempts) is tuple and all(type(attempt) is Attempt for attempt in attempts)
             and type(cost_evidence) is CostEvidence
             and len(study.schedule) == study.required_streak == 1
             and type(terminal_reports) is type(expected_terminal_report_sha256s) is type(arm_return_closes) is tuple
             and len(terminal_reports) == len(expected_terminal_report_sha256s) == len(arm_return_closes) == len(study.seeds),
             "original Qwen2 terminal, evaluation and evidence-class owners required")
    _require(type(require_prelaunch_bound_releases) is bool
             and (not require_prelaunch_bound_releases or expected_request_selection_sha256s is not None),
             "prelaunch-bound Qwen2 comparison requires independently selected paid requests")
    if expected_request_selection_sha256s is not None:
        _require(type(expected_request_selection_sha256s) is tuple
                 and len(expected_request_selection_sha256s) == len(study.seeds)
                 and all(_pin(pin) for pin in expected_request_selection_sha256s),
                 "one independently selected Qwen2 request commitment per seed required")
    terminal_by_seed = {}
    event_roster = _event_roster(cost_evidence.events)
    expected_event_ids = {key for key, event in event_roster.items() if event.kind == "evaluation"}
    scoped_ids = set()
    last_charges = {row.attempt_sha256: dict(row.entries) for _, row in cost_evidence.observations if row.stage == "close"}
    look_charges = {row.attempt_sha256: dict(row.entries) for _, row in cost_evidence.observations
                    if row.stage == study.schedule[0]}
    by_slot = {(row.seed, row.arm): row.attempt_sha256 for row in attempts}
    request_pins = ((None,) * len(study.seeds) if expected_request_selection_sha256s is None
                    else expected_request_selection_sha256s)
    for seed, raw, digest, closes, request_pin in zip(study.seeds, terminal_reports,
            expected_terminal_report_sha256s, arm_return_closes, request_pins, strict=True):
        terminal = _selected_projector_report(raw, digest, _QWEN2_PROJECTOR_TERMINAL_SCHEMA)
        _require(("request_selection_sha256" in terminal) == (request_pin is not None)
                 and terminal.get("request_selection_sha256") == request_pin,
                 "original Qwen2 paid report differs from the selected request commitment")
        _require(("original_prelaunch_bound_releases" in terminal) == require_prelaunch_bound_releases
                 and (not require_prelaunch_bound_releases or terminal["original_prelaunch_bound_releases"] is True),
                 "Qwen2 paid report differs from the selected prelaunch-bound release requirement")
        proof, history = terminal.get("physical_proof"), terminal.get("attempts")
        _require(terminal.get("legal_scoring_or_dispatch_authority") is False
                 and terminal.get("all_four_available") is True
                 and terminal.get("complete_model_return_roles") == list(_T5_EXTERNAL_PROJECTOR_PAID_ROLES)
                 and type(proof) is dict and proof.get("scope") == _QWEN2_PROJECTOR_PHYSICAL_SCOPES[expected_evidence_kind]
                 and type(history) is list and 4 <= len(history) <= 32 and proof.get("event_count") == len(history)
                 and proof.get("selection_sha256") == terminal.get("attempts_sha256") and _pin(terminal.get("attempts_sha256"))
                 and type(closes) is tuple and len(closes) == len(_T5_EXTERNAL_PROJECTOR_PAID_ROLES),
                 "exact class-matched Qwen2 paid terminal history and four returns required")
        history_by_role = {role: [] for role in _T5_EXTERNAL_PROJECTOR_PAID_ROLES}
        by_seed = {}
        for item in history:
            _require(type(item) is dict and item.get("role") in _T5_EXTERNAL_PROJECTOR_PAID_ROLES
                     and _pin(item.get("event_sha256")), "typed original Qwen2 paid history required")
            role, event_id = item["role"], item["event_sha256"]
            event = event_roster.get(event_id)
            attempt_id = by_slot.get((seed.identifier, role))
            _require(event_id not in scoped_ids and event is not None and event.kind == "evaluation"
                     and (event.disposition, event.close_receipt_sha256) == (item.get("disposition"), item.get("physical_close_sha256"))
                     and last_charges.get(attempt_id, {}).get(event_id) == look_charges.get(attempt_id, {}).get(event_id) == 1,
                     "each original Qwen2 evaluation or failed retry must be paid once on its own arm at the look and at close")
            scoped_ids.add(event_id)
            by_seed[event_id] = event
            history_by_role[role].append(item)
        _require(proof.get("exclusive_paid_work") == _physical_work_ns(by_seed),
                 "Qwen2 terminal counters differ from the original evaluation and retry union")
        eligible = []
        for role, close in zip(_T5_EXTERNAL_PROJECTOR_PAID_ROLES, closes, strict=True):
            items = history_by_role[role]
            _require(items and items[-1]["disposition"] == "complete"
                     and all(row["disposition"] != "complete" for row in items[:-1])
                     and type(close) is bytes and 0 < len(close) <= 1024**2,
                     "Qwen2 review must use the one successful final evaluation of its selected role")
            item, close_pin = items[-1], sha256(close).hexdigest()
            original = _selected_projector_report(close, close_pin, "reviewed-qwen2-projector-protected-return/v2")
            inputs = {key: original.get(key) for key in ("binding_sha256", "source_sha256", "prefill_sha256")}
            _require(all(_pin(value) for value in inputs.values())
                     and original == {"schema": "reviewed-qwen2-projector-protected-return/v2", **inputs, **item}
                     and all(_pin(item.get(key)) for key in ("return_sha256", "parent_sha256", "release_report_sha256",
                         "original_owner_close_sha256", "terminal_link_sha256", "original_request_sha256"))
                     and item["release_report_sha256"] == item["original_owner_close_sha256"],
                     "the selected logical Qwen2 close differs from its genuine terminal role or release")
            eligible.append((inputs, item, close_pin))
        _require(all(input_pins == eligible[0][0] for input_pins, _, _ in eligible),
                 "all Qwen2 roles must share the same committed input and prefill")
        terminal_by_seed[seed.identifier] = (raw, digest, tuple(eligible))
    _require(scoped_ids == expected_event_ids, "original Qwen2 terminal history must exhaust every paid evaluation event")

    def verify(study_pin, seed, report_pin, raw, links):
        terminal, terminal_pin, eligible = terminal_by_seed[seed]
        report = json.loads(raw)
        _require(report.get("original_projector_evidence_kind") == expected_evidence_kind
                 and all(item["binding_sha256"] == report["binding_sha256"] for item, _, _ in eligible),
                 "original Qwen2 assessment and terminal input binding or evidence class differ")
        for arm, link, (_, paid, close_pin) in zip(report["arms"], links, eligible, strict=True):
            _require((arm["return_sha256"], *link) == (paid["return_sha256"], paid["role"], close_pin,
                         paid["event_sha256"], paid["physical_close_sha256"]),
                     "Qwen2 scientific evaluation differs from its exact logical and original physical close")
        _require(verify_terminal_owner(study_pin, seed, terminal_pin, terminal,
                                      tuple(close for _, _, close in eligible)) is True,
                 "original Qwen2 terminal owner refused its exact history and releases")
        return verify_assessment_owner(study_pin, seed, report_pin, raw, links)

    comparison = _compare_verified_external_projector(validator, paid_schema=QWEN2_EXTERNAL_PROJECTOR_PAID_SCHEMA,
        report_schema=_QWEN2_PROJECTOR_REPORT_SCHEMA, study=study, expected_study_sha256=expected_study_sha256,
        attempts=attempts, expected_attempts_sha256=expected_attempts_sha256, contrast_plan=contrast_plan,
        expected_contrast_plan_sha256=expected_contrast_plan_sha256, assessment_reports=assessment_reports,
        expected_assessment_report_sha256s=expected_assessment_report_sha256s, verify_assessment_owner=verify,
        evaluation_event_sha256s=evaluation_event_sha256s, cost_evidence=cost_evidence,
        expected_cost_evidence_sha256=expected_cost_evidence_sha256, verify_cost_owner=verify_cost_owner)
    if expected_request_selection_sha256s is not None:
        comparison["request_selection_sha256s"] = expected_request_selection_sha256s
    if require_prelaunch_bound_releases:
        comparison["original_prelaunch_bound_releases"] = True
    return {**comparison, "original_projector_evidence_kind": expected_evidence_kind}


QWEN2_EXTERNAL_PROJECTOR_PHYSICAL_SNAPSHOT_SCHEMA = "reviewed-qwen2-external-projector-physical-snapshot/v1"
QWEN2_EXTERNAL_PROJECTOR_EXPERIMENT_SCHEMA = "reviewed-qwen2-external-projector-experiment-accounting/v1"


def qwen2_external_projector_physical_snapshot_commitment(snapshot, events):
    return _external_projector_physical_snapshot_commitment(QWEN2_EXTERNAL_PROJECTOR_PHYSICAL_SNAPSHOT_SCHEMA, snapshot, events)


def readback_qwen2_external_projector_physical_work(validator, physical_owner, **inputs):
    return _readback_external_projector_physical_work(validator, physical_owner,
