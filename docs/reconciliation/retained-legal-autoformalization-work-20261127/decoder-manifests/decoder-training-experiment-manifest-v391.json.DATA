        "sha256": "7d9d08cbe88f9d987ca48055681f922cafe5ab9767d672ef07f9bf4d3089626d"
      },
      "full_crossed_profile": {
        "conditions": [
          "Authenticate the fixed product sampling frame, seed and group independence, original release policy, exact complete cell roster and family error allocation before any outcomes.",
          "Freeze common TRAIN/DEVELOPMENT inputs, checkpoint-choice procedure and evaluator configuration. Holdout groups cannot pick checkpoints or hyperparameters.",
          "A cell is a fixed bounded function of its seed input and independent group input conditional on common pre-study artifacts. Additional review/inference randomness must be frozen before the draws or supply independently scoped draws compatible with the matchings.",
          "Keep every selected seed and cell, paid failures and unresolved reviews. Excluding a seed because the checkpoint failed FINAL would select on outcomes and change the target.",
          "Keep the existing source fidelity, proof, retention, coverage, abstention and cost-to-threshold decisions on their original evidence. This confidence interval describes only the paired population fidelity contrast."
        ],
        "decomposition": "Set m=min(S,G), n=max(S,G). Offset k pairs each small-axis index i with large-axis index (i+k) mod n. Each matching contains m disjoint seed-group draws. Use all n matchings, which partition the rectangle exactly once.",
        "justification": "Each matching mean has m independent outcomes bounded in [-1,1]. Its centered log moment-generating function is at most t^2/(2*m). Apply convexity of exp to the average of all matching means, then the two-sided Hoeffding tail. Matchings may share inputs with other matchings.",
        "missingness": "Apply the radius to the latent complete equal-cell mean. Existing pointwise missingness bounds L and U contain that realized latent mean. Return [max(-1,L-R), min(1,U+R)] even if availability is informative.",
        "owner_upgrade": "Use a new method-bound sampling plan domain in the existing paired FINAL owner. Keep the existing v1 plan encoding and committed receipts unchanged. Bind frame law, fixed endpoint and error family, selected method, and original paid outcomes. No automatic migration.",
        "planning_profile_id": "crossed_two_sample_hoeffding/v1",
        "radius": "sqrt(2*ln(2/alpha)/min(S,G))",
        "retains_full_group_and_seed_roster_and_same_missingness_bounds": true
      },
      "illustrative_workloads_four_teacher_pairs_alpha_0_0125_gap_0_25": {
        "previous_balanced_full_cross": {
          "group_draws": 325,
          "minimum_teacher_final_arm_group_observations": 845000,
          "registered_training_attempts": 2925,
          "seed_draws": 325,
          "selected_comparison_cells": 105625
        },
        "proposed_balanced_full_cross": {
          "group_draws": 163,
          "minimum_teacher_final_arm_group_observations": 212552,
          "registered_training_attempts": 1467,
          "seed_draws": 163,
          "selected_comparison_cells": 26569
        },
        "separate_prospective_one_matching": {
          "group_draws": 163,
          "minimum_teacher_final_arm_group_observations": 1304,
          "registered_training_attempts": 1467,
          "seed_draws": 163,
          "selected_comparison_cells": 163
        }
      },
      "local_planning_verification": {
        "complete_and_sparse_mean_expectation_preserved": "1/3 in the enumerated non-additive fixture",
        "evaluated_missingness_completions_against_existing_owner": 16,
        "exact_finite_population_draw_configurations": 108,
        "rectangular_geometry_cases": 81,
        "sparse_finite_panel_counterexample": "selected diagonal=1, full realized mean=0",
        "strict_integer_precision_boundary_cases": 8
      },
      "optional_sparse_research_profile": {
        "design": "For balanced S=G, fix K distinct offsets before outcomes. Each seed and each group is represented K times. Under common seed/group marginals this preserves the same population mean and conservative radius.",
        "finite_panel_rule": "A sparse realized mean need not equal the full rectangle. If the full realized rectangle is reported, treat the unobserved cell weight as unknown in [-1,1], or leave the finite full-panel estimate unavailable.",
        "retained_constraints": "The existing FINAL owner binds each arm to the complete reserved panel. This sparse design does not alter that owner, certify an attempt, or remove original FINAL costs. It needs a separate preregistered cohort, owner and physically receipted roster before use.",
        "status": "future_separate_protocol",
        "unobserved_full_panel_bounds": "[(K/G)*L_sparse-(1-K/G), (K/G)*U_sparse+(1-K/G)] for balanced frozen axes."
      },
      "previous_precision_plan_retained": true,
      "primary_research": "https://www.cs.rpi.edu/academics/courses/spring06/random/hoefding.pdf#page=12",
      "primary_research_scope": "Hoeffding (1963), theorem 2 and section 5b with r=s=1; application to the current fidelity contrast is a design inference.",
      "schema": "prospective-paired-final-crossed-fidelity-matching-plan/v1",
      "status": "private_advisory_experiment_design",
      "target": "Same crossed product-law mean of candidate-minus-own-control fidelity, equal within-group row weights, with a common policy and independent prospective seed and group draws.",
      "workload_scope": "Conditional on recording all nine training attempts for each seed and all eight teacher arms against every selected comparison cell, with at least one eligible row per cell. Counts exclude additional looks and do not establish measured cost or a convergence improvement."
    },
