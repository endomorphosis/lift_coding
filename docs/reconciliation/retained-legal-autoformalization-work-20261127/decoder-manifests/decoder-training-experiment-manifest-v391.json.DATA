    "development_assessment_futility_plan": {
      "bound_existing_owners": {
        "heldout_gate_roster": {
          "bytes": 101486,
          "path": "/tmp/decoder-training-paired-final-private-v01/relational_assessment.py",
          "sha256": "53e1ffd0aa72edaa6e1ae8e1400e064c1a6fb0622866899b3846572abc337b76"
        },
        "threshold_reducer": {
          "bytes": 6211,
          "path": "/tmp/decoder-training-threshold-reference-v01.py",
          "sha256": "df9bee221d6e6dab1ee6e9ad621fd36442d44c77812eb58f3cb5f027f8ae5fdd"
        }
      },
      "criterion": {
        "abstention": "A verified abstention is a positive in this gate. The look cannot pass if T/N is strictly above the preregistered upper cutoff.",
        "equality": "Both gates are inclusive in the existing reducer; a best case equal to the threshold can still pass.",
        "fidelity_formal_coverage_retention": "For T verified positives, F verified negatives and U unknown out of N=T+F+U, the look cannot pass if (T+U)/N is strictly below the preregistered lower cutoff.",
        "zero_or_unverified_denominator": "Leave the gate unavailable. This optional proof does not treat that absence as a measured failure."
      },
      "disposition": [
        "Use only as a versioned, preregistered DEVELOPMENT option with the same evidence rules and work scheduling across all arms.",
        "Attach a separate noncertifying unattainability proof to the paused assessment and original paid owner close. Keep every row and original evaluated finding; unmeasured gate values remain unavailable.",
        "The existing threshold reducer keeps its actual pass/fail/unavailable decisions and cannot certify from partial observations. An unavailable scheduled look already breaks the sustained pass streak.",
        "Schedule later predefined looks normally. Lower performance at this checkpoint provides no impossibility proof about a later training checkpoint.",
        "Complete every required independently reviewed FINAL outcome and retention gate. For any DEVELOPMENT study requiring complete facet or four-arm outcomes, preserve the full evidence policy or use preregistered missingness bounds.",
        "Only avoid unstarted work. Retain actual resource and proof costs and close rights for anything started. Attach the original paid termination and identify intentionally unstarted components."
      ],
      "local_planning_checks": {
        "additional_controls": [
          "unknown/zero denominator",
          "inclusive cutoff equality",
          "independent retention reference",
          "mixed eligibility and formal denominators"
        ],
        "exact_reference": "Every integer completion for 1-6 rows, all five gates and six rational cutoffs was checked against the retained threshold reducer.",
        "partial_pattern_gate_cutoff_configurations": 32760,
        "provably_unattainable_configurations": 11640
      },
      "production_execution_or_source_selection": false,
      "proof_requirements": [
        "Use the original assessment owner and bind the exact admitted checkpoint/look, positive frozen denominator, ordered eligible row roster, cutoffs and evidence commitments before testing.",
        "Each resolved row must be an original, independently verified gate finding for that checkpoint and assessment, with no duplicates, reopened rows or environment substitution.",
        "The original roster fixes source-fidelity eligibility and formal obligation membership independently of candidate outputs. Coverage and abstention use the entire roster. Retention requires the complete independently authenticated baseline and its fixed positive denominator.",
        "Give each remaining or unmeasured row its most favorable outcome. A timeout, failure to review or unknown result remains unknown and may not contribute a resolved unfavorable outcome."
      ],
      "purpose": "Avoid starting more review or compiler work for one frozen DEVELOPMENT checkpoint when the registered gates already cannot all pass.",
      "schema": "decoder-fixed-development-look-futility-plan/v1",
      "status": "private_design_with_model_free_arithmetic_controls",
      "workload_example": {
        "best_possible_pass_fraction": "89/100",
        "coverage_lower_cutoff": "9/10",
        "frozen_roster_rows": 100,
        "remaining_unknown": 89,
        "verified_cannot_cover": 11,
        "workload_interpretation": "The evaluator can refrain from unrelated unstarted components if their only role is look certification and the original owner validates the evidence. There are no measured savings in this fixture."
      }
    },
