    "joint_mechanistic_credit_and_weight_edit_protocol": {
      "aim": "Measure whether a bounded activation-guided edit gives additional source-fidelity and cost-to-threshold benefit after structured reinforcement-learning credit.",
      "cost_to_threshold": {
