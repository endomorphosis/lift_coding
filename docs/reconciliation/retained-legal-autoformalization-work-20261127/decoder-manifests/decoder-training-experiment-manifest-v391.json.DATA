    "stage_a_paired_final_fidelity_precision_planning": {
      "a0_admission_effect": "none",
      "applies_to": "a prospective population source-fidelity contrast for the independently reviewed paired FINAL panel",
      "arithmetic": {
        "constant": "C = 2*ln(2/alpha)",
        "minimum_balanced_seeds_and_groups": "S=G=max(2,floor(2*C/t^2)+1).",
        "minimum_groups_for_fixed_seeds": "When t > 0 and S > C/t^2, G_min = max(2,floor(C/(t^2-C/S))+1). Otherwise no finite G clears the stated margin.",
        "planning_flow": [
          "Freeze the claim family, sampling frame and alpha allocation before outcomes; the union-bound allocation permits shared seeds, groups and controls across contrasts.",
          "For each allowed seed count within the prospective resource envelope, require enough eligible independent groups for the requested radius. Use the same fixed horizon and review coverage.",
          "Compare feasible seed/group plans with full original compute, teacher, verification and review costs. Include the remaining FINAL accesses, shared events once for physical totals, and failed attempts.",
          "When no combination is feasible, keep the result descriptive on its finite panel and retain unknown outcomes; use prospective redesign for a later population claim."
        ],
        "radius": "R = sqrt(C*(1/S+1/G))",
        "strict_margin_rule": "The lower effect bound L must satisfy L-R > delta. Define t = L-delta."
      },
      "claim_boundary": "These requirements address interval precision conditional on a realized or assumed identification bound. They supply neither power nor a measured effect. Cost-to-threshold and the other independent gates retain their original endpoints.",
