     def __post_init__(self) -> None:
         for name in ("sample_id", "obligation_id", "obligation_type", "legal_ir_view"):
@@ -1078,6 +1082,36 @@
                              or not _SHA256_RE.fullmatch(feedback_id[len(prefix):]))
         ):
             raise ProofFeedbackError("expected feedback record must be a canonical record ID")
+        receipt = self.checked_proof_receipt
+        expectation = self.checked_proof_expectation
+        if receipt is None and expectation is None:
+            return
+        from ...bridge.proof_receipt_attestation import TrustedProofReceipt
+        from ...ir_core.claims import FrozenMap
+
+        if type(receipt) is not TrustedProofReceipt or not isinstance(expectation, Mapping):
+            raise ProofFeedbackError("checked proof requires its typed receipt and independent expectation")
+        required = {
+            "receipt_id", "content_id", "source_result_digest", "property_id", "tree_id",
+            "backend_id", "authority", "assumptions", "bounds", "sample_sha256",
+            "formal_obligation_sha256", "reviewed_target_sha256", "dependency_manifest_sha256",
+        }
+        if not required.issubset(expectation):
+            raise ProofFeedbackError("checked proof expectation is incomplete")
+        for name in required - {"assumptions", "bounds"}:
+            if type(expectation[name]) is not str or not expectation[name]:
+                raise ProofFeedbackError("checked proof expectation identifiers must be explicit strings")
+        if expectation["authority"] != "theorem":
+            raise ProofFeedbackError("positive proof feedback requires theorem authority")
+        if (receipt.metadata.get("issued_at") or receipt.metadata.get("expires_at")) and not (
+            expectation.get("now") or expectation.get("as_of")
+        ):
+            raise ProofFeedbackError("time-bounded proof requires an explicitly selected as-of value")
+        try:
+            frozen = FrozenMap(expectation)
+        except (TypeError, ValueError) as error:
+            raise ProofFeedbackError("checked proof expectation must be immutable JSON") from error
+        object.__setattr__(self, "checked_proof_expectation", frozen)
 
