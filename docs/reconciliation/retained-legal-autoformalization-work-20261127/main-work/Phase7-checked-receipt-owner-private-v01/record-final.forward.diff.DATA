@@ -1101,6 +1135,53 @@
             and self.obligation_type == record.obligation_type
             and self.legal_ir_view == record.legal_ir_view
             and self.obligation_digest == record.obligation_digest
+            and (not record.positive or self._checked_positive_receipt_matches(record))
+        )
+
+    def _checked_positive_receipt_matches(self, record: LegalIRProofFeedbackRecord) -> bool:
+        """Validate supplied checked evidence against an independent selection.
+
+        This validates the receipt and its selected bindings; it does not run a
+        prover, authenticate its producer, infer formal-target IDs, or grant
+        legal review. The evidence owner supplies the receipt-to-target join.
+        Legacy nonpositive feedback retains its separate verification path.
+        """
+
+        receipt = self.checked_proof_receipt
+        expectation = self.checked_proof_expectation
+        if receipt is None or expectation is None:
+            return False
+        from ...bridge.proof_receipt_attestation import TrustedProofReceipt
+        from ...verification_api import (
+            TRUSTED_PROOF_RECEIPT_SCHEMA, VERIFIED_RECEIPT_DISPATCH_INTERFACE,
+            LogicVerificationAPI, VerificationAuthority, VerificationStatus,
+        )
+
+        if type(receipt) is not TrustedProofReceipt or receipt.receipt_id not in record.receipt_ids:
+            return False
+        for name in ("sample_sha256", "formal_obligation_sha256", "reviewed_target_sha256",
+                     "dependency_manifest_sha256"):
+            if expectation.get(name) != getattr(self, name):
+                return False
+        response = LogicVerificationAPI().verify_receipt(
+            receipt, expectation=expectation, request_id=record.record_id
+        )
+        result = dict(response.result)
+        return (
+            response.operation == "verify_receipt"
+            and response.status is VerificationStatus.SUCCEEDED
+            and response.authority is VerificationAuthority.THEOREM
+            and response.request_id == record.record_id
+            and result.get("valid") is True
+            and result.get("kind") == "trusted_proof_receipt"
+            and result.get("dispatch") == VERIFIED_RECEIPT_DISPATCH_INTERFACE
+            and result.get("schema_version") == TRUSTED_PROOF_RECEIPT_SCHEMA
+            and result.get("underlying_authority") == "theorem"
+            and result.get("underlying_status") == "proved"
+            and result.get("receipt_id") == expectation["receipt_id"]
+            and result.get("content_id") == expectation["content_id"]
+            and result.get("source_result_digest") == expectation["source_result_digest"]
+            and result.get("round_trip") == receipt.to_dict()
         )
 
 
