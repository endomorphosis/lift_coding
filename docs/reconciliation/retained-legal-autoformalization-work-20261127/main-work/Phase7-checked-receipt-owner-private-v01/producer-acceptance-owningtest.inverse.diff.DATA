-def _generated_formula_exception_obligation(train):
-    from ipfs_datasets_py.logic.integration.reasoning.legal_ir_obligations import (
-        generate_legal_ir_proof_obligations,
-    )
-
-    # Contract coverage can share this kind; select the actual formula obligation.
-    obligations = [item for item in generate_legal_ir_proof_obligations(train)
-                   if item.kind == "exception_scope_precedence"
-                   and item.formula_id and item.metadata.get("exception_count", 0) > 0
-                   and item.statement.startswith("exception_scope_precedes_norm(")]
-    assert obligations
-    obligation = obligations[0]
-    assert obligation.sample_id == train.sample_id
-    assert obligation.obligation_id != train.sample_id
-    assert obligation.legal_ir_view == "deontic.ir"
-    assert obligation.logic_family == "conditional_normative"
-    return obligation
