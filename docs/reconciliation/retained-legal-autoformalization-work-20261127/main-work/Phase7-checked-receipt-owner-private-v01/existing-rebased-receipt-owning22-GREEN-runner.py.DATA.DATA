"""Rebind the existing Phase7 no-fit controls to a pinned private Git projection."""

import argparse
import ast
from dataclasses import replace
import hashlib
import importlib.util
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import sys
import traceback
from types import ModuleType

STAGE = Path('/tmp/codex-all-work-github-main-reconciliation-20261123-etm066qn/Phase8-existing-native-CI-trigger-repair-private-v01/coordination-full-goal-v02/Phase7-Guide571-exact-eight-current-producer-private-heuvytq_')
RETAINED_ADAPTER = (
    "no-fit-current-obligation-bound-feedback-adapter-v02.py", 20480,
    "43ad9ed1524e541998646663dc67baea01cacce87769666d4afa12cd6252abf7",
)
RED_ADAPTER = (
    "no-fit-current-obligation-adapter-v01.py", 20405,
    "a84c49de31dd4218043f2f6b9ff1f9ef954291eddde2661b20a580fbbc539bf7",
)
RED_MANIFEST = ('no-fit-overlay-current-Guide571-red.manifest.json', 427, '8660221d9e68a845a86b37473f8e916c3fb75d4fd36e9b3927f9748a51d0a079')
RECEIPT_GREEN = (
    "no-fit-exact-feedback-receipt-substitution-v02.py", 4047,
    "ca63791a73523e689cef71a8b9682e7989464ea6959a6ee465fd0ef219142634",
