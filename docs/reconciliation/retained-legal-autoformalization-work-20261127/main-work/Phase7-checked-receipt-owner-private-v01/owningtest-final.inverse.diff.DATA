-def _checked_current_feedback_fixture(train, versions):
-    """Author both sides of a fictional selection; this is not a Native proof."""
-    from dataclasses import replace
-
-    from ipfs_datasets_py.logic.backends.results import ResultAuthority, ResultStatus, TheoremResult
-    from ipfs_datasets_py.logic.bridge.proof_receipt_attestation import (
-        build_trusted_receipt_from_backend_result,
-    )
-    from ipfs_datasets_py.logic.families.models import EvidenceAuthority
-    from ipfs_datasets_py.logic.ir_core.claims import FrozenMap
-    from ipfs_datasets_py.logic.ir_core.protocols import ExecutionBounds
-
-    # These authored IDs agree with the existing fictional record fixture.
-    # Neither the offered receipt nor untrusted feedback supplies the expectation.
-    result = TheoremResult(
-        result_id="fictional-current-feedback-result",
-        backend_id="fictional-independent-checker",
-        backend_version="fictional-v1",
-        authority=ResultAuthority.THEOREM,
-        status=ResultStatus.PROVED,
-        assumptions=("fictional-reviewed-assumption",),
-        bounds=ExecutionBounds(timeout_ms=1000, max_steps=100),
-        translation_ceiling=EvidenceAuthority.INDEPENDENTLY_CHECKABLE,
-        metadata=FrozenMap({
-            "bounds": {"timeout_ms": 1000, "max_steps": 100},
-            "issued_at": "2026-01-01T00:00:00Z",
-            "expires_at": "2030-01-01T00:00:00Z",
-        }),
-    )
-    expected = build_trusted_receipt_from_backend_result(
-        result,
-        theorem_id="fictional-current-feedback-theorem",
-        property_id="fictional-current-feedback-property",
-        translation_receipt_id="fictional-current-feedback-translation",
-        tree_id="fictional-current-feedback-tree",
-        policy_id="fictional-current-feedback-policy",
-        receipt_id="proof-feedback-receipt",
-    )
-    record, selected = _current_feedback_fixture(train, versions)
-    expectation = {
-        "receipt_id": "proof-feedback-receipt",
-        "content_id": expected.content_id,
-        "source_result_digest": result.digest,
-        "property_id": "fictional-current-feedback-property",
-        "tree_id": "fictional-current-feedback-tree",
-        "backend_id": "fictional-independent-checker",
-        "authority": "theorem",
-        "assumptions": ["fictional-reviewed-assumption"],
-        "bounds": {"timeout_ms": 1000, "max_steps": 100},
-        "now": "2026-01-02T00:00:00Z",
-        "sample_sha256": selected.sample_sha256,
-        "formal_obligation_sha256": selected.formal_obligation_sha256,
-        "reviewed_target_sha256": selected.reviewed_target_sha256,
-        "dependency_manifest_sha256": selected.dependency_manifest_sha256,
-    }
-    target = replace(
-        selected, checked_proof_receipt=expected, checked_proof_expectation=expectation,
-    )
-    return record, target, expected, expectation
-
