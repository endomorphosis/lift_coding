assert write_cap['previous_charge']==install['full_charge']
assert charge['previous_charge']==freeze['full_charge']
def ledger_join(prior_record, successor_record):
    prior=prior_record['after_full_retained_precharge']; before=successor_record['prior']
    after=successor_record['after_full_retained_precharge']
    amount=successor_record['added_Source_only_envelope']
    assert type(amount) is int and amount>0
    for key in ('used','internal_used','global_cap','internal_cap'):
        assert prior[key]==before[key] and after[key]==before[key]+amount
    assert after['captures']>=before['captures']>=prior['captures']
    assert successor_record['exact_human_affirmation']==prior_record['exact_human_affirmation']
    assert successor_record['all_prior_costs_retained'] is successor_record['resource_policy_capacity_unchanged'] is True
ledger_join(guide_cap,write_cap)
ledger_join(write_cap,charge)
read(charge['exact_human_affirmation'])
ledger = charge['after_full_retained_precharge']
assert ledger['global_cap'] >= ledger['used'] >= ledger['internal_used']
assert ledger['internal_cap'] >= ledger['internal_used']
assert all(closed['actual_ledger_after'][k]==ledger[k] for k in ('used','internal_used','global_cap','internal_cap'))
old_D = Path(controls['historical_D_path'])
old_fixture = load(controls['historical_fixture_reference'])
def retarget_path(path):
    return str(D / Path(path).relative_to(old_D))
def retarget_row(row):
    rel = Path(row['path']).relative_to(old_D).as_posix()
    fresh = current[retarget_path(row['path'])]
    expected = images[rel]
    assert all(fresh[k] == expected[k] for k in ('bytes', 'sha256')), rel
    return fresh
rows = [retarget_row(row) for row in old_fixture['required_fixture_closure']]
assert {Path(row['path']).relative_to(D).as_posix() for row in rows}==set(images)
assert len(rows) == len({row['path'] for row in rows}) == controls['fixture_closure_count'] == 32
absences = [retarget_path(path) for path in old_fixture['required_current_namespace_absences']]
assert len(absences) == len(set(absences)) == 6 and all(not os.path.lexists(path) for path in absences)
fixture_wire = old_fixture | dict(
    schema='actual-existing-P1-ordinary99-protected-fixture-closure/v1',
    actual_closed_Source_READ_reference=closed_ref, current_Source_absence_rows=None,
    current_physical_integration_package_Source_row=retarget_row(old_fixture['current_physical_integration_package_Source_row']),
    required_fixture_closure=rows, pytest_inifile=retarget_path(old_fixture['pytest_inifile']),
    required_current_namespace_absences=absences,
    required_normal_conftests=[retarget_path(path) for path in old_fixture['required_normal_conftests']])
assert set(fixture_wire['required_normal_conftests']) == {str(D/'conftest.py'), str(D/'tests/conftest.py')}
fixture = seal('actual-live-ordinary99-exact-32-fixture-wire.json', fixture_wire)
proof = seal('actual-live-ordinary99-clean-D-A-index-provenance.json', dict(
    D=didx, A=aidx, branch=branch, frozen=freeze_ref, actual_paired_D_A_READ3=closed_ref,
    A_raw_Source_index_capture_claimed=False, A_index_metadata_verified_against_current_epoch=True))
D_prov, A_prov = (
    dict(root=p['root'], HEAD=p['Git_HEAD'], tree=p['Git_tree'], actual_closed_Source_READ=closed_ref,
         clean_index_provenance_reference=proof, local_frozen_Git_metadata_reference=metadata,
         clean_worktree_and_index=True, status_sha256=digest(b''))
    for p, metadata in ((d_project, freeze_ref), (a_project, proof)))
ready = seal('READY-live-ordinary99-actual-READ3-INERT.json', dict(
    schema='actual-READ3-live-ordinary99-nonclock/v1', controls=controls_ref, read=abi_ref,
    fixture=fixture, freeze=freeze_ref, read_close=closed_ref, modules=modules,
    D_prov=D_prov, A_prov=A_prov, outer=outer_ref, python=python_ref,
    expected_absent_paths=absences, latest_closed_Source_full_precharge=charge_ref,
    read3_named_metadata_guard=guard_ref, named_metadata_count=len(guards),
    isolated_frozen_local_git_candidate=True, canonical_source_application=False,
    protected_guide_publication=guide_ref, protected_guide_full_charge=install['full_charge'],
    observed_independent_base=base_ref,
    exact_write_full_charge=freeze['full_charge'],
    final_ordinary_runtime_qualification_eligibility_authority=None))
print(json.dumps(ready, sort_keys=True))
