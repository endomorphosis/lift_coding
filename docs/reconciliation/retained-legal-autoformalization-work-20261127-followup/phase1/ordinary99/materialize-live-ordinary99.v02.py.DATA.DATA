closed_ref = dict(path=sys.argv[1], bytes=int(sys.argv[2]), sha256=sys.argv[3])
controls_ref = dict(path=str(HERE/'READY-P1-existing-ordinary99-controls-INERT.json'), bytes=16781,
    sha256='a10401245bb5ad6c26a84979d7ea62e509eaff917ef2d0bcc30981002ec01241')
closed, controls = load(closed_ref), load(controls_ref)
assert closed['terminal_returncode'] == 0 and closed['Source_closed'] is closed['module_closed'] is True
assert closed['ordinary_phase_qualified'] is closed['Source_WRITE_claimed'] is closed['promotion_selected'] is False
assert controls['selected_Git_candidate'] is controls['selected_Source'] is controls['selected_root_clock'] is controls['selected_runtime_bindings'] is None
assert controls['ordinary_result'] is controls['native_result'] is None and controls['cases']==99 and controls['functions']==24
