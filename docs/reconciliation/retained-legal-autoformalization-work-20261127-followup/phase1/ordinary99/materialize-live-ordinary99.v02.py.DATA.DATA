import hashlib
import json
import os
from pathlib import Path
import stat
import sys

HERE = Path(__file__).resolve().parent
keys = ('path', 'bytes', 'sha256')
fields = ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_uid', 'st_gid', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
def stamp(s):
    return {k: str(getattr(s, k)) for k in fields}
def digest(b):
    return hashlib.sha256(b).hexdigest()
def read(ref):
    p = Path(ref['path'])
    assert p.is_absolute()
    with os.fdopen(os.open(p, os.O_NOFOLLOW | os.O_RDONLY), 'rb') as f:
        before = os.fstat(f.fileno())
        assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_size == ref['bytes']
        b = f.read(ref['bytes'] + 1)
        assert stamp(before) == stamp(os.fstat(f.fileno())) == stamp(p.lstat())
    assert len(b) == ref['bytes'] and digest(b) == ref['sha256']
    return b
def load(ref):
    return json.loads(read(ref))
def seal(name, value):
    path = HERE / name
    raw = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode()
    with os.fdopen(os.open(path, os.O_CREAT | os.O_NOFOLLOW | os.O_WRONLY | os.O_EXCL, 0o400), 'wb') as f:
        f.write(raw)
        f.flush()
        os.fsync(f.fileno())
    return dict(path=str(path), bytes=len(raw), sha256=digest(raw))

