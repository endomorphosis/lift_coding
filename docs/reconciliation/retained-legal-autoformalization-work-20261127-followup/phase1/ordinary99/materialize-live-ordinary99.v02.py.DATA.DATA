captures = {row['path']: row for row in closed['individual_captures']}
expected = set(controls['expected_ownership_roles'])
assert set(candidate['roles'])==expected
assert len(captures) == len(closed['individual_captures']) == 3
assert set(captures) == {str(D/rel) for rel in expected} | {didx['path']}
assert set(freeze['committed']) == expected
for path, row in captures.items():
    held = current[path]
    assert all(held[k] == row[k] for k in ('path', 'bytes', 'sha256', 'full9'))
    b = read(row['raw_reference'])
    assert len(b) == held['bytes'] and digest(b) == held['sha256']
    if path != didx['path']:
        rel = Path(path).relative_to(D).as_posix()
        role = candidate['roles'][rel]
        target = controls['expected_ownership_roles'][rel]
        installed = freeze['committed'][rel]
        source_before=read(role['before'])
        assert digest(source_before)==target['before_sha256']
        assert b == read(role['after']) == read(target['expected_after'])
        def git_blob(body):
            return hashlib.sha1(f'blob {len(body)}\0'.encode()+body).hexdigest()
        assert git_blob(source_before)==installed['parent_blob']==target['before_Gitblob']
        assert git_blob(b)==installed['stage0_and_committed_blob']==target['expected_Gitblob']
        assert all(held[k] == installed[k] for k in ('path', 'bytes', 'sha256', 'full9'))

role_plan = controls['future_roles']['guarded_bootstrap_modules']
images = controls['future_roles']['fixture_roles']
assert len(images)==controls['fixture_closure_count']==32
modules = {}
for name, role in role_plan.items():
