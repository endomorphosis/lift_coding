actual_epoch=load(abi['actual_isolated_content_epoch'])
assert actual_epoch['terminal_returncode']==0 and actual_epoch['Source_closed'] is actual_epoch['module_closed'] is True
assert actual_epoch['outer_epoch_reference']==abi['outer_epoch_reference']
