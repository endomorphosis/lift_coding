base=load(base_ref)
assert base['schema']=='observed-current-main-independent-V2-descendant-of-Guide580/v1'
assert base['observed_base_is_direct_dataset_descendant'] is True and base['git_worktrees_changed'] is False
assert base['guide_main']['datasets']==controls['expected_D_publish_head']
assert base['live_main_after']['datasets']==freeze['parent']=='9a89672b4b3d32d6e83fbc29368b40e4cc033612'
assert base['guide_main']['accelerate']==base['live_main_after']['accelerate']==controls['expected_A_publish_head']
assert set(base['exact_D_delta'])=={
    'ipfs_datasets_py/logic/autoformal/legal_norm_content_adjudication_v1.py',
    'tests/unit/logic/autoformal/test_legal_norm_content_adjudication_v1.py'}
assert all(base['unchanged_D_git_blobs'][path]==row['before_Gitblob']
           for path,row in controls['expected_ownership_roles'].items())

assert freeze['terminal_returncode'] == 0 and freeze['pushed'] is False
assert freeze['isolated_Source_context_closed'] is freeze['local_clean'] is freeze['only_two_D_tree_entries_changed'] is True
assert freeze['shared_source_or_Git_mutation'] is False
assert freeze['ordinary_qualified'] is freeze['qualified_native'] is False
assert len(closed['actual_closed_Source_read_leases'])==2
assert all(row['mode']=='read' and row['cooperative'] is True for row in closed['actual_closed_Source_read_leases'])
d_project, a_project = closed['projects']
D, A = Path(d_project['root']), Path(a_project['root'])
assert str(D) == freeze['root'] == controls['current_D_path'] and D.resolve(strict=True) == D
assert str(A) == controls['current_additional_A_path'] and A.resolve(strict=True) == A
frozen = freeze['frozen']
assert (d_project['Git_HEAD'], d_project['Git_tree']) == (frozen['HEAD'], frozen['tree'])
assert (a_project['Git_HEAD'], a_project['Git_tree']) == (controls['expected_A_publish_head'], controls['expected_A_tree'])
didx = frozen['index']
assert didx['path'] == str(D / '.git/index') and closed['protected_index_reference'] == didx
branch = frozen['branch_file']
assert stamp(Path(branch['path']).lstat()) == branch['full9']

abi_ref = closed['ordinary_read_binding_abi']
abi = load(abi_ref)
assert abi['schema'] == 'actual-D27-observed-D-root-initializer-READ-small-closeout/v1'
assert abi['Root_selected'] is abi['Source_closed'] is abi['owned_module_closed'] is True
assert abi['exact_local_freeze'] == freeze_ref and abi['protected_index_reference'] == didx
assert all(abi[k] == closed[k] for k in (
    'actual_isolated_content_epoch','outer_epoch_reference','outer_epoch_record_count',
