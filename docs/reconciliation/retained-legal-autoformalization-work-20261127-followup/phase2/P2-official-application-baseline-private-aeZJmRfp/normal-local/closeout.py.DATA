from pathlib import Path
import fcntl, hashlib, json, os, subprocess
import xml.etree.ElementTree as ET
w=Path(__file__).resolve().parent
def file_ref(path):
    data=path.read_bytes()
    return {"path":str(path),"bytes":len(data),"sha256":hashlib.sha256(data).hexdigest()}
metadata=json.loads((w/"real-checkout-pins.json").read_bytes())
src=Path(metadata["selected_repo"])
seal=metadata["private_seal"]
assert file_ref(Path(seal["path"]))==seal
normal={}
commit=metadata["authored_candidate"]["oid"]
for name,count in (("official",7),("legacy",4)):
    path=w/name/"local-source-closeout.json"
    row=json.loads(path.read_bytes())
    xml=Path(row["junit"]["path"])
    pin=file_ref(xml)
    assert pin=={key:row["junit"][key] for key in pin}
    nodes=ET.fromstring(xml.read_bytes()).findall(".//testcase")
    assert len(nodes)==count==len({(n.get("name"),n.get("classname")) for n in nodes})
    assert all(node.find(tag) is None for node in nodes for tag in ("failure","error","skipped"))
    assert row["returncode"]==0 and row["commit"]==commit and row["source_read_closed"]
    assert row["same_collection_execution_xml"] and row["all_source_pins_verified_before_and_after"]
    assert len(row["conftest_origins"])==3
    actual_functions=[n.get("name").split("[",1)[0] for n in nodes]
    assert [n.get("name") for n in nodes]==[entry.split("::")[-1] for entry in row["collected"]]
    roster=[entry.split("::")[-1] for entry in (w.parent/("final-official.selectors" if name=="official" else "legacy.selectors")).read_text().splitlines()]
    vector=[1]*len(roster)
    assert actual_functions==[function for function,count in zip(roster,vector,strict=True) for _ in range(count)]
    normal[name]={"cases":count,"functions":len(roster),"case_vector":vector,"report":file_ref(path),"junit":pin}
for name in ("admission.lock","source.lock"):
    path=src/"workspace/control-plane/source-leases"/name
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW),"rb") as fd:
        fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
        fcntl.flock(fd,fcntl.LOCK_UN)
env={**os.environ,"GIT_OPTIONAL_LOCKS":"0","GIT_NO_LAZY_FETCH":"1"}
def git(*args):
    return subprocess.check_output(["git","-C",str(src),"-c","core.preloadIndex=false",*args],env=env,timeout=20)
assert git("rev-parse","HEAD").decode().strip()==commit
assert git("status","--porcelain=v1","--untracked-files=all")==b""
title10=w/"title10/actual-title10-complete-pending-three-stage-replay.json"
title_pin=file_ref(title10)
assert title_pin["sha256"]=="403de3e0afeae839d20f64270d04cacd6fd83a66d0f30c45ef9733b087489a37"
pilot=json.loads(title10.read_bytes())
assert pilot["candidate"]==commit and pilot["source_read_closed"]
assert pilot["historical_exact_request_records_preserved"] and pilot["independent_validation_equal"]
assert pilot["path_pins_checked_before_and_after"]==len(metadata["paths"])
assert pilot["answers_supplied"]==pilot["signatures_created"]==pilot["selected_signing_keys"]==0
for artifact in pilot["artifacts"].values():
    assert file_ref(Path(artifact["path"]))==artifact
counters=pilot["candidate_application_counts"]
assert counters["groups"]==counters["blocked_groups"]==4
assert counters["deferred_questions"]==28
assert all(counters[key]==0 for key in ("activated_candidate_answer_snapshots","activated_answer_slots",
           "authenticated_application_claims","source_decisions_applied","physical_governing_bindings_applied"))
record={"schema":"official-V2-source-application-normal-local-qualification/v1",
        "candidate":metadata["authored_candidate"],"owner_test_and_guide_seal":seal,
        "normal":{"fixture_scope":normal,"original_configs":metadata["normal_config"],"clean":True},
        "exact_source_files_before_and_after_each":len(metadata["paths"]),
        "all_three_Source_READs_closed_and_locks_exclusive_probe_acquired":True,
        "actual_retained_title10_pending_replay":title_pin,
        "SDK_managed":False,"published":False,"real_statutory_review":False,
        "isolated_checkout_role_map":file_ref(w/"real-checkout-pins.json")}
path=w/"actual-official-V2-application-pending-Title10-and-legacy-Source-closed.json"
with path.open("x") as f:
    json.dump(record,f,indent=2,sort_keys=True);f.write("\n")
path.chmod(0o400)
print(json.dumps(file_ref(path)))
