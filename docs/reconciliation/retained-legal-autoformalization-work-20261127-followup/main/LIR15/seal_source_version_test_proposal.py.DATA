    'Source_canonical_Git_mutations': False,
    'Source_or_SQL_or_Native_or_model_or_real_RPC_or_SDK_execution': False,
    'current_Source_epoch_clock_resource_authority_bindings': None,
    'actual_collect_RUN_JUnit_subreports_results': None,
    'real_legal_review_training_gold_or_corpus_admission': False,
    'full_eight_phase_goal_complete': False,
    'Root_qualification_next': 'Existing owner selects and source-binds this exact appended test before any execution. Static review is not a runtime PASS; no Native or parent-profile transfer.',
    'private_read_accounting': {
        'older_record_lookup_bytes_retained': older_record_lookup_bytes_retained,
        'new_assignment_prior_explicit_input_and_readback_bytes': prior_new_assignment_explicit_bytes,
        'assembler_reads_and_output_readbacks_before_packet': sum(r['bytes'] for r in reads),
        'new_assignment_total_before_packet_readback': prior_new_assignment_explicit_bytes + sum(r['bytes'] for r in reads),
        'private_unit_planning_bound_bytes': 8 * 1024 * 1024,
        'all_prior_costs_failures_and_partial_searches_retained': True,
