"""Scan new Git blob payloads for credential markers without printing values."""
from collections import Counter
import json
from pathlib import Path
import re
import subprocess

HERE = Path(__file__).resolve().parent
REPO = '/home/barberb/portland-laws.github.io/ipfs_datasets_py/.git'
BASE = 'a8191d2510658f330db78b43bc4fad3712973bf0'
PATTERNS = {
    'private_key': rb'-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----',
    'github_token': rb'(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{45,})',
    'aws_access_key': rb'\b(?:AKIA|ASIA)[A-Z0-9]{16}\b',
    'provider_token': rb'\bsk-(?:proj-)?[A-Za-z0-9_-]{35,}',
    'credential_url': rb'https?://[^\s/]+:[^\s/@]+@',
}

def main():
    listing = subprocess.check_output(['git','--git-dir='+REPO,'rev-list','--objects','--branches','^'+BASE])
    objects = {}
    for line in listing.splitlines():
        oid,_,name = line.partition(b' ')
        objects[oid.decode()] = name.decode(errors='replace')
    proc = subprocess.Popen(['git','--git-dir='+REPO,'cat-file','--batch'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    counts = Counter()
    hits = []
    total = 0
    largest = []
    for oid,name in objects.items():
        proc.stdin.write(oid.encode()+b'\n');proc.stdin.flush()
        header = proc.stdout.readline().split()
        if len(header)!=3:
            raise RuntimeError('Unexpected Git object header')
        kind = header[1].decode(); size = int(header[2])
        data = proc.stdout.read(size)
        if len(data)!=size or proc.stdout.read(1)!=b'\n':
            raise RuntimeError('Truncated Git object')
        counts[kind]+=1
        total+=size
        if total > 1024**3:
            raise RuntimeError('Declared one GiB scan bound exceeded')
        if kind=='blob':
            if size>5*1024**2:
                largest.append({'oid':oid,'path':name,'bytes':size})
            matched = [key for key,pat in PATTERNS.items() if re.search(pat,data)]
            if matched:
                hits.append({'oid':oid,'path':name,'bytes':size,'marker_families':matched})
    proc.stdin.close()
    rc=proc.wait(timeout=30)
    error=proc.stderr.read().decode(errors='replace')
    assert rc==0,(rc,error)
    report={'schema':'git-recovery-payload-marker-scan/v1','source_git_dir':REPO,'excluded_published_ancestor':BASE,'object_counts':dict(counts),'uncompressed_bytes':total,'large_blobs':largest,'marker_hits':hits,'git_child_returncode':rc,'secret_values_printed':False}
    (HERE/'portland-history-marker-scan.json').write_text(json.dumps(report,indent=2)+'\n')
    print(json.dumps(report,indent=2))

if __name__ == '__main__':
    main()
