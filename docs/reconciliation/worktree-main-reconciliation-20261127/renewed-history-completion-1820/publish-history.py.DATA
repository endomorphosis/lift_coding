"""Reuse the existing archive publisher and update the verified child pin."""
from pathlib import Path
import argparse
import datetime
import hashlib
import importlib.util
import json
import subprocess

HERE = Path(__file__).resolve().parent
REPO = Path('/tmp/lift-origin-main-reconcile-private-A8hmZDEd/root')
CHILD = '10a3dac4d863b44eb848dfc9f6f91a925e4e1c13'
HALLUCINATE = 'f41eef8e6978807553ec7c000688be61fed1863e'
GUIDE_ROOT = '9577abf26d4e236709d11a0f39402cdd986da267'
SPEC = importlib.util.spec_from_file_location('existing_archive_publisher',
    '/tmp/lift-origin-main-reconcile-private-A8hmZDEd/publish_archive.py')
P = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(P)
P.ROOT, P.REPO, P.PAYLOAD = HERE, REPO, HERE / 'history-publication'
PREFIX = 'docs/reconciliation/worktree-main-reconciliation-20261127/renewed-history-completion-1820/'


def tree(rows):
    raw = b''.join(f'{mode} {kind} {oid}\t{name}'.encode() + b'\0'
                   for name, (mode, kind, oid) in sorted(rows.items()))
    return P.git('mktree', '--missing', '-z', data=raw).decode().strip()


def main():
    release = HERE / 'PUBLICATION-CUSTODY-RELEASE-TO-GUIDE586.json'
    assert release.is_file(), 'retained Guide586 custody release is required'
    if release.exists():
        binding = json.loads((HERE / 'Guide586-actual-closed-rebind.json').read_bytes())
        assert binding['actual_closed_rc'] == 0
        assert binding['fresh_remote_tips_verified'] == {
            'datasets': CHILD, 'hallucinate': HALLUCINATE, 'root': GUIDE_ROOT,
            'accelerate': 'fae7981fa576817536a3c7aa62c5d28dc417f214'}
        receipt = Path(binding['receipt']).read_bytes()
        assert len(receipt) == 9730
        assert hashlib.sha256(receipt).hexdigest() == \
            '2c1a7897a36f287b53301b57991f7b39fdf2f564aedf9f72045eef4bd32784a5'
        closed = json.loads(receipt)
        assert closed['terminal_returncode'] == 0 and closed['all_owned_publication_commands_closed']
    parser = argparse.ArgumentParser()
    parser.add_argument('--reviewed-roster-sha256', required=True)
    args = parser.parse_args()
    roster_raw = (HERE / 'reviewed-history-payload-roster.json').read_bytes()
    assert hashlib.sha256(roster_raw).hexdigest() == args.reviewed_roster_sha256
    reviewed = json.loads(roster_raw)
    expected_files = {row['path']: row for row in reviewed['files']}
    remote = subprocess.check_output(['git', 'ls-remote',
        'https://github.com/endomorphosis/ipfs_datasets_py.git',
        'refs/heads/main'], text=True).split()[0]
    assert remote == CHILD, 'child remote changed: review required'
    P.git('fetch', '--no-tags', '--no-recurse-submodules', 'origin', 'main')
    base = P.git('rev-parse', 'origin/main').decode().strip()
    P.git('merge-base', '--is-ancestor', GUIDE_ROOT, base)
    assert not P.git('ls-tree', '-r', '--name-only', base, '--', PREFIX.rstrip('/')).strip(), \
        'recovery namespace already exists on fetched main: review required'
    changes, files = {}, []
    for path in sorted(P.PAYLOAD.rglob('*')):
        if path.is_dir():
            continue
        assert path.is_file() and not path.is_symlink()
        rel = path.relative_to(P.PAYLOAD).as_posix()
        assert rel.startswith(PREFIX)
        raw = path.read_bytes()
        assert len(raw) < 95 * 1024 ** 2
        assert rel in expected_files
        assert len(raw) == expected_files[rel]['bytes']
        assert hashlib.sha256(raw).hexdigest() == expected_files[rel]['sha256']
        oid = P.git('hash-object', '-w', '--stdin', data=raw).decode().strip()
        assert oid == hashlib.sha1(f'blob {len(raw)}\0'.encode() + raw).hexdigest()
        cursor = changes
        parts = rel.split('/')
        for part in parts[:-1]:
            cursor = cursor.setdefault(part, {})
        cursor[parts[-1]] = oid
        files.append({'path': rel, 'bytes': len(raw),
                      'sha256': hashlib.sha256(raw).hexdigest(), 'blob': oid})
    assert {row['path'] for row in files} == set(expected_files)
    root_rows = P.listing(P.merge_tree(base + '^{tree}', changes))
    external = P.listing(root_rows['external'][2])
    previous = external['ipfs_datasets']
    assert previous == ('160000', 'commit', CHILD), \
        'parent pin changed: review required'
    assert root_rows['hallucinate_app'] == ('160000', 'commit', HALLUCINATE)
    assert external['ipfs_accelerate'] == ('160000', 'commit',
                                         'fae7981fa576817536a3c7aa62c5d28dc417f214')
    final_tree = tree(root_rows)
    commit = P.git('commit-tree', final_tree, '-p', base, '-m',
        'Preserve seven remaining historical commit tips [skip ci]').decode().strip()
    actual = set(P.git('diff-tree', '--no-commit-id', '--name-only',
                       '-r', base, commit).decode().splitlines())
    assert actual == {row['path'] for row in files}
    for row in files:
        raw = P.git('show', commit + ':' + row['path'])
        assert len(raw) == row['bytes'] and hashlib.sha256(raw).hexdigest() == row['sha256']
    record = {'schema': 'renewed-request-normal-main-publication/v1',
        'base': base, 'commit': commit, 'tree': final_tree, 'files': files,
        'child_pin_before': previous[2], 'child_pin_after': CHILD,
        'guide586_root_preserved': GUIDE_ROOT, 'gitlink_changes': 0,
        'normal_fast_forward': True, 'force': False,
        'reviewed_roster_sha256': args.reviewed_roster_sha256,
        'hosted_ci_dispatched': False, 'original_working_files_untouched': True}
    (HERE / 'prepared-history-publication.json').write_text(json.dumps(record, indent=2) + '\n')
    push = subprocess.run(['git', '-c', 'core.hooksPath=/dev/null', '-c',
        'http.version=HTTP/1.1', '-C', str(REPO), 'push', 'origin',
        commit + ':refs/heads/main'], capture_output=True, text=True)
    (HERE / 'history-push.stdout').write_text(push.stdout)
    (HERE / 'history-push.stderr').write_text(push.stderr)
    record.update(push_returncode=push.returncode,
        remote_main=P.git('ls-remote', 'origin', 'refs/heads/main').decode().split()[0],
        closed_utc=datetime.datetime.now(datetime.timezone.utc).isoformat())
    (HERE / 'actual-history-publication.json').write_text(json.dumps(record, indent=2) + '\n')
    print(json.dumps({key: value for key, value in record.items() if key != 'files'}))
    assert push.returncode == 0 and record['remote_main'] == commit


if __name__ == '__main__':
    main()
