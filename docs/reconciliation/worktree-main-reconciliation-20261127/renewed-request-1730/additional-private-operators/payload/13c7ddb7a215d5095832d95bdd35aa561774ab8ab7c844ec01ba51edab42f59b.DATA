import ast, base64, hashlib, json, os, re, stat, subprocess, sys, time, zlib
from pathlib import Path
work=Path(__file__).resolve().parent
base=Path(sys.argv[4])
assert base.parent==work and not base.exists()
base.mkdir(mode=0o700)
helper=ast.parse((work/'run-read3.py').read_bytes())
defs=[s for s in helper.body if isinstance(s,ast.FunctionDef) or (isinstance(s,ast.Assign) and getattr(s.targets[0],'id',None)=='policy')]
exec(compile(ast.Module(body=defs,type_ignores=[]),'guarded FD and retention helpers','exec'))
def raw(pin):return read(pin['path'],pin['bytes'],pin['sha256'])[1]
def top(code):
    out={}
    for s in ast.parse(code).body:
        if isinstance(s,ast.Assign) and len(s.targets)==1 and isinstance(s.targets[0],ast.Name):
            try:out[s.targets[0].id]=ast.literal_eval(s.value)
            except (ValueError,TypeError):pass
    return out
def bind(code,values):
    for k,v in values.items():
        code,n=re.subn(r'^'+k+r' = .+$',lambda _:k+' = '+repr(v),code,flags=re.M)
        assert n==1,k
    assert all(top(code)[k]==v for k,v in values.items())
    compile(code,'existing bound ordinary62 control','exec',dont_inherit=True)
    return code
def save(name,s):
    path=base/name
    data=s.encode()
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400)
    with os.fdopen(fd,'wb') as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    return read(path,len(data),hashlib.sha256(data).hexdigest())[0]

href={'path':sys.argv[1],'bytes':int(sys.argv[2]),'sha256':sys.argv[3]}
h=val(href)
src_ref,b=read(work/'P2-READ3-existing-Source-terminal.json',3142,'0474185aa79ed412c809f50afeb3badde97e89d39df6aef1390f5c6d937dcd76')
src=json.loads(b)
assert src['returncode']==0 and src['Source_closed'] and src['owned_module_closed'] and src['exact_3_snapshot_and_Git_joins_verified']
read_abi=h['read']
abi=val(read_abi)
fr=val(src['execution_freeze'])
d,a=h['D_prov'],h['A_prov']
projects=[{'root':r['root'],'Git_HEAD':r['HEAD'],'Git_tree':r['tree']} for r in (d,a)]
assert projects==fr['frozen_roots']
assert abi['outer_epoch_reference']==fr['epochs']['outer'] and abi['python_epoch_reference']==fr['epochs']['python']
outer={r['path']:r for r in val(abi['outer_epoch_reference'])}
assert len(outer)==1611 and abi['protected_index_reference']==fr['index']
prior=top(read('/tmp/Root-P8-V4-reviewed-graph-existing-ordinary9-v331-l4ls_bm7/Root-selected-existing-ordinary9-operator.py',70696,'c6bdf4bf57302218039fa9b09d16ff8ba47f3f66f17873ce1ab84c2f524de453')[1])
fields=('FINAL_SDK_BINDINGS','FINAL_RESOURCE_STATE_PATH','FINAL_EXPECTED_RESOURCE_CONFIG','FINAL_EXPECTED_CAPACITY','FINAL_ADDITIONAL_IMPORT_ROOTS','source42')
inherited={k:prior[k] for k in fields}
state_ref,b=read(inherited['FINAL_RESOURCE_STATE_PATH'])
state=json.loads(b)
assert state['config']==inherited['FINAL_EXPECTED_RESOURCE_CONFIG'] and state['child_process_capacity']==inherited['FINAL_EXPECTED_CAPACITY']
for rel,digest in inherited['FINAL_SDK_BINDINGS'].values():
    assert outer[str(Path(d['root'])/rel)]['sha256']==digest
owner=val(src['operator_controls']['request'])['approved_current_Source42_owner_binding']
assert zlib.decompress(base64.b64decode(inherited['source42']['raw_zlib_base64']))==raw(val(owner)['code_reference'])
fx=val(h['fixture'])
assert len(fx['required_fixture_closure'])==8 and len(h['modules'])==3
assert h['script_sha256']==fx['script_required_fixture']['sha256']
assert all(row==outer[row['path']] for row in fx['required_fixture_closure'])
op,boot=(raw(h['controls'][k]).decode() for k in ('operator','bootstrap'))
op_old=top(op)
assert op_old['D_READ_BINDING_ABI']==prior['D_READ_BINDING_ABI']
assert op_old['FACTORY_REFERENCE']==h['controls']['factory'] and raw(h['controls']['factory'])
assert all(not os.path.lexists(p) for p in fx['required_absent_paths'])
assert all(not os.path.lexists(p) and Path(p).is_relative_to(d['root']) for p in op_old['ABSENT_PATHS'])
assert all(op_old[k] is None for k in inherited)
n=128*1024**2
previous=src['fully_retained_ledger'] if len(sys.argv)==5 else val({'path':sys.argv[5],'bytes':int(sys.argv[6]),'sha256':sys.argv[7]})['fully_retained_ledger']
ledger={**previous,'global_cap':previous['global_cap']+n,'internal_cap':previous['internal_cap']+n}
paid={**ledger,'used':ledger['used']+n,'internal_used':ledger['internal_used']+n,'captures':ledger['captures']+1}
assert paid['global_cap']-paid['used']==previous['global_cap']-previous['used']==6356992
cap=keep('ordinary62-Source-full-precharge.json',{'prior':previous,'selected':ledger,'after_full_retained_precharge':paid,
 'added_Source_only_envelope':n,'previous_closed_READ3':src_ref,'authority':val(src['cap'])['standing_authority'],
 'all_prior_failed_attempts_and_Source_costs_retained':True,'SDK_profile_capacity_unchanged':True})
effect=keep('Root-selected-effect.json',{'Root_selected':True,'ordinary_SDK_execution_selected':True,'temporary_workspace_only':True,
 'scope':'Current frozen-local Phase2 whole-project ordinary62; retained53 plus new9','no_actual_DuckDB_SQL_or_Native_Lean_selected':True,
 'no_model_training_or_prover_selected':True,'no_legal_or_training_admission':True,
 'no_live_managed_ledger_reconciliation_or_cap_change_selected':True})
io=keep('Root-selected-IO.json',{'Root_selected':True,'Source_envelope_bytes':n,'admitted':True,
 'all_prior_failed_attempts_and_Source_costs_retained':True,'ledger_before':ledger,'original_limits_and_guards_unchanged':True,
 'physical_IO_accounting_complete':False,'cap_reference':cap})
manifest={'Root_selected':True,'frozen_Git_candidates':True,'Source_WRITE_claimed':False,'ordinary_execution_or_qualification':None,
 'projects':projects,'D_provenance':d,'A_provenance':a,'modules':h['modules'],'source_read_binding_reference':read_abi,
 'fixture_closure_reference':h['fixture'],'effect_decision_reference':effect,'admitted_io_plan_reference':io}
mref=keep('Root-selected-ordinary62-binding-manifest.json',manifest)
out=base/'actual-output'
now=time.time_ns()
end=now+840*10**9
selection=keep('Root-selected-existing-ordinary62.json',{'schema':'Root-selected-existing-Phase2-whole-project-ordinary62/v1','Root_selected':True,
 'Source_READ_binding':read_abi,'IO_reference':io,'effect_reference':effect,'Source_envelope_bytes':n,'case_hint':62,
 'actual_COLLECT_supplies_order':True,'frozen_D_HEAD':d['HEAD'],'frozen_D_tree':d['tree'],'launch_not_before_utc_ns':now,
 'launch_deadline_utc_ns':end,'ledger_before':ledger,'output_namespace':str(out),'actual_nonclock_handoff':href,
 'resource_preadmission_readback':state_ref})
runtime={'schema':'Root-selected-normal-HOME-rescue-launch-authority/v1','root_selection':selection,
 'launch_not_before_utc_ns':now,'launch_deadline_utc_ns':end}
boot=bind(boot,{'ROOT':d['root'],'ADDITIONAL_A_ROOT':a['root'],
 'EXPECTED_MODULES':{k:dict(v,scope='frozen_local_git_D_source') for k,v in h['modules'].items()},
 'REQUIRED_CANONICAL_CONFTESTS':fx['required_normal_conftests'],'PYTEST_INIFILE':fx['pytest_inifile'],
 'ROOT_RUNTIME_SELECTION':runtime,'GIT_CANDIDATE_PROVENANCE':d,'ADDITIONAL_A_PROVENANCE':a,'BINDING_MANIFEST_REFERENCE':mref,
 'SOURCE_READ_BINDING_REFERENCE':read_abi,'ADMITTED_IO_PLAN_REFERENCE':io,'EFFECT_DECISION_REFERENCE':effect,
 'SOURCE_EPOCH_SHA256':abi['outer_epoch_reference']['sha256'],'SOURCE_EPOCH_RECORD_COUNT':len(outer)})
bref=save('Root-selected-bootstrap.py',boot)
op=bind(op,{**inherited,'EXPECTED_CLI_SCRIPT_SHA256':h['script_sha256'],'PREP':str(Path(h['controls']['operator']['path']).parent),
 'ROOT_SELECTION':selection,'ROOT_RUNTIME_SELECTION':runtime,'FINAL_OUTPUT_PATH':str(out),
 'FINAL_D_ROOT':d['root'],'FINAL_D_HEAD':d['HEAD'],'FINAL_D_TREE':d['tree'],
 'FINAL_A_ROOT':a['root'],'FINAL_A_HEAD':a['HEAD'],'FINAL_A_TREE':a['tree'],
 'D_READ_BINDING_REFERENCE':read_abi,'FINAL_BINDING_MANIFEST_REFERENCE':mref,'FINAL_BINDING_MANIFEST':manifest,
 'FINAL_MODULE_BINDINGS':h['modules'],'FINAL_D_PROVENANCE':d,'FINAL_A_PROVENANCE':a,'FINAL_SOURCE_PROJECTS':projects,
 'FINAL_FIXTURE_CLOSURE_REFERENCE':h['fixture'],'FINAL_EFFECT_DECISION_REFERENCE':effect,'FINAL_EFFECT_DECISION':val(effect),
 'FINAL_ADMITTED_IO_PLAN_REFERENCE':io,'BOOTSTRAP_REFERENCE':bref})
operator=save('Root-selected-existing-ordinary62-operator.py',op)
with (base/'operator.stdout').open('xb') as so,(base/'operator.stderr').open('xb') as se:
    child=subprocess.Popen(['/usr/bin/python3','-I','-B',operator['path'],read_abi['path'],str(read_abi['bytes']),read_abi['sha256']],stdout=so,stderr=se)
    running=keep('ordinary62-managed-dispatched.json',{'owner':'Root','pid':child.pid,'selection':selection,
                   'operator':operator,'bootstrap':bref,'actual_Source3':src_ref,'precharge':cap,'output_namespace':str(out)})
    print(json.dumps(running),flush=True)
    rc=child.wait()
full=next(iter(out.glob('complete-frozen-local-D-*-ordinary62-existing-owner-report.json')),None)
result={'owner':'Root','ordinary62_parent_terminal_returncode':rc,'actual_handle':None,'selected_dispatch':running,'cap':cap,
 'fully_retained_ledger':paid,'Source3':src_ref,'freeze':src['execution_freeze'],'ordinary_report':None,
 'stderr':read(base/'operator.stderr')[0],'stdout':read(base/'operator.stdout')[0]}
if full:
    r,b=read(full)
    report=json.loads(b)
    result.update(ordinary_report=r,parent_home_absent=not (out/'parent-home').exists())
    result.update({k:report[k] for k in ('qualification_complete','Source_closed','resource_cleanup_confirmed','errors')})
else:
    result['qualification_complete']=False
result_ref=keep('ordinary62-managed-terminal.json',result)
print(json.dumps(result_ref),flush=True)
raise SystemExit(rc)
