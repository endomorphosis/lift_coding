                if 'observed_git_blob_oid' in t:
                    actual_oid = hashlib.sha1(b'blob ' + str(len(back)).encode() + b'\x00' + back).hexdigest()
                    assert actual_oid == t['observed_git_blob_oid']
                    record['Git_blob_verified'] = True
                row = {'path': t['path'], 'bytes': t['bytes'], 'sha256': H(back), 'full9': actual9, 'kind': t['kind'], 'root': root, 'raw_reference': rr}
