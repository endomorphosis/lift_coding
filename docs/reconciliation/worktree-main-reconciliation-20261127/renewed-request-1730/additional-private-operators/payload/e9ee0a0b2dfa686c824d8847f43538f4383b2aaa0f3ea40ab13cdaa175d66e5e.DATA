    else:
        report['module_closed'] = False
    report['actual_operation_IO'] = dict(spent)
    if ledger is not None:
        ledger['captures'] += spent['captures']
        ledger['used'] += spent['bytes']
        ledger['internal_used'] += spent['bytes']
        assert ledger['used'] <= ledger['global_cap'] and ledger['internal_used'] <= ledger['internal_cap']
        report['ledger_after'] = {k: ledger[k] for k in before}
    ref = js(OUT / 'actual-D27-observed-D-root-initializer-Source-READ-v01-closed-report.json', report)
    compact = js(OUT / 'actual-D27-observed-D-root-initializer-Source-READ-v01-small-closeout.json', {'schema': 'actual-D27-observed-D-root-initializer-READ-small-closeout/v1', 'status': 'PASS' if not report['errors'] and report.get('snapshot_complete') else 'FAILED', 'Source_closed': report['Source_closed'], 'owned_module_closed': report['module_closed'], 'errors': report['errors'], 'roots_before': report.get('before'), 'roots_after': report.get('after'), 'AGENTS_reuse': report.get('retained_AGENTS_reuse'), 'AGENTS_named_absences': len(report.get('AGENTS_after', {}).get('absent', [])), 'captures': report['captures'], 'A_index_shared_guard_before': report.get('A_index_shared_guard_before'), 'A_index_shared_guard_after': report.get('A_index_shared_guard_after'), 'previous_D_cooperative_freeze': report.get('previous_D_cooperative_freeze'), 'execution_freeze': report.get('execution_freeze'), 'previous_D_Source42_WRITE_claimed': False, 'actual_IO': spent, 'ledger_after': report.get('ledger_after'), 'full_report_reference': ref, 'SDK_Native_compiler_or_project_execution': False, 'cohort_process_free_or_positive_handle_qualified': False})
    print(json.dumps({'event': 'P2_COMPOSED234_CURRENT_D_FROZEN_READ3_CLOSED_COMPACT', 'compact': compact}, sort_keys=True), flush=True)
    print(json.dumps({'event': 'P2_COMPOSED234_CURRENT_D_FROZEN_READ3_READ_CLOSED', 'report': ref, 'completed': len(report['captures']), 'Source_closed': report['Source_closed'], 'module_closed': report['module_closed'], 'ledger_after': report.get('ledger_after'), 'errors': report['errors']}, sort_keys=True), flush=True)
