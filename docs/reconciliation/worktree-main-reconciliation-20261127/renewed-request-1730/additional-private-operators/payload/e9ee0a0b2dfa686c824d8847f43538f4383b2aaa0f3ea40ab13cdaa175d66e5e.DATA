REQ = {'path': '/tmp/Root-P2-existing-owner-Guide584-reconciliation-hxm7h07u/P2-current-composed234-READ3-existing-request.json', 'bytes': 76834, 'sha256': '17c22c611045ca79435fda221777160a3fae58ecac0a0b0c8e5f323ca8a2f898'}
