report = {'schema': 'actual-frozen-A-D-existing-READ-operation/v1', 'inputs': [], 'captures': [], 'Source_contexts': [], 'errors': [], 'Source_closed': False, 'module_closed': False, 'prelaunch_carried': dict(spent), 'selected_reference': SEL, 'request_reference': REQ}
