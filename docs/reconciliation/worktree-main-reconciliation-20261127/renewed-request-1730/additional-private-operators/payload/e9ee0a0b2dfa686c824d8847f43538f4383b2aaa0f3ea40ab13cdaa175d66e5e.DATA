def admit(n):
    if type(n) is not int or n < 0 or spent['bytes'] + n > 67108864:
        raise RuntimeError('selected READ envelope insufficient before read')
    if before['used'] + spent['bytes'] + n > before['global_cap'] or before['internal_used'] + spent['bytes'] + n > before['internal_cap']:
        raise RuntimeError('shared Source allowance insufficient before read')

def control_read(ref, kind='private_control'):
    p = Path(ref['path'])
    a = p.lstat()
    assert stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and (a.st_uid == os.getuid())
    assert a.st_size == ref['bytes']
    admit(ref['bytes'] + 1)
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    parts = []
    total = 0
    report['inputs'].append({'path': str(p), 'kind': kind, 'actual_bytes': 0})
    row = report['inputs'][-1]
    try:
        assert f9(os.fstat(fd)) == f9(a)
        spent['captures'] += 1
        while total <= ref['bytes']:
            part = os.read(fd, min(1048576, ref['bytes'] + 1 - total))
            total += len(part)
            spent['bytes'] += len(part)
            row['actual_bytes'] += len(part)
            if not part:
                break
            parts.append(part)
        assert f9(a) == f9(os.fstat(fd)) == f9(p.lstat())
    finally:
        os.close(fd)
    raw = b''.join(parts)
    assert len(raw) == ref['bytes']
    assert 'sha256' not in ref or H(raw) == ref['sha256']
    return raw

def seal(path, raw):
    assert type(raw) is bytes
    p = Path(path)
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 256)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    return {'path': str(p), 'bytes': len(raw), 'sha256': H(raw)}

def js(path, obj):
    return seal(path, (json.dumps(obj, sort_keys=True, indent=2) + '\n').encode())

def git(root, *args, allow_nonzero=False):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS='0', GIT_NO_LAZY_FETCH='1', GIT_TERMINAL_PROMPT='0')
    admit(262144)
    p = subprocess.run(['/usr/bin/git', '-C', root, *args], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
    spent['captures'] += 1
    spent['bytes'] += len(p.stdout) + len(p.stderr)
    assert len(p.stdout) + len(p.stderr) <= 262144
    report.setdefault('Git_calls', []).append({'root': root, 'args': args, 'returncode': p.returncode, 'stdout_bytes': len(p.stdout), 'stderr_bytes': len(p.stderr)})
    if not allow_nonzero and p.returncode:
        raise RuntimeError(('read-only Git failed', root, args, p.returncode, p.stderr.decode(errors='replace')))
    return p

def root_facts(root, expected):
    head = git(root, 'rev-parse', 'HEAD').stdout.decode().strip()
    tree = git(root, 'rev-parse', 'HEAD^{tree}').stdout.decode().strip()
    assert (head, tree) == (expected['Git_HEAD'], expected['Git_tree'])
    status = git(root, 'status', '--porcelain=v1', '-z', '--untracked-files=normal').stdout
    cached = git(root, 'diff', '--cached', '--quiet', 'HEAD', '--', allow_nonzero=True).returncode
    working = git(root, 'diff', '--quiet', '--', allow_nonzero=True).returncode
    assert status == b'' and cached == working == 0, ('frozen candidate no longer clean', root, status, cached, working)
    return {'HEAD': head, 'tree': tree, 'clean_worktree_and_index': True, 'status_sha256': H(status), 'cached_diff_returncode': cached, 'working_diff_returncode': working}

def parents(path):
    out = []
    for p in reversed(Path(path).parents):
        s = p.lstat()
        assert stat.S_ISDIR(s.st_mode) and (not stat.S_ISLNK(s.st_mode))
        fd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            assert f9(s) == f9(os.fstat(fd)) == f9(p.lstat())
        finally:
            os.close(fd)
        out.append({'path': str(p), 'full9': f9(s)})
    return out

def leaf(t):
    p = Path(t['path'])
    s = p.lstat()
    assert stat.S_ISREG(s.st_mode) and s.st_nlink == 1
    assert f9(s) == t['full9'] and s.st_size == t['bytes']

def check_shared_A_index(row):
    root, path = row['root'], row['path']
    ip = git(root, 'rev-parse', '--path-format=absolute', '--git-path', 'index').stdout.decode().strip()
    common = git(root, 'rev-parse', '--path-format=absolute', '--git-common-dir').stdout.decode().strip()
    assert Path(ip).is_absolute() and Path(ip).is_relative_to(Path(common))
    assert path == ip and path == str(Path(root) / '.git/index')
    parents(path)
    leaf(row)
    raw = control_read({k: row[k] for k in ('path','bytes','sha256')}, 'shared_A_index_hash_guard_without_raw_capture')
    leaf(row)
    assert H(raw) == row['sha256']
    return dict(row, exact_HASH_and_full9_reverified=True, stored_as_numbered_capture=False)

