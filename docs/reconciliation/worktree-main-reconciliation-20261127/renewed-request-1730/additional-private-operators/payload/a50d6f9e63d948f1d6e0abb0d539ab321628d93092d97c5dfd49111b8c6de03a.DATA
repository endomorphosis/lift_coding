import ast,hashlib,json,os,re,runpy,stat,subprocess,time
from pathlib import Path
base=Path(__file__).resolve().parent
def take(path,methods,names):
    tree=ast.parse(Path(path).read_bytes())
    out=[]
    for node in tree.body:
        if isinstance(node,ast.FunctionDef) and (methods is None or node.name in methods):
            out.append(node)
        if isinstance(node,ast.Assign) and getattr(node.targets[0],'id',None) in names:
            out.append(node)
    return compile(ast.Module(body=out,type_ignores=[]),str(path),'exec')
exec(take('/tmp/Root-P2-whole-component-managed-R5-n8Fkdm2q/run-read3.py',None,{'policy'}))
exec(take(base/'freeze-repin.py',{'git','head','data_row'},{'D','A','D_PARENT','A_HEAD','ROLE','POST_SHA','POST_BLOB','OWNER','FIXTURE','env'}))
exec(take(base/'run-source1.py',{'ack'},{'status'}))
first_keep=keep
def keep(name,obj):
    path=base/name
    if name.startswith('native-current-') and path.is_file():
        record,b=read(path)
        assert json.loads(b)==obj
        return record
    return first_keep(name,obj)

