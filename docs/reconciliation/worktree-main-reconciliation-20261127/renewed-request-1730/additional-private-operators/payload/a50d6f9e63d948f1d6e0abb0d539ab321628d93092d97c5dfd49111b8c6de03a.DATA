assert not git(D,'status','--porcelain=v1') and not git(A,'status','--porcelain=v1')

def gitrows(root,oid,names):
    out={}
    raw=git(root,'ls-tree','-lrz',oid,'--',*sorted(names))
    assert len(raw)<1024**2
    for line in raw.split(b'\0'):
        if line:
            hdr,p=line.split(b'\t',1);mode,kind,blob,size=hdr.decode().split()
            assert kind=='blob' and mode in ('100644','100755')
            out[p.decode()]=(mode,blob,int(size))
    assert set(out)==names
    return out
locations={}
for row in allrows:
    path=Path(row['path'])
    root,=(r for r in (D,A) if path.is_relative_to(r))
    locations[str(path)]=root,str(path.relative_to(root))
names={r:{rel for root,rel in locations.values() if root==r and not rel.startswith('.git/')} for r in (D,A)}
curr={r:gitrows(r,head(r),names[r]) for r in (D,A)}
q=val(pub['qualification'])
oldf=val(q['exact_local_freeze'])
historical=gitrows(D,oldf['frozen']['HEAD'],names[D])
aidx=doc['A_index']
didx=f['frozen']['stage0_index']
branch=f['frozen_branch_ref']
changed_doc=doc['committed_docs']
assert len(changed_doc)==4
rows=[]
for row in allrows:
    p=Path(row['path'])
    root,rel=locations[str(p)]
    meta={'path':str(p),'bytes':p.lstat().st_size,'full9':full9(p.lstat())}
    if str(p) in (aidx['path'],didx['path'],branch['path']):
        pointer=next(q for q in (aidx,didx,branch) if q['path']==str(p))
        assert meta=={k:pointer[k] for k in meta}
        rows.append(pointer);continue
    if rel.startswith('.git/'):
        assert all(row[k]==meta[k] for k in meta)
        rows.append({**meta,'sha256':None});continue
    assert curr[root][rel][2]==meta['bytes']
    assert bool(int(meta['full9']['st_mode'])&stat.S_IXUSR)==(curr[root][rel][0]=='100755')
    if root==D and rel==ROLE:
        actual=f['committed'][rel]
        assert all(actual[k]==meta[k] for k in meta) and curr[root][rel][1]==POST_BLOB
        digest=actual['sha256']
    elif root==D and rel in changed_doc:
        actual=changed_doc[rel]
        assert ('100644',actual['committed_blob'],actual['bytes'])==curr[root][rel]
        digest=actual['sha256']
    else:
        earlier=previous_rows[str((old if root==D else A)/rel)]
        assert earlier['bytes']==meta['bytes'] and (root==A or curr[root][rel]==historical[rel]),rel
        if root==A:assert earlier['full9']==meta['full9']
        digest=earlier['sha256']
    assert type(digest) is str and len(digest)==64
    rows.append({**meta,'sha256':digest})
by_path={r['path']:r for r in rows}
