for di in sorted(dirs):
    for basename in ('AGENTS.md','AGENTS.override.md'):
        p=di/basename
        here={'path':str(p),'exists':os.path.lexists(p)}
        if here['exists']:
            root=D if p.is_relative_to(D) else A
            rel=str(p.relative_to(root))
            previous_pin=old_agents.get(str((old if root==D else A)/rel))
            if previous_pin:
                assert previous_pin['exists']
                linked=previous_pin['reuse_captured_raw']
            else:
                assert root==D and rel=='ipfs_datasets_py/logic/autoformal/AGENTS.md'
                linked,_=read('/tmp/Root-result-cache-owned-existing-route-L4Wyme59/read4-retained-current-AGENTS.DATA',1686)
            r,data=read(linked['path'],linked['bytes'],linked['sha256'])
            blob=hashlib.sha1(f'blob {len(data)}\0'.encode()+data).hexdigest()
            assert head(root,'HEAD:'+rel)==blob and p.lstat().st_size==len(data)
            here.update(full9=full9(p.lstat()),reuse_captured_raw=linked)
        agents.append(here)
