clean(orig,D)
clean(a,A)
for field in ('index','branch_ref'):
    row=f[field]
    obs,_=capture(Path(row['path']),row['bytes'],row['sha256'])
    assert list(obs['full9'].values())==row['full9']
a_index=docs['A_index']
assert facts(a/'.git/index')=={key:a_index[key] for key in ('path','bytes','full9')}
historical={'D':pub/'repositories/datasets','A':Path('/tmp/A21d7-A4-existing-qualifier-sparse-companion-odzgyALT/accelerate')}
past=mapped(seed['rows'],{'D':prior/'datasets','A':a})
old_py=mapped(py,historical)
old_native=mapped(nat,historical)
assert len(old_py)==1597 and len(old_native)==1610 and set(old_py)<=set(old_native)
keys=list(dict.fromkeys((*old_native,*(('D',r) for r in local['compiled_at_terminal']),('D','ipfs_datasets_py/logic/autoformal/AGENTS.md'))))
roots={'D':d,'A':a}
tracked={side:{rel for owner,rel in keys if owner==side and not rel.startswith('.git/')} for side in roots}
current={'D':tree(orig,D,tracked['D']),'A':tree(a,A,tracked['A'])}
assert all(set(current[side])==tracked[side] for side in roots)
assert sum(row[2] for row in current['D'].values())<96*1024**2
cli=['scripts/__init__.py','scripts/ops/__init__.py','scripts/ops/legal_ir/__init__.py','scripts/ops/legal_ir/validate_uscode_corpus_release.py']
assert all(not (orig/rel).is_file() and rel in current['D'] for rel in cli)
assert not d.exists()
subprocess.run(['/usr/bin/git','init','--quiet',str(d)],check=True,env=env,timeout=20)
stores=[]
todo=[(orig/'.git/objects').resolve()]
while todo:
    path=todo.pop(0)
    if path in stores:
        continue
    assert path.is_dir()
    stores.append(path)
    alts=path/'info/alternates'
    if alts.is_file():
        todo.extend((path/r).resolve() for r in alts.read_text().splitlines() if r)
(d/'.git/objects/info/alternates').write_text(''.join(str(p)+'\n' for p in reversed(stores)))
git(d,'config','--local','core.sparseCheckout','true')
git(d,'config','--local','core.sparseCheckoutCone','false')
(d/'.git/info/sparse-checkout').write_text(''.join('/'+r+'\n' for r in sorted(current['D'])))
