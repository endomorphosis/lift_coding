doc=guide['guide582_Source_closed']
_,docs=obj(Path(doc['path']),doc['bytes'],doc['sha256'])
run=f['run']
_,local=obj(Path(run['path']),run['bytes'],run['sha256'])
assert q['normal_local_software_nine']==fref and f['candidate']['oid']==D and f['candidate']['parent']==base
