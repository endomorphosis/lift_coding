from hashlib import sha1, sha256
import json, os, stat, subprocess
from pathlib import Path

w=Path(__file__).resolve().parent
pub=Path('/tmp/codex-all-work-github-main-reconciliation-20261123-etm066qn')
c=pub/'Phase8-existing-native-CI-trigger-repair-private-v01/coordination-full-goal-v02/P2-V4-checked-whole-project-private-yI1zwigi'
orig=c/'normal-current/checkout'
prior=Path('/tmp/Root-result-cache-owned-existing-route-L4Wyme59')
d,a=w/'datasets',prior/'accelerate'
D='d2ddb5fc873c38370268975f4e76a80ff427c87c'
A='fae7981fa576817536a3c7aa62c5d28dc417f214'
base='937ad474d2d8650e3ccee16c10319a9c72d4429a'
fields=('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
io={'direct_bytes':0,'git_stdout_bytes':0,'current_uncached_git_body_bytes':0}
env=os.environ|{'GIT_CONFIG_NOSYSTEM':'1','GIT_CONFIG_GLOBAL':'/dev/null','GIT_LFS_SKIP_SMUDGE':'1','GIT_NO_LAZY_FETCH':'1','GIT_TERMINAL_PROMPT':'0','GIT_OPTIONAL_LOCKS':'0'}

def f9(st):return {key:str(getattr(st,key)) for key in fields}

def facts(path):
    st=path.lstat()
    assert stat.S_ISREG(st.st_mode) and st.st_nlink==1 and st.st_uid==os.getuid(),path
    return {'path':str(path),'bytes':st.st_size,'full9':f9(st)}

def ref(row):return {k:row[k] for k in ('path','bytes','sha256')}

def capture(path,size=None,hash=None):
    row=facts(path)
    assert row['bytes']<=8*1024**2 and (size is None or row['bytes']==size),path
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW),'rb') as stream:
        assert f9(os.fstat(stream.fileno()))==row['full9']
        raw=stream.read(row['bytes']+1)
        assert f9(os.fstat(stream.fileno()))==row['full9']==facts(path)['full9']
    io['direct_bytes']+=len(raw)
    row['sha256']=sha256(raw).hexdigest()
    assert len(raw)==row['bytes'] and (hash is None or row['sha256']==hash),path
    return row,raw

def obj(path,size,hash):
    row,raw=capture(path,size,hash)
    return ref(row),json.loads(raw)

def put(name,obj):
    path=w/name
    raw=obj if type(obj) is bytes else (json.dumps(obj,indent=2,sort_keys=True)+'\n').encode()
    with os.fdopen(os.open(path,os.O_WRONLY|os.O_CREAT|os.O_NOFOLLOW|os.O_EXCL,0o400),'wb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    return {'path':str(path),'bytes':len(raw),'sha256':sha256(raw).hexdigest()}

def git(repo,*args,bound=1024**2):
    cmd=['/usr/bin/git','--no-optional-locks','-C',str(repo),'-c','index.threads=1','-c','pack.threads=1','-c','core.preloadIndex=false','-c','core.hooksPath=/dev/null',*args]
    raw=subprocess.run(cmd,capture_output=True,check=True,env=env,timeout=75).stdout
    assert len(raw)<=bound,(args[0],len(raw))
    io['git_stdout_bytes']+=len(raw)
    return raw

def tree(repo,oid,names):
    out={}
    for row in git(repo,'ls-tree','-lrz',oid,'--',*sorted(names)).split(b'\0'):
        if row:
            hdr,rel=row.split(b'\t',1)
            mode,kind,blob,size=hdr.decode().split()
            assert kind=='blob' and mode in ('100644','100755')
            out[rel.decode()]=(mode,blob,int(size))
    return out

def clean(root,oid):
    assert git(root,'rev-parse','HEAD').decode().strip()==oid
    assert not git(root,'status','--porcelain=v1','--untracked-files=all'),root

def mapped(rows,roots):
    out={}
    for row in rows:
        path=Path(row['path'])
        side,=(side for side,root in roots.items() if path.is_relative_to(root))
        key=side,str(path.relative_to(roots[side]))
        assert key not in out
        out[key]=row
    return out

fref,f=obj(c/'normal-current/actual-current-local-Source-whole-component-nine-qualified-frozen.json',3978,'e35ef752ba725f8457b8d44e229838f3b33f477e41402c9743d3704d1c3aed3b')
qref,q=obj(c/'READY-existing-R5-whole-project-v03-current-local-frozen-nonclock-INERT-v02.json',7130,'aad130667f20516920b508346e1ba7d27cf62f51515125f6aa7a79d05b3eca5b')
gref,guide=obj(prior/'actual-Phase8-result-cache-Source2-READ4-ordinary11-Guide582-publication.json',5773,'a1283734a9520e9e32a5f8ec4d8bf2b766586e162e81621de91a37caeeb83a62')
sref,seed=obj(prior/'current-frozen-full9-hash-epoch.json',922486,'d5bebc252d1bf5cca22f4a9d3730c3fae14a5cb8f36d765509987c2b6c1508c8')
