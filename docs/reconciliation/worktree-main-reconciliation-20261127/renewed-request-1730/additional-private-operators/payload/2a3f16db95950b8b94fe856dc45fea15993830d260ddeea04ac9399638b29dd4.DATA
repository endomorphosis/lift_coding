exclude.write_text(exclude.read_text()+'\n/workspace/control-plane/source-leases/admission.lock\n/workspace/control-plane/source-leases/source.lock\n')
git(d,'-c','advice.detachedHead=false','checkout','--detach','--quiet',D)
clean(d,D)
assert git(d,'rev-parse','HEAD^{tree}','HEAD^').decode().split()==[f['candidate']['tree'],base]
assert set(git(d,'diff-tree','--no-commit-id','--name-only','-r','HEAD').decode().splitlines())==set(q['exact_roles'])
d_index,_=capture(d/'.git/index')
prior_tree=tree(prior/'datasets','72e5160bf588f8c689ecbb11c658acc2bc3c9a97',tracked['D'])
rows={}
unreused={}
for side,rel in keys:
    path=roots[side]/rel
    item=facts(path)
    previous=past.get((side,rel))
    if rel=='.git/index':
        item=d_index if side=='D' else a_index
    elif rel.startswith('.git/'):
        if side=='D':
            item,_=capture(path)
        else:
            assert previous['full9']==item['full9']
            item['sha256']=previous.get('sha256')
    else:
        mode,blob,size=current[side][rel]
        assert (item['bytes'],bool(int(item['full9']['st_mode']) & stat.S_IXUSR))==(size,mode=='100755'),path
        if previous and previous['bytes']==size and (side=='A' or current[side][rel]==prior_tree.get(rel)):
            if side=='A':
                assert previous['full9']==item['full9']
            item['sha256']=previous['sha256']
        elif side=='D' and rel in q['exact_roles']:
            post=q['exact_roles'][rel]['after']
            assert (post['git_blob'],post['bytes'])==(blob,size)
            item['sha256']=post['sha256']
        else:
            unreused[side,rel]=(blob,size)
    rows[side,rel]=item
assert sum(size for _,size in unreused.values())<=8*1024**2
for key,(blob,size) in unreused.items():
    raw=git(roots[key[0]],'cat-file','blob',blob,bound=size)
    assert len(raw)==size and sha1(f'blob {size}\0'.encode()+raw).hexdigest()==blob
    rows[key]['sha256']=sha256(raw).hexdigest()
    io['current_uncached_git_body_bytes']+=size
posts={}
for rel,role in q['exact_roles'].items():
    row=rows['D',rel]
    post=role['after']
    assert (row['bytes'],row['sha256'],current['D'][rel][1])==(post['bytes'],post['sha256'],post['git_blob'])
    assert git(d,'ls-files','--stage','-z','--',rel)==f"100644 {post['git_blob']} 0\t{rel}\0".encode()
    posts[rel]=row|{'git_blob':post['git_blob'],'mode':role['mode']}

absent=tuple('ipfs_datasets_py/'+part for part in (
