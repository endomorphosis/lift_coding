agents=[]
dirs={p for row in rows.values() for p in Path(row['path']).parents if any(p.is_relative_to(root) for root in roots.values())}
for folder in sorted(dirs):
    for name in ('AGENTS.md','AGENTS.override.md'):
        path=folder/name
        if not os.path.lexists(path):
            agents.append({'path':str(path),'exists':False})
            continue
        side,=(side for side,root in roots.items() if path.is_relative_to(root))
        rel=str(path.relative_to(roots[side]))
        mode,blob,size=tree(roots[side],D if side=='D' else A,{rel})[rel]
        raw=git(roots[side],'cat-file','blob',blob,bound=65536)
        assert len(raw)==size and sha1(f'blob {size}\0'.encode()+raw).hexdigest()==blob
        proof=put('retained-AGENTS-'+side+'-'+sha256(str(path).encode()).hexdigest()[:12]+'.DATA',raw)
        assert facts(path)['bytes']==size
        agents.append({'path':str(path),'exists':True,'full9':facts(path)['full9'],'reuse_captured_raw':proof})
rootfacts=[{'root':str(root),'Git_HEAD':oid,'Git_tree':git(root,'rev-parse','HEAD^{tree}').decode().strip()} for root,oid in ((d,D),(a,A))]
