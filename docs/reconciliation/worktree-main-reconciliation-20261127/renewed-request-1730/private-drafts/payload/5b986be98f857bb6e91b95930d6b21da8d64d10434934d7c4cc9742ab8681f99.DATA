fields = ('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
def f9(info):
    return {k:str(getattr(info,k)) for k in fields}

def ref(path, size=None, digest=None, *, limit=16*1024**2):
    p=Path(path)
    a=p.lstat()
    assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size<=limit,p
    with os.fdopen(os.open(p,os.O_RDONLY|os.O_NOFOLLOW),'rb') as source:
        assert f9(os.fstat(source.fileno()))==f9(a)
        raw=source.read(a.st_size+1)
        assert f9(os.fstat(source.fileno()))==f9(a)
    assert f9(p.lstat())==f9(a) and len(raw)==a.st_size
    observed=dict(path=str(p),bytes=len(raw),sha256=sha256(raw).hexdigest())
    assert size is None or size==observed['bytes'],p
    assert digest is None or digest==observed['sha256'],p
    return observed,raw

def checked(r):
    return ref(r['path'],r['bytes'],r['sha256'])[1]

def obj(r):
    return json.loads(checked(r))

def seal(name,data):
    p=work/name
    if type(data) is not bytes:
        data=(json.dumps(data,indent=2,sort_keys=True)+'\n').encode()
    with os.fdopen(os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400),'wb') as f:
        f.write(data);f.flush();os.fsync(f.fileno())
    return ref(p)[0]

def git(repo,*argv):
    return subprocess.check_output(['/usr/bin/git','--no-optional-locks','-C',str(repo),*argv],
        env=os.environ|{'GIT_NO_LAZY_FETCH':'1','GIT_TERMINAL_PROMPT':'0'},timeout=20)

def exact_keys(row):
    return {k:row[k] for k in ('path','bytes','sha256','full9')}



