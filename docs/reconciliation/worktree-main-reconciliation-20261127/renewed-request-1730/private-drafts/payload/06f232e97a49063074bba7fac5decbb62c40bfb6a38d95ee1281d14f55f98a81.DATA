assert worker_output['full9']['st_size']==physical_ref['bytes'] and worker_output['full9']['st_nlink']==1
assert {k:worker_output[k] for k in ('bytes','sha256')}=={k:physical_ref[k] for k in ('bytes','sha256')}
assert physical_ref['sha256']==sent['physical_request_sha256']==manifest['physical_context']['physical_request_sha256']
assert physical_ref['sha256']==anchors['physical_request_sha256']==joined['request_sha256']==current['request_sha256']
