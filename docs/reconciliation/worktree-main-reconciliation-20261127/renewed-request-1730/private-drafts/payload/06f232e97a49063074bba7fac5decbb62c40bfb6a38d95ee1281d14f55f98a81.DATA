replay_row=request_artifacts[request_value['component']['replay']]
assert replay_row['family']=='replay' and len(replay_row['payload'])==replay_row['bytes']
replay_args=decode_parent_replay_value_v1(replay_row['payload'],expected_payload_sha256=replay_row['sha256'])['join_args']
assert type(replay_args) is list and len(replay_args)==6
pairing,=json.loads(replay_args[0])['paired_bundles']
manifest_path=pairing['manifest_path_in_repo']
relative_manifest=Path(manifest_path)
assert not relative_manifest.is_absolute() and '..' not in relative_manifest.parts
assert str(relative_manifest)==manifest_path and relative_manifest.suffix=='.json'
historical_repo=Path(pairing['repository_root'])
assert historical_repo.is_absolute() and '..' not in historical_repo.parts
assert historical_repo.is_relative_to(worker_paired_path.parent/'material') and not os.path.lexists(historical_repo)
original_paths=request_value['physical_inputs']
assert set(original_paths)=={'law_path','entity_path'}
assert all(Path(path).is_relative_to(worker_paired_path.parent/'material') and not os.path.lexists(path)
           for path in original_paths.values())
assert set(replay_args[4])=={manifest_path}
manifest_bytes=replay_args[4][manifest_path]
paired_manifest_ref=dict(path_in_repo=manifest_path,bytes=len(manifest_bytes),sha256=h(manifest_bytes))
assert summary['retained_paired_cache_manifest']==paired_manifest_ref
manifest_descriptor,=json.loads(replay_args[3])['manifests']
assert all(manifest_descriptor[k]==paired_manifest_ref[k] for k in ('path_in_repo','bytes','sha256'))
bundle_manifest=json.loads(manifest_bytes)
assert bundle_manifest['path_in_repo']==manifest_path
assert set(bundle_manifest['tables'])=={'artifacts','goals','paired_spans'}
archive=decode_parent_replay_value_v1(retained_archive,expected_payload_sha256=paired_ref['sha256'])
assert type(archive) is dict and len(archive)==3
archive_tables={}
for role, table in bundle_manifest['tables'].items():
    name=table['path_in_repo']
    relative=Path(name)
    assert not relative.is_absolute() and '..' not in relative.parts
    assert str(relative)==name and relative.suffix=='.parquet'
    body=archive[name]
    assert type(body) is bytes and body[:4]==body[-4:]==b'PAR1'
    assert type(table['bytes']) is int and 0<len(body)==table['bytes'] and h(body)==table['sha256']
    archive_tables[role]={k:table[k] for k in ('path_in_repo','bytes','sha256')}
assert set(archive)=={row['path_in_repo'] for row in archive_tables.values()}
assert len(manifest_bytes)+sum(row['bytes'] for row in archive_tables.values())<=MAX_PARENT_REPLAY_BYTES

source_only=summary['source_only_original_path_projection']
