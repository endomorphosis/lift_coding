# Independently recompute CIDv1 dag-json+sha2-256 from the exact saved wire.
def verify_seal(value):
    body=dict(value)
    digest=body.pop("record_cid")
    assert body["cid_scope"]=="payload_without_record_cid/v1"
    prefix=bytes((1,0xA9,2,0x12,0x20))
    calculated="b"+base64.b32encode(prefix+hashlib.sha256(canonical(body)).digest()).decode().lower().rstrip("=")
    assert digest==calculated
for sealed in (result,current,checked,evidence,joined['declared_qualification'],joined['declared_eligibility']):
    verify_seal(sealed)
