scope=dict(schema='actual-R5-physical-v4-checked-whole-project-current/v1',
    terminal_returncode=0,terminal_session=session,full_report=report_ref,current_Source_read=source_ref,
    last_published_Guide582=guide_ref,prior_managed_ordinary62=ordinary_ref,exact_owned_terminal=dict(path=sys.argv[5],bytes=int(sys.argv[6]),sha256=sys.argv[7]),root_selection=chosen,raw_outputs=files,
    retained_physical_request=physical_ref,original_planned_physical_request_sha256=sent['physical_request_sha256'],
    retained_request_transport_bytes=physical_ref['bytes'],
    retained_paired_cache_archive=paired_ref,retained_paired_cache_manifest=paired_manifest_ref,
    retained_paired_cache_verified_tables=archive_tables,
    exact_paired_archive_joined_to_three_request_embedded_manifest_descriptors=True,
    original_fixture_paths_and_workspace_absent=True,
    exact_three_source_only_dag_json_record_CIDs_recomputed=True,
    source_only_original_path_projection=source_only_projection,
    after_close_portable_replay_executed=False,
    full_retained_precharge=selection['Source_precharge'],Source_closed=True,resource_and_parent_closed=True,
    receipt_observation=v,refused_joins=checks,checked_release_anchors=anchors,checked_native_observation=checked,
    current_review_observation=current,checked_release_refusals=bridge_refusals,exact_six_dag_json_record_CIDs_recomputed=True,exact_compiled_modules=len(receipt['compiled_modules']),exact_conditional_obligations=len(obligations),
    checked_whole_project=whole_summary,exact_whole_project_dag_json_record_CIDs_recomputed=True,
    fixture='signed fictional source and review',A4_original_parent_admission=False,proof_receipt_or_corpus_admission=False,
    exact_logical_output=acc,transport_wrapper_bytes=sum(f['bytes'] for f in files.values()))
out=work/'actual-R5-physical-v4-checked-whole-project-current.json'
body=(json.dumps(scope,indent=2,sort_keys=True)+'\n').encode()
with os.fdopen(os.open(out,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o400),'wb') as f:
    f.write(body);f.flush();os.fsync(f.fileno())
print(json.dumps(read(out)[0],sort_keys=True))
print(json.dumps(dict(measurements=m,exact_logical_output=acc)))
