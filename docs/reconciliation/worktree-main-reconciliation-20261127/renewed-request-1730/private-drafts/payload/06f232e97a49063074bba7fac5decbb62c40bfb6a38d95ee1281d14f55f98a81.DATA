worker_paired_path=Path(worker_paired_output['path'])
worker_request_path=Path(worker_output['path'])
assert worker_paired_path.is_absolute() and '..' not in worker_paired_path.parts
assert worker_paired_path.name=='paired-cache.bin' and worker_paired_path.parent==worker_request_path.parent
assert not os.path.lexists(worker_paired_path.parent)
assert set(worker_paired_output['full9'])==set(fields)
assert all(type(value) is int and value>=0 for value in worker_paired_output['full9'].values())
assert worker_paired_output['full9']['st_size']==paired_ref['bytes'] and worker_paired_output['full9']['st_nlink']==1
assert stat.S_ISREG(worker_paired_output['full9']['st_mode'])
assert stat.S_IMODE(worker_paired_output['full9']['st_mode'])==0o400
assert all(worker_paired_output[k]==paired_ref[k] for k in ('bytes','sha256'))
assert Path(physical_ref['path'])!=Path(paired_ref['path'])

request_value=decode_parent_replay_value_v1(retained_raw,expected_payload_sha256=physical_ref['sha256'])
assert request_value['schema']=='legal-uscode-release-closure-request/v4'
