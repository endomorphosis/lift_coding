        },
        "capacity_and_cost_baseline": {
          "$ref": "#/$defs/evidenceReference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "source_only"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "teacher_profiles": {
                "maxItems": 0
              },
              "projection_or_retrieval_contract": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "teacher_profiles": {
                "minItems": 1
              },
              "projection_or_retrieval_contract": {
                "$ref": "#/$defs/evidenceReference"
