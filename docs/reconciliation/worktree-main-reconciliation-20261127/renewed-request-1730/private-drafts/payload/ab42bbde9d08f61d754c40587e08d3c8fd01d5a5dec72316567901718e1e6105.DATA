"""
    current_anchors=current_anchors.replace("__HELPER_PATH__",repr(helper_ref['path'])).replace("__HELPER_BYTES__",repr(helper_ref['bytes'])).replace("__HELPER_HASH__",repr(helper_ref['sha256']))
