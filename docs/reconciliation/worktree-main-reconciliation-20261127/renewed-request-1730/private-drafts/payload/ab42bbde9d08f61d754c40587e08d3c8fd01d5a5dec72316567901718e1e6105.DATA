    for before,after in (
        ("len(sys.argv)==5, 'owned terminal session and exact Root selection PATH/BYTES/SHA required'","len(sys.argv)==8, 'owned terminal session, exact Root selection PATH/BYTES/SHA, actual reaped terminal PATH/BYTES/SHA required'"),
        ("schema='actual-R5-physical-v4-checked-release-retained-request-and-paired-cache-v563'","schema='actual-R5-physical-v4-checked-whole-project-current/v1'"),
        ("current_Guide563=guide_ref,prior_ordinary53=ordinary_ref","last_published_Guide582=guide_ref,prior_managed_ordinary62=ordinary_ref,exact_owned_terminal=dict(path=sys.argv[5],bytes=int(sys.argv[6]),sha256=sys.argv[7])"),
        ("out=work/'actual-R5-physical-v4-checked-release-retained-request-and-paired-cache-v563.json'",f"out=work/{OUTPUT!r}"),
    ):
        assert result.count(before)==1,before
        result=result.replace(before,after)
    compile(result,'existing-R5-current-six-output-closure-verifier','exec',dont_inherit=True)
    return save(out,'verify-current-P2-six-output-R5.py',result.encode())

def main():
    assert __debug__ and len(sys.argv) in (2,5)
    if sys.argv[1]=='--verify-nonclock':
        a,b,c,d,e,rows,controls,f,g,guide=read_current_source()
        assert normal_codec_pin(rows)
        print(json.dumps(dict(READ3=a,freeze=c,outer=e,ordinary62_plan=f,last_guide=guide,
            collector=controls['collector']['after'],verifier=detached_verifier_v04(controls),epoch_rows=len(rows),dispatch=False)))
        return
    hand=pin(sys.argv[1],int(sys.argv[2]),sys.argv[3]); out=Path(sys.argv[4])
    assert out.is_absolute() and not out.exists() and out.parent.resolve()==out.parent
    assert not any(out.is_relative_to(x) for x in (Path(D),Path(A)))
    out.mkdir(mode=0o700)
    prepare_runtime(obj(hand),out)

if __name__=='__main__':
    main()
