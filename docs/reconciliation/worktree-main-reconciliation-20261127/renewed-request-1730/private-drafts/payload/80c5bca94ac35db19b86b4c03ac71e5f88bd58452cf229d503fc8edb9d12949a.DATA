        assert seen['clean_worktree_and_index'] is True

    selected_paths = {str(D/p) for p in EXPECTED}
    proven = {row['path']: row for row in write['installed']}
    seen_read = {row['path']: row for row in src['captures']}
    assert len(proven) == len(write['installed']) == 2 and set(proven) == selected_paths
    assert len(seen_read) == len(src['captures']) == 4
    assert set(seen_read) == selected_paths | {str(root/'.git/index') for root in (D, A)}
    physical_fields = ('path', 'bytes', 'sha256', 'full9')
    assert all(seen_read[str(D/'.git/index')][k] == freeze['frozen']['stage0_index'][k] for k in physical_fields)
    for path, (oid, size, sha) in EXPECTED.items():
