def previous(name, digest):
    blob = (PREV / name).read_bytes()
    assert hashlib.sha256(blob).hexdigest() == digest
    return blob.decode()


def replace(text, before, after, count=1):
    assert text.count(before) == count, (before, text.count(before), count)
    return text.replace(before, after)


def splice(text, start, end, replacement):
    begin = text.index(start)
    stop = text.index(end, begin)
    return text[:begin] + replacement + text[stop:]


