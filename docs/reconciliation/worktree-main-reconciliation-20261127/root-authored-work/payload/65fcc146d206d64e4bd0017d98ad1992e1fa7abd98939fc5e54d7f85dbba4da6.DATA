"""Read-only GitHub repository identity comparison; never opens task payloads.

Current GitHub identity is useful for alias/fork/owner screening. It does not
prove historical independence, independent contributors, or training novelty.
"""
import concurrent.futures
import hashlib
import json
from pathlib import Path
import time
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parent


def dump(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def fetch(repo):
    url = "https://api.github.com/repos/" + repo
    started = time.time_ns()
    request = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "ns-repository-identity-audit/1",
        "X-GitHub-Api-Version": "2022-11-28",
    })
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read(2_000_001)
            if len(raw) > 2_000_000:
                raise ValueError("repository metadata byte limit")
            data = json.loads(raw)
            def project(item):
                return {"id": item["id"], "full_name": item["full_name"],
                        "owner_id": item["owner"]["id"],
                        "owner_login": item["owner"]["login"]}
            row = {**project(data), "status": "observed", "requested_repo": repo,
                   "request_url": url, "resolved_url": response.url,
                   "response_sha256": hashlib.sha256(raw).hexdigest(),
                   "fork": data["fork"], "archived": data["archived"],
                   "parent": project(data["parent"]) if data.get("parent") else None,
                   "source": project(data["source"]) if data.get("source") else None,
                   "license_spdx": (data.get("license") or {}).get("spdx_id"),
                   "started_at_ns": started, "finished_at_ns": time.time_ns()}
            return row, raw
    except Exception as exc:
        return {"requested_repo": repo, "request_url": url, "status": "unavailable",
                "error_type": type(exc).__name__,
                "http_code": exc.code if isinstance(exc, urllib.error.HTTPError) else None,
                "started_at_ns": started, "finished_at_ns": time.time_ns()}, None


def main():
    output = ROOT / "repository_identity_v1"
    output.mkdir()
    (output / "responses").mkdir()
    old_path = ROOT.parent / "next_stage_candidate_registry.json"
    new_path = ROOT / "verified_metadata_v1/public_metadata.json"
    old = json.loads(old_path.read_text())["historical_candidates"]
    new = json.loads(new_path.read_text())
    if isinstance(new, dict):
        new = new["rows"]
    old_repos = sorted({r["family_id"].removeprefix("upstream:") for r in old})
    new_repos = sorted({r["repo"] for r in new})
    repos = sorted(set(old_repos + new_repos))
    freeze = {"schema": "ns-repository-identity-freeze/v1", "frozen_at_ns": time.time_ns(),
              "script_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
              "inputs": {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in (old_path, new_path)},
              "original_repositories": old_repos, "candidate_repositories": new_repos,
              "comparison_rule": "Same repository ID or intersecting repository/source/parent IDs is identity/declared-fork overlap. Same owner ID is separately flagged conservatively, not asserted to imply shared source or author dependence.",
              "model_calls": 0, "hidden_payloads_read": False}
    dump(output / "freeze.json", freeze)
    (output / Path(__file__).name).write_bytes(Path(__file__).read_bytes())
    observations = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = {pool.submit(fetch, repo): repo for repo in repos}
        for future in concurrent.futures.as_completed(futures):
            row, raw = future.result()
            repo = futures[future]
            observations[repo] = row
            dump(output / (repo.replace("/", "__") + ".json"), row)
            if raw is not None:
                (output / "responses" / (repo.replace("/", "__") + ".json")).write_bytes(raw)
    def ids(row):
        return {row["id"]} | {row[k]["id"] for k in ("parent", "source") if row[k]}
    comparisons = []
    for repo in new_repos:
        candidate = observations[repo]
        identity, owner, unknown = [], [], []
        for original in old_repos:
            prior = observations[original]
            if candidate["status"] != "observed" or prior["status"] != "observed":
                unknown.append(original)
                continue
            if ids(candidate) & ids(prior):
                identity.append(original)
            if candidate["owner_id"] == prior["owner_id"]:
                owner.append(original)
        comparisons.append({"candidate": repo, "identity_or_declared_fork_overlap": identity,
                            "shared_current_owner": owner, "unresolved_comparisons": unknown,
                            "confirmatory_enrolled": False})
    summary = {"schema": "ns-repository-identity-audit/v1", "requested_repositories": len(repos),
               "observed_repositories": sum(r["status"] == "observed" for r in observations.values()),
               "comparisons": comparisons,
               "redirected_or_renamed_repositories": [{"requested": repo, "current": r["full_name"]}
                    for repo, r in sorted(observations.items())
                    if r["status"] == "observed" and repo.lower() != r["full_name"].lower()],
               "candidate_identity_overlap_count": sum(bool(r["identity_or_declared_fork_overlap"]) for r in comparisons),
               "candidate_shared_owner_count": sum(bool(r["shared_current_owner"]) for r in comparisons),
               "all_identity_comparisons_observed": not any(r["unresolved_comparisons"] for r in comparisons),
               "confirmatory_enrolled_families": 0, "model_calls": 0,
               "scope": "Current GitHub alias, declared fork and owner metadata against the sixteen original repositories only. Portfolio exposure, historical code ancestry, dependency overlap and model-training contamination are not established by this audit."}
    dump(output / "summary.json", summary)
    dump(output / "artifact_manifest.json", {str(p.relative_to(output)): hashlib.sha256(p.read_bytes()).hexdigest()
         for p in sorted(output.rglob("*")) if p.is_file()})
    print(json.dumps(summary, indent=2))


if __name__ == "__main__":
    main()
