def test_catalog_finalguard_detects_command_prefix_callback_input_write_restore(case,monkeypatch):
    target=case['root']/case['prepared']['artifact'];raw=target.read_bytes()
    real=catalog._command_prefix
    def prefix(*args):
        command=real(*args);target.write_bytes(raw+b' ');target.write_bytes(raw);return command
    monkeypatch.setattr(catalog,'_command_prefix',prefix)
    with pytest.raises(ValueError):load(case)


def test_catalog_whole_operation_suppresses_owner_and_guard_detects_later_source_change(case,monkeypatch):
    from ipfs_accelerate_py.agent_supervisor.runtime import supervisor_meta_index as metadata
    calls=[];monkeypatch.setattr(metadata.SupervisorMetaIndex,'from_env',lambda:calls.append(True))
    _,_,guard=load(case);assert calls==[]
    target=case['root']/'worker.py';raw=target.read_bytes();target.write_bytes(raw+b' ');target.write_bytes(raw)
    with pytest.raises(ValueError):guard()


def test_daemon_required_pointer_and_absent_default_roundtrip(case,monkeypatch):
    from ipfs_accelerate_py.agent_supervisor.todo_daemon.implementation_daemon import PortalImplementationDaemon
    fake=SimpleNamespace(repo_root=case['root'],_task_metadata_value=lambda task,key: task.metadata.get(key,''))
    base={'code retrieval artifact':'retrieval.json','code retrieval sha256':case['prepared']['native_bindings']['source_artifact_sha256']}
    task=SimpleNamespace(task_id=case['inputs']['task_id'],canonical_task_cid=case['inputs']['task_cid'],metadata=base)
    old=PortalImplementationDaemon._code_retrieval_implementation_references(fake,task,repository_id='repo:outer',tree_id='head:outer')
    assert all(row.kind!=catalog.KIND for row in old)
    task.metadata={**base,**{key.lower():value for key,value in case['prepared']['metadata'].items()}}
    new=PortalImplementationDaemon._code_retrieval_implementation_references(fake,task,repository_id='repo:outer',tree_id='head:outer')
    assert new[:-1]==old and new[-1].kind==catalog.KIND and new[-1].required
    task.metadata.pop('code source nomination sha256')
    with pytest.raises(ValueError):PortalImplementationDaemon._code_retrieval_implementation_references(fake,task,repository_id='repo:outer',tree_id='head:outer')


def setup_runner(case,tmp_path,monkeypatch):
    from ipfs_accelerate_py import llm_router
    from ipfs_accelerate_py.llm_allocation import intelligence_index
    from ipfs_accelerate_py.agent_supervisor.runtime import (semantic_router_translation,router_public_instruction,
        multi_supervisor_runner,codex_usage_receipt)
    def git(*args):subprocess.run(['/usr/bin/git','-C',str(case['root']),*args],capture_output=True,check=True)
    git('init');git('add','worker.py','instruction.md');git('-c','user.name=Fixture','-c','user.email=fixture@example.invalid','commit','-m','public')
    workspace=tmp_path/'allocated-worktree';git('worktree','add','--detach',str(workspace),'HEAD');monkeypatch.chdir(workspace)
    for name in (*multi_supervisor_runner.DATABASE_PROGRAM_ENV_NAMES,*multi_supervisor_runner.STATE_CREDENTIAL_ENV_NAMES,'IPFS_ACCELERATE_AGENT_STATE_OWNER_TOKEN'):
        monkeypatch.delenv(name,raising=False)
    monkeypatch.setattr(semantic_router_translation,'encode_semantic_router_prompt',lambda **_:SimpleNamespace(
        receipt=case['semantic'],provider_prompt=case['prompt']))
    monkeypatch.setattr(semantic_router_translation,'decode_semantic_router_response',lambda response,**_:SimpleNamespace(
        text=response,receipt={'unit_stub':True,'completion_authority':False}))
    monkeypatch.setattr(router_public_instruction,'load_public_instruction',lambda **_:(case['block'],case['public']))
    monkeypatch.setattr(intelligence_index,'discover_available_providers',lambda:['codex_cli'])
    monkeypatch.setattr(intelligence_index,'select_efficient_route',lambda **_:SimpleNamespace(provider='codex_cli',model_name='pinned',catalog_revision='fixture'))
    monkeypatch.setattr(llm_router,'get_llm_provider',lambda *a,**k:object())
    monkeypatch.setattr(codex_usage_receipt,'recover_codex_usage',lambda **_:None)
    from ipfs_accelerate_py.cli_runtime.cli_metadata import set_last_cli_observation
    monkeypatch.setattr(llm_router,'generate_text',lambda *a,**k:set_last_cli_observation('codex_cli',{'exit_code':0}) or 'fake')
    return llm_router,dict(prompt=case['prompt'],provider='codex_cli',model='pinned',timeout=30,max_output_tokens=100,
        semantic_repository=case['root'],semantic_transport='native',public_instruction_artifact=tmp_path/'synthetic-admitted.json',
        public_instruction_sha256='a'*64,public_instruction_task_cid=case['inputs']['task_cid'])


@pytest.mark.parametrize('mode,semantic_mode',[('expanded','native'),('compact','native'),('expanded','identifiers')])
def test_actual_runner_fake_dispatch_preserves_native_identity_literal_and_full_catalog(case,tmp_path,monkeypatch,capsys,mode,semantic_mode):
    llm,options=setup_runner(case,tmp_path,monkeypatch);observed=[]
    def generate(prompt,**kwargs):
        from ipfs_accelerate_py.cli_runtime.cli_metadata import set_last_cli_observation
        observed.append(prompt);set_last_cli_observation('codex_cli',{'exit_code':0});return 'authored fake response'
    monkeypatch.setattr(llm,'generate_text',generate)
    _,receipt=runner.run(**{**options,'semantic_transport':semantic_mode},code_retrieval_codec=mode)
    assert len(observed)==1 and receipt['router_calls']==1
    assert observed[0].endswith(case['block']) and catalog.HEADER in observed[0]
    assert receipt['native_prompt_sha256']==sha(case['prompt'].encode())
    assert receipt['reviewed_source_nomination_context']['row_count']==1
    assert receipt['model_prompt_bytes']==len(observed[0].encode())
    assert receipt['completion_authority'] is False
    assert receipt['semantic_transport']==semantic_mode
    if mode=='compact':assert receipt['code_retrieval_projection']['selected_transport']=='compact'
    capsys.readouterr()


@pytest.mark.parametrize('observer',[False,True])
@pytest.mark.parametrize('revision',['task:nomination','revision:foreign'])
def test_runner_rejects_wrong_revision_before_provider_or_model_observation(case,tmp_path,monkeypatch,observer,revision):
    from test.api.test_router_model_input_observation import (
        protect_observation_inputs,forbid_provider_apis,authored_boundary,
    )
    from ipfs_accelerate_py.agent_supervisor.runtime import container_worker_boundary
    _,options=setup_runner(case,tmp_path,monkeypatch)
    prompt,semantic=modified_prompt(case,lambda capsule:capsule.__setitem__('objective_revision',revision))
    case['prompt']=prompt;case['semantic'].update(semantic)
    options['prompt']=prompt
    if observer:
        artifact=protect_observation_inputs(case['root'],prompt,case['public'])
        monkeypatch.setattr(container_worker_boundary,'verify_container_worker_boundary',lambda **_:authored_boundary())
        options.update(public_instruction_artifact=artifact,public_instruction_sha256=case['public']['artifact_sha256'],
            container_boundary=tmp_path/'authored-boundary.json',container_boundary_sha256='c'*64,
            observe_model_input_only=True)
    forbid_provider_apis(monkeypatch)
    emitted=[];real=runner.render_model_prompt
    def render(**kwargs):emitted.append(True);return real(**kwargs)
    monkeypatch.setattr(runner,'render_model_prompt',render)
    with pytest.raises(source.CodeSourceInspectionError,match='catalog differs'):
        runner.run(**options)
    assert emitted==[]


def test_runner_absent_default_unchanged_and_missing_binding_preprovider(case,tmp_path,monkeypatch,capsys):
    llm,options=setup_runner(case,tmp_path,monkeypatch)
    monkeypatch.setattr(llm,'generate_text',lambda *a,**k:pytest.fail('invalid nomination reached provider'))
    with pytest.raises(ValueError):runner.run(**{**options,'public_instruction_artifact':None,'public_instruction_sha256':'','public_instruction_task_cid':''})
    prompt,semantic=modified_prompt(case,lambda capsule:capsule['evidence'].__setitem__(slice(None),[row for row in capsule['evidence'] if row['kind']!=catalog.KIND]))
    case['semantic'].update(semantic);captured=[]
    def generate(prompt,**kwargs):
        from ipfs_accelerate_py.cli_runtime.cli_metadata import set_last_cli_observation
        captured.append(prompt);set_last_cli_observation('codex_cli',{'exit_code':0});return 'fake'
    monkeypatch.setattr(llm,'generate_text',generate)
    _,receipt=runner.run(**{**options,'prompt':prompt})
    expected,_=runner.render_model_prompt(prompt=prompt+case['block'],purpose='coding',workspace=Path.cwd())
    assert captured==[expected] and 'reviewed_source_nomination_context' not in receipt
    capsys.readouterr()


def test_runner_finalguard_before_dispatch_rejects_provider_selection_mutation(case,tmp_path,monkeypatch,capsys):
    llm,options=setup_runner(case,tmp_path,monkeypatch)
    target=case['root']/case['prepared']['artifact'];raw=target.read_bytes()
    def provider(*a,**k):target.write_bytes(raw+b' ');target.write_bytes(raw);return object()
    monkeypatch.setattr(llm,'get_llm_provider',provider)
    monkeypatch.setattr(llm,'generate_text',lambda *a,**k:pytest.fail('changed nomination reached provider'))
    with pytest.raises(ValueError):runner.run(**options)
    receipt=json.loads(capsys.readouterr().out.strip().splitlines()[-1])
    assert receipt['router_calls']==0 and receipt['usage'] is None and receipt['completion_authority'] is False


def test_runner_finalguard_after_materializer_callback_refuses_before_provider(case,tmp_path,monkeypatch,capsys):
    from ipfs_accelerate_py.agent_supervisor.runtime import code_retrieval_wire_delivery as delivery,container_worker_boundary
    llm,options=setup_runner(case,tmp_path,monkeypatch)
    monkeypatch.setattr(container_worker_boundary,'verify_container_worker_boundary',lambda **_:{'unit_stub':True})
    real=delivery.materialize_verified_code_retrieval_wire
    target=case['root']/case['prepared']['artifact'];raw=target.read_bytes();called=[]
    def materialize(*args,**kwargs):
        handle=real(*args,**kwargs);called.append(True)
        target.write_bytes(raw+b' ');target.write_bytes(raw)
        return handle
    monkeypatch.setattr(delivery,'materialize_verified_code_retrieval_wire',materialize)
    monkeypatch.setattr(llm,'generate_text',lambda *a,**k:pytest.fail('changed nomination reached provider'))
    # The public fixture may have writable workspace ancestors. Keep the real
    # production ancestry check and put only this ephemeral wire beneath /tmp.
    with tempfile.TemporaryDirectory(prefix='nomination-materializer-',dir='/tmp') as directory:
        wire_root=Path(directory)/'context-wires';wire_root.mkdir(mode=0o700)
        monkeypatch.setattr(runner,'_wire_delivery_root',lambda:wire_root)
        with pytest.raises(ValueError):runner.run(**options,code_retrieval_codec='compact',code_retrieval_wire_delivery='materialized',
            container_boundary=tmp_path/'synthetic-boundary.json',container_boundary_sha256='c'*64)
        receipt=json.loads(capsys.readouterr().out.strip().splitlines()[-1])
        assert called==[True] and receipt['router_calls']==0 and receipt['usage'] is None
        assert receipt['wire_delivery_cleanup_status']=='removed' and list(wire_root.iterdir())==[]


def test_complete_model_budget_charges_catalog_and_literal_before_any_provider_call(case,tmp_path,monkeypatch):
    llm,options=setup_runner(case,tmp_path,monkeypatch)
    prompt=case['prompt']+'\n'+('x'*(254000-len(case['prompt'].encode())-1))
    case['semantic'].update(native_prompt_sha256=sha(prompt.encode()),native_prompt_bytes=len(prompt.encode()))
    assert len(prompt.encode())==254000
    monkeypatch.setattr(llm,'get_llm_provider',lambda *a,**k:pytest.fail('overbudget prompt selected provider'))
    monkeypatch.setattr(llm,'generate_text',lambda *a,**k:pytest.fail('overbudget prompt dispatched provider'))
    with pytest.raises(ValueError,match='model prompt'):
        runner.run(**{**options,'prompt':prompt})
