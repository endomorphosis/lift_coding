    {"implementation": []}])
def test_portal_projection_requires_plain_retained_summary_shapes(summary):
    with pytest.raises(ValueError): diag.project_portal_implementation_summary(summary)


def test_portal_projection_refuses_mapping_subclasses():
    class MappingSubclass(dict):
        pass
    with pytest.raises(ValueError): diag.project_portal_implementation_summary(MappingSubclass(_portal_summary()))
    with pytest.raises(ValueError):
        diag.project_portal_implementation_summary({"implementation": MappingSubclass(returncode=1)})


def test_portal_unknown_reason_retains_only_utf8_digest_and_length():
    source = "provider token=PRIVATE_BODY /private/key α雪"
    summary = _portal_summary(); summary["implementation"]["reason"] = source
    projection = diag.project_portal_implementation_summary(summary)
    assert projection["reason"] == "unclassified_native_reason"
    assert projection["reason_sha256"] == hashlib.sha256(source.encode()).hexdigest()
    assert projection["reason_bytes"] == len(source.encode())
    assert "PRIVATE_BODY" not in wire(projection).decode() and "/private" not in wire(projection).decode()


@pytest.mark.parametrize("invalid", [True, 1, [], "雪" * 1400])
def test_portal_reason_type_and_utf8_bound(invalid):
    summary = _portal_summary(); summary["implementation"]["reason"] = invalid
    with pytest.raises(ValueError): diag.project_portal_implementation_summary(summary)


@pytest.mark.parametrize("mutation", ["extra", "missing", "bool_code", "bool_size", "wrong_known_digest", "absent_reason_digest", "flag_alias"])
def test_portal_wire_projection_has_closed_identity_and_types(mutation):
    projection = diag.project_portal_implementation_summary(_portal_summary())
    if mutation == "extra": projection["command"] = "never export"
    elif mutation == "missing": projection.pop("returncode")
    elif mutation == "bool_code": projection["returncode"] = True
    elif mutation == "bool_size": projection["reason_bytes"] = True
    elif mutation == "wrong_known_digest": projection["reason_sha256"] = "0" * 64
    elif mutation == "absent_reason_digest": projection["reason"] = None
    else: projection["provider_dispatched"] = 0
    with pytest.raises(ValueError): diag.validate_portal_implementation_projection(projection)


def test_portal_projection_is_from_only_this_completed_pass(scope, result):
    first = diag.project_portal_implementation_summary(_portal_summary())
    result["implementation_result"]["bridge_portal_implementation"] = first
    result["portal_implementation"] = {"returncode": 99}
    record = build(scope, result)
    assert record["portal_implementation"] == first
    result["implementation_result"]["bridge_portal_implementation"] = {"returncode": 99}
    with pytest.raises(ValueError): build(scope, result)


def _legacy(record):
    legacy = deepcopy(record)
    legacy.pop("portal_implementation")
    legacy["schema"] = "native-dispatch-first-claimed-pass@1"
    return legacy


def test_retained_v1_validation_and_protected_read_do_not_add_fields(run_root, scope, record):
    legacy = _legacy(record); original = wire(legacy)
    assert set(legacy) == diag.LEGACY_FIELDS
    assert wire(diag.validate_first_claimed_pass_diagnostic(legacy)) == original
    assert diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=legacy) is True
    assert wire(diag.read_first_claimed_pass_diagnostic(run_root=run_root, expected_scope=scope)) == original
    assert diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=record) is False
    assert (run_root / diag.FIRST_PASS_NAME).read_bytes() == original


@pytest.mark.parametrize("mutation", ["v1_extra", "v2_missing", "foreign_version"])
def test_versioned_records_never_silently_change_fieldsets(record, mutation):
    if mutation == "v1_extra": record["schema"] = diag.LEGACY_SCHEMA
    elif mutation == "v2_missing": record.pop("portal_implementation")
    else: record["schema"] = "native-dispatch-first-claimed-pass@3"
    with pytest.raises(ValueError): diag.validate_first_claimed_pass_diagnostic(record)


@pytest.mark.parametrize("mutation", ["unknown", "authority_alias", "foreign_task", "bool_sequence", "bool_count", "unknown_impl", "reason_identity", "missing_impl"])
def test_public_record_is_a_closed_non_authority(record, mutation):
    if mutation == "unknown": record["hidden"] = False
    elif mutation == "authority_alias": record["execution_authority"] = 0
    elif mutation == "foreign_task": record["claimed_task_cid"] = "cid:foreign"
    elif mutation == "bool_sequence": record["sequence"] = True
    elif mutation == "bool_count": record["write_count"] = False
    elif mutation == "unknown_impl": record["implementation"]["prompt"] = "private"
    elif mutation == "reason_identity": record["implementation"]["reason_sha256"] = "f" * 64
    else: record.pop("implementation")
    with pytest.raises(ValueError): diag.validate_first_claimed_pass_diagnostic(record)


def test_exclusive_retention_keeps_first_outcome_and_stat_identity(run_root, scope, result):
    first = build(scope, result, 4)
    assert diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=first) is True
    path = run_root / diag.FIRST_PASS_NAME; before = path.stat(); before_bytes = path.read_bytes()
    result["implementation_result"]["reason"] = "portal_provider_failed"
    later = build(scope, result, 99)
    assert diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=later) is False
    assert path.read_bytes() == before_bytes and path.stat().st_ino == before.st_ino
    assert path.stat().st_mtime_ns == before.st_mtime_ns and path.stat().st_ctime_ns == before.st_ctime_ns
    retained = diag.read_first_claimed_pass_diagnostic(run_root=run_root, expected_scope=scope)
    assert retained == first and retained["sequence"] == 4


def test_missing_protected_record_returns_none(run_root, scope):
    assert diag.read_first_claimed_pass_diagnostic(run_root=run_root, expected_scope=scope) is None


@pytest.mark.parametrize("kind", ["symlink", "fifo", "hardlink", "mode", "oversized", "bad_json", "duplicate_json", "foreign_scope"])
def test_reader_refuses_unsafe_or_forged_sidecar(run_root, tmp_path, record, scope, kind):
    path = run_root / diag.FIRST_PASS_NAME
    raw = wire(record)
    if kind == "symlink":
        other = tmp_path / "foreign"; other.write_bytes(raw); path.symlink_to(other)
    elif kind == "fifo": os.mkfifo(path, 0o600)
    else:
        if kind == "oversized": raw = b"x" * (diag.MAX_RECORD_BYTES + 1)
        elif kind == "bad_json": raw = b"{"
        elif kind == "duplicate_json": raw = raw[:-1] + b',"schema":"native-dispatch-first-claimed-pass@1"}'
        elif kind == "foreign_scope": record["scope"]["command_sha256"] = "e" * 64; raw = wire(record)
        path.write_bytes(raw); path.chmod(0o600)
        if kind == "hardlink": os.link(path, tmp_path / "linked")
        elif kind == "mode": path.chmod(0o644)
    with pytest.raises((ValueError, OSError)):
        diag.read_first_claimed_pass_diagnostic(run_root=run_root, expected_scope=scope)


@pytest.mark.parametrize("kind", ["linked_root", "public_root", "noncanonical"])
def test_publication_root_is_nofollow_private_canonical(run_root, tmp_path, record, kind):
    if kind == "linked_root":
        linked = tmp_path / "link"; linked.symlink_to(run_root, target_is_directory=True); selected = linked
    elif kind == "public_root": run_root.chmod(0o755); selected = run_root
    else: selected = str(run_root.parent) + "/../" + run_root.parent.name + "/" + run_root.name
    with pytest.raises((ValueError, OSError)):
        diag.publish_first_claimed_pass_diagnostic(run_root=selected, record=record)
    assert not (run_root / diag.FIRST_PASS_NAME).exists()


def test_existing_foreign_first_record_is_never_replaced(run_root, scope, record):
    diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=record)
    before = (run_root / diag.FIRST_PASS_NAME).read_bytes()
    foreign = deepcopy(record); foreign["scope"]["command_sha256"] = "e" * 64
    with pytest.raises(ValueError): diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=foreign)
    assert (run_root / diag.FIRST_PASS_NAME).read_bytes() == before


@pytest.mark.parametrize("mutation", ["inode", "write_restore"])
def test_mid_read_mutation_refuses(run_root, scope, record, monkeypatch, mutation):
    diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=record)
    path = run_root / diag.FIRST_PASS_NAME; original = os.read; acted = []
    def changed(fd, size):
        block = original(fd, size)
        if block and not acted:
            acted.append(True); raw = path.read_bytes()
            if mutation == "inode":
                replacement = run_root / "replacement"; replacement.write_bytes(raw); replacement.chmod(0o600); replacement.replace(path)
            else: path.write_bytes(b"changed"); path.write_bytes(raw)
        return block
    monkeypatch.setattr(diag.os, "read", changed)
    with pytest.raises(ValueError): diag.read_first_claimed_pass_diagnostic(run_root=run_root, expected_scope=scope)


def test_run_root_substitution_after_capture_refuses(run_root, scope, record, monkeypatch):
    diag.publish_first_claimed_pass_diagnostic(run_root=run_root, record=record)
    original = diag._read
    def substituted(fd):
        value = original(fd)
        run_root.rename(run_root.with_name("retired-root")); run_root.mkdir(mode=0o700)
        return value
    monkeypatch.setattr(diag, "_read", substituted)
    with pytest.raises(ValueError): diag.read_first_claimed_pass_diagnostic(run_root=run_root, expected_scope=scope)


def _native_stub(scope, monkeypatch, failure):
    from ipfs_accelerate_py.agent_supervisor.todo_daemon import implementation_daemon as module
    obj = object.__new__(module.DatabaseImplementationDaemon)
    obj._shutdown_boundary = lambda: None
    obj._renew_attempt_lease = lambda _: None
    obj.provider_invocation_recorded = lambda *_, **__: {"callback_state": "started_outcome_unknown"}
    obj._record_event = lambda *_, **__: None
    def callback(_):
        raise failure
    obj.resume_attempt = callback
    attempt = SimpleNamespace(attempt_id="execution:unit001", task_cid=scope["task_cid"], task_alias="AUTHORED-TASK")
    return module, obj, attempt


@pytest.mark.parametrize("enabled", [False, True])
@pytest.mark.parametrize("kind", ["early_deferral", "unknown_error"])
def test_real_resume_method_retains_same_outcome_and_optin_safe_diagnostic(scope, monkeypatch, enabled, kind):
    from ipfs_accelerate_py.agent_supervisor.todo_daemon.database_portal_bridge import DatabasePortalBridgeDeferred, DatabasePortalBridgeError
    failure = (DatabasePortalBridgeDeferred("do not export raw prompt /private/path")
        if kind == "early_deferral" else DatabasePortalBridgeError("do not export raw prompt /private/path"))
    _, native, attempt = _native_stub(scope, monkeypatch, failure)
    if enabled: monkeypatch.setenv(diag.ENV, wire(scope).decode())
    else: monkeypatch.delenv(diag.ENV, raising=False)
    result = native._resume_attempt_without_process_crash(attempt)
    assert result["status"] == "running" and result["deferred"] is True and result["attempt_id"] == attempt.attempt_id
    assert ("bridge_unknown_diagnostic" in result) is enabled
    assert ("bridge_portal_implementation" in result) is enabled
    if enabled:
        safe = diag.validate_bridge_unknown_diagnostic(result["bridge_unknown_diagnostic"])
        assert safe["exceptions"][0]["exception_type"] == type(failure).__name__
        record = build(scope, {"claimed_task_cid": scope["task_cid"], "attempt_id": attempt.attempt_id,
            "active_task_id": "AUTHORED-TASK", "write_count": 1, "implementation_result": result})
        assert "do not export" not in wire(record).decode() and "private/path" not in wire(record).decode()


@pytest.mark.parametrize("enabled", [False, True])
@pytest.mark.parametrize("kind", ["early_deferral", "unknown_error"])
def test_real_resume_retains_same_exception_portal_summary_without_body_or_replay(scope, monkeypatch, enabled, kind):
    from ipfs_accelerate_py.agent_supervisor.todo_daemon.database_portal_bridge import DatabasePortalBridgeDeferred, DatabasePortalBridgeError
    summary = _portal_summary(); summary["implementation"]["reason"] = "sensitive worker failure α雪"
    summary["implementation"].update(branch="private-branch", task_id="private-alias", output="private-body")
    kind_type = DatabasePortalBridgeDeferred if kind == "early_deferral" else DatabasePortalBridgeError
    failure = kind_type("private bridge message", result=summary)
    _, native, attempt = _native_stub(scope, monkeypatch, failure)
    calls = []
    def callback(_):
        calls.append(attempt.attempt_id)
        raise failure
    native.resume_attempt = callback
    if enabled: monkeypatch.setenv(diag.ENV, wire(scope).decode())
    else: monkeypatch.delenv(diag.ENV, raising=False)
    outcome = native._resume_attempt_without_process_crash(attempt)
    assert calls == [attempt.attempt_id] and outcome["status"] == "running" and outcome["deferred"] is True
    assert ("bridge_portal_implementation" in outcome) is enabled
    if enabled:
        projection = outcome["bridge_portal_implementation"]
        assert projection == diag.project_portal_implementation_summary(failure.result)
        assert projection["returncode"] == 1 and projection["provider_dispatched"] is False
        record = build(scope, {"claimed_task_cid": scope["task_cid"], "attempt_id": attempt.attempt_id,
            "active_task_id": "AUTHORED-TASK", "write_count": 1, "implementation_result": outcome})
        assert record["portal_implementation"] == projection
        assert "sensitive worker" not in wire(record).decode() and "private-" not in wire(record).decode()
        assert all(record[key] is False for key in diag.FALSE_FIELDS)


def test_malformed_portal_summary_does_not_change_retained_native_outcome(scope, monkeypatch):
    from ipfs_accelerate_py.agent_supervisor.todo_daemon.database_portal_bridge import DatabasePortalBridgeDeferred
    failure = DatabasePortalBridgeDeferred("retained", result={"implementation": {"returncode": True}})
    _, native, attempt = _native_stub(scope, monkeypatch, failure)
    monkeypatch.setenv(diag.ENV, wire(scope).decode())
    outcome = native._resume_attempt_without_process_crash(attempt)
    assert outcome["status"] == "running" and outcome["deferred"] is True
    assert "bridge_portal_implementation" not in outcome and "bridge_unknown_diagnostic" not in outcome


def test_default_exception_helper_does_not_import_new_module(scope, monkeypatch):
    import builtins
    from ipfs_accelerate_py.agent_supervisor.todo_daemon import implementation_daemon as native
    monkeypatch.delenv(diag.ENV, raising=False)
    original = builtins.__import__
    def forbid(name, *args, **kwargs):
        if "native_dispatch_diagnostics" in name:
            pytest.fail("default path imported telemetry helper")
        return original(name, *args, **kwargs)
    monkeypatch.setattr(builtins, "__import__", forbid)
    assert native._scoped_native_dispatch_exception_diagnostic(ValueError("unused")) == {}


@pytest.mark.parametrize("enabled", [False, True])
def test_running_pass_uses_already_held_attempt_ids_without_stitched_read(scope, monkeypatch, enabled):
    from ipfs_accelerate_py.agent_supervisor.todo_daemon import implementation_daemon as native
    from ipfs_accelerate_py.agent_supervisor.todo_daemon import unresolved_interruption
    obj = object.__new__(native.DatabaseImplementationDaemon)
    obj._native_dispatch_control = None
    obj.reconcile_prepared_task_completions = lambda: []
    obj.reconcile_terminal_portal_failures = lambda: []
    obj.reconcile_expired_running_attempts = lambda **_: []
    obj.reconcile_recoverable_portal_failure_rearms = lambda: []
    monkeypatch.setattr(unresolved_interruption, "reconcile_declared", lambda _: [])
    obj._retained_attempt_fairness = SimpleNamespace(require_current=lambda: None, excluded_task_cids=set(), attempt=None)
    attempt = SimpleNamespace(task_cid=scope["task_cid"], task_alias="AUTHORED-TASK", attempt_id="execution:unit001")
    obj.list_running_attempts = lambda: [attempt]
    obj._task_recovery_lease = lambda _: None
    obj._resume_attempt_without_process_crash = lambda _: {"attempt_id": attempt.attempt_id, "status": "running", "reason": "provider_callback_outcome_unknown"}
    obj.authority_mode = "quack"; obj.task_source_kind = "duckdb"; obj._markdown_status_writes = 0; obj._control_schema_verification = {}
    obj.state_schema_revision = "authored-unit-profile"
    if enabled: monkeypatch.setenv(diag.ENV, wire(scope).decode())
    else: monkeypatch.delenv(diag.ENV, raising=False)
    result = obj._run_once_impl()
    assert ("claimed_task_cid" in result) is enabled and ("attempt_id" in result) is enabled
    if enabled:
        assert build(scope, result)["claimed_task_cid"] == attempt.task_cid
