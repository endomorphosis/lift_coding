"""Pure telemetry/capture controls plus explicit stubbed daemon integration.

No native owner admission, provider, target code, training, solver or original
index qualification. The callback controls invoke real daemon methods on an
uninitialized object with all owner/callback operations explicitly stubbed.
"""
from copy import deepcopy
import hashlib
import json
import os
from pathlib import Path
from types import SimpleNamespace

import pytest

from ipfs_accelerate_py.agent_supervisor.runtime import native_dispatch_diagnostics as diag


def wire(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode()


@pytest.fixture
def scope():
    return {"schema": diag.SCOPE_SCHEMA, "run_id": "admitted-" + "a" * 32, "task_cid": "cid:authored-task",
        "command_sha256": "b" * 64, "producer_source_sha256": "c" * 64}


@pytest.fixture
def result(scope):
    return {"active_task_id": "AUTHORED-TASK", "claimed_task_cid": scope["task_cid"], "attempt_id": "execution:unit001",
        "write_count": 1, "implementation_result": {"status": "running", "reason": "provider_callback_outcome_unknown",
            "deferred": True, "attempt_id": "execution:unit001"}}


def build(scope, result, sequence=1):
    return diag.build_first_claimed_pass_diagnostic(scope=scope, sequence=sequence, result=result,
        process_instance_id="process:unit001", owner_session_id="database-session:unit001")


@pytest.fixture
def record(scope, result):
    return build(scope, result)


@pytest.fixture
def run_root(tmp_path):
    root = tmp_path / "private-run"
    root.mkdir(mode=0o700)
    return root


def test_projection_is_closed_independent_and_not_provider_authority(scope, result):
    result.update(prompt="MUST NEVER EXPORT", command="PRIVATE ARGV", usage={"tokens": 7})
    record = build(scope, result)
    assert set(record) == diag.FIELDS and record["scope"] == scope
    assert all(record[key] is False for key in diag.FALSE_FIELDS)
    assert "PRIVATE" not in wire(record).decode() and "MUST NEVER" not in wire(record).decode()
    result["implementation_result"]["reason"] = "changed"
    scope["command_sha256"] = "f" * 64
    assert record["implementation"]["reason"] == "provider_callback_outcome_unknown"
    assert record["scope"]["command_sha256"] == "b" * 64


def test_unknown_reason_and_status_are_digest_and_size_only(scope, result):
    source = "private/path prompt α雪 token=DO_NOT_EXPORT"
    result["implementation_result"].update(reason=source, status=source)
    record = build(scope, result)
    assert record["implementation"]["reason"] == "unclassified_native_reason"
    assert record["implementation"]["status"] == "unclassified_native_status"
    assert record["implementation"]["reason_sha256"] == hashlib.sha256(source.encode()).hexdigest()
    assert record["implementation"]["reason_bytes"] == len(source.encode())
    assert source not in wire(record).decode() and "DO_NOT_EXPORT" not in wire(record).decode()


def test_scope_exact_canonical_roundtrip(scope):
    assert diag.parse_diagnostic_scope(wire(scope).decode()) == scope
    assert diag.parse_diagnostic_scope(None) is None and diag.parse_diagnostic_scope("") is None
    with pytest.raises(ValueError): diag.parse_diagnostic_scope(json.dumps(scope))


@pytest.mark.parametrize("mutation", ["extra", "authority", "bad_run", "foreign_schema", "bool_task", "bad_command", "bad_source"])
def test_scope_is_closed_and_exact(scope, mutation):
    if mutation == "extra": scope["extra"] = False
    elif mutation == "authority": scope["execution_authority"] = False
    elif mutation == "bad_run": scope["run_id"] = "admitted-" + "A" * 32
    elif mutation == "foreign_schema": scope["schema"] += "x"
    elif mutation == "bool_task": scope["task_cid"] = False
    elif mutation == "bad_command": scope["command_sha256"] = "b" * 63
    else: scope["producer_source_sha256"] = True
    with pytest.raises(ValueError): diag.validate_diagnostic_scope(scope)


@pytest.mark.parametrize("raw", ["1", "true", "{}", "[]", "x" * 1025, '{"schema":1,"schema":2}', '"' + "雪" * 400 + '"'])
def test_scope_parser_rejects_noncanonical_or_unbounded_enable(raw):
    with pytest.raises(ValueError): diag.parse_diagnostic_scope(raw)


@pytest.mark.parametrize("key", ["claimed_task_cid", "attempt_id"])
@pytest.mark.parametrize("invalid", [False, 0, [], {}, ""])
def test_malformed_outer_ids_never_fall_back_to_inner(scope, result, key, invalid):
    result["implementation_result"].update(task_cid=scope["task_cid"], attempt_id="execution:unit001")
    result[key] = invalid
    with pytest.raises(ValueError): build(scope, result)


@pytest.mark.parametrize("mutation", ["foreign_task", "inner_task", "inner_attempt", "sequence_bool", "write_bool", "deferred_zero", "status_bool", "reason_large", "owner_path"])
def test_completed_pass_join_and_nonboolean_limits(scope, result, mutation):
    if mutation == "foreign_task": result["claimed_task_cid"] = "cid:foreign"
    elif mutation == "inner_task": result["implementation_result"]["task_cid"] = "cid:foreign"
    elif mutation == "inner_attempt": result["implementation_result"]["attempt_id"] = "execution:foreign"
    elif mutation == "write_bool": result["write_count"] = True
    elif mutation == "deferred_zero": result["implementation_result"]["deferred"] = 0
    elif mutation == "status_bool": result["implementation_result"]["status"] = False
    elif mutation == "reason_large": result["implementation_result"]["reason"] = "雪" * 4096
    if mutation == "owner_path":
        with pytest.raises(ValueError):
            diag.build_first_claimed_pass_diagnostic(scope=scope, sequence=1, result=result,
                process_instance_id="process:test", owner_session_id="/private/owner")
    else:
        with pytest.raises(ValueError): build(scope, result, True if mutation == "sequence_bool" else 1)


def test_idle_pass_does_not_create_first_claimed_record(scope):
    assert build(scope, {"unchanged": True, "write_count": 0, "active_task_id": "", "implementation_result": None}) is None


def test_resumed_pass_without_same_pass_cid_refuses_instead_of_stitching(scope, result):
    result.pop("claimed_task_cid")
    with pytest.raises(ValueError): build(scope, result)
    result["implementation_result"]["task_cid"] = scope["task_cid"]
    assert build(scope, result)["claimed_task_cid"] == scope["task_cid"]


def test_exception_chain_exports_no_messages_paths_or_source_lines(monkeypatch):
    import linecache
    monkeypatch.setattr(linecache, "getline", lambda *_, **__: pytest.fail("diagnostics read source lines"))
    try:
        try:
            raise ValueError("do not export private key body /credential α雪")
        except ValueError as cause:
            raise RuntimeError("do not export provider prompt") from cause
    except RuntimeError as error:
        result = diag.safe_exception_diagnostic(error)
    assert [x["exception_type"] for x in result["exceptions"]] == ["RuntimeError", "ValueError"]
    assert all(len(x["frames"]) <= 8 and all("/" not in frame["file"] for frame in x["frames"]) for x in result["exceptions"])
    assert "private key" not in wire(result).decode() and "provider prompt" not in wire(result).decode()
    assert result["settlement_authority"] is False


@pytest.fixture
def router_render_error():
    try:
        raise ValueError("private /owner/key render source α雪")
    except ValueError as error:
        return diag.build_router_render_error(error)


def test_router_render_error_uses_generic_envelope_and_excludes_messages_lines_locals(monkeypatch):
    import linecache
    monkeypatch.setattr(linecache, "getline", lambda *_, **__: pytest.fail("router diagnostic read source lines"))
    monkeypatch.setattr(diag.traceback, "extract_tb", lambda *_, **__: pytest.fail("router diagnostic read source lines"))
    secret_local = "MUST_NOT_EXPORT_LOCAL_KEY"
    try:
        try:
            raise ValueError("private source /owner/key α雪")
        except ValueError as cause:
            raise RuntimeError("private rendered model prompt") from cause
    except RuntimeError as error:
        record = diag.build_router_render_error(error)
    assert secret_local not in wire(record).decode() and "private" not in wire(record).decode()
    assert record["schema"] == "router-implementation-error@2" and record["error_type"] == "RuntimeError"
    diagnostic = record["diagnostic"]
    assert diagnostic["schema"] == "router-render-exception-diagnostic@1"
    assert diagnostic["settlement_authority"] is False and len(diagnostic["exceptions"]) == 2
    assert diagnostic["exceptions"][0]["message_sha256"] == hashlib.sha256(b"private rendered model prompt").hexdigest()
    assert diagnostic["exceptions"][1]["message_sha256"] == hashlib.sha256("private source /owner/key α雪".encode()).hexdigest()
    assert all(len(row["frames"]) <= 8 and all("/" not in frame["file"] for frame in row["frames"])
        for row in diagnostic["exceptions"])
    assert len(wire(record)) <= diag.MAX_RECORD_BYTES


def test_router_render_error_validation_is_independent_and_does_not_change_bridge_schema(router_render_error):
    original = deepcopy(router_render_error)
    checked = diag.validate_router_render_error(router_render_error)
    checked["diagnostic"]["exceptions"][0]["frames"][0]["line"] += 1
    assert router_render_error == original
    bridge = deepcopy(router_render_error["diagnostic"]); bridge["schema"] = diag.BRIDGE_SCHEMA
    assert diag.validate_bridge_unknown_diagnostic(bridge) == bridge
    assert bridge["schema"] == "database-bridge-unknown-diagnostic@1"
    assert router_render_error["diagnostic"]["schema"] == diag.ROUTER_RENDER_SCHEMA
    with pytest.raises(ValueError): diag.validate_bridge_unknown_diagnostic(router_render_error["diagnostic"])


@pytest.mark.parametrize("mutation", ["extra", "legacy_schema", "missing", "error_conflict", "error_bool",
    "error_large", "diagnostic_bridge_schema", "diagnostic_extra", "authority_zero", "raw_message",
    "absolute_file", "bool_line", "too_many_frames", "too_many_exceptions", "bad_digest"])
def test_router_render_error_closed_shapes_and_same_exception_class(router_render_error, mutation):
    record = router_render_error; diagnostic = record["diagnostic"]; row = diagnostic["exceptions"][0]
    if mutation == "extra": record["prompt"] = "not exportable"
    elif mutation == "legacy_schema": record["schema"] = "router-implementation-error@1"
    elif mutation == "missing": record.pop("diagnostic")
    elif mutation == "error_conflict": record["error_type"] = "RuntimeError"
    elif mutation == "error_bool": record["error_type"] = False
    elif mutation == "error_large": record["error_type"] = "E" * 129
    elif mutation == "diagnostic_bridge_schema": diagnostic["schema"] = diag.BRIDGE_SCHEMA
    elif mutation == "diagnostic_extra": diagnostic["execution_authority"] = False
    elif mutation == "authority_zero": diagnostic["settlement_authority"] = 0
    elif mutation == "raw_message": row["message"] = "private body"
    elif mutation == "absolute_file": row["frames"][0]["file"] = "/owner/module.py"
    elif mutation == "bool_line": row["frames"][0]["line"] = True
    elif mutation == "too_many_frames": row["frames"] *= 9
    elif mutation == "too_many_exceptions": diagnostic["exceptions"] *= 5
    else: row["message_sha256"] = "0" * 63
    with pytest.raises(ValueError): diag.validate_router_render_error(record)


@pytest.mark.parametrize("invalid", [None, False, {}, "exception"])
def test_router_render_error_builder_requires_exception(invalid):
    with pytest.raises(ValueError): diag.build_router_render_error(invalid)


def test_router_render_error_refuses_oversized_utf8_message():
    with pytest.raises(ValueError): diag.build_router_render_error(ValueError("雪" * 1400))


def test_router_render_error_cause_and_frame_walk_is_bounded_and_cycle_safe():
    first = ValueError("first")
    chain = first
    for _ in range(5):
        error = RuntimeError("cause")
        error.__cause__ = chain
        chain = error
    record = diag.build_router_render_error(chain)
    assert len(record["diagnostic"]["exceptions"]) == 4
    first.__cause__ = first
    assert len(diag.build_router_render_error(first)["diagnostic"]["exceptions"]) == 1
    def recurse(depth):
        if depth: return recurse(depth - 1)
        raise ValueError("deep")
    try:
        recurse(12)
    except ValueError as error:
        assert len(diag.build_router_render_error(error)["diagnostic"]["exceptions"][0]["frames"]) == 8
    try:
        recurse(66)
    except ValueError as error:
        with pytest.raises(ValueError): diag.build_router_render_error(error)


def test_router_render_error_rejects_custom_mapping_and_schema_aliases(router_render_error):
    class MappingSubclass(dict):
        pass
    class StringSubclass(str):
        pass
    with pytest.raises(ValueError): diag.validate_router_render_error(MappingSubclass(router_render_error))
    router_render_error["schema"] = StringSubclass(diag.ROUTER_ERROR_SCHEMA)
    with pytest.raises(ValueError): diag.validate_router_render_error(router_render_error)
    router_render_error["schema"] = diag.ROUTER_ERROR_SCHEMA
    router_render_error["diagnostic"]["schema"] = StringSubclass(diag.ROUTER_RENDER_SCHEMA)
    with pytest.raises(ValueError): diag.validate_router_render_error(router_render_error)


@pytest.fixture
def exception_diagnostic():
    return {"schema": diag.BRIDGE_SCHEMA, "settlement_authority": False, "exceptions": [{"exception_type": "ValueError",
        "message_sha256": "d" * 64, "frames": [{"file": "module.py", "line": 7, "function": "_native_guard"}]}]}


@pytest.mark.parametrize("mutation", ["unknown", "authority_zero", "many_exceptions", "unknown_exception", "raw_message",
    "many_frames", "absolute_file", "relative_file", "bool_line", "bad_function"])
def test_existing_exception_diagnostic_closed_bounds(exception_diagnostic, mutation):
    value = exception_diagnostic; row = value["exceptions"][0]; frame = row["frames"][0]
    if mutation == "unknown": value["extra"] = False
    elif mutation == "authority_zero": value["settlement_authority"] = 0
    elif mutation == "many_exceptions": value["exceptions"] *= 5
    elif mutation == "unknown_exception": row["extra"] = False
    elif mutation == "raw_message": row["message"] = "secret"
    elif mutation == "many_frames": row["frames"] *= 9
    elif mutation == "absolute_file": frame["file"] = "/private/module.py"
    elif mutation == "relative_file": frame["file"] = "../module.py"
    elif mutation == "bool_line": frame["line"] = True
    else: frame["function"] = "source text with spaces"
    with pytest.raises(ValueError): diag.validate_bridge_unknown_diagnostic(value)


def test_optional_bridge_diagnostic_is_same_pass_not_latest(scope, result, exception_diagnostic):
    result["implementation_result"]["bridge_unknown_diagnostic"] = exception_diagnostic
    record = build(scope, result)
    assert record["bridge_unknown_diagnostic"] == exception_diagnostic
    exception_diagnostic["exceptions"][0]["frames"][0]["line"] = 8
    assert record["bridge_unknown_diagnostic"]["exceptions"][0]["frames"][0]["line"] == 7


def _portal_summary():
    return {"implementation": {"returncode": 1, "deferred": False, "skipped": False,
        "provider_dispatched": False, "provider_call_allowed": False, "attempt_consumed": False,
        "reason": "portal_provider_failed"}}


def test_portal_projection_excludes_unrelated_bodies_and_is_independent(scope, result):
    class UnreadBody:
        def __str__(self):
            pytest.fail("projection inspected an unrelated body")
    summary = _portal_summary()
    summary["output"] = UnreadBody()
    summary["implementation"].update(prompt=UnreadBody(), branch=UnreadBody(), task_id=UnreadBody(),
        implementation_commit=UnreadBody(), validation_result=UnreadBody())
    projection = diag.project_portal_implementation_summary(summary)
    assert set(projection) == diag.PORTAL_IMPLEMENTATION_FIELDS
    assert projection["returncode"] == 1 and projection["provider_dispatched"] is False
    result["implementation_result"]["bridge_portal_implementation"] = projection
    record = build(scope, result)
    assert record["schema"] == "native-dispatch-first-claimed-pass@2"
    assert record["portal_implementation"] == projection
    summary["implementation"]["returncode"] = 75
    projection["returncode"] = 3
    assert record["portal_implementation"]["returncode"] == 1
    assert all(record[key] is False for key in diag.FALSE_FIELDS)


def test_portal_projection_missing_values_are_explicitly_unknown():
    assert diag.project_portal_implementation_summary({}) is None
    empty = diag.project_portal_implementation_summary({"implementation": {}})
    assert empty == {"returncode": None, **{key: None for key in diag.PORTAL_FLAGS},
        "reason": None, "reason_sha256": None, "reason_bytes": 0}


@pytest.mark.parametrize("invalid", [True, False, 1.0, "1", None, [], {}, -(2**31)-1, 2**31])
def test_portal_supplied_returncode_is_exact_bounded_integer(invalid):
    summary = _portal_summary(); summary["implementation"]["returncode"] = invalid
    with pytest.raises(ValueError): diag.project_portal_implementation_summary(summary)


@pytest.mark.parametrize("returncode", [-(2**31), -9, 0, 75, 2**31-1])
def test_portal_returncode_retains_sign_and_exact_value(returncode):
    summary = _portal_summary(); summary["implementation"]["returncode"] = returncode
    assert diag.project_portal_implementation_summary(summary)["returncode"] == returncode


@pytest.mark.parametrize("key", sorted(diag.PORTAL_FLAGS))
