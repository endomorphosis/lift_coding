def test_compact_invocation_requires_projection_and_matches_outer_selection(tmp_path):
    trial = _transport_trial("identifiers")
    trial["supervisor"]["provider_invocations"][0]["intent_requirements_transport"] = "compact"
    path = _receipt(tmp_path, "missing-projection.json", SUPERVISOR, [trial], "full", "identifiers")
    with pytest.raises(ValueError, match="projection"):
        collect(supervisors=[path])


def _compact_trial():
    trial = _transport_trial("identifiers")
    trial["supervisor"]["intent_requirements_transport"] = "compact"
    call = trial["supervisor"]["provider_invocations"][0]
    call["intent_requirements_transport"] = "compact"
    call["public_instruction"] = {
        "schema": "supervisor-public-instruction-inclusion@6",
        "task_cid": "cid:task", "context_cid": "cid:instruction", "manifest_cid": "cid:manifest",
        "task_id": "TASK-1", "artifact_sha256": "e" * 64, "source_sha256": "f" * 64,
        "source_bytes": 50, "block_sha256": "a" * 64, "block_bytes": 6000,
        "intent_requirements": {"requirements_context_cid": "cid:requirements"},
        "intent_requirements_projection": {
            "schema": "supervisor-intent-requirements-projection@1",
            "codec_schema": "supervisor-compact-task-intent-requirements@1",
            "requested_transport": "compact", "transport": "compact",
            "requirements_context_cid": "cid:requirements", "source_sha256": "f" * 64,
            "source_bytes": 50, "expanded_sha256": "b" * 64, "expanded_bytes": 10000,
            "wire_sha256": "c" * 64, "wire_bytes": 4000,
            "expanded_block_bytes": 11000, "selected_block_bytes": 5000,
            "canonical_roundtrip_verified": True, "proof_authority": False,
            "execution_authority": False, "completion_authority": False,
        },
    }
    return trial


def test_compact_measurements_are_retained_without_granting_input_or_token_authority(tmp_path):
    trial = _compact_trial()
    path = _receipt(tmp_path, "compact.json", SUPERVISOR, [trial], "full", "identifiers")
    row = collect(supervisors=[path])["rows"][0]
    observed = row["invocations"][0]["input_observation"]
    assert row["intent_requirements_transport"] == "compact"
    projection = observed["public_instruction"]["intent_requirements_projection"]
    assert projection == trial["supervisor"]["provider_invocations"][0]["public_instruction"]["intent_requirements_projection"]
    assert observed["measurements_are_token_savings"] is False
    assert observed["input_reconstruction_verified_by_receipt_presence"] is False


def test_expanded_provider_planning_and_compact_coding_keep_all_usage_in_the_compact_arm(tmp_path):
    trial = _compact_trial()
    planning = _invocation("planning")
    planning["intent_requirements_transport"] = "expanded"
    trial["supervisor"]["provider_invocations"].insert(0, planning)
    path = _receipt(tmp_path, "provider-planned-compact.json", SUPERVISOR, [trial], "full", "identifiers")
    result = collect(supervisors=[path])
    row = result["rows"][0]
    assert row["intent_requirements_transport"] == "compact"
    assert row["provider_calls"] == 2
    assert row["tokens"]["total_tokens"] == 44
    assert row["invocations"][0]["input_observation"]["intent_requirements_transport"] == "expanded"
    assert result["arm_totals"]["full:identifiers:intent=compact"]["tokens"]["total_tokens"] == 44


@pytest.mark.parametrize("mutation", ["foreign_context", "short_parent", "list_transport", "dict_transport",
    "integer_authority", "benefit_gate", "invocation_mode", "outer_mode"])
def test_compact_projection_cannot_launder_conflicting_measurements_or_controls(tmp_path, mutation):
    trial = _compact_trial()
    call = trial["supervisor"]["provider_invocations"][0]
    instruction = call["public_instruction"]
    projection = instruction["intent_requirements_projection"]
    if mutation == "foreign_context":
        projection["requirements_context_cid"] = "cid:foreign"
    elif mutation == "short_parent":
        instruction["block_bytes"] = projection["selected_block_bytes"] + projection["source_bytes"]
    elif mutation in ("list_transport", "dict_transport"):
        projection["transport"] = [] if mutation == "list_transport" else {}
    elif mutation == "integer_authority":
        projection["proof_authority"] = 0
    elif mutation == "benefit_gate":
        projection["expanded_block_bytes"] = 10001
        projection["selected_block_bytes"] = 10001
        instruction["block_bytes"] = 12000
    elif mutation == "invocation_mode":
        call["intent_requirements_transport"] = "expanded"
    else:
        trial["supervisor"]["intent_requirements_transport"] = "expanded"
    path = _receipt(tmp_path, "conflicting.json", SUPERVISOR, [trial], "full", "identifiers")
    with pytest.raises(ValueError, match="IntentIR|selected"):
        collect(supervisors=[path])


