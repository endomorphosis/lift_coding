@pytest.mark.parametrize("mutation", ["label", "schema", "freshness", "native_hash", "configuration", "authority"])
def test_transport_or_verification_tampering_is_rejected_in_comparison(tmp_path, mutation):
    trial = _transport_trial("native")
    call = trial["supervisor"]["provider_invocations"][0]
    if mutation == "label":
        call["semantic_transport"] = "identifiers"
    elif mutation == "schema":
        call["semantic_context_verification"]["schema"] = "foreign@1"
    elif mutation == "freshness":
        call["semantic_context_verification"]["freshness_checked"] = False
    elif mutation == "native_hash":
        call["semantic_context_verification"]["native_prompt_sha256"] = "f" * 64
    elif mutation == "configuration":
        trial["supervisor"]["semantic_transport"] = "identifiers"
    else:
        call["semantic_context_verification"]["completion_authority"] = True
    receipt = _receipt(tmp_path, "native.json", SUPERVISOR, [trial], "full", "native")
    with pytest.raises(ValueError, match="semantic|transport"):
        collect(supervisors=[receipt])


@pytest.mark.parametrize("changed", ["public_instruction", "doctor_residual_context", "intent_requirements"])
def test_public_requirements_and_residual_advisories_must_match_across_transports(tmp_path, changed):
    trials = [_transport_trial("identifiers"), _transport_trial("native")]
    for trial in trials:
        call = trial["supervisor"]["provider_invocations"][0]
        call["doctor_residual_context"] = {"schema": "doctor-residual-router-context@1",
            "task_cid": "cid:task", "context_cid": "cid:residual", "native_capsule_id": "cid:capsule",
            "artifact_sha256": "c" * 64, "advisory_sha256": "d" * 64, "advisory_bytes": 300}
        call["public_instruction"] = {"schema": "supervisor-public-instruction-inclusion@2",
            "task_cid": "cid:task", "context_cid": "cid:instruction", "manifest_cid": "cid:manifest",
            "task_id": "TASK-1", "artifact_sha256": "e" * 64, "source_sha256": "f" * 64,
            "source_bytes": 50, "block_sha256": "a" * 64, "block_bytes": 80,
            "intent_requirements": {"requirements_context_cid": "cid:requirements", "contract_cid": "cid:contract",
                "graph_cid": "cid:graph", "coverage_cid": "cid:coverage", "planning_receipt_cid": "cid:planning",
                "ledger_sha256": "b" * 64, "requirement_ids": ["r1"], "dependency_requirement_ids": [],
                "prohibition_requirement_ids": [], "raw_prompt": "MUST NOT APPEAR"}}
    identifiers = _receipt(tmp_path, "identifiers.json", SUPERVISOR, [trials[0]], "full", "identifiers")
    native = _receipt(tmp_path, "native.json", SUPERVISOR, [trials[1]], "full", "native")
    matched = collect(supervisors=[identifiers, native])
    assert matched["semantic_transport_comparisons"][0]["contexts_comparable"] is True
    assert "MUST NOT APPEAR" not in json.dumps(matched)
    call = trials[1]["supervisor"]["provider_invocations"][0]
    if changed == "intent_requirements":
        call["public_instruction"]["intent_requirements"]["ledger_sha256"] = "c" * 64
    else:
        call[changed]["block_sha256" if changed == "public_instruction" else "advisory_sha256"] = "c" * 64
    native.write_text(json.dumps({**json.loads(native.read_text()), "trials": [trials[1]]}))
    mismatched = collect(supervisors=[identifiers, native])["semantic_transport_comparisons"][0]
    assert mismatched["status"] == "non_isolated_context_mismatch"
    assert mismatched["contexts_comparable"] is False


def test_cli_supports_two_supervisor_transports_without_baseline(tmp_path, monkeypatch, capsys):
    identifiers = _receipt(tmp_path, "identifiers.json", SUPERVISOR,
        [_transport_trial("identifiers")], "full", "identifiers")
    native = _receipt(tmp_path, "native.json", SUPERVISOR,
        [_transport_trial("native")], "full", "native")
    output = tmp_path / "comparison"
    monkeypatch.setattr(sys, "argv", ["benchmark_comparison", "--supervisor", str(identifiers),
        "--supervisor", str(native), "--output", str(output)])
    main()
    summary = json.loads(capsys.readouterr().out)
    assert summary["retained_trials"] == 2 and summary["comparable_transport_profiles"] == 1
    assert summary["native_codex_baseline_supplied"] is False
    assert json.loads((output / "comparison.json").read_text())["semantic_transport_comparisons"][0]["contexts_comparable"] is True
    assert "identical_recorded_context" in (output / "comparison.md").read_text()


def _controls(path, *, doctor="generic", planning="intent_symbolic", archive="a" * 64):
    value = json.loads(path.read_text())
    value.update(doctor_profile=doctor, planning_strategy=planning)
    for trial in value["trials"]:
        trial["supervisor"].update(doctor_profile=doctor, planning_strategy=planning)
        trial["agent_context"] = {"metadata": {"doctor_profile": doctor, "planning_strategy": planning,
            "runtime_archive_sha256": archive}}
    path.write_text(json.dumps(value))
    return path


@pytest.mark.parametrize("control", ["doctor", "planning", "archive"])
def test_different_execution_controls_do_not_form_a_transport_pair(tmp_path, control):
    identifiers = _controls(_receipt(tmp_path, "identifiers.json", SUPERVISOR,
        [_transport_trial("identifiers")], "full", "identifiers"))
    changed = {"doctor": "header-contract"} if control == "doctor" else (
        {"planning": "direct"} if control == "planning" else {"archive": "b" * 64})
    native = _controls(_receipt(tmp_path, "native.json", SUPERVISOR,
        [_transport_trial("native")], "full", "native"), **changed)
    result = collect(supervisors=[identifiers, native])
    assert len(result["semantic_transport_comparisons"]) == 2
    assert all(pair["status"] == "counterpart_transport_unavailable" for pair in result["semantic_transport_comparisons"])
    assert all(pair["contexts_comparable"] is False for pair in result["semantic_transport_comparisons"])
    assert len(result["arm_totals"]) == 2
    assert "Doctor generic" in markdown(result)


@pytest.mark.parametrize("key,value", [("doctor_profile", "header-contract"), ("doctor_profile", None),
    ("planning_strategy", "direct"), ("planning_strategy", "invented")])
def test_conflicting_or_invalid_controls_are_not_pooled(tmp_path, key, value):
    path = _controls(_receipt(tmp_path, "identifiers.json", SUPERVISOR,
        [_transport_trial("identifiers")], "full", "identifiers"))
    raw = json.loads(path.read_text())
    raw["trials"][0]["supervisor"][key] = value
    path.write_text(json.dumps(raw))
    with pytest.raises(ValueError, match="selected"):
        collect(supervisors=[path])


def test_matching_recorded_bindings_require_successful_model_input_audits(tmp_path):
