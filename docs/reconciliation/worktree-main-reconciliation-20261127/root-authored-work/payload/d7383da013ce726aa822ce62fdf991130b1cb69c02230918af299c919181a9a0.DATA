@pytest.fixture
def validated_wire_projection(monkeypatch):
    """Isolate comparison joins after the separately tested audit validator.

    These scalar fixtures do not claim native replay, materialization, or proof.
    """
    from benchmarks.agent_supervisor.container_coding import terminal_context_audit
    monkeypatch.setattr(terminal_context_audit, "validate_code_retrieval_projection_receipt",
        lambda raw: raw.get("code_retrieval_projection"))


def _wire_trial(mode=None, *, selected="compact", reward=1):
    trial = _transport_trial("native", reward=reward)
    report = trial["supervisor"]
    report.update(code_retrieval_codec="compact", code_retrieval_transport="full")
    call = report["provider_invocations"][0]
    call.update(invocation_id="1" * 32, code_retrieval_codec="compact")
    projection = {"schema": "supervisor-code-retrieval-prompt-projection@2",
        "guidance_version": 2, "selected_transport": selected,
        "proof_authority": False, "execution_authority": False,
        "completion_authority": False, "publication_authority": False}
    if mode is not None:
        report["code_retrieval_wire_delivery"] = call["code_retrieval_wire_delivery"] = mode
    if mode == "materialized":
        projection.update(schema="supervisor-code-retrieval-prompt-projection@3", guidance_version=3,
            wire_delivery={"schema": "supervisor-code-retrieval-wire-delivery@1", "mode": "materialized",
                "path": "/opt/ipfs-supervisor/worker-home/context-wires/" + "1" * 32 + "/" + "c" * 64 + ".json",
                "wire_sha256": "c" * 64, "wire_bytes": 1000, "source_sha256": "d" * 64,
                "native_prompt_sha256": "a" * 64, "owner_custody": False,
                "materialized": selected == "compact", "proof_authority": False,
                "execution_authority": False, "completion_authority": False, "publication_authority": False})
    call["code_retrieval_projection"] = projection
    return trial


def _wire_receipt(tmp_path, name, mode=None, *, selected="compact", reward=1):
    path = _receipt(tmp_path, name, SUPERVISOR, [_wire_trial(mode, selected=selected, reward=reward)], "full", "native")
    value = json.loads(path.read_text())
    value.update(code_retrieval_codec="compact", code_retrieval_transport="full")
    if mode is not None:
        value["code_retrieval_wire_delivery"] = mode
        value["trials"][0]["agent_context"] = {"metadata": {"code_retrieval_wire_delivery": mode}}
    path.write_text(json.dumps(value))
    return path


def test_legacy_and_explicit_inline_wire_controls_keep_original_group_and_deduplicate(tmp_path, validated_wire_projection):
    legacy = _wire_receipt(tmp_path, "legacy.json")
    inline = _wire_receipt(tmp_path, "inline.json", "inline")
    result = collect(supervisors=[legacy, inline])
    assert result["retained_trial_count"] == 1
    row = result["rows"][0]
    assert len(row["source_receipts"]) == 2
    assert row["code_retrieval_wire_delivery"] == "inline"
    assert row["comparison_group"] == "full:native:retrieval=full:code-codec=compact"
    assert row["invocations"][0]["input_observation"]["code_retrieval_wire_delivery"] == "inline"
    assert result["semantic_transport_comparisons"][0]["code_retrieval_wire_delivery"] == "inline"


def test_wire_treatments_separate_same_trial_failures_and_unknown_costs(tmp_path, validated_wire_projection):
    inline = _wire_receipt(tmp_path, "inline.json", "inline")
    materialized = _wire_receipt(tmp_path, "materialized.json", "materialized", reward=0)
    value = json.loads(materialized.read_text())
    trial = value["trials"][0]
    report = trial["supervisor"]
    coding = report["provider_invocations"][0]
    coding.update(status="provider_failed", error_type="TimeoutExpired",
        wire_delivery_cleanup_status="removed", wire_delivery_post_provider_verified=False)
    coding["native_rollout_usage"]["task_complete_observed"] = False
    report["provider_invocations"].insert(0, _invocation("planning"))
    value["trials"].append({"trial": "setup-abort", "exception_type": "SetupError", "supervisor": None})
    value["trial_count"] = 2
    materialized.write_text(json.dumps(value))
    result = collect(supervisors=[inline, materialized])
    assert result["retained_trial_count"] == 3
    assert len(result["semantic_transport_comparisons"]) == 2
    assert set(result["arm_totals"]) == {"full:native:retrieval=full:code-codec=compact",
        "full:native:retrieval=full:code-codec=compact:code-wire=materialized"}
    failed = result["rows"][1]
    assert failed["provider_calls"] == failed["observed_provider_invocations"] == 2
    assert failed["native_usage_complete_observed"] is False
    assert failed["tokens"]["total_tokens"] is None
    assert failed["known_token_subtotals"] == {"input_tokens": 40, "cached_input_tokens": 30,
        "output_tokens": 4, "total_tokens": 44}
    observation = failed["invocations"][1]["input_observation"]
    assert observation["wire_delivery_cleanup_status"] == "removed"
    assert observation["wire_delivery_post_provider_verified"] is False
    assert failed["context_input_audit"]["all_observed_coding_inputs_verified"] is True
    assert observation["input_reconstruction_verified_by_receipt_presence"] is False
    costs = result["unsuccessful_attempt_costs"][failed["comparison_group"]]
    assert costs["trials"] == 2
    assert costs["known_token_subtotals"]["total_tokens"] == 44
    assert costs["tokens"]["total_tokens"] is None
    assert costs["unknown_token_trials"]["total_tokens"] == 2
    assert "materialized code retrieval wire" in markdown(result)
    assert "MUST NOT APPEAR" not in json.dumps(result)


def test_materialized_control_preserves_unmaterialized_expanded_fallback(tmp_path, validated_wire_projection):
    path = _wire_receipt(tmp_path, "fallback.json", "materialized", selected="expanded")
    row = collect(supervisors=[path])["rows"][0]
    observed = row["invocations"][0]["input_observation"]
    assert row["code_retrieval_wire_delivery"] == "materialized"
    assert observed["code_retrieval_projection"]["selected_transport"] == "expanded"
    assert observed["code_retrieval_projection"]["wire_delivery"]["materialized"] is False
    assert observed["wire_delivery_cleanup_status"] is None
    assert observed["wire_delivery_post_provider_verified"] is None
    assert row["tokens"]["total_tokens"] == 22


@pytest.mark.parametrize("location", ["receipt", "report", "metadata", "invocation"])
@pytest.mark.parametrize("invalid", [None, False, [], "unknown"])
def test_invalid_wire_control_is_never_a_missing_legacy_control(tmp_path, validated_wire_projection, location, invalid):
    path = _wire_receipt(tmp_path, "invalid-wire.json", "inline")
    value = json.loads(path.read_text())
    trial = value["trials"][0]
    places = {"receipt": value, "report": trial["supervisor"], "metadata": trial["agent_context"]["metadata"],
        "invocation": trial["supervisor"]["provider_invocations"][0]}
    places[location]["code_retrieval_wire_delivery"] = invalid
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="wire.delivery|wire_delivery"):
        collect(supervisors=[path])


@pytest.mark.parametrize("location", ["receipt", "report", "metadata"])
def test_conflicting_outer_and_actual_wire_controls_are_rejected(tmp_path, validated_wire_projection, location):
    path = _wire_receipt(tmp_path, "conflicting-wire.json", "materialized")
    value = json.loads(path.read_text())
    trial = value["trials"][0]
    places = {"receipt": value, "report": trial["supervisor"], "metadata": trial["agent_context"]["metadata"]}
    places[location]["code_retrieval_wire_delivery"] = "inline"
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="conflicting.*wire_delivery"):
        collect(supervisors=[path])


@pytest.mark.parametrize("selected", ["compact", "expanded"])
def test_materialized_control_cannot_relabel_a_legacy_inline_projection(tmp_path, validated_wire_projection, selected):
    path = _wire_receipt(tmp_path, "legacy-relabel.json", "materialized", selected=selected)
    value = json.loads(path.read_text())
    projection = value["trials"][0]["supervisor"]["provider_invocations"][0]["code_retrieval_projection"]
    projection.update(schema="supervisor-code-retrieval-prompt-projection@2", guidance_version=2)
    projection.pop("wire_delivery")
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="wire delivery conflicts"):
        collect(supervisors=[path])


def test_materialized_projection_needs_its_actual_invocation_control(tmp_path, validated_wire_projection):
    path = _wire_receipt(tmp_path, "missing-actual-control.json", "materialized")
    value = json.loads(path.read_text())
    value["trials"][0]["supervisor"]["provider_invocations"][0].pop("code_retrieval_wire_delivery")
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="wire delivery conflicts"):
        collect(supervisors=[path])


def test_materialized_actual_coding_control_needs_a_projection(tmp_path, validated_wire_projection):
    path = _wire_receipt(tmp_path, "missing-materialized-projection.json", "materialized")
    value = json.loads(path.read_text())
    value["trials"][0]["supervisor"]["provider_invocations"][0].pop("code_retrieval_projection")
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="lacks its projection"):
        collect(supervisors=[path])


@pytest.mark.parametrize("changed", [{"arm": "no-index"}, {"semantic_transport": "identifiers"},
    {"code_retrieval_transport": "frontier"}, {"code_retrieval_codec": "expanded"}])
def test_materialized_control_requires_native_full_compact_profile(tmp_path, changed):
    report = {"semantic_transport": "native", "code_retrieval_transport": "full",
        "code_retrieval_codec": "compact", "code_retrieval_wire_delivery": "materialized"}
    value = {"arm": "full", **report, **changed}
    path = _receipt(tmp_path, "invalid-profile.json", SUPERVISOR,
        [{"trial": "not-dispatched", "supervisor": {k: v for k, v in value.items() if k != "arm"}}],
        value["arm"], value["semantic_transport"])
    receipt = json.loads(path.read_text())
    receipt.update({k: v for k, v in value.items() if k != "arm"})
    path.write_text(json.dumps(receipt))
    with pytest.raises(ValueError, match="requires.*native|requires.*indexed"):
        collect(supervisors=[path])


@pytest.mark.parametrize("field,invalid", [("wire_delivery_cleanup_status", None),
    ("wire_delivery_cleanup_status", False), ("wire_delivery_cleanup_status", "unknown"),
    ("wire_delivery_post_provider_verified", None), ("wire_delivery_post_provider_verified", 0),
    ("wire_delivery_post_provider_verified", "true")])
def test_wire_lifecycle_observations_are_strict_scalars(tmp_path, validated_wire_projection, field, invalid):
    path = _wire_receipt(tmp_path, "invalid-lifecycle.json", "materialized")
    value = json.loads(path.read_text())
    value["trials"][0]["supervisor"]["provider_invocations"][0][field] = invalid
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="wire delivery.*observation"):
        collect(supervisors=[path])


@pytest.mark.parametrize("mode,selected", [("inline", "compact"), ("materialized", "expanded")])
@pytest.mark.parametrize("field,observed", [("wire_delivery_cleanup_status", "removed"),
    ("wire_delivery_post_provider_verified", False)])
def test_wire_lifecycle_fields_cannot_claim_a_handle_for_inline_or_fallback(tmp_path, validated_wire_projection, mode, selected, field, observed):
    path = _wire_receipt(tmp_path, "no-handle.json", mode, selected=selected)
    value = json.loads(path.read_text())
    value["trials"][0]["supervisor"]["provider_invocations"][0][field] = observed
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="wire delivery.*observation"):
        collect(supervisors=[path])


@pytest.mark.parametrize("cleanup", ["removed", "failed"])
def test_materialized_cleanup_failures_remain_observations_without_authority(tmp_path, validated_wire_projection, cleanup):
    path = _wire_receipt(tmp_path, "cleanup.json", "materialized", reward=0)
    value = json.loads(path.read_text())
    call = value["trials"][0]["supervisor"]["provider_invocations"][0]
    call.update(wire_delivery_cleanup_status=cleanup, wire_delivery_post_provider_verified=False,
        status="provider_failed", error_type="ProviderError")
    path.write_text(json.dumps(value))
    row = collect(supervisors=[path])["rows"][0]
    observation = row["invocations"][0]["input_observation"]
    assert observation["wire_delivery_cleanup_status"] == cleanup
    assert observation["wire_delivery_post_provider_verified"] is False
    assert row["invocations"][0]["error_type"] == "ProviderError"
    assert row["tokens"]["total_tokens"] == 22
    delivery = observation["code_retrieval_projection"]["wire_delivery"]
    assert all(delivery[key] is False for key in ("owner_custody", "proof_authority", "execution_authority",
        "completion_authority", "publication_authority"))


@pytest.mark.parametrize("changed", ["mode", "cleanup", "post_provider"])
def test_conflicting_actual_invocation_identity_cannot_pool_wire_observations(tmp_path, validated_wire_projection, changed):
    path = _wire_receipt(tmp_path, "duplicate-call.json", "materialized")
    value = json.loads(path.read_text())
    report = value["trials"][0]["supervisor"]
    call = report["provider_invocations"][0]
    call.update(wire_delivery_cleanup_status="removed", wire_delivery_post_provider_verified=True)
    duplicate = json.loads(json.dumps(call))
    if changed == "mode":
        duplicate["code_retrieval_wire_delivery"] = "inline"
    elif changed == "cleanup":
        duplicate["wire_delivery_cleanup_status"] = "failed"
    else:
        duplicate["wire_delivery_post_provider_verified"] = False
    report["provider_invocations"].append(duplicate)
    path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="conflicting provider invocation"):
        collect(supervisors=[path])


def test_conflicting_retained_wire_lifecycle_observations_are_not_deduplicated(tmp_path, validated_wire_projection):
    first = _wire_receipt(tmp_path, "first.json", "materialized")
    second = _wire_receipt(tmp_path, "second.json", "materialized")
    for path, status in [(first, "removed"), (second, "failed")]:
        value = json.loads(path.read_text())
        value["trials"][0]["supervisor"]["provider_invocations"][0]["wire_delivery_cleanup_status"] = status
        path.write_text(json.dumps(value))
    with pytest.raises(ValueError, match="conflicting retained trial identity"):
        collect(supervisors=[first, second])
