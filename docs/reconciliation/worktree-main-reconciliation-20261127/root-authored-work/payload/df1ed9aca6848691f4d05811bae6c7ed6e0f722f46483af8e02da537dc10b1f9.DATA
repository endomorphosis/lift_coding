"""Concrete evidence production and independent artifact revalidation."""
from __future__ import annotations
import itertools
import json
import time
from pathlib import Path
import z3
from common import PROCEDURES, Artifacts, canonical, cid, query_identity, frozen_guard, independent_decision, original_catalog, read, replay_exact, saved_candidate, sha, validate_query, write_new

CHECK_OPERATIONS = ("RUN_SELECTED_TESTS", "RUN_STATIC_ANALYSIS", "RUN_TYPE_CHECK")

def symbolic_proof(procedure):
    """Solver checks a declared bounded logical contract, not Python semantics."""
    rows = []
    operations = [step.operation.value for step in procedure.steps]
    if sorted(operations) != sorted(("READ_STATE", *CHECK_OPERATIONS, "CHECK_POSTCONDITION", "EMIT_RECEIPT")):
        raise ValueError("proof expects the exact closed selected operation set")
    for length in range(7):
        values = [z3.Int("value_" + str(i)) for i in range(length)]
        kinds = [z3.Int("kind_" + str(i)) for i in range(length)]
        budget = z3.Int("budget")
        all_int = z3.And(*[kind == 0 for kind in kinds])
        total = z3.Sum(values) if values else z3.IntVal(0)
        meanings = {"RUN_SELECTED_TESTS": total <= budget,
                    "RUN_STATIC_ANALYSIS": z3.And(*[z3.And(v >= 0, v <= 7) for v in values]),
                    "RUN_TYPE_CHECK": all_int}
        selected = z3.And(*[meanings[name] for name in operations if name in meanings])
        # Independent bad-witness encoding of the desired predicate.
        bad = z3.Or(*[z3.Or(kind != 0, value < 0, value > 7) for kind, value in zip(kinds, values)])
        specification = z3.Not(z3.Or(bad, total > budget))
        solver = z3.Solver(); solver.set(timeout=10000)
        solver.add(budget >= -1, budget <= 25)
        for kind, value in zip(kinds, values): solver.add(kind >= 0, kind <= 3, value >= -2, value <= 9)
        solver.add(selected != specification)
        statement = solver.to_smt2(); outcome = str(solver.check())
        if outcome != "unsat": raise ValueError("bounded logical decision proof failed: " + outcome)
        rows.append({"length": length, "smt2": statement, "result": outcome})
    return {"solver": "Z3", "version": z3.get_full_version(), "rows": rows,
            "domain": {"lengths": list(range(7)), "integer_values": [-2, 9], "budgets": [-1, 25], "kind_tags": {"integer": 0, "boolean": 1, "float": 2, "string": 3}},
            "scope": "Symbolic operation-contract equivalence under declared bounds. Concrete frozen Python catalog bridge is separate evidence; no arbitrary-Python execution theorem."}

def verify_symbolic_proof(payload, procedure):
    expected = symbolic_proof(procedure)
    if payload != expected: raise ValueError("proof artifact differs from independently reconstructed statements/results")
    for row in payload["rows"]:
        solver = z3.Solver(); solver.set(timeout=10000); solver.from_string(row["smt2"])
        if str(solver.check()) != "unsat": raise ValueError("retained proof statement failed independent solver replay")

def evaluated_rows(procedure, corpus, catalog):
    rows = []
    for query in corpus:
        validate_query(query)
        before = canonical(query); observed, trace = replay_exact(procedure, query, catalog)
        expected = independent_decision(json.loads(before))
        if canonical(query) != before: raise ValueError("read-only evidence execution changed query")
        if observed != expected: raise ValueError("concrete candidate disagrees with independent decision")
        rows.append({"query_cid": query_identity(query), "observed": observed, "expected": expected, "trace": trace})
    return rows

def expected_artifacts(run, timings=None):
    run = Path(run); frozen = frozen_guard(run); candidate, source_row, counterexamples = saved_candidate()
    corpus = read(run / "corpora.json")
    catalog = original_catalog(); common = {"bindings": candidate.bindings.to_dict(), "procedure_cid": candidate.procedure.content_id,
        "candidate_cid": candidate.content_id, "freeze_sha256": sha((run / "freeze.json").read_bytes()),
        "source_manifest_sha256": sha(canonical(frozen["sources_sha256"]))}
    artifacts = {}
    started=time.perf_counter()
    proof = {"schema": "ns-procedure-bounded-proof/v1", "kind": "proof", "contract_id": "bounded-symbolic-sequence-decision@1", **common,
             "proof": symbolic_proof(candidate.procedure), "concrete_bridge": evaluated_rows(candidate.procedure, corpus["proof_bridge"], catalog),
             "corpus_sha256": sha(canonical(corpus["proof_bridge"]))}
    artifacts["proof"] = proof
    if timings is not None: timings["proof_and_concrete_bridge_seconds"]=time.perf_counter()-started
    for kind in ("test", "adversarial", "held_out", "shadow"):
        started=time.perf_counter()
        artifacts[kind] = {"schema": "ns-procedure-concrete-evaluation/v1", "kind": kind,
            "contract_id": "sequence-budget@1" if kind == "test" else "bounded-" + kind + "-evaluation@1", **common,
            "corpus_sha256": sha(canonical(corpus[kind])), "rows": evaluated_rows(candidate.procedure, corpus[kind], catalog),
            "scope": "Fresh prospectively frozen constructed inputs after original development; disjoint from original exposed inputs; no population-level claim. Shadow is independent pre-certificate read-only candidate replay."}
        if timings is not None: timings[kind+"_seconds"]=time.perf_counter()-started
    artifacts["specification"] = {"schema": "ns-procedure-specification-evidence/v1", "kind": "specification", **common,
        "predicate": "Closed dict(values:list, budget:int); accept iff each value is an exact int in0..7 and sum<=budget. Scope lengths0..6, integer values-2..9, budgets-1..25; nonint supported JSON values reject.",
        "independent_predicate_source": frozen["sources_sha256"][str(Path(__file__).with_name("common.py"))]}
    artifacts["source_episode"] = {"schema": "ns-procedure-original-source-alias-bindings/v1", "kind": "source_episode", **common,
        "legacy_aliases": list(candidate.source_episode_cids), "saved_synthesis_sha256": frozen["sources_sha256"][str(PROCEDURES / "results/cold_synthesis-prime.json")],
        "candidate_artifact_index": 0, "catalog_source_sha256": candidate.bindings.repository_commit,
        "scope": "Exact retained original synthesis/source artifacts map legacy identifiers; aliases are not newly minted content-addressed execution episodes."}
    artifacts["counterexample_set"] = {"schema": "ns-procedure-original-counterexample-binding/v1", "kind": "counterexample_set", **common,
        "native_counterexample_set_cid": counterexamples.content_id, "native_members": [member.to_facts() for member in counterexamples.members],
        "saved_artifacts": source_row["synthesis"]["counterexamples"]}
    return candidate, artifacts

def produce(run):
    run = Path(run); timings={}; _, artifacts = expected_artifacts(run, timings); store = Artifacts(run / "evidence_objects")
    started=time.perf_counter()
    manifest = {kind: store.put(item) for kind, item in artifacts.items()}
    write_new(run / "evidence_manifest.json", manifest)
    timings["artifact_persistence_seconds"]=time.perf_counter()-started
    write_new(run / "evidence_production_costs.json",timings)
    frozen_guard(run)
    return manifest

def validate_manifest(manifest, store, expected):
    if set(manifest) != {"proof", "test", "adversarial", "held_out", "shadow", "specification", "source_episode", "counterexample_set"}: raise ValueError("closed complete evidence manifest required")
    if len(set(manifest.values())) != 8: raise ValueError("evidence kinds need distinct artifact identities")
    admitted = {}
    for kind, identity in manifest.items():
        item = store.get(identity)
        if canonical(item) != canonical(expected[kind]): raise ValueError("complete actual evidence payload mismatch: " + kind)
        admitted[kind] = item
    return admitted

def admit_artifacts(run):
    """Fresh reader executes source and independent oracle before artifact admission."""
    run = Path(run); candidate, expected = expected_artifacts(run)
    manifest = read(run / "evidence_manifest.json"); store = Artifacts(run / "evidence_objects")
    admitted = validate_manifest(manifest, store, expected)
    verify_symbolic_proof(admitted["proof"]["proof"], candidate.procedure)
    return candidate, manifest, admitted

def negative_controls(run, manifest, expected):
    """Independent clone mutations exercise admission without changing originals."""
    class Clone:
        def __init__(self): self.bodies = {cid(value): canonical(value) for value in expected.values()}
        def get(self, identity):
            body = self.bodies[identity]; item = json.loads(body)
            if cid(item) != identity or canonical(item) != body: raise ValueError("altered CID bytes")
            return item
    rows = []
    def reject(name, changed, clone):
        try: validate_manifest(changed, clone, expected)
        except (ValueError, KeyError) as exc: rows.append({"control": name, "rejected": True, "reason": str(exc)})
        else: raise ValueError("negative evidence control unexpectedly admitted: " + name)
    for kind in manifest:
        altered = dict(manifest); del altered[kind]; reject("missing-"+kind, altered, Clone())
        clone=Clone(); clone.bodies[manifest[kind]] += b" "; reject("changed-bytes-"+kind, manifest, clone)
        item=json.loads(canonical(expected[kind])); item["freeze_sha256"]="0"*64
        clone=Clone(); identity=cid(item); clone.bodies[identity]=canonical(item); altered=dict(manifest);altered[kind]=identity
        reject("reminted-stale-source-"+kind,altered,clone)
    altered=dict(manifest);altered["held_out"],altered["test"]=altered["test"],altered["held_out"]
    reject("cross-kind",altered,Clone())
    for kind in ("proof", "test", "adversarial", "held_out", "shadow"):
        item=json.loads(canonical(expected[kind])); key="concrete_bridge" if kind=="proof" else "rows"
        item[key][0]["observed"]=not item[key][0]["observed"]
        clone=Clone();identity=cid(item);clone.bodies[identity]=canonical(item);altered=dict(manifest);altered[kind]=identity
        reject("reminted-false-result-"+kind,altered,clone)
    write_new(Path(run)/"evidence_negative_controls.json",rows)
