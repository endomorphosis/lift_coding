"""Execute one admitted Terminal-Bench task inside the deployed container.

Called as the nonroot supervisor owner. All model and candidate-code execution
goes through separately deployed worker-identity launchers. The original Harbor
verifier runs afterwards and remains outside this process's indexed context.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
from pathlib import Path
import shlex
import signal
import stat
import subprocess
import time
import uuid

from benchmarks.agent_supervisor.container_coding import terminal_indexed_preparation as preparation
from benchmarks.agent_supervisor.container_coding import terminal_source_nomination_budget as active_budget
from benchmarks.agent_supervisor.container_coding.full_supervisor_benchmark import (
    _capture_source_nomination_review, _source_nomination_observation,
    _validate_code_retrieval_codec, _validate_code_retrieval_transport,
    _validate_code_retrieval_wire_delivery, _validate_intent_requirements_transport,
)
from benchmarks.agent_supervisor.container_coding.native_quack_qualification import open_existing_native_owner
from benchmarks.agent_supervisor.container_coding.terminal_doctor_dispatch import (
    implementation_argv, prepare_terminal_doctor_dispatch,
)
from ipfs_accelerate_py.agent_supervisor.entrypoints.admitted_benchmark_runtime import AdmittedBenchmarkRuntime
from ipfs_accelerate_py.agent_supervisor.runtime.local_planning_admission import verify_local_benchmark_admission
from ipfs_accelerate_py.agent_supervisor.task_sources.task_execution_route_policy import GROK_CODEX_EXECUTION_MODE

ROOT = Path("/opt/ipfs-supervisor")
ROUTER = ROOT / "bin/router-worker"
VALIDATOR = ROOT / "bin/validation-worker"
WORKTREES = ROOT / "worktrees"


def _doctor_contract_profile(arm: str, doctor_profile: str) -> str | None:
    """Select the native Doctor gate while preserving its candidate/residual routes."""
    if type(doctor_profile) is not str or doctor_profile not in {"header-contract", "generic"}:
        raise ValueError("unknown Doctor profile")
    if doctor_profile == "generic" and arm != "full":
        raise ValueError("generic Doctor profile requires the full indexed arm")
    return "wsgi-header-controls@1" if doctor_profile == "header-contract" else None


def _write(path: Path, value):
    path.write_text(json.dumps(value, sort_keys=True, indent=2) + "\n")


def _arm_cleanup_deadline(deadline: float) -> None:
    """Replace the work alarm with the bounded cleanup window.

    STOP can begin just before the work deadline or while unwinding that
    deadline's exception. In either case the work alarm must not cut short
    the separately reserved shutdown budget. Leave two seconds for the final
    result before the caller's total deadline.
    """
    signal.setitimer(signal.ITIMER_REAL, max(.001, deadline - time.monotonic() - 2))


def _router_reply(stdout: str) -> tuple[str, dict]:
    lines = stdout.splitlines()
    matches = []
    for index, line in enumerate(lines):
        try:
            value = json.loads(line)
        except ValueError:
            continue
        if isinstance(value, dict) and value.get("schema") == "router-implementation-invocation@1":
            matches.append((index, value))
    if len(matches) != 1:
        raise ValueError("worker did not return exactly one router invocation receipt")
    index, receipt = matches[0]
    if not receipt.get("external_container_boundary"):
        raise ValueError("worker receipt lacks the qualified container identity")
    return "\n".join(lines[index + 1:]).strip(), receipt


def _pre_dispatch_refusal(item: dict) -> dict | None:
    """Retain bounded diagnostics without treating a planned prompt as input."""
    if (item.get("schema") != "router-implementation-pre-dispatch-refusal@1"
            or item.get("purpose") != "coding" or item.get("status") != "failed"
            or type(item.get("router_calls")) is not int or item["router_calls"] != 0
            or type(item.get("invocation_id")) is not str
            or re.fullmatch(r"[0-9a-f]{32}", item["invocation_id"]) is None
            or item.get("completion_authority") is not False
            or item.get("usage") is not None or item.get("native_rollout_usage") is not None):
        return None
    controls = {
        "semantic_transport": {"identifiers", "native", "none"},
        "intent_requirements_transport": {"expanded", "compact"},
        "code_retrieval_codec": {"expanded", "compact"},
        "code_retrieval_wire_delivery": {"inline", "materialized"},
    }
    if any(type(item.get(key)) is not str or item[key] not in choices
            for key, choices in controls.items()):
        return None
    if (item["semantic_transport"] != "native" or item["code_retrieval_codec"] != "compact"
            or item["code_retrieval_wire_delivery"] != "materialized"):
        return None
    safe = {"schema": item["schema"], "phase": "coding", "purpose": "coding",
        "invocation_id": item["invocation_id"], "status": "failed", "router_calls": 0,
        "completion_authority": False, **{key: item[key] for key in controls}}
    for prefix in ("native_prompt", "router_prompt", "model_prompt"):
        digest, count = item.get(prefix + "_sha256"), item.get(prefix + "_bytes")
        if (type(digest) is not str or re.fullmatch(r"[0-9a-f]{64}", digest) is None
                or type(count) is not int or not 0 < count <= 256_000):
            return None
        safe.update({prefix + "_sha256": digest, prefix + "_bytes": count})
    instruction, projection = item.get("public_instruction"), item.get("code_retrieval_projection")
    if type(instruction) is not dict or type(projection) is not dict:
        return None
    for key, digest in (("public_source_sha256", instruction.get("source_sha256")),
                        ("wire_sha256", projection.get("wire_sha256"))):
        if type(digest) is not str or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
            return None
        safe[key] = digest
    wire_bytes = projection.get("wire_bytes")
    if type(wire_bytes) is not int or not 0 < wire_bytes <= 512_000:
        return None
    safe["wire_bytes"] = wire_bytes
    error_type = item.get("error_type")
    if type(error_type) is not str or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,127}", error_type) is None:
        return None
    safe["error_type"] = error_type
    try:
        canonical = json.dumps(item, sort_keys=True, separators=(",", ":"),
            ensure_ascii=False, allow_nan=False).encode("utf-8")
    except (TypeError, ValueError, UnicodeError):
        return None
    safe["receipt_sha256"] = hashlib.sha256(canonical).hexdigest()
    return safe


def _collect_worker_receipts(report: dict, state: Path) -> None:
    """Collect actual calls and separate safe pre-dispatch refusal receipts."""
    seen = {item["invocation_id"] for item in report["provider_invocations"]}
    refusals = report.setdefault("pre_dispatch_refusals", [])
    report.pop("model_input_observations", None)
    report.pop("model_input_observation_refusals", None)
    observation_ids = {}
    conflicting_observations = set()
    diagnostic_errors = None
    diagnostic_errors_truncated = False
    diagnostic_records = {}
    diagnostic_records_truncated = False
    if (report.get("source_nomination_phase") == "resume"
            and report.get("source_nomination_controls", {}).get("observe_model_input_only") is True):
        diagnostic_errors = set()
        report.pop("model_input_worker_error_diagnostics", None)
    def observation_error(reason):
        errors = report.setdefault("model_input_observation_errors", [])
        if len(errors) < 16 and reason not in errors:
            errors.append(reason)
    for path in state.rglob("*.log"):
        if path.stat().st_size > 8_000_000:
            continue
        for line in path.read_text(errors="replace").splitlines():
            try:
                item = json.loads(line)
            except ValueError:
                continue
            if (isinstance(item, dict) and item.get("schema") == "router-implementation-invocation@1"
                    and item.get("invocation_id") not in seen):
                report["provider_invocations"].append({"phase": "coding", **item})
                seen.add(item["invocation_id"])
            elif (isinstance(item, dict) and type(item.get("schema")) is str
                    and item["schema"] in {"supervisor-model-input-observation@1", "supervisor-model-input-observation@2"}):
                from ipfs_accelerate_py.agent_supervisor.runtime.model_input_observation_receipt import validate_model_input_observation
                try:
                    observed = validate_model_input_observation(item)
                except (ValueError, TypeError, KeyError):
                    observation_error("invalid_observation_receipt")
                    continue
                if (report.get("source_nomination_phase") != "resume"
                        or report.get("source_nomination_controls", {}).get("observe_model_input_only") is not True):
                    observation_error("observation_mode_not_requested")
                    continue
                if any(key in report and observed[key] != report[key] for key in (
                        "semantic_transport", "intent_requirements_transport",
                        "code_retrieval_codec", "code_retrieval_wire_delivery")):
                    observation_error("observation_controls_differ")
                    continue
                if (Path(observed["workspace"]) == WORKTREES
                        or not Path(observed["workspace"]).is_relative_to(WORKTREES)):
                    observation_error("observation_workspace_differ")
                    continue
                task_cids = [report.get(key, {}).get("task_cid") for key in (
                    "context", "doctor_dispatch", "public_instruction")]
                if any(task_cid is not None and observed["public_instruction"]["task_cid"] != task_cid
                       for task_cid in task_cids):
                    observation_error("observation_task_differ")
                    continue
                identity = observed["observation_id"]
                if identity in conflicting_observations:
                    continue
                if identity in observation_ids and observation_ids[identity] != observed:
                    conflicting_observations.add(identity)
                    observation_ids.pop(identity)
                    observation_error("conflicting_observation_identity")
                elif len(observation_ids) >= 16 and identity not in observation_ids:
                    observation_error("observation_population_exceeds_bound")
                else:
                    observation_ids[identity] = observed
            elif (diagnostic_errors is not None and type(item) is dict
                    and item.get("schema") == "router-implementation-error@2"):
                from ipfs_accelerate_py.agent_supervisor.runtime.native_dispatch_diagnostics import validate_router_render_error
                try:
                    safe_error = validate_router_render_error(item)
                except (ValueError, TypeError, KeyError):
                    continue
                error_type = safe_error["error_type"]
                if len(diagnostic_errors) < 16 or error_type in diagnostic_errors:
                    diagnostic_errors.add(error_type)
                else:
                    diagnostic_errors_truncated = True
                    diagnostic_records_truncated = True
                    continue
                identity = json.dumps(safe_error, sort_keys=True, separators=(",", ":"))
                if len(diagnostic_records) < 16 or identity in diagnostic_records:
                    diagnostic_records[identity] = safe_error
                else:
                    diagnostic_records_truncated = True
            elif (diagnostic_errors is not None and type(item) is dict
                    and set(item) == {"schema", "error_type"}
                    and item["schema"] == "router-implementation-error@1"
                    and type(item["error_type"]) is str
                    and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,127}", item["error_type"])):
                # This existing scan already parses the line. Export only its
                # closed class field; a log record is not a scoped worker birth.
                if len(diagnostic_errors) < 16 or item["error_type"] in diagnostic_errors:
                    diagnostic_errors.add(item["error_type"])
                else:
                    diagnostic_errors_truncated = True
            elif isinstance(item, dict) and item.get("schema") == "router-implementation-pre-dispatch-refusal@1":
                safe = _pre_dispatch_refusal(item)
                if (safe is not None and safe not in refusals and all(
                        key not in report or safe[key] == report[key] for key in (
                            "semantic_transport", "intent_requirements_transport",
                            "code_retrieval_codec", "code_retrieval_wire_delivery"))):
                    refusals.append(safe)
            elif (isinstance(item, dict) and type(item.get("schema")) is str and item.get("schema") in {
                    "native-doctor-candidate-materialization@1", "native-doctor-contract-candidate-materialization@1"}
                  and item.get("task_cid") == report.get("doctor_dispatch", {}).get("task_cid")):
                if item not in report.setdefault("doctor_invocations", []):
                    report["doctor_invocations"].append(item)
    if observation_ids.keys() & seen:
        observation_error("observation_identity_conflicts_with_provider")
        observation_ids = {key: value for key, value in observation_ids.items() if key not in seen}
    if observation_ids:
        for status, key in (("observed", "model_input_observations"),
                            ("refused", "model_input_observation_refusals")):
            rows = [value for value in observation_ids.values() if value["status"] == status]
            if rows:
                report[key] = rows
    if diagnostic_errors:
        report["model_input_worker_error_diagnostics"] = {
            "schema": "terminal-model-input-worker-error-diagnostics@1",
            "status": "observed_unattributed_router_errors", "error_types": sorted(diagnostic_errors),
            "error_types_truncated": diagnostic_errors_truncated,
            "source_scope_matched": False, "worker_birth_established": False,
            "provider_population_complete": False, "provider_transmission_verified": False,
            "provider_usage_measured": False, "proof_authority": False,
            "execution_authority": False, "completion_authority": False,
            "raw_messages_or_prompts_exported": False,
        }
        if diagnostic_records:
            report["model_input_worker_error_diagnostics"].update(
                schema="terminal-model-input-worker-error-diagnostics@2",
                error_records=[diagnostic_records[key] for key in sorted(diagnostic_records)],
                error_records_truncated=diagnostic_records_truncated)


def _collect_native_dispatch_diagnostics(runtime, report: dict) -> None:
    """Observe one protected first-pass record; never reconcile its callback."""
    if (report.get("source_nomination_phase") != "resume"
            or report.get("source_nomination_controls", {}).get("observe_model_input_only") is not True):
        return
    observed = {"schema": "terminal-native-dispatch-diagnostics@1", "status": "unknown",
        "reason": "first_claimed_pass_unavailable", "first_claimed_pass": None,
        "source_scope_matched": False, "provider_population_complete": False,
        "provider_transmission_verified": False, "provider_usage_measured": False,
        "task_progress_authority": False, "proof_authority": False,
        "execution_authority": False, "completion_authority": False,
        "raw_messages_or_prompts_exported": False}
    try:
        from ipfs_accelerate_py.agent_supervisor.runtime.native_dispatch_diagnostics import (
            ENV, read_first_claimed_pass_diagnostic, validate_diagnostic_scope)
        from ipfs_accelerate_py.agent_supervisor.entrypoints.isolated_benchmark_runtime import _digest
        scope = validate_diagnostic_scope(runtime.manifest["native_dispatch_diagnostic_scope"])
        if _digest(runtime.manifest) != runtime.manifest_id:
            raise ValueError("native diagnostic launch grant changed")
        declared = [value for key, value in runtime.manifest["environment"] if key == ENV]
        if len(declared) != 1 or json.loads(declared[0]) != scope or scope["run_id"] != runtime.run_id:
            raise ValueError("native diagnostic scope differs from signed launch environment")
        task_cid = report.get("doctor_dispatch", {}).get("task_cid")
        if task_cid is not None and scope["task_cid"] != task_cid:
            raise ValueError("native diagnostic scope differs from admitted task")
        record = read_first_claimed_pass_diagnostic(run_root=runtime.state / "run", expected_scope=scope)
        if record is not None:
            observed.update(status="observed_first_claimed_pass", reason="protected_scoped_record_matched",
                first_claimed_pass=record, source_scope_matched=True)
    except Exception as error:
        observed.update(reason="first_claimed_pass_invalid_or_unavailable", error_type=type(error).__name__[:128])
    report["native_dispatch_diagnostics"] = observed


def _native_diagnostics(state: Path) -> dict:
    """Retain bounded startup evidence, without prompts or owner credentials."""
    result = {"schema": "native-supervisor-diagnostics@1"}
    logs = []
    paths = [state / "supervisor-process.log", *sorted(
        (state / "run").glob("admitted_managed_daemon*.log"))[-8:]]
    for path in paths:
        if not path.is_file() or path.is_symlink():
            continue
        with path.open("rb") as stream:
            stream.seek(max(0, path.stat().st_size - 65536))
            raw = stream.read(65536)
        text = raw.decode(errors="replace")
        logs.append(dict(path=path.relative_to(state).as_posix(), log_bytes=path.stat().st_size,
                      tail_sha256=hashlib.sha256(raw).hexdigest(),
                      git_dubious_ownership="detected dubious ownership" in text,
                      exception_types=re.findall(r"^([A-Za-z_][A-Za-z0-9_.]*(?:Error|Exception)):.*$", text, re.M)[-8:],
                      traceback_frames=[{"file": name, "line": int(line), "function": function}
                          for name, line, function in re.findall(
                              r'^\s*File "([^"\n]{1,512})", line ([0-9]{1,8}), in ([A-Za-z0-9_<>.]{1,100})', text, re.M)[-12:]]))
    if logs:
        result.update(logs=logs, git_dubious_ownership=any(row["git_dubious_ownership"] for row in logs),
                      exception_types=list(dict.fromkeys(kind for row in logs for kind in row["exception_types"]))[-8:],
                      traceback_frames=[frame for row in logs for frame in row["traceback_frames"]][-12:])
    for name in ("admitted_supervisor_status.json", "admitted_database_daemon_pass_heartbeat.json",
                 "admitted_native_owner_heartbeat.json"):
        path = state / "run" / name
        if path.is_file() and not path.is_symlink() and path.stat().st_size <= 65536:
            try:
                value = json.loads(path.read_text())
                result[name] = {key: value[key] for key in (
                    "schema", "status", "healthy", "pid", "daemon_pid", "supervisor_pid",
                    "selection_idle_reason", "error_type", "phase",
                ) if key in value and type(value[key]) in (str, int, bool, type(None))}
            except (OSError, ValueError, TypeError):
                result[name] = {"readable_json": False}
    return result


def _final_context_audit(report: dict, *, state: Path, deadline: float) -> None:
    """Observe completed dispatch inputs after shutdown within remaining time."""
    if report.get("arm") != "full":
        return
    try:
        from benchmarks.agent_supervisor.container_coding.terminal_context_audit import collect_terminal_context_audit
        # Historical catalog replay has an explicitly bounded thirty-second
        # ceiling; other coding inputs retain ten seconds. Presence selects
        # only a CPU budget, and the collector still validates the receipt.
        # Both stay within the existing one-second final-report reserve.
        audit_ceiling = 30.0 if any(
            type(row) is dict and row.get("phase") == "coding"
            and "reviewed_source_nomination_context" in row
            for row in report.get("provider_invocations", [])
        ) else 10.0
        report["context_input_audit"] = collect_terminal_context_audit(
            state=state, receipts=report.get("provider_invocations", []), workspace_root=WORKTREES,
            timeout_seconds=max(0, min(audit_ceiling, deadline - time.monotonic() - 1.0)))
    except Exception as error:
        # Observation failure must never suppress provider accounting or the
        # final report. STOP and worker cleanup have already been attempted.
        report["context_input_audit"] = {"schema": "terminal-final-context-audit@1",
            "status": "unknown", "reason": "audit_finalization_unavailable",
            "error_type": type(error).__name__, "provider_calls": 0,
            "raw_prompts_exported": False, "completion_authority": False}
    if report.get("model_input_observations"):
        try:
            from benchmarks.agent_supervisor.container_coding.terminal_model_input_observation_audit import collect_terminal_model_input_observation_audit
            report["model_input_observation_audit"] = collect_terminal_model_input_observation_audit(
                state=state, observations=report["model_input_observations"], workspace_root=WORKTREES,
                timeout_seconds=max(0, min(30.0, deadline - time.monotonic() - 1.0)))
        except Exception as error:
            report["model_input_observation_audit"] = {
                "schema": "terminal-model-input-observation-audit@1", "status": "unknown",
                "reason": "audit_finalization_unavailable", "error_type": type(error).__name__,
                "all_rendered_model_inputs_verified": None, "provider_invocations_created": 0,
                "provider_transmission_verified": False, "provider_usage_measured": False,
                "raw_prompts_exported": False, "completion_authority": False}


def _mark_missing_coding_receipt(report: dict, *, observe_model_input_only: bool) -> None:
    """Distinguish the selected render-only command from a provider route.

    The flag is the trusted driver's selected command control. A self-declared
    observation alone cannot switch the role or authenticate launch population.
    Missing render evidence does not create a provider invocation or zero usage.
    """
    if not (report.get("coding_dispatch_possible") and report.get("implementation_route") == "model_router"):
        return
    coding_receipted = any(row.get("phase") == "coding" for row in report["provider_invocations"])
    if observe_model_input_only is True:
        report["provider_route_observed"] = coding_receipted
        report["launch_population_authenticated"] = False
        observations = report.get("model_input_observations", [])
        if (len(observations) != 1 or report.get("model_input_observation_errors")
                or report.get("model_input_observation_refusals")):
            report["unreceipted_model_input_observation"] = {
                "phase": "coding", "status": "unknown", "usage": None,
                "reason": "render_only_dispatch_lacks_one_valid_matching_observation",
            }
        return
    if not coding_receipted:
        report["unreceipted_provider_attempt"] = {
            "phase": "coding", "usage": None,
            "reason": "implementation_may_have_dispatched_without_a_final_router_receipt",
        }


class _PostStopRefreshExpired(BaseException):
    """A deadline must escape optional-component unavailability handlers."""


def _mark_initial_autoencoder_historical(report: dict) -> None:
    """Initial learned nominations do not become current after publication.

    Preserve historical training provenance even when the successor context
    has no remaining rebuild budget. Revalidating or retraining against the
    published source requires its own receipt; semantic refresh alone does not
    establish freshness of this separate learned index.
    """
    learner = report.get("initial_context", {}).get("codebase_autoencoder")
    if learner is None:
        return
    report["post_publication_autoencoder"] = {
        "schema": "terminal-published-code-autoencoder-observation@1",
        "status": "historical", "reason": "initial_checkpoint_not_revalidated_after_publication",
        "checkpoint_sha256": learner["checkpoint_sha256"],
        "receipt_sha256": learner["receipt_sha256"],
        "initial_source_hashes": dict(learner["source_hashes"]),
        "freshness_checked": False, "current_source_reuse_authority": False,
        "new_autoencoder_training_steps": 0, "provider_calls": 0,
        "formalization_authority": False, "proof_authority": False,
        "completion_authority": False,
    }


def _refresh_completed_context(runtime, report: dict, *, deadline: float) -> None:
    """Spend only remaining post-STOP work time; retain finalization reserve."""
    if (report.get("arm") != "full" or report.get("task_state", {}).get("status") != "completed"
            or report.get("stop", {}).get("status") != "succeeded"
            or report.get("remaining_processes") != 0):
        return
    _mark_initial_autoencoder_historical(report)
    frozen = report.get("initial_context", {}).get("security_autoencoder_advice")
    if frozen is not None:
        report["post_publication_security_advice"] = {
            "status": "deferred", "reason": "published_source_not_revalidated",
            "checkpoint_sha256": frozen["checkpoint"]["checkpoint_sha256"],
            "initial_source_hashes": frozen["source_hashes"], "current_source_reuse_authority": False,
            "training_steps": 0, "provider_calls": 0, "download_calls": 0,
            "proof_authority": False, "completion_authority": False}
    budget = max(0., deadline - time.monotonic() - 15.)
    observation = {"status": "deferred", "budget_seconds": budget, "refresh_seconds": None,
        "completion_authority": False, "embedding_calls": None}
    report["post_publication_context"] = observation
    if budget < 5:
        observation["reason"] = "post_stop_refresh_budget_unavailable"
        return
    started = time.monotonic()
    previous_handler = signal.getsignal(signal.SIGALRM)
    def expired(signum, frame):
        raise _PostStopRefreshExpired("post-STOP refresh budget expired")
    try:
        signal.signal(signal.SIGALRM, expired)
        signal.setitimer(signal.ITIMER_REAL, budget)
        frozen = report.get("initial_context", {}).get("security_autoencoder_advice")
        if frozen is not None:
            from ipfs_accelerate_py.agent_supervisor.runtime.security_autoencoder_advisor import refresh_security_advice
            report["post_publication_security_advice"] = refresh_security_advice(
                repository=Path(frozen["repository"]), previous=frozen,
                output=Path(frozen["output"]).parent / "published-security-advice")
        doctor = report.get("doctor_dispatch", {})
        workflow = doctor.get("contract_workflow")
        if workflow is not None:
            from ipfs_accelerate_py.agent_supervisor.runtime.doctor_contract_refresh import refresh_doctor_contract_index
            report["post_publication_proof_index"] = refresh_doctor_contract_index(
                repository=Path(workflow["repository"]), workflow=workflow,
                state=Path(doctor["result_artifact"]).parent / "published-contract-index")
        results = runtime.refresh_after_stop()
        observation["results"] = results
        counters = ("local_embedding_calls", "local_embedding_texts",
                    "remote_embedding_calls", "text_generation_calls")
        receipts = [row.get("embedding_receipt") for row in results]
        valid = [receipt for receipt in receipts if isinstance(receipt, dict)
            and receipt.get("schema") in {"supervisor-published-learned-embedding-receipt@1",
                "supervisor-published-lexical-retrieval-receipt@1"}
            and all(type(receipt.get(key)) is int and receipt[key] >= 0 for key in counters)]
        complete = bool(receipts) and len(valid) == len(receipts)
        observation["embedding_accounting"] = {
            "all_refreshes_receipted": complete,
            "totals": {key: sum(row[key] for row in valid) if complete else None for key in counters},
            "known_subtotals": {key: sum(row[key] for row in valid) if valid else None for key in counters}}
        if complete:
            observation["embedding_calls"] = sum(
                row["local_embedding_calls"] + row["remote_embedding_calls"] for row in valid)
        observation["status"] = ("refreshed" if results and all(
            row.get("status") == "refreshed" and row.get("retrieval_status") == "current"
            for row in results) else "incomplete")
    except (_PostStopRefreshExpired, Exception) as error:
        observation.update(status="unavailable", error_type=type(error).__name__)
    finally:
        observation["refresh_seconds"] = time.monotonic() - started
        report["phases"]["post_publication_refresh_seconds"] = observation["refresh_seconds"]
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        _arm_cleanup_deadline(deadline)


def _security_learning_inputs(*, security_initializer: Path | None,
                              canonical_cve_export: Path | None,
                              canonical_cve_manifest_sha256: str | None) -> dict:
    """Load independently pinned portable bindings within the agent budget."""
    if bool(canonical_cve_export) != bool(canonical_cve_manifest_sha256):
        raise ValueError("canonical CVE export and manifest SHA256 must be supplied together")
    weight_transfer = None
    if security_initializer is not None:
        from ipfs_datasets_py.logic.formalization.autoencoder.security.codebase_autoencoder_transfer import _read, validate_legal_shared_weight_fork

        weight_transfer = json.loads(_read(Path(security_initializer).absolute(), 32_000))
        validate_legal_shared_weight_fork(expected_receipt=weight_transfer, replay_source=False)
    canonical_cve_training = None
    if canonical_cve_export is not None:
        from ipfs_datasets_py.logic.formalization.autoencoder.security.security_cve_canonical_export import load_canonical_cve_training

        root = Path(canonical_cve_export).absolute()
        load_canonical_cve_training(root, expected_manifest_sha256=canonical_cve_manifest_sha256)
        canonical_cve_training = {"output": str(root), "manifest_sha256": canonical_cve_manifest_sha256}
    return {"weight_transfer": weight_transfer, "canonical_cve_training": canonical_cve_training}


def _security_runtime_inputs(*, security_checkpoint, security_checkpoint_manifest_sha256,
                             security_initializer, canonical_cve_export, canonical_cve_manifest_sha256,
                             security_checkpoint_hub_descriptor=None, formula_decoder_descriptor=None,
                             header_protocol_descriptor=None):
    frozen = security_checkpoint is not None or security_checkpoint_manifest_sha256 is not None
    if frozen:
        if (not security_checkpoint or not security_checkpoint_manifest_sha256
                or any(value is not None for value in (security_initializer, canonical_cve_export, canonical_cve_manifest_sha256))):
            raise ValueError("frozen checkpoint requires its manifest pin and excludes local training")
        from ipfs_datasets_py.logic.formalization.autoencoder.security.security_autoencoder_checkpoint import load_security_checkpoint
        loaded = load_security_checkpoint(Path(security_checkpoint).absolute(),
            expected_manifest_sha256=security_checkpoint_manifest_sha256)
        selected = {"train_autoencoder": False, "security_checkpoint": loaded["descriptor"]}
        if formula_decoder_descriptor is not None:
            from ipfs_accelerate_py.agent_supervisor.runtime.security_autoencoder_advisor import _read
            from ipfs_datasets_py.logic.formalization.autoencoder.security.security_formula_decoder import load_security_formula_decoder
            decoder = json.loads(_read(Path(formula_decoder_descriptor).absolute(), 32_000))
            load_security_formula_decoder(decoder)
            selected["formula_decoder"] = decoder
            if header_protocol_descriptor is not None:
                protocol = json.loads(_read(Path(header_protocol_descriptor).absolute(), 32_000))
                from ipfs_datasets_py.logic.security_ir.doctor_header_contracts import WsgiHeaderProtocolContract
                if type(protocol) is not dict or set(protocol) != {"review_ref", "callback_parameter"}:
                    raise ValueError("explicit closed reviewed header protocol required")
                WsgiHeaderProtocolContract(**protocol)
                selected["header_protocol"] = protocol
        elif header_protocol_descriptor is not None:
            raise ValueError("header protocol requires a selected formula decoder")
        if security_checkpoint_hub_descriptor is not None:
            from ipfs_accelerate_py.agent_supervisor.runtime.security_autoencoder_hub import validate_hub_descriptor
            from ipfs_accelerate_py.agent_supervisor.runtime.security_autoencoder_advisor import _read
            hub = validate_hub_descriptor(json.loads(_read(Path(security_checkpoint_hub_descriptor).absolute(), 32_000)))
            if hub["manifest_sha256"] != security_checkpoint_manifest_sha256:
                raise ValueError("selected security Hub manifest differs")
            selected["security_checkpoint_hub"] = hub
        return selected
    if any(item is not None for item in (security_checkpoint_hub_descriptor, formula_decoder_descriptor, header_protocol_descriptor)):
        raise ValueError("security Hub and formula models require an explicit frozen checkpoint")
    return {"train_autoencoder": True, **_security_learning_inputs(
        security_initializer=security_initializer, canonical_cve_export=canonical_cve_export,
        canonical_cve_manifest_sha256=canonical_cve_manifest_sha256)}


def _source_nomination_phase_inputs(*, instruction, requirement_contract, model_snapshot, model_revision):
    """Capture independent public controls; do not read any owner key or DB."""
    from ipfs_accelerate_py.agent_supervisor.runtime import code_source_inspection as source
    from ipfs_accelerate_py.agent_supervisor.runtime.supervisor_meta_index import public_replay_without_metadata
    for path in (instruction, requirement_contract):
        if not isinstance(path, Path) or not path.is_absolute() or ".." in path.parts:
            raise ValueError("source nomination phases require canonical public instruction and contract paths")
    captured = source._PublicCapture(instruction.parent)
    raw = captured.read(instruction.name, 32768)
    contract_raw = captured.read(requirement_contract.name, 4 * 1024 * 1024,
        root=requirement_contract.parent)
    text = raw.decode("utf-8", errors="strict")
    with public_replay_without_metadata():
        contract = preparation._load_intent_requirement_contract(requirement_contract, text)
    if type(contract) is not dict or contract.get("schema") != "intent-plan-requirement-contract@2":
        raise ValueError("source nomination phases require an explicit source-bound @2 contract")
    if bool(model_snapshot) != bool(model_revision):
        raise ValueError("source nomination phases require the same complete embedding policy")
    if ((model_snapshot is not None and not isinstance(model_snapshot, Path))
            or type(model_revision) is not str):
        raise ValueError("source nomination phases require an explicit embedding policy")
    captured.verify_originals()
    return {"instruction_sha256": hashlib.sha256(raw).hexdigest(),
        "contract_file_sha256": hashlib.sha256(contract_raw).hexdigest(),
        "instruction_text": text, "contract": contract,
        "model_snapshot": str(model_snapshot.resolve(strict=True)) if model_snapshot is not None else None,
        "model_revision": model_revision}


def _source_nomination_owner_receipt(directory, name, maximum=4 * 1024 * 1024):
    """Read only named phase receipts under the deployed same-owner boundary."""
    from ipfs_accelerate_py.agent_supervisor.runtime import code_source_inspection as source
    if (type(name) is not str or name not in {
            "prepared.json", "admission.json", "planning-result.json", "initial-context-result.json"}
            and re.fullmatch(r"[A-Za-z0-9_.-]{1,128}-source-nomination-prepare_only-result\.json", name) is None):
        raise ValueError("only closed source nomination phase receipt names are readable")
    if directory.resolve(strict=True) != directory:
        raise ValueError("canonical same-owner phase directory required")
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    file_fd = None
    try:
        before_directory = os.fstat(fd)
        if before_directory.st_uid != os.geteuid() or stat.S_IMODE(before_directory.st_mode) & 0o022:
            raise ValueError("protected same-owner phase directory required")
        file_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        before = os.fstat(file_fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_uid != os.geteuid()
                or stat.S_IMODE(before.st_mode) & 0o022 or not 0 < before.st_size <= maximum):
            raise ValueError("bounded protected same-owner phase receipt required")
        with os.fdopen(file_fd, "rb", closefd=False) as stream:
            raw = stream.read(maximum + 1)
        if (len(raw) > maximum or source._stat(before) != source._stat(os.fstat(file_fd))
                or source._stat(before) != source._stat(os.stat(name, dir_fd=fd, follow_symlinks=False))
                or source._stat(before_directory) != source._stat(os.fstat(fd))):
            raise ValueError("same-owner phase receipt witness changed")
        return source._parse(raw), hashlib.sha256(raw).hexdigest()
    finally:
        if file_fd is not None:
            os.close(file_fd)
        os.close(fd)


def _source_nomination_ready_task(*, state, admission, verified, baseline):
    from ipfs_accelerate_py.agent_supervisor.task_sources.intent_repository import IntentRepository
    task = verified["graph"].tasks[0]
    with IntentRepository(state / "intent.duckdb", install_schema=False) as intent:
        rows = intent.plan_projection(task_cids=[task.task_cid])["tasks"]
    if (len(rows) != 1 or rows[0]["status"] != "ready" or rows[0]["task_cid"] != task.task_cid
            or str(rows[0]["revision"]) != baseline["task_revision"]):
        raise ValueError("resume requires the same current ready admitted task revision")
    contract, _, _, _ = preparation.local._contract(rows[0]["body"], task.task_cid)
    if contract["manifest"] != admission["manifest"] or contract["graph_cid"] != verified["graph"].content_id:
        raise ValueError("resume native task differs from the signed admitted plan")


def _source_nomination_resume_budget(*, state, limit_seconds):
    """Read only the protected original phase charge before expensive replay."""
    active_budget.validate_limit(limit_seconds)
    prior, digest = _source_nomination_owner_receipt(
        state.parent, state.name + "-source-nomination-prepare_only-result.json")
    if (type(prior) is not dict or prior.get("source_nomination_phase") != "prepare_only"
            or prior.get("source_nomination_review_required") is not True
            or prior.get("task_completed") is not False or prior.get("error") is not None
            or type(prior.get("worker_cleanup_returncode")) is not int
            or prior["worker_cleanup_returncode"] != 0):
        raise ValueError("resume requires a completed measured preparation and successful cleanup")
    charged = active_budget.validate_preparation_budget(
        prior.get("source_nomination_active_budget"), expected_limit_seconds=limit_seconds)
    return {"prior_charged_ns": charged, "prepared_phase_report_sha256": digest}


def _load_source_nomination_resume(*, state, inputs, controls, nomination,
                                   expected_phase_report_sha256=None):
    """Replay the original prepared owner; never author another profile or plan."""
    from .terminal_initial_context import load_initial_context
    from .source_nomination_review_preparation import SCHEMA
    from ipfs_accelerate_py.agent_supervisor.runtime import code_source_inspection as source
    from ipfs_accelerate_py.agent_supervisor.runtime import intent_source_nomination as pure

    prior_name = state.name + "-source-nomination-prepare_only-result.json"
    prior, prior_sha = _source_nomination_owner_receipt(state.parent, prior_name)
    if type(controls) is not dict:
        raise ValueError("resume requires the pinned active budget controls")
    budget = _source_nomination_resume_budget(state=state,
        limit_seconds=controls.get("active_budget_limit_seconds"))
    if (prior_sha != budget["prepared_phase_report_sha256"]
            or expected_phase_report_sha256 is not None and prior_sha != expected_phase_report_sha256):
        raise ValueError("resume preparation active budget receipt changed during replay")
    if (type(prior) is not dict or prior.get("source_nomination_phase") != "prepare_only"
            or prior.get("source_nomination_review_required") is not True
            or prior.get("task_completed") is not False or prior.get("provider_invocations") != []
            or prior.get("source_nomination_independent_inputs") != {
                key: inputs[key] for key in ("instruction_sha256", "contract_file_sha256", "model_snapshot", "model_revision")}
            or source._json(prior.get("source_nomination_controls")) != source._json(controls)):
        raise ValueError("resume controls differ from the independently captured preparation phase")
    state_pins = {}
    records = {}
    for name in ("prepared.json", "admission.json", "planning-result.json", "initial-context-result.json"):
        records[name], state_pins[name] = _source_nomination_owner_receipt(state, name)
    if state_pins != prior.get("source_nomination_state_sha256"):
        raise ValueError("resume prepared phase receipts changed")
    prepared = preparation._load_prepared(state)
    if (prepared != records["prepared.json"] or prepared["query"] != inputs["instruction_text"]
            or prepared.get("intent_requirement_contract") != inputs["contract"]):
        raise ValueError("resume differs from independent original instruction or requirement contract")
    admission = records["admission.json"]
    verified = verify_local_benchmark_admission(admission, initial=True)
    if admission["manifest"] != prepared["manifest"] or len(verified["graph"].tasks) != 1:
        raise ValueError("resume signed admission differs from original prepared manifest")
    initial = load_initial_context(state=state, prepared=prepared, require_empty_owner=False)
    descriptor = initial["descriptor"]
    if (descriptor["model_snapshot"] != inputs["model_snapshot"]
            or descriptor["model_revision"] != inputs["model_revision"]):
        raise ValueError("resume may not switch the initial embedding policy")
    planned = records["planning-result.json"]
    if (type(planned) is not dict or planned.get("qualified") is not True or planned.get("planning_strategy") != "intent_symbolic"
            or type(planned.get("provider_calls")) is not int or planned["provider_calls"] != 0):
        raise ValueError("resume requires the existing qualified symbolic plan")
    baseline_ref = prior["source_nomination_review_preparation"]
    if type(baseline_ref) is not dict or not {"artifact", "sha256"} <= set(baseline_ref):
        raise ValueError("bounded independently pinned public review baseline required")
    source._digest(baseline_ref["sha256"])
    repository = Path(prepared["repository"])
    captured = source._PublicCapture(repository)
    raw = captured.read(baseline_ref["artifact"], 65536)
    if hashlib.sha256(raw).hexdigest() != baseline_ref["sha256"]:
        raise ValueError("resume public review baseline digest differs")
    baseline, _ = pure._decoded(raw, 65536)
    review, _ = pure._decoded(nomination["raw"], 65536)
    task = verified["graph"].tasks[0]
    if (baseline.get("schema") != SCHEMA or baseline.get("task_id") != task.task_key
            or baseline.get("task_cid") != task.task_cid or baseline.get("bindings") != review["bindings"]
            or baseline["bindings"]["task_revision"] != baseline.get("task_revision")
            or baseline["bindings"]["index_id"] != initial["retrieval"]["index_id"]
            or baseline.get("original_retrieval") != {
                "artifact": descriptor["metadata"]["Code retrieval artifact"],
                "sha256": descriptor["metadata"]["Code retrieval sha256"]}):
        raise ValueError("resume review differs from the original current task and native index baseline")
    _source_nomination_ready_task(state=state, admission=admission, verified=verified, baseline=baseline)
    if (repository / ".runtime/terminal-context").exists():
        raise ValueError("resume worker context was already created")
    if preparation._load_prepared(state) != prepared:
        raise ValueError("resume prepared declaration changed during replay")
    if _source_nomination_owner_receipt(state.parent, prior_name)[1] != prior_sha:
        raise ValueError("resume preparation active budget receipt changed during replay")
    captured.verify_originals()
    return {"prepared": prepared, "planning": planned, "initial_context": records["initial-context-result.json"],
        "prior_charged_ns": budget["prior_charged_ns"],
        "receipt": {"prepared_phase_report_sha256": prior_sha,
            "public_review_baseline_sha256": baseline_ref["sha256"], "same_owner_preparation_reused": True,
            "new_profiles_created": 0, "new_plan_calls": 0, "new_initial_context_calls": 0,
            "planner_current_facts_added": 0}}


def run(*, instruction: Path, state: Path, arm: str, timeout_seconds=285,
        semantic_transport: str = "identifiers",
        doctor_profile: str = "header-contract",
        intent_requirements_transport: str = "expanded",
        code_retrieval_transport: str = "full",
        code_retrieval_codec: str = "expanded",
        code_retrieval_wire_delivery: str = "inline",
        model_snapshot: Path | None = None, model_revision="",
        security_initializer: Path | None = None, canonical_cve_export: Path | None = None,
        canonical_cve_manifest_sha256: str | None = None,
        security_checkpoint: Path | None = None, security_checkpoint_manifest_sha256: str | None = None,
        security_checkpoint_hub_descriptor: Path | None = None,
        formula_decoder_descriptor: Path | None = None, header_protocol_descriptor: Path | None = None,
        intent_checkpoint_descriptor: Path | None = None,
        intent_projection_request: Path | None = None,
        intent_projection_request_sha256: str | None = None,
        disable_intent_autoencoder: bool = False,
        intent_requirement_contract: Path | None = None,
        source_nomination_review: Path | None = None,
        source_nomination_review_sha256: str | None = None,
        source_nomination_prepare_only: bool = False,
        source_nomination_resume: bool = False,
        observe_model_input_only: bool = False) -> dict:
    if type(source_nomination_prepare_only) is not bool or type(source_nomination_resume) is not bool:
        raise ValueError("source nomination lifecycle controls must be boolean")
    if source_nomination_prepare_only and source_nomination_resume:
        raise ValueError("source nomination preparation and resume are separate phases")
    if type(observe_model_input_only) is not bool:
        raise ValueError("model input observation control must be boolean")
    if observe_model_input_only and not (source_nomination_prepare_only or source_nomination_resume):
        raise ValueError("model input observation requires the full source nomination lifecycle")
    phase_started_ns = time.monotonic_ns() if source_nomination_prepare_only or source_nomination_resume else None
    prior_charge = {"prior_charged_ns": 0, "prepared_phase_report_sha256": None}
    if source_nomination_prepare_only or source_nomination_resume:
        if arm != "full" or not isinstance(intent_requirement_contract, Path):
            raise ValueError("source nomination phases require full arm and an explicit @2 contract path")
        if re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", state.name) is None:
            raise ValueError("source nomination phases require a bounded canonical state name")
        active_budget.validate_limit(timeout_seconds)
        if os.geteuid() != 1000 or not state.is_relative_to(ROOT / "state"):
            raise ValueError("container task must run as the deployed private supervisor owner")
    if source_nomination_prepare_only and (
            source_nomination_review is not None or source_nomination_review_sha256 is not None):
        raise ValueError("source nomination preparation exports inputs before a review is supplied")
    if source_nomination_resume and (
            source_nomination_review is None or source_nomination_review_sha256 is None):
        raise ValueError("source nomination resume requires the independently reviewed pair")
    if not source_nomination_resume and (
            source_nomination_review is not None or source_nomination_review_sha256 is not None):
        raise ValueError("source nomination review requires the same prepared owner state in resume mode")
    if source_nomination_resume:
        prior_charge = _source_nomination_resume_budget(state=state, limit_seconds=timeout_seconds)
        if active_budget.scheduling_remaining_seconds(limit_seconds=timeout_seconds,
                prior_charged_ns=prior_charge["prior_charged_ns"]) <= (
                active_budget.CLEANUP_SECONDS + active_budget.MIN_WORK_SECONDS):
            raise ValueError("resume has no remaining active work budget after its cleanup reserve")
    nomination = _capture_source_nomination_review(arm, source_nomination_review,
        source_nomination_review_sha256, requirement_contract=intent_requirement_contract)
    if arm not in {"full", "no-index"} or not 90 <= timeout_seconds <= 300:
        raise ValueError("explicit bounded arm required")
    _validate_code_retrieval_transport(arm, code_retrieval_transport)
    _validate_code_retrieval_codec(arm, code_retrieval_codec, semantic_transport=semantic_transport,
        code_retrieval_transport=code_retrieval_transport)
    _validate_code_retrieval_wire_delivery(arm, code_retrieval_wire_delivery,
        semantic_transport=semantic_transport, code_retrieval_transport=code_retrieval_transport,
        code_retrieval_codec=code_retrieval_codec)
    contract_profile = _doctor_contract_profile(arm, doctor_profile)
    if semantic_transport not in {"identifiers", "native"}:
        raise ValueError("unknown semantic transport")
    if semantic_transport == "native" and arm != "full":
        raise ValueError("native semantic transport requires the full indexed arm")
    _validate_intent_requirements_transport(arm, intent_requirements_transport,
        requirement_contract=intent_requirement_contract)
    if arm != "full" and any(value is not None for value in (
            security_initializer, canonical_cve_export, canonical_cve_manifest_sha256,
            security_checkpoint, security_checkpoint_manifest_sha256, security_checkpoint_hub_descriptor,
            formula_decoder_descriptor, header_protocol_descriptor)):
        raise ValueError("security training assets require the full indexed arm")
    phase_inputs = (_source_nomination_phase_inputs(instruction=instruction,
        requirement_contract=intent_requirement_contract, model_snapshot=model_snapshot,
        model_revision=model_revision) if source_nomination_prepare_only or source_nomination_resume else None)
    phase_controls = {"arm": arm, "semantic_transport": semantic_transport,
        "doctor_profile": doctor_profile, "intent_requirements_transport": intent_requirements_transport,
        "code_retrieval_transport": code_retrieval_transport, "code_retrieval_codec": code_retrieval_codec,
        "code_retrieval_wire_delivery": code_retrieval_wire_delivery,
        "disable_intent_autoencoder": disable_intent_autoencoder}
    if phase_started_ns is not None:
        phase_controls.update(active_budget_policy=active_budget.POLICY,
            active_budget_limit_seconds=timeout_seconds,
            active_budget_cleanup_seconds=active_budget.CLEANUP_SECONDS)
        if observe_model_input_only:
            phase_controls["observe_model_input_only"] = True
    if os.geteuid() != 1000 or not state.is_relative_to(ROOT / "state"):
        raise ValueError("container task must run as the deployed private supervisor owner")
    # Canonical files remain read-only to the model identity. The trusted
    # launcher makes only its allocated candidate worktree group-writable.
    os.umask(0o022)
    started = time.monotonic() if phase_started_ns is None else phase_started_ns / active_budget.NANOSECONDS
    phase_allowance = timeout_seconds if phase_started_ns is None else active_budget.scheduling_remaining_seconds(
        limit_seconds=timeout_seconds, prior_charged_ns=prior_charge["prior_charged_ns"])
    deadline = started + phase_allowance
    work_deadline = deadline - 40
    report = {"schema": "terminal-admitted-supervisor-run@1", "arm": arm,
              "semantic_transport": semantic_transport,
              "doctor_profile": doctor_profile, "doctor_profile_experimental": doctor_profile == "generic",
              "intent_requirements_transport": intent_requirements_transport,
              "code_retrieval_transport": code_retrieval_transport,
              "code_retrieval_codec": code_retrieval_codec,
              "code_retrieval_wire_delivery": code_retrieval_wire_delivery,
              "task_completed": False, "official_reward": None,
              "max_total_agent_seconds": timeout_seconds, "provider_invocations": [],
              "pre_dispatch_refusals": [],
              "reserved_cleanup_seconds": 40, "work_cutoff_seconds": timeout_seconds - 40,
              "production_activation": False, "benchmark_advantage_claimed": False,
              "phases": {}, "remaining_processes": None}
    observer_probe = None
    observer_capture = None
    if observe_model_input_only:
        report["observer_lifecycle_qualified"] = False
    if nomination is not None:
        report.update(_source_nomination_observation(nomination))
    if source_nomination_prepare_only or source_nomination_resume:
        report["source_nomination_phase"] = "prepare_only" if source_nomination_prepare_only else "resume"
        report["source_nomination_independent_inputs"] = {key: phase_inputs[key]
            for key in ("instruction_sha256", "contract_file_sha256", "model_snapshot", "model_revision")}
        report["source_nomination_controls"] = phase_controls
        report["source_nomination_end_to_end_budget_accounted"] = False
        report["source_nomination_phase_allowance_seconds"] = phase_allowance
        report["work_cutoff_seconds"] = phase_allowance - active_budget.CLEANUP_SECONDS
    state.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    report_path = state.parent / (state.name + "-result.json")
    if source_nomination_prepare_only or source_nomination_resume:
        report_path = state.parent / (state.name + "-source-nomination-" + report["source_nomination_phase"] + "-result.json")
        if report_path.exists() or report_path.is_symlink():
            raise ValueError("source nomination phase report already exists; prior evidence must be retained")

    def budget_expired(signum, frame):
        # Reserve time for native STOP and durable accounting before Harbor's
        # independent outer timeout destroys the disposable container.
        signal.setitimer(signal.ITIMER_REAL, 0)
        raise TimeoutError("the total benchmark agent budget is exhausted")

    previous_alarm = signal.signal(signal.SIGALRM, budget_expired)
    previous_term = signal.signal(signal.SIGTERM, budget_expired)
    signal.setitimer(signal.ITIMER_REAL, max(1, timeout_seconds - 40) if phase_started_ns is None
        else max(.001, work_deadline - time.monotonic()))

    def remaining(reserve=0):
        value = int(work_deadline - time.monotonic() - reserve)
        if value < 1:
            raise TimeoutError("the total benchmark agent budget is exhausted")
        return value

    def isolated_planner(prompt, *, repository, provider, model, reasoning_effort,
                         timeout, max_new_tokens, trace_path):
        if provider != "codex_cli":
            raise ValueError("benchmark planner route differs from the native baseline")
        planner_tree = WORKTREES / ("planner-" + uuid.uuid4().hex)
        subprocess.run(["git", "-C", str(repository), "-c", "core.hooksPath=/dev/null",
                        "worktree", "add", "--detach", str(planner_tree), "HEAD"],
                       check=True, capture_output=True, timeout=min(30, remaining(15)))
        argv = [str(ROUTER), "--model", model, "--reasoning-effort", reasoning_effort,
                "--purpose", "planning",
                "--timeout", str(min(timeout, remaining(20))),
                "--max-output-tokens", str(max_new_tokens)]
        process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, text=True, cwd=planner_tree)
        try:
            stdout, stderr = process.communicate(prompt, timeout=min(timeout + 10, remaining(10)))
        except BaseException:
            process.terminate()
            try:
                stdout, stderr = process.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                process.kill()
                stdout, stderr = process.communicate()
            trace_path.write_text(stdout)
            trace_path.with_suffix(".stderr").write_text(stderr)
            try:
                _, receipt = _router_reply(stdout)
                report["provider_invocations"].append({"phase": "planning", **receipt})
            except ValueError:
                report["unreceipted_provider_attempt"] = {"phase": "planning", "usage": None,
                                                           "reason": "interrupted_without_receipt"}
            raise
        call = subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)
        trace_path.write_text(call.stdout)
        trace_path.with_suffix(".stderr").write_text(call.stderr)
        text, receipt = _router_reply(call.stdout)
        report["provider_invocations"].append({"phase": "planning", **receipt})
        if call.returncode or receipt.get("status") != "provider_returned":
            raise RuntimeError("isolated planning router did not complete successfully")
        return {"text": text, "observation": receipt.get("usage", {}), "execution_receipt": receipt}

    try:
        if phase_started_ns is not None:
            remaining()
        if source_nomination_resume:
            before = time.monotonic()
            try:
                resumed = _load_source_nomination_resume(state=state, inputs=phase_inputs,
                    controls=phase_controls, nomination=nomination,
                    expected_phase_report_sha256=prior_charge["prepared_phase_report_sha256"])
                if resumed["prior_charged_ns"] != prior_charge["prior_charged_ns"]:
                    raise ValueError("resume preparation active budget charge changed")
                prepared, planned = resumed["prepared"], resumed["planning"]
                report["initial_context"] = resumed["initial_context"]
                report["source_nomination_resume"] = resumed["receipt"]
                report["intent_preplanning"] = prepared["intent_preplanning"]
                if "public_intent_profile" in prepared:
                    report["public_intent_profile"] = prepared["public_intent_profile"]
            finally:
                report["phases"]["source_nomination_resume_seconds"] = time.monotonic() - before
        else:
            before = time.monotonic()
            try:
                prepared = preparation.prepare(repository=Path("/app"), instruction=instruction, state=state,
                    intent_checkpoint_descriptor=intent_checkpoint_descriptor,
                    intent_projection_request=intent_projection_request,
                    intent_projection_request_sha256=intent_projection_request_sha256,
                    disable_intent_autoencoder=disable_intent_autoencoder,
                    intent_requirement_contract=intent_requirement_contract)
                report["intent_preplanning"] = prepared["intent_preplanning"]
                if "public_intent_profile" in prepared:
                    report["public_intent_profile"] = prepared["public_intent_profile"]
            finally:
                report["phases"]["prepare_seconds"] = time.monotonic() - before
            if arm == "full":
                before = time.monotonic()
                try:
                    report["initial_context"] = preparation.initial_context(state=state,
                        model_snapshot=model_snapshot, model_revision=model_revision,
                        **_security_runtime_inputs(security_checkpoint=security_checkpoint,
                            security_checkpoint_manifest_sha256=security_checkpoint_manifest_sha256,
                            security_checkpoint_hub_descriptor=security_checkpoint_hub_descriptor,
                            formula_decoder_descriptor=formula_decoder_descriptor,
                            header_protocol_descriptor=header_protocol_descriptor,
                            security_initializer=security_initializer,
                            canonical_cve_export=canonical_cve_export,
                            canonical_cve_manifest_sha256=canonical_cve_manifest_sha256))
                finally:
                    report["phases"]["initial_context_seconds"] = time.monotonic() - before
            before = time.monotonic()
            try:
                planned = preparation.plan(state=state, provider_callable=isolated_planner,
                                           timeout_seconds=min(90, remaining(30)))
            finally:
                report["phases"]["planning_seconds"] = time.monotonic() - before
        report["planning"] = planned
        if not planned.get("qualified"):
            raise RuntimeError("the model proposal did not pass independent admission")
        if source_nomination_prepare_only:
            from .source_nomination_review_preparation import prepare_source_nomination_review_baseline
            before = time.monotonic()
            try:
                report["source_nomination_review_preparation"] = prepare_source_nomination_review_baseline(state=state)
                stored = preparation._load_prepared(state)
                if stored["query"] != phase_inputs["instruction_text"] or stored.get("intent_requirement_contract") != phase_inputs["contract"]:
                    raise ValueError("review preparation differs from independent public instruction or contract")
                report["source_nomination_state_sha256"] = {name: _source_nomination_owner_receipt(state, name)[1]
                    for name in ("prepared.json", "admission.json", "planning-result.json", "initial-context-result.json")}
                report["source_nomination_review_required"] = True
            finally:
                report["phases"]["source_nomination_review_export_seconds"] = time.monotonic() - before
            return report
        bundle = None
        if arm == "full":
            if phase_started_ns is not None:
                remaining()
            before = time.monotonic()
            try:
                nomination_arguments = ({"source_nomination_review": nomination["path"],
                    "source_nomination_review_sha256": nomination["sha256"]}
                    if nomination is not None else {})
                context = preparation.context(state=state, model_snapshot=model_snapshot,
                    model_revision=model_revision, code_retrieval_transport=code_retrieval_transport,
                    **nomination_arguments)
            finally:
                report["phases"]["context_seconds"] = time.monotonic() - before
            report["context"] = context
            bundle = context["context_bundle"]
        admission = json.loads((state / "admission.json").read_text())
        verified = verify_local_benchmark_admission(admission, initial=True)
        task = verified["graph"].tasks[0]
        doctor = None
        if arm == "full":
            before = time.monotonic()
            try:
                doctor = prepare_terminal_doctor_dispatch(repository=Path("/app"), state=state,
                    admission=admission, task_cid=task.task_cid, contract_profile=contract_profile)
            finally:
                report["phases"]["doctor_seconds"] = time.monotonic() - before
            report["doctor_dispatch"] = doctor
        report["implementation_route"] = doctor["route"] if doctor is not None else "model_router"
        if observe_model_input_only and report["implementation_route"] != "model_router":
            raise ValueError("model input observation requires the native Doctor model-router route")
        implementation = implementation_argv(router=ROUTER, model=preparation.MODEL,
            reasoning=preparation.REASONING, timeout=remaining(25),
            semantic_repository=Path("/app") if bundle is not None else None,
            semantic_transport=semantic_transport, doctor=doctor,
            intent_requirements_transport=intent_requirements_transport,
            code_retrieval_codec=code_retrieval_codec,
            code_retrieval_wire_delivery=code_retrieval_wire_delivery)
        if report["implementation_route"] == "model_router":
            if observe_model_input_only:
                implementation += ["--observe-model-input-only"]
            from ipfs_accelerate_py.agent_supervisor.runtime.router_public_instruction import prepare_public_instruction_context
            instruction_context = prepare_public_instruction_context(repository=Path("/app"),
                admission=admission, task_cid=task.task_cid, source_path=preparation.INSTRUCTION,
                expected_source_sha256=verified["manifest"]["sources"][preparation.INSTRUCTION]["sha256"])
            report["public_instruction"] = instruction_context
            implementation += ["--public-instruction-artifact", instruction_context["artifact"],
                "--public-instruction-sha256", instruction_context["sha256"],
                "--public-instruction-task-cid", task.task_cid]
        command = shlex.join(implementation)
        with open_existing_native_owner(
            database=state / "intent.duckdb", checkout=Path("/app"), state_dir=state / "owner",
            repository_id=verified["manifest"]["repository_cid"],
            execution_routes={task.task_key: GROK_CODEX_EXECUTION_MODE},
        ) as owner:
            diagnostic_arguments = {"native_dispatch_diagnostics": True} if observe_model_input_only else {}
            runtime = AdmittedBenchmarkRuntime.create(
                state / "launch", admission=admission, server=owner.server, source=owner.source,
                implement=True, implementation_command=command, context_bundle=bundle,
                max_task_attempts=1, timeout_ms=20_000, lifetime_seconds=min(600, max(120, remaining() + 60)),
                worker_worktree_root=WORKTREES, candidate_runner_argv=(str(VALIDATOR),),
                refresh_context_on_completion=bundle is not None,
                published_retrieval_policy=("local-safetensors-symbols@1" if model_snapshot is not None
                    else "lexical-tfidf-symbols@1") if bundle is not None else None,
                published_learned_artifacts=({
                    "result": ".runtime/terminal-vectors/result.json",
                    "manifest": ".runtime/terminal-vectors/model-manifest.json",
                    "model_snapshot": str(model_snapshot.resolve(strict=True)),
                } if bundle is not None and model_snapshot is not None else None),
                **diagnostic_arguments,
            )
            try:
                if observe_model_input_only:
                    from benchmarks.agent_supervisor.container_coding.terminal_observer_stop import ObserverStopProbe
                    # Establish absence in this newly granted launch before
                    # START; old phase receipts cannot terminate the wait.
                    observer_probe = ObserverStopProbe(runtime=runtime, report=report,
                        workspace_root=WORKTREES)
                report["coding_dispatch_possible"] = True
                report["start"] = runtime.start().to_dict()
                if report["start"]["status"] != "succeeded":
                    raise RuntimeError("native supervisor START failed")
                while time.monotonic() < work_deadline - 1:
                    if observer_probe is not None:
                        candidate = observer_probe.poll(state=state, deadline=work_deadline - 1)
                        if candidate is not None:
                            report["observer_stop"] = {key: value for key, value in candidate.items()
                                if key not in {"observation", "audit"}}
                            if candidate.get("status") == "verified_rendered_input":
                                observer_capture = candidate
                                observed = candidate["observation"]
                                report["observer_stop"].update(observation_id=observed["observation_id"],
                                    native_prompt_sha256=observed["native_prompt_sha256"],
                                    model_prompt_sha256=observed["model_prompt_sha256"],
                                    audit_sha256=hashlib.sha256(json.dumps(candidate["audit"], sort_keys=True,
                                        separators=(",", ":"), allow_nan=False).encode()).hexdigest())
                            # Invalid or unknown input stops this observer role
                            # with failure. It never settles the native attempt.
                            break
                        # This role waits for rendered input. Repeated owner
                        # control queries can consume its observation window.
                        time.sleep(.5)
                        continue
                    task_state = owner.source.get_task(task.task_cid)
                    report["task_state"] = {"task_cid": task.task_cid, "status": task_state.status,
                                             "revision": task_state.revision}
                    if task_state.status in {"completed", "failed", "blocked", "cancelled"}:
                        break
                    heartbeat = runtime.state / "run/admitted_database_daemon_pass_heartbeat.json"
                    try:
                        reason = json.loads(heartbeat.read_text()).get("selection_idle_reason")
                    except (OSError, ValueError):
                        reason = None
                    if reason == "expired_attempt_settlement_unavailable":
                        report["unavailable_settlement"] = True
                        break
                    time.sleep(.5)
                if observer_capture is None:
                    report["observation"] = runtime.observe()
            finally:
                _arm_cleanup_deadline(deadline)
                try:
                    report["stop"] = runtime.stop().to_dict()
                    report["remaining_processes"] = len(runtime.process.snapshot(runtime.profile).members)
                    if observer_capture is not None:
                        report["observer_stop"]["capture_unchanged_after_stop"] = observer_probe.recheck()
                    _refresh_completed_context(runtime, report, deadline=deadline)
                finally:
                    try:
                        report["native_diagnostics"] = _native_diagnostics(runtime.state)
                    except Exception as error:
                        report["native_diagnostics_error"] = type(error).__name__
                    finally:
                        try:
                            _collect_native_dispatch_diagnostics(runtime, report)
                        finally:
                            runtime.close()
        report["task_completed"] = (
            not observe_model_input_only and report.get("task_state", {}).get("status") == "completed"
            and report["stop"]["status"] == "succeeded" and report["remaining_processes"] == 0
        )
    except Exception as error:
        report["error"] = {"type": type(error).__name__, "message": str(error)[:2048]}
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_alarm)
        signal.signal(signal.SIGTERM, previous_term)
        # This deployment owns exactly one worker UID in one disposable
        # container. Reap detached provider children even after failed startup.
        try:
            cleanup = subprocess.run(["sudo", "-n", "-u", "benchmarkworker", "--",
                                      str(ROOT / "bin/worker-entry"), "--cleanup"],
                                     cwd="/", capture_output=True,
                                     timeout=max(.1, min(15, deadline - time.monotonic() - 1)))
            report["worker_cleanup_returncode"] = cleanup.returncode
        except Exception as error:
            report["worker_cleanup_error"] = type(error).__name__
        if report.get("worker_cleanup_returncode") != 0:
            report["task_completed"] = False
        _collect_worker_receipts(report, state)
        _mark_missing_coding_receipt(report, observe_model_input_only=observe_model_input_only)
        _final_context_audit(report, state=state, deadline=deadline)
        if observe_model_input_only and observer_capture is not None:
            from benchmarks.agent_supervisor.container_coding.terminal_observer_stop import verified_observation_audit
            report["observer_lifecycle_qualified"] = (
                observer_capture is not None and "error" not in report
                and report.get("start", {}).get("status") == "succeeded"
                and report.get("stop", {}).get("status") == "succeeded"
                and type(report.get("remaining_processes")) is int and report["remaining_processes"] == 0
                and type(report.get("worker_cleanup_returncode")) is int and report["worker_cleanup_returncode"] == 0
                and report.get("observer_stop", {}).get("capture_unchanged_after_stop") is True
                and report.get("model_input_observations") == [observer_capture["observation"]]
                and not report.get("model_input_observation_errors")
                and not report.get("model_input_observation_refusals")
                and not report.get("model_input_worker_error_diagnostics")
                and not report.get("pre_dispatch_refusals")
                and not report.get("provider_invocations")
                and "unreceipted_model_input_observation" not in report
                and "unreceipted_provider_attempt" not in report
                and verified_observation_audit(report.get("model_input_observation_audit"),
                    observer_capture["observation"])
                and time.monotonic() < deadline - 1)
        report["seconds"] = time.monotonic() - started
        if phase_started_ns is not None:
            report["source_nomination_active_budget"] = active_budget.phase_budget(
                limit_seconds=timeout_seconds, prior_charged_ns=prior_charge["prior_charged_ns"],
                phase_active_ns=max(0, time.monotonic_ns() - phase_started_ns))
            report["source_nomination_active_processing_scope"] = active_budget.POLICY
            report["source_nomination_official_wall_budget_qualified"] = False
        _write(report_path, report)
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--instruction", type=Path, required=True)
    parser.add_argument("--state", type=Path, required=True)
    parser.add_argument("--arm", choices=["full", "no-index"], required=True)
    parser.add_argument("--semantic-transport", choices=["identifiers", "native"], default="identifiers")
    parser.add_argument("--doctor-profile", choices=["header-contract", "generic"], default="header-contract")
    parser.add_argument("--intent-requirements-transport", choices=["expanded", "compact"], default="expanded")
    parser.add_argument("--code-retrieval-transport", choices=["full", "frontier"], default="full")
    parser.add_argument("--code-retrieval-codec", choices=["expanded", "compact"], default="expanded")
    parser.add_argument("--code-retrieval-wire-delivery", choices=["inline", "materialized"], default="inline")
    parser.add_argument("--timeout-seconds", type=int, default=285)
    parser.add_argument("--model-snapshot", type=Path)
    parser.add_argument("--model-revision", default="")
    parser.add_argument("--security-initializer", type=Path)
    parser.add_argument("--canonical-cve-export", type=Path)
    parser.add_argument("--canonical-cve-manifest-sha256")
    parser.add_argument("--security-checkpoint", type=Path)
    parser.add_argument("--security-checkpoint-manifest-sha256")
    parser.add_argument("--security-checkpoint-hub-descriptor", type=Path)
    parser.add_argument("--formula-decoder-descriptor", type=Path)
    parser.add_argument("--header-protocol-descriptor", type=Path)
    parser.add_argument("--intent-checkpoint-descriptor", type=Path)
    parser.add_argument("--intent-projection-request", type=Path)
    parser.add_argument("--intent-projection-request-sha256")
    parser.add_argument("--disable-intent-autoencoder", action="store_true")
    parser.add_argument("--intent-requirement-contract", type=Path)
    parser.add_argument("--source-nomination-review", type=Path)
    parser.add_argument("--source-nomination-review-sha256")
    parser.add_argument("--source-nomination-prepare-only", action="store_true")
    parser.add_argument("--source-nomination-resume", action="store_true")
    parser.add_argument("--observe-model-input-only", action="store_true")
    result = run(**vars(parser.parse_args()))
    summary = {key: result[key] for key in ("task_completed", "arm", "semantic_transport", "doctor_profile",
        "doctor_profile_experimental", "seconds", "provider_invocations")}
    if "observer_lifecycle_qualified" in result:
        summary["observer_lifecycle_qualified"] = result["observer_lifecycle_qualified"]
    print(json.dumps(summary))
    return 0 if (result["task_completed"] or result.get("source_nomination_review_required") is True
        or result.get("observer_lifecycle_qualified") is True) else 1


if __name__ == "__main__":
    raise SystemExit(main())
