      "name": "regularizer",
      "node_kind": "Assign",
      "source_segment": "regularizer = L2 * _dot(weights, weights) / 2",
      "source_segment_utf8_sha256": "7a318e9c8b5e633e266bc00f0b165cf55b7cf0734427b24c0532fbeb00225ae1",
      "span": [
