      "name": "data",
      "node_kind": "Assign",
      "source_segment": "data = math.fsum(max(0.0, -z) + math.log1p(math.exp(-abs(z))) for z in margins) / len(margins)",
      "source_segment_utf8_sha256": "b01195690bdfb572f7b0573e752eaf0c64c28cf69c38070b207cb237fd8d6d55",
