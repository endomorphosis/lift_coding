      "ast_path": "module.body[24].body[0]",
      "ast_sha256": "3e132b195b19b366ff4f1372a697a26c2c932f863b7e3434e1b5fc8f3f9940e5",
      "name": "margins",
      "node_kind": "Assign",
      "source_segment": "margins = [_dot(weights, row) for row in differences]",
      "source_segment_utf8_sha256": "3c0a0ba2d056671eb2378aaeeeb784909b40e74e47039069dcc2d406efdbf587",
