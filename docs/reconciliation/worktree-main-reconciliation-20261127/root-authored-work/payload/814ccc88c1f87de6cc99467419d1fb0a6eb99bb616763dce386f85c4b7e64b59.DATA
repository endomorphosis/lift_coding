      "name": "factors",
      "node_kind": "Assign",
      "source_segment": "factors = [math.exp(-z) / (1 + math.exp(-z)) if z >= 0 else 1 / (1 + math.exp(z))\n               for z in margins]",
      "source_segment_utf8_sha256": "4a8de8191c554678ef05b86dad7d78510fcae7e1c44fdb3d82a559a6e754fb7e",
