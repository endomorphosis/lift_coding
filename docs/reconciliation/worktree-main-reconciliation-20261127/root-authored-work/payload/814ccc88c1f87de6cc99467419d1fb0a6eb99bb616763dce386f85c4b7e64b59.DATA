    ],
    "evaluation_order": [
      "Resolve fixed callee binding before its positional arguments; read operands and arguments in source order",
      "Evaluate comprehension iterable in outer scope; then bind targets in the fresh inner scope",
      "ListComp evaluates each selected body eagerly in input order; GeneratorExp setup captures environment and defers bodies",
      "Binary zip prepares left then right and yields only min(left.length,right.length) pairs in order",
      "Tuple target binds left then right; own resulting environment is right::left::outer, matching target extendNames nesting",
      "range(len(weights)) resolves/evaluates the actual weights list even if empty; produce ascending integer0..n-1",
      "Subscript evaluates list then index; checks own integer and actual list bound before lookup",
      "IfExp lowers both branches, but own interpreter evaluates only condition and selected branch",
      "Each assignment evaluates RHS before binding; first RHS error stops later assignments"
    ],
    "generator_consumption": "math.fsum immediate consumption folds exact Real addition in source order. Body error ends consumption at the first selected error. No escape, resume, send/throw, generator identity, consumption by any other callee or nested mutable source effect is accepted.",
    "materialization_theorem": "For the same prepared finite iterable, captured environment, target and pure body, observeNumber(consumeGenerator g) equals the exact ordered sum observation of eager own body traversal. Prove by list induction for success and first error. Addition is total exact Real arithmetic; this does not assert CPython math.fsum rounding, effect traces or exception timing.",
    "termination": "Syntax recursion and finite list/range consumption supply only local evaluator termination. Bounded original training-loop correspondence and convergence remain separate."
  },
