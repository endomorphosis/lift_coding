  "generic_preservation_contract": {
    "observations": "Scalar uses integer/real toReal coercion; Nat/Index use independently checked own integers; vectors/matrices preserve list order and actual lengths before Fin conversion. Runtime error translation is explicit. Wrong-type/out-of-bounds errors are independently modeled and proved unreachable for accepted lowering plus related inputs, not erased by target type annotations.",
    "premises_allowed": [
      "ordinary finite exact-real input values and structural lookup/order/rectangular-shape relation",
      "fixed pure callee/global specification",
      "actual successful structural lowering"
    ],
    "premises_forbidden": [
      "successful source/target whole-expression evaluation",
      "desired list/vector/objective/gradient result",
      "model trajectory equality, minimizer or convergence",
      "pointwise desired body outputs as a caller admission premise",
      "semantic proof field in syntax/lowered program"
    ],
    "selected_error_equivalence": "State separate success/error equivalences as conclusions from the general observation equality. Source left-to-right traversal and first selected error correspond to target ordered applicative/list observation; do not assert identical evaluation traces or later-operand nonexecution in Lean.",
    "statement": "StructuralContainerEnvRel context pyEnv targetEnv -> lowerContainerAst context shape expr = .ok sourceExpr -> observeAtShape shape (evalNumericContainerAst pureRegistry pyEnv expr) = evalSourceExpr targetEnv sourceExpr."
  },
  "grammar_policy": {
    "generator_representation": "PreparedGenerator contains only raw body/target syntax, captured immutable own data environment and a separately prepared finite iterable. No SourceExpr, target evaluator, output vector, desired numerical result or preservation proof field.",
    "iterable_representation": "Own finite numeric/row sequence, ordered binary zip descriptor and ascending range descriptor. Preparing a generator resolves/evaluates its outer iterable before installing the target binder and does not evaluate body elements.",
    "list_meaning": "Finite immutable ordinary numeric list/rectangular list-of-lists data. Original syntax has ListComp and GeneratorExp, not an arbitrary List literal in the first five; arbitrary list construction remains refused.",
    "pure_callee_registry": "Retain full PyCalleeRef.name/attribute syntax. Admit only exact immutable builtin abs/max/len/zip/range, math.exp/log1p/fsum and the explicit pinned user-function _dot model. Reject aliases, shadowed/rebound global identities, arbitrary attributes and callable protocols. Source hashes alone do not establish runtime purity/bindings.",
    "reuse": "Existing immutable PyExpr/PyArgs/PyComprehension/PyTarget/PyStmt and scoped PyName; do not replace them with SourceTerm leaves or embed target evaluation/model opcodes.",
    "runtime_errors": "Fresh own runtime error family preserves inherited unknownName/divisionByZero/logDomain/unsupported tags and explicitly adds wrongValueKind, indexOutOfBounds and malformedTupleBinding. Static LowerError is a separate datatype, with source path/reason only; refusal is not a runtime exception claim.",
    "runtime_values": "Fresh independent PyDataValue(number PyNumber, boolean Bool, sequence List PyDataValue, pair PyDataValue PyDataValue) and PyDataEnvironment List(PyName×PyDataValue). Preserve source number integer/real tags internally; observations explicitly coerce both to Real. Do not edit old scalar PyValue/PyEnvironment.",
    "scalar_compatibility": "Fresh recursive own container interpreter calls only its own scalar primitive implementations/independent arithmetic (reuse numericBinary/invokePrimitive is allowed); never call evalSourceExpr/evalSourceTerm/lowerSupportedAst or model objective. Prove agreement on admitted old scalar syntax under the structurally projected scalar environment, rather than assuming an evaluation equation."
  },
  "independent_interpreter": {
    "definitions": [
      "lookupData",
      "bindTarget",
