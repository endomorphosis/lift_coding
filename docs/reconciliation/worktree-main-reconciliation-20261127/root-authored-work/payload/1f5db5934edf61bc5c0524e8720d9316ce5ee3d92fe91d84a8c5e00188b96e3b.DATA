  ],
  "total_cost_measurement": {
    "primary": "Sum per-attempt latest observed native input_tokens + output_tokens when both are known and the population is qualified. Flag aggregate completeness independently.",
    "subset_fields": "cached_input_tokens is inside input_tokens; reasoning_output_tokens is inside output_tokens. Neither is added again.",
    "diagnostics": [
      "Recorded STRING argument/output bytes and maxima",
      "Duplicate/unmatched/unclassified events",
      "Adjacent cumulative-counter deltas without turn/tool attribution",
      "Repeated broad reads and readback volume only where natively qualified",
      "Source/index freshness and expansion/capsule choices",
      "Task outcome, retries, provider attempts, wall time and refresh/training completeness"
    ],
    "unknowns": "One CLI invocation is not one model turn. Recorded output bytes are not attributable native tokens or exact network payload. Provider hard token cap, per-tool token attribution, billing total and causal effects remain unknown until independently qualified."
  },
