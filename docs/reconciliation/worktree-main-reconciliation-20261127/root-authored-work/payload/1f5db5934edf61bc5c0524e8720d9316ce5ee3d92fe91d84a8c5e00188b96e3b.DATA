      "task_plus_selected_code_and_verbose_metadata": 5911,
      "task_plus_minified_selected_display_and_compact_metadata": 3493
    },
    "interpretation": "Selecting exact task-focused source has a larger potential effect than minification. Compact metadata avoids repeating full symbol/frontier rows. Even on identical original location/hash labels, minified excerpt guidance increases 3467 to 3493 local tokens; the complete-envelope gate rejects it.",
    "qualification_limits": [
      "36 symbols are authored task-focused nominations, not verified requirement completeness",
      "35 unresolved frontier entries remain",
      "Fresh preview DuckDB stores AST/static calls/selected KG only",
      "No provider/model/prover/training/task-verifier invocation in this stage",
      "No default runtime route changed"
    ]
  },
