  "milestones": [
    {
      "id": 1,
      "priority": "next",
      "name": "Qualify and integrate whole-session accounting",
      "implementation": "Connect pure ledger only inside the existing exact-thread/cwd bounded native-usage reader after native-layout qualification. Store scalar receipts, not transcripts.",
      "acceptance": [
        "Known synthetic tool joins, non-string payloads, unknown types, duplicate/unmatched IDs, malformed usage, counter regression and bounds controls pass",
        "Native installed fixture confirms full known/missing field semantics without raw content export",
        "All attempts retained; latest cumulative snapshot counted once; unknown totals remain unavailable",
        "No claimed hard native token budget unless actual CLI/provider enforcement is qualified"
      ]
    },
