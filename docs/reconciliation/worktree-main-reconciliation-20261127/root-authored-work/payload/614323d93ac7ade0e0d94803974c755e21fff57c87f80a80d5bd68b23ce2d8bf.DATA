def case3Bucket2 : Bucket := { requests := [], rows := [], metrics := { cost := { numerator := 0, denominator := 1 }, padding := { numerator := 0, denominator := 1 }, latency := { numerator := 0, denominator := 1 }, sequential := { numerator := 0, denominator := 1 } }, before := "", after := "" }
theorem authored_case_3_accepted : modelAccept case3Bucket1 case3Bucket2 = true := by decide

