"""Current two-module metadata, real native producers and lake restart."""
from copy import deepcopy
import hashlib
import json

import pytest

from benchmarks.agent_supervisor.container_coding import terminal_revision_metadata as revision


def _sources():
    return {"caller.py": b"from callee import increment\n\ndef run(n: int) -> int:\n    return increment(n)\n\ndef dynamic(name, n):\n    return globals()[name](n)\n",
            "callee.py": "def increment(n: int) -> int:\n    \"\"\"Return café-compatible integer increment.\"\"\"\n    return n + 1\n".encode()}


def _build(sources=None):
    return revision.build_revision_metadata(sources=_sources() if sources is None else sources,
                                            repository_id="public-two-module-fixture")


def test_native_metadata_is_deterministic_complete_and_advisory():
    sources = _sources()
    first = _build(sources)
    second = _build(dict(reversed(list(sources.items()))))
    assert first == second
    assert set(first) == {"records", "source_snapshot", "dependency_edges"}
    snapshot, records = first["source_snapshot"], first["records"]
    assert snapshot["whole_supplied_scope"] is True and snapshot["source_count"] == 2
    assert snapshot["records_sha256"] == revision._identity(records)
    assert {row["path"]: row["source_text"].encode() for row in records["source_files"]} == sources
    assert records["ast"] and records["kg"] and records["vectors"] and records["contracts"]
    assert {row["path"] for row in records["native_ast_indexes"][0]["results"]} == set(sources)
    assert all(row["learned"] is False and row["proof_authority"] is False for row in records["vectors"])
    assert records["provenance"][0]["vector_training_steps"] == 0
    assert records["provenance"][0]["source_body_executed"] is False
    assert records["provenance"][0]["formal_projection_attempted"] is False
    assert snapshot["proof_authority"] is False
    pins = snapshot["producer"]["files"]
    assert any(row["path"].endswith("terminal_revision_metadata.py") for row in pins)
    assert any(row["path"].endswith("program_ast_adapters.py") for row in pins)


def test_import_and_call_edges_bind_both_original_source_versions():
    result = _build()
    edges = [row for row in result["dependency_edges"] if row["target_path"] == "callee.py"]
    assert {row["kind"] for row in edges} == {"import", "call"}
    assert all(row["resolution"] == "static_syntax" for row in edges)
    assert all(row["target_source_sha256"] == hashlib.sha256(_sources()["callee.py"]).hexdigest() for row in edges)
    assert all(row["semantic_authority"] is False and row["source_semantics_verified"] is False for row in edges)
    assert any(row["source_symbol"] == "run" and row["target_symbol"] == "increment" for row in edges)


def test_callee_change_invalidates_revision_records_and_dependent_edges():
    original = _build()
    changed = _sources()
    changed["callee.py"] = changed["callee.py"].replace(b"n + 1", b"n + 2")
    successor = _build(changed)
    assert original["source_snapshot"]["revision_id"] != successor["source_snapshot"]["revision_id"]
    assert original["source_snapshot"]["records_sha256"] != successor["source_snapshot"]["records_sha256"]
    before = {row["edge_id"] for row in original["dependency_edges"] if row["target_path"] == "callee.py"}
    after = {row["edge_id"] for row in successor["dependency_edges"] if row["target_path"] == "callee.py"}
    assert before and after and before.isdisjoint(after)
    assert next(row for row in original["source_snapshot"]["sources"] if row["path"] == "caller.py") == next(
        row for row in successor["source_snapshot"]["sources"] if row["path"] == "caller.py")


def test_dependency_edge_change_retains_unknown_target_as_frontier():
    sources = _sources()
    original = _build(sources)
    sources["caller.py"] = sources["caller.py"].replace(b"from callee import increment", b"from absent import increment")
    changed = _build(sources)
    assert original["dependency_edges"] != changed["dependency_edges"]
    imported = next(row for row in changed["dependency_edges"] if row["kind"] == "import")
    assert imported["target_path"] is None and imported["resolution"] == "unresolved"
    assert changed["records"]["unsupported"]
    assert not any(row["resolution"] == "static_syntax" and row["kind"] == "call" for row in changed["dependency_edges"])


def test_every_source_unit_and_frontier_has_exact_utf8_span_and_provenance():
    sources = _sources()
    result = _build(sources)
    for row in [*result["records"]["source_units"], *result["records"]["unsupported"], *result["records"]["contracts"]]:
        raw = sources[row["path"]]
        span = row["span"]
        assert span["sha256"] == hashlib.sha256(raw[span["start_byte"]:span["end_byte"]]).hexdigest()
        assert row["source_sha256"] == hashlib.sha256(raw).hexdigest()
        assert row["proof_authority"] is False
    frontier = next(row for row in result["records"]["unsupported"] if row["reason"] == "dynamic_dispatch")
    assert frontier["source_symbol"] == "dynamic" and frontier["retained"] is True
    assert frontier["expression"] == "globals()[name]"
    contract = next(row for row in result["records"]["contracts"] if row["qualified_symbol"] == "increment")
    assert "café" in contract["docstring"] and contract["return_annotation"] == "int"


@pytest.mark.parametrize("body", [b"def run(increment, n):\n    return increment(n)\n",
                                  b"def run(n):\n    increment = n\n    return increment(n)\n"])
def test_shadowed_import_is_not_resolved(body):
    sources = _sources()
    sources["caller.py"] = b"from callee import increment\n" + body
    result = _build(sources)
    assert all(row["resolution"] != "static_syntax" for row in result["dependency_edges"] if row["kind"] == "call")
    assert result["records"]["unsupported"]


def test_class_body_shadowed_import_is_not_resolved():
    sources = _sources()
    sources["caller.py"] = (b"from callee import increment\nclass C:\n"
        b"    def increment(n):\n        return n + 10\n    value = increment(1)\n")
    result = _build(sources)
    assert all(row["resolution"] != "static_syntax" for row in result["dependency_edges"] if row["kind"] == "call")


def test_original_producer_stat_witness_rejects_same_byte_write_restore(tmp_path, monkeypatch):
    # Only a fresh synthetic producer file is written; genuine native modules
    # and the implementation under test remain unchanged.
    producer = tmp_path / "terminal_revision_metadata.py"
    producer.write_bytes(b"# public synthetic producer witness\n")
    original = revision._syntax

    def mutate(*args):
        raw = producer.read_bytes()
        producer.write_bytes(raw)
        return original(*args)

    monkeypatch.setattr(revision, "__file__", str(producer))
    monkeypatch.setattr(revision, "_syntax", mutate)
    with pytest.raises(revision.RevisionMetadataError, match="producer changed"):
        _build()


def test_target_source_is_never_imported_or_executed(tmp_path):
    marker = tmp_path / "target-imported"
    sources = {"callee.py": ("raise RuntimeError('target source must not execute')\n"
        "def increment(n):\n    return n + 1\n").encode(),
        "caller.py": (f"from pathlib import Path\nPath({str(marker)!r}).write_text('executed')\n"
                      "from callee import increment\n").encode()}
    result = _build(sources)
    assert not marker.exists()
    assert result["source_snapshot"]["source_body_executed"] is False
    assert any(row["node_kind"] == "Raise" for row in result["records"]["unsupported"])


@pytest.mark.parametrize("sources", [{}, {"../escape.py": b"x=1\n"}, {"/absolute.py": b"x=1\n"},
                                     {"dir//x.py": b"x=1\n"}, {"x.txt": b"x=1\n"},
                                     {"x.py": "x=1\n"}, {"x.py": b"\xff"},
                                     {"x.py": b"def broken(:\n"}, {"x.py": b""}])
def test_malformed_or_foreign_source_scope_is_rejected(sources):
    with pytest.raises(revision.RevisionMetadataError):
        _build(sources)


def test_file_byte_total_node_and_repository_bounds_reject_before_native_work(monkeypatch):
    for sources, limit, amount in [({f"s{i}.py": b"x=1\n" for i in range(2)}, "files", 1),
                                   ({"x.py": b"x=1\n"}, "source_bytes", 3),
                                   ({"x.py": b"x=1\n"}, "total_source_bytes", 3),
                                   ({"x.py": b"x=1\n"}, "ast_nodes", 1)]:
        with monkeypatch.context() as patch:
            patch.setitem(revision.LIMITS, limit, amount)
            with pytest.raises(revision.RevisionMetadataError, match="bound|bounded"):
                _build(sources)
    for repository_id in ["", " padded", "newline\n", "a" * 513, None]:
        with pytest.raises(revision.RevisionMetadataError):
            revision.build_revision_metadata(sources=_sources(), repository_id=repository_id)


def test_native_duckdb_and_ducklake_hydration_independent_restart_preserves_all_families(tmp_path):
    from benchmarks.agent_supervisor.container_coding import codebase_ir_metadata as metadata
    from benchmarks.agent_supervisor.container_coding.terminal_codebase_supervisor_fixture import (
        bound_terminal_codebase_metadata_records, reconstruct_terminal_codebase_metadata_records,
    )
    current = _build()
    bounded = bound_terminal_codebase_metadata_records(current["records"])
    output = tmp_path / "revision-metadata"
    report = metadata.hydrate_codebase_ir_metadata(records=bounded, output=output,
                                                   source_snapshot=current["source_snapshot"])
    assert report["fresh_process_readback"]["verified"] is True
    replay = metadata.validate_codebase_ir_metadata(output=output, expected=report, fresh_process=True)
    assert replay == report
    restored = {family: [json.loads(line)["payload"] for line in
                        (output / descriptor["relative_path"]).read_text().splitlines()]
                for family, descriptor in replay["exports"].items()}
    assert reconstruct_terminal_codebase_metadata_records(restored) == current["records"]
    assert report["qualification"]["proof_authority"] is False
    assert report["lake_layout"]["typed_vector_columns"] is False
    assert list((output / "lake/data").rglob("*.parquet"))
    wrong = deepcopy(report)
    wrong["source_snapshot_sha256"] = "sha256:" + "0" * 64
    with pytest.raises(metadata.MetadataError, match="expected metadata binding"):
        metadata.validate_codebase_ir_metadata(output=output, expected=wrong)
