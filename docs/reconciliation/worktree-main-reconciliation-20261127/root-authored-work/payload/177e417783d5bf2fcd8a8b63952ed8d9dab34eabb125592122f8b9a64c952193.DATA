#!/usr/bin/env python3
"""Freeze a coherent runtime and run isolated native producer/consumer services."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import time

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[5]
EVALS = HERE.parents[1]

def sha(data): return hashlib.sha256(data).hexdigest()
def canon(obj): return json.dumps(obj, sort_keys=True, separators=(",", ":")).encode()
def write(path, obj): path.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=HERE / "results_v1")
    parser.add_argument("--datasets-root", type=Path)
    parser.add_argument("--semantic-scope", choices=("all", "bounded"), default="all")
    parser.add_argument("--identity-checks", action="store_true")
    args = parser.parse_args()
    if args.output.exists(): raise SystemExit("output exists; use a new version")
    out = args.output.resolve(); out.mkdir(parents=True)
    aseh = ROOT / ".worktrees/agent-supervisor-efficiency-and-state-hardening-v1"
    roots = {"ipfs_accelerate_py": aseh, "ipfs_datasets_py": aseh / "ipfs_datasets_py", "ipfs_kit_py": aseh / "ipfs_kit_py"}
    original_heads = {k: subprocess.check_output(["git", "-C", str(v), "rev-parse", "HEAD"], text=True).strip() for k, v in roots.items()}
    if args.datasets_root: roots["ipfs_datasets_py"] = args.datasets_root.resolve()
    runtime_files = {}
    for name, base in roots.items():
        for path in sorted((base / name).rglob("*")):
            if path.is_file() and path.suffix in {".py", ".json"} and "__pycache__" not in path.parts:
                runtime_files[str(path)] = sha(path.read_bytes())
    pythonpath = [str(roots[k]) for k in ("ipfs_datasets_py", "ipfs_kit_py", "ipfs_accelerate_py")]
    source_manifest = {"roots": {k: str(v) for k, v in roots.items()}, "pythonpath": pythonpath, "files": runtime_files, "source_basis_git_heads": original_heads, "datasets_variant_manifest_sha256": sha((HERE / "runtime_merkle_index_v1_manifest.json").read_bytes()) if args.datasets_root else None}
    write(out / "runtime_source_manifest.json", source_manifest)
    registry_path = EVALS / "next_stage_candidate_registry.json"
    registry = json.loads(registry_path.read_text())
    protocol = json.loads((HERE / "protocol.json").read_text())
    candidates = [c for c in registry["historical_candidates"] if c["task_id"] in protocol["cohort"]]
    assert [c["task_id"] for c in candidates] == protocol["cohort"]
    jobs = []
    for case in candidates:
        folder = out / case["task_id"]; folder.mkdir()
        tree = ROOT / case["public_tree"]["path"]
        archive_path = ROOT / case["public_archive"]["path"]
        assert sha(archive_path.read_bytes()) == case["public_archive"]["sha256"]
        files = {}; opaque_links = {}
        with tarfile.open(archive_path, "r:gz") as archive:
            for member in archive.getmembers():
                if member.isdir(): continue
                parts = Path(member.name).parts
                assert len(parts) > 1 and ".." not in parts and not member.name.startswith("/")
                relative = "/".join(parts[1:]); path = tree / relative
                if member.issym():
                    assert path.is_symlink() and os.readlink(path) == member.linkname
                    opaque_links[relative] = {"link_target": member.linkname, "sha256": sha(member.linkname.encode()), "policy": "do not follow; preserve as explicit unresolved source metadata"}
                    continue
                assert member.isfile(), "unsupported non-regular archive member"
                raw = archive.extractfile(member).read()
                assert not path.is_symlink() and sha(path.read_bytes()) == sha(raw)
                files[relative] = {"sha256": sha(raw), "bytes": len(raw), "executable": bool(path.stat().st_mode & 0o111)}
        actual = {str(p.relative_to(tree)) for p in tree.rglob("*") if p.is_file() and not p.is_symlink()}
        assert actual == set(files), "cached tree has undeclared files"
        assert {str(p.relative_to(tree)) for p in tree.rglob("*") if p.is_symlink()} == set(opaque_links)
        # Git builds a tree for these actual public bytes/modes, without changing the cached tree.
        gitdir = folder / "source_objects.git"
        subprocess.run(["git", "init", "--bare", "--quiet", str(gitdir)], check=True)
        git = ["git", "--git-dir=" + str(gitdir), "--work-tree=" + str(tree)]
        subprocess.run(git + ["-c", "core.autocrlf=false", "add", "--all", "--force", "."], cwd=tree, check=True)
        tree_oid = subprocess.check_output(git + ["write-tree"], cwd=tree, text=True).strip()
        source = {"task_id": case["task_id"], "tree": str(tree), "files": files, "opaque_symlinks": opaque_links, "computed_git_tree_oid": tree_oid, "git_tree_provenance": "new Git tree of exact public cached archive bytes/modes; upstream commit tree not independently fetched or authenticated", "archive_sha256": case["public_archive"]["sha256"], "original_pre_fix_commit_claim": case["pre_fix_commit"]}
        write(folder / "public_source_manifest.json", source)
        write(folder / "case.json", case)
        jobs.append({"task_id": case["task_id"], "folder": str(folder), "case_sha256": sha((folder / "case.json").read_bytes()), "source_manifest_sha256": sha((folder / "public_source_manifest.json").read_bytes())})
    bindings = {p.name: sha(p.read_bytes()) for p in (HERE / "protocol.json", Path(__file__), HERE / "native_service.py")}
    freeze = {"schema": "ns-integrated-context-service-freeze/v1", "frozen_at_unix": time.time(), "evaluation_sources": bindings, "registry_sha256": sha(registry_path.read_bytes()), "runtime_manifest_sha256": sha((out / "runtime_source_manifest.json").read_bytes()), "jobs": jobs, "semantic_scope": args.semantic_scope, "identity_checks": args.identity_checks, "provider_calls": 0}
    write(out / "freeze.json", freeze)
    env = {k: os.environ[k] for k in ("PATH", "LANG", "LC_ALL", "HOME") if k in os.environ}
    env.update(PYTHONPATH=os.pathsep.join(pythonpath), PYTHONDONTWRITEBYTECODE="1", IPFS_ACCEL_SKIP_CORE="1", GIT_CEILING_DIRECTORIES=str(ROOT / "papers/completion/runtime_bootstrap/unblock_20260912/ns_baselines/source_cache"))
    executions = []
    for job in jobs:
        for role in ("produce", "consume"):
            command = ["/usr/bin/python3", "-B", str(HERE / "native_service.py"), role, "--run", str(out), "--case", job["task_id"]]
            started = time.perf_counter()
            try:
                result = subprocess.run(command, cwd="/tmp", env=env, capture_output=True, text=True, timeout=600)
            except subprocess.TimeoutExpired as exc:
                folder = Path(job["folder"])
                (folder / (role + ".stdout")).write_bytes(exc.stdout or b"")
                (folder / (role + ".stderr")).write_bytes(exc.stderr or b"")
                write(folder / (role + "_process.json"), {"role": role, "task_id": job["task_id"], "command": command, "timed_out": True, "returncode": None, "wall_seconds": time.perf_counter() - started, "bound_seconds": 600})
                raise SystemExit("bounded service timed out; partial result retained")
            folder = Path(job["folder"])
            (folder / (role + ".stdout")).write_text(result.stdout)
            (folder / (role + ".stderr")).write_text(result.stderr)
            receipt = {"role": role, "task_id": job["task_id"], "command": command, "returncode": result.returncode, "wall_seconds": time.perf_counter() - started}
            write(folder / (role + "_process.json"), receipt); executions.append(receipt)
            print(json.dumps(receipt), flush=True)
            if result.returncode: raise SystemExit("service failed; preserve this run and rerun into a new version")
    assert all(sha(Path(path).read_bytes()) == expected for path, expected in runtime_files.items())
    rows = [{"task_id": j["task_id"], "producer": json.loads((Path(j["folder"]) / "producer.json").read_text()), "consumer": json.loads((Path(j["folder"]) / "consumer.json").read_text())} for j in jobs]
    summary = {"schema": "ns-integrated-context-qualification-result/v1", "freeze_sha256": sha((out / "freeze.json").read_bytes()), "runtime_unchanged_after_services": True, "rows": rows, "processes": executions, "all_roundtrips_passed": all(r["consumer"]["all_checks_passed"] for r in rows), "provider_calls": 0, "ready_full_caller": False, "quality_or_token_savings_claim": False}
    write(out / "summary.json", summary)
    print(json.dumps({"all_roundtrips_passed": summary["all_roundtrips_passed"], "provider_calls": 0}), flush=True)

if __name__ == "__main__": main()
