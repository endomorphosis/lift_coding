   if not p.is_file():continue
   target=snapshot/repo/p.relative_to(base);target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(p.read_bytes());sources[str(p)]={'snapshot':str(target.relative_to(snapshot)),'sha256':sha(p)}
