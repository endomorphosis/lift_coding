  "current_indexed_default_payload": {
    "capsule_ast_details": "PythonAnalyzer puts normalized _projection(node) in symbol.metadata.facets[].version_evidence. The capsule compiler preserves this field through _authoritative_metadata. It can contain the selected function implementation AST. _ChildProjection removes separately addressable nested definitions; class member functions become interface records, so it is not a complete file/class AST or literal source excerpt.",
    "capsule_ast_source_files": [
      "ipfs_datasets_py/logic/software_contracts/semantic_index/python_analysis.py:_ChildProjection,_projection,PythonAnalyzer",
      "ipfs_datasets_py/logic/software_contracts/semantic_state/capsules.py:_authoritative_metadata,compile_capsule",
      "ipfs_datasets_py/logic/software_contracts/semantic_state/models.py:SemanticCapsule.identity_payload"
    ],
    "capsule_limit": 8,
    "capsules": "Only selected capsule dictionaries are embedded (at most 8 for indexed-default@1 and possibly fewer after byte-budget repacking), with parallel admission dictionaries. Capsule first-class fields include signature, annotations, defaults, decorators, contracts, effects, exceptions, references, docstring hint, source path/CID and metadata; there is no dedicated raw source-text excerpt field.",
    "correction": "Presence of raw_sources, capsules and pack does not establish that the whole repository or all source bodies are repeatedly sent. Some structured facts/identifiers can overlap, but their actual serialized/provider-token costs require a content-free census.",
    "duplication_measured": false,
    "pack": "ContextPackResult.to_dict embeds pack identity, references with short summaries/metadata, token estimate, coverage status, budget flag and decisions. It repeats some source/capsule identities and admission metadata; it does not blindly embed a second copy of every complete raw source or every complete capsule AST.",
    "provider_transport": "The runner sends verified semantic transport: native_context retains other evidence, translated_semantic contains this bounded worker payload with approved identifier aliases, and native_suffix remains literal. Doctor/public instruction, workspace/helper guidance and reply contract are composed afterward; metadata projection/tokenizer selection can choose another exactly reconstructible representation. Optional source-view guidance currently adds no code text.",
    "raw_sources_rule": "With nonempty worker_query, start with required_raw_paths; for explicit program_paths add captured non-program support except deferred task data. Optional program source bytes are omitted and identified in worker_projection.raw_source_fetch_required. This is a scoped selection, not the entire repository.",
    "selector": "duckdb-query-symbol-name@1",
    "source_files_inspected": [
