  },
  "qualification_gate": "Do not start another expensive paired rendering trial until authored exact-input replay demonstrates at least one compact source view in the real coding input. Zero optional helper calls are acceptable for input-inclusion measurement but insufficient for an edit-cycle adoption claim.",
  "schema": "terminal-source-view-next-phase-plan@1",
  "smallest_correct_integration": {
    "eligibility": "Visible supported Python symbols only, inside the original program_paths and complete manifest. Skip paths already supplied as required exact raw source. Preserve every existing raw-source obligation and literal instruction. If there is no eligible compact view, mark the experiment ineligible before a provider call rather than relabeling an unchanged input as a treatment.",
    "extra_context_risk": "The additive read block can overlap implementation information already present in selected capsule metadata.facets[].version_evidence. This first change proves actual presentation and matched rendering; it does not remove existing AST evidence or guarantee lower tokens than the current indexed baseline.",
    "measurement": "Source-view inclusion is established by exact reconstructed dispatched bytes containing at least one treatment view. It is separate from optional helper-operation receipts and cannot prove that the model reasoned from that view.",
    "new_module": "ipfs_accelerate_py/agent_supervisor/runtime/source_input_view.py",
    "placement": "Append one deterministic source-read block to router_prompt and required_suffix after canonical semantic verification and public instruction inclusion, before render_model_prompt and coding reply contract. Include the identical block in native/tokenizer fallback. No rewrite of canonical native prompt or translated_semantic.raw_sources.",
    "proposed_functions": [
      "build_source_input_view",
      "replay_source_input_view_for_audit",
      "validate_source_input_view_receipt"
    ],
    "receipt_fields": [
      "schema",
      "policy",
      "renderer_sha256",
      "renderer_version",
      "python_toolchain_identity",
      "task_id",
      "scope_cid",
      "semantic_root_cid",
      "native_capsule_id",
      "native_prompt_sha256",
      "source_manifest_sha256",
      "ordered_selection_sha256",
      "source_bindings",
      "per_view_requested_and_actual_format",
      "per_view_source_and_content_sha256",
      "per_view_bytes",
      "source_read_block_sha256",
      "source_read_block_bytes",
      "views_included",
      "compact_views_included",
      "fallback_reasons",
      "complete_model_prompt_sha256",
      "complete_model_prompt_bytes",
      "semantic_equivalence_claimed=false",
      "proof_authority=false",
      "completion_authority=false"
    ],
    "rendering": "Extract a pure bounded bytes-to-view renderer from code_source_view so online construction and historical audit share exact rendering without reading the mutable worktree. Preserve names, literals and docstrings; compile without executing and require AST equality. For unsupported scopes, directives or layout use a recorded raw fallback or declare ineligible. Do not change producer capsule/proof content or reissue their identities.",
    "selection": "Use one frozen ordered list derived from verified worker_projection.selected_symbols and the same selected capsule population in both arms. Map producer stable_symbol_id to path and qualified_name explicitly; helper path::qualified_name is a separate identifier namespace. Never discover additional repository paths. Producer qualified names include the module prefix; map to the helper local qualified name only through verified path/module identity and symbol facts, never by arbitrary suffix matching.",
    "source_reader": "Read retained blocks through the already verified semantic source CID mapping; match SHA256 and CID. At dispatch also verify corresponding allocated coding-worktree bytes and canonical semantic repository bytes against the same manifest, then recheck before dispatch. Historical replay uses retained blocks only and grants no current-source freshness.",
    "wire_schema": "supervisor-source-read-input@1"
  },
