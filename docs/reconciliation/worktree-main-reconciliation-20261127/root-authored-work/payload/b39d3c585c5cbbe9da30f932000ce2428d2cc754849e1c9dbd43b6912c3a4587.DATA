import ObjectiveContainerPreservation

set_option backward.isDefEq.respectTransparency false

/-!
SOURCE-ONLY, UNCOMPILED, UNQUALIFIED CANDIDATE.

Generic coordinate bridges for the compositional exact-real container backend.
Body-success assumptions describe primitive partial evaluation at actual input
coordinates. They are not premises asserting the desired objective, gradient,
source/compiler equivalence, model convergence, or task satisfaction.

Minimum zip dimensions are retained, with explicit finite embeddings into both
inputs. The conversion wrappers already derive list length from successful
traversal before construction of a finite vector. These lemmas identify that
vector with independently supplied primitive body results.

No Python Float/libm/math.fsum refinement, external decoder theorem, original
preparation/objective/gradient/convergence theorem, metadata admission, or
planner activation is claimed. All theorem bodies below await native checking.
-/

namespace RankerObjectiveContainerEvaluationBridge

noncomputable section

open scoped BigOperators
open RankerObjectiveIR (SliceError mapOne)
open RankerObjectiveContainerIR (mapExact zipMapExact orderedFsum)
open RankerObjectiveContainerLanguage (vectorOfList mapToVector zipToVector)

def leftZipIndex {leftLength rightLength : ℕ}
    (index : Fin (min leftLength rightLength)) : Fin leftLength :=
  ⟨index.val, Nat.lt_of_lt_of_le index.isLt (Nat.min_le_left _ _)⟩

def rightZipIndex {leftLength rightLength : ℕ}
    (index : Fin (min leftLength rightLength)) : Fin rightLength :=
  ⟨index.val, Nat.lt_of_lt_of_le index.isLt (Nat.min_le_right _ _)⟩

/-- List conversion recovers the entire finite function, regardless of the
proof term obtained from successful traversal. -/
theorem vectorOfList_ofFn {length : ℕ} (values : Fin length → ℝ)
    (sameLength : (List.ofFn values).length = length) :
    vectorOfList (List.ofFn values) sameLength = values := by
  funext index
  simp [vectorOfList, List.get_ofFn]

theorem mapToVector_ofFn_success {α : Type} {length : ℕ}
    (body : α → Except SliceError ℝ) (inputs : Fin length → α) (outputs : Fin length → ℝ)
    (success : ∀ index, body (inputs index) = .ok (outputs index)) :
    mapToVector body inputs = .ok outputs := by
  have accepted := RankerObjectiveContainerIR.map_exact_ofFn_success body inputs outputs success
  unfold mapToVector
  split
  · rename_i problem equation
    have impossible : (Except.error problem : Except SliceError (List ℝ)) = .ok (List.ofFn outputs) :=
      equation.symm.trans accepted
    cases impossible
  · rename_i observed equation
    have sameOutputs := Except.ok.inj (equation.symm.trans accepted)
    subst observed
    rw [vectorOfList_ofFn]

/-- Partial zip traverses exactly the pairs generated by pure ordered zip.
The inductive equality preserves the first error and shorter-input truncation. -/
theorem zipMapExact_eq_mapExact_zipWith {α β γ : Type}
    (body : α → β → Except SliceError γ) (left : List α) (right : List β) :
    zipMapExact body left right =
      mapExact (fun pair : α × β => body pair.1 pair.2) (List.zipWith Prod.mk left right) := by
  induction left generalizing right with
  | nil => rfl
  | cons first rest ih =>
    cases right with
    | nil => rfl
    | cons rightFirst rightRest =>
      simp only [zipMapExact, List.zipWith, mapExact]
      rw [ih rightRest]

/-- Pure zip coordinates embed into both original input domains. No premise
equating the input lengths is introduced. -/
theorem zipWith_ofFn_min {α β γ : Type} {leftLength rightLength : ℕ}
    (body : α → β → γ) (left : Fin leftLength → α) (right : Fin rightLength → β) :
    List.zipWith body (List.ofFn left) (List.ofFn right) =
      List.ofFn (fun index : Fin (min leftLength rightLength) =>
        body (left (leftZipIndex index)) (right (rightZipIndex index))) := by
  apply List.ext_getElem
  · simp only [List.length_zipWith, List.length_ofFn]
  · intro index leftBound rightBound
    simp only [List.getElem_zipWith, List.getElem_ofFn, leftZipIndex, rightZipIndex]

/-- Only existing paired coordinates require body success. There is no
all-cross-product body-success condition, and unequal lengths remain valid. -/
theorem zipMapExact_ofFn_min_success {α β : Type} {leftLength rightLength : ℕ}
    (body : α → β → Except SliceError ℝ)
    (left : Fin leftLength → α) (right : Fin rightLength → β)
    (outputs : Fin (min leftLength rightLength) → ℝ)
    (success : ∀ index, body (left (leftZipIndex index)) (right (rightZipIndex index)) =
      .ok (outputs index)) :
    zipMapExact body (List.ofFn left) (List.ofFn right) = .ok (List.ofFn outputs) := by
  rw [zipMapExact_eq_mapExact_zipWith, zipWith_ofFn_min]
  exact RankerObjectiveContainerIR.map_exact_ofFn_success
    (fun pair : α × β => body pair.1 pair.2)
    (fun index : Fin (min leftLength rightLength) =>
      (left (leftZipIndex index), right (rightZipIndex index))) outputs success

theorem zipToVector_ofFn_min_success {α β : Type} {leftLength rightLength : ℕ}
    (body : α → β → Except SliceError ℝ)
    (left : Fin leftLength → α) (right : Fin rightLength → β)
    (outputs : Fin (min leftLength rightLength) → ℝ)
    (success : ∀ index, body (left (leftZipIndex index)) (right (rightZipIndex index)) =
      .ok (outputs index)) :
    zipToVector body left right = .ok outputs := by
  have accepted := zipMapExact_ofFn_min_success body left right outputs success
  unfold zipToVector
  split
  · rename_i problem equation
    have impossible : (Except.error problem : Except SliceError (List ℝ)) = .ok (List.ofFn outputs) :=
      equation.symm.trans accepted
    cases impossible
  · rename_i observed equation
    have sameOutputs := Except.ok.inj (equation.symm.trans accepted)
    subst observed
    rw [vectorOfList_ofFn]

theorem orderedFsum_ofFn_eq_sum {length : ℕ} (values : Fin length → ℝ) :
    orderedFsum (List.ofFn values) = ∑ index, values index := by
  rw [RankerObjectiveContainerIR.orderedFsum_eq_sum, List.sum_ofFn]

theorem orderedFsum_map_success {α : Type} {length : ℕ}
    (body : α → Except SliceError ℝ) (inputs : Fin length → α) (outputs : Fin length → ℝ)
    (success : ∀ index, body (inputs index) = .ok (outputs index)) :
    mapOne (fun values : Fin length → ℝ => orderedFsum (List.ofFn values))
      (mapToVector body inputs) = .ok (∑ index, outputs index) := by
  rw [mapToVector_ofFn_success body inputs outputs success]
  simp only [mapOne, orderedFsum_ofFn_eq_sum]

theorem orderedFsum_zip_success {α β : Type} {leftLength rightLength : ℕ}
    (body : α → β → Except SliceError ℝ)
    (left : Fin leftLength → α) (right : Fin rightLength → β)
    (outputs : Fin (min leftLength rightLength) → ℝ)
    (success : ∀ index, body (left (leftZipIndex index)) (right (rightZipIndex index)) =
      .ok (outputs index)) :
    mapOne (fun values : Fin (min leftLength rightLength) → ℝ => orderedFsum (List.ofFn values))
      (zipToVector body left right) = .ok (∑ index, outputs index) := by
  rw [zipToVector_ofFn_min_success body left right outputs success]
  simp only [mapOne, orderedFsum_ofFn_eq_sum]

#print axioms vectorOfList_ofFn
#print axioms mapToVector_ofFn_success
#print axioms zipMapExact_eq_mapExact_zipWith
#print axioms zipWith_ofFn_min
#print axioms zipMapExact_ofFn_min_success
#print axioms zipToVector_ofFn_min_success
#print axioms orderedFsum_ofFn_eq_sum
#print axioms orderedFsum_map_success
#print axioms orderedFsum_zip_success

end

end RankerObjectiveContainerEvaluationBridge
