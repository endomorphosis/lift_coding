 argv=['docker','--host=unix:///var/run/docker.sock','run','--rm','--network=none','--read-only','--cap-drop=ALL','--security-opt=no-new-privileges','--cpus=1','--memory=2g','--pids-limit=32','--user',str(os.getuid())+':'+str(os.getgid()),'--tmpfs','/tmp:rw,nosuid,nodev,size=268435456','--mount','type=bind,src='+str(source)+',dst=/candidate,readonly','--mount','type=bind,src='+str(driver)+',dst=/driver/a/b/c/d/e/driver.py,readonly','--mount','type=bind,src='+str(private)+',dst=/results','--workdir=/candidate','--entrypoint=/usr/bin/env',image,'-i','HOME=/tmp','PATH=/usr/local/bin:/usr/bin:/bin','PYTHONDONTWRITEBYTECODE=1','python3','-I','-B','/driver/a/b/c/d/e/driver.py','--run','/results','--worker',uid]
 start=time.monotonic()
 with (private/'stdout.private').open('wb') as o,(private/'stderr.private').open('wb') as e:p=subprocess.run(argv,stdout=o,stderr=e,timeout=60)
 elapsed=time.monotonic()-start;P.dump(private/'execution.json',{'argv':argv,'returncode':p.returncode,'elapsed_seconds':elapsed});result=json.loads((private/(uid+'.json')).read_text()) if p.returncode==0 else {}
 r={'schema':'ns-oauth-supplement-public-result/v2','public_probe_completed':p.returncode==0,'public_examples':result.get('cases'),'public_examples_passed':result.get('passed'),'public_probe_elapsed_seconds':elapsed,'source_unchanged':P.inventory(source)==inventory,'candidate_source_tree_sha256':prior['candidate_source_tree_sha256'],'retained_native_success':prior['native_success'],'retained_native_receipt_sha256':prior['native_receipt_sha256'],'combined_acceptance_qualified':False,'new_native_grader_calls':0,'new_public_probe_processes':1,'provider_calls':0};P.dump(O/'summary.json',r);print(json.dumps(r,sort_keys=True))
