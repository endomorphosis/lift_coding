 '- [Retained supplemental native attempt](oauth_supplement_v1/retained_attempt_v1.json)',
 '- [Public base source index](public_bases_v1/admission.json)',
 ''
 ]
 (H/'ACCEPTANCE_REPORT.md').write_text('\n'.join(lines))
 print(json.dumps({'admission_sha256':sha(E/'admission_v1.json'),'declaration_sha256':sha(H/'endpoint_declaration_v2.json'),'audit_sha256':sha(H/'audit_v1/summary.json'),'quality_cost_projection_sha256':sha(E/'quality_cost_projection_v1.json'),'report_sha256':sha(H/'ACCEPTANCE_REPORT.md')}))
