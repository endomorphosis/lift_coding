"""Bounded native implementation command dispatched through the shared router.

The supervisor owns worktree allocation, credentials isolation, validation and
completion. This runner performs one pinned coding-provider invocation in the
current worktree and retains native usage; it grants no task completion.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import uuid


OBSERVATION_SCHEMA = "supervisor-model-input-observation@1"
OBSERVATION_FIELDS = frozenset({
    "schema", "observation_id", "status", "error_type", "requested_provider", "requested_model",
    "reasoning_effort", "purpose", "prompt_sha256", "prompt_bytes", "native_prompt_sha256",
    "native_prompt_bytes", "model_prompt_sha256", "model_prompt_bytes", "workspace_advisory_sha256",
    "workspace_advisory_bytes", "workspace", "router_prompt_sha256", "router_prompt_bytes",
    "semantic_transport", "intent_requirements_transport", "code_retrieval_codec",
    "code_retrieval_wire_delivery", "code_retrieval_projection", "semantic_context_verification",
    "semantic_translation", "doctor_residual_context", "public_instruction",
    "reviewed_source_nomination_context", "timeout_seconds", "requested_output_tokens",
    "provider_attempted", "router_calls", "usage", "native_rollout_usage", "execution_authority",
    "proof_authority", "completion_authority", "external_container_boundary",
    "final_custody_guard_verified", "wire_delivery_post_observation_verified",
    "wire_delivery_cleanup_status", "seconds",
})


def _observation_custody_guard(*, prompt, repository, instruction_artifact, instruction_receipt,
                              residual_artifact=None):
    """Retain public input witnesses without activating an owner metadata index."""
    from .code_source_inspection import _PublicCapture
    from .compact_code_retrieval import _native
    from .supervisor_meta_index import public_replay_without_metadata
    from .verified_code_retrieval_projection import _semantic_scope
    with public_replay_without_metadata():
        capsule, _ = _native(prompt)
        scope = _semantic_scope(capsule)
        capture = _PublicCapture(repository)
        for path, digest in scope.items():
            raw = capture.read(path, 2_000_000)
            if hashlib.sha256(raw).hexdigest() != digest:
                raise ValueError("observed semantic source differs from verified source inventory")
        for row in capsule["evidence"]:
            if row.get("kind") in {"semantic-context", "code-retrieval-context"}:
                capture.read(row["path"], 2_000_000)
        artifact = Path(instruction_artifact).relative_to(repository).as_posix()
        raw = capture.read(artifact, 2_000_000)
        if hashlib.sha256(raw).hexdigest() != instruction_receipt["artifact_sha256"]:
            raise ValueError("observed public instruction artifact differs")
        raw = capture.read(instruction_receipt["source_path"], 32768)
        if hashlib.sha256(raw).hexdigest() != instruction_receipt["source_sha256"]:
            raise ValueError("observed literal public instruction differs")
        if residual_artifact is not None:
            capture.read(Path(residual_artifact).relative_to(repository).as_posix(), 2_000_000)
        capture.verify_originals()
    def verify():
        with public_replay_without_metadata():
            capture.verify_originals()
    return verify


def _wire_delivery_root() -> Path:
    from .code_retrieval_wire_delivery import DEFAULT_DELIVERY_ROOT
    return DEFAULT_DELIVERY_ROOT


def render_model_prompt(*, prompt: str, purpose: str, workspace: Path,
                        semantic_transport: bool = False,
                        code_retrieval_projected: bool = False) -> tuple[str, str]:
    """Preserve native task bytes while making the allocated coding path explicit."""
    if purpose not in {"planning", "coding"}:
        raise ValueError("explicit planning or coding purpose required")
    if purpose == "planning":
        return prompt, ""
    location = json.dumps(str(workspace), ensure_ascii=True)
    advisory = (
        "Supervisor coding workspace contract:\n"
        f"Your allocated checkout and current working directory is {location}.\n"
        "When the task names /app/<relative-path>, use the corresponding file under "
        "this allocated checkout. Edit the declared outputs there, including any "
        "declared new output. Do not write to canonical /app.\n"
        "This mapping changes tool filesystem locations only. In report contents, "
        "keep the task's requested logical path names, including original /app paths; "
        "do not substitute allocated checkout paths.\n"
        "The supervisor owner validates and publishes the candidate. Do not stage "
        "or commit Git changes, and do not modify Git control files. This path "
        "mapping does not expand the task's allowed files or grant completion authority.\n\n"
        + ("Task context follows using a reversible semantic symbol table; source code and authority remain canonical:\n"
           if semantic_transport else
           "Task context follows with exact retrieval projection:\n"
           if code_retrieval_projected else "Original native task prompt follows without modification:\n")
    )
    if len(advisory.encode()) > 8192:
        raise ValueError("coding workspace advisory exceeds its byte bound")
    return advisory + prompt, advisory


def run(*, prompt: str, provider: str, model: str, timeout: int, max_output_tokens: int,
        reasoning_effort: str = "high", container_boundary: Path | None = None,
        container_boundary_sha256: str = "", purpose: str = "coding",
        semantic_repository: Path | None = None, semantic_transport: str = "identifiers",
        doctor_residual_artifact: Path | None = None,
        doctor_residual_sha256: str = "", doctor_residual_task_cid: str = "",
        public_instruction_artifact: Path | None = None, public_instruction_sha256: str = "",
        public_instruction_task_cid: str = "", intent_requirements_transport: str = "expanded",
        code_retrieval_codec: str = "expanded",
        code_retrieval_wire_delivery: str = "inline",
        observe_model_input_only: bool = False) -> tuple[str, dict]:
    if type(observe_model_input_only) is not bool:
        raise ValueError("model input observation control must be boolean")
    observation_started = time.monotonic() if observe_model_input_only else None
    if observe_model_input_only and (type(prompt) is not str or type(model) is not str
            or type(timeout) is not int or type(max_output_tokens) is not int):
        raise ValueError("model input observation requires exact typed invocation controls")
    if observe_model_input_only and (not 0 < len(model.encode("utf-8")) <= 256
            or any(ord(char) < 32 or ord(char) == 127 for char in model)):
        raise ValueError("model input observation requires a bounded printable requested model")
    if observe_model_input_only and (purpose != "coding" or semantic_repository is None
            or container_boundary is None or not container_boundary_sha256
            or not all((public_instruction_artifact, public_instruction_sha256, public_instruction_task_cid))):
        raise ValueError("model input observation requires isolated verified semantic coding instruction")
    if provider != "codex_cli":
        raise ValueError("this version qualifies the router's codex_cli coding route only")
    if not model or not 1 <= timeout <= 600 or not 1 <= max_output_tokens <= 16_384:
        raise ValueError("explicit model and bounded invocation settings required")
    if reasoning_effort not in {"low", "medium", "high", "xhigh", "max"}:
        raise ValueError("explicit supported reasoning effort required")
    if not prompt.strip() or len(prompt.encode()) > 256_000:
        raise ValueError("implementation prompt exceeds its byte bound")
    if semantic_transport not in {"identifiers", "native"}:
        raise ValueError("unknown semantic transport")
    if type(intent_requirements_transport) is not str or intent_requirements_transport not in {"expanded", "compact"}:
        raise ValueError("unknown IntentIR requirements transport")
    if intent_requirements_transport == "compact" and (public_instruction_artifact is None or purpose != "coding"):
        raise ValueError("compact IntentIR requires an explicitly bound coding instruction")
    if type(code_retrieval_codec) is not str or code_retrieval_codec not in {"expanded", "compact"}:
        raise ValueError("unknown code retrieval codec")
    if code_retrieval_codec == "compact" and (purpose != "coding" or semantic_transport != "native"
            or semantic_repository is None or public_instruction_artifact is None
            or not public_instruction_sha256 or not public_instruction_task_cid):
        raise ValueError("compact code retrieval codec requires native coding and a bound public instruction")
    if type(code_retrieval_wire_delivery) is not str or code_retrieval_wire_delivery not in {"inline", "materialized"}:
        raise ValueError("unknown code retrieval wire delivery")
    if code_retrieval_wire_delivery == "materialized" and (code_retrieval_codec != "compact"
            or container_boundary is None or not container_boundary_sha256):
        raise ValueError("materialized code retrieval wire requires compact coding inside a verified container boundary")
    if semantic_transport == "native" and (semantic_repository is None or purpose != "coding"):
        raise ValueError("native semantic transport requires the full semantic coding route")
    root = Path.cwd().resolve()
    boundary = None
    if container_boundary is not None or container_boundary_sha256:
        from .container_worker_boundary import verify_container_worker_boundary
        if container_boundary is None:
            raise ValueError("container boundary artifact required")
        boundary = verify_container_worker_boundary(
            artifact=container_boundary, expected_sha256=container_boundary_sha256, workspace=root,
        )
    if observe_model_input_only and (type(boundary) is not dict
            or type(boundary.get("worker_uid")) is not int or boundary["worker_uid"] <= 0
            or type(boundary.get("owner_uid")) is not int or boundary["owner_uid"] <= 0
            or boundary["worker_uid"] == boundary["owner_uid"]):
        raise ValueError("model input observation requires a qualified separate worker boundary")
    top = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    if Path(top).resolve() != root:
        raise ValueError("implementation must start at its allocated Git worktree root")
    encoded = None
    semantic_verification = None
    residual_receipt = None
    residual_advisory = ""
    router_prompt = prompt
    if semantic_repository is not None:
        semantic_repository = Path(semantic_repository).resolve(strict=True)
        if semantic_repository == root:
            raise ValueError("semantic coding requires a separate allocated worktree")
        # The trusted launch chooses the canonical source root. A model cannot
        # nominate a foreign catalog or substitute a different checkout.
        def common_dir(repository):
            value = subprocess.check_output(
                ["/usr/bin/git", "-c", "safe.directory=" + str(repository), "-C", str(repository),
                 "rev-parse", "--path-format=absolute", "--git-common-dir"],
                text=True, timeout=10,
            ).strip()
            return Path(value).resolve(strict=True)
        if common_dir(semantic_repository) != common_dir(root):
            raise ValueError("semantic source repository differs from allocated worktree")
        from .semantic_router_translation import encode_semantic_router_prompt
        # Both experiment arms verify the same current producer and source
        # inventory. Only identifiers applies the reversible wire encoding.
        verified = encode_semantic_router_prompt(prompt=prompt, repository=semantic_repository)
        semantic_verification = {
            "schema": "semantic-router-source-verification@1",
            **{key: verified.receipt[key] for key in (
                "task_id", "scope_cid", "semantic_root_cid", "semantic_sha256",
                "native_prompt_sha256", "native_prompt_bytes", "freshness_checked",
            )},
        }
        if semantic_transport == "identifiers":
            encoded = verified
            router_prompt = encoded.provider_prompt
    residual_args = (doctor_residual_artifact, doctor_residual_sha256, doctor_residual_task_cid)
    if any(residual_args):
        if not all(residual_args) or semantic_repository is None or purpose != "coding":
            raise ValueError("exact residual binding requires the full semantic coding route")
        from .doctor_residual_context import load_doctor_residual_advisory
        residual_advisory, residual_receipt = load_doctor_residual_advisory(
            artifact=doctor_residual_artifact, expected_sha256=doctor_residual_sha256,
            repository=semantic_repository, task_cid=doctor_residual_task_cid, prompt=prompt, workspace=root)
        router_prompt += residual_advisory
    instruction_receipt = None
    retrieval_projection = None
    invocation = uuid.uuid4().hex
    delivery_packet = None
    delivery_source = None
    delivery_root = None
    nomination_advisory = ""
    nomination_receipt = None
    nomination_guard = None
    observation_guard = None
    from .reviewed_source_nomination_context import nomination_pointer
    nomination = nomination_pointer(prompt)
    if nomination is not None and (purpose != "coding" or semantic_repository is None
            or semantic_verification is None or not all((public_instruction_artifact,
                public_instruction_sha256, public_instruction_task_cid))):
        raise ValueError("reviewed source nomination requires a verified semantic coding instruction")
    instruction_args = (public_instruction_artifact, public_instruction_sha256, public_instruction_task_cid)
    if any(instruction_args):
        if not all(instruction_args) or purpose != "coding":
            raise ValueError("exact public instruction binding requires a coding route")
        from .router_public_instruction import load_public_instruction
        instruction, instruction_receipt = load_public_instruction(
            artifact=public_instruction_artifact, expected_sha256=public_instruction_sha256,
            task_cid=public_instruction_task_cid, prompt=prompt, workspace=root,
            repository=semantic_repository, requirements_transport=intent_requirements_transport)
        if observe_model_input_only:
            observation_guard = _observation_custody_guard(prompt=prompt, repository=semantic_repository,
                instruction_artifact=public_instruction_artifact, instruction_receipt=instruction_receipt,
                residual_artifact=doctor_residual_artifact)
        if nomination is not None:
            from .reviewed_source_nomination_context import load_reviewed_source_nomination_context
            from .verified_code_retrieval_projection import extract_verified_public_instruction_source
            nomination_advisory, nomination_receipt, nomination_guard = load_reviewed_source_nomination_context(
                prompt=prompt, repository=semantic_repository,
                source_text=extract_verified_public_instruction_source(instruction, instruction_receipt),
                instruction_receipt=instruction_receipt, semantic_verification=semantic_verification)
        if code_retrieval_codec == "compact":
            from .verified_code_retrieval_projection import (
                decoder_command_prefix, extract_verified_public_instruction_source,
                project_verified_code_retrieval_prompt,
            )
            source_text = extract_verified_public_instruction_source(instruction, instruction_receipt)
            decoder = decoder_command_prefix(repository=semantic_repository,
                source_path=instruction_receipt["source_path"],
                source_sha256=instruction_receipt["source_sha256"],
                native_prompt_sha256=hashlib.sha256(prompt.encode()).hexdigest())
            projection_options = {}
            if code_retrieval_wire_delivery == "materialized":
                from .compact_code_retrieval import encode_code_retrieval_prompt
                from .code_retrieval_wire_delivery import planned_wire_path
                delivery_root = _wire_delivery_root()
                delivery_packet = encode_code_retrieval_prompt(prompt, source_text)
                projection_options = {"guidance_version": 3,
                    "delivered_wire_path": str(planned_wire_path(delivery_packet, invocation_id=invocation,
                                                                 delivery_root=delivery_root)),
                    "delivery_root": delivery_root}
                delivery_source = source_text
            projected, retrieval_projection = project_verified_code_retrieval_prompt(
                prompt=prompt, repository=semantic_repository, source_text=source_text,
                decoder_command=decoder, **projection_options)
            router_prompt = projected + residual_advisory
        # Preserve the literal requirements after semantic encoding. Native
        # capsule identity remains the stdin identity, not this projection.
        router_prompt += nomination_advisory + instruction
    model_prompt, advisory = render_model_prompt(prompt=router_prompt, purpose=purpose, workspace=root,
        semantic_transport=encoded is not None,
        code_retrieval_projected=retrieval_projection is not None
            and retrieval_projection["selected_transport"] == "compact")
    if len(model_prompt.encode()) > 256_000:
        raise ValueError("model prompt with workspace contract exceeds its byte bound")
    if retrieval_projection is not None and retrieval_projection["selected_transport"] == "compact":
        expanded_model, _ = render_model_prompt(prompt=prompt + residual_advisory + nomination_advisory + instruction,
            purpose=purpose, workspace=root)
        if len(model_prompt.encode()) >= len(expanded_model.encode()):
            raise ValueError("complete model retrieval projection is not smaller")
    # Native provider children must never inherit a typed owner token, private
    # bootstrap channel, or database program. The daemon supplies this scrub.
    from .multi_supervisor_runner import DATABASE_PROGRAM_ENV_NAMES, STATE_CREDENTIAL_ENV_NAMES
    if any(name in os.environ for name in (*DATABASE_PROGRAM_ENV_NAMES, *STATE_CREDENTIAL_ENV_NAMES,
                                           "IPFS_ACCELERATE_AGENT_STATE_OWNER_TOKEN")):
        raise ValueError("implementation inherited database authority")
    receipt = {
        "schema": "router-implementation-invocation@1", "invocation_id": invocation,
        "provider": provider, "model": model,
        "reasoning_effort": reasoning_effort, "purpose": purpose,
        # Keep the original fields bound to native stdin for capsule comparison.
        # The distinct model fields attest the complete actual provider input.
        "prompt_sha256": hashlib.sha256(prompt.encode()).hexdigest(), "prompt_bytes": len(prompt.encode()),
        "native_prompt_sha256": hashlib.sha256(prompt.encode()).hexdigest(),
        "native_prompt_bytes": len(prompt.encode()),
        "model_prompt_sha256": hashlib.sha256(model_prompt.encode()).hexdigest(),
        "model_prompt_bytes": len(model_prompt.encode()),
        "workspace_advisory_sha256": hashlib.sha256(advisory.encode()).hexdigest() if advisory else None,
        "workspace_advisory_bytes": len(advisory.encode()),
        "workspace": str(root),
        "router_prompt_sha256": hashlib.sha256(router_prompt.encode()).hexdigest(),
        "router_prompt_bytes": len(router_prompt.encode()),
        "semantic_transport": semantic_transport if semantic_repository is not None else "none",
        "intent_requirements_transport": intent_requirements_transport,
        "code_retrieval_codec": code_retrieval_codec,
        "code_retrieval_wire_delivery": code_retrieval_wire_delivery,
        "code_retrieval_projection": retrieval_projection,
        "semantic_context_verification": semantic_verification,
        "semantic_translation": dict(encoded.receipt) if encoded is not None else None,
        "doctor_residual_context": residual_receipt,
        "public_instruction": instruction_receipt,
        "timeout_seconds": timeout, "requested_output_tokens": max_output_tokens,
        "provider_output_token_cap_enforced": False, "router_calls": 0,
        "usage": None, "completion_authority": False,
        "external_container_boundary": boundary,
    }
    if nomination_receipt is not None:
        receipt["reviewed_source_nomination_context"] = nomination_receipt
    delivery_handle = None
    def prepare_delivery():
        nonlocal delivery_handle
        if code_retrieval_wire_delivery == "materialized" and retrieval_projection["selected_transport"] == "compact":
            from .code_retrieval_wire_delivery import materialize_verified_code_retrieval_wire
            delivery_handle = materialize_verified_code_retrieval_wire(delivery_packet,
                source_text=delivery_source,
                expected_wire_sha256=retrieval_projection["wire_sha256"],
                expected_wire_bytes=retrieval_projection["wire_bytes"],
                expected_source_sha256=instruction_receipt["source_sha256"],
                expected_native_sha256=receipt["native_prompt_sha256"],
                invocation_id=invocation, delivery_root=delivery_root)
            planned_delivery = dict(retrieval_projection["wire_delivery"], materialized=True)
            if delivery_handle.receipt != planned_delivery:
                raise ValueError("materialized wire delivery differs from selected projection")
            retrieval_projection["wire_delivery"] = dict(delivery_handle.receipt)
    if observe_model_input_only:
        receipt = {key: value for key, value in receipt.items() if key not in {
            "invocation_id", "provider", "model", "provider_output_token_cap_enforced"}}
        receipt.update(schema=OBSERVATION_SCHEMA, observation_id=invocation,
            status="refused", error_type=None, requested_provider=provider, requested_model=model,
            provider_attempted=False, native_rollout_usage=None,
            execution_authority=False, proof_authority=False,
            reviewed_source_nomination_context=nomination_receipt,
            final_custody_guard_verified=False, wire_delivery_post_observation_verified=None,
            wire_delivery_cleanup_status=None, seconds=0.0)
        observation_error = None
        try:
            prepare_delivery()
            if nomination_guard is not None:
                nomination_guard()
        except BaseException as error:
            observation_error = error
        finally:
            if delivery_handle is not None:
                try:
                    delivery_handle.verify()
                    receipt["wire_delivery_post_observation_verified"] = True
                except BaseException as error:
                    receipt["wire_delivery_post_observation_verified"] = False
                    observation_error = observation_error or error
                try:
                    receipt["wire_delivery_cleanup_status"] = delivery_handle.cleanup()
                except BaseException as error:
                    receipt["wire_delivery_cleanup_status"] = "failed"
                    observation_error = observation_error or error
                if receipt["wire_delivery_cleanup_status"] != "removed" and observation_error is None:
                    observation_error = ValueError("observed materialized wire cleanup failed")
            # Fence every render, materialization, verify and cleanup callback.
            try:
                if nomination_guard is not None:
                    nomination_guard()
                observation_guard()
                receipt["final_custody_guard_verified"] = observation_error is None
            except BaseException as error:
                observation_error = observation_error or error
            receipt["seconds"] = time.monotonic() - observation_started
            receipt["status"] = "observed" if observation_error is None else "refused"
            receipt["error_type"] = type(observation_error).__name__ if observation_error is not None else None
            if set(receipt) != OBSERVATION_FIELDS:
                raise RuntimeError("closed model input observation receipt differs")
            raw = json.dumps(receipt, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
            if len(raw.encode("utf-8")) + 1 > 65536:
                raise ValueError("complete model input observation exceeds its byte bound")
            print(raw, flush=True)
        if observation_error is not None:
            raise observation_error
        return "", receipt
    from ipfs_accelerate_py.cli_runtime.cli_metadata import get_last_cli_observation, set_last_cli_observation
    from ipfs_accelerate_py.llm_allocation.intelligence_index import discover_available_providers, select_efficient_route
    from ipfs_accelerate_py.llm_router import generate_text, get_llm_provider
    from ipfs_accelerate_py.router_deps import RouterDeps
    available = discover_available_providers()
    if provider not in available:
        raise ValueError("configured shared-router provider is unavailable")
    route = select_efficient_route(model_name=model, provider=provider, task_kind="coding", available_providers=available)
    if route.provider != provider or route.model_name != model:
        raise ValueError("model manager changed the explicit benchmark route")
    deps = RouterDeps()
    instance = get_llm_provider(provider, deps=deps, use_cache=False)
    set_last_cli_observation(provider, {})
    receipt["allocation_catalog"] = route.catalog_revision
    started = time.monotonic()
    previous = os.environ.get("ipfs_accelerate_py_CODEX_SANDBOX")
    previous_bytecode = os.environ.get("PYTHONDONTWRITEBYTECODE")
    os.environ["ipfs_accelerate_py_CODEX_SANDBOX"] = "danger-full-access" if boundary else "workspace-write"
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        prepare_delivery()
        if nomination_guard is not None:
            nomination_guard()
        receipt["router_calls"] = 1
        output = generate_text(
            model_prompt, provider=provider, model_name=model, provider_instance=instance, deps=deps,
            allow_local_fallback=False, allow_cross_provider_fallback=False,
            timeout=timeout, max_tokens=max_output_tokens, max_new_tokens=max_output_tokens,
            reasoning_effort=reasoning_effort,
            task_kind="coding", allocation_path="cli", allocation_session_id=invocation,
        )
        observation = get_last_cli_observation(provider)
        if observation.get("exit_code") != 0:
            raise RuntimeError("coding CLI did not return an observed successful exit")
        if not isinstance(output, str) or not output.strip():
            raise RuntimeError("coding router returned an empty response")
        if encoded is not None:
            from .semantic_router_translation import decode_semantic_router_response
            decoded = decode_semantic_router_response(response=output, encoded=encoded,
                                                      repository=semantic_repository)
            receipt["semantic_response_translation"] = dict(decoded.receipt)
            output = decoded.text
        receipt["status"] = "provider_returned"
        return output, receipt
    except BaseException as error:
        receipt.update(status="failed", error_type=type(error).__name__)
        if receipt["router_calls"] == 0:
            receipt["schema"] = "router-implementation-pre-dispatch-refusal@1"
        raise
    finally:
        if delivery_handle is not None:
            try:
                delivery_handle.verify()
                receipt["wire_delivery_post_provider_verified"] = True
            except Exception:
                receipt["wire_delivery_post_provider_verified"] = False
            try:
                receipt["wire_delivery_cleanup_status"] = delivery_handle.cleanup()
            except Exception:
                receipt["wire_delivery_cleanup_status"] = "failed"
        if receipt["router_calls"] == 0:
            receipt["usage"] = None
            receipt["native_rollout_usage"] = None
        else:
            observation = get_last_cli_observation(provider)
            # Keep native categories intact; cached tokens are already in input.
            # Provider failures remain measured attempts with unknown totals.
            receipt["usage"] = {key: observation[key] for key in (
                "prompt_tokens", "completion_tokens", "cached_tokens", "reasoning_tokens",
                "total_cost_usd", "model_id", "session_id", "thread_id", "num_turns", "exit_code", "timed_out",
            ) if key in observation}
            from .codex_usage_receipt import recover_codex_usage
            receipt["native_rollout_usage"] = recover_codex_usage(
                home=Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex"),
                thread_id=str(observation.get("thread_id") or observation.get("session_id") or ""),
                workspace=root,
            )
        receipt["seconds"] = time.monotonic() - started
        print(json.dumps(receipt, sort_keys=True), flush=True)
        if previous is None:
            os.environ.pop("ipfs_accelerate_py_CODEX_SANDBOX", None)
        else:
            os.environ["ipfs_accelerate_py_CODEX_SANDBOX"] = previous
        if previous_bytecode is None:
            os.environ.pop("PYTHONDONTWRITEBYTECODE", None)
        else:
            os.environ["PYTHONDONTWRITEBYTECODE"] = previous_bytecode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", default="codex_cli", choices=["codex_cli"])
    parser.add_argument("--model", required=True)
    parser.add_argument("--timeout", type=int, default=90)
    parser.add_argument("--max-output-tokens", type=int, default=4096)
    parser.add_argument("--reasoning-effort", default="high", choices=["low", "medium", "high", "xhigh", "max"])
    parser.add_argument("--purpose", default="coding", choices=["planning", "coding"])
    parser.add_argument("--container-boundary", type=Path)
    parser.add_argument("--container-boundary-sha256", default="")
    parser.add_argument("--semantic-repository", type=Path)
    parser.add_argument("--semantic-transport", choices=["identifiers", "native"], default="identifiers")
    parser.add_argument("--intent-requirements-transport", choices=["expanded", "compact"], default="expanded")
    parser.add_argument("--code-retrieval-codec", choices=["expanded", "compact"], default="expanded")
    parser.add_argument("--code-retrieval-wire-delivery", choices=["inline", "materialized"], default="inline")
    parser.add_argument("--doctor-residual-artifact", type=Path)
    parser.add_argument("--doctor-residual-sha256", default="")
    parser.add_argument("--doctor-residual-task-cid", default="")
    parser.add_argument("--public-instruction-artifact", type=Path)
    parser.add_argument("--public-instruction-sha256", default="")
    parser.add_argument("--public-instruction-task-cid", default="")
    parser.add_argument("--observe-model-input-only", action="store_true")
    args = parser.parse_args()
    prompt = sys.stdin.buffer.read(256_001).decode("utf-8")
    try:
        output, receipt = run(prompt=prompt, provider=args.provider, model=args.model,
                        timeout=args.timeout, max_output_tokens=args.max_output_tokens,
                        reasoning_effort=args.reasoning_effort,
                        container_boundary=args.container_boundary,
                        container_boundary_sha256=args.container_boundary_sha256,
                        purpose=args.purpose, semantic_repository=args.semantic_repository,
                        semantic_transport=args.semantic_transport,
                        doctor_residual_artifact=args.doctor_residual_artifact,
                        doctor_residual_sha256=args.doctor_residual_sha256,
                        doctor_residual_task_cid=args.doctor_residual_task_cid,
                        public_instruction_artifact=args.public_instruction_artifact,
                        public_instruction_sha256=args.public_instruction_sha256,
                        public_instruction_task_cid=args.public_instruction_task_cid,
                        intent_requirements_transport=args.intent_requirements_transport,
                        code_retrieval_codec=args.code_retrieval_codec,
                        code_retrieval_wire_delivery=args.code_retrieval_wire_delivery,
                        observe_model_input_only=args.observe_model_input_only)
    except Exception as error:
        error_receipt = {"schema": "router-implementation-error@1", "error_type": type(error).__name__}
        if args.observe_model_input_only:
            try:
                from .native_dispatch_diagnostics import build_router_render_error
                error_receipt = build_router_render_error(error)
            except Exception:
                # Optional telemetry cannot change the original failure result.
                pass
        print(json.dumps(error_receipt), file=sys.stderr)
        return 1
    if receipt.get("schema") == OBSERVATION_SCHEMA:
        return 75
    print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
