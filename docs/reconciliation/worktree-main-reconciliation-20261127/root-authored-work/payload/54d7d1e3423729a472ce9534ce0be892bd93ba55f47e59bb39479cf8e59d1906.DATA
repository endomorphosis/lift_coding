#!/usr/bin/env python3
"""Isolate a source-analysis reuse guard for irreversible graph projections."""
import difflib
import hashlib
import json
import os
from pathlib import Path
import shutil

HERE = Path(__file__).resolve().parent
def sha(body): return hashlib.sha256(body).hexdigest()

def main():
    source = HERE / "runtime_state_identity_v5/ipfs_datasets_py"
    destination = HERE / "runtime_resolution_reuse_v6"
    if destination.exists(): raise SystemExit("preserve previous source profile")
    relative = Path("logic/software_contracts/semantic_index/scanner.py")
    before = (source / relative).read_text()
    marker = '''    if any(item.repository_id != previous.repository_id for item in items):
        return None
    return items
'''
    replacement = '''    if any(item.repository_id != previous.repository_id for item in items):
        return None
    symbol_ids = {item.stable_id for item in items}
    for edge in previous.edges:
        if edge.source_id not in symbol_ids or not _python_frontend_edge(edge):
            continue
        original_target = edge.metadata.get("unresolved_target")
        if (isinstance(original_target, str)
                and original_target.startswith(("lexical:", "module:", "pytest-fixture:"))
                and original_target != edge.target_id):
            # A public state stores resolved graph edges, not a lossless frontend
            # cache. A candidate CID would look uniquely resolved on the next
            # pass; its original confidence/metadata cannot always be recovered.
            # Re-extract this verified current file before current-inventory
            # resolution. Never retain a stale candidate set as source evidence.
            return None
    return items
'''
    assert before.count(marker) == 1
    after = before.replace(marker, replacement)
    compile(after, str(destination / "ipfs_datasets_py" / relative), "exec")
    destination.mkdir()
    shutil.copytree(source, destination / "ipfs_datasets_py", copy_function=os.link,
                    symlinks=True, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    target = destination / "ipfs_datasets_py" / relative
    temp = target.with_suffix(".py.new"); temp.write_text(after); os.replace(temp, target)
    assert (source / relative).read_text() == before
    assert os.stat(source / relative).st_ino != os.stat(target).st_ino
    patch = "".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
                    fromfile="a/ipfs_datasets_py/" + str(relative), tofile="b/ipfs_datasets_py/" + str(relative)))
    (HERE / "resolution_reuse_v6.patch").write_text(patch)
    parent = HERE / "runtime_state_identity_v5_manifest.json"
    result = {"schema": "ns-context-native-source-variant/v6", "variant_package": str(destination / "ipfs_datasets_py"),
              "parent_variant": str(parent), "parent_variant_sha256": sha(parent.read_bytes()),
              "changed_file": str(relative), "original_sha256": sha(before.encode()), "variant_sha256": sha(after.encode()),
              "materializer_sha256": sha(Path(__file__).read_bytes()), "upstream_files_modified": False,
              "change": "Reject path analysis reuse if a prior frontend edge was projected from lexical/module/fixture spelling to a different concrete target; re-extract actual current bytes then resolve against current inventory.",
              "cold_behavior_changed": False, "all_native_guards_and_source_scope_retained": True,
              "tradeoff": "Some unchanged source paths require frontend reanalysis; measure actual diagnostics and cost.",
              "provider_calls": 0}
    (HERE / "runtime_resolution_reuse_v6_manifest.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result))

if __name__ == "__main__": main()
