"""Fresh-task transport over existing genuine Grok named-session APIs.

Top level is stdlib plus the inert sibling worker. No model, SDK, database,
resource acquisition or dispatch occurs on import. JSON supplies no authority.
"""
from __future__ import annotations
import hashlib
import importlib
import json
import math
import os
from pathlib import Path
import re
import stat
import sys
import time
import types
import uuid
from . import grok_fresh_task_capture_worker as worker

CAPSULE_SCHEMA='legal-ir-grok-planning-transport-capsule/v4'
SOURCE_SCHEMA='fresh-task-grok-capture-source-profile/v1'
FILES=frozenset({'worker','runtime','helper','owner_source','adapter'})
NAMED_FIELDS=frozenset({'native_home','audit_directory','preparation_home','binary','configuration',
    'owner_sampling_policy','system_requirements','cleanup_reserve_seconds','bootstrap_max_seconds'})
CAPTURE_FIELDS=('allocation_session_id','provider','native_session_id','workspace','resume_style')
METHODS=['initialize','session/new','_x.ai/session/rename','_x.ai/session/close']
RELATIVE={
 'worker':'ipfs_accelerate_py/cli_runtime/grok_fresh_task_capture_worker.py',
 'adapter':'ipfs_accelerate_py/cli_runtime/grok_fresh_task_capture_transport.py',
 'runtime':'ipfs_accelerate_py/agent_supervisor/runtime/router_implementation_runner.py',
 'helper':'ipfs_accelerate_py/cli_runtime/grok_named_session.py',
 'owner_source':'ipfs_accelerate_py/cli_runtime/grok_production_owner.py'}
MODULES={
 'ipfs_accelerate_py':'ipfs_accelerate_py/__init__.py',
 'ipfs_accelerate_py.cli_runtime.grok_fresh_task_capture_worker':RELATIVE['worker'],
 'ipfs_accelerate_py.cli_runtime.grok_fresh_task_capture_transport':RELATIVE['adapter'],
 'ipfs_accelerate_py.agent_supervisor.runtime.router_implementation_runner':RELATIVE['runtime'],
 'ipfs_accelerate_py.cli_runtime.grok_named_session':RELATIVE['helper'],
 'ipfs_accelerate_py.cli_runtime.grok_production_owner':RELATIVE['owner_source'],
 'ipfs_accelerate_py.llm_router':'ipfs_accelerate_py/llm_router.py',
 'ipfs_accelerate_py.llm_allocation':'ipfs_accelerate_py/llm_allocation/__init__.py',
 'ipfs_accelerate_py.llm_allocation.duckdb_store':'ipfs_accelerate_py/llm_allocation/duckdb_store.py'}
PRIVATE_MODULES={
 'ipfs_accelerate_py.cli_runtime.grok_private_fake_credentials':'ipfs_accelerate_py/cli_runtime/grok_private_fake_credentials.py',
 'ipfs_accelerate_py.common':'ipfs_accelerate_py/common/__init__.py',
 'ipfs_accelerate_py.common.storage_wrapper':'ipfs_accelerate_py/common/storage_wrapper.py',
 'ipfs_accelerate_py.common.secrets_manager':'ipfs_accelerate_py/common/secrets_manager.py',
 'ipfs_accelerate_py.llm_allocation.api_key_slots':'ipfs_accelerate_py/llm_allocation/api_key_slots.py'}
_PRIVATE_PREPARATION_ATTEMPTED=False
_PRIVATE_RETAINED=[]
_DISPATCH_ATTEMPTED=False
need=worker.need
canonical=worker.canonical

def digest(value):return hashlib.sha256(canonical(value)).hexdigest()

def source_pin(path,expected):
    path=Path(path)
    pin=dict(path=str(path),bytes=path.lstat().st_size,sha256=expected)
    worker.read_pin(pin)
    return pin

def validate_capsule_shape(capsule,request):
    need(type(capsule)is dict and set(capsule)=={'schema','source_generation','files','named_session'} and
         capsule['schema']==CAPSULE_SCHEMA and capsule['source_generation']==request['source_generation'],
         'generic_V4_capsule_and_fresh_generation_required')
    files=capsule['files'];need(type(files)is dict and set(files)==FILES,'closed_five_source_roles_required')
    root=Path(request['accelerator_root'])
    for role,pin in files.items():
        worker.pin_shape(pin)
        need(pin['path']==str(root/RELATIVE[role]),'fixed_normal_source_role_path_required')
    named=capsule['named_session'];need(type(named)is dict and set(named)==NAMED_FIELDS,'closed_named_session_inputs_required')
    for name in ('binary','configuration','owner_sampling_policy'):
        worker.pin_shape(named[name],256*1024**2 if name=='binary'else 65536)
    if named['system_requirements']is not None:worker.pin_shape(named['system_requirements'],65536)
    for name in ('native_home','audit_directory','preparation_home'):
        p=named[name];need(type(p)is str and Path(p).is_absolute() and '..'not in Path(p).parts,'owned_named_path_shape_required')
    for name,upper in (('cleanup_reserve_seconds',10),('bootstrap_max_seconds',30)):
        n=named[name];need(type(n)in (int,float) and math.isfinite(n) and 1<=n<=upper,'finite_named_lifetime_input_required')
    return capsule

def load_source_profile(request):
    profile=worker.decode(worker.read_pin(request['source_profile_pin'],worker.MAX_REQUEST,private=True))
    need(set(profile)=={'schema','source_generation','sources'} and profile['schema']==SOURCE_SCHEMA and
         profile['source_generation']==request['source_generation'] and type(profile['sources'])is dict and
         1<=len(profile['sources'])<=512,'closed_normal_source_profile_required')
    root=Path(request['accelerator_root'])
    for name,d in profile['sources'].items():
        need(type(name)is str and Path(name).is_absolute() and Path(name).is_relative_to(root) and
             type(d)is str and re.fullmatch('[0-9a-f]{64}',d),'source_profile_member_shape_required')
    for relative in MODULES.values():need(str(root/relative)in profile['sources'],'explicit_normal_dependency_pin_required')
    if request['schema']==worker.PRIVATE_SCHEMA:
        need(14<=len(profile['sources'])<=512,'private_v2_fourteen_source_profile_required')
        for relative in PRIVATE_MODULES.values():
            need(str(root/relative)in profile['sources'],'private_v2_explicit_dependency_pin_required')
    return profile

def normal_module(name,request,profile):
    relative=MODULES.get(name)
    if relative is None:
        need(request['schema']==worker.PRIVATE_SCHEMA and name in PRIVATE_MODULES,'private_v2_normal_dependency_route_required')
        relative=PRIVATE_MODULES[name]
    path=Path(request['accelerator_root'])/relative
    source_pin(path,profile['sources'][str(path)])
    module=importlib.import_module(name)
    if name=='ipfs_accelerate_py':
        # The genuine pinned lazy root deliberately installs this exact subclass.
        # This exception applies to the root only, never arbitrary module proxies.
        need(isinstance(module,types.ModuleType),'genuine_normal_root_module_required')
        namespace=types.ModuleType.__getattribute__(module,'__dict__');cls=type(module)
        need(cls is namespace.get('_IPFSAccelerateModule') and cls.__module__==name and
             cls.__qualname__=='_IPFSAccelerateModule' and cls.__bases__==(types.ModuleType,),
             'genuine_pinned_normal_root_class_required')
        for method in ('__getattribute__','__setattr__','__delattr__','__dir__'):
            function=vars(cls).get(method)
            need(type(function)is types.FunctionType and function.__globals__ is namespace and
                 function.__module__==name and function.__qualname__=='_IPFSAccelerateModule.'+method and
                 function.__code__.co_filename==str(path),
                 'genuine_pinned_normal_root_method_required')
    else:
        need(type(module)is types.ModuleType,'genuine_exact_normal_submodule_required')
    need(sys.modules.get(name)is module and
         module.__file__==module.__spec__.origin==str(path) and path.resolve(strict=True)==path,
         'genuine_normal_module_object_spec_origin_required')
    source_pin(path,profile['sources'][str(path)])
    return module

def _private_pin(path,maximum):
    path=Path(path)
    need(path.resolve(strict=True)==path,'private_snapshot_path_alias')
    descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
    try:
        before=os.fstat(descriptor)
        need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and before.st_uid==os.geteuid() and
             stat.S_IMODE(before.st_mode)==0o600 and 0<before.st_size<=maximum,'bounded_private_snapshot_required')
        parts=[];count=0
        while count<=maximum:
            block=os.read(descriptor,min(65536,maximum+1-count))
            if not block:break
            count+=len(block);parts.append(block)
        raw=b''.join(parts)
        need(count==before.st_size and worker._identity(before)==worker._identity(os.fstat(descriptor))==worker._identity(path.lstat()),
             'private_snapshot_changed')
        pin=dict(path=str(path),bytes=count,sha256=hashlib.sha256(raw).hexdigest())
    finally:os.close(descriptor)
    worker.read_pin(pin,maximum,private=True)
    return pin


def _directory(path):
    path=Path(path);info=path.lstat()
    need(path.resolve(strict=True)==path and stat.S_ISDIR(info.st_mode) and info.st_uid==os.geteuid() and
         stat.S_IMODE(info.st_mode)==0o700,'existing_private_unaliased_directory_required')
    return path

def fresh_record(directory,name,raw):
    directory=_directory(directory)
    need(type(name)is str and re.fullmatch('[A-Za-z0-9_.-]{1,96}',name) and
         type(raw)is bytes and 0<len(raw)<=worker.MAX_RECEIPT,'bounded_new_metadata_record_required')
    path=directory/name
    descriptor=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,0o600)
    try:
        view=memoryview(raw)
        while view:
            count=os.write(descriptor,view);need(count>0,'metadata_short_write');view=view[count:]
        os.fsync(descriptor)
    finally:os.close(descriptor)
    parent=os.open(directory,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
    try:os.fsync(parent)
    finally:os.close(parent)
    pin=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    need(worker.read_pin(pin,private=True)==raw,'metadata_durable_readback_differs')
    return pin

PRIVATE_PREPARATION_CHECKPOINT_SCHEMA='private-fake-preparation-checkpoint/v1'
PRIVATE_PREPARATION_CHECKPOINT_NAME='private-fake-preparation.json'
_CHECKPOINT_FALSE_FIELDS=frozenset({'provider_called','native_dispatch_started','capture_accepted_by_parent',
    'task_completion_accepted','native_qualified','production_qualified','Lean_admitted'})
_CHECKPOINT_FIELDS=frozenset({'schema','worker_request','sealed_worker_request_sha256','fake_credential_fixture_pin',
    'owner_request_sha256','context_pin','source_profile_pin','capsule_pin','source_generation','task_alias','task_cid',
    'database_attempt_id','database_attempt_number','allocation_session_id','worker_identity','worker_argv','allocation_store_path',
    'original_work_deadline_monotonic','original_native_deadline_monotonic','private_fake_credentials',
    'owner_rpc_receipts','checkpoint_started_monotonic','checkpoint_observed_monotonic','metadata_only',
    'execution_environment','checkpoint_contains_post_write_observation'})|_CHECKPOINT_FALSE_FIELDS

def _private_checkpoint_work_current(request):
    """Actual original clock only; metadata helpers never acquire authority."""
    now=time.monotonic()
    work=request['work_deadline_monotonic'];native=request['native_deadline_monotonic']
    need(all(type(x)in(int,float)and math.isfinite(x)for x in(now,work,native))and
         0<work<native and native-work<=60 and now<work-3.0,
         'private_checkpoint_original_work_margin_expired')
    return now

def validate_private_preparation_checkpoint(record,*,request,sealed_request_sha256,context_pin,context,worker_identity):
    """Pure closed metadata validation; a valid record grants no live capability."""
    worker.validate_request(request)
    need(request['schema']==worker.PRIVATE_SCHEMA and type(record)is dict and set(record)==_CHECKPOINT_FIELDS and
         record['schema']==PRIVATE_PREPARATION_CHECKPOINT_SCHEMA,'closed_private_preparation_checkpoint_required')
    need(type(sealed_request_sha256)is str and re.fullmatch('[0-9a-f]{64}',sealed_request_sha256)and
         digest(request)==sealed_request_sha256 and canonical(record['worker_request'])==canonical(request)and
         record['sealed_worker_request_sha256']==sealed_request_sha256,
         'checkpoint_original_sealed_worker_S_required')
    for name in('fake_credential_fixture_pin','source_profile_pin','capsule_pin'):
        worker.pin_shape(record[name],worker.MAX_REQUEST)
        need(record[name]==request[name],'checkpoint_original_F_profile_capsule_required')
    worker.pin_shape(record['context_pin'])
    need(record['context_pin']==context_pin and context_pin['path']==request['context_path']and
         record['owner_request_sha256']==request['owner_request_sha256']==context['request_sha256'],
         'checkpoint_original_R_and_context_required')
    for name in('source_generation','task_alias','task_cid','database_attempt_id','database_attempt_number','allocation_session_id'):
        need(type(record[name])is type(request[name])and record[name]==request[name],
             'checkpoint_original_task_attempt_generation_required')
    need(type(record['worker_identity'])is dict and canonical(record['worker_identity'])==canonical(worker_identity)and
         type(worker_identity)is dict and
         set(worker_identity)=={'pid','birth','group_pid','parent_pid'}and
         all(type(x)is int and x>0 for x in worker_identity.values())and
         worker_identity['pid']==context['worker_pid']and worker_identity['birth']==context['worker_birth']and
         worker_identity['group_pid']==context['worker_process_group']==worker_identity['pid']and
         worker_identity['parent_pid']==context['owner_pid']==request['owner_pid'],
         'checkpoint_original_actual_worker_identity_required')
    argv=record['worker_argv']
    need(type(argv)is list and bool(argv)and all(type(arg)is str and '\0'not in arg for arg in argv)and
         sum(len(arg.encode('utf-8'))+1 for arg in argv)<=65536,
         'checkpoint_bounded_actual_worker_argv_required')
    need(type(record['allocation_store_path'])is str and record['allocation_store_path']==context['allocation_store_path']and
         Path(record['allocation_store_path']).is_absolute()and '..'not in Path(record['allocation_store_path']).parts,
         'checkpoint_original_store_path_required')
    need(type(record['original_work_deadline_monotonic'])is type(request['work_deadline_monotonic'])and
         record['original_work_deadline_monotonic']==request['work_deadline_monotonic']and
         type(record['original_native_deadline_monotonic'])is type(request['native_deadline_monotonic'])and
         record['original_native_deadline_monotonic']==request['native_deadline_monotonic'],
         'checkpoint_original_deadlines_required')
    init=record['private_fake_credentials']
    need(type(init)is dict and init.get('schema')=='private-fake-credential-installation-observation/v2'and
         init.get('fixture_pin')==request['fake_credential_fixture_pin']and
         init.get('owner_request_sha256')==request['owner_request_sha256']and
         init.get('sealed_worker_request_sha256')==sealed_request_sha256 and
         init.get('same_owner_client')is True and init.get('same_store')is True and
         init.get('no_capture_rows_seeded')is True and init.get('actual_readonly_capture_table_counts')==
             {'cli_sessions':0,'cli_session_aliases':0}and
         all(init.get(name)is False for name in('provider_called','provider_dispatch_granted','task_completion_accepted',
             'native_qualified','production_qualified','Lean_admitted')),
         'checkpoint_completed_private_preparation_metadata_required')
    moments=[init.get('preparation_started_monotonic'),init.get('preparation_completed_monotonic'),
        record['checkpoint_started_monotonic'],record['checkpoint_observed_monotonic']]
    need(all(type(x)in(int,float)and math.isfinite(x)and x>0 for x in moments)and
         moments==sorted(moments)and moments[-1]<request['work_deadline_monotonic']-3.0,
         'checkpoint_original_observation_order_required')
    persistence=init.get('fake_persistence')
    need(type(persistence)is dict and set(persistence)=={'schema','path','initial_fstat','final_fstat','final_pin','observed_monotonic'}and
         persistence['schema']=='private-fake-secret-persistence-observation/v1'and
         persistence['path']==str(Path(request['receipt_directory'])/'private-fake-secrets.json'),
         'checkpoint_private_persistence_metadata_required')
    initial=persistence['initial_fstat'];final=persistence['final_fstat']
    for row in(initial,final):
        need(type(row)is dict and set(row)=={'device','inode','uid','mode','nlink','bytes'}and
             all(type(x)is int and x>=0 for x in row.values())and row['inode']>0 and row['mode']==0o600 and row['nlink']==1,
             'checkpoint_owned600_persistence_fstat_required')
    need(initial['bytes']==3 and 0<final['bytes']<=4096 and
         all(initial[name]==final[name]for name in('device','inode','uid','mode','nlink')),
         'checkpoint_same_inode_persistence_required')
    worker.pin_shape(persistence['final_pin'],4096)
    need(persistence['final_pin']['path']==persistence['path']and persistence['final_pin']['bytes']==final['bytes']and
         type(persistence['observed_monotonic'])in(int,float)and math.isfinite(persistence['observed_monotonic'])and
         moments[0]<=persistence['observed_monotonic']<=moments[1],
         'checkpoint_persistence_pin_and_original_observation_required')
    rows=record['owner_rpc_receipts'];before=init.get('owner_rpc_receipt_count_before_preparation')
    after=init.get('owner_rpc_receipt_count_after_preparation')
    need(type(rows)is list and 1<=len(rows)<=512 and all(type(row)is dict for row in rows)and
         type(before)is int and type(after)is int and
         1<=before<after==len(rows)and rows[0].get('stage')=='request_prepared'and
         rows[-1].get('stage')=='remaining_deadline','checkpoint_real_contiguous_owner_prefix_required')
    fields={'sequence','stage','request_sha256','context_sha256','owner_pid','owner_birth','owner_process_group',
        'client_pid','client_birth','client_process_group','observed_monotonic','received_monotonic','response_sha256',
        'actual_kernel_peer_owner_verified','observation_is_not_native_authority'}
    last=0.0
    for index,row in enumerate(rows,1):
        need(type(row)is dict and set(row)==fields and type(row['sequence'])is int and row['sequence']==index and
             row['request_sha256']==request['owner_request_sha256']and row['context_sha256']==context['context_sha256']and
             type(row['stage'])is str and row['actual_kernel_peer_owner_verified']is True and
             row['observation_is_not_native_authority']is True and type(row['response_sha256'])is str and
             re.fullmatch('[0-9a-f]{64}',row['response_sha256']), 'checkpoint_owner_receipt_binding_required')
        for key,expected in(('owner_pid',context['owner_pid']),('owner_birth',context['owner_birth']),
                ('client_pid',worker_identity['pid']),('client_birth',worker_identity['birth']),
                ('client_process_group',worker_identity['group_pid'])):
            need(type(row[key])is int and row[key]==expected,'checkpoint_owner_receipt_process_required')
        observed=row['observed_monotonic'];received=row['received_monotonic']
        need(type(row['owner_process_group'])is int and row['owner_process_group']>0 and
             all(type(x)in(int,float)and math.isfinite(x)for x in(observed,received))and
             0<observed<=received<=moments[-1]and last<=observed,
             'checkpoint_owner_receipt_observation_order_required')
        last=received
    need(record['metadata_only']is True and record['execution_environment']=='isolated-loopback'and
         record['checkpoint_contains_post_write_observation']is False and
         all(record[name]is False for name in _CHECKPOINT_FALSE_FIELDS),
         'checkpoint_is_not_capture_or_native_authority')
    need(len(canonical(record))<=worker.MAX_RECEIPT,'bounded_private_preparation_checkpoint_required')
    return record

def read_private_preparation_checkpoint(pin,*,request,sealed_request_sha256,context_pin,context,worker_identity,identity=None):
    """Read actual owned600 checkpoint; optional original inode identity is binding."""
    worker.pin_shape(pin)
    need(pin['path']==str(Path(request['receipt_directory'])/PRIVATE_PREPARATION_CHECKPOINT_NAME),
         'fixed_private_preparation_checkpoint_path_required')
    path=Path(pin['path']);before=worker._identity(path.lstat())
    need(identity is None or tuple(identity)==before,'original_private_checkpoint_inode_changed')
    record=worker.decode(worker.read_pin(pin,private=True))
    need(before==worker._identity(path.lstat()),'private_checkpoint_changed_during_readback')
    validate_private_preparation_checkpoint(record,request=request,sealed_request_sha256=sealed_request_sha256,
        context_pin=context_pin,context=context,worker_identity=worker_identity)
    return record

def write_private_preparation_checkpoint(record,*,request,sealed_request_sha256,context_pin,context,worker_identity):
    """Write once using genuine O_EXCL/fsync/read-only-pin route; failure propagates.

    There is deliberately no stop selector or owner/client argument. This small
    metadata API cannot authenticate a live owner or qualify a capture. A late
    return leaves the fixed file intact for the real process owner to collect.
    """
    options=dict(request=request,sealed_request_sha256=sealed_request_sha256,context_pin=context_pin,
        context=context,worker_identity=worker_identity)
    validate_private_preparation_checkpoint(record,**options)
    _private_checkpoint_work_current(request)
    pin=fresh_record(Path(request['receipt_directory']),PRIVATE_PREPARATION_CHECKPOINT_NAME,canonical(record))
    _private_checkpoint_work_current(request)
    read_private_preparation_checkpoint(pin,**options)
    _private_checkpoint_work_current(request)
    return pin

def _private_checkpoint_current(request,prepared,*,helper,store,initialization,borrowed_request_fd,borrowed_request_sha256):
    """Actual same client/store/source/S/F/R custody; no factory or DB query."""
    helper._work_current(request)
    profile=load_source_profile(request)
    core=normal_module('ipfs_accelerate_py.cli_runtime.grok_production_owner',request,profile)
    actual_helper=normal_module('ipfs_accelerate_py.cli_runtime.grok_private_fake_credentials',request,profile)
    need(core is prepared['core']and helper is actual_helper and profile==prepared['profile'],
         'checkpoint_original_source_objects_required')
    auth=helper.authenticate_private_fixture(fixture_pin=request['fake_credential_fixture_pin'],request=request,
        request_descriptor=borrowed_request_fd,request_sha256=borrowed_request_sha256,core=core,owner_client=prepared['client'])
    helper._work_current(request)
    need(auth['context']==prepared['context']and auth['profile']==profile and
         prepared['worker_identity']==core.process(os.getpid())and prepared['store']is store and
         prepared['private_fake_credentials']is initialization,'checkpoint_original_prepared_objects_required')
    allocation=normal_module('ipfs_accelerate_py.llm_allocation.duckdb_store',request,profile)
    need(type(store)is allocation.AllocationStore and allocation._DEFAULT_STORE is store and
         str(store.path)==auth['context']['allocation_store_path']and store._ready is True,
         'checkpoint_same_ready_private_store_required')
    for path,sha in profile['sources'].items():
        helper._work_current(request);source_pin(path,sha);helper._work_current(request)
    for pin,maximum in((request['capsule_pin'],worker.MAX_REQUEST),(request['source_profile_pin'],worker.MAX_REQUEST),
            (prepared['context_pin'],core.MAX_FRAME)):
        helper._work_current(request);worker.read_pin(pin,maximum,private=True);helper._work_current(request)
    prepared['client'].assert_current('remaining_deadline');helper._work_current(request)
    return auth

def prepare_parent_context(*,request,capsule):
    worker.validate_request(request);validate_capsule_shape(capsule,request)
    need(digest(capsule)==request['capsule_pin']['sha256'],'exact_generic_capsule_commitment_required')
    profile=load_source_profile(request)
    for role,pin in capsule['files'].items():
        worker.read_pin(pin);need(profile['sources'].get(pin['path'])==pin['sha256'],'capsule_and_source_profile_must_join')
    normal_module('ipfs_accelerate_py',request,profile)
    core=normal_module('ipfs_accelerate_py.cli_runtime.grok_production_owner',request,profile)
    context_pin=_private_pin(request['context_path'],core.MAX_FRAME)
    context=core.validate_context(core.decode(worker.read_pin(context_pin,core.MAX_FRAME,private=True)))
    expected=dict(database_task_cid=request['task_cid'],database_attempt_id=request['database_attempt_id'],
        database_attempt_number=request['database_attempt_number'],portal_task_id=request['task_alias'],
        allocation_session_id=request['allocation_session_id'],source_generation=request['source_generation'],
        request_sha256=request['owner_request_sha256'],workspace=request['workspace'],
        work_deadline_monotonic=request['work_deadline_monotonic'],native_deadline_monotonic=request['native_deadline_monotonic'],
        owner_pid=request['owner_pid'],owner_birth=request['owner_birth'],
        source_bindings_sha256=request['source_profile_pin']['sha256'],capsule_sha256=request['capsule_pin']['sha256'],
        worker_source_sha256=capsule['files']['worker']['sha256'],owner_source_sha256=capsule['files']['owner_source']['sha256'])
    need(all(type(v)is type(context[k]) and context[k]==v for k,v in expected.items()),'actual_parent_context_and_fresh_task_join_required')
    own=core.process(os.getpid());parent=core.process(os.getppid())
    need(parent['pid']==request['owner_pid'] and parent['birth']==request['owner_birth'] and
         own['pid']==context['worker_pid'] and own['birth']==context['worker_birth'] and
         own['group_pid']==context['worker_process_group']==os.getpid() and own['parent_pid']==parent['pid'],
         'actual_direct_worker_parent_birth_and_group_required')
    client=core.ProductionOwnerGuardClient(context,expected_owner_pid=parent['pid'],expected_owner_birth=parent['birth'],
        expected_request_sha256=request['owner_request_sha256'],expected_source_generation=request['source_generation'],
        expected_worker_source_sha256=capsule['files']['worker']['sha256'],expected_allocation_session_id=request['allocation_session_id'])
    client.assert_current('request_prepared')
    need(os.environ.get('IPFS_ACCELERATE_AGENT_TASK_ID')==request['task_alias'] and
         os.environ.get('IPFS_ACCELERATE_AGENT_TASK_CID')==request['task_cid'] and
         os.environ.get('IPFS_ACCELERATE_AGENT_TASK_ATTEMPT')==str(request['database_attempt_number']),
         'native_task_environment_join_required')
    _directory(request['receipt_directory'])
    return dict(core=core,client=client,context=context,context_pin=context_pin,profile=profile,worker_identity=own)

def prepare_private_fake_credentials(request,prepared_parent_context,*,borrowed_request_fd,borrowed_request_sha256):
    """Private v2 only; retain the exact prepared peer client and singleton store."""
    global _PRIVATE_PREPARATION_ATTEMPTED
    preparation_started=time.monotonic()
    need(not _PRIVATE_PREPARATION_ATTEMPTED,'one_private_fake_preparation_only')
    worker.validate_request(request)
    need(request['schema']==worker.PRIVATE_SCHEMA and type(prepared_parent_context)is dict,
         'explicit_private_v2_prepared_context_required')
    prepared=prepared_parent_context;core,client,context=(prepared[k]for k in('core','client','context'))
    profile=load_source_profile(request)
    need(prepared['profile']==profile,'original_private_source_profile_required')
    actual_core=normal_module('ipfs_accelerate_py.cli_runtime.grok_production_owner',request,profile)
    need(core is actual_core and type(client)is core.ProductionOwnerGuardClient,
         'original_prepared_private_owner_client_required')
    helper=normal_module('ipfs_accelerate_py.cli_runtime.grok_private_fake_credentials',request,profile)
    for name in('authenticate_private_fixture','prepare_private_duckdb_dependency','quiesce_private_duckdb',
                'initialize_private_fake_credentials','require_owned_rootless_network'):
        helper._source_function(helper,name)
    auth=helper.authenticate_private_fixture(fixture_pin=request['fake_credential_fixture_pin'],request=request,
        request_descriptor=borrowed_request_fd,request_sha256=borrowed_request_sha256,core=core,owner_client=client)
    value=auth['value'];need(auth['context']==context and auth['profile']==profile,'same_authenticated_private_context_required')
    helper._source_function(core,'process')
    need(prepared['worker_identity']==core.process(os.getpid()),'original_private_worker_identity_required')
    before_receipts=client.receipts();need(type(before_receipts)is list and bool(before_receipts),
        'actual_preparation_owner_receipt_prefix_required')
    helper._work_current(value);client.assert_current('remaining_deadline');helper._work_current(value)
    need('store'not in prepared and 'private_fake_credentials'not in prepared,'fresh_private_prepared_slots_required')
    _PRIVATE_PREPARATION_ATTEMPTED=True
    retained=dict(prepared=prepared,client=client,store=None,initialization=None)
    _PRIVATE_RETAINED.append(retained)
    early_network=helper.require_owned_rootless_network(value['network_namespace'],sealed_policy=value['network_witness_policy'],
        work_deadline_monotonic=value['work_deadline_monotonic'],native_deadline_monotonic=value['native_deadline_monotonic'])
    helper._work_current(value)
    # Authenticate the complete narrow48-file closure BEFORE native import or
    # a first AllocationStore query can mutate schema or create native threads.
    helper.prepare_private_duckdb_dependency(value);helper._work_current(value)
    allocation=normal_module('ipfs_accelerate_py.llm_allocation',request,profile);helper._work_current(value)
    allocation_module=normal_module('ipfs_accelerate_py.llm_allocation.duckdb_store',request,profile);helper._work_current(value)
    need(os.environ.get('IPFS_ACCELERATE_LLM_ALLOCATION_DB')==context['allocation_store_path']and
         allocation_module._DEFAULT_STORE is None,'fresh_context_bound_private_allocation_store_required')
    factory=helper._source_function(allocation_module,'get_allocation_store')
    need(allocation.get_allocation_store is factory,'same_normal_allocation_store_factory_required')
    helper._work_current(value);store=factory();retained['store']=store;helper._work_current(value)
    need(type(store)is allocation_module.AllocationStore and allocation_module._DEFAULT_STORE is store and
         str(store.path)==context['allocation_store_path']and store.path.is_file(),
         'actual_preexisting_context_bound_private_store_required')
    before=_store_row(store,request,context,empty=True);helper._work_current(value)
    bound=store.get_session_api_key(request['allocation_session_id'],'grok_cli');helper._work_current(value)
    rows=store.list_api_key_slots('grok_cli');helper._work_current(value)
    selected=[row for row in rows if type(row)is dict and row.get('slot_id')==value['credential_slot']]
    need(type(bound)is dict and bound.get('session_id')==request['allocation_session_id']and
         bound.get('backend')=='grok_cli'and bound.get('slot_id')==value['credential_slot']and len(selected)==1 and
         selected[0].get('backend')=='grok_cli'and selected[0].get('enabled')is True and
         selected[0].get('key_fingerprint')==value['credential_fingerprint'],
         'actual_existing_private_slot_metadata_required')
    helper._work_current(value);conn=store._duckdb.connect(str(store.path),read_only=True)
    try:
        helper._work_current(value);counts={}
        for table in('cli_sessions','cli_session_aliases'):
            helper._work_current(value);counts[table]=conn.execute('SELECT COUNT(*) FROM '+table).fetchone()[0]
            helper._work_current(value)
    finally:conn.close()
    helper._work_current(value)
    need(counts=={'cli_sessions':0,'cli_session_aliases':0},'actual_private_capture_tables_must_be_empty')
    need('ipfs_accelerate_py.common.secrets_manager'not in sys.modules,'no_prior_private_secrets_module_required')
    quiescence=helper.quiesce_private_duckdb(value=value,request=request,context=context,store=store,
        phase='before_initialization');helper._work_current(value)
    initialization=helper.initialize_private_fake_credentials(fixture_pin=request['fake_credential_fixture_pin'],
        request=request,request_descriptor=borrowed_request_fd,request_sha256=borrowed_request_sha256,
        core=core,owner_client=client,store=store)
    retained['initialization']=initialization;helper._work_current(value)
    need(initialization['schema']=='private-fake-credential-installation-observation/v2'and
         len(initialization['network_observations'])==4 and len(initialization['public_duckdb_quiescence'])==1,
         'actual_private_v2_complete_initialization_required')
    initialization['public_duckdb_quiescence'].insert(0,quiescence)
    initialization.update(early_network_observation=early_network,store_readiness=before,
        actual_readonly_capture_table_counts=counts,public_empty_capture_read_is_absence_proof=False,
        no_capture_rows_seeded=True)
    need(prepared['client']is client and context==client.context()and allocation_module._DEFAULT_STORE is store,
         'original_private_client_and_store_must_be_retained')
    helper._work_current(value);client.assert_current('remaining_deadline');helper._work_current(value)
    after_receipts=client.receipts()
    need(after_receipts[:len(before_receipts)]==before_receipts and
         len(after_receipts)>len(before_receipts)and
         [row['sequence']for row in after_receipts]==list(range(1,len(after_receipts)+1)),
         'same_client_contiguous_preparation_owner_receipts_required')
    helper._work_current(value);preparation_completed=time.monotonic()
    initialization.update(preparation_started_monotonic=preparation_started,
        preparation_completed_monotonic=preparation_completed,
        owner_rpc_receipt_count_before_preparation=len(before_receipts),
        owner_rpc_receipt_count_after_preparation=len(after_receipts))
    prepared['store']=store;prepared['private_fake_credentials']=initialization
    checkpoint_started=_private_checkpoint_work_current(request)
    # Retain the intended fixed path BEFORE fallible authentication or write.
    # No exception here is swallowed; a late durable file remains diagnostic.
    checkpoint_state=dict(path=str(Path(request['receipt_directory'])/PRIVATE_PREPARATION_CHECKPOINT_NAME),
        pin=None,identity=None,completed=False)
    retained['checkpoint']=checkpoint_state
    _private_checkpoint_current(request,prepared,helper=helper,store=store,initialization=initialization,
        borrowed_request_fd=borrowed_request_fd,borrowed_request_sha256=borrowed_request_sha256)
    current_receipts=client.receipts()
    need(current_receipts[:len(after_receipts)]==after_receipts,
         'checkpoint_original_preparation_ACK_prefix_changed')
    # Snapshot the exact original preparation prefix1..N. Later genuine guard
    # ACKs form a server/client suffix, never fabricated future checkpoint rows.
    checkpoint_receipts=after_receipts
    record=dict(schema=PRIVATE_PREPARATION_CHECKPOINT_SCHEMA,worker_request=worker.decode(canonical(request)),
        sealed_worker_request_sha256=borrowed_request_sha256,fake_credential_fixture_pin=request['fake_credential_fixture_pin'],
        owner_request_sha256=request['owner_request_sha256'],context_pin=prepared['context_pin'],
        source_profile_pin=request['source_profile_pin'],capsule_pin=request['capsule_pin'],
        source_generation=request['source_generation'],task_alias=request['task_alias'],task_cid=request['task_cid'],
        database_attempt_id=request['database_attempt_id'],database_attempt_number=request['database_attempt_number'],
        allocation_session_id=request['allocation_session_id'],worker_identity=dict(prepared['worker_identity']),worker_argv=_worker_argv(),
        allocation_store_path=str(store.path),original_work_deadline_monotonic=request['work_deadline_monotonic'],
        original_native_deadline_monotonic=request['native_deadline_monotonic'],private_fake_credentials=worker.decode(canonical(initialization)),
        owner_rpc_receipts=checkpoint_receipts,checkpoint_started_monotonic=checkpoint_started,
        checkpoint_observed_monotonic=_private_checkpoint_work_current(request),metadata_only=True,
        execution_environment='isolated-loopback',checkpoint_contains_post_write_observation=False,
        **{name:False for name in _CHECKPOINT_FALSE_FIELDS})
    options=dict(request=request,sealed_request_sha256=borrowed_request_sha256,context_pin=prepared['context_pin'],
        context=context,worker_identity=prepared['worker_identity'])
    checkpoint_state['record']=record
    pin=write_private_preparation_checkpoint(record,**options)
    checkpoint_state['pin']=pin
    prepared['private_fake_preparation_checkpoint_pin']=pin
    checkpoint_state['identity']=worker._identity(Path(pin['path']).lstat())
    prepared['private_fake_preparation_checkpoint_identity']=checkpoint_state['identity']
    helper._work_current(request)
    _private_checkpoint_current(request,prepared,helper=helper,store=store,initialization=initialization,
        borrowed_request_fd=borrowed_request_fd,borrowed_request_sha256=borrowed_request_sha256)
    read_private_preparation_checkpoint(pin,identity=checkpoint_state['identity'],**options)
    helper._work_current(request)
    need(client.receipts()[:len(checkpoint_receipts)]==checkpoint_receipts,
         'checkpoint_owner_ACK_prefix_changed_after_write')
    checkpoint_state['write_completed_observed_monotonic']=_private_checkpoint_work_current(request)
    checkpoint_state['completed']=True
    return initialization

def bounded_timeout(remaining,maximum):
    need(type(remaining)in (int,float) and math.isfinite(remaining) and
         type(maximum)is int and 1<=maximum<=90,'bounded_original_timeout_input_required')
    value=min(maximum,math.floor(remaining));need(value>=1,'original_work_budget_exhausted')
    return value

def _worker_argv():
    raw=Path('/proc/self/cmdline').read_bytes()
    need(0<len(raw)<=65536 and raw.endswith(b'\0'),'actual_worker_argv_bound_required')
    return [part.decode('utf-8')for part in raw[:-1].split(b'\0')]

def _store_row(store,request,context,*,empty):
    need(str(store.path)==context['allocation_store_path'],'actual_bound_allocation_store_required')
    # A genuine first public query performs AllocationStore's lazy initialization.
    # Empty alone is insufficient: a missing backend also returns an empty dict.
    row=store.get_cli_session(request['allocation_session_id'],'grok_cli')
    need(store._ready is True and type(store._duckdb)is types.ModuleType and
         store._duckdb is sys.modules.get('duckdb'),'actual_bound_ready_allocation_store_required')
    if empty:need(type(row)is dict and row=={},'fresh_allocation_capture_must_be_empty')
    else:
        need(type(row)is dict and all(type(row.get(k))is str and row[k]for k in CAPTURE_FIELDS) and
             row['allocation_session_id']==request['allocation_session_id'] and row['provider']=='grok_cli' and
             row['workspace']==request['workspace'] and row['resume_style']=='resume','actual_allocation_capture_readback_required')
    return dict(allocation_store_path=str(store.path),row={}if empty else {k:row[k]for k in CAPTURE_FIELDS},observed_monotonic=time.monotonic())

def run_capture(*,request,capsule,prepared,request_bytes,sealed_request_sha256,original_stdin):
    global _DISPATCH_ATTEMPTED
    need(not _DISPATCH_ATTEMPTED,'one_fresh_capture_dispatch_only');_DISPATCH_ATTEMPTED=True
    need(canonical(request)==request_bytes and hashlib.sha256(request_bytes).hexdigest()==sealed_request_sha256,
         'actual_sealed_request_bytes_required')
    core,client,context,profile=(prepared[k]for k in ('core','client','context','profile'))
    need(prepared['worker_identity']==core.process(os.getpid()),'original_worker_identity_changed')
    need(Path.cwd().resolve(strict=True)==Path(request['workspace']),'actual_worker_workspace_required')
    need(type(original_stdin)is bytes and 0<len(original_stdin)<=worker.MAX_STDIN,'bounded_original_stdin_required')
    text=original_stdin.decode('utf-8');named=capsule['named_session']
    helper=normal_module('ipfs_accelerate_py.cli_runtime.grok_named_session',request,profile)
    runtime=normal_module('ipfs_accelerate_py.agent_supervisor.runtime.router_implementation_runner',request,profile)
    normal_module('ipfs_accelerate_py.llm_router',request,profile)
    allocation=normal_module('ipfs_accelerate_py.llm_allocation',request,profile)
    allocation_module=normal_module('ipfs_accelerate_py.llm_allocation.duckdb_store',request,profile)
    need(os.environ.get('IPFS_ACCELERATE_LLM_ALLOCATION_DB')==context['allocation_store_path'],'actual_allocation_environment_required')
    if request['schema']==worker.PRIVATE_SCHEMA:
        need('private_fake_credentials'in prepared and 'store'in prepared,'actual_private_preparation_required_before_capture')
        store=prepared['store']
        need(allocation.get_allocation_store()is store,'original_private_allocation_store_changed')
        need('private_fake_preparation_checkpoint_pin'in prepared and
             'private_fake_preparation_checkpoint_identity'in prepared,
             'durable_private_preparation_checkpoint_required_before_capture')
        read_private_preparation_checkpoint(prepared['private_fake_preparation_checkpoint_pin'],request=request,
            sealed_request_sha256=sealed_request_sha256,context_pin=prepared['context_pin'],context=context,
            worker_identity=prepared['worker_identity'],identity=prepared['private_fake_preparation_checkpoint_identity'])
    else:store=allocation.get_allocation_store()
    need(type(store)is allocation_module.AllocationStore,'actual_normal_allocation_store_required')
    before=_store_row(store,request,context,empty=True)
    def source(pin):return helper.SourcePin(Path(pin['path']),pin['sha256'],maximum_bytes=pin['bytes'])
    owner_request=helper.NamedSessionRequest(workspace=Path(request['workspace']),native_home=Path(named['native_home']),
        audit_directory=Path(named['audit_directory']),binary=source(named['binary']),configuration=source(named['configuration']),
        owner_sampling_policy=source(named['owner_sampling_policy']),
        preparation=helper.NativeHomePreparation(Path(named['preparation_home']),source(named['configuration'])),
        helper_source=source(capsule['files']['helper']),owner_source=source(capsule['files']['owner_source']),
        owner_guard=core.owner_guard_for(client),source_generation=request['source_generation'],
        deadline_monotonic=request['work_deadline_monotonic'],allocation_session_id=request['allocation_session_id'],
        credential_slot=context['credential_slot'],credential_fingerprint=context['credential_fingerprint'],
        system_requirements=source(named['system_requirements'])if named['system_requirements']is not None else None,
        cleanup_reserve_seconds=named['cleanup_reserve_seconds'],bootstrap_max_seconds=named['bootstrap_max_seconds'])
    owner_request.assert_current('worker_v4_dispatch')
    timeout=bounded_timeout(owner_request.remaining_seconds(request['maximum_timeout_seconds']),request['maximum_timeout_seconds'])
    observed=[]
    dispatched=time.monotonic()
    output,router=runtime.run(prompt=text,provider='grok_cli',model='grok-4.7',purpose='planning',timeout=timeout,
        max_output_tokens=request['max_output_tokens'],reasoning_effort='high',grok_named_session_request=owner_request,
        receipt_observer=lambda row:observed.append(canonical(row)))
    response_time=time.monotonic()
    need(type(router)is dict and len(observed)==1 and observed[0]==canonical(router) and
         router.get('schema')=='router-implementation-invocation@1' and router.get('provider')=='grok_cli' and
         router.get('model')=='grok-4.7' and router.get('purpose')=='planning' and router.get('router_calls')==1 and
         router.get('status')=='provider_returned' and router.get('workspace')==request['workspace'] and
         router.get('native_prompt_sha256')==hashlib.sha256(original_stdin).hexdigest(),
         'actual_returned_router_receipt_required')
    need(type(router.get('invocation_id'))is str and re.fullmatch('[0-9a-f]{32}',router['invocation_id']) and
         router['invocation_id']!=request['allocation_session_id'],'distinct_actual_runtime_invocation_required')
    session=owner_request.completed_session_id;named_receipt=owner_request.receipt();policy=router.get('provider_invocation_policy',{})
    need(type(session)is str and str(uuid.UUID(session))==session and policy.get('native_resume_session_id')==session and
         policy.get('native_resume_identity_verified')is True and policy.get('owned_named_session')==named_receipt and
         named_receipt.get('response_accepted')is True and named_receipt.get('lifetime_closed')is True and
         named_receipt.get('native_process_reaped')is True and type(named_receipt.get('native_process_returncode'))is int and
         named_receipt['native_process_returncode']==0 and named_receipt.get('bootstrap_successful')is True and
         named_receipt.get('request_methods')==METHODS and named_receipt.get('forced_cleanup')is False and
         named_receipt.get('cleanup_error_types')==[],'actual_accepted_closed_native_session_required')
    after=_store_row(store,request,context,empty=False)
    need(after['row']['native_session_id']==session,'accepted_native_UUID_capture_join_required')
    owner_request.assert_current('worker_v4_response')
    need(time.monotonic()<request['work_deadline_monotonic'] and type(output)is str and
         0<len(output.encode('utf-8'))<=65536,'bounded_actual_provider_response_required')
    # Recheck every frozen producer before publishing any success metadata.
    for name,d in profile['sources'].items():source_pin(Path(name),d)
    worker.read_pin(request['capsule_pin'],worker.MAX_REQUEST,private=True)
    worker.read_pin(request['source_profile_pin'],worker.MAX_REQUEST,private=True)
    worker.read_pin(prepared['context_pin'],core.MAX_FRAME,private=True)
    directory=Path(request['receipt_directory'])
    request_pin=fresh_record(directory,'capture-request.json',request_bytes)
    router_pin=fresh_record(directory,'router-receipt.json',canonical(router))
    named_pin=fresh_record(directory,'named-session-receipt.json',canonical(named_receipt))
    bootstrap_pin=_private_pin(Path(named['audit_directory'])/'bootstrap-stdout.jsonl',worker.MAX_RECEIPT)
    record=dict(schema=worker.RECEIPT_SCHEMA,request_pin=request_pin,sealed_request_sha256=sealed_request_sha256,
        owner_request_sha256=request['owner_request_sha256'],context_pin=prepared['context_pin'],capsule_pin=request['capsule_pin'],
        source_profile_pin=request['source_profile_pin'],source_generation=request['source_generation'],task_alias=request['task_alias'],
        task_cid=request['task_cid'],database_attempt_id=request['database_attempt_id'],database_attempt_number=request['database_attempt_number'],
        allocation_session_id=request['allocation_session_id'],worker_identity=dict(prepared['worker_identity']),worker_argv=_worker_argv(),
        stdin=dict(bytes=len(original_stdin),sha256=hashlib.sha256(original_stdin).hexdigest()),
        original_work_deadline_monotonic=request['work_deadline_monotonic'],original_native_deadline_monotonic=request['native_deadline_monotonic'],
        dispatch_monotonic=dispatched,response_monotonic=response_time,observed_monotonic=time.monotonic(),timeout_seconds=timeout,
        router_receipt_pin=router_pin,named_receipt_pin=named_pin,bootstrap_stdout_pin=bootstrap_pin,
        store_capture_before=before,store_capture_observation=after,owner_rpc_receipts=client.receipts(),
        provider_response=dict(bytes=len(output.encode('utf-8')),sha256=hashlib.sha256(output.encode('utf-8')).hexdigest()),
        execution_environment=request['execution_environment'],metadata_only=True,capture_accepted_by_parent=False,
        task_completion_accepted=False,production_qualified=False)
    if request['schema']==worker.PRIVATE_SCHEMA:
        initialization=prepared['private_fake_credentials'];stdin_started=prepared.get('stdin_read_started_monotonic')
        need(type(stdin_started)in(int,float)and math.isfinite(stdin_started)and
             initialization['preparation_completed_monotonic']<=stdin_started<=dispatched,
             'private_initialization_must_precede_actual_stdin_read')
        record['private_fake_credentials']=initialization
        record['stdin_read_started_monotonic']=stdin_started
        read_private_preparation_checkpoint(prepared['private_fake_preparation_checkpoint_pin'],request=request,
            sealed_request_sha256=sealed_request_sha256,context_pin=prepared['context_pin'],context=context,
            worker_identity=prepared['worker_identity'],identity=prepared['private_fake_preparation_checkpoint_identity'])
        record['private_fake_preparation_checkpoint_pin']=prepared['private_fake_preparation_checkpoint_pin']
    need(record['observed_monotonic']<request['work_deadline_monotonic'],'capture_metadata_after_original_work_deadline')
    return fresh_record(directory,'capture-transport.json',canonical(record))
