"""Real local signal/latch boundaries; no credentials, resources or DB."""
import os
import signal
import threading
import time

import pytest

from ipfs_accelerate_py.agent_supervisor.runtime import private_same_pid_fixture as binding
from ipfs_accelerate_py.agent_supervisor.todo_daemon.database_shutdown import DatabaseDaemonShutdown


def handlers():
    return {value: signal.getsignal(value) for value in (signal.SIGTERM, signal.SIGINT)}


def test_real_ordinary_shutdown_latch_and_handler_restoration():
    previous = handlers()
    with binding._private_shutdown_handlers() as shutdown:
        assert type(shutdown) is DatabaseDaemonShutdown
        assert shutdown.signum is None
        for signum in previous:
            actual = signal.getsignal(signum)
            assert actual.__self__ is shutdown
            assert actual.__func__ is DatabaseDaemonShutdown.request
    assert handlers() == previous


@pytest.mark.parametrize('signum', [signal.SIGTERM, signal.SIGINT])
def test_actual_own_process_signal_latches_until_python_checkpoint(signum):
    previous = handlers()
    with pytest.raises(SystemExit) as caught:
        with binding._private_shutdown_handlers() as shutdown:
            os.kill(os.getpid(), signum)
            assert shutdown.signum == signum
            # Reaching this boundary demonstrates that the real handler did
            # not raise into an in-flight call.
            shutdown.checkpoint()
    assert caught.value.code == 128 + signum
    assert handlers() == previous


def test_second_real_signal_preserves_first_stop_cause():
    previous = handlers()
    with binding._private_shutdown_handlers() as shutdown:
        os.kill(os.getpid(), signal.SIGTERM)
        os.kill(os.getpid(), signal.SIGINT)
        assert shutdown.signum == signal.SIGTERM
    assert handlers() == previous


def test_real_latched_stop_interrupts_wait_at_explicit_boundary():
    previous = handlers()
    with binding._private_shutdown_handlers() as shutdown:
        os.kill(os.getpid(), signal.SIGTERM)
        original_deadline = time.monotonic() + 1
        with pytest.raises(SystemExit) as caught:
            binding._wait_for_private_stop(shutdown, cleanup_start_monotonic=original_deadline)
        assert caught.value.code == 128 + signal.SIGTERM
        assert original_deadline > time.monotonic()
    assert handlers() == previous


@pytest.mark.parametrize('offset', [-1.0, 0.02])
def test_wait_respects_fixed_cleanup_boundary_without_stop_or_renewal(offset):
    with binding._private_shutdown_handlers() as shutdown:
        original_deadline = time.monotonic() + offset
        binding._wait_for_private_stop(shutdown, cleanup_start_monotonic=original_deadline)
        assert time.monotonic() >= original_deadline
        assert shutdown.signum is None


def test_secondary_thread_cannot_replace_process_signal_handlers():
    previous = handlers()
    observed = []
    def attempt():
        try:
            with binding._private_shutdown_handlers():
                observed.append('unexpected-entry')
        except binding.PrivateFixtureRefusal as error:
            observed.append(str(error))
    thread = threading.Thread(target=attempt)
    thread.start()
    thread.join(timeout=2)
    assert not thread.is_alive()
    assert observed == ['actual_daemon_main_thread_required']
    assert handlers() == previous


def test_unrelated_exception_restores_exact_original_handlers():
    previous = handlers()
    with pytest.raises(ValueError, match='private-test-boundary'):
        with binding._private_shutdown_handlers():
            raise ValueError('private-test-boundary')
    assert handlers() == previous


@pytest.mark.parametrize('first_clock', ['work', 'native', 'grant'])
def test_actual_wait_stops_at_earliest_original_work_or_cleanup_clock(first_clock):
    now = time.monotonic()
    work, native, grant = now+30, now+40, now+40
    expected = now+0.02
    if first_clock == 'work':
        work = expected
    elif first_clock == 'native':
        native = expected+10
    else:
        grant = expected+10
    request = dict(work_deadline_monotonic=work, native_deadline_monotonic=native)
    cutoff = binding._private_cleanup_start(request, grant_deadline_monotonic=grant)
    assert abs(cutoff-expected) < 0.000001
    with binding._private_shutdown_handlers() as shutdown:
        binding._wait_for_private_stop(shutdown, cleanup_start_monotonic=cutoff)
    assert time.monotonic() >= cutoff
    assert time.monotonic() < now+30
    assert request == dict(work_deadline_monotonic=work, native_deadline_monotonic=native)
