"""Private S/F/R reader controls; no owner, client, resource or capture row.

Only inert protocol dictionaries and actual private files/sealed memfds are
used. No initializer, manager, DB, provider, native session or FIRST is run.
"""
import copy
import fcntl
import hashlib
import os
from pathlib import Path
import time

import pytest
import ipfs_accelerate_py.cli_runtime.grok_fresh_task_capture_check as check


def _pin(path, value):
    raw=check.canonical(value)
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


@pytest.fixture
def private_metadata(tmp_path):
    root=Path('/inert/normal-source');directory=tmp_path/'receipts';directory.mkdir(mode=0o700)
    now=time.monotonic();work=now+30;native=work+60
    sources={str(root/relative):hashlib.sha256(relative.encode()).hexdigest() for relative in check.PRIVATE_PROFILE_PATHS}
    profile=dict(schema='fresh-task-grok-capture-source-profile/v1',source_generation='grok-automatic-named-session/inert-private',sources=sources)
    named=dict(native_home='/inert/native-home',audit_directory='/inert/audit',preparation_home='/inert/preparation',
        binary=dict(path='/inert/grok',bytes=1,sha256='1'*64),configuration=dict(path='/inert/config',bytes=1,sha256='2'*64),
        owner_sampling_policy=dict(path='/inert/policy',bytes=1,sha256='3'*64),system_requirements=None,
        cleanup_reserve_seconds=5,bootstrap_max_seconds=10)
    capsule=dict(schema='legal-ir-grok-planning-transport-capsule/v4',source_generation=profile['source_generation'],
        files={role:dict(path=str(root/relative),bytes=1,sha256=sources[str(root/relative)]) for role,relative in check.PRIVATE_CAPSULE_ROLES.items()},named_session=named)
    nonce='4'*32;fingerprint=hashlib.sha256(('INVALID_PRIVATE_LOOPBACK_FIXTURE_ONLY_'+nonce).encode()).hexdigest()[:16]
    context=dict(schema='grok-production-owner-context/v1',database_task_cid='inert-new-task',database_attempt_id='inert-attempt',
        database_claim_id='inert-claim',database_attempt_number=1,coordination_lease_id='inert-coordination',owner_session_id='inert-owner',
        fencing_token=1,fence_epoch=1,portal_task_id='inert-alias',portal_task_revision_cid='inert-revision',portal_attempt=1,
        native_attempt_id='inert-attempt',allocation_session_id='inert-allocation',credential_slot='private-offline-inert',
        credential_fingerprint=fingerprint,allocation_store_path=str(directory/'allocation.duckdb'),workspace='/inert/workspace',
        source_generation=profile['source_generation'],source_bindings_sha256=check.digest(profile),capsule_sha256=check.digest(capsule),
        worker_source_sha256=capsule['files']['worker']['sha256'],owner_source_sha256=capsule['files']['owner_source']['sha256'],
        work_deadline_monotonic=work,native_deadline_monotonic=native,root_lease_id='inert-root',phase_lease_id='inert-phase',
        disk_native_lease_id='inert-native-disk',disk_reservation_id='inert-disk',owner_pid=10,owner_birth=20,worker_pid=30,
        worker_birth=40,worker_process_group=30,endpoint='/inert/socket',socket=dict(device=1,inode=2,mode=0o140600,uid=0,gid=0,nlink=1),nonce='5'*48)
    context['request_sha256']=check.digest(dict(schema=context['schema'],**{key:context[key] for key in check.PRIVATE_PRELAUNCH_FIELDS}))
    context['context_sha256']=check.digest(context)
    request=dict(schema=check.PRIVATE_SCHEMA,mode='fresh-task-capture-diagnostic',one_shot=True,attempt_cap=1,
        provider_dispatch_allowed=True,execution_environment='isolated-loopback',accelerator_root=str(root),workspace='/inert/workspace',
        receipt_directory=str(directory),task_alias=context['portal_task_id'],task_cid=context['database_task_cid'],
        database_attempt_id=context['database_attempt_id'],database_attempt_number=1,allocation_session_id=context['allocation_session_id'],
        source_generation=profile['source_generation'],work_deadline_monotonic=work,native_deadline_monotonic=native,
        owner_pid=10,owner_birth=20,owner_request_sha256=context['request_sha256'],context_path=str(directory/'owner-context.json'),
        capsule_pin=_pin(directory/'capsule.json',capsule),source_profile_pin=_pin(directory/'profile.json',profile),max_output_tokens=64,maximum_timeout_seconds=20)
    fixture=dict(schema=check.PRIVATE_FIXTURE_SCHEMA,execution_environment='isolated-loopback',paid_provider_calls_allowed=False,
        task_cid=request['task_cid'],task_alias=request['task_alias'],database_attempt_id=request['database_attempt_id'],database_attempt_number=1,
        allocation_session_id=request['allocation_session_id'],source_generation=request['source_generation'],owner_request_sha256=request['owner_request_sha256'],
        source_profile_sha256=check.digest(profile),capsule_sha256=check.digest(capsule),credential_slot=context['credential_slot'],credential_fingerprint=fingerprint,
        fake_nonce=nonce,receipt_directory=str(directory),work_deadline_monotonic=work,native_deadline_monotonic=native,network_namespace=dict(device=4,inode=10),
        network_witness_policy=dict(schema='private-owned-rootless-network-policy/v1',witness_kind='own-net-owned-user-restricted-maps/v1',expected_uid_map=[[0,1000,1],[1,100000,65536]],expected_gid_map=[[0,1000,1],[1,100000,65536]]),
        private_duckdb_quiescence_policy=dict(schema='private-owned-DuckDB-public-close-policy/v1',operation='duckdb.close',maximum_observation_milliseconds=200))
    request['fake_credential_fixture_pin']=_pin(directory/'private-fake-credential-fixture.json',fixture)
    return dict(request=request,context=context,fixture=fixture,source_profile=profile,capsule=capsule)


def test_private_S_F_R_metadata_join_never_installs_or_admits(private_metadata):
    result=check.validate_private_fixture_metadata(**private_metadata)
    assert result['sealed_request_sha256']==check.digest(private_metadata['request'])
    assert result['owner_request_sha256']==private_metadata['context']['request_sha256']
    assert result['sealed_request_sha256']!=result['owner_request_sha256']
    assert result['initializer_qualified']is result['native_qualified']is result['task_completion_accepted']is False


@pytest.mark.parametrize('mutation',[
    'v1','provider','cap_bool','extra_F','paid','task','attempt_bool','owner_S','wrong_R','slot','nonce','fingerprint',
    'fixture_path','fixture_digest','profile_digest','profile_generation','profile_missing','profile_outside','capsule_schema','capsule_role',
    'context_claim','work','map_bool','map_initial','map_overlap','quiescence_operation','quiescence_bound','quiescence_extra'])
def test_private_original_sealed_fixture_context_source_policy_tamper_refuses(private_metadata,mutation):
    data=copy.deepcopy(private_metadata);q=data['request'];f=data['fixture'];c=data['context'];p=data['source_profile'];v=data['capsule']
    if mutation=='v1':q['schema']='fresh-task-grok-capture-request/v1'
    elif mutation=='provider':q['execution_environment']='provider'
    elif mutation=='cap_bool':q['attempt_cap']=True
    elif mutation=='extra_F':f['unexpected']=True
    elif mutation=='paid':f['paid_provider_calls_allowed']=True
    elif mutation=='task':f['task_cid']='another'
    elif mutation=='attempt_bool':f['database_attempt_number']=True
    elif mutation=='owner_S':f['owner_request_sha256']=check.digest(q)
    elif mutation=='wrong_R':q['owner_request_sha256']='0'*64
    elif mutation=='slot':f['credential_slot']='another'
    elif mutation=='nonce':f['fake_nonce']='6'*32
    elif mutation=='fingerprint':f['credential_fingerprint']='0'*16
    elif mutation=='fixture_path':q['fake_credential_fixture_pin']['path']=str(Path(f['receipt_directory'])/'other.json')
    elif mutation=='fixture_digest':q['fake_credential_fixture_pin']['sha256']='0'*64
    elif mutation=='profile_digest':q['source_profile_pin']['sha256']='0'*64
    elif mutation=='profile_generation':p['source_generation']='other'
    elif mutation=='profile_missing':p['sources'].pop(next(iter(p['sources'])))
    elif mutation=='profile_outside':p['sources']['/outside/source.py']='0'*64
    elif mutation=='capsule_schema':v['schema']='other'
    elif mutation=='capsule_role':v['files']['worker']['sha256']='0'*64
    elif mutation=='context_claim':c['database_claim_id']='another';c['context_sha256']=check.digest({k:v for k,v in c.items()if k!='context_sha256'})
    elif mutation=='work':q['work_deadline_monotonic']+=1
    elif mutation=='map_bool':f['network_witness_policy']['expected_uid_map'][0][0]=True
    elif mutation=='map_initial':f['network_witness_policy']['expected_uid_map']=[[0,0,4294967295]]
    elif mutation=='map_overlap':f['network_witness_policy']['expected_gid_map']=[[0,1000,2],[1,100000,1]]
    elif mutation=='quiescence_operation':f['private_duckdb_quiescence_policy']['operation']='internal.close'
    elif mutation=='quiescence_bound':f['private_duckdb_quiescence_policy']['maximum_observation_milliseconds']=201
    elif mutation=='quiescence_extra':f['private_duckdb_quiescence_policy']['callback']='arbitrary'
    if mutation not in ('fixture_path','fixture_digest'):
        q['fake_credential_fixture_pin']=_pin(q['fake_credential_fixture_pin']['path'],f)
    with pytest.raises(check.CaptureCheckRefusal):check.validate_private_fixture_metadata(**data)


def _write_inputs(data):
    q=data['request']
    for name,key in [('fixture','fake_credential_fixture_pin'),('source_profile','source_profile_pin'),('capsule','capsule_pin')]:
        path=Path(q[key]['path']);path.write_bytes(check.canonical(data[name]));path.chmod(0o600)


def _sealed_request(request,*,sealed=True):
    raw=check.canonical(request);fd=os.memfd_create('private-S-F-R-metadata',os.MFD_CLOEXEC|os.MFD_ALLOW_SEALING)
    os.write(fd,raw)
    if sealed:fcntl.fcntl(fd,fcntl.F_ADD_SEALS,fcntl.F_SEAL_WRITE|fcntl.F_SEAL_GROW|fcntl.F_SEAL_SHRINK|fcntl.F_SEAL_SEAL)
    return fd


def test_actual_sealed_S_and_owned_F_profile_capsule_readback_preserve_borrow(private_metadata):
    _write_inputs(private_metadata);fd=_sealed_request(private_metadata['request'])
    try:
        os.lseek(fd,3,os.SEEK_SET)
        result=check.read_private_authentication_inputs(descriptor=fd,request=private_metadata['request'],context=private_metadata['context'])
        assert result['fixture']==private_metadata['fixture'] and os.lseek(fd,0,os.SEEK_CUR)==3
        assert result['authentication']['initializer_qualified']is False
    finally:os.close(fd)


def test_actual_unsealed_S_cannot_authenticate_otherwise_valid_private_inputs(private_metadata):
    _write_inputs(private_metadata);fd=_sealed_request(private_metadata['request'],sealed=False)
    try:
        with pytest.raises(check.CaptureCheckRefusal):check.read_private_authentication_inputs(descriptor=fd,request=private_metadata['request'],context=private_metadata['context'])
    finally:os.close(fd)


def test_actual_F_tamper_after_sealed_S_is_refused(private_metadata):
    _write_inputs(private_metadata);fd=_sealed_request(private_metadata['request'])
    try:
        path=Path(private_metadata['request']['fake_credential_fixture_pin']['path']);path.write_bytes(b'{"schema":"changed"}\n')
        with pytest.raises(check.CaptureCheckRefusal):check.read_private_authentication_inputs(descriptor=fd,request=private_metadata['request'],context=private_metadata['context'])
    finally:os.close(fd)


def _preparation_metadata(data):
    """Inert observations only; no fake client, store or accepted capture row."""
    q=data['request'];c=data['context'];f=data['fixture'];start=q['work_deadline_monotonic']-20
    network=dict(schema='private-owned-rootless-network-observation/v1',network_namespace=f['network_namespace'],
        user_namespace=dict(device=4,inode=11),network_owner_user_namespace=dict(device=4,inode=11),
        uid_map=f['network_witness_policy']['expected_uid_map'],gid_map=f['network_witness_policy']['expected_gid_map'],
        uid_map_sha256='1'*64,gid_map_sha256='2'*64,interfaces=[[1,'lo']],IPv4_routes_sha256='3'*64,IPv6_routes_sha256='4'*64,
        own_NET_owned_by_noninitial_self_USER=True,only_loopback_and_no_external_routes_observed=True,
        metadata_only=True,sealed_policy_authenticated=False,policy_binding_required=True,arbitrary_outer_freshness_proved=False,
        helper_initializer_called=False,provider_called=False,native_qualified=False,production_qualified=False,Lean_admitted=False,
        owned_namespace_descriptors_closed=True)
    def quiet(phase,offset):
        moment=start+offset
        samples=[dict(stage=stage,observed_monotonic=moment+delta,python_thread_count=1,native_thread_ids=[30],
            native_thread_count=1,main_python_thread=True,atomic=False) for stage,delta in
            [('before_public_close',-.001),('after_public_close',.002),('observation_25ms',.027),
             ('observation_50ms',.052),('observation_100ms',.102),('observation_200ms',.202)]]
        return dict(schema='private-DuckDB-public-quiescence/v1',phase=phase,public_API='duckdb.close',arguments_count=0,
            call_started_monotonic=moment,call_returned_monotonic=moment+.001,returned_None=True,samples=samples,
            actual_single_thread_gate_passed=True,observations_are_not_continuous=True,qualification_granted=False,
            explicit_default_connection_API_called=False,implicit_default_connection_creation='UNKNOWN',native_thread_cause_attributed=False,
            dependency_closure_pin=dict(path=str(Path(q['receipt_directory'])/'private-fake-duckdb-closure.json'),bytes=15157,
                sha256='00e462ea48071e91f6312fac75e35601ab5530233183f3da11de2542603c3f29'),
            verified_dependency_root=str(Path(q['receipt_directory'])/'private-fake-duckdb'),dependency_file_count=48,
            dependency_total_bytes=55017948,distribution_version='1.5.5',engine_version='1.5.5',
            work_deadline_monotonic=q['work_deadline_monotonic'],native_deadline_monotonic=q['native_deadline_monotonic'])
    value=dict(schema='private-fake-credential-installation-observation/v2',metadata_only=True,
        actual_same_process_private_manager=True,credential_slot=f['credential_slot'],credential_fingerprint=f['credential_fingerprint'],
        fake_only=True,real_credentials_used=False,ambient_credentials_read=False,provider_called=False,provider_dispatch_granted=False,
        singleton_reset=False,task_completion_accepted=False,native_qualified=False,production_qualified=False,Lean_admitted=False,
        fixture_pin=q['fake_credential_fixture_pin'],owner_request_sha256=c['request_sha256'],sealed_worker_request_sha256=check.digest(q),
        network_policy_binding_verified=True,network_observations=[copy.deepcopy(network) for _ in range(4)],
        public_duckdb_quiescence=[quiet('before_initialization',.3),quiet('after_strict_readback',1.3)],
        work_deadline_monotonic=q['work_deadline_monotonic'],native_deadline_monotonic=q['native_deadline_monotonic'],
        same_owner_client=True,same_store=True,early_network_observation=copy.deepcopy(network),
        store_readiness=dict(allocation_store_path=c['allocation_store_path'],row={},observed_monotonic=start+.2),
        actual_readonly_capture_table_counts=dict(cli_sessions=0,cli_session_aliases=0),
        public_empty_capture_read_is_absence_proof=False,no_capture_rows_seeded=True,
        preparation_started_monotonic=start,preparation_completed_monotonic=start+2,
        owner_rpc_receipt_count_before_preparation=1,owner_rpc_receipt_count_after_preparation=3)
    clients=[];owners=[]
    claim=('database_task_cid','database_attempt_id','database_claim_id','database_attempt_number',
        'coordination_lease_id','owner_session_id','fencing_token','fence_epoch')
    resources=('root_lease_id','phase_lease_id','disk_native_lease_id','disk_reservation_id')
    for sequence,(stage,offset) in enumerate([('request_prepared',-.2),('remaining_deadline',.1),('remaining_deadline',1),
                                             ('worker_v4_dispatch',2.15),('worker_v4_response',2.3)],1):
        response=dict(schema='grok-production-owner-currentness/v1',status='current',sequence=sequence,stage=stage,
            **{key:c[key] for key in ('request_sha256','context_sha256','nonce','owner_pid','owner_birth','worker_pid',
                'worker_birth','worker_process_group','work_deadline_monotonic','native_deadline_monotonic')},
            observed_monotonic=start+offset)
        shared=dict(sequence=sequence,stage=stage,request_sha256=c['request_sha256'],context_sha256=c['context_sha256'],
            response_sha256=check.digest(response),client_pid=c['worker_pid'],client_birth=c['worker_birth'],
            owner_pid=c['owner_pid'],owner_birth=c['owner_birth'],observed_monotonic=start+offset)
        clients.append(dict(shared,client_process_group=c['worker_process_group'],received_monotonic=start+offset+.005,
            actual_kernel_peer_owner_verified=True,observation_is_not_native_authority=True))
        owners.append(dict(shared,claim_binding={key:c[key] for key in claim},resource_binding={key:c[key] for key in resources},
            source_bindings_sha256=c['source_bindings_sha256']))
    return dict(transport=dict(private_fake_credentials=value,stdin_read_started_monotonic=start+2.1,
                dispatch_monotonic=start+2.2,owner_rpc_receipts=clients),owner_rows=owners)


def test_private_preparation_same_RPC_prefix_quiescence_is_only_metadata(private_metadata):
    observation=_preparation_metadata(private_metadata)
    result=check.validate_private_preparation_metadata(**private_metadata,**observation)
    assert len(observation['owner_rows'])==5 and result['initializer_qualified'] is False
    assert result['native_qualified'] is result['production_qualified'] is result['task_completion_accepted'] is False


@pytest.mark.parametrize('mutation',[
    'stdin_before','before_bool','after_count','missing_rpc','sequence','claim','resource','source','worker_birth',
    'ack_digest','ack_stale','readiness_store','sql_count','empty_lookup_proof','network_ownership','network_map',
    'network_route','network_interfaces','quiet_missing','quiet_gate','quiet_offset','quiet_dependency','authority','sealed_S'])
def test_private_preparation_observation_tamper_refuses(private_metadata,mutation):
    observation=_preparation_metadata(private_metadata);t=observation['transport'];v=t['private_fake_credentials']
    clients=t['owner_rpc_receipts'];owners=observation['owner_rows'];quiet=v['public_duckdb_quiescence']
    if mutation=='stdin_before':t['stdin_read_started_monotonic']=v['preparation_started_monotonic']
    elif mutation=='before_bool':v['owner_rpc_receipt_count_before_preparation']=True
    elif mutation=='after_count':v['owner_rpc_receipt_count_after_preparation']=len(clients)
    elif mutation=='missing_rpc':owners.pop(1)
    elif mutation=='sequence':clients[2]['sequence']=2
    elif mutation=='claim':owners[1]['claim_binding']['database_claim_id']='other'
    elif mutation=='resource':owners[1]['resource_binding']['root_lease_id']='other'
    elif mutation=='source':owners[1]['source_bindings_sha256']='0'*64
    elif mutation=='worker_birth':clients[1]['client_birth']+=1
    elif mutation=='ack_digest':clients[1]['response_sha256']=owners[1]['response_sha256']='0'*64
    elif mutation=='ack_stale':clients[1]['received_monotonic']=owners[1]['observed_monotonic']+1
    elif mutation=='readiness_store':v['store_readiness']['allocation_store_path']='/another/store'
    elif mutation=='sql_count':v['actual_readonly_capture_table_counts']['cli_sessions']=1
    elif mutation=='empty_lookup_proof':v['public_empty_capture_read_is_absence_proof']=True
    elif mutation=='network_ownership':v['network_observations'][0]['network_owner_user_namespace']['inode']+=1
    elif mutation=='network_map':v['network_observations'][0]['uid_map']=[[0,0,4294967295]]
    elif mutation=='network_route':v['network_observations'][0]['IPv4_routes_sha256']='0'*64
    elif mutation=='network_interfaces':v['network_observations'][0]['interfaces']=[[]]
    elif mutation=='quiet_missing':quiet.pop()
    elif mutation=='quiet_gate':quiet[-1]['actual_single_thread_gate_passed']=False
    elif mutation=='quiet_offset':quiet[0]['samples'][-1]['observed_monotonic']=quiet[0]['call_returned_monotonic']+.199
    elif mutation=='quiet_dependency':quiet[0]['dependency_closure_pin']['sha256']='0'*64
    elif mutation=='authority':v['native_qualified']=True
    elif mutation=='sealed_S':v['sealed_worker_request_sha256']='0'*64
    with pytest.raises(check.CaptureCheckRefusal):check.validate_private_preparation_metadata(**private_metadata,**observation)


@pytest.mark.parametrize('mutation',['count_two','wrong_worker_pid'])
def test_private_final_200ms_must_observe_only_actual_worker(private_metadata,mutation):
    observation=_preparation_metadata(private_metadata)
    sample=observation['transport']['private_fake_credentials']['public_duckdb_quiescence'][-1]['samples'][-1]
    actual=private_metadata['context']['worker_pid']
    if mutation=='count_two':sample['native_thread_ids']=[actual,actual+1];sample['native_thread_count']=2
    else:sample['native_thread_ids']=[actual+1]
    with pytest.raises(check.CaptureCheckRefusal):check.validate_private_preparation_metadata(**private_metadata,**observation)


def test_private_final_response_may_arrive_after_preparation_margin_before_original_work(private_metadata):
    observation=_preparation_metadata(private_metadata);q=private_metadata['request'];c=private_metadata['context']
    left=observation['transport']['owner_rpc_receipts'][-1];right=observation['owner_rows'][-1]
    observed=q['work_deadline_monotonic']-.8;received=q['work_deadline_monotonic']-.7
    left['observed_monotonic']=right['observed_monotonic']=observed;left['received_monotonic']=received
    response=dict(schema='grok-production-owner-currentness/v1',status='current',sequence=left['sequence'],stage=left['stage'],
        **{key:c[key] for key in ('request_sha256','context_sha256','nonce','owner_pid','owner_birth','worker_pid',
            'worker_birth','worker_process_group','work_deadline_monotonic','native_deadline_monotonic')},observed_monotonic=observed)
    left['response_sha256']=right['response_sha256']=check.digest(response)
    result=check.validate_private_preparation_metadata(**private_metadata,**observation)
    assert q['work_deadline_monotonic']-3<received<q['work_deadline_monotonic']
    assert result['initializer_qualified'] is result['native_qualified'] is False
