"""Construction-only composition for a future explicitly admitted child hook.

SOURCE CANDIDATE ONLY. There is intentionally no CLI/main entry. The existing
sealed daemon must opt in through a separately reviewed source/request binding
before calling this code with its actual bootstrap result. This module neither
mints bootstrap credentials nor accepts a serialized resource capability.
"""
from __future__ import annotations

from contextlib import ExitStack, nullcontext
import hashlib
import importlib
import json
import math
import os
from pathlib import Path
import stat
import sys
import threading
import time


P_ROOT = Path('/home/barberb/lift_coding/external/ipfs_datasets')
SCHEMA = 'private-approved-child-same-pid-construction-request/v1'
_RETAINED = []


class FixtureRefusal(RuntimeError):
    pass


class FixtureClosureUnknown(FixtureRefusal):
    """The same live composition must remain retained by the approved caller."""


def need(value, reason):
    if not value:
        raise FixtureRefusal(reason)


def _release_owned_phase_disk(disk, *, parent_lease):
    """Close a genuine private phase component, without granting admission.

    Used by the live M0 and independently testable with real private SDK
    owners. Unknown writes/pending consumers/strict inventory failures refuse.
    """
    from ipfs_datasets_py.optimizers.logic_theorem_optimizer import resource_scheduler as sdk
    from ipfs_datasets_py.optimizers.logic_theorem_optimizer import parented_phase_resources as parented
    for module, relative in ((sdk, 'resource_scheduler.py'), (parented, 'parented_phase_resources.py')):
        expected = str(P_ROOT/'ipfs_datasets_py/optimizers/logic_theorem_optimizer'/relative)
        need(module.__file__ == module.__spec__.origin == expected,
             'canonical_actual_resource_component_modules_required')
    need(type(disk) is parented.ParentedPhaseResourceReservation and
         type(parent_lease) is sdk.ResourceLease and parent_lease.owner_pid == os.getpid() and
         disk._parent is parent_lease and disk._owner_pid == os.getpid() and type(disk._entered) is bool,
         'actual_original_disk_composition_required')
    lease = disk._lease
    need(lease is None or (type(lease) is sdk.ResourceLease and lease.owner_pid == os.getpid() and
         lease.parent_lease_id == parent_lease.lease_id), 'actual_owned_disk_native_handle_required')
    record = disk._record
    if record is None:
        need(disk._entered is False and lease is None, 'partial_disk_local_state_unproven')
        with disk._locked():
            need(disk.reservation_id not in disk._read()['reservations'],
                 'partial_disk_durable_disposition_unproven')
        return 'absent'
    need(disk._entered is True and type(record) is dict and
         record.get('reservation_id') == disk.reservation_id and record.get('owner_pid') == os.getpid() and
         record.get('status') in {'reserved', 'active', 'retained', 'released'},
         'actual_owned_disk_record_required')
    # Existing stopped cleanup keeps owner/source/attempt/consumer/group and
    # the entire strict fresh attempt census. It grants nothing and borrows no
    # authority from a serialized record.
    released = disk.release(artifacts_durable=True)
    need(released['status'] == 'released' and disk._record['status'] == 'released' and
         disk._record.get('artifacts_durable_asserted') is True, 'actual_disk_release_unproven')
    with disk._locked():
        need(disk._read()['reservations'].get(disk.reservation_id) == disk._record,
             'actual_disk_durable_release_unproven')
    need(lease is None or lease.released is True, 'actual_disk_native_release_unproven')
    return 'released'


def read_pin(pin):
    need(type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'}, 'exact_pin_required')
    path = Path(pin['path'])
    need(path.is_absolute() and path.resolve(strict=True) == path, 'unaliased_pin_required')
    descriptor = os.open(path, os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
    try:
        before = os.fstat(descriptor)
        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and
             type(pin['bytes']) is int and 0 < before.st_size == pin['bytes'] <= 128*1024**2,
             'bounded_regular_pin_required')
        identity = lambda row: (row.st_dev, row.st_ino, row.st_mode, row.st_nlink,
                                row.st_size, row.st_mtime_ns, row.st_ctime_ns)
        chunks = []; count = 0
        while block := os.read(descriptor, 128*1024):
            count += len(block); need(count <= pin['bytes'], 'pin_grew')
            chunks.append(block)
        body = b''.join(chunks)
        need(count == pin['bytes'] and hashlib.sha256(body).hexdigest() == pin['sha256'] and
             identity(before) == identity(os.fstat(descriptor)) == identity(path.lstat()),
             'pin_content_or_identity_changed')
        return body
    finally:
        os.close(descriptor)


def source_digest(path):
    path = Path(path)
    need(not str(path).endswith(('.duckdb', '.db', '.sqlite', '.state.json', '.pt', '.pth',
                                '.safetensors', '.ckpt')), 'source_not_database_or_weights')
    size = path.lstat().st_size
    # Reuse the stable regular-file reader without treating asserted JSON as a
    # capability. Source hashes are only provenance; native APIs still admit.
    need(0 < size <= 128*1024**2, 'source_size_bound')
    need(path.resolve(strict=True) == path, 'source_alias')
    descriptor = os.open(path, os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
    try:
        before = os.fstat(descriptor)
        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1, 'regular_source_required')
        witness = lambda row: (row.st_dev, row.st_ino, row.st_mode, row.st_nlink,
                               row.st_size, row.st_mtime_ns, row.st_ctime_ns)
        hashed = hashlib.sha256(); count = 0
        while block := os.read(descriptor, 128*1024):
            count += len(block); need(count <= 128*1024**2, 'source_grew')
            hashed.update(block)
        need(count == before.st_size and witness(before) == witness(os.fstat(descriptor)) ==
             witness(path.lstat()), 'source_changed')
        return hashed.hexdigest()
    finally:
        os.close(descriptor)


def strict_request(pin):
    need(type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'} and
         type(pin['bytes']) is int and 0 < pin['bytes'] <= 2*1024**2, 'request_bound')
    def unique(pairs):
        value = {}
        for key, child in pairs:
            need(key not in value, 'duplicate_request_key'); value[key] = child
        return value
    def bad_constant(_value):
        raise FixtureRefusal('nonfinite_request')
    value = json.loads(read_pin(pin), object_pairs_hook=unique, parse_constant=bad_constant)
    need(type(value) is dict and set(value) == {
        'schema', 'fixture_id', 'source_roots', 'source_sha256', 'source_profile_pin', 'capsule_pin',
        'worker_path', 'source_generation', 'fixture_root', 'attempt_directory', 'socket_parent',
        'allocation_store_path', 'database_path', 'coordination_path', 'execution_path',
        'private_task_cid', 'private_task_alias', 'original_task_cid', 'original_catalog_path',
        'private_store_id', 'private_database_uuid', 'private_server_id',
        'original_store_id', 'original_database_uuid', 'state_dir', 'owner_session_id',
        'allocation_session_id', 'credential_slot', 'credential_fingerprint', 'resources',
        'work_deadline_monotonic', 'native_deadline_monotonic', 'construction_only'},
        'closed_request_schema_required')
    need(value['schema'] == SCHEMA and value['construction_only'] is True, 'M0_only')
    need(type(value['fixture_id']) is str and value['fixture_id'].startswith('same-pid-M0-') and
         len(value['fixture_id']) <= 128, 'explicit_fixture_identity_required')
    need(type(value['source_roots']) is list and len(value['source_roots']) == 2 and
         all(type(path) is str and Path(path).is_absolute() for path in value['source_roots']) and
         value['source_roots'][1] == str(P_ROOT), 'canonical_P_role_required')
    need(type(value['source_sha256']) is dict and 1 <= len(value['source_sha256']) <= 10000,
         'complete_bounded_source_map_required')
    for name, digest in value['source_sha256'].items():
        need(type(name) is str and Path(name).is_absolute() and type(digest) is str and len(digest) == 64 and
             all(c in '0123456789abcdef' for c in digest), 'source_pin_shape')
    for name in ('source_profile_pin', 'capsule_pin'):
        metadata_pin = value[name]
        read_pin(metadata_pin)
        need(value['source_sha256'].get(metadata_pin['path']) == metadata_pin['sha256'],
             'profile_and_capsule_must_join_complete_source_map')
    need(value['source_sha256'].get(str(Path(__file__))) == source_digest(__file__),
         'composition_source_must_be_separately_pinned')
    for name in ('private_store_id', 'private_database_uuid', 'private_server_id',
                 'original_store_id', 'original_database_uuid', 'source_generation',
                 'allocation_session_id', 'credential_slot', 'credential_fingerprint', 'owner_session_id'):
        need(type(value[name]) is str and 0 < len(value[name]) <= 4096, 'explicit_private_identity_required')
    need(value['private_store_id'] != value['original_store_id'] and
         value['private_database_uuid'] != value['original_database_uuid'],
         'original_store_authority_excluded')
    for name in ('work_deadline_monotonic', 'native_deadline_monotonic'):
        need(type(value[name]) in (int, float) and math.isfinite(value[name]), 'original_deadline_required')
    need(time.monotonic() < value['work_deadline_monotonic'] <= value['native_deadline_monotonic'] and
         value['native_deadline_monotonic']-time.monotonic() <= 3600, 'finite_original_lifetime_required')
    need(type(value['private_task_cid']) is str and value['private_task_cid'] and
         value['private_task_cid'] != value['original_task_cid'] and
         type(value['private_task_alias']) is str and value['private_task_alias'].startswith('SAMEPID-M0-'),
         'wholly_private_task_identity_required')
    root = Path(value['fixture_root'])
    need(root.is_absolute() and root.resolve(strict=True) == root and root.is_dir() and
         root.lstat().st_uid == os.getuid() and not root.lstat().st_mode & 0o077,
         'actual_private_fixture_directory_required')
    original = Path(value['original_catalog_path'])
    need(original.is_absolute() and '..' not in original.parts and
         not root.is_relative_to(original.parent) and not original.is_relative_to(root),
         'original_catalog_namespace_excluded')
    for name in ('attempt_directory', 'socket_parent', 'allocation_store_path', 'database_path',
                 'coordination_path', 'execution_path', 'state_dir'):
        path = Path(value[name])
        need(path.is_absolute() and '..' not in path.parts and path.is_relative_to(root) and
             path != original and path.resolve(strict=False) == path, 'private_path_scope_required')
    attempt = Path(value['attempt_directory'])
    need(attempt.resolve(strict=True) == attempt and attempt.is_dir() and
         attempt.lstat().st_uid == os.getuid() and not attempt.lstat().st_mode & 0o077 and
         Path(value['allocation_store_path']).parent == attempt and
         not Path(value['allocation_store_path']).exists(), 'fresh_private_allocation_path_required')
    need(not Path(value['socket_parent']).is_relative_to(attempt), 'socket_outside_strict_attempt_required')
    need(Path(value['socket_parent']).is_dir() and Path(value['state_dir']).is_dir(),
         'precharged_private_directories_required')
    for name in ('execution_path', 'coordination_path', 'state_dir'):
        need(Path(value[name]).is_relative_to(attempt), 'local_sidecar_writes_must_be_disk_charged')
    need(all(not Path(value[name]).exists() for name in ('execution_path', 'coordination_path')),
         'fresh_private_local_sidecars_required')
    need(len({value[name] for name in ('allocation_store_path', 'database_path', 'coordination_path',
         'execution_path')}) == 4, 'distinct_private_database_files_required')
    worker = Path(value['worker_path'])
    need(worker.is_absolute() and value['source_sha256'].get(str(worker)) == source_digest(worker),
         'pinned_future_worker_source_required')
    resource = value['resources']
    need(type(resource) is dict and set(resource) == {'scheduler_state_path', 'policy_sha256',
        'ledger_path', 'named_roots', 'storage_bytes', 'memory_mb', 'admission_timeout_seconds',
        'ledger_lock_timeout_seconds'}, 'explicit_resource_envelope_required')
    need(type(resource['memory_mb']) is int and 1 <= resource['memory_mb'] <= 2048 and
         type(resource['storage_bytes']) is int and 1 <= resource['storage_bytes'] <= 512*1024**2,
         'finite_M0_CPU_only_envelope_required')
    need(type(resource['named_roots']) is list and resource['named_roots'] and
         all(type(path) is str and Path(path).is_absolute() and
             Path(path).resolve(strict=True) == Path(path) for path in resource['named_roots']) and
         any(root.is_relative_to(Path(path)) for path in resource['named_roots']),
         'actual_named_storage_roots_required')
    need(type(resource['policy_sha256']) is str and len(resource['policy_sha256']) == 64 and
         all(c in '0123456789abcdef' for c in resource['policy_sha256']) and
         all(type(resource[name]) is str and Path(resource[name]).is_absolute()
             for name in ('scheduler_state_path', 'ledger_path')), 'explicit_existing_native_authority_required')
    for name, maximum in (('admission_timeout_seconds', 120), ('ledger_lock_timeout_seconds', 60)):
        need(type(resource[name]) in (int, float) and math.isfinite(resource[name]) and
             0 < resource[name] <= maximum, 'bounded_admission_wait_required')
    return value


def _import_pinned_normal_module(name, root, relative, source_sha256):
    """Import/check real source metadata only; this grants no capability."""
    module = importlib.import_module(name)
    path = Path(root)/relative
    need(module.__file__ == module.__spec__.origin == str(path) and
         source_sha256.get(str(path)) == source_digest(path),
         'genuine_normal_module_origin_required')
    return module


class PrivateSamePidConstruction:
    """Retained live M0 composition; approved caller owns invocation/receipts.

    ``owner_bootstrap`` must be the real result already obtained exactly once
    by database_owner_bootstrap_kwargs in the existing approved daemon child.
    The caller must retain this object and its process if close() is unknown.
    No context-manager auto-release or original task dispatch is provided.
    """
    def __init__(self, *, args, program, owner_bootstrap, request_pin):
        self.request_pin = dict(request_pin); self.request = strict_request(request_pin)
        self.args, self.program, self.bootstrap = args, program, owner_bootstrap
        self.pid, self.thread = os.getpid(), threading.get_ident()
        self.source_stack = ExitStack(); self.source_locks = []
        self.root = self.phase = self.disk = self.daemon = self.profile = self.store = None
        self.native_owner_heartbeat = None
        self.disk_entered = self.disk_closed = self.constructed = self.closed = False
        self.construction_started = False
        self.stage = "not_started"
        self.native_deadlines = None; self.pending_admission_error = None
        self.source_closed = False; self.native_ids = []; self.failure = None
        self.allocation_env_installed = False
        self.previous_allocation_env = ('IPFS_ACCELERATE_LLM_ALLOCATION_DB' in os.environ,
                                       os.environ.get('IPFS_ACCELERATE_LLM_ALLOCATION_DB'))
        _RETAINED.append(self)

    def __reduce__(self):
        raise TypeError('private same-PID live construction cannot be serialized')

    def _remaining(self):
        need(os.getpid() == self.pid and threading.get_ident() == self.thread, 'original_child_thread_required')
        remaining = self.request['native_deadline_monotonic']-time.monotonic()
        need(remaining > 0, 'original_native_deadline_expired')
        return remaining

    def _work_remaining(self):
        remaining = min(self._remaining(), self.request['work_deadline_monotonic']-time.monotonic())
        need(remaining > 0, 'original_work_deadline_expired')
        return remaining

    def _sources(self):
        read_pin(self.request_pin)
        need(all(source_digest(path) == digest for path, digest in self.request['source_sha256'].items()),
             'current_producer_source_changed')
        self._loaded_sources()

    def _loaded_sources(self):
        """Reject already loaded drift and unpinned future producer imports."""
        for name, module in tuple(sys.modules.items()):
            top = name.partition('.')[0]
            if top not in {'ipfs_accelerate_py', 'ipfs_datasets_py'}:
                continue
            path = getattr(module, '__file__', None)
            spec = getattr(module, '__spec__', None)
            need(type(path) is str and spec is not None and spec.origin == path,
                 'real_package_source_origin_required')
            expected = Path(self.request['source_roots'][0]) if top == 'ipfs_accelerate_py' else P_ROOT
            need(Path(path).is_relative_to(expected) and
                 self.request['source_sha256'].get(path) == source_digest(path),
                 'foreign_or_unpinned_loaded_producer_refused')

    def _module(self, name, root, relative):
        return _import_pinned_normal_module(name, root, relative, self.request['source_sha256'])

    def failure_observation(self):
        """Fixed diagnostic fields only; these observations are not grants."""
        record = getattr(self.disk, '_record', None)
        lease = getattr(self.disk, '_lease', None)
        status = record.get('status') if type(record) is dict else 'absent'
        return dict(schema='private-M0-safe-disposition-observation/v1',
            stage=self.stage, disk_enter_returned=self.disk_entered,
            disk_base_entered=getattr(self.disk, '_entered', False) is True,
            disk_record_status=status if status in {'absent', 'reserved', 'active', 'retained', 'released'} else 'unknown',
            actual_disk_native_handle_present=lease is not None,
            actual_disk_native_handle_released=(lease.released is True if lease is not None else None),
            disk_closed=self.disk_closed, constructed=self.constructed, source_closed=self.source_closed)

    def _remember_actual_disk_native(self):
        lease = getattr(self.disk, '_lease', None)
        if lease is not None:
            need(type(lease) is self.native_deadlines.ResourceLease and lease.owner_pid == self.pid and
                 lease.parent_lease_id == self.phase.lease_id,
                 'actual_owned_disk_native_handle_required')
            if lease.lease_id not in self.native_ids:
                self.native_ids.append(lease.lease_id)

    def _close_owned_disk(self):
        self._remember_actual_disk_native()
        _release_owned_phase_disk(self.disk, parent_lease=self.phase)
        self.disk_closed = True

    def construct(self):
        need(not self.construction_started and not self.constructed and not self.closed and self.root is None, 'one_construction_only')
        self.construction_started = True
        self._work_remaining(); self._sources()
        request = self.request; A = Path(request['source_roots'][0])
        need(A.resolve(strict=True) == A, 'exact_approved_accelerator_tree_required')
        # The approved child already loaded Accelerator. Canonical P may be
        # prepended only when no foreign P module has already been loaded.
        for name, module in tuple(sys.modules.items()):
            if name.partition('.')[0] in {'ipfs_accelerate_py', 'ipfs_datasets_py'} and getattr(module, '__file__', None):
                expected_root = A if name.startswith('ipfs_accelerate_py') else P_ROOT
                need(Path(module.__file__).is_relative_to(expected_root) and
                     module.__spec__.origin == module.__file__, 'foreign_preloaded_tree_refused')
        if str(P_ROOT) not in sys.path or sys.path[0] != str(P_ROOT):
            sys.path.insert(0, str(P_ROOT))
        daemon = self._module('ipfs_accelerate_py.agent_supervisor.todo_daemon.implementation_daemon', A,
            'ipfs_accelerate_py/agent_supervisor/todo_daemon/implementation_daemon.py')
        bootstrap = self._module('ipfs_accelerate_py.agent_supervisor.todo_daemon.native_owner_bootstrap', A,
            'ipfs_accelerate_py/agent_supervisor/todo_daemon/native_owner_bootstrap.py')
        typed = self._module('ipfs_accelerate_py.agent_supervisor.task_sources.typed_database_task_source', A,
            'ipfs_accelerate_py/agent_supervisor/task_sources/typed_database_task_source.py')
        credentials = self._module('ipfs_accelerate_py.agent_supervisor.task_sources.state_owner_bootstrap', A,
            'ipfs_accelerate_py/agent_supervisor/task_sources/state_owner_bootstrap.py')
        programs = self._module('ipfs_accelerate_py.agent_supervisor.runtime.multi_supervisor_runner', A,
            'ipfs_accelerate_py/agent_supervisor/runtime/multi_supervisor_runner.py')
        need(type(self.bootstrap) is dict and set(self.bootstrap) == {'task_source', 'close_task_source',
             'process_instance_id', 'state_owner_bootstrap_credentials'} and
             type(self.bootstrap['task_source']) is typed.TypedDatabaseTaskSource and
             type(self.bootstrap['state_owner_bootstrap_credentials']) is credentials.StateOwnerBootstrapCredentials and
             self.bootstrap['close_task_source'] is True, 'actual_existing_bootstrap_result_required')
        credential = self.bootstrap['state_owner_bootstrap_credentials']
        need(type(self.program) is programs.DatabaseProgramConfig and self.program.authority_mode == 'quack' and
             self.program.task_source_kind == 'duckdb' and self.program.quack_endpoint == credential.endpoint and
             self.program.store_id == credential.store_id and
             self.bootstrap['process_instance_id'] == credential.process_birth_id,
             'current_approved_program_and_birth_required')
        need(self.args.state_owner_bootstrap_fd >= 3 and self.args.state_owner_client_id == credential.client_id and
             self.args.implement is False and self.args.max_task_attempts == 1 and
             tuple(self.args.execution_slice_task_cid) == (request['private_task_cid'],) and
             tuple(self.args.execution_slice_task_id) == (request['private_task_alias'],),
             'approved_private_no_dispatch_slice_and_cap_required')
        need(all(str(getattr(self.args, name, '')) == request[name]
                 for name in ('database_path', 'coordination_path', 'execution_path', 'state_dir',
                              'owner_session_id')),
             'CLI_must_name_exact_private_paths_and_owner')
        authority = self.bootstrap['task_source'].require_quack_authority_binding(
            expected_endpoint=credential.endpoint, expected_process_instance_id=credential.process_birth_id,
            bootstrap_credentials=credential)
        stable = authority['stable_authority']
        need(authority['store_id'] == stable['store_id'] == credential.store_id == request['private_store_id'] and
             authority['server_id'] == credential.server_id == request['private_server_id'] and
             stable['database_uuid'] == request['private_database_uuid'] and
             authority['store_id'] != request['original_store_id'] and
             stable['database_uuid'] != request['original_database_uuid'],
             'genuine_current_bootstrap_must_bind_wholly_private_store')
        lease = self._module('ipfs_datasets_py.optimizers.logic_theorem_optimizer.autoencoder_source_lease', P_ROOT,
            'ipfs_datasets_py/optimizers/logic_theorem_optimizer/autoencoder_source_lease.py')
        self.native_deadlines = self._module(
            'ipfs_datasets_py.optimizers.logic_theorem_optimizer.resource_scheduler', P_ROOT,
            'ipfs_datasets_py/optimizers/logic_theorem_optimizer/resource_scheduler.py')
        try:
            with self.native_deadlines.resource_admission_deadline(
                    work_deadline_monotonic=request['work_deadline_monotonic'],
                    native_deadline_monotonic=request['native_deadline_monotonic']):
                for root in (A, P_ROOT):
                    held = self.source_stack.enter_context(lease.source_lease(root, mode='read',
                        timeout_seconds=min(30, self._work_remaining())))
                    info = Path(held.lock_path).lstat()
                    self.source_locks.append(dict(root=str(root), path=held.lock_path,
                        device=info.st_dev, inode=info.st_ino,
                        kernel_key=f'{os.major(info.st_dev):02x}:{os.minor(info.st_dev):02x}:{info.st_ino}'))
                self._sources()
                existing = self._module('ipfs_datasets_py.optimizers.logic_theorem_optimizer.existing_resource_scheduler', P_ROOT,
                    'ipfs_datasets_py/optimizers/logic_theorem_optimizer/existing_resource_scheduler.py')
                parented = self._module('ipfs_datasets_py.optimizers.logic_theorem_optimizer.parented_phase_resources', P_ROOT,
                    'ipfs_datasets_py/optimizers/logic_theorem_optimizer/parented_phase_resources.py')
                resource = request['resources']
                self._work_remaining()
                self.scheduler = existing.open_existing_scheduler(resource['scheduler_state_path'], resource['policy_sha256'])
                wait = lambda: min(resource['admission_timeout_seconds'], self._work_remaining())
                self.stage = 'native_root_admission'
                self.root = self.scheduler.acquire(self.native_deadlines.ResourceLane.HAMMER_LEAN, cpu_slots=1, memory_mb=resource['memory_mb'],
                    child_process_slots=1, timeout=wait(), request_id=request['fixture_id']+':root')
                self.native_ids.append(self.root.lease_id)
                self.stage = 'native_phase_admission'
                self.phase = self.root.acquire_child(cpu_slots=1, memory_mb=resource['memory_mb'],
                    child_process_slots=1, timeout=wait(), request_id=request['fixture_id']+':phase')
                self.native_ids.append(self.phase.lease_id)
                self.stage = 'disk_reservation_construct'
                self.disk = parented.ParentedPhaseResourceReservation(resource['ledger_path'],
                    roots=tuple(Path(path) for path in resource['named_roots']),
                    attempt_directory=Path(request['attempt_directory']), parent_lease=self.phase,
                    storage_bytes=resource['storage_bytes'], memory_mb=resource['memory_mb'],
                    cpu_slots=1, child_process_slots=1, scheduler_state_path=resource['scheduler_state_path'],
                    expected_scheduler_policy_sha256=resource['policy_sha256'], timeout_seconds=self._remaining(),
                    ledger_lock_timeout_seconds=min(resource['ledger_lock_timeout_seconds'], self._work_remaining()))
                self._work_remaining(); self.stage = 'disk_reservation_enter'
                try:
                    self.disk.__enter__()
                except BaseException as entry_error:
                    # Preserve the original admission/entry exception and any
                    # pending-SDK marker even if local handle tracking fails.
                    try:
                        self._remember_actual_disk_native()
                    except BaseException as tracking_error:
                        entry_error.private_M0_tracking_error_type = type(tracking_error).__name__
                    raise
                else:
                    self.disk_entered = True
                    self._remember_actual_disk_native()
                allocation = self._module('ipfs_accelerate_py.llm_allocation.duckdb_store', A,
                    'ipfs_accelerate_py/llm_allocation/duckdb_store.py')
                self.stage = 'allocation_schema_construct'
                self.store = allocation.AllocationStore(Path(request['allocation_store_path']))
                self._work_remaining()
                self.store.list_api_key_slots('grok_cli')
                need(self.store._ready is True, 'genuine_private_DuckDB_schema_required')
                os.environ['IPFS_ACCELERATE_LLM_ALLOCATION_DB'] = str(self.store.path)
                self.allocation_env_installed = True
                self._work_remaining()
                self.stage = 'database_daemon_construct'
                self.daemon = daemon.DatabaseImplementationDaemon(database_path=Path(request['database_path']),
                    coordination_path=Path(request['coordination_path']), execution_path=Path(request['execution_path']),
                    state_dir=Path(self.args.state_dir), state_prefix=str(self.args.state_prefix),
                    owner_session_id=str(self.args.owner_session_id), authority_mode='quack', task_source_kind='duckdb',
                    quack_uri=credential.endpoint, require_real_execution=False, max_task_attempts=1,
                    execution_slice_task_cids=(request['private_task_cid'],),
                    execution_slice_task_ids=(request['private_task_alias'],), **self.bootstrap)
                modules = {}
                for short in ('grok_production_owner', 'grok_existing_phase_owner', 'grok_owned_unix_socket',
                              'grok_production_owner_server', 'grok_production_handoff', 'grok_same_pid_owner_profile'):
                    modules[short] = self._module('ipfs_accelerate_py.cli_runtime.'+short, A,
                        'ipfs_accelerate_py/cli_runtime/'+short+'.py')
                self._work_remaining(); self.stage = 'same_pid_profile_module_preload'
                self._module('ipfs_accelerate_py.agent_supervisor.todo_daemon.database_portal_bridge', A,
                    'ipfs_accelerate_py/agent_supervisor/todo_daemon/database_portal_bridge.py')
                self.stage = 'same_pid_profile_construct'
                self.profile = modules['grok_same_pid_owner_profile'].ExistingSamePidOwnerProfile(
                    core=modules['grok_production_owner'], factory_module=modules['grok_existing_phase_owner'],
                    listener_module=modules['grok_owned_unix_socket'], server_module=modules['grok_production_owner_server'],
                    handoff_module=modules['grok_production_handoff'], database_owner=self.daemon, allocation_store=self.store,
                    root=self.root, phase=self.phase, disk=self.disk, source_roots=(A, P_ROOT),
                    source_pins=dict(request['source_sha256']), source_locks=tuple(self.source_locks),
                    source_profile_pin=dict(request['source_profile_pin']), capsule_pin=dict(request['capsule_pin']),
                    source_generation=request['source_generation'], worker_path=Path(request['worker_path']),
                    socket_parent=Path(request['socket_parent']), allocation_session_id=request['allocation_session_id'],
                    credential_slot=request['credential_slot'], credential_fingerprint=request['credential_fingerprint'],
                    work_deadline_monotonic=request['work_deadline_monotonic'],
                    native_deadline_monotonic=request['native_deadline_monotonic'], expected_task_cid=request['private_task_cid'])
                self._work_remaining()
                observation = bootstrap.observe_typed_database_without_dispatch(self.daemon)
                need(observation['attempt_consumed'] is False and observation['write_count'] == 0 and
                     observation['provider_dispatched'] is False, 'construction_must_not_dispatch')
                # Use the existing genuine credential-bound reader. Keep its
                # connection and producer activity inside this composition's
                # actual native/source custody until ordinary owner STOP.
                self.native_owner_heartbeat = bootstrap.NativeOwnerHeartbeat(
                    credentials=credential, state_dir=Path(self.args.state_dir),
                    state_prefix=str(self.args.state_prefix))
                self._work_remaining(); self.stage = 'native_heartbeat_start'
                self.native_owner_heartbeat.start()
                self.stage = 'final_strict_attempt_check'
                self.disk.check_usage(self.disk.directory, full=True)
                self._work_remaining(); self._sources(); self.constructed = True
                self.stage = 'constructed'
                return dict(schema='private-same-pid-M0-construction-observation/v1', fixture_id=request['fixture_id'],
                    same_pid=os.getpid(), construction_only=True, actual_same_pid_profile_constructed=True,
                    native_ids=list(self.native_ids), actual_source_lock_count=len(self.source_locks),
                    typed_owner_ready_task_count=observation['ready_task_count'],
                    private_store_id=authority['store_id'], private_database_uuid=stable['database_uuid'],
                    private_server_id=authority['server_id'],
                    task_claimed=False, provider_dispatched=False, full_transport_qualified=False,
                    production_qualified=False, original_task_selected=False, Lean_admitted=False)
        except BaseException as error:
            self.failure = type(error).__name__
            if getattr(error, 'resource_admission_cleanup_pending', False):
                # Retain the actual SDK object/request outcome, not a JSON grant.
                self.pending_admission_error = error
            raise

    def close(self, *, artifacts_durable):
        """Explicit stopped cleanup; preserve this object on every unknown.

        The approved parent owns and precharges durable receipts separately.
        It must persist observations before selecting artifacts_durable=True.
        No new resource grant or task retry occurs in this method.
        """
        need(artifacts_durable is True and not self.closed, 'durable_explicit_stopped_cleanup_required')
        need(os.getpid() == self.pid and threading.get_ident() == self.thread, 'original_child_thread_required')
        try:
            need(self.pending_admission_error is None, 'actual_native_admission_retirement_unproven')
            cleanup_scope = (self.native_deadlines.resource_cleanup_deadline(
                native_deadline_monotonic=self.request['native_deadline_monotonic'])
                if self.native_deadlines is not None else nullcontext())
            with cleanup_scope:
                self.stage = 'heartbeat_and_daemon_stopped_cleanup'
                if self.native_owner_heartbeat is not None:
                    self.native_owner_heartbeat.close()
                    thread = self.native_owner_heartbeat.thread
                    need((thread is None or not thread.is_alive()) and
                         not self.native_owner_heartbeat.client.attached,
                         'actual_native_owner_heartbeat_cleanup_unproven')
                if self.daemon is not None:
                    self.daemon.close()
                elif type(self.bootstrap) is dict and 'task_source' in self.bootstrap:
                    self.bootstrap['task_source'].close()
                if self.disk is not None and not self.disk_closed:
                    self.stage = 'disk_owned_stopped_cleanup'
                    self._close_owned_disk()
                for resource in (self.phase, self.root):
                    if resource is not None and not resource.released:
                        need(resource.release(), 'actual_native_release_refused')
                if hasattr(self, 'scheduler'):
                    need(not any(row.get('lease_id') in self.native_ids for row in self.scheduler.active_leases()),
                         'selected_native_ids_still_active')
                self._sources()
                if self.allocation_env_installed:
                    need(os.environ.get('IPFS_ACCELERATE_LLM_ALLOCATION_DB') == self.request['allocation_store_path'],
                         'allocation_environment_changed_before_release')
                    present, value = self.previous_allocation_env
                    if present:
                        os.environ['IPFS_ACCELERATE_LLM_ALLOCATION_DB'] = value
                    else:
                        os.environ.pop('IPFS_ACCELERATE_LLM_ALLOCATION_DB', None)
                    self.allocation_env_installed = False
                self.source_stack.close()
                locks = [line.split() for line in Path('/proc/locks').read_text().splitlines()]
                for row in self.source_locks:
                    info = Path(row['path']).lstat()
                    need((info.st_dev, info.st_ino) == (row['device'], row['inode']) and
                         not any('->' not in record and len(record) >= 6 and
                             record[4] == str(self.pid) and record[5] == row['kernel_key'] for record in locks),
                         'actual_original_kernel_source_lock_release_unproven')
                self.source_closed = True; self.closed = True
                self.stage = 'closed'
                _RETAINED.remove(self)
                return dict(schema='private-same-pid-M0-child-closure/v1', fixture_id=self.request['fixture_id'],
                    construction_only=True, actual_constructed=self.constructed, selected_native_ids_absent=True,
                    actual_source_locks_released=True, task_claimed=False, provider_dispatched=False,
                    original_task_selected=False, production_qualified=False, Lean_admitted=False)
        except BaseException as error:
            self.failure = type(error).__name__
            # Preserve actual objects and any still-held locks/leases. The
            # caller must retain the live approved child and reconcile closure.
            raise FixtureClosureUnknown('M0_closure_unproven_live_composition_retained') from error
