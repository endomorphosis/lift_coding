"""Inert real-file QA metadata rejection tests, never native qualification.

No capability, scheduler, runtime, owner, credential or database is doubled.
The actual source-pinned stdlib checker reads test-owned evidence bytes.
"""
from pathlib import Path
import copy
import hashlib
import importlib.util
import json
import sys

import pytest

W=Path('/home/barberb/lift_coding')
D=W/'artifacts/legal-ir-supervisor-recovery-20261018-03/private-M1-provisioning-caller-source-v7'
C=W/'artifacts/legal-ir-supervisor-recovery-20261018-03/private-M1-independent-acceptance-source-v3'


def load(name,path):
    spec=importlib.util.spec_from_file_location(name,path)
    module=importlib.util.module_from_spec(spec);sys.modules[name]=module;spec.loader.exec_module(module)
    return module


caller=load('private_M1_caller_metadata_under_test',D/'run_offline_m1.py')
check=load('private_M1_actual_stdlib_metadata_checker',C/'check_offline_m1.py')


def write(path,value):
    path.write_text(json.dumps(value,sort_keys=True)+'\n');path.chmod(0o600)
    return check.pin(path)


@pytest.fixture
def metadata(tmp_path):
    # This fabricated QA metadata is explicitly inert. Positive validation
    # means only that the reader accepts its closed shape, never real QA.
    files={f'test_inert_{i}.py':12 for i in range(16)}
    files['test_inert_selected.py']=32
    assert sum(files.values())==224
    selected={'test_inert_selected.py':tuple('case_'+str(i) for i in range(8))}
    driver=tmp_path/'inert_driver.py'
    driver.write_text('TESTS = '+repr(files)+'\nEXISTING_SELECTION = '+repr(selected)+'\n')
    driver_pin=check.pin(driver)
    viewroot=tmp_path/'inert-view';viewroot.mkdir()
    prepared=write(tmp_path/'prepared.json',{'metadata_only':True})
    collection=[]
    for name,count in files.items():
        for i in range(count):
            collection.append(dict(nodeid='test/api/'+name+'::case_'+str(i),path=str(viewroot/'test/api'/name)))
    reports=[dict(nodeid=row['nodeid'],when=phase,outcome='passed') for row in collection
        for phase in ('setup','call','teardown')]
    invariants={name:True for name in ('exact_224_unique_cases','exact_file_case_counts',
        'focused_five_real_SDK_components_first','complete_672_unique_phase_pairs','all_phases_pass',
        'exact_reviewed_existing_eight_nodeids','all_three_real_conftest_objects_retained',
        'normal_core_objects_specs_sources_unchanged','pytest_entry_environment_restored',
        'dynamic_board_loader_disposition_and_alias_sources_observed')}
    tests=dict(schema='private-M1-entry-normal224-tests/v1',successful=True,pytest_exit_code=0,
        view_pins={'path':prepared['path'],'sha256':prepared['sha256']},required_invariants=invariants,
        collection=collection,reports=reports,actual_counts=files,
        actual_existing_nodeids=['test/api/test_inert_selected.py::case_'+str(i) for i in range(8)],
        focused_component_cases_first=True,normal_imports_before={str(i):{'inert':True} for i in range(19)},
        normal_imports_after={str(i):{'inert':True} for i in range(19)},actual_environment_delta_after_pytest=[])
    owner=dict(schema='private-M1-entry-normal224-owner/v1',successful=True,source_leases_released=True,
        actual_original_source_kernel_keys_released=True,descendants_drained=True,child_returncode=0)
    junit=tmp_path/'pytest.xml';junit.write_text('<testsuites><testsuite tests="224" failures="0" errors="0" skipped="0"/></testsuites>')
    reference=dict(schema='private-M1-entry-normal224-QA-reference/v1',view_root=str(viewroot),prepared_pin=prepared,
        owner_result=write(tmp_path/'owner.json',owner),tests_report=write(tmp_path/'tests.json',tests),
        JUnit=check.pin(junit),QA_driver=driver_pin)
    return dict(reference=reference,tests=tests,prepared=prepared,view={'view_root':str(viewroot)},driver=driver_pin,
        tests_path=tmp_path/'tests.json',junit=junit)


def invoke(value):
    return caller.require_normal_QA(check=check,reference=value['reference'],view_pin=value['prepared'],
        view=value['view'],driver_pin=value['driver'])


def test_inert_closed_QA_shape_reader_only(metadata):
    assert invoke(metadata)['tests_report']==metadata['reference']['tests_report']


def test_same_QA_reference_cannot_be_rebound_to_other_prepared_bytes(metadata,tmp_path):
    metadata['prepared']=write(tmp_path/'other-prepared.json',{'metadata_only':'different'})
    with pytest.raises(check.OfflineM1CheckFailed,match='actual224_QA_reference_must_join'):
        invoke(metadata)


def test_duplicate_actual_case_metadata_is_not_complete_population(metadata):
    metadata['tests']['collection'][1]=dict(metadata['tests']['collection'][0])
    metadata['reference']['tests_report']=write(metadata['tests_path'],metadata['tests'])
    with pytest.raises(check.OfflineM1CheckFailed,match='actual_unique_cases_and_complete_phase_coverage_required'):
        invoke(metadata)


def test_duplicate_passing_phase_metadata_is_not_complete_coverage(metadata):
    metadata['tests']['reports'][1]=dict(metadata['tests']['reports'][0])
    metadata['reference']['tests_report']=write(metadata['tests_path'],metadata['tests'])
    with pytest.raises(check.OfflineM1CheckFailed,match='actual_unique_cases_and_complete_phase_coverage_required'):
        invoke(metadata)


def test_renamed_true_invariant_cannot_replace_reviewed_gate(metadata):
    value=metadata['tests']['required_invariants'];value['invented_gate']=value.pop('pytest_entry_environment_restored')
    metadata['reference']['tests_report']=write(metadata['tests_path'],metadata['tests'])
    with pytest.raises(check.OfflineM1CheckFailed,match='exact_selected_driver_population_and_invariants_required'):
        invoke(metadata)


def test_real_QA_evidence_file_tamper_without_repin_is_refused(metadata):
    metadata['tests_path'].write_text('{}\n')
    with pytest.raises(check.OfflineM1CheckFailed,match='evidence_pin_mismatch'):
        invoke(metadata)


@pytest.fixture
def owner_metadata_context(tmp_path):
    """Complete inert metadata plus a real private socket inode; no live owner.

    Positive validation tests only the genuine closed context validator.
    The fixed identity integers are inert input data, never native capability
    objects, a client, an ACK, or proof of a process/task/credential lifetime.
    """
    import os
    import socket
    import tempfile
    import time
    import ipfs_accelerate_py.cli_runtime.grok_production_owner as core
    with tempfile.TemporaryDirectory(prefix='m1c-',dir=tmp_path.parent) as temporary:
        root=Path(temporary)
        with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as channel:
            endpoint=root/'s';channel.bind(str(endpoint));endpoint.chmod(0o600)
            info=endpoint.lstat()
            witness=dict(device=info.st_dev,inode=info.st_ino,mode=info.st_mode,
                uid=info.st_uid,gid=info.st_gid,nlink=info.st_nlink)
            value={name:'inert-'+name for name in core.PRELAUNCH_FIELDS}
            now=time.monotonic()
            value.update(schema=core.CONTEXT_SCHEMA,database_attempt_id='inert-attempt',
                native_attempt_id='inert-attempt',database_attempt_number=1,portal_attempt=1,
                fencing_token=0,fence_epoch=0,allocation_session_id='inert-offline-allocation',
                allocation_store_path=str(root/'unopened-allocation.duckdb'),workspace=str(root),
                source_generation='grok-automatic-named-session/inert-offline-metadata',
                source_bindings_sha256='1'*64,capsule_sha256='2'*64,worker_source_sha256='3'*64,
                owner_source_sha256=hashlib.sha256(Path(core.__file__).read_bytes()).hexdigest(),
                work_deadline_monotonic=now+10,native_deadline_monotonic=now+20,
                owner_pid=2,owner_birth=1,worker_pid=3,worker_birth=1,worker_process_group=3,
                endpoint=str(endpoint),socket=witness,nonce='4'*48,
                **caller.offline_owner_credential_metadata())
            value['request_sha256']=core.digest({'schema':core.CONTEXT_SCHEMA,
                **{name:value[name] for name in core.PRELAUNCH_FIELDS}})
            value['context_sha256']=core.digest(value)
            yield core,value


def test_public_offline_marker_metadata_satisfies_actual_owner_context_shape(owner_metadata_context):
    core,value=owner_metadata_context
    assert caller.offline_owner_credential_metadata()==caller.offline_owner_credential_metadata()
    assert core.validate_context(value)==value


def test_invalid_offline_fingerprint_still_refused_by_actual_owner_validator(owner_metadata_context):
    core,value=owner_metadata_context
    value=dict(value);value['credential_fingerprint']='not-a-16-hex-fingerprint'
    value['request_sha256']=core.digest({'schema':core.CONTEXT_SCHEMA,
        **{name:value[name] for name in core.PRELAUNCH_FIELDS}})
    value['context_sha256']=core.digest({name:child for name,child in value.items()
        if name!='context_sha256'})
    with pytest.raises(core.ProductionOwnerRefusal,match='^owner_context_credential_metadata$'):
        core.validate_context(value)
