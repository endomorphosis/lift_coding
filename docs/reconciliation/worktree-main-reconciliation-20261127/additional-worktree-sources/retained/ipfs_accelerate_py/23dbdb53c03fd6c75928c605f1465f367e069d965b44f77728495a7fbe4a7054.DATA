"""Real local Unix sockets/FDs only; no bootstrap credential or native grant."""
import array
from contextlib import contextmanager
import errno
import fcntl
import os
from pathlib import Path
import select
import socket
import stat
import threading
import time

import pytest

import ipfs_accelerate_py.agent_supervisor.task_sources.bootstrap_fd_transport as transport


@contextmanager
def pair():
    left, right = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
    left.settimeout(1.0)
    right.settimeout(1.0)
    try:
        yield left, right
    finally:
        left.close()
        right.close()


@contextmanager
def witnesses():
    memfd = os.memfd_create('inert-bootstrap-witness-test', os.MFD_CLOEXEC|os.MFD_ALLOW_SEALING)
    directory = -1
    try:
        os.write(memfd, b'inert-source-test-metadata')
        seals = fcntl.F_SEAL_SEAL|fcntl.F_SEAL_WRITE|fcntl.F_SEAL_GROW|fcntl.F_SEAL_SHRINK
        fcntl.fcntl(memfd, fcntl.F_ADD_SEALS, seals)
        directory = os.open('.', os.O_PATH|os.O_DIRECTORY|os.O_CLOEXEC)
        yield memfd, directory
    finally:
        if directory >= 0:
            os.close(directory)
        os.close(memfd)


def deadline():
    return time.monotonic()+1.0


def identity(descriptor):
    info = os.fstat(descriptor)
    return info.st_dev, info.st_ino, info.st_mode


def identity_count(descriptor):
    target = identity(descriptor)
    count = 0
    for name in os.listdir('/proc/self/fd'):
        try:
            count += identity(int(name)) == target
        except OSError as error:
            assert error.errno == errno.EBADF
    return count


def raw_send(channel, packet, descriptors=()):
    rights = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', descriptors))] if descriptors else []
    sent = channel.sendmsg([packet], rights)
    assert sent > 0
    channel.sendall(packet[sent:])


def assert_borrowed_open(descriptors):
    for descriptor in descriptors:
        os.fstat(descriptor)


def test_ordinary_frame_has_identical_bytes_and_no_descriptor():
    with pair() as (sender, receiver):
        sender.sendall(b'\0\0\0\2{}')
        assert transport.receive_framed_bytes(receiver, deadline_monotonic=deadline()) == (b'{}', ())
        assert receiver.gettimeout() == 1.0


def test_real_sealed_memfd_and_actual_dot_directory_arrive_CLOEXEC():
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        transport.send_framed_bytes(sender, b'{"inert":true}', descriptors=borrowed,
                                    deadline_monotonic=deadline())
        body, received = transport.receive_framed_bytes(
            receiver, expected_descriptor_count=2, deadline_monotonic=deadline())
        try:
            assert body == b'{"inert":true}' and len(received) == 2
            assert tuple(identity(fd) for fd in received) == tuple(identity(fd) for fd in borrowed)
            assert all(not os.get_inheritable(fd) for fd in received)
            assert all(fcntl.fcntl(fd, fcntl.F_GETFD) & fcntl.FD_CLOEXEC for fd in received)
            assert os.pread(received[0], 64, 0) == b'inert-source-test-metadata'
            assert fcntl.fcntl(received[0], fcntl.F_GET_SEALS) == fcntl.fcntl(borrowed[0], fcntl.F_GET_SEALS)
            assert stat.S_ISDIR(os.fstat(received[1]).st_mode)
            assert tuple(identity_count(fd) for fd in borrowed) == tuple(n+1 for n in before)
        finally:
            transport.close_received_descriptors(received)
        assert tuple(identity_count(fd) for fd in borrowed) == before
        assert_borrowed_open(borrowed)
        assert sender.gettimeout() == receiver.gettimeout() == 1.0


@pytest.mark.parametrize('rights_location', ['header', 'body'])
def test_default_ordinary_receiver_rejects_rights_on_any_fragment_and_closes_them(rights_location):
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        if rights_location == 'header':
            raw_send(sender, b'\0\0\0\2{}', borrowed)
        else:
            sender.sendall(b'\0\0\0\2')
            raw_send(sender, b'{}', borrowed)
        with pytest.raises(transport.BootstrapFDTransportError):
            transport.receive_framed_bytes(receiver, deadline_monotonic=deadline())
        assert tuple(identity_count(fd) for fd in borrowed) == before
        assert_borrowed_open(borrowed)
        assert receiver.gettimeout() == 1.0


def test_private_receiver_accepts_actual_rights_on_body_fragment():
    with witnesses() as borrowed, pair() as (sender, receiver):
        sender.sendall(b'\0\0\0\2')
        raw_send(sender, b'{}', borrowed)
        body, received = transport.receive_framed_bytes(
            receiver, expected_descriptor_count=2, deadline_monotonic=deadline())
        try:
            assert body == b'{}'
            assert tuple(identity(fd) for fd in received) == tuple(identity(fd) for fd in borrowed)
        finally:
            transport.close_received_descriptors(received)


@pytest.mark.parametrize('sent_count', [0, 1, 3])
def test_exact_private_count_and_real_kernel_ancillary_truncation_close_received_FDs(sent_count):
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        selected = () if sent_count == 0 else (borrowed[0],) if sent_count == 1 else borrowed+(borrowed[0],)
        raw_send(sender, b'\0\0\0\2{}', selected)
        with pytest.raises(transport.BootstrapFDTransportError):
            transport.receive_framed_bytes(receiver, expected_descriptor_count=2,
                                           deadline_monotonic=deadline())
        assert tuple(identity_count(fd) for fd in borrowed) == before
        assert_borrowed_open(borrowed)


def test_unknown_actual_kernel_credentials_ancillary_is_rejected():
    with pair() as (sender, receiver):
        receiver.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
        sender.sendall(b'\0\0\0\2{}')
        with pytest.raises(transport.BootstrapFDTransportError,
                           match='unexpected_or_truncated_ancillary_data'):
            transport.receive_framed_bytes(receiver, deadline_monotonic=deadline())


@pytest.mark.parametrize('packet', [b'\0', b'\0\0\0\x10{}'])
def test_EOF_after_actual_rights_closes_all_received_FDs(packet):
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        raw_send(sender, packet, borrowed)
        sender.shutdown(socket.SHUT_WR)
        with pytest.raises(transport.BootstrapFDTransportError,
                           match='bootstrap_stream_closed_before_frame_complete'):
            transport.receive_framed_bytes(receiver, expected_descriptor_count=2,
                                           deadline_monotonic=deadline())
        assert tuple(identity_count(fd) for fd in borrowed) == before


def test_original_absolute_timeout_closes_received_rights_and_restores_socket():
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        raw_send(sender, b'\0', borrowed)
        original_deadline = time.monotonic()+0.02
        with pytest.raises(TimeoutError):
            transport.receive_framed_bytes(receiver, expected_descriptor_count=2,
                                           deadline_monotonic=original_deadline)
        assert time.monotonic() >= original_deadline
        assert tuple(identity_count(fd) for fd in borrowed) == before
        assert receiver.gettimeout() == 1.0


def test_fragmented_frame_cannot_renew_original_timeout():
    errors = []
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        def send_slowly():
            try:
                raw_send(sender, b'\0', borrowed)
                for byte in b'\0\0\2{}':
                    time.sleep(0.03)
                    sender.sendall(bytes([byte]))
            except (BrokenPipeError, OSError) as error:
                errors.append(type(error).__name__)
        thread = threading.Thread(target=send_slowly)
        thread.start()
        try:
            original_deadline = time.monotonic()+0.05
            with pytest.raises(TimeoutError):
                transport.receive_framed_bytes(receiver, expected_descriptor_count=2,
                                               deadline_monotonic=original_deadline)
            assert time.monotonic() >= original_deadline
        finally:
            receiver.shutdown(socket.SHUT_RDWR)
            thread.join(timeout=1)
        assert not thread.is_alive()
        assert tuple(identity_count(fd) for fd in borrowed) == before


def test_large_frame_partial_send_preserves_exactly_one_rights_pair():
    result = []
    with witnesses() as borrowed, pair() as (sender, receiver):
        sender.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4096)
        body = b'x'*65536
        assert sender.getsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF) < len(body)+4
        def send_large():
            try:
                transport.send_framed_bytes(sender, body, descriptors=borrowed,
                                            deadline_monotonic=deadline())
                result.append('sent')
            except BaseException as error:
                result.append(error)
        thread = threading.Thread(target=send_large)
        thread.start()
        received = ()
        try:
            assert select.select([receiver], [], [], 1)[0] == [receiver]
            actual, received = transport.receive_framed_bytes(
                receiver, expected_descriptor_count=2, deadline_monotonic=deadline())
            assert actual == body and len(received) == 2
        finally:
            transport.close_received_descriptors(received)
            receiver.shutdown(socket.SHUT_RDWR)
            thread.join(timeout=1)
        assert not thread.is_alive() and result == ['sent']
        assert_borrowed_open(borrowed)


@pytest.mark.parametrize('size', [0, 1, 65537])
def test_invalid_frame_length_closes_rights_before_return(size):
    with witnesses() as borrowed, pair() as (sender, receiver):
        before = tuple(identity_count(fd) for fd in borrowed)
        raw_send(sender, size.to_bytes(4, 'big'), borrowed)
        with pytest.raises(transport.BootstrapFDTransportError, match='bootstrap_frame_size_invalid'):
            transport.receive_framed_bytes(receiver, expected_descriptor_count=2,
                                           deadline_monotonic=deadline())
        assert tuple(identity_count(fd) for fd in borrowed) == before


@pytest.mark.parametrize('count', [-1, 1, 3, True, 1.0])
def test_invalid_descriptor_count_rejected_without_consuming_frame(count):
    with pair() as (sender, receiver):
        sender.sendall(b'\0\0\0\2{}')
        with pytest.raises(transport.BootstrapFDTransportError,
                           match='expected_descriptor_count_must_be_zero_or_two'):
            transport.receive_framed_bytes(receiver, expected_descriptor_count=count,
                                           deadline_monotonic=deadline())
        assert transport.receive_framed_bytes(receiver, deadline_monotonic=deadline()) == (b'{}', ())


def test_expired_sender_deadline_keeps_borrowed_descriptors_open():
    with witnesses() as borrowed, pair() as (sender, receiver):
        with pytest.raises(transport.BootstrapFDTransportError,
                           match='original_deadline_expired_or_unbounded'):
            transport.send_framed_bytes(sender, b'{}', descriptors=borrowed,
                                        deadline_monotonic=time.monotonic()-1)
        assert_borrowed_open(borrowed)


def test_owned_descriptor_closer_attempts_later_real_close_after_first_OS_error():
    with witnesses() as borrowed:
        duplicate = os.dup(borrowed[0])
        try:
            with pytest.raises(transport.BootstrapFDTransportError) as caught:
                transport.close_received_descriptors((1 << 30, duplicate))
            assert caught.value.failed_descriptors == (1 << 30,)
            assert isinstance(caught.value.__cause__, OSError)
            assert caught.value.__cause__.errno == errno.EBADF
            with pytest.raises(OSError) as closed:
                os.fstat(duplicate)
            assert closed.value.errno == errno.EBADF
        finally:
            try:
                os.close(duplicate)
            except OSError as error:
                assert error.errno == errno.EBADF
        assert_borrowed_open(borrowed)
