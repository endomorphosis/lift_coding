            'database_attempt_number','allocation_session_id','source_generation','owner_request_sha256',
            'receipt_directory','work_deadline_monotonic','native_deadline_monotonic')}
        value.update(schema=helper.PRIVATE_SCHEMA,execution_environment='isolated-loopback',paid_provider_calls_allowed=False,
            source_profile_sha256=worker_request['source_profile_pin']['sha256'],capsule_sha256=worker_request['capsule_pin']['sha256'],
            credential_slot=self.request['credential_slot'],credential_fingerprint=self.request['credential_fingerprint'],
            fake_nonce=policy['public_fake_nonce'],network_namespace=dict(self.namespace_witness['network_namespace']),
            network_witness_policy=policy['network_witness_policy'],
            private_duckdb_quiescence_policy=policy['private_duckdb_quiescence_policy'])
        context=dict(binding,request_sha256=handoff.owner._request_sha256)
        helper.validate_fixture_metadata(value,worker_request,context)
        directory=handoff.server.context_path.parent
        self._stage_private_duckdb(directory)
        fixture_pin=self._write_private_file(directory/'private-fake-credential-fixture.json',helper.canonical(value))
        # Retain the created F identity immediately. F commits R, never S.
        self.fake_credential_fixture_pin=dict(fixture_pin)
        row=Path(fixture_pin['path']).lstat()
        self.fake_credential_fixture_identity=(row.st_dev,row.st_ino,row.st_mode,row.st_uid,row.st_nlink,row.st_size,row.st_mtime_ns,row.st_ctime_ns)
        need(helper.decode(helper.read_pin(fixture_pin))==value,'actual_created_private_F_readback_required')
        self._work_remaining()
        return fixture_pin

