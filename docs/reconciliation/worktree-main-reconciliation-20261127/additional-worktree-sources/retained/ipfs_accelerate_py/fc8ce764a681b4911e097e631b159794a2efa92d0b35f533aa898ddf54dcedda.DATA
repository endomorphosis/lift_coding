    def _create_private_credential_fixture(self, handoff, worker_request, helper):
        self.require_current()
        need(self.fake_credential_fixture_pin is None and handoff is self.profile.handoff and
             handoff.owner._request_sha256==worker_request['owner_request_sha256'],
             'one_actual_prelaunch_R_to_fixture_F_required')
