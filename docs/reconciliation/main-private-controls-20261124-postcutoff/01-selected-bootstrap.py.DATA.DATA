def source_io_control_bytes(path):
    p = Path(path)
    before = p.lstat()
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or (not 0 <= before.st_size <= 4194304):
        raise RuntimeError('named private control size/type differs')
    source_io_admit(SOURCE_IO_STATE, before.st_size + 1)
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(fd)
        fields = ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_uid', 'st_gid', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
        stamp = lambda x: tuple((getattr(x, k) for k in fields))
        if stamp(before) != stamp(opened):
            raise RuntimeError('named private control FD differs')
        raw = source_io_read_fd(SOURCE_IO_STATE, fd, before.st_size, p, 'named-workspace-control')
        if stamp(before) != stamp(os.fstat(fd)) or stamp(before) != stamp(p.lstat()) or len(raw) != before.st_size:
            raise RuntimeError('named private control changed')
    finally:
        os.close(fd)
    return raw
request = json.loads(source_io_control_bytes(workspace / 'request.json'))
