def body_identity(name):
    path = str(bound_paths[name])
    row = modules[name]
    exact(path, row['bytes'], row['sha256'])
    observed = dict(authenticated[path])
    if observed['full9'] != row['full9']:
        raise RuntimeError('bound D module metadata differs: ' + name)
    return dict(name=name, path=path, bytes=observed['bytes'], sha256=observed['sha256'], scope=row['scope'], full9=observed['full9'])
