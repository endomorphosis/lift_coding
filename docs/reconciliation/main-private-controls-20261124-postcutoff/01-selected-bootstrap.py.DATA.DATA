SOURCE_IO_SCOPE = 'declared-direct-Source-auth-and-private-control-reads/v1'
SOURCE_IO_OUTSIDE_BOUNDARY = ['interpreter/bootstrap-selfloading', 'stdlib/thirdparty/generalproject/library-IO-not-through-named-readers', 'SDK-internal-IO-not-through-named-readers', 'complete-kernel/runtime-IO']

def source_io_start(allocation, authority, role, initial=None):
    if not isinstance(allocation, dict) or set(allocation) != {'schema', 'runtime_authority', 'operation_total_bytes', 'role_limits', 'ledger_before', 'scope'}:
        raise RuntimeError('unbound or malformed closed Source IO allocation')
    if allocation['schema'] != 'Root-selected-declared-direct-Source-IO-allocation/v1' or allocation['scope'] != SOURCE_IO_SCOPE or (not isinstance(authority, dict)) or (allocation['runtime_authority'] != authority):
        raise RuntimeError('Source IO closed authority/scope differs')
    limits = allocation['role_limits']
    total = allocation['operation_total_bytes']
    before = allocation['ledger_before']
    if not isinstance(limits, dict) or set(limits) != {'parent', 'collect', 'run'} or any((type(v) is not int or v < 0 for v in limits.values())) or (type(total) is not int) or (total <= 0) or (sum(limits.values()) > total):
        raise RuntimeError('Source IO closed role limits differ')
    if not isinstance(before, dict) or any((type(before.get(k)) is not int or before[k] < 0 for k in ('captures', 'used', 'internal_used', 'global_cap', 'internal_cap'))):
        raise RuntimeError('Source IO ledger shape differs')
    if before['used'] + total > before['global_cap'] or before['internal_used'] + total > before['internal_cap']:
        raise RuntimeError('Source IO total allocation unavailable before admission')
    if role not in ('parent', 'collect', 'run', 'bootstrap'):
        raise RuntimeError('Source IO role differs')
    limit = min(limits['collect'], limits['run']) if role == 'bootstrap' else limits[role]
    initial = {'bytes': 0, 'captures': 0} if initial is None else initial
    if set(initial) != {'bytes', 'captures'} or any((type(v) is not int or v < 0 for v in initial.values())) or initial['bytes'] > limit:
        raise RuntimeError('Source IO known prelaunch charge differs')
    return {'schema': 'actual-declared-direct-Source-IO-meter/v1', 'scope': SOURCE_IO_SCOPE, 'runtime_authority': authority, 'allocation': allocation, 'role': role, 'limit_bytes': limit, 'initial_known_IO': dict(initial), 'bytes': initial['bytes'], 'captures': initial['captures'], 'read_syscalls': 0, 'inputs': [], 'violations': [], 'declared_direct_IO_budget_accepted': False, 'outside_boundary': SOURCE_IO_OUTSIDE_BOUNDARY, 'outside_boundary_actual_bytes': None, 'complete_kernel_or_runtime_IO_measured': False, 'finished': False}

def source_io_bind_role(state, role, allocation, authority):
    if state['finished'] or state['role'] != 'bootstrap' or role not in ('collect', 'run') or (allocation != state['allocation']) or (authority != state['runtime_authority']):
        raise RuntimeError('Source IO child role/authority differs')
    limit = allocation['role_limits'][role]
    if state['bytes'] > limit:
        raise RuntimeError('Source IO request read already exceeds role allocation')
    state['role'] = role
    state['limit_bytes'] = limit
    return state

def source_io_admit(state, n):
    if type(n) is not int or n < 0 or state['finished'] or (state['bytes'] + n > state['limit_bytes']):
        state['violations'].append({'kind': 'Source-IO-allocation-refusal', 'requested_bound': n, 'actual_bytes_before': state['bytes']})
        raise RuntimeError('declared direct Source IO allocation insufficient before read')

def source_io_read_fd(state, fd, maximum_bytes, path, kind):
    if type(maximum_bytes) is not int or maximum_bytes < 0:
        raise RuntimeError('Source IO read bound differs')
    source_io_admit(state, maximum_bytes + 1)
    row = {'path': str(path), 'kind': str(kind), 'actual_bytes': 0, 'read_syscalls': 0}
    state['inputs'].append(row)
    state['captures'] += 1
    parts = []
    total = 0
    try:
        while total <= maximum_bytes:
            state['read_syscalls'] += 1
            row['read_syscalls'] += 1
            piece = os.read(fd, min(65536, maximum_bytes + 1 - total))
            state['bytes'] += len(piece)
            row['actual_bytes'] += len(piece)
            total += len(piece)
            if not piece:
                break
            parts.append(piece)
        if total > maximum_bytes:
            state['violations'].append({'kind': 'Source-IO-content-length-refusal', 'path': str(path), 'actual_bytes': total})
            raise RuntimeError('Source IO file grew beyond selected bound')
    except BaseException as error:
        state['violations'].append({'kind': 'Source-IO-read-error', 'path': str(path), 'type': type(error).__name__, 'actual_bytes': row['actual_bytes']})
        raise
    return b''.join(parts)

def source_io_finish(state):
    state['finished'] = True
    state['declared_direct_IO_budget_accepted'] = not state['violations'] and state['bytes'] <= state['limit_bytes']
    return state

def source_io_validate_child(child, allocation, authority, role):
    if role not in ('collect', 'run'):
        raise RuntimeError('child Source IO role differs')
    if not isinstance(child, dict) or child.get('schema') != 'actual-declared-direct-Source-IO-meter/v1' or child.get('scope') != SOURCE_IO_SCOPE or (child.get('allocation') != allocation) or (child.get('runtime_authority') != authority) or (child.get('role') != role):
        raise RuntimeError('missing or mismatched declared direct child Source IO meter')
    limit = child.get('limit_bytes')
    if type(limit) is not int or limit < 0 or limit != allocation['role_limits'][role]:
        raise RuntimeError('child direct Source IO limit type or value differs')
    violations = child.get('violations')
    if child.get('finished') is not True or child.get('declared_direct_IO_budget_accepted') is not True or type(violations) is not list or (violations != []) or (type(child.get('bytes')) is not int) or (type(child.get('captures')) is not int) or (child['bytes'] < 0) or (child['captures'] < 0) or (child['bytes'] > limit):
        raise RuntimeError('child declared direct Source IO budget not accepted')
    initial = child.get('initial_known_IO')
    inputs = child.get('inputs')
    if type(initial) is not dict or set(initial) != {'bytes', 'captures'} or any((type(initial[k]) is not int or initial[k] != 0 for k in initial)):
        raise RuntimeError('child initial direct Source IO must be exact integer zero')
    if type(inputs) is not list or any((type(row) is not dict or set(row) != {'path', 'kind', 'actual_bytes', 'read_syscalls'} or type(row['path']) is not str or (type(row['kind']) is not str) or (type(row['actual_bytes']) is not int) or (row['actual_bytes'] < 0) or (type(row['read_syscalls']) is not int) or (row['read_syscalls'] < 1) for row in inputs)):
        raise RuntimeError('child direct Source IO event shape or read calls differ')
    if child['captures'] != len(inputs) or child['bytes'] != sum((row['actual_bytes'] for row in inputs)) or type(child.get('read_syscalls')) is not int or (child['read_syscalls'] != sum((row['read_syscalls'] for row in inputs))):
        raise RuntimeError('child direct Source IO event totals differ')
    if child.get('complete_kernel_or_runtime_IO_measured') is not False or 'outside_boundary_actual_bytes' not in child or child['outside_boundary_actual_bytes'] is not None or (child.get('outside_boundary') != SOURCE_IO_OUTSIDE_BOUNDARY):
        raise RuntimeError('child Source IO claim exceeds declared direct boundary')
    return {'bytes': child['bytes'], 'captures': child['captures'], 'read_syscalls': child['read_syscalls'], 'scope': SOURCE_IO_SCOPE, 'complete_kernel_or_runtime_IO_measured': False}

def validate_runtime_authority(authority, expected_authority, now_utc_ns):
    keys = {'schema', 'root_selection', 'launch_not_before_utc_ns', 'launch_deadline_utc_ns'}
    for value in (authority, expected_authority):
        if type(value) is not dict or set(value) != keys or value['schema'] != 'Root-selected-normal-HOME-rescue-launch-authority/v1':
            raise RuntimeError('closed Root runtime authority required')
        reference = value['root_selection']
        if type(reference) is not dict or set(reference) != {'path', 'bytes', 'sha256'}:
            raise RuntimeError('one exact immutable Root selection reference required')
        if type(reference['path']) is not str or not Path(reference['path']).is_absolute() or type(reference['bytes']) is not int or (reference['bytes'] <= 0) or (type(reference['sha256']) is not str) or (len(reference['sha256']) != 64) or any((c not in '0123456789abcdef' for c in reference['sha256'])):
            raise RuntimeError('invalid immutable Root selection reference')
        start = value['launch_not_before_utc_ns']
        deadline = value['launch_deadline_utc_ns']
        if type(start) is not int or type(deadline) is not int or (not 0 < start < deadline):
            raise RuntimeError('finite exact UTC nanosecond launch window required')
    if authority != expected_authority:
        raise RuntimeError('Root runtime authority mismatch, including selection and clock')
    if type(now_utc_ns) is not int or not authority['launch_not_before_utc_ns'] <= now_utc_ns < authority['launch_deadline_utc_ns']:
        raise RuntimeError('Root launch clock outside selected window')
    return authority
