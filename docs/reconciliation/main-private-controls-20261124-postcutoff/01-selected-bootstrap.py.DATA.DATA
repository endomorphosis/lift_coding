def audit_configuration():
    result = []
    for value in configuration_paths:
        path = Path(value)
        if not path.is_absolute() or path.resolve(strict=True) != path or (not (path.is_relative_to(root) or path.is_relative_to(accelerate))):
            raise RuntimeError('configuration path is outside bound D/additional A READ roots')
        row = epoch[str(path)]
        exact(str(path), row['bytes'], row['sha256'])
        observed = dict(authenticated[str(path)])
        if observed['full9'] != row['full9']:
            raise RuntimeError('normal ini/conftest Source epoch metadata differs')
        result.append(observed)
    return result
loaded = {}

def audit_modules():
    result = []
    for name in module_order:
        mod = sys.modules.get(name)
        if mod is not loaded.get(name) or mod is None:
            raise RuntimeError('existing-name module object was replaced: ' + name)
        path = bound_paths[name]
        if Path(mod.__file__).resolve(strict=True) != path or Path(mod.__spec__.origin).resolve(strict=True) != path or mod.__spec__.name != name:
            raise RuntimeError('module physical origin was retagged: ' + name)
        parent_name, attribute = name.rsplit('.', 1)
        if getattr(sys.modules[parent_name], attribute) is not mod:
            raise RuntimeError('parent-package alias differs: ' + name)
        result.append(body_identity(name))
    return result
