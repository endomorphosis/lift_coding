{
  "actual_route": [
    {
      "behavior": "A4 calls host check_obligation and run_ucan, then computes pre_allow from both. This route does not call IntentAuthorizationService.evaluate or the composed proof-job policy to build its decision.",
      "refs": [
        "harness:875-911"
      ],
      "step": 1
    },
    {
      "behavior": "Harness constructs DecisionReceipt directly with outcome ALLOW, selected-evidence identifier and obligation label, and fixed attempt/result/decision/policy digests. If the pre-gate fails it uses a deliberately wrong receipt audience; the forged control is the literal string forged.",
      "refs": [
        "harness:467-491",
        "harness:912-929",
        "baseline:56-63"
      ],
      "step": 2
    },
    {
      "behavior": "Enforcer resolves receipt/capability, invokes native verify_decision_receipt with caller context, expected roots and supplied clock, then requires exact ALLOW and checks tool/arguments/effects/delegation/environment bindings.",
      "refs": [
        "archived_enforcer:735-856",
        "datasets_receipt:1577-1654"
      ],
      "step": 3
    },
    {
      "behavior": "When a capability exists, native verify_capability checks content integrity, one-time marker, parent allow-receipt identity, effect/resource subsets and other parent/context restrictions. This pure check neither authenticates an issuer nor consumes anything.",
      "refs": [
        "archived_enforcer:858-880",
        "datasets_receipt:1657-1771"
      ],
      "step": 4
    },
    {
      "behavior": "Enforcer derives a consumption key, calls injected store.try_consume, denies an already-consumed key, then invokes the delegate. The archived deployment injects the file-backed adapter through an embedded exclusive owner client.",
      "refs": [
        "archived_enforcer:554-580",
        "archived_enforcer:1173-1229",
        "consumption:212-228",
        "consumption:243-323"
      ],
      "step": 5
    }
  ],
