    "transaction baseline",
    "clock",
    "RNG",
    "service image/config/corpus",
    "explicit environment projection"
  ],
  "schema": "pctdd/fixture-adapter-inventory@1",
  "secret_rule": "commit provider identity/version/epoch/policy, never secret bytes"
}
